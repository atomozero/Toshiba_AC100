From f4c0f53adb282726034e1aab49b83267111c5a3f Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 00:36:24 +0200
Subject: [PATCH 068/270] ARM bring-up: write the syslog with a high priority
 so it is not starved (not for merging)

---
 src/system/kernel/fs/vfs_boot.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/system/kernel/fs/vfs_boot.cpp b/src/system/kernel/fs/vfs_boot.cpp
index b520d082a9..2aaf1275e1 100644
--- a/src/system/kernel/fs/vfs_boot.cpp
+++ b/src/system/kernel/fs/vfs_boot.cpp
@@ -625,7 +625,7 @@ vfs_mount_boot_file_system(kernel_args* args)
 			if (last != NULL && !readOnly) {
 				strlcpy(last + 1, "0", sizeof(sEspPath) - (last + 1 - sEspPath));
 				thread_id thread = spawn_kernel_thread(&syslog_to_esp_thread,
-					"syslog to ESP", B_LOW_PRIORITY, NULL);
+					"syslog to ESP", B_URGENT_DISPLAY_PRIORITY, NULL);
 				resume_thread(thread);
 			}
 			break;
