From 56862285d7526c729b28d6572348128af2371d84 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 27 Oct 2026 07:20:25 +0100
Subject: [PATCH 35/63] usb_serial: deselect also when the device has been
 removed

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/drivers/ports/usb_serial/SerialDevice.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/add-ons/kernel/drivers/ports/usb_serial/SerialDevice.cpp b/src/add-ons/kernel/drivers/ports/usb_serial/SerialDevice.cpp
index 6000e0c99d..5847222a0a 100644
--- a/src/add-ons/kernel/drivers/ports/usb_serial/SerialDevice.cpp
+++ b/src/add-ons/kernel/drivers/ports/usb_serial/SerialDevice.cpp
@@ -444,7 +444,10 @@ SerialDevice::Select(uint8 event, uint32 ref, selectsync *sync)
 status_t
 SerialDevice::DeSelect(uint8 event, selectsync *sync)
 {
-	if (fDeviceRemoved)
+	// Also once the device is gone: the TTY outlives it until Close(), which
+	// notifies the TTY's select pool, and the entry must not stay there after
+	// the select() it belongs to has returned.
+	if (fSystemTTYCookie == NULL)
 		return B_DEV_NOT_READY;
 
 	return gTTYModule->tty_deselect(fSystemTTYCookie, event, sync);
-- 
2.39.5

