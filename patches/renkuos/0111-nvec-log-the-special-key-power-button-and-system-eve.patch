From 7e29237e0228c142869d20eac5e9e5cae7d77033 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 19:46:00 +0200
Subject: [PATCH 111/270] nvec: log the special key, power button and system
 events (bring-up)

Neither the power button nor the backlight keys did anything on the AC100,
and only the first 100 messages were logged: always log the events other
than ordinary keys and touchpad packets, and the state changes of the
"Wakeup" key GPIO of Linux' device tree (PJ7).
---
 src/add-ons/kernel/busses/i2c/nvec/nvec.cpp | 39 +++++++++++++++++++--
 1 file changed, 36 insertions(+), 3 deletions(-)

diff --git a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
index 83cee83941..228449539b 100644
--- a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
+++ b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
@@ -89,6 +89,9 @@
 										+ (((gpio) / 8) % 4) * 4 + (reg))
 #define TEGRA_GPIO_CNF				0x00
 #define TEGRA_GPIO_OE				0x10
+#define TEGRA_GPIO_IN				0x30
+#define TEGRA_GPIO_MSK_CNF			0x800
+#define TEGRA_GPIO_MSK_OE			0x810
 #define TEGRA_GPIO_MSK_OUT			0x820
 	// masked write: bit n + 8 selects bit n
 
@@ -210,6 +213,7 @@ struct nvec_device {
 	bigtime_t			repeatRate;
 	bigtime_t			currentRepeatDelay;
 	bool				extendedKey;	// an 0xe0 prefix came
+	uint32				wakeupGPIOLevel;
 
 	// power button, watched by the power_daemon
 	mutex				powerButtonLock;
@@ -374,6 +378,18 @@ setup_hardware(nvec_device* device)
 	*(volatile uint32*)(device->gpio
 		+ TEGRA_GPIO_REG(device->requestGPIO, TEGRA_GPIO_OE)) |= gpioBit;
 
+	// the "Wakeup" key of Linux' device tree, PJ7: a GPIO input, as Linux'
+	// gpio-keys sets it up
+	uint32 wakeupBit = 1U << (79 % 8);
+	*(volatile uint32*)(device->gpio
+		+ TEGRA_GPIO_REG(79, TEGRA_GPIO_MSK_OE)) = wakeupBit << 8;
+	*(volatile uint32*)(device->gpio
+		+ TEGRA_GPIO_REG(79, TEGRA_GPIO_MSK_CNF)) = (wakeupBit << 8) | wakeupBit;
+	device->wakeupGPIOLevel = *(volatile uint32*)(device->gpio
+		+ TEGRA_GPIO_REG(79, TEGRA_GPIO_IN)) & wakeupBit;
+	TRACE_ALWAYS("GPIO PJ7 (wakeup) %s at start\n",
+		device->wakeupGPIOLevel != 0 ? "high" : "low");
+
 	write_reg(device, I2C_CNFG, I2C_CNFG_NEW_MASTER_SFM
 		| I2C_CNFG_PACKET_MODE_EN | (2 << I2C_CNFG_DEBOUNCE_CNT_SHIFT));
 	write_reg(device, I2C_SL_CNFG, I2C_SL_NEWSL);
@@ -969,9 +985,20 @@ poll_thread(void* data)
 			kBatteryValues[next++ % B_COUNT_OF(kBatteryValues)] };
 		nvec_write(device, request, sizeof(request));
 
-		for (int32 i = 0; i < 50 && !device->stopping; i++)
+		for (int32 i = 0; i < 50 && !device->stopping; i++) {
 			snooze(100000);
 
+			// bring-up aid: Linux' device tree has a "Wakeup" key on GPIO
+			// PJ7 (79, active low); is it the power button?
+			uint32 level = *(volatile uint32*)(device->gpio
+				+ TEGRA_GPIO_REG(79, TEGRA_GPIO_IN)) & (1U << (79 % 8));
+			if (level != device->wakeupGPIOLevel) {
+				TRACE_ALWAYS("GPIO PJ7 (wakeup) %s\n", level != 0
+					? "high" : "low");
+				device->wakeupGPIOLevel = level;
+			}
+		}
+
 		// bring-up aid: is the EC still talking to us?
 		if (next % 6 == 0 && next <= 60) {
 			TRACE_ALWAYS("%" B_PRIu32 " interrupts, %" B_PRIu32 " messages (%"
@@ -1018,8 +1045,14 @@ rx_thread(void* data)
 			device->rxTail++;
 		}
 
-		// bring-up aid: show what the EC sends
-		if (reported < 100) {
+		// bring-up aid: show what the EC sends; the events other than
+		// ordinary keys and touchpad packets always (special keys, power
+		// button, system events)
+		bool special = is_event(&message)
+			&& ((message.data[0] & 0x8f) != NVEC_PS2_EVT)
+			&& ((message.data[0] & 0x8f) != NVEC_KB_EVT
+				|| ((message.data[0] >> 5) & 3) != NVEC_2BYTES);
+		if (reported < 100 || special) {
 			reported++;
 			dump_message(is_event(&message) ? "event" : "reply", &message);
 		}
