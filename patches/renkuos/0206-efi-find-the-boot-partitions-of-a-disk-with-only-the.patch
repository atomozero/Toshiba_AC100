From 22f1384b9f347c45b8eeb04559eb0f893ac2d751 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 24 Oct 2026 15:35:05 +0200
Subject: [PATCH 206/270] efi: find the boot partitions of a disk with only the
 backup GPT

To tell which partitions belong to the boot disk, the loader compared
the GPT header at block 1 with the one it had parsed. When only the
backup table is valid (the start of the disk belongs to something else,
as on the eMMC of the Toshiba AC100) the header in memory is rebuilt
from the backup, and block 1 holds unrelated data: no partition matched
and the loader stopped with "Boot volume is not valid". Compare with the
backup header at the end of the disk in that case.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../kernel/partitioning_systems/gpt/Header.h    |  2 ++
 src/system/boot/platform/efi/devices.cpp        | 17 ++++++++++++++---
 2 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/src/add-ons/kernel/partitioning_systems/gpt/Header.h b/src/add-ons/kernel/partitioning_systems/gpt/Header.h
index a2cb925c12..4e5d9937be 100644
--- a/src/add-ons/kernel/partitioning_systems/gpt/Header.h
+++ b/src/add-ons/kernel/partitioning_systems/gpt/Header.h
@@ -26,6 +26,8 @@ public:
 
 			status_t			InitCheck() const;
 			bool				IsDirty() const;
+			bool				IsBackupOnly() const
+									{ return fBackupOnly; }
 
 			uint64				FirstUsableBlock() const
 									{ return fHeader.FirstUsableBlock(); }
diff --git a/src/system/boot/platform/efi/devices.cpp b/src/system/boot/platform/efi/devices.cpp
index ad59142afd..11ea72e79b 100644
--- a/src/system/boot/platform/efi/devices.cpp
+++ b/src/system/boot/platform/efi/devices.cpp
@@ -127,12 +127,23 @@ device_contains_partition(EfiDevice *device, boot::Partition *partition)
 		uint32 blockSize = device->BlockSize();
 		gpt_table_header *deviceHeader =
 			(gpt_table_header*)malloc(blockSize);
-		ssize_t bytesRead = device->ReadAt(NULL, blockSize, deviceHeader,
-			blockSize);
+		// With only the backup table (the start of the disk belongs to
+		// something else, as on NVIDIA Tegra systems), compare with that
+		// one: the header in memory was rebuilt from it.
+		const gpt_table_header& tableHeader = header->TableHeader();
+		uint64 headerBlock = header->IsBackupOnly()
+			? tableHeader.alternate_block : 1;
+		ssize_t bytesRead = device->ReadAt(NULL, headerBlock * blockSize,
+			deviceHeader, blockSize);
 		if (bytesRead != (ssize_t)blockSize)
 			return false;
 
-		if (memcmp(deviceHeader, &header->TableHeader(),
+		if (header->IsBackupOnly()) {
+			if (memcmp(&deviceHeader->disk_guid, &tableHeader.disk_guid,
+					sizeof(guid_t)) != 0
+				|| deviceHeader->entries_crc != tableHeader.entries_crc)
+				return false;
+		} else if (memcmp(deviceHeader, &tableHeader,
 				sizeof(gpt_table_header)) != 0)
 			return false;
 
