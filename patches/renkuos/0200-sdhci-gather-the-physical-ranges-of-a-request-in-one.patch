From 0ea47aaecc86ecb4d09783ff4f3c6525426d6696 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 24 Oct 2026 10:34:32 +0200
Subject: [PATCH 200/203] sdhci: gather the physical ranges of a request in one
 ADMA2 transfer

The controllers announced a single DMA segment per operation, so a read
into an ordinary (physically scattered) buffer became one command per
page: on the Toshiba AC100 both the eMMC (8 bit, 48 MHz) and the SD card
read at about 6 MB/s, whatever the block size.

ADMA2 takes a descriptor table: allow 128 segments and, when ADMA2 is the
data mode, describe all of them in one table and send a single command.
The other modes, or ranges that do not fit the table, still go one range
at a time. The cache maintenance on ARM covers every range.

Tested in QEMU (sdhci-pci, ARM): 512 KB reads in 128 ranges as one
transfer; reads, unaligned reads and a 16 MB write/read-back match the
data checked on the host.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/busses/mmc/sdhci.cpp      | 100 +++++++++++++++----
 src/add-ons/kernel/busses/mmc/sdhci.h        |  11 +-
 src/add-ons/kernel/busses/mmc/sdhci_acpi.cpp |   3 +-
 src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp  |   3 +-
 src/add-ons/kernel/busses/mmc/sdhci_pci.cpp  |   3 +-
 5 files changed, 96 insertions(+), 24 deletions(-)

diff --git a/src/add-ons/kernel/busses/mmc/sdhci.cpp b/src/add-ons/kernel/busses/mmc/sdhci.cpp
index 388c63cce7..db35f587fd 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci.cpp
+++ b/src/add-ons/kernel/busses/mmc/sdhci.cpp
@@ -946,8 +946,15 @@ sync_dma_buffer(phys_addr_t address, size_t size, bool isWrite)
 status_t
 SdhciBus::_TransferChunk(uint8 command, uint32 argument, uint32 blockCount,
 	uint32 blockSize, bool isWrite, int dataMode, int stopMode,
-	phys_addr_t physical, uint8* buffer, bigtime_t timeout)
+	phys_addr_t physical, uint8* buffer, bigtime_t timeout,
+	const generic_io_vec* vecs, uint32 vecCount)
 {
+	// With ADMA2, the data may also be given as a list of physical ranges
+	// (\a vecs) instead of \a physical: one descriptor table covers them all,
+	// and the whole list is a single command.
+	if (vecs != NULL && dataMode != kDataModeAdma2)
+		return B_BAD_VALUE;
+
 	const bool multi = command == SD_READ_MULTIPLE_BLOCKS
 		|| command == SD_WRITE_MULTIPLE_BLOCKS;
 	const size_t length = (size_t)blockCount * blockSize;
@@ -986,19 +993,30 @@ SdhciBus::_TransferChunk(uint8 command, uint32 argument, uint32 blockCount,
 		{
 			const uint32 maxDescriptors = B_PAGE_SIZE / sizeof(adma2_descriptor);
 			uint32 count = 0;
-			phys_addr_t address = physical;
-			size_t remaining = length;
-			while (remaining > 0) {
-				if (count >= maxDescriptors)
+			size_t total = 0;
+			const uint32 rangeCount = vecs != NULL ? vecCount : 1;
+			for (uint32 i = 0; i < rangeCount; i++) {
+				phys_addr_t address = vecs != NULL ? vecs[i].base : physical;
+				size_t remaining = vecs != NULL ? vecs[i].length : length;
+				if ((address & 3) != 0 || (remaining & 3) != 0
+					|| (uint64)address + remaining > 0x100000000ULL) {
 					return B_BAD_VALUE;
-				size_t chunk = std::min(remaining, kAdma2MaxTransferLength);
-				adma2_descriptor& descriptor = fDmaDescriptors[count++];
-				descriptor.attributes = kAdma2Valid | kAdma2ActTran;
-				descriptor.length = chunk;
-				descriptor.address = (uint32)address;
-				address += chunk;
-				remaining -= chunk;
+				}
+				total += remaining;
+				while (remaining > 0) {
+					if (count >= maxDescriptors)
+						return B_BAD_VALUE;
+					size_t chunk = std::min(remaining, kAdma2MaxTransferLength);
+					adma2_descriptor& descriptor = fDmaDescriptors[count++];
+					descriptor.attributes = kAdma2Valid | kAdma2ActTran;
+					descriptor.length = chunk;
+					descriptor.address = (uint32)address;
+					address += chunk;
+					remaining -= chunk;
+				}
 			}
+			if (count == 0 || total != length)
+				return B_BAD_VALUE;
 			// The last descriptor ends the table
 			fDmaDescriptors[count - 1].attributes |= kAdma2End | kAdma2Interrupt;
 
@@ -1031,10 +1049,15 @@ SdhciBus::_TransferChunk(uint8 command, uint32 argument, uint32 blockCount,
 	// buffer has to be made coherent with the caches by hand. The barrier
 	// makes sure the descriptors are in memory before the transfer starts.
 	const bool cachedBuffer = dataMode != kDataModePio
-		&& (physical < fDmaDescriptorsPhysical
+		&& (vecs != NULL || physical < fDmaDescriptorsPhysical
 			|| physical >= fDmaDescriptorsPhysical + 2 * B_PAGE_SIZE);
-	if (cachedBuffer)
-		sync_dma_buffer(physical, length, isWrite);
+	if (cachedBuffer) {
+		if (vecs != NULL) {
+			for (uint32 i = 0; i < vecCount; i++)
+				sync_dma_buffer(vecs[i].base, vecs[i].length, isWrite);
+		} else
+			sync_dma_buffer(physical, length, isWrite);
+	}
 	asm volatile ("dsb" : : : "memory");
 #endif
 
@@ -1208,8 +1231,13 @@ SdhciBus::_TransferChunk(uint8 command, uint32 argument, uint32 blockCount,
 	fRegisters->interrupt_status = kDataStatusBits;
 
 #ifdef __ARM__
-	if (cachedBuffer && !isWrite)
-		sync_dma_buffer(physical, length, false);
+	if (cachedBuffer && !isWrite) {
+		if (vecs != NULL) {
+			for (uint32 i = 0; i < vecCount; i++)
+				sync_dma_buffer(vecs[i].base, vecs[i].length, false);
+		} else
+			sync_dma_buffer(physical, length, false);
+	}
 #endif
 	return B_OK;
 }
@@ -1218,7 +1246,8 @@ SdhciBus::_TransferChunk(uint8 command, uint32 argument, uint32 blockCount,
 status_t
 SdhciBus::_TransferBlocks(bool isWrite, uint32 argument, uint32 argumentStep,
 	uint32 blockCount, int dataMode, int stopMode, phys_addr_t physical,
-	uint8* buffer, bigtime_t timeout)
+	uint8* buffer, bigtime_t timeout, const generic_io_vec* vecs,
+	uint32 vecCount)
 {
 	if (stopMode == kStopModeSingle) {
 		uint8 command = isWrite ? SD_WRITE_SINGLE_BLOCK : SD_READ_SINGLE_BLOCK;
@@ -1251,7 +1280,7 @@ SdhciBus::_TransferBlocks(bool isWrite, uint32 argument, uint32 argumentStep,
 
 	uint8 command = isWrite ? SD_WRITE_MULTIPLE_BLOCKS : SD_READ_MULTIPLE_BLOCKS;
 	return _TransferChunk(command, argument, blockCount, kBlockSize, isWrite,
-		dataMode, stopMode, physical, buffer, timeout);
+		dataMode, stopMode, physical, buffer, timeout, vecs, vecCount);
 }
 
 
@@ -1676,6 +1705,39 @@ SdhciBus::DoIO(uint8_t command, IOOperation* operation, bool offsetAsSectors)
 	const generic_io_vec* vecs = operation->Vecs();
 	generic_size_t vecOffset = 0;
 
+	// ADMA2 gathers the physical ranges of the whole operation in one
+	// descriptor table: one command instead of one per range (often a single
+	// page), whose overhead dominated the transfer time.
+	if (fDataMode == kDataModeAdma2 && fStopMode != kStopModeSingle) {
+		uint32 vecCount = operation->VecCount();
+		generic_size_t total = 0;
+		for (uint32 i = 0; i < vecCount; i++)
+			total += vecs[i].length;
+		if (vecCount > 1 && total == length && length / kBlockSize <= 0xffff) {
+			uint32 argument = offset / (offsetAsSectors ? kBlockSize : 1);
+			status_t status = _TransferBlocks(isWrite, argument,
+				offsetAsSectors ? 1 : kBlockSize, length / kBlockSize,
+				fDataMode, fStopMode, 0, NULL, kTransferTimeout, vecs,
+				vecCount);
+			static int32 sGatherLogCount = 0;
+			if (atomic_add(&sGatherLogCount, 1) < 3) {
+				TRACE_ALWAYS("%s of %" B_PRIuGENADDR " bytes in %" B_PRIu32
+					" ranges as one ADMA2 transfer: %s\n",
+					isWrite ? "write" : "read", length, vecCount,
+					strerror(status));
+			}
+			if (status == B_OK)
+				return B_OK;
+			if (status != B_BAD_VALUE) {
+				ERROR("%s of %" B_PRIuGENADDR " bytes in %" B_PRIu32 " ranges at %"
+					B_PRIdOFF " failed: %s\n", isWrite ? "write" : "read",
+					length, vecCount, offset, strerror(status));
+				return status;
+			}
+			// the ranges did not fit the descriptor table: one by one
+		}
+	}
+
 	while (length > 0) {
 		size_t toCopy = std::min((generic_size_t)length,
 			vecs->length - vecOffset);
diff --git a/src/add-ons/kernel/busses/mmc/sdhci.h b/src/add-ons/kernel/busses/mmc/sdhci.h
index 5cec972c62..735866590a 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci.h
+++ b/src/add-ons/kernel/busses/mmc/sdhci.h
@@ -19,6 +19,9 @@
 #include "mmc.h"
 
 
+struct generic_io_vec;
+
+
 // A single entry of the ADMA2 descriptor table, in the 32-bit address format.
 // See SD Host Controller Simplified Specification, section 1.13.
 struct adma2_descriptor {
@@ -130,12 +133,16 @@ class SdhciBus {
 									uint32 blockSize, bool isWrite,
 									int dataMode, int stopMode,
 									phys_addr_t physical, uint8* buffer,
-									bigtime_t timeout);
+									bigtime_t timeout,
+									const generic_io_vec* vecs = NULL,
+									uint32 vecCount = 0);
 			status_t			_TransferBlocks(bool isWrite,
 									uint32 argument, uint32 argumentStep,
 									uint32 blockCount, int dataMode,
 									int stopMode, phys_addr_t physical,
-									uint8* buffer, bigtime_t timeout);
+									uint8* buffer, bigtime_t timeout,
+									const generic_io_vec* vecs = NULL,
+									uint32 vecCount = 0);
 			void				_AbortTransfer(const char* reason);
 			void				_LogCardStatus(const char* when,
 									uint32 status);
diff --git a/src/add-ons/kernel/busses/mmc/sdhci_acpi.cpp b/src/add-ons/kernel/busses/mmc/sdhci_acpi.cpp
index b79495cce8..0c07222c2b 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci_acpi.cpp
+++ b/src/add-ons/kernel/busses/mmc/sdhci_acpi.cpp
@@ -164,7 +164,8 @@ register_child_devices_acpi(void* cookie)
 		{ B_DMA_ALIGNMENT, B_UINT32_TYPE, { .ui32 = 511 }},
 		{ B_DMA_HIGH_ADDRESS, B_UINT64_TYPE, { .ui64 = 0x100000000LL }},
 		{ B_DMA_BOUNDARY, B_UINT32_TYPE, { .ui32 = (1 << 19) - 1 }},
-		{ B_DMA_MAX_SEGMENT_COUNT, B_UINT32_TYPE, { .ui32 = 1 }},
+		// ADMA2 takes them all in one command (see SdhciBus::DoIO())
+		{ B_DMA_MAX_SEGMENT_COUNT, B_UINT32_TYPE, { .ui32 = 128 }},
 		{ B_DMA_MAX_SEGMENT_BLOCKS, B_UINT32_TYPE, { .ui32 = (1 << 10) - 1 }},
 
 		// private data to identify device
diff --git a/src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp b/src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp
index 6eece5582d..f6ca39c8d7 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp
+++ b/src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp
@@ -395,7 +395,8 @@ register_child_devices_fdt(void* cookie)
 		{ B_DMA_ALIGNMENT, B_UINT32_TYPE, { .ui32 = 511 } },
 		{ B_DMA_HIGH_ADDRESS, B_UINT64_TYPE, { .ui64 = 0x100000000LL } },
 		{ B_DMA_BOUNDARY, B_UINT32_TYPE, { .ui32 = (1 << 19) - 1 } },
-		{ B_DMA_MAX_SEGMENT_COUNT, B_UINT32_TYPE, { .ui32 = 1 } },
+		// ADMA2 takes them all in one command (see SdhciBus::DoIO())
