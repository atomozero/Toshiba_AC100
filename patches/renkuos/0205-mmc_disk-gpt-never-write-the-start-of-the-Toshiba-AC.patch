From c95334f61b4044654f0e12c18d697a3670e75bb9 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 24 Oct 2026 13:58:46 +0200
Subject: [PATCH 205/270] mmc_disk, gpt: never write the start of the Toshiba
 AC100 eMMC

The NVIDIA Tegra 2 of the AC100 boots from the start of the eMMC (BCT,
partition table, bootloader), followed by Android's recovery and boot
images and its partition table: no MBR or primary GPT can go there, and
a stray write may leave the machine unable to start from the eMMC.
Haiku is installed from 16 MB on, described by a GPT that only exists as
the backup table at the end of the disk.

- mmc_disk: on the AC100 (device tree compatible "compal,paz00") refuse
  writes and trims in the first 16 MB of the eMMC; "emmc_protect_mb" in
  the driver settings moves the limit, 0 switches it off.
- gpt: when only the backup table is valid, use it and never write the
  primary header, its entries or the protective MBR: entry changes go to
  the backup table only, rewriting the whole table is refused.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/drivers/disk/mmc/Jamfile   |  9 +++
 .../kernel/drivers/disk/mmc/mmc_disk.cpp      | 65 ++++++++++++++++++-
 .../kernel/drivers/disk/mmc/mmc_disk.h        |  3 +
 .../partitioning_systems/gpt/Header.cpp       | 39 +++++++----
 .../kernel/partitioning_systems/gpt/Header.h  |  3 +
 5 files changed, 106 insertions(+), 13 deletions(-)

diff --git a/src/add-ons/kernel/drivers/disk/mmc/Jamfile b/src/add-ons/kernel/drivers/disk/mmc/Jamfile
index 9849a2d76c..c3b0af5a9d 100644
--- a/src/add-ons/kernel/drivers/disk/mmc/Jamfile
+++ b/src/add-ons/kernel/drivers/disk/mmc/Jamfile
@@ -4,6 +4,15 @@ UsePrivateKernelHeaders ;
 UsePrivateHeaders drivers ;
 SubDirHdrs $(HAIKU_TOP) src system kernel device_manager ;
 
+# the eMMC protection of the Toshiba AC100 checks the device tree
+local fdtLibrary ;
+if $(TARGET_ARCH) = arm {
+	UseLibraryHeaders [ FDirName libfdt ] ;
+	fdtLibrary = kernel_fdt.a ;
+}
+
 KernelAddon mmc_disk :
 	mmc_disk.cpp
+	:
+	$(fdtLibrary)
 ;
diff --git a/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp b/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp
index df88247a43..9d64cd0c6b 100644
--- a/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp
+++ b/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp
@@ -28,6 +28,13 @@
 
 #include <AutoDeleter.h>
 
+#ifdef __ARM__
+extern "C" {
+#include <libfdt.h>
+}
+extern void* gFDT;
+#endif
+
 
 // Verbose tracing, including one line per read and write call. That also
 // fills the syslog fast enough to push the boot messages out of it.
@@ -198,6 +205,49 @@ mmc_disk_register_device(device_node* node)
 }
 
 
+/*!	The internal eMMC of the Toshiba AC100 starts with what its NVIDIA Tegra 2
+	boots from (BCT, partition table, bootloader), then Android's recovery and
+	boot images and its partition table: no partition table can be written
+	there, and a write there may leave the machine unable to start from the
+	eMMC. Haiku lives from 16 MB on, so the first 16 MB are never written,
+	whatever asks for it. The settings can move the limit
+	("emmc_protect_mb 0" switches it off).
+*/
+static off_t
+mmc_disk_protected_size(void* settings)
+{
+#ifdef __ARM__
+	if (gFDT == NULL
+		|| fdt_node_check_compatible(gFDT, 0, "compal,paz00") != 0) {
+		return 0;
+	}
+	const char* value = get_driver_parameter(settings, "emmc_protect_mb", NULL,
+		NULL);
+	off_t megabytes = value != NULL ? strtoll(value, NULL, 10) : 16;
+	return megabytes > 0 ? megabytes * 1024 * 1024 : 0;
+#else
+	(void)settings;
+	return 0;
+#endif
+}
+
+
+static bool
+mmc_disk_write_allowed(mmc_disk_driver_info* info, off_t offset)
+{
+	if (offset >= info->protectedEnd)
+		return true;
+
+	static int32 sRefusedCount = 0;
+	if (atomic_add(&sRefusedCount, 1) < 10) {
+		dprintf("mmc_disk: refused a write at %" B_PRIdOFF ", in the protected "
+			"first %" B_PRIdOFF " MB of the eMMC\n", offset,
+			info->protectedEnd / 1024 / 1024);
+	}
+	return false;
+}
+
+
 static status_t
 mmc_disk_execute_iorequest(void* data, IOOperation* operation)
 {
@@ -208,6 +258,11 @@ mmc_disk_execute_iorequest(void* data, IOOperation* operation)
 		info->scheduler->OperationCompleted(operation, B_READ_ONLY_DEVICE, 0);
 		return B_READ_ONLY_DEVICE;
 	}
+	if (operation->IsWrite()
+		&& !mmc_disk_write_allowed(info, operation->Offset())) {
+		info->scheduler->OperationCompleted(operation, B_PERMISSION_DENIED, 0);
+		return B_PERMISSION_DENIED;
+	}
 
 	uint8_t command;
 	if (operation->IsWrite()) {
@@ -870,6 +925,7 @@ mmc_disk_init_driver(device_node* node, void** cookie)
 	info->cacheEnabled = false;
 	info->wantCache = true;
 	info->cacheDirty = 0;
+	info->protectedEnd = 0;
 
 	if (info->isMMC) {
 		// Options in /boot/home/config/settings/kernel/drivers/mmc_disk:
@@ -878,6 +934,7 @@ mmc_disk_init_driver(device_node* node, void** cookie)
 		//   emmc_bus_width 4			widest bus to try
 		bool writeEnable = true;
 		void* handle = load_driver_settings("mmc_disk");
+		info->protectedEnd = mmc_disk_protected_size(handle);
 		if (handle != NULL) {
 			writeEnable = get_driver_boolean_parameter(handle,
 				"emmc_write_enable", true, true);
@@ -913,6 +970,10 @@ mmc_disk_init_driver(device_node* node, void** cookie)
 			unload_driver_settings(handle);
 		}
 		info->readOnly = !writeEnable;
+		if (info->protectedEnd > 0) {
+			dprintf("mmc_disk: Toshiba AC100 eMMC, the first %" B_PRIdOFF
+				" MB are never written\n", info->protectedEnd / 1024 / 1024);
+		}
 
 		TRACE("eMMC device, RCA %u, %s addressing, %s, bus width up to %d "
 			"bits, speed up to %s, write cache %s%s\n", info->rca,
@@ -1185,13 +1246,15 @@ mmc_block_trim(mmc_disk_driver_info* info, fs_trim_data* trimData)
 	STATIC_ASSERT(sizeof(deviceSize) <= sizeof(uint64));
 	ASSERT(deviceSize >= 0);
 
-	// Do not trim past device end
+	// Do not trim past device end, nor in the protected area
 	for (uint32 i = 0; i < trimData->range_count; i++) {
 		uint64 offset = trimData->ranges[i].offset;
 		uint64& size = trimData->ranges[i].size;
 
 		if (offset >= (uint64)deviceSize)
 			return B_BAD_VALUE;
+		if (!mmc_disk_write_allowed(info, (off_t)offset))
+			return B_PERMISSION_DENIED;
 		size = min_c(size, (uint64)deviceSize - offset);
 	}
 
diff --git a/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.h b/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.h
index f0d2f5ea9a..167a09e492 100644
--- a/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.h
+++ b/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.h
@@ -50,6 +50,9 @@ typedef struct {
 	bool cacheEnabled;
 		// The volatile write cache is on: writes must be flushed
 	int32 cacheDirty;
+	off_t protectedEnd;
+		// writes and trims below this offset are refused (see
+		// mmc_disk_protected_size())
 		// Something was written since the last flush
 
 	device_geometry geometry;
diff --git a/src/add-ons/kernel/partitioning_systems/gpt/Header.cpp b/src/add-ons/kernel/partitioning_systems/gpt/Header.cpp
index cd0c2e6c3a..c9a05da5df 100644
--- a/src/add-ons/kernel/partitioning_systems/gpt/Header.cpp
+++ b/src/add-ons/kernel/partitioning_systems/gpt/Header.cpp
@@ -52,7 +52,8 @@ Header::Header(int fd, uint64 lastBlock, uint32 blockSize)
 	fBlockSize(blockSize),
 	fStatus(B_NO_INIT),
 	fEntries(NULL),
-	fDirty(false)
+	fDirty(false),
+	fBackupOnly(false)
 {
 	// TODO: check the correctness of the protective MBR and warn if invalid
 
@@ -84,12 +85,18 @@ Header::Header(int fd, uint64 lastBlock, uint32 blockSize)
 		return;
 
 	if (fStatus != B_OK) {
-		// Recreate primary header from the backup
+		// Use the backup table, and keep it the only one: on some machines
+		// the start of the disk belongs to something else (on NVIDIA Tegra
+		// systems, what the chip boots from), and a GPT is only kept at the
+		// end of the disk. So the primary header is never written back.
 		fHeader = fBackupHeader;
 		fHeader.SetAbsoluteBlock(EFI_HEADER_LOCATION);
 		fHeader.SetEntriesBlock(EFI_PARTITION_ENTRIES_BLOCK);
 		fHeader.SetAlternateBlock(lastBlock);
 		fDirty = true;
+		fBackupOnly = true;
+		dprintf("gpt: only the backup table at block %" B_PRIu64 " is valid, "
+			"the start of the disk will not be written\n", lastBlock);
 	} else if (status != B_OK) {
 		// Recreate backup header from primary
 		_SetBackupHeaderFromPrimary(lastBlock);
@@ -138,7 +145,8 @@ Header::Header(uint64 lastBlock, uint32 blockSize)
 	fBlockSize(blockSize),
 	fStatus(B_NO_INIT),
 	fEntries(NULL),
-	fDirty(true)
+	fDirty(true),
+	fBackupOnly(false)
 {
 	TRACE(("EFI::Header: Initialize GPT, block size %" B_PRIu32 "\n",
 		blockSize));
@@ -210,11 +218,13 @@ Header::WriteEntry(int fd, uint32 entryIndex)
 {
 	off_t entryOffset = entryIndex * fHeader.EntrySize();
 
-	status_t status = _Write(fd,
-		fHeader.EntriesBlock() * fBlockSize + entryOffset,
-		fEntries + entryOffset, fHeader.EntrySize());
-	if (status != B_OK)
-		return status;
+	status_t status = B_OK;
+	if (!fBackupOnly) {
+		status = _Write(fd, fHeader.EntriesBlock() * fBlockSize + entryOffset,
+			fEntries + entryOffset, fHeader.EntrySize());
+		if (status != B_OK)
+			return status;
+	}
 
 	// Update header, too -- the entries CRC changed
 	status = _WriteHeader(fd);
@@ -233,6 +243,9 @@ Header::WriteEntry(int fd, uint32 entryIndex)
 status_t
 Header::Write(int fd)
 {
+	if (fBackupOnly)
+		return B_NOT_ALLOWED;
+
 	// Try to write the protective MBR
 	PartitionMap partitionMap;
 	PrimaryPartition *partition = NULL;
@@ -277,10 +290,12 @@ Header::_WriteHeader(int fd)
 {
 	_UpdateCRC();
 
-	status_t status = _Write(fd, fHeader.AbsoluteBlock() * fBlockSize,
-		&fHeader, sizeof(gpt_table_header));
-	if (status != B_OK)
-		return status;
+	if (!fBackupOnly) {
+		status_t status = _Write(fd, fHeader.AbsoluteBlock() * fBlockSize,
+			&fHeader, sizeof(gpt_table_header));
+		if (status != B_OK)
+			return status;
+	}
 
 	return _Write(fd, fBackupHeader.AbsoluteBlock() * fBlockSize,
 		&fBackupHeader, sizeof(gpt_table_header));
diff --git a/src/add-ons/kernel/partitioning_systems/gpt/Header.h b/src/add-ons/kernel/partitioning_systems/gpt/Header.h
index eee0c153e5..a2cb925c12 100644
--- a/src/add-ons/kernel/partitioning_systems/gpt/Header.h
+++ b/src/add-ons/kernel/partitioning_systems/gpt/Header.h
@@ -76,6 +76,9 @@ private:
 			gpt_table_header	fBackupHeader;
 			uint8*				fEntries;
 			bool				fDirty;
+			bool				fBackupOnly;
+				// only the backup table is valid: the start of the disk
+				// holds something else and is never written
 };
 
 
