From 99d7addc2f14588b4b9485a56d19c9ae4989e15a Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 25 Oct 2026 14:35:55 +0100
Subject: [PATCH 220/270] ARM bring-up: log the port and hub status when a
 device is removed (not for merging)

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/bus_managers/usb/Hub.cpp | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/src/add-ons/kernel/bus_managers/usb/Hub.cpp b/src/add-ons/kernel/bus_managers/usb/Hub.cpp
index 6f1066bae5..a7ddd96be3 100644
--- a/src/add-ons/kernel/bus_managers/usb/Hub.cpp
+++ b/src/add-ons/kernel/bus_managers/usb/Hub.cpp
@@ -566,6 +566,23 @@ Hub::Explore(change_item **changeList)
 			} else {
 				// Device removed...
 				TRACE_ALWAYS("port %" B_PRId32 ": device removed\n", i);
+#ifdef __arm__
+				{
+					// AC100 bring-up: why did the device go away? An over
+					// current shows in the port or in the hub status.
+					uint16 hubStatus[2] = { 0, 0 };
+					size_t actualLength = 0;
+					DefaultPipe()->SendRequest(USB_REQTYPE_CLASS
+						| USB_REQTYPE_DEVICE_IN, USB_REQUEST_GET_STATUS, 0, 0,
+						sizeof(hubStatus), hubStatus, sizeof(hubStatus),
+						&actualLength);
+					dprintf("AC100: usb hub %d port %" B_PRId32 " removal: "
+						"status 0x%x, change 0x%x, hub status 0x%x, change "
+						"0x%x\n", DeviceAddress(), i + 1,
+						fPortStatus[i].status, fPortStatus[i].change,
+						hubStatus[0], hubStatus[1]);
+				}
+#endif
 				if (fChildren[i] != NULL) {
 					TRACE("removing device %p\n", fChildren[i]);
 					fChildren[i]->Changed(changeList, false);
