+status_t
+init_hardware(void)
+{
+	uint8 version;
+	status_t status = arm_dvc_i2c_read(TPS6586X_ADDRESS, TPS6586X_VERSIONCRC,
+		&version, 1);
+	if (status != B_OK)
+		return status;
+	TRACE_ALWAYS("TPS6586x version %#x\n", version);
+	return B_OK;
+}
