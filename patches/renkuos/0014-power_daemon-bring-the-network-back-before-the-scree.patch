From 263c664694aed5f6ce526502f58f414cb17cddb9 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Thu, 19 Nov 2026 22:19:28 +0100
Subject: [PATCH 14/32] power_daemon: bring the network back before the screen
 when the lid opens

Waking the screen waits for the app_server; the network should not wait
for it.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/servers/power/lid_monitor.cpp | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/servers/power/lid_monitor.cpp b/src/servers/power/lid_monitor.cpp
index 52858c208b..4447365f93 100644
--- a/src/servers/power/lid_monitor.cpp
+++ b/src/servers/power/lid_monitor.cpp
@@ -58,7 +58,8 @@ LidMonitor::LidMonitor()
 {
 	DIR* dir = opendir(kPowerDevices);
 	if (dir != NULL) {
-		while (dirent* entry = readdir(dir)) {
+		dirent* entry;
+		while ((entry = readdir(dir)) != NULL) {
 			size_t length = strlen(entry->d_name);
 			if (length < 4 || strcmp(entry->d_name + length - 4, "_lid") != 0)
 				continue;
@@ -157,8 +158,6 @@ LidMonitor::_LidClosed()
 void
 LidMonitor::_LidOpened()
 {
-	set_screen_power(true);
-
 	if (fSchedulerMode >= 0) {
 		set_scheduler_mode(fSchedulerMode);
 		fSchedulerMode = -1;
@@ -172,4 +171,7 @@ LidMonitor::_LidOpened()
 		interface.AutoConfigure(AF_INET);
 	}
 	fInterfacesDown.MakeEmpty();
+
+	// last, as it waits for the app_server
+	set_screen_power(true);
 }
