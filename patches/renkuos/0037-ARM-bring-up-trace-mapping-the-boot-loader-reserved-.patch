From 2d65d0d8bc0bf0bf942ac3366efa6bb1af94c901 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 19:12:57 +0200
Subject: [PATCH 037/203] ARM bring-up: trace mapping the boot loader reserved
 areas (not for merging)

---
 src/system/kernel/vm/vm.cpp | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/system/kernel/vm/vm.cpp b/src/system/kernel/vm/vm.cpp
index a42274e19c..2263c9c181 100644
--- a/src/system/kernel/vm/vm.cpp
+++ b/src/system/kernel/vm/vm.cpp
@@ -1961,6 +1961,11 @@ vm_map_physical_memory(team_id team, const char* name, void** _address,
 		B_PRIu32 ", phys = %#" B_PRIxPHYSADDR ")\n", team, name, *_address,
 		addressSpec, size, protection, physicalAddress));
 
+	const bool trace = strcmp(name, "boot loader reserved area") == 0;
+	if (trace) {
+		dprintf("AC100:   map physical %#" B_PRIxPHYSADDR ", size %#" B_PRIxADDR
+			"\n", physicalAddress, size);
+	}
 	status_t status = check_protection(team, &protection);
 	if (status != B_OK)
 		return status;
@@ -1997,6 +2002,8 @@ vm_map_physical_memory(team_id team, const char* name, void** _address,
 		cache->ReleaseRefLocked();
 
 	cache->Unlock();
+	if (trace)
+		dprintf("AC100:   vm_map_cache: %#" B_PRIx32 "\n", status);
 
 	if (status == B_OK) {
 		// Set requested memory type -- default to uncached, but allow
@@ -2023,9 +2030,15 @@ vm_map_physical_memory(team_id team, const char* name, void** _address,
 	if (alreadyWired) {
 		// The area is already mapped, but possibly not with the right
 		// memory type.
+		if (trace)
+			dprintf("AC100:   ProtectArea\n");
 		map->Lock();
 		map->ProtectArea(area, area->protection);
+		if (trace)
+			dprintf("AC100:   ProtectArea done, unlock (flush)\n");
 		map->Unlock();
+		if (trace)
+			dprintf("AC100:   unlocked\n");
 	} else {
 		// Map the area completely.
 
