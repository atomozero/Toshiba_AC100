From 5513588ad0cda020a84c153a3183bd6a65f8525c Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 18:29:12 +0200
Subject: [PATCH 032/203] ARM bring-up: look for other mappings of the stack
 page on panic, show only the first fault (not for merging)

---
 .../private/kernel/arch/arm/arm_boot_marker.h |  1 +
 src/system/kernel/arch/arm/arch_cpu.cpp       | 33 +++++++++++++++++++
 src/system/kernel/arch/arm/arch_int.cpp       |  7 ++--
 src/system/kernel/debug/debug.cpp             |  1 +
 4 files changed, 40 insertions(+), 2 deletions(-)

diff --git a/headers/private/kernel/arch/arm/arm_boot_marker.h b/headers/private/kernel/arch/arm/arm_boot_marker.h
index fb550af04a..80b8d2522e 100644
--- a/headers/private/kernel/arch/arm/arm_boot_marker.h
+++ b/headers/private/kernel/arch/arm/arm_boot_marker.h
@@ -129,6 +129,7 @@ void arm_boot_marker_value(int row, uint32 value);
 void arm_boot_marker_text(const char* text);
 void arm_boot_check_text(int row);
 void arm_boot_show_exceptions(int row);
+void arm_boot_find_stack_aliases(int row);
 /* hardware translation (ATS1CPR), 0xfa000000 | fault status if none */
 uint32 arm_virtual_to_physical(addr_t address);
 #endif
diff --git a/src/system/kernel/arch/arm/arch_cpu.cpp b/src/system/kernel/arch/arm/arch_cpu.cpp
index eac9b4b83d..c891e6bda4 100644
--- a/src/system/kernel/arch/arm/arch_cpu.cpp
+++ b/src/system/kernel/arch/arm/arch_cpu.cpp
@@ -159,6 +159,39 @@ arm_boot_check_text(int row)
 }
 
 
+/*!	Asks the MMU for every page of the address space and shows, starting at
+	\a row, the physical page of the current stack, how many virtual pages map
+	to it, and the first three of them.
+*/
+void
+arm_boot_find_stack_aliases(int row)
+{
+	addr_t stack = ROUNDDOWN((addr_t)__builtin_frame_address(0), B_PAGE_SIZE);
+	uint32 target = arm_virtual_to_physical(stack) & ~(B_PAGE_SIZE - 1);
+	uint32 aliases[3] = { 0, 0, 0 };
+	uint32 count = 0;
+
+	addr_t address = 0;
+	do {
+		uint32 physical = arm_virtual_to_physical(address);
+		if ((physical & 0xff000000) != 0xfa000000
+			&& (physical & ~(B_PAGE_SIZE - 1)) == target) {
+			// list the other mappings first, the stack itself is known
+			if (address != stack && count < 3)
+				aliases[count] = address;
+			if (address != stack)
+				count++;
+		}
+		address += B_PAGE_SIZE;
+	} while (address != 0);
+
+	arm_boot_marker_value(row, target);
+	arm_boot_marker_value(row + 1, count);
+	arm_boot_marker_value(row + 2, aliases[0]);
+	arm_boot_marker_value(row + 3, aliases[1]);
+}
+
+
 status_t
 arch_cpu_preboot_init_percpu(kernel_args *args, int curr_cpu)
 {
diff --git a/src/system/kernel/arch/arm/arch_int.cpp b/src/system/kernel/arch/arm/arch_int.cpp
index b688bed9cf..4437ed4e72 100644
--- a/src/system/kernel/arch/arm/arch_int.cpp
+++ b/src/system/kernel/arch/arm/arch_int.cpp
@@ -420,8 +420,11 @@ arch_arm_page_fault(struct iframe *frame, addr_t far, uint32 fsr, bool isWrite,
 		return;
 	}
 
-	if (gKernelStartup) {
-		// bring-up aid: page faults are unexpected this early
+	static bool sFaultShown = false;
+	if (gKernelStartup && !sFaultShown) {
+		// bring-up aid: page faults are unexpected this early; only the first
+		// one is shown, later ones would hide it
+		sFaultShown = true;
 		arm_boot_marker(33);
 		arm_boot_marker_value(4, far);
 		arm_boot_marker_value(5, frame->pc);
diff --git a/src/system/kernel/debug/debug.cpp b/src/system/kernel/debug/debug.cpp
index 79a37f7c0f..61abe85889 100644
--- a/src/system/kernel/debug/debug.cpp
+++ b/src/system/kernel/debug/debug.cpp
@@ -2146,6 +2146,7 @@ panic(const char* format, ...)
 			asm volatile ("cpsid aif");
 			sPanicShown = true;
 			arm_boot_marker(34);
+			arm_boot_find_stack_aliases(110);
 			arm_boot_check_text(203);
 			arm_boot_show_exceptions(303);
 			arm_boot_marker_value(3,
