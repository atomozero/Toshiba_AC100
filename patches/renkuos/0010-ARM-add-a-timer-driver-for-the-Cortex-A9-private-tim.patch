diff --git a/src/system/kernel/arch/arm/arch_timer_a9_twd.cpp b/src/system/kernel/arch/arm/arch_timer_a9_twd.cpp
new file mode 100644
index 0000000000..949a267107
--- /dev/null
+++ b/src/system/kernel/arch/arm/arch_timer_a9_twd.cpp
@@ -0,0 +1,191 @@
+/*
+ * Copyright 2026, Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "arch_timer_a9_twd.h"
+
+#include <KernelExport.h>
+#include <timer.h>
+#include <vm/vm.h>
+
+
+// Register offsets, in bytes, from the private timer base
+#define TWD_LOAD				0x00
+#define TWD_COUNTER				0x04
+#define TWD_CONTROL				0x08
+#define TWD_INTERRUPT_STATUS	0x0c
+
+#define TWD_CONTROL_ENABLE		(1U << 0)
+#define TWD_CONTROL_IRQ_ENABLE	(1U << 2)
+
+#define TWD_MAX_LOAD			0xffffffffU
+
+
+static inline uint32
+read_reg(volatile uint32* regs, uint32 offset)
+{
+	return regs[offset / sizeof(uint32)];
+}
+
+
+static inline void
+write_reg(volatile uint32* regs, uint32 offset, uint32 value)
+{
+	regs[offset / sizeof(uint32)] = value;
+}
+
+
+A9TWDTimer::A9TWDTimer(phys_addr_t regBase, uint32 interrupt,
+	uint32 frequency)
+	:
+	fInterrupt(interrupt),
+	fFrequency(frequency),
+	fLock(B_SPINLOCK_INITIALIZER),
+	fBaseTicks(0),
+	fLoaded(0),
+	fEventArmed(false),
+	fEventTicks(0)
+{
+	if (fFrequency == 0)
+		panic("A9 TWD timer: unknown frequency!");
+
+	fRegArea = vm_map_physical_memory(B_SYSTEM_TEAM, "timer-a9-twd",
+		(void**)&fRegs, B_ANY_KERNEL_ADDRESS, B_PAGE_SIZE,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+		ROUNDDOWN(regBase, B_PAGE_SIZE), false);
+	if (fRegArea < 0)
+		panic("Cannot map A9 TWD timer registers!");
+	fRegs += (regBase % B_PAGE_SIZE) / sizeof(uint32);
+
+	dprintf("A9 TWD: timer @ %#" B_PRIxPHYSADDR ", IRQ %" B_PRId32 ", %" B_PRIu32
+		" Hz\n", regBase, fInterrupt, fFrequency);
+
+	write_reg(fRegs, TWD_CONTROL, 0);
+	write_reg(fRegs, TWD_INTERRUPT_STATUS, 1);
+	install_io_interrupt_handler(fInterrupt, &A9TWDTimer::_HandleInterrupt,
+		this, 0);
+
+	// start counting right away, the clock must run even without events
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&fLock);
+	_LoadLocked(TWD_MAX_LOAD);
+	write_reg(fRegs, TWD_CONTROL, TWD_CONTROL_ENABLE | TWD_CONTROL_IRQ_ENABLE);
+	release_spinlock(&fLock);
+	restore_interrupts(state);
+}
+
+
+void
+A9TWDTimer::SetTimeout(bigtime_t timeout)
+{
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&fLock);
+
+	uint64 ticks;
+	if (timeout >= _ToTime(TWD_MAX_LOAD))
+		ticks = TWD_MAX_LOAD;
+	else if (timeout <= 0)
+		ticks = 1;
+	else
+		ticks = max_c(_ToTicks(timeout), 1);
+
+	_LoadLocked((uint32)ticks);
+	fEventArmed = true;
+	fEventTicks = fBaseTicks + ticks;
+
+	release_spinlock(&fLock);
+	restore_interrupts(state);
+}
+
+
+bigtime_t
+A9TWDTimer::Time()
+{
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&fLock);
+
+	uint64 ticks = _TicksLocked();
+
+	release_spinlock(&fLock);
+	restore_interrupts(state);
+
+	return _ToTime(ticks);
+}
+
+
+void
+A9TWDTimer::Clear()
+{
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&fLock);
+
+	fEventArmed = false;
+	_LoadLocked(TWD_MAX_LOAD);
+
+	release_spinlock(&fLock);
+	restore_interrupts(state);
+}
+
+
+uint64
+A9TWDTimer::_TicksLocked()
+{
+	// In single shot mode the counter stops at 0 once the load has elapsed
+	return fBaseTicks + (fLoaded - read_reg(fRegs, TWD_COUNTER));
+}
+
+
+void
+A9TWDTimer::_LoadLocked(uint32 ticks)
+{
+	fBaseTicks = _TicksLocked();
+	fLoaded = ticks;
+	// writing the load register also reloads the counter
+	write_reg(fRegs, TWD_LOAD, ticks);
+}
+
+
+uint64
+A9TWDTimer::_ToTicks(bigtime_t time) const
+{
+	return (uint64)time / 1000000 * fFrequency
+		+ (uint64)time % 1000000 * fFrequency / 1000000;
+}
+
+
+bigtime_t
+A9TWDTimer::_ToTime(uint64 ticks) const
+{
+	return ticks / fFrequency * 1000000
+		+ ticks % fFrequency * 1000000 / fFrequency;
+}
+
+
+int32
+A9TWDTimer::_HandleInterrupt(void* data)
+{
+	A9TWDTimer* timer = (A9TWDTimer*)data;
+
+	acquire_spinlock(&timer->fLock);
+
+	write_reg(timer->fRegs, TWD_INTERRUPT_STATUS, 1);
+
+	// The interrupt may be stale if the counter was reloaded meanwhile; only
+	// act on an expired load.
+	bool expired = read_reg(timer->fRegs, TWD_COUNTER) == 0;
+	bool eventDue = timer->fEventArmed
+		&& timer->_TicksLocked() >= timer->fEventTicks;
+
+	if (eventDue)
+		timer->fEventArmed = false;
+	if (expired) {
+		// keep the clock running until the next SetTimeout()
+		timer->_LoadLocked(TWD_MAX_LOAD);
+	}
+
+	release_spinlock(&timer->fLock);
+
+	return eventDue ? timer_interrupt() : B_HANDLED_INTERRUPT;
+}
diff --git a/src/system/kernel/arch/arm/arch_timer_a9_twd.h b/src/system/kernel/arch/arm/arch_timer_a9_twd.h
new file mode 100644
index 0000000000..ae1b8b6401
--- /dev/null
+++ b/src/system/kernel/arch/arm/arch_timer_a9_twd.h
@@ -0,0 +1,58 @@
+/*
+ * Copyright 2026, Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef ARCH_ARM_TIMER_A9_TWD_H
+#define ARCH_ARM_TIMER_A9_TWD_H
+
+
+#include "soc.h"
+
+#include <new>
+
+
+// Private timer of the Cortex-A9 MPCore ("arm,cortex-a9-twd-timer"). It has a
+// single 32-bit down counter, so it serves both as clock source and as event
+// timer: the time is accumulated from the ticks consumed since the counter was
+// last loaded, and the counter is reloaded for every timeout.
+class A9TWDTimer : public HardwareTimer {
+public:
+	void SetTimeout(bigtime_t timeout);
+	bigtime_t Time();
+	void Clear();
+
+	static status_t Init(phys_addr_t regBase, uint32 interrupt,
+		uint32 frequency)
+	{
+		if (sInstance != NULL)
+			return B_OK;
+
+		A9TWDTimer* timer = new(std::nothrow) A9TWDTimer(regBase, interrupt,
+			frequency);
+		return timer != NULL ? B_OK : B_NO_MEMORY;
+	}
+
+private:
+	A9TWDTimer(phys_addr_t regBase, uint32 interrupt, uint32 frequency);
+
+	uint64 _TicksLocked();
+	void _LoadLocked(uint32 ticks);
+	uint64 _ToTicks(bigtime_t time) const;
+	bigtime_t _ToTime(uint64 ticks) const;
+
+	static int32 _HandleInterrupt(void* data);
+
+	area_id fRegArea;
+	volatile uint32* fRegs;
+	int32 fInterrupt;
+	uint32 fFrequency;
+
+	spinlock fLock;
+	uint64 fBaseTicks;		// ticks elapsed until the last load
+	uint32 fLoaded;			// value the counter was last loaded with
+	bool fEventArmed;
+	uint64 fEventTicks;		// when the armed event is due
+};
+
+
+#endif /* ARCH_ARM_TIMER_A9_TWD_H */
