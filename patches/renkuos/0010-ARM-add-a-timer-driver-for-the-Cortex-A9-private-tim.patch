diff --git a/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp b/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
index 86e78e9673..bfe8a9687a 100644
--- a/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
+++ b/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
@@ -17,6 +17,7 @@ extern "C" {
 }
 
 #include "dtb.h"
+#include "efi_platform.h"
 
 
 const struct supported_interrupt_controllers {
@@ -43,6 +44,36 @@ const struct supported_timers {
 };
 
 
+// The Cortex-A9 private timer (TWD) exists on every Cortex-A9 MPCore, but is
+// only used when the device tree offers no better (SoC specific) timer.
+static addr_range sTWDRegs;
+static uint32 sTWDInterrupt;
+static bool sHasTWD = false;
+
+
+/*!	The TWD runs at PERIPHCLK, whose rate the device tree usually doesn't
+	describe, so measure it against the firmware's Stall().
+*/
+static uint32
+calibrate_twd(addr_t base)
+{
+	enum { kLoad = 0, kCounter = 1, kControl = 2, kInterruptStatus = 3 };
+	volatile uint32* twd = (volatile uint32*)base;
+	const uint32 kCalibrationTime = 10000; // µs
+
+	twd[kControl] = 0;
+	twd[kLoad] = 0xffffffff;
+	twd[kControl] = 1; // enabled, single shot, no interrupt, prescaler 0
+	uint32 start = twd[kCounter];
+	kBootServices->Stall(kCalibrationTime);
+	uint32 end = twd[kCounter];
+	twd[kControl] = 0;
+	twd[kInterruptStatus] = 1;
+
+	return (uint32)((uint64)(start - end) * 1000000 / kCalibrationTime);
+}
+
+
 void
 arch_handle_fdt(const void* fdt, int node)
 {
@@ -85,6 +116,13 @@ arch_handle_fdt(const void* fdt, int node)
 		}
 	}
 
+	if (!sHasTWD && dtb_has_fdt_string(compatible, compatibleLen,
+			"arm,cortex-a9-twd-timer")) {
+		dtb_get_reg(fdt, node, 0, sTWDRegs);
+		sTWDInterrupt = dtb_get_interrupt(fdt, node);
+		sHasTWD = true;
+	}
+
 	boot_timer_info &timer = gKernelArgs.arch_args.timer;
 	if (timer.kind[0] == 0) {
 		for (uint32 i = 0; i < B_COUNT_OF(kSupportedTimers); i++) {
@@ -120,6 +158,13 @@ arch_dtb_set_kernel_args(void)
 	}
 
 	boot_timer_info &timer = gKernelArgs.arch_args.timer;
+	if (timer.kind[0] == 0 && sHasTWD) {
+		strlcpy(timer.kind, TIMER_KIND_A9_TWD, sizeof(timer.kind));
+		timer.regs = sTWDRegs;
+		timer.interrupt = sTWDInterrupt;
+		gKernelArgs.arch_args.timerFrequency = calibrate_twd(sTWDRegs.start);
+	}
+
 	dprintf("Chosen timer:\n");
 	if (timer.kind[0] == 0) {
 		dprintf("kind: None!\n");
@@ -129,5 +174,9 @@ arch_dtb_set_kernel_args(void)
 			timer.regs.start,
 			timer.regs.size);
 		dprintf("  irq: %" B_PRIu32 "\n", timer.interrupt);
+		if (gKernelArgs.arch_args.timerFrequency != 0) {
+			dprintf("  frequency: %" B_PRIu32 " Hz\n",
+				gKernelArgs.arch_args.timerFrequency);
+		}
 	}
 }
