From 2ac377c2cd40c8eff18ef16a1539b187c6f7f4e2 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 20 Oct 2026 18:10:57 +0200
Subject: [PATCH 02/63] ARM: link libroot and applications against the
 cross-compiler libsupc++ and libgcc

libroot embeds libsupc++.a, and every image links the static libgcc.a, from
the prebuilt gcc_syslibs_devel package. On ARM that libsupc++.a decodes the
type info references of catch clauses as PC-relative while the linker writes
them GOT-relative (TARGET2), so applications that do not load libstdc++
(Tracker, for one) crashed whenever an exception reached a catch clause,
for example while Tracker launched an application. Both prebuilt archives
also use d16-d31, which VFPv3-D16 CPUs do not have. Take them from the
cross-compiler, like the kernel already does.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 build/jam/SystemLibraryRules | 19 +++++++++++++++++++
 configure                    |  6 ++++--
 2 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/build/jam/SystemLibraryRules b/build/jam/SystemLibraryRules
index e28d67a113..b7c379ca42 100644
--- a/build/jam/SystemLibraryRules
+++ b/build/jam/SystemLibraryRules
@@ -75,6 +75,14 @@ rule TargetStaticLibsupc++ asPath
 	# Invoking with <asPath> = true will return the full library path.
 
 	if $(TARGET_PLATFORM) = haiku {
+		if $(TARGET_PACKAGING_ARCH) = arm && $(TARGET_BOOT_LIBSUPC++) {
+			# the one built by the cross-compiler: the prebuilt libsupc++.a
+			# requires a VFP with 32 double registers, and its unwinder
+			# decodes the type info references (TARGET2) differently than
+			# the linker writes them
+			return $(TARGET_BOOT_LIBSUPC++) ;
+		}
+
 		# return libsupc++.a from the gcc_syslibs_devel build feature.
 		local flags ;
 		if $(asPath) = true {
@@ -174,6 +182,12 @@ rule TargetLibgcc asPath
 			return [
 				BuildFeatureAttribute gcc_syslibs_devel : libgcc.a : $(flags)
 			] ;
+		} else if $(TARGET_PACKAGING_ARCH) = arm && $(TARGET_BOOT_LIBGCC) {
+			# the static libgcc.a built by the cross-compiler, see
+			# TargetKernelLibgcc
+			return [
+				BuildFeatureAttribute gcc_syslibs : libgcc_s.so.1 : $(flags)
+			] $(TARGET_BOOT_LIBGCC) ;
 		} else {
 			# return libgcc_s.so from the gcc_syslibs build feature and libgcc.a
 			# from the gcc_syslibs_devel build feature.
@@ -197,6 +211,11 @@ rule TargetStaticLibgcc asPath
 	# Invoking with <asPath> = true will return the full library path.
 
 	if $(TARGET_PLATFORM) = haiku {
+		if $(TARGET_PACKAGING_ARCH) = arm && $(TARGET_BOOT_LIBGCC) {
+			# see TargetKernelLibgcc
+			return $(TARGET_BOOT_LIBGCC) ;
+		}
+
 		# return libgcc.a from the gcc_syslibs_devel build feature.
 		local flags ;
 		if $(asPath) = true {
diff --git a/configure b/configure
index 4e1e9532de..ee682a99e3 100755
--- a/configure
+++ b/configure
@@ -345,9 +345,11 @@ standard_gcc_settings()
 			bootCxxHeaders="$headers/$gccMachine"
 			;;
 		arm-*)
-			# Kernel and boot loader use the libgcc.a built by the cross-compiler,
-			# so that they match its FPU configuration (e.g. VFPv3-D16)
+			# The kernel uses the libgcc.a built by the cross-compiler, so that
+			# it matches its FPU configuration (e.g. VFPv3-D16); so does
+			# libroot, with its libsupc++.a
 			bootLibgcc=`$gcc -print-file-name=libgcc.a`
+			bootLibSupCxx=`$gcc -print-file-name=libsupc++.a`
 			;;
 	esac
 
