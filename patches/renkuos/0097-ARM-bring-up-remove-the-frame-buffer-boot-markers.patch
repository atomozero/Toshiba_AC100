-uint32
-arm_virtual_to_physical(addr_t address)
-{
-	uint32 par;
-	asm volatile ("mcr p15, 0, %1, c7, c8, 0\n"	// ATS1CPR
-		"isb\n"
-		"mrc p15, 0, %0, c7, c4, 0"
-		: "=r" (par) : "r" (address));
-	if ((par & 1) != 0)
-		return 0xfa000000 | (par & 0xfff);
-	return (par & 0xfffff000) | (address & 0xfff);
-}
