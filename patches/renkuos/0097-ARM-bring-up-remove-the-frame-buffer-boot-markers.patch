-
-/*!	Compares the kernel's code pages with the checksums of the kernel file and
-	shows: number of bad pages (0xc0de....), first bad page, its physical
-	address, its checksum, the expected one and the first word of __udivsi3.
-*/
-void
-arm_boot_check_text(int row)
-{
-	uint32 bad = 0;
-	uint32 firstBad = 0;
-	uint32 firstSum = 0;
-	uint32 firstExpected = 0;
-	if (gArmTextCheck.base != 0) {
-		const uint32* words = (const uint32*)(addr_t)gArmTextCheck.base;
-		uint32 pages = (gArmTextCheck.words + 1023) / 1024;
-		for (uint32 page = 0; page < pages && page < 1024; page++) {
-			uint32 expected = gArmTextCheck.sums[page];
-			if (expected == 0)
-				continue;
-			uint32 sum = 0;
-			uint32 end = min_c(gArmTextCheck.words, (page + 1) * 1024);
-			for (uint32 i = page * 1024; i < end; i++)
-				sum = ((sum << 1) | (sum >> 31)) ^ words[i];
-			if (sum != expected) {
-				if (bad++ == 0) {
-					firstBad = gArmTextCheck.base + page * B_PAGE_SIZE;
-					firstSum = sum;
-					firstExpected = expected;
-				}
-			}
-		}
-	}
-
-	arm_boot_marker_value(row, (gArmTextCheck.base != 0 ? 0xc0de0000 : 0xdead0000)
-		| (bad & 0xffff));
-	arm_boot_marker_value(row + 1, firstBad);
-	arm_boot_marker_value(row + 2,
-		firstBad != 0 ? arm_virtual_to_physical(firstBad) : 0);
-	arm_boot_marker_value(row + 3, firstSum);
-	arm_boot_marker_value(row + 4, firstExpected);
-	arm_boot_marker_value(row + 5, *(volatile uint32*)(addr_t)&__udivsi3);
-	arm_boot_marker_value(row + 6,
-		arm_virtual_to_physical((addr_t)&__udivsi3));
-}
-
-
-/*!	Asks the MMU for every page of the address space and shows, starting at
-	\a row, the physical page of the current stack, how many virtual pages map
-	to it, and the first three of them.
-*/
-void
-arm_boot_find_stack_aliases(int row)
-{
-	addr_t stack = ROUNDDOWN((addr_t)__builtin_frame_address(0), B_PAGE_SIZE);
-	uint32 target = arm_virtual_to_physical(stack) & ~(B_PAGE_SIZE - 1);
-	uint32 aliases[3] = { 0, 0, 0 };
-	uint32 count = 0;
-
-	addr_t address = 0;
-	do {
-		uint32 physical = arm_virtual_to_physical(address);
-		if ((physical & 0xff000000) != 0xfa000000
-			&& (physical & ~(B_PAGE_SIZE - 1)) == target) {
-			// list the other mappings first, the stack itself is known
-			if (address != stack && count < 3)
-				aliases[count] = address;
-			if (address != stack)
-				count++;
-		}
-		address += B_PAGE_SIZE;
-	} while (address != 0);
-
-	arm_boot_marker_value(row, target);
-	arm_boot_marker_value(row + 1, count);
-	arm_boot_marker_value(row + 2, aliases[0]);
-	arm_boot_marker_value(row + 3, aliases[1]);
-}
 
 
