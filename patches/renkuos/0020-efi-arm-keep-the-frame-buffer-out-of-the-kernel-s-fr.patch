From ac91f761b7e6edd19937f880ae6b25de8fa24323 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 16:49:35 +0200
Subject: [PATCH 020/203] efi/arm: keep the frame buffer out of the kernel's
 free memory

On NVIDIA Tegra, U-Boot's frame buffer is ordinary RAM inside an
EfiBootServicesCode region. The kernel only treated EfiLoaderData as
allocated, so it could hand out frame buffer pages (e.g. for early page
tables, slabs or stacks) while the boot splash and debug output were
still drawn there. Add the frame buffer to the allocated physical ranges
when it overlaps physical memory.
---
 .../boot/platform/efi/arch/arm/arch_mmu.cpp     | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/src/system/boot/platform/efi/arch/arm/arch_mmu.cpp b/src/system/boot/platform/efi/arch/arm/arch_mmu.cpp
index 3bd7ef96aa..5e4557a127 100644
--- a/src/system/boot/platform/efi/arch/arm/arch_mmu.cpp
+++ b/src/system/boot/platform/efi/arch/arm/arch_mmu.cpp
@@ -176,6 +176,23 @@ arch_mmu_post_efi_setup(size_t memoryMapSize,
 	build_physical_allocated_list(memoryMapSize, memoryMap,
 		descriptorSize, descriptorVersion);
 
+	// The firmware's frame buffer may live in ordinary RAM, e.g. inside an
+	// EfiBootServicesCode region (U-Boot on NVIDIA Tegra), which the kernel
+	// would otherwise reuse while the screen is still being drawn to.
+	if (gKernelArgs.frame_buffer.enabled) {
+		phys_addr_t start = ROUNDDOWN(
+			gKernelArgs.frame_buffer.physical_buffer.start, B_PAGE_SIZE);
+		phys_addr_t end = ROUNDUP(gKernelArgs.frame_buffer.physical_buffer.start
+			+ gKernelArgs.frame_buffer.physical_buffer.size, B_PAGE_SIZE);
+		for (uint32 i = 0; i < gKernelArgs.num_physical_memory_ranges; i++) {
+			const addr_range& range = gKernelArgs.physical_memory_range[i];
+			if (start < range.start + range.size && end > range.start) {
+				insert_physical_allocated_range(start, end - start);
+				break;
+			}
+		}
+	}
+
 	// Switch EFI to virtual mode, using the kernel pmap.
 	kRuntimeServices->SetVirtualAddressMap(memoryMapSize, descriptorSize,
 		descriptorVersion, memoryMap);
