From 0fa0e6ab283b299ca5639da91abf0849b2bff2f0 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 25 Oct 2026 09:03:32 +0100
Subject: [PATCH 216/270] build: add the Bluetooth stack to the ARM minimum
 image

The ARM minimum image ships the Bluetooth preferences and
libbluetooth.so, but not bluetooth_server, the HCI stack, the L2CAP
protocol or the h2generic USB driver, so the Bluetooth module of the
Toshiba AC100 (a USB HCI device, class 0xe0/0x01/0x01) is never used.
Add them as in the regular image.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 build/jam/images/definitions/minimum | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/build/jam/images/definitions/minimum b/build/jam/images/definitions/minimum
index 1f4e3f4216..5822cfa57d 100644
--- a/build/jam/images/definitions/minimum
+++ b/build/jam/images/definitions/minimum
@@ -573,6 +573,7 @@ if arm in $(HAIKU_PACKAGING_ARCHS) {
 	] ;
 
 	SYSTEM_SERVERS += [ FFilterByBuildFeatures
+		bluetooth_server
 		mail_daemon
 		media_addon_server
 		media_server
@@ -581,6 +582,19 @@ if arm in $(HAIKU_PACKAGING_ARCHS) {
 		print_addon_server
 	] ;
 
+	# Bluetooth stack + drivers, for the Bluetooth preferences above
+	SYSTEM_NETWORK_PROTOCOLS +=
+		bluetooth
+		l2cap
+	;
+	SYSTEM_BT_STACK =
+		hci
+		btCoreData
+	;
+	SYSTEM_ADD_ONS_DRIVERS_BT_H2 +=
+		h2generic
+	;
+
 	SYSTEM_ADD_ONS_TRANSLATORS += [ FFilterByBuildFeatures
 		BMPTranslator
 		GIFTranslator
