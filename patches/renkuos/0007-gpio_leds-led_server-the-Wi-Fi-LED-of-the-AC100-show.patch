@@ -0,0 +1,15 @@
+resource app_signature "application/x-vnd.RenkuOS-led_server";
+
+resource app_flags B_EXCLUSIVE_LAUNCH | B_BACKGROUND_APP;
+
+resource app_version {
+	major  = 1,
+	middle = 0,
