diff --git a/src/servers/led/LEDServer.cpp b/src/servers/led/LEDServer.cpp
new file mode 100644
index 0000000000..f4bafa5efa
--- /dev/null
+++ b/src/servers/led/LEDServer.cpp
@@ -0,0 +1,168 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+/*!	led_server: what the LEDs of the machine show. The gpio_leds driver
+	publishes them in /dev/misc/led/<name>, writing "1" or "0" switches one
+	on or off. For now there is one rule: an LED named for Wi-Fi ("wifi",
+	"wlan") is on while a wireless interface is connected to a network.
+	Without such LEDs the server quits at once.
+*/
+
+
+#include <stdio.h>
+#include <string.h>
+#include <strings.h>
+
+#include <Application.h>
+#include <Directory.h>
+#include <Entry.h>
+#include <NetworkDevice.h>
+#include <NetworkInterface.h>
+#include <NetworkNotifications.h>
+#include <NetworkRoster.h>
+#include <ObjectList.h>
+#include <Path.h>
+#include <String.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <syslog.h>
+#include <unistd.h>
+
+
+static const char* kSignature = "application/x-vnd.RenkuOS-led_server";
+static const char* kLEDDirectory = "/dev/misc/led";
+
+
+class LEDServer : public BApplication {
+public:
+								LEDServer();
+
+	virtual	void				ReadyToRun();
+	virtual	void				MessageReceived(BMessage* message);
+
+private:
+			void				_Update();
+			bool				_WirelessConnected();
+			void				_Set(const char* path, bool on);
+
+			BObjectList<BString, true> fWifiLEDs;
+			int32				fWifiState;
+				// -1 not set yet
+};
+
+
+LEDServer::LEDServer()
+	:
+	BApplication(kSignature),
+	fWifiState(-1)
+{
+}
+
+
+void
+LEDServer::ReadyToRun()
+{
+	// listing the directory also has the device manager look for LEDs
+	BDirectory directory(kLEDDirectory);
+	BEntry entry;
+	while (directory.GetNextEntry(&entry) == B_OK) {
+		BPath path;
+		if (entry.GetPath(&path) != B_OK)
+			continue;
+		const char* name = path.Leaf();
+		if (strcasestr(name, "wifi") != NULL
+			|| strcasestr(name, "wlan") != NULL) {
+			fWifiLEDs.AddItem(new BString(path.Path()));
+		}
+	}
+
+	if (fWifiLEDs.IsEmpty()) {
+		// nothing to drive on this machine
+		Quit();
+		return;
+	}
+
+	start_watching_network(B_WATCH_NETWORK_INTERFACE_CHANGES
+		| B_WATCH_NETWORK_LINK_CHANGES | B_WATCH_NETWORK_WLAN_CHANGES, this);
+	_Update();
+}
+
+
+void
+LEDServer::MessageReceived(BMessage* message)
+{
+	switch (message->what) {
+		case B_NETWORK_MONITOR:
+			_Update();
+			break;
+
+		default:
+			BApplication::MessageReceived(message);
+			break;
+	}
+}
+
+
+void
+LEDServer::_Update()
+{
+	bool connected = _WirelessConnected();
+	if ((int32)connected == fWifiState)
+		return;
+	fWifiState = connected;
+
+	for (int32 i = 0; i < fWifiLEDs.CountItems(); i++)
+		_Set(fWifiLEDs.ItemAt(i)->String(), connected);
+}
+
+
+/*!	A wireless interface that is up and has a link is joined to a network.
+	An interface the user disabled is down, while its card may still report
+	the link for a while.
+*/
+bool
+LEDServer::_WirelessConnected()
+{
+	BNetworkRoster& roster = BNetworkRoster::Default();
+	BNetworkInterface interface;
+	uint32 cookie = 0;
+	while (roster.GetNextInterface(&cookie, interface) == B_OK) {
+		uint32 flags = interface.Flags();
+		if ((flags & IFF_LOOPBACK) != 0 || (flags & IFF_UP) == 0)
+			continue;
+		BNetworkDevice device(interface.Name());
+		if (device.IsWireless() && device.HasLink())
+			return true;
+	}
+	return false;
+}
+
+
+void
+LEDServer::_Set(const char* path, bool on)
+{
+	int fd = open(path, O_WRONLY);
+	if (fd < 0) {
+		syslog(LOG_WARNING, "led_server: cannot open %s: %s\n", path,
+			strerror(errno));
+		return;
+	}
+	if (write(fd, on ? "1" : "0", 1) != 1) {
+		syslog(LOG_WARNING, "led_server: cannot set %s: %s\n", path,
+			strerror(errno));
+	}
+	close(fd);
+}
+
+
+int
+main()
+{
+	LEDServer server;
+	server.Run();
+	return 0;
+}
