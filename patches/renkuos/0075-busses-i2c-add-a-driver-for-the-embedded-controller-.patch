+
+static status_t
+read_key(nvec_device* device, void* buffer)
+{
+	while (true) {
+		status_t status = acquire_sem_etc(device->keySem, 1,
+			B_CAN_INTERRUPT | B_RELATIVE_TIMEOUT,
+			device->repeatKey != 0 ? device->currentRepeatDelay
+				: B_INFINITE_TIMEOUT);
+
+		raw_key_info info;
+		if (status == B_TIMED_OUT) {
+			// the EC does not repeat keys itself
+			if (device->repeatKey == 0)
+				continue;
+			info.timestamp = system_time();
+			info.keycode = device->repeatKey;
+			info.is_keydown = true;
+			device->currentRepeatDelay = device->repeatRate;
+		} else if (status != B_OK) {
+			return status;
+		} else {
+			InterruptsSpinLocker locker(device->keyLock);
+			if (device->keyTail == device->keyHead)
+				continue;
+			info = device->keys[device->keyTail % NVEC_KEY_COUNT];
+			device->keyTail++;
+			locker.Unlock();
+
+			if (info.is_keydown) {
+				device->repeatKey = info.keycode;
+				device->currentRepeatDelay = device->repeatDelay;
+			} else if (info.keycode == device->repeatKey)
+				device->repeatKey = 0;
+		}
+
+		if (!IS_USER_ADDRESS(buffer))
+			return B_BAD_ADDRESS;
+		return user_memcpy(buffer, &info, sizeof(info));
+	}
+}
+
+
+static status_t
+read_movement(nvec_device* device, void* buffer)
+{
+	while (true) {
+		status_t status = acquire_sem_etc(device->mouseSem, 1, B_CAN_INTERRUPT,
+			0);
+		if (status != B_OK)
+			return status;
+
+		InterruptsSpinLocker locker(device->mouseLock);
+		if (device->movementTail == device->movementHead)
+			continue;
+		mouse_movement movement
+			= device->movements[device->movementTail % NVEC_MOUSE_COUNT];
+		device->movementTail++;
+		locker.Unlock();
+
+		if (!IS_USER_ADDRESS(buffer))
+			return B_BAD_ADDRESS;
+		return user_memcpy(buffer, &movement, sizeof(movement));
+	}
+}
+
+
+static status_t
+nvec_control(void* cookie, uint32 op, void* buffer, size_t length)
+{
+	nvec_handle* handle = (nvec_handle*)cookie;
+	nvec_device* device = handle->device;
+
+	if (handle->keyboard) {
+		switch (op) {
+			case KB_READ:
+				return read_key(device, buffer);
+
+			case KB_GET_KEYBOARD_ID:
+			{
+				uint16 id = 0xab83;
+				if (!IS_USER_ADDRESS(buffer))
+					return B_BAD_ADDRESS;
+				return user_memcpy(buffer, &id, sizeof(id));
+			}
+
+			case KB_SET_LEDS:
+			{
+				uint8 leds[3];
+				if (!IS_USER_ADDRESS(buffer)
+					|| user_memcpy(leds, buffer, sizeof(leds)) != B_OK) {
+					return B_BAD_ADDRESS;
+				}
+				// all three bits are needed for the caps lock LED to light
+				// up (as in Linux, a firmware bug?)
+				uint8 message[] = { NVEC_KBD, KBD_SET_LEDS,
+					(uint8)(leds[1] ? 7 : 0) };
+				return nvec_write(device, message, sizeof(message));
+			}
+
+			case KB_SET_KEY_REPEAT_RATE:
+			{
+				int32 rate;
+				if (!IS_USER_ADDRESS(buffer)
+					|| user_memcpy(&rate, buffer, sizeof(rate)) != B_OK) {
+					return B_BAD_ADDRESS;
+				}
+				if (rate <= 0 || rate > 1000000)
+					return B_BAD_VALUE;
+				device->repeatRate = 10000000 / rate;
+				return B_OK;
+			}
+
+			case KB_GET_KEY_REPEAT_RATE:
+			{
+				int32 rate = 10000000 / device->repeatRate;
+				if (!IS_USER_ADDRESS(buffer))
+					return B_BAD_ADDRESS;
+				return user_memcpy(buffer, &rate, sizeof(rate));
+			}
+
+			case KB_SET_KEY_REPEAT_DELAY:
+				if (!IS_USER_ADDRESS(buffer))
+					return B_BAD_ADDRESS;
+				return user_memcpy(&device->repeatDelay, buffer,
+					sizeof(bigtime_t));
+
+			case KB_GET_KEY_REPEAT_DELAY:
+				if (!IS_USER_ADDRESS(buffer))
+					return B_BAD_ADDRESS;
+				return user_memcpy(buffer, &device->repeatDelay,
+					sizeof(bigtime_t));
+
+			case KB_SET_CONTROL_ALT_DEL_TIMEOUT:
+			case KB_CANCEL_CONTROL_ALT_DEL:
+			case KB_DELAY_CONTROL_ALT_DEL:
+				return B_OK;
+		}
+		return B_DEV_INVALID_IOCTL;
+	}
+
+	switch (op) {
+		case MS_READ:
+			return read_movement(device, buffer);
+
+		case MS_NUM_EVENTS:
+		{
+			int32 count;
+			get_sem_count(device->mouseSem, &count);
+			return count;
+		}
+
+		case MS_SET_CLICKSPEED:
+			if (!IS_USER_ADDRESS(buffer))
+				return B_BAD_ADDRESS;
+			return user_memcpy(&device->clickSpeed, buffer,
+				sizeof(bigtime_t));
+	}
+	return B_DEV_INVALID_IOCTL;
+}
