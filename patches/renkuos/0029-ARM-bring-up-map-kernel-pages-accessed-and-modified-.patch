From e684b6031b4d780face1ae085c637cf8a7399dd9 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 18:07:36 +0200
Subject: [PATCH 029/270] ARM bring-up: map kernel pages accessed and modified
 (experiment, not for merging)

---
 .../arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp       | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp b/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
index cf7e54417c..a412d24b5a 100644
--- a/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
+++ b/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
@@ -220,6 +220,11 @@ ARMVMTranslationMap32Bit::Map(addr_t va, phys_addr_t pa, uint32 attributes,
 		"virtual address: %#" B_PRIxADDR ", existing pte: %#" B_PRIx32, va,
 		pt[index]);
 
+	// bring-up experiment: kernel mappings start out accessed and modified,
+	// so that they never take access flag or dirty bit faults
+	if (fIsKernelMap)
+		attributes |= PAGE_ACCESSED | PAGE_MODIFIED;
+
 	ARMPagingMethod32Bit::PutPageTableEntryInTable(&pt[index], pa, attributes,
 		memoryType, fIsKernelMap);
 
