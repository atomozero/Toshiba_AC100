+//#define TRACE_SDHCI
+#ifdef TRACE_SDHCI
+#	define TRACE(x...) dprintf("\33[33msdhci:\33[0m " x)
+#else
+#	define TRACE(x...) ;
+#endif
+#define TRACE_ALWAYS(x...)	dprintf("\33[33msdhci:\33[0m " x)
+#define ERROR(x...)			dprintf("\33[33msdhci:\33[0m " x)
+#define CALLED(x...)		TRACE("CALLED %s\n", __PRETTY_FUNCTION__)
+
+
+#define SDHCI_FDT_MMC_BUS_MODULE_NAME "busses/mmc/sdhci/fdt/device/v1"
+
+
+// #pragma mark - NVIDIA Tegra 2
+
+
+// Clock and reset controller ("nvidia,tegra20-car") registers, see
+// drivers/clk/tegra/clk-tegra20.c and clk-tegra-periph.c in Linux
+#define TEGRA20_CAR_BASE				0x60006000
+#define TEGRA_CAR_RST_DEVICES(bank)		(0x04 + (bank) * 4)
+#define TEGRA_CAR_CLK_OUT_ENB(bank)		(0x10 + (bank) * 4)
+#define TEGRA_CAR_SOURCE_PLLP			(0U << 30)
+#define TEGRA_CAR_SOURCE_MASK			(3U << 30)
+#define TEGRA_CAR_DIVIDER_MASK			0xff
+
+// Tegra 2's PLLP always runs at 216 MHz
+#define TEGRA20_GPIO_BASE				0x6000d000
+#define TEGRA_GPIO_REG(gpio, reg)		(((gpio) / 32) * 0x80 \
+											+ (((gpio) / 8) % 4) * 4 + (reg))
+#define TEGRA_GPIO_CNF					0x00
+#define TEGRA_GPIO_OE					0x10
+#define TEGRA_GPIO_OUT					0x20
+#define TEGRA_GPIO_IN					0x30
+#define GPIO_ACTIVE_LOW					1
+
+#define TEGRA20_PLLP_KHZ				216000
+// SDMMC module clock we set up: PLLP * 2 / (7 + 2) = 48 MHz
+#define TEGRA20_SDMMC_DIVIDER			7
+#define TEGRA20_SDMMC_KHZ				48000
+
+
+struct tegra_sdmmc_clock {
+	uint32	clockId;		// as in dt-bindings/clock/tegra20-car.h
+	uint32	sourceRegister;
+};
+
+static const tegra_sdmmc_clock kTegra20SdmmcClocks[] = {
+	{ 14, 0x150 },	// SDMMC1
+	{ 9, 0x154 },	// SDMMC2
+	{ 69, 0x1bc },	// SDMMC3
+	{ 15, 0x164 },	// SDMMC4
+};
+
+
+/*!	Finds the device node of the controller a phandle in property \a name of
+	\a dev points to, and returns its first register range.
+*/
+static bool
+fdt_get_phandle_reg(fdt_device_module_info* module, fdt_device* dev,
+	uint32 phandle, uint64* base, uint64* length)
+{
+	device_node* busNode = module->get_bus(dev);
+	fdt_bus_module_info* busModule;
+	fdt_bus* bus;
+	if (gDeviceManager->get_driver(busNode, (driver_module_info**)&busModule,
+			(void**)&bus) != B_OK) {
+		return false;
+	}
+
+	device_node* targetNode = busModule->node_by_phandle(bus, phandle);
+	if (targetNode == NULL)
+		return false;
+
+	fdt_device_module_info* targetModule;
+	fdt_device* target;
+	if (gDeviceManager->get_driver(targetNode,
+			(driver_module_info**)&targetModule, (void**)&target) != B_OK) {
+		return false;
+	}
+
+	return targetModule->get_reg(target, 0, base, length);
+}
+
+
+/*!	Makes sure the SDMMC module clock is running and out of reset, and sets it
+	to a known rate, as Tegra's SDHCI capabilities don't report a base clock.
+	The boot loader only sets up the controllers it used itself.
+*/
+static status_t
+tegra20_setup_clock(fdt_device_module_info* module, fdt_device* dev,
+	uint32* _baseClockKHz)
+{
+	int length;
+	const uint32* clocks = (const uint32*)module->get_prop(dev, "clocks",
+		&length);
+	if (clocks == NULL || length < 8) {
+		ERROR("Tegra: no clocks property\n");
+		return B_BAD_DATA;
+	}
+
+	uint32 phandle = B_BENDIAN_TO_HOST_INT32(clocks[0]);
+	uint32 clockId = B_BENDIAN_TO_HOST_INT32(clocks[1]);
+
+	const tegra_sdmmc_clock* clock = NULL;
+	for (size_t i = 0; i < B_COUNT_OF(kTegra20SdmmcClocks); i++) {
+		if (kTegra20SdmmcClocks[i].clockId == clockId)
+			clock = &kTegra20SdmmcClocks[i];
+	}
+	if (clock == NULL) {
+		ERROR("Tegra: unknown SDMMC clock %" B_PRIu32 "\n", clockId);
+		return B_BAD_DATA;
+	}
+
+	uint64 carBase, carLength;
+	if (!fdt_get_phandle_reg(module, dev, phandle, &carBase, &carLength)) {
+		// the clock controller node may not be initialized yet
+		carBase = TEGRA20_CAR_BASE;
+		ERROR("Tegra: clock controller not found, assuming %#" B_PRIx64 "\n",
+			carBase);
+	}
+
+	volatile uint32* car;
+	area_id carArea = map_physical_memory("tegra car", carBase, B_PAGE_SIZE,
+		B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+		(void**)&car);
+	if (carArea < B_OK)
+		return carArea;
+
+	uint32 bank = clockId / 32;
+	uint32 bit = 1U << (clockId % 32);
+
+	// Hold the module in reset while the clock is changed, then release it
+	car[TEGRA_CAR_RST_DEVICES(bank) / 4] |= bit;
+	car[TEGRA_CAR_CLK_OUT_ENB(bank) / 4] |= bit;
+
+	uint32 source = car[clock->sourceRegister / 4];
+	source &= ~(TEGRA_CAR_SOURCE_MASK | TEGRA_CAR_DIVIDER_MASK);
+	source |= TEGRA_CAR_SOURCE_PLLP | TEGRA20_SDMMC_DIVIDER;
+	car[clock->sourceRegister / 4] = source;
+
+	spin(2);
+	car[TEGRA_CAR_RST_DEVICES(bank) / 4] &= ~bit;
+
+	delete_area(carArea);
+
+	*_baseClockKHz = TEGRA20_PLLP_KHZ * 2 / (TEGRA20_SDMMC_DIVIDER + 2);
+	TRACE("Tegra: SDMMC clock %" B_PRIu32 " at %" B_PRIu32 " kHz\n", clockId,
+		*_baseClockKHz);
+	return B_OK;
+}
+
+
+/*!	Accesses the GPIO named by the device tree property \a name. If \a output
+	is true, the GPIO is driven to \a value, else it is made an input. Returns
+	the logical (active level corrected) state of the line.
+*/
+static status_t
+tegra20_gpio(fdt_device_module_info* module, fdt_device* dev,
+	const char* name, bool output, bool value, bool* _active)
+{
+	int length;
+	const uint32* cells = (const uint32*)module->get_prop(dev, name, &length);
+	if (cells == NULL || length < 12)
+		return B_ENTRY_NOT_FOUND;
+
+	uint32 phandle = B_BENDIAN_TO_HOST_INT32(cells[0]);
+	uint32 gpio = B_BENDIAN_TO_HOST_INT32(cells[1]);
+	bool activeLow = (B_BENDIAN_TO_HOST_INT32(cells[2]) & GPIO_ACTIVE_LOW) != 0;
+
+	uint64 base, size;
+	if (!fdt_get_phandle_reg(module, dev, phandle, &base, &size))
+		base = TEGRA20_GPIO_BASE;
+
+	volatile uint32* regs;
+	area_id area = map_physical_memory("tegra gpio", base, B_PAGE_SIZE,
+		B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+		(void**)&regs);
+	if (area < B_OK)
+		return area;
+
+	uint32 bit = 1U << (gpio % 8);
+	regs[TEGRA_GPIO_REG(gpio, TEGRA_GPIO_CNF) / 4] |= bit;
+	if (output) {
+		if (value != activeLow)
+			regs[TEGRA_GPIO_REG(gpio, TEGRA_GPIO_OUT) / 4] |= bit;
+		else
+			regs[TEGRA_GPIO_REG(gpio, TEGRA_GPIO_OUT) / 4] &= ~bit;
+		regs[TEGRA_GPIO_REG(gpio, TEGRA_GPIO_OE) / 4] |= bit;
+	} else
+		regs[TEGRA_GPIO_REG(gpio, TEGRA_GPIO_OE) / 4] &= ~bit;
+
+	bool level = (regs[TEGRA_GPIO_REG(gpio, TEGRA_GPIO_IN) / 4] & bit) != 0;
+	delete_area(area);
+
+	if (_active != NULL)
+		*_active = level != activeLow;
+	return B_OK;
+}
+
+
+static status_t
+tegra20_init(fdt_device_module_info* module, fdt_device* dev,
+	SdhciQuirks& quirks)
+{
+	uint64 regBase = 0, regLength;
+	module->get_reg(dev, 0, &regBase, &regLength);
+
+	// The slot may be powered through a GPIO, which the firmware could have
+	// turned off when it was done with the card
+	bool powered;
+	if (tegra20_gpio(module, dev, "power-gpios", true, true, &powered)
+			== B_OK) {
+		TRACE_ALWAYS("Tegra %#" B_PRIx64 ": slot power on (%s)\n", regBase,
+			powered ? "on" : "off?");
+		snooze(10000);
+	}
+
+	status_t status = tegra20_setup_clock(module, dev, &quirks.baseClockKHz);
+	if (status != B_OK)
+		return status;
+
+	// From the "nvidia,tegra20-sdhci" quirks of Linux' sdhci-tegra.c
+	quirks.forceSpec200 = true;
+	quirks.brokenTimeoutValue = true;
+	quirks.combinedCommandWrite = true;
+	quirks.noHighSpeedBit = true;
+
+	// Card detection is done through a GPIO on Tegra, not by the controller.
+	// TODO: use the "cd-gpios" GPIO for insertion and removal instead of
+	// assuming a card is present.
+	bool cardPresent;
+	if (tegra20_gpio(module, dev, "cd-gpios", false, false, &cardPresent)
+			== B_OK) {
+		TRACE_ALWAYS("Tegra %#" B_PRIx64 ": card detect says %s\n", regBase,
+			cardPresent ? "inserted" : "not inserted");
+	}
+	quirks.forceCardPresent = true;
+	return B_OK;
+}
+
+
+// #pragma mark -
+
+
+struct sdhci_fdt_compatible {
+	const char*	compatible;
+	status_t	(*init)(fdt_device_module_info* module, fdt_device* dev,
+					SdhciQuirks& quirks);
+};
+
+static const sdhci_fdt_compatible kSupportedControllers[] = {
+	{ "nvidia,tegra20-sdhci", &tegra20_init },
+};
+
+
+static const sdhci_fdt_compatible*
+find_controller(device_node* node)
+{
+	const char* compatible;
+	if (gDeviceManager->get_attr_string(node, "fdt/compatible", &compatible,
+			false) != B_OK) {
+		return NULL;
+	}
+
+	for (size_t i = 0; i < B_COUNT_OF(kSupportedControllers); i++) {
+		if (strcmp(compatible, kSupportedControllers[i].compatible) == 0)
+			return &kSupportedControllers[i];
+	}
+	return NULL;
+}
+
+
+static bool
+is_enabled(fdt_device_module_info* module, fdt_device* dev)
+{
+	int length;
+	const char* status = (const char*)module->get_prop(dev, "status", &length);
+	return status == NULL || strcmp(status, "okay") == 0
+		|| strcmp(status, "ok") == 0;
+}
+
+
+status_t
+init_bus_fdt(device_node* node, void** bus_cookie)
+{
+	CALLED();
+
+	// node is our mmc bus node, its parent the SDHCI device, and the parent of
+	// that one the FDT node
+	device_node* parent = gDeviceManager->get_parent_node(node);
+	device_node* fdtParent = gDeviceManager->get_parent_node(parent);
+	gDeviceManager->put_node(parent);
+
+	fdt_device_module_info* module;
+	fdt_device* dev;
+	status_t status = gDeviceManager->get_driver(fdtParent,
+		(driver_module_info**)&module, (void**)&dev);
+	const sdhci_fdt_compatible* controller = find_controller(fdtParent);
+	gDeviceManager->put_node(fdtParent);
+	if (status != B_OK)
+		return status;
+	if (controller == NULL)
+		return B_BAD_VALUE;
+
+	uint64 regs, regsLength;
+	if (!module->get_reg(dev, 0, &regs, &regsLength)) {
+		ERROR("No registers to map\n");
+		return B_BAD_DATA;
+	}
+
+	uint64 irq;
+	if (!module->get_interrupt(dev, 0, NULL, &irq)) {
+		ERROR("No interrupt\n");
+		return B_BAD_DATA;
+	}
+
+	SdhciQuirks quirks = {};
+	status = controller->init(module, dev, quirks);
+	if (status != B_OK)
+		return status;
+
+	// a non removable card (eMMC) has no card detection at all
+	int length;
+	if (module->get_prop(dev, "non-removable", &length) != NULL)
+		quirks.forceCardPresent = true;
+
+	struct registers* registers;
+	area_id regsArea = map_physical_memory("sdhc_regs_map", regs, regsLength,
+		B_ANY_KERNEL_BLOCK_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+		(void**)&registers);
+	if (regsArea < B_OK) {
+		ERROR("Could not map registers\n");
+		return regsArea;
+	}
+
+	TRACE("%s @ %#" B_PRIx64 ", IRQ %" B_PRIu64 "\n", controller->compatible,
+		regs, irq);
+
+	SdhciBus* bus = new(std::nothrow) SdhciBus(registers, irq, false, &quirks);
+
+	status = B_NO_MEMORY;
+	if (bus != NULL)
+		status = bus->InitCheck();
+
+	if (status != B_OK) {
+		if (bus != NULL)
+			delete bus;
+		else
+			delete_area(regsArea);
+		return status;
+	}
+
+	*bus_cookie = bus;
+	return B_OK;
+}
+
+
+status_t
+register_child_devices_fdt(void* cookie)
+{
+	CALLED();
+	SdhciDevice* context = (SdhciDevice*)cookie;
+
+	device_attr attrs[] = {
+		// properties of this controller for mmc bus manager
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE, { .string = "SDHC bus" } },
+		{ B_DEVICE_FIXED_CHILD, B_STRING_TYPE,
+			{ .string = MMC_BUS_MODULE_NAME } },
+		{ B_DEVICE_BUS, B_STRING_TYPE, { .string = "mmc" } },
+
+		// DMA properties, see register_child_devices_acpi()
+		{ B_DMA_ALIGNMENT, B_UINT32_TYPE, { .ui32 = 511 } },
+		{ B_DMA_HIGH_ADDRESS, B_UINT64_TYPE, { .ui64 = 0x100000000LL } },
+		{ B_DMA_BOUNDARY, B_UINT32_TYPE, { .ui32 = (1 << 19) - 1 } },
+		{ B_DMA_MAX_SEGMENT_COUNT, B_UINT32_TYPE, { .ui32 = 1 } },
+		{ B_DMA_MAX_SEGMENT_BLOCKS, B_UINT32_TYPE, { .ui32 = (1 << 10) - 1 } },
+		{ NULL }
+	};
+
+	return gDeviceManager->register_node(context->fNode,
+		SDHCI_FDT_MMC_BUS_MODULE_NAME, attrs, NULL, NULL);
+}
+
+
+float
+supports_device_fdt(device_node* parent)
+{
+	if (find_controller(parent) == NULL)
+		return 0.0f;
+
+	fdt_device_module_info* module;
+	fdt_device* dev;
+	if (gDeviceManager->get_driver(parent, (driver_module_info**)&module,
+			(void**)&dev) != B_OK || !is_enabled(module, dev)) {
+		return 0.0f;
+	}
+
+	TRACE("SDHCI device found: %s\n", module->get_name(dev));
+	return 0.8f;
+}
+
+
+// Device node registered for each SD slot. It implements the MMC operations so
+// the bus manager can use it to communicate with SD cards.
+mmc_bus_interface gSDHCIFDTDeviceModule = {
+	.info = {
+		.info = {
+			.name = SDHCI_FDT_MMC_BUS_MODULE_NAME,
+		},
+
+		.init_driver = init_bus_fdt,
+		.uninit_driver = uninit_bus,
+		.device_removed = bus_removed,
+	},
+
+	.set_clock = set_clock,
+	.execute_command = execute_command,
+	.do_io = do_io,
+	.set_scan_semaphore = set_scan_semaphore,
+	.set_bus_width = set_bus_width,
+	.terminate_bus = terminate_bus,
+	.set_card_type = set_card_type,
+	.read_data = read_data,
+	.set_timing = set_timing,
+};
