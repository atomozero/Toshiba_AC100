+
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include <FindDirectory.h>
+#include <Message.h>
+#include <Path.h>
+#include <String.h>
+
+#include <TestSuiteAddon.h>
+#include <cppunit/TestFixture.h>
+#include <cppunit/extensions/HelperMacros.h>
+
+#include <bluetooth/HCI/btHCI_event.h>
+
+#include "BondStore.h"
+#include "DeviceCache.h"
+#include "KeyVault.h"
+#include "SettingsFile.h"
+
+
+static const bdaddr_t kAdapter = {{ 0xfd, 0x2c, 0x18, 0x6d, 0x62, 0x6c }};
+static const bdaddr_t kSpeakers = {{ 0x70, 0x56, 0x14, 0x20, 0x8d, 0x3c }};
+static const bdaddr_t kPhone = {{ 0x6a, 0x81, 0xb2, 0xb0, 0x7d, 0x0c }};
+
+
+static bdaddr_t
+address(uint8 last)
+{
+	bdaddr_t address = {{ last, 1, 2, 3, 4, 5 }};
+	return address;
+}
+
+
+class DeviceCacheTest : public CppUnit::TestFixture {
+	CPPUNIT_TEST_SUITE(DeviceCacheTest);
+	CPPUNIT_TEST(TestKeptAfterLoad);
+	CPPUNIT_TEST(TestServiceClasses);
+	CPPUNIT_TEST(TestPruneOld);
+	CPPUNIT_TEST(TestPruneTooMany);
+	CPPUNIT_TEST(TestRemove);
+	CPPUNIT_TEST_SUITE_END();
+
+public:
+	void setUp()
+	{
+		BPath temporary;
+		find_directory(B_SYSTEM_TEMP_DIRECTORY, &temporary);
+		temporary.Append("devicecache_test_XXXXXX");
+		char path[B_PATH_NAME_LENGTH];
+		strlcpy(path, temporary.Path(), sizeof(path));
+		CPPUNIT_ASSERT(mkdtemp(path) != NULL);
+		fDirectory.SetTo(path);
+	}
+
+	void tearDown()
+	{
+		BString command("rm -rf ");
+		command << "'" << fDirectory.Path() << "'";
+		system(command.String());
+	}
+
+	void TestKeptAfterLoad()
+	{
+		{
+			DeviceCache cache(fDirectory, kAdapter);
+			CPPUNIT_ASSERT_EQUAL(B_OK, cache.Load());
+			DeviceRecord record;
+			record.address = kSpeakers;
+			record.name = "Cucina";
+			record.deviceClass[1] = 0x04;
+			record.clockOffset = 0x1234;
+			record.pageScanRepetitionMode = 1;
+			cache.Update(record);
+			CPPUNIT_ASSERT_EQUAL(B_OK, cache.Flush());
+		}
+
+		DeviceCache cache(fDirectory, kAdapter);
+		CPPUNIT_ASSERT_EQUAL(B_OK, cache.Load());
+		DeviceRecord record;
+		CPPUNIT_ASSERT(cache.Get(kSpeakers, record));
+		CPPUNIT_ASSERT_EQUAL(BString("Cucina"), record.name);
+		CPPUNIT_ASSERT_EQUAL((uint8)0x04, record.deviceClass[1]);
+		CPPUNIT_ASSERT_EQUAL((uint16)0x1234, record.clockOffset);
+		CPPUNIT_ASSERT_EQUAL((uint8)1, record.pageScanRepetitionMode);
+		CPPUNIT_ASSERT(record.lastSeen > 0);
+		CPPUNIT_ASSERT(!cache.Get(kPhone, record));
+	}
+
+	void TestServiceClasses()
+	{
+		{
+			DeviceCache cache(fDirectory, kAdapter);
+			cache.Load();
+			uint16 classes[] = { 0x111f, 0x110b, 0x110e };
+			cache.SetServiceClasses(kSpeakers, classes, 3);
+			cache.SetName(kSpeakers, "Cucina");
+		}
+
+		DeviceCache cache(fDirectory, kAdapter);
+		cache.Load();
+		DeviceRecord record;
+		CPPUNIT_ASSERT(cache.Get(kSpeakers, record));
+		CPPUNIT_ASSERT_EQUAL((uint8)3, record.serviceClassCount);
+		CPPUNIT_ASSERT(record.HasServiceClass(0x110b));
+		CPPUNIT_ASSERT(!record.HasServiceClass(0x1124));
+		CPPUNIT_ASSERT_EQUAL(BString("Cucina"), record.name);
+	}
+
+	void TestPruneOld()
+	{
+		// a file with a device not seen for a year, paired and not
+		BMessage file('btDv');
+		int64 longAgo = (int64)time(NULL) - 365 * 24 * 3600;
+		bdaddr_t addresses[] = { kSpeakers, kPhone };
+		for (int i = 0; i < 2; i++) {
+			BMessage device;
+			device.AddData("address", B_RAW_TYPE, &addresses[i],
+				sizeof(bdaddr_t));
+			device.AddInt64("last seen", longAgo);
+			file.AddMessage("device", &device);
+		}
+		BPath directory;
+		SettingsFile::AdapterDirectory(fDirectory, kAdapter, directory);
+		BPath path(directory.Path(), "devices");
+		CPPUNIT_ASSERT_EQUAL(B_OK, SettingsFile::Write(path, file, 0644));
+
+		FileKeyVault vault(fDirectory);
+		BondStore bonds(fDirectory, kAdapter, &vault);
+		bonds.Load();
+		PairingContext context;
+		linkkey_t key;
+		memset(&key, 7, sizeof(key));
+		bonds.PairingFinished(kSpeakers, key, kLinkKeyCombination, context);
+
+		DeviceCache cache(fDirectory, kAdapter);
+		cache.Load();
+		CPPUNIT_ASSERT_EQUAL((int32)1,
+			cache.Prune(bonds, 30 * 24 * 3600, 100));
+		DeviceRecord record;
+		CPPUNIT_ASSERT(cache.Get(kSpeakers, record));
+		CPPUNIT_ASSERT(!cache.Get(kPhone, record));
+	}
+
+	void TestPruneTooMany()
+	{
+		FileKeyVault vault(fDirectory);
+		BondStore bonds(fDirectory, kAdapter, &vault);
+		bonds.Load();
+
+		DeviceCache cache(fDirectory, kAdapter);
+		cache.Load();
+		for (uint8 i = 0; i < 10; i++) {
+			DeviceRecord record;
+			record.address = address(i);
+			cache.Update(record);
+		}
+		CPPUNIT_ASSERT_EQUAL((int32)6,
+			cache.Prune(bonds, 30 * 24 * 3600, 4));
+		CPPUNIT_ASSERT_EQUAL((int32)4, cache.CountRecords());
+	}
+
+	void TestRemove()
+	{
+		DeviceCache cache(fDirectory, kAdapter);
+		cache.Load();
+		cache.SetName(kSpeakers, "Cucina");
+		cache.SetName(kPhone, "moto g15");
+		cache.Remove(kSpeakers);
+		CPPUNIT_ASSERT_EQUAL(B_OK, cache.Flush());
+
+		DeviceCache loaded(fDirectory, kAdapter);
+		loaded.Load();
+		DeviceRecord record;
+		CPPUNIT_ASSERT(!loaded.Get(kSpeakers, record));
+		CPPUNIT_ASSERT(loaded.Get(kPhone, record));
+	}
+
+private:
+	BPath			fDirectory;
+};
+
+
+CPPUNIT_TEST_SUITE_NAMED_REGISTRATION(DeviceCacheTest, getTestSuiteName());
