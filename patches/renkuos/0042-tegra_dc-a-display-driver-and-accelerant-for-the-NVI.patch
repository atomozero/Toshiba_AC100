diff --git a/headers/private/graphics/tegra_dc/tegra_dc_info.h b/headers/private/graphics/tegra_dc/tegra_dc_info.h
new file mode 100644
index 0000000000..e46891df2d
--- /dev/null
+++ b/headers/private/graphics/tegra_dc/tegra_dc_info.h
@@ -0,0 +1,146 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef TEGRA_DC_INFO_H
+#define TEGRA_DC_INFO_H
+
+
+#include <Accelerant.h>
+#include <Drivers.h>
+#include <edid.h>
+
+
+#define TEGRA_DC_ACCELERANT_NAME	"tegra_dc.accelerant"
+#define TEGRA_DC_DEVICE_NAME		"graphics/tegra_dc"
+
+
+/*!	Shared between the kernel driver and the accelerant (cloned read-write
+	by it). The kernel driver owns the hardware: the accelerant only reads
+	this and asks for changes through the ioctls below.
+*/
+struct tegra_dc_shared_info {
+	area_id			mode_list_area;		// created by the primary accelerant
+	uint32			mode_count;
+
+	display_mode	current_mode;
+	uint32			bytes_per_row;
+
+	display_timing	timing;				// as the firmware set the panel up
+	uint32			frame_buffer_size;	// bytes mapped for scanout
+
+	sem_id			vblank_sem;
+	uint32			vblank_count;		// vertical blank interrupts so far
+
+	bool			has_backlight;		// the backlight PWM runs
+	uint32			dpms_mode;			// B_DPMS_*
+
+	edid1_info		edid_info;
+	bool			has_edid;
+};
+
+
+enum {
+	TEGRA_DC_GET_PRIVATE_DATA = B_DEVICE_OP_CODES_END + 1,
+		// area_id of the shared info
+	TEGRA_DC_GET_DEVICE_NAME,
+		// char[B_PATH_NAME_LENGTH]
+	TEGRA_DC_CLONE_FRAME_BUFFER,
+		// area_info of a clone of the scanout memory in the caller
+	TEGRA_DC_SET_DISPLAY_MODE,
+		// display_mode
+	TEGRA_DC_GET_BRIGHTNESS,
+		// uint32, backlight duty cycle 0 - 256
+	TEGRA_DC_SET_BRIGHTNESS,
+		// uint32, backlight duty cycle 1 - 256
+	TEGRA_DC_SET_DPMS_MODE,
+		// uint32, B_DPMS_*
+	TEGRA_DC_SET_CURSOR_BITMAP,
+		// tegra_dc_cursor_bitmap
+	TEGRA_DC_MOVE_CURSOR,
+		// uint16[2], x and y of the hot spot
+	TEGRA_DC_SHOW_CURSOR,
+		// uint32, 0 hides
+	TEGRA_DC_ALLOCATE_OVERLAY_BUFFER,
+		// tegra_dc_overlay_buffer, size in, area and address out
+	TEGRA_DC_RELEASE_OVERLAY_BUFFER,
+		// area_id
+	TEGRA_DC_CONFIGURE_OVERLAY,
+		// tegra_dc_overlay_config
+	TEGRA_DC_GET_HDMI_STATUS,
+		// tegra_dc_hdmi_status
+	TEGRA_DC_RECONNECT_HDMI,
+		// nothing: the HDMI output reads its driver settings again
+	TEGRA_DC_SET_HDMI_VIDEO,
+		// tegra_dc_hdmi_video: a video on the whole HDMI screen, or not
+};
+
+
+struct tegra_dc_hdmi_video {
+	uint32			enable;
+	area_id			handle;			// an overlay buffer, as allocated
+	uint32			space;			// B_YCbCr422 or B_RGB32
+	uint32			bytes_per_row;
+	uint16			width;
+	uint16			height;
+};
+
+
+struct tegra_dc_hdmi_status {
+	bool			plugged;		// the hot plug line is up
+	bool			active;			// the output runs
+	bool			has_edid;
+	bool			hdmi_sink;		// rather than DVI
+	bool			dvi;			// sending DVI
+	bool			enabled;		// not turned off in the settings
+	bool			video;			// showing a video, not the panel
+	char			screen_name[16];
+	uint16			width;
+	uint16			height;
+	uint32			pixel_clock;	// kHz
+	uint16			h_total;
+	uint16			v_total;
+};
+
+
+struct tegra_dc_overlay_buffer {
+	uint32			size;			// in
+	area_id			handle;			// the driver's area, to release it
+	area_id			area;			// a cloneable clone in the caller
+	void*			address;		// of that clone
+	uint32			physical;
+};
+
+struct tegra_dc_overlay_config {
+	uint32			enable;
+	area_id			handle;			// of the buffer to show
+	uint32			space;			// B_YCbCr422 or B_RGB32
+	uint32			bytes_per_row;
+	uint16			source_x;		// part of the buffer shown
+	uint16			source_y;
+	uint16			source_width;
+	uint16			source_height;
+	uint16			x;				// where on screen, inside it
+	uint16			y;
+	uint16			width;
+	uint16			height;
+	uint32			filter;			// bit 0 horizontal, bit 1 vertical
+	bool			color_key;		// show where window A has the key
+	uint32			key_lower;		// 0x00RRGGBB
+	uint32			key_upper;
+};
+
+
+#define TEGRA_DC_CURSOR_SIZE		64
+
+struct tegra_dc_cursor_bitmap {
+	uint16			width;
+	uint16			height;
+	uint16			hot_x;
+	uint16			hot_y;
+	uint32			bytes_per_row;
+	const void*		bits;			// B_RGBA32, in the caller's address space
+};
+
+
+#endif	// TEGRA_DC_INFO_H
