+//	#pragma mark - power and hot plug
+
+
+static status_t
+set_hdmi_power(bool on)
+{
+	const uint8 supplies = TPS6586X_LDO7 | TPS6586X_LDO8;
+	const uint8 registers[] = { TPS6586X_SUPPLYENC, TPS6586X_SUPPLYEND };
+	for (size_t i = 0; i < B_COUNT_OF(registers); i++) {
+		uint8 value;
+		status_t status = arm_dvc_i2c_read(TPS6586X_ADDRESS, registers[i],
+			&value, 1);
+		if (status != B_OK)
+			return status;
+		uint8 newValue = on ? value | supplies : value & ~supplies;
+		if (newValue == value)
+			continue;
+		status = arm_dvc_i2c_write(TPS6586X_ADDRESS, registers[i], &newValue,
+			1);
+		if (status != B_OK)
+			return status;
+	}
+	if (on)
+		snooze(5000);
+	return B_OK;
+}
