@@ -0,0 +1,55 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+/*!	Hardware cursor: a 64x64 image with alpha, on a window of its own. */
+
+
+#include "accelerant.h"
+#include "accelerant_protos.h"
+
+#include <errno.h>
+#include <unistd.h>
+
+
+status_t
+tegra_dc_set_cursor_bitmap(uint16 width, uint16 height, uint16 hotX,
+	uint16 hotY, color_space colorSpace, uint16 bytesPerRow,
+	const uint8* bitmapData)
+{
+	if (colorSpace != B_RGBA32 || width > TEGRA_DC_CURSOR_SIZE
+		|| height > TEGRA_DC_CURSOR_SIZE) {
+		return B_BAD_VALUE;
+	}
+
+	tegra_dc_cursor_bitmap cursor;
+	cursor.width = width;
+	cursor.height = height;
+	cursor.hot_x = hotX;
+	cursor.hot_y = hotY;
+	cursor.bytes_per_row = bytesPerRow;
+	cursor.bits = bitmapData;
+	if (ioctl(gInfo->device, TEGRA_DC_SET_CURSOR_BITMAP, &cursor,
+			sizeof(cursor)) != 0) {
+		return errno;
+	}
+	return B_OK;
+}
+
+
+void
+tegra_dc_move_cursor(uint16 x, uint16 y)
+{
+	uint16 position[2] = { x, y };
+	ioctl(gInfo->device, TEGRA_DC_MOVE_CURSOR, position, sizeof(position));
+}
+
+
+void
+tegra_dc_show_cursor(bool isVisible)
+{
+	uint32 show = isVisible ? 1 : 0;
+	ioctl(gInfo->device, TEGRA_DC_SHOW_CURSOR, &show, sizeof(show));
+}
diff --git a/src/add-ons/accelerants/tegra_dc/hooks.cpp b/src/add-ons/accelerants/tegra_dc/hooks.cpp
new file mode 100644
index 0000000000..19ae7e2779
--- /dev/null
+++ b/src/add-ons/accelerants/tegra_dc/hooks.cpp
@@ -0,0 +1,111 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+#include "accelerant_protos.h"
+
+#include <driver_settings.h>
+
+
+/*!	"hardware_cursor false" in the tegra_dc driver settings leaves the
+	cursor to app_server.
+*/
+static bool
+hardware_cursor_enabled()
+{
+	void* settings = load_driver_settings("tegra_dc");
+	bool enabled = get_driver_boolean_parameter(settings, "hardware_cursor",
+		true, true);
+	unload_driver_settings(settings);
+	return enabled;
+}
+
+
+extern "C" void*
+get_accelerant_hook(uint32 feature, void* data)
+{
+	switch (feature) {
+		// general
+		case B_INIT_ACCELERANT:
+			return (void*)tegra_dc_init_accelerant;
+		case B_UNINIT_ACCELERANT:
+			return (void*)tegra_dc_uninit_accelerant;
+		case B_CLONE_ACCELERANT:
+			return (void*)tegra_dc_clone_accelerant;
+		case B_ACCELERANT_CLONE_INFO_SIZE:
+			return (void*)tegra_dc_accelerant_clone_info_size;
+		case B_GET_ACCELERANT_CLONE_INFO:
+			return (void*)tegra_dc_get_accelerant_clone_info;
+		case B_GET_ACCELERANT_DEVICE_INFO:
+			return (void*)tegra_dc_get_accelerant_device_info;
+		case B_ACCELERANT_RETRACE_SEMAPHORE:
+			return (void*)tegra_dc_accelerant_retrace_semaphore;
+
+		// modes
+		case B_ACCELERANT_MODE_COUNT:
+			return (void*)tegra_dc_accelerant_mode_count;
+		case B_GET_MODE_LIST:
+			return (void*)tegra_dc_get_mode_list;
+		case B_PROPOSE_DISPLAY_MODE:
+			return (void*)tegra_dc_propose_display_mode;
+		case B_SET_DISPLAY_MODE:
+			return (void*)tegra_dc_set_display_mode;
+		case B_GET_DISPLAY_MODE:
+			return (void*)tegra_dc_get_display_mode;
+		case B_GET_PREFERRED_DISPLAY_MODE:
+			return (void*)tegra_dc_get_preferred_display_mode;
+		case B_GET_EDID_INFO:
+			return (void*)tegra_dc_get_edid_info;
+		case B_GET_FRAME_BUFFER_CONFIG:
+			return (void*)tegra_dc_get_frame_buffer_config;
+		case B_GET_PIXEL_CLOCK_LIMITS:
+			return (void*)tegra_dc_get_pixel_clock_limits;
+
+		// cursor
+		case B_SET_CURSOR_BITMAP:
+			return hardware_cursor_enabled()
+				? (void*)tegra_dc_set_cursor_bitmap : NULL;
+		case B_MOVE_CURSOR:
+			return hardware_cursor_enabled()
+				? (void*)tegra_dc_move_cursor : NULL;
+		case B_SHOW_CURSOR:
+			return hardware_cursor_enabled()
+				? (void*)tegra_dc_show_cursor : NULL;
+
+		// brightness and display power
+		case B_SET_BRIGHTNESS:
+			return (void*)tegra_dc_set_brightness;
+		case B_GET_BRIGHTNESS:
+			return (void*)tegra_dc_get_brightness;
+		case B_DPMS_CAPABILITIES:
+			return (void*)tegra_dc_dpms_capabilities;
+		case B_DPMS_MODE:
+			return (void*)tegra_dc_dpms_mode;
+		case B_SET_DPMS_MODE:
+			return (void*)tegra_dc_set_dpms_mode;
+
+		// overlay
+		case B_OVERLAY_COUNT:
+			return (void*)tegra_dc_overlay_count;
+		case B_OVERLAY_SUPPORTED_SPACES:
+			return (void*)tegra_dc_overlay_supported_spaces;
+		case B_OVERLAY_SUPPORTED_FEATURES:
+			return (void*)tegra_dc_overlay_supported_features;
+		case B_ALLOCATE_OVERLAY_BUFFER:
+			return (void*)tegra_dc_allocate_overlay_buffer;
+		case B_RELEASE_OVERLAY_BUFFER:
+			return (void*)tegra_dc_release_overlay_buffer;
+		case B_GET_OVERLAY_CONSTRAINTS:
+			return (void*)tegra_dc_get_overlay_constraints;
+		case B_ALLOCATE_OVERLAY:
+			return (void*)tegra_dc_allocate_overlay;
+		case B_RELEASE_OVERLAY:
+			return (void*)tegra_dc_release_overlay;
+		case B_CONFIGURE_OVERLAY:
+			return (void*)tegra_dc_configure_overlay;
+	}
+
+	return NULL;
+}
diff --git a/src/add-ons/accelerants/tegra_dc/mode.cpp b/src/add-ons/accelerants/tegra_dc/mode.cpp
new file mode 100644
index 0000000000..d1ad99607f
--- /dev/null
+++ b/src/add-ons/accelerants/tegra_dc/mode.cpp
@@ -0,0 +1,160 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+/*!	Modes: the panel as the firmware set it up, at 32 or 16 bits per pixel. */
+
+
+#include "accelerant.h"
+#include "accelerant_protos.h"
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <create_display_modes.h>
+#include <video_overlay.h>
+
+
+static bool
+is_mode_supported(display_mode* mode)
+{
+	const display_timing& timing = gInfo->shared_info->timing;
+	return mode != NULL
+		&& mode->timing.h_display == timing.h_display
+		&& mode->timing.v_display == timing.v_display
+		&& mode->virtual_width == timing.h_display
+		&& mode->virtual_height == timing.v_display
+		&& (mode->space == B_RGB32 || mode->space == B_RGB16);
+}
+
+
+static void
+panel_mode(display_mode& mode, color_space space)
+{
+	memset(&mode, 0, sizeof(display_mode));
+	mode.timing = gInfo->shared_info->timing;
+	mode.space = space;
+	mode.virtual_width = mode.timing.h_display;
+	mode.virtual_height = mode.timing.v_display;
+	mode.flags = B_8_BIT_DAC | B_PARALLEL_ACCESS | B_HARDWARE_CURSOR
+		| B_SUPPORTS_OVERLAYS;
+	if (gInfo->shared_info->has_backlight)
+		mode.flags |= B_DPMS;
+}
+
+
+status_t
+create_mode_list()
+{
+	const color_space spaces[] = { B_RGB32, B_RGB16 };
+	display_mode mode;
+	panel_mode(mode, B_RGB32);
+
+	gInfo->mode_list_area = create_display_modes("tegra_dc modes", NULL,
+		&mode, 1, spaces, B_COUNT_OF(spaces), is_mode_supported,
+		&gInfo->mode_list, &gInfo->shared_info->mode_count);
+	if (gInfo->mode_list_area < 0)
+		return gInfo->mode_list_area;
+
+	gInfo->shared_info->mode_list_area = gInfo->mode_list_area;
+	return B_OK;
+}
+
+
+//	#pragma mark -
+
+
+uint32
+tegra_dc_accelerant_mode_count(void)
+{
+	return gInfo->shared_info->mode_count;
+}
+
+
+status_t
+tegra_dc_get_mode_list(display_mode* modes)
+{
+	memcpy(modes, gInfo->mode_list,
+		gInfo->shared_info->mode_count * sizeof(display_mode));
+	return B_OK;
+}
+
+
+status_t
+tegra_dc_propose_display_mode(display_mode* target, const display_mode* low,
+	const display_mode* high)
+{
+	// The panel has one timing: keep the color space, take everything else
+	color_space space = (color_space)target->space;
+	if (space != B_RGB16)
+		space = B_RGB32;
+	panel_mode(*target, space);
+	return B_OK;
+}
+
+
+status_t
+tegra_dc_set_display_mode(display_mode* mode)
+{
+	if (!is_mode_supported(mode))
+		return B_BAD_VALUE;
+	if (ioctl(gInfo->device, TEGRA_DC_SET_DISPLAY_MODE, mode,
+			sizeof(display_mode)) != 0) {
+		return errno;
+	}
+	return B_OK;
+}
+
+
+status_t
+tegra_dc_get_display_mode(display_mode* currentMode)
+{
+	*currentMode = gInfo->shared_info->current_mode;
+	return B_OK;
+}
+
+
+status_t
+tegra_dc_get_preferred_display_mode(display_mode* preferredMode)
+{
+	panel_mode(*preferredMode, B_RGB32);
+	return B_OK;
+}
+
+
+status_t
+tegra_dc_get_edid_info(void* info, size_t size, uint32* _version)
+{
+	if (!gInfo->shared_info->has_edid)
+		return B_ERROR;
+	if (size < sizeof(edid1_info))
+		return B_BUFFER_OVERFLOW;
+
+	memcpy(info, &gInfo->shared_info->edid_info, sizeof(edid1_info));
+	*_version = EDID_VERSION_1;
+	return B_OK;
+}
+
+
+status_t
+tegra_dc_get_frame_buffer_config(frame_buffer_config* config)
+{
+	config->frame_buffer = gInfo->frame_buffer;
+	config->frame_buffer_dma = NULL;
+	config->bytes_per_row = gInfo->shared_info->bytes_per_row;
+	return B_OK;
+}
+
+
+status_t
+tegra_dc_get_pixel_clock_limits(display_mode* mode, uint32* _low,
+	uint32* _high)
+{
+	// Only the panel's own pixel clock
+	*_low = *_high = gInfo->shared_info->timing.pixel_clock;
+	return B_OK;
+}
diff --git a/src/add-ons/accelerants/tegra_dc/overlay.cpp b/src/add-ons/accelerants/tegra_dc/overlay.cpp
new file mode 100644
index 0000000000..d6747c3d08
--- /dev/null
+++ b/src/add-ons/accelerants/tegra_dc/overlay.cpp
@@ -0,0 +1,279 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+/*!	Video overlay: window B of the display controller scales a YCbCr 4:2:2
+	or RGB32 frame, converts it to RGB, and shows it under the desktop where
+	that has the key color. The frames are physically contiguous buffers the
+	kernel driver allocates.
+*/
+
+
+#include "accelerant.h"
+#include "accelerant_protos.h"
+
+#include <errno.h>
+#include <new>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+
+struct tegra_dc_overlay {
+	overlay_buffer		buffer;		// first, app_server sees only this
+	area_id				handle;
+	area_id				area;
+};
+
+
+static const uint32 kSupportedSpaces[] = { B_YCbCr422, B_RGB32, 0 };
+
+static int32 sOverlayToken;
+static bool sOverlayAllocated;
+
+
+static uint32
+bytes_per_pixel(uint32 space)
+{
+	return space == B_YCbCr422 ? 2 : 4;
+}
+
+
+/*!	The key compares window A pixels before their expansion to 24 bits; red
+	is the low byte.
+*/
+static void
+key_range(const overlay_window& window, uint32& lower, uint32& upper)
+{
+	const overlay_key_color* keys[] = { &window.red, &window.green,
+		&window.blue };
+	uint32 shifts[] = { 0, 0, 0 };
+	if (gInfo->shared_info->current_mode.space == B_RGB16) {
+		shifts[0] = 3;
+		shifts[1] = 2;
+		shifts[2] = 3;
+	}
+
+	lower = upper = 0;
+	for (int32 i = 0; i < 3; i++) {
+		uint32 low = (keys[i]->value & keys[i]->mask) << shifts[i];
+		uint32 high = ((keys[i]->value | ~keys[i]->mask) << shifts[i]) & 0xff;
+		lower |= (low & 0xff) << (8 * i);
+		upper |= high << (8 * i);
+	}
+}
+
+
+static status_t
+hide_overlay()
+{
+	tegra_dc_overlay_config config = {};
+	if (ioctl(gInfo->device, TEGRA_DC_CONFIGURE_OVERLAY, &config,
+			sizeof(config)) != 0) {
+		return errno;
+	}
+	return B_OK;
+}
+
+
+//	#pragma mark -
+
+
+uint32
+tegra_dc_overlay_count(const display_mode* mode)
+{
+	return 1;
+}
+
+
+const uint32*
+tegra_dc_overlay_supported_spaces(const display_mode* mode)
+{
+	return kSupportedSpaces;
+}
+
+
+uint32
+tegra_dc_overlay_supported_features(uint32 colorSpace)
+{
+	return B_OVERLAY_COLOR_KEY | B_OVERLAY_HORIZONTAL_FILTERING
+		| B_OVERLAY_VERTICAL_FILTERING;
+}
+
+
+const overlay_buffer*
+tegra_dc_allocate_overlay_buffer(color_space colorSpace, uint16 width,
+	uint16 height)
+{
+	if (colorSpace != B_YCbCr422 && colorSpace != B_RGB32)
+		return NULL;
+	if (width == 0 || height == 0 || width > 2048 || height > 2048)
+		return NULL;
+
+	tegra_dc_overlay* overlay = new(std::nothrow) tegra_dc_overlay;
+	if (overlay == NULL)
+		return NULL;
+
+	uint32 bytesPerRow = (width * bytes_per_pixel(colorSpace) + 63) & ~63u;
+	tegra_dc_overlay_buffer request = {};
+	request.size = bytesPerRow * height;
+	if (ioctl(gInfo->device, TEGRA_DC_ALLOCATE_OVERLAY_BUFFER, &request,
+			sizeof(request)) != 0) {
+		delete overlay;
+		return NULL;
+	}
+
+	overlay->handle = request.handle;
+	overlay->area = request.area;
+	overlay->buffer.space = colorSpace;
+	overlay->buffer.width = width;
+	overlay->buffer.height = height;
+	overlay->buffer.bytes_per_row = bytesPerRow;
+	overlay->buffer.buffer = request.address;
+	overlay->buffer.buffer_dma = (void*)(addr_t)request.physical;
+	return &overlay->buffer;
+}
+
+
+status_t
+tegra_dc_release_overlay_buffer(const overlay_buffer* buffer)
+{
+	if (buffer == NULL)
+		return B_BAD_VALUE;
+
+	tegra_dc_overlay* overlay = (tegra_dc_overlay*)buffer;
+	delete_area(overlay->area);
+	ioctl(gInfo->device, TEGRA_DC_RELEASE_OVERLAY_BUFFER, &overlay->handle,
+		sizeof(overlay->handle));
+	delete overlay;
+	return B_OK;
+}
+
+
+status_t
+tegra_dc_get_overlay_constraints(const display_mode* mode,
+	const overlay_buffer* buffer, overlay_constraints* constraints)
+{
+	if (buffer == NULL || constraints == NULL)
+		return B_BAD_VALUE;
+
+	memset(constraints, 0, sizeof(overlay_constraints));
+
+	// 4:2:2 frames start on a pixel pair
+	uint16 alignment = buffer->space == B_YCbCr422 ? 1 : 0;
+	constraints->view.h_alignment = alignment;
+	constraints->view.width_alignment = alignment;
+	constraints->view.width.min = 2;
+	constraints->view.width.max = buffer->width;
+	constraints->view.height.min = 2;
+	constraints->view.height.max = buffer->height;
+
+	constraints->window.width.min = 2;
+	constraints->window.width.max = 4096;
+	constraints->window.height.min = 2;
+	constraints->window.height.max = 4096;
+
+	// The DDA steps at most 8 (2 bytes per pixel) or 4 (4 bytes) source
+	// pixels horizontally and 15 lines vertically
+	constraints->h_scale.min = buffer->space == B_YCbCr422 ? 1.0f / 8 : 1.0f / 4;
+	constraints->h_scale.max = 16.0f;
+	constraints->v_scale.min = 1.0f / 15;
+	constraints->v_scale.max = 16.0f;
+	return B_OK;
+}
+
+
+overlay_token
+tegra_dc_allocate_overlay(void)
+{
+	if (sOverlayAllocated)
+		return NULL;
+	sOverlayAllocated = true;
+	return (overlay_token)&sOverlayToken;
+}
+
+
+status_t
+tegra_dc_release_overlay(overlay_token overlayToken)
+{
+	if (overlayToken != (overlay_token)&sOverlayToken || !sOverlayAllocated)
+		return B_BAD_VALUE;
+
+	hide_overlay();
+	sOverlayAllocated = false;
+	return B_OK;
+}
+
+
+status_t
+tegra_dc_configure_overlay(overlay_token overlayToken,
+	const overlay_buffer* buffer, const overlay_window* window,
+	const overlay_view* view)
+{
+	if (overlayToken != (overlay_token)&sOverlayToken)
+		return B_BAD_VALUE;
+	if (buffer == NULL || window == NULL || view == NULL)
+		return hide_overlay();
+
+	const tegra_dc_overlay* overlay = (const tegra_dc_overlay*)buffer;
+	if (window->width == 0 || window->height == 0 || view->width == 0
+		|| view->height == 0) {
+		return hide_overlay();
+	}
+
+	// Clip the window to the screen, and the view with it
+	const display_timing& timing = gInfo->shared_info->current_mode.timing;
+	int32 left = max_c(window->h_start, 0);
+	int32 top = max_c(window->v_start, 0);
+	int32 right = min_c(window->h_start + window->width,
+		(int32)timing.h_display);
+	int32 bottom = min_c(window->v_start + window->height,
+		(int32)timing.v_display);
+	if (left >= right || top >= bottom)
+		return hide_overlay();
+
+	float hScale = (float)view->width / window->width;
+	float vScale = (float)view->height / window->height;
+	int32 sourceLeft = view->h_start
+		+ (int32)((left - window->h_start) * hScale + 0.5f);
+	int32 sourceTop = view->v_start
+		+ (int32)((top - window->v_start) * vScale + 0.5f);
+	int32 sourceRight = view->h_start
+		+ (int32)((right - window->h_start) * hScale + 0.5f);
+	int32 sourceBottom = view->v_start
+		+ (int32)((bottom - window->v_start) * vScale + 0.5f);
+	sourceRight = min_c(sourceRight, (int32)buffer->width);
+	sourceBottom = min_c(sourceBottom, (int32)buffer->height);
+	if (sourceLeft >= sourceRight || sourceTop >= sourceBottom)
+		return hide_overlay();
+
+	tegra_dc_overlay_config config = {};
+	config.enable = 1;
+	config.handle = overlay->handle;
+	config.space = buffer->space;
+	config.bytes_per_row = buffer->bytes_per_row;
+	config.source_x = sourceLeft;
+	config.source_y = sourceTop;
+	config.source_width = sourceRight - sourceLeft;
+	config.source_height = sourceBottom - sourceTop;
+	config.x = left;
+	config.y = top;
+	config.width = right - left;
+	config.height = bottom - top;
+	if ((window->flags & B_OVERLAY_HORIZONTAL_FILTERING) != 0)
+		config.filter |= 1;
+	if ((window->flags & B_OVERLAY_VERTICAL_FILTERING) != 0)
+		config.filter |= 2;
+	if ((window->flags & B_OVERLAY_COLOR_KEY) != 0) {
+		config.color_key = true;
+		key_range(*window, config.key_lower, config.key_upper);
+	}
+
+	if (ioctl(gInfo->device, TEGRA_DC_CONFIGURE_OVERLAY, &config,
+			sizeof(config)) != 0) {
+		return errno;
+	}
+	return B_OK;
+}
diff --git a/src/add-ons/accelerants/tegra_dc/power.cpp b/src/add-ons/accelerants/tegra_dc/power.cpp
new file mode 100644
index 0000000000..282cde3523
--- /dev/null
+++ b/src/add-ons/accelerants/tegra_dc/power.cpp
@@ -0,0 +1,81 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+/*!	Brightness and display power: the panel backlight, through the kernel
+	driver.
+*/
+
+
+#include "accelerant.h"
+#include "accelerant_protos.h"
+
+#include <errno.h>
+#include <unistd.h>
+
+
+status_t
+tegra_dc_set_brightness(float brightness)
+{
+	if (!gInfo->shared_info->has_backlight)
+		return B_NOT_SUPPORTED;
+
+	// 1 - 256: never fully off, that is what DPMS is for
+	if (brightness < 0)
+		brightness = 0;
+	if (brightness > 1)
+		brightness = 1;
+	uint32 duty = (uint32)(brightness * 255 + 0.5f) + 1;
+	if (ioctl(gInfo->device, TEGRA_DC_SET_BRIGHTNESS, &duty, sizeof(duty))
+			!= 0) {
+		return errno;
+	}
+	return B_OK;
+}
+
+
+status_t
+tegra_dc_get_brightness(float* brightness)
+{
+	if (!gInfo->shared_info->has_backlight)
+		return B_NOT_SUPPORTED;
+
+	uint32 duty;
+	if (ioctl(gInfo->device, TEGRA_DC_GET_BRIGHTNESS, &duty, sizeof(duty))
+			!= 0) {
+		return errno;
+	}
+	*brightness = duty <= 1 ? 0 : (duty - 1) / 255.0f;
+	return B_OK;
+}
+
+
+uint32
+tegra_dc_dpms_capabilities(void)
+{
+	if (!gInfo->shared_info->has_backlight)
+		return B_DPMS_ON;
+	return B_DPMS_ON | B_DPMS_STAND_BY | B_DPMS_SUSPEND | B_DPMS_OFF;
+}
+
+
+uint32
+tegra_dc_dpms_mode(void)
+{
+	return gInfo->shared_info->dpms_mode;
+}
+
+
+status_t
+tegra_dc_set_dpms_mode(uint32 mode)
+{
+	if (!gInfo->shared_info->has_backlight)
+		return mode == B_DPMS_ON ? B_OK : B_NOT_SUPPORTED;
+	if (ioctl(gInfo->device, TEGRA_DC_SET_DPMS_MODE, &mode, sizeof(mode))
+			!= 0) {
+		return errno;
+	}
+	return B_OK;
+}
