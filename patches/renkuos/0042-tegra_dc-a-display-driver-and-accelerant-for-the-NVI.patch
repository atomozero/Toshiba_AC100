+
+//	#pragma mark - driver
+
+
+/*!	Only claims the display when the firmware left it as expected: a Tegra 2,
+	display controller A running, and window A scanning out of the memory
+	reserved for it.
+*/
+status_t
+init_hardware(void)
+{
+	if (gFDT == NULL || fdt_node_check_compatible(gFDT, 0, "nvidia,tegra20")
+			!= 0) {
+		return B_DEVICE_NOT_FOUND;
+	}
+
+	area_id carArea;
+	volatile uint32* car = map_registers("tegra car", TEGRA20_CAR_BASE,
+		B_PAGE_SIZE, &carArea);
+	if (car == NULL)
+		return B_ERROR;
+	bool running = (car[CAR_CLK_OUT_ENB_L / 4] & CAR_DISP1_BIT) != 0
+		&& (car[CAR_RST_DEVICES_L / 4] & CAR_DISP1_BIT) == 0;
+	delete_area(carArea);
+	if (!running) {
+		dprintf("tegra_dc: display controller A is not running\n");
+		return B_DEVICE_NOT_FOUND;
+	}
+
+	area_id dcArea;
+	volatile uint32* dc = map_registers("tegra_dc registers",
+		TEGRA20_DC_A_BASE, TEGRA20_DC_SIZE, &dcArea);
+	if (dc == NULL)
+		return B_ERROR;
+	dc[DC_CMD_DISPLAY_WINDOW_HEADER] = WINDOW_A_SELECT;
+	uint32 options = dc[WIN_OPTIONS];
+	uint32 start = dc[WINBUF_START_ADDR];
+	uint32 size = dc[WIN_SIZE];
+	delete_area(dcArea);
+
+	if ((options & WIN_OPTIONS_ENABLE) == 0 || start != SCANOUT_BASE
+		|| size != ((PANEL_HEIGHT << 16) | PANEL_WIDTH)) {
+		dprintf("tegra_dc: window A not as expected (options %#" B_PRIx32
+			", start %#" B_PRIx32 ", size %#" B_PRIx32 ")\n", options, start,
+			size);
+		return B_DEVICE_NOT_FOUND;
+	}
+	return B_OK;
+}
+
+
+status_t
+init_driver(void)
+{
+	memset(&sDevice, 0, sizeof(sDevice));
+	sDevice.registers_area = sDevice.scanout_area = sDevice.shared_area = -1;
+	sDevice.pwm_area = -1;
+	for (int32 i = 0; i < MAX_OVERLAY_BUFFERS; i++)
+		sDevice.overlay_buffers[i].area = sDevice.overlay_buffers[i].memory = -1;
+	mutex_init(&sDevice.lock, "tegra_dc");
+	return B_OK;
+}
+
+
+void
+uninit_driver(void)
+{
+	mutex_destroy(&sDevice.lock);
+}
+
+
+const char**
+publish_devices(void)
+{
+	return sDeviceNames;
+}
+
+
+device_hooks*
+find_device(const char* name)
+{
+	return &sDeviceHooks;
+}
