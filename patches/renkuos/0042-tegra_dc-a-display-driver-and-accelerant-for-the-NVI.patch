+
+/*!	Turns the clock of a block on and takes it out of reset, or puts it
+	back into reset and stops its clock.
+*/
+static void
+enable_block(uint32 enableRegister, uint32 resetRegister, uint32 bit,
+	bool enable)
+{
+	if (enable) {
+		write_car(resetRegister, read_car(resetRegister) | bit);
+		write_car(enableRegister, read_car(enableRegister) | bit);
+		snooze(1000);
+		write_car(resetRegister, read_car(resetRegister) & ~bit);
+		spin(10);
+	} else {
+		write_car(resetRegister, read_car(resetRegister) | bit);
+		write_car(enableRegister, read_car(enableRegister) & ~bit);
+	}
+}
