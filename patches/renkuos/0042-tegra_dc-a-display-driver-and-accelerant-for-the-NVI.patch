+
+static void
+setup_hot_plug_pin()
+{
+	// GPIO mode, input: the masked registers change only this pin
+	volatile uint32* port = sHdmi.gpio + GPIO_BANK3_PORT1 / 4;
+	port[(GPIO_MASKED + GPIO_OE) / 4] = 1u << (HOT_PLUG_BIT + 8);
+	port[(GPIO_MASKED + GPIO_CNF) / 4]
+		= (1u << (HOT_PLUG_BIT + 8)) | (1u << HOT_PLUG_BIT);
+}
+
+
+static bool
+screen_plugged()
+{
+	volatile uint32* port = sHdmi.gpio + GPIO_BANK3_PORT1 / 4;
+	return (port[GPIO_IN / 4] & (1u << HOT_PLUG_BIT)) != 0;
+}
