From 602c8577c51a1100e1540138601604b6ae6009ef Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 00:27:53 +0200
Subject: [PATCH 067/203] ARM bring-up: log enumerated USB devices and failed
 addressing (not for merging)

---
 src/add-ons/kernel/bus_managers/usb/BusManager.cpp | 2 ++
 src/add-ons/kernel/bus_managers/usb/Device.cpp     | 4 ++++
 2 files changed, 6 insertions(+)

diff --git a/src/add-ons/kernel/bus_managers/usb/BusManager.cpp b/src/add-ons/kernel/bus_managers/usb/BusManager.cpp
index bc264e8aa1..2424cc4a98 100644
--- a/src/add-ons/kernel/bus_managers/usb/BusManager.cpp
+++ b/src/add-ons/kernel/bus_managers/usb/BusManager.cpp
@@ -157,6 +157,8 @@ BusManager::AllocateDevice(Hub *parent, int8 hubAddress, uint8 hubPort,
 
 	if (result < B_OK) {
 		TRACE_ERROR("error while setting device address\n");
+		dprintf("AC100: usb set address failed: speed %d, behind hub %d port "
+			"%d\n", speed, hubAddress, hubPort);
 		FreeAddress(deviceAddress);
 		return NULL;
 	}
diff --git a/src/add-ons/kernel/bus_managers/usb/Device.cpp b/src/add-ons/kernel/bus_managers/usb/Device.cpp
index b85fd496c1..adb8613059 100644
--- a/src/add-ons/kernel/bus_managers/usb/Device.cpp
+++ b/src/add-ons/kernel/bus_managers/usb/Device.cpp
@@ -54,6 +54,10 @@ Device::Device(Object* parent, int8 hubAddress, uint8 hubPort,
 	}
 
 	TRACE("full device descriptor for device %d:\n", fDeviceAddress);
+	dprintf("AC100: usb device %d: %04x:%04x class %d, speed %d, behind hub %d "
+		"port %d\n", fDeviceAddress, fDeviceDescriptor.vendor_id,
+		fDeviceDescriptor.product_id, fDeviceDescriptor.device_class, speed,
+		fHubAddress, fHubPort);
 	TRACE("\tlength:..............%d\n", fDeviceDescriptor.length);
 	TRACE("\tdescriptor_type:.....0x%04x\n", fDeviceDescriptor.descriptor_type);
 	TRACE("\tusb_version:.........0x%04x\n", fDeviceDescriptor.usb_version);
