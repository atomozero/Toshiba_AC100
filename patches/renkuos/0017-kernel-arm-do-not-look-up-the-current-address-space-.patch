From b399bb2ab9ff5c154f6eef2c1b6c2abc6bca402d Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 16:15:01 +0200
Subject: [PATCH 017/270] kernel/arm: do not look up the current address space
 without a team

arch_arm_handle_access_flag_fault() called VMAddressSpace::GetCurrent()
for faults on user addresses. During early boot the current thread is
the idle thread, which has no team yet, so a fault on a user address at
that time faulted again on thread->team->address_space instead of being
reported (seen on the Toshiba AC100 during vm_init).
---
 src/system/kernel/arch/arm/arch_int.cpp | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/system/kernel/arch/arm/arch_int.cpp b/src/system/kernel/arch/arm/arch_int.cpp
index 8b9d657413..d4a60a0655 100644
--- a/src/system/kernel/arch/arm/arch_int.cpp
+++ b/src/system/kernel/arch/arm/arch_int.cpp
@@ -311,8 +311,13 @@ arch_arm_handle_access_flag_fault(addr_t far, uint32 fsr, bool isWrite, bool isE
 	VMAddressSpacePutter addressSpace;
 	if (IS_KERNEL_ADDRESS(far))
 		addressSpace.SetTo(VMAddressSpace::GetKernel());
-	else if (IS_USER_ADDRESS(far))
-		addressSpace.SetTo(VMAddressSpace::GetCurrent());
+	else if (IS_USER_ADDRESS(far)) {
+		// During early boot the current (idle) thread has no team yet, and
+		// VMAddressSpace::GetCurrent() would dereference it.
+		Thread* thread = thread_get_current_thread();
+		if (thread != NULL && thread->team != NULL)
+			addressSpace.SetTo(VMAddressSpace::GetCurrent());
+	}
 
 	if (!addressSpace.IsSet())
 		return false;
