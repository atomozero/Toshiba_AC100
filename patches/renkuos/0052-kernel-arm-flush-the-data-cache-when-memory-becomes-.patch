From 875e2294a782a89a444f3f1a9874e55e419f2bf1 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 22:35:39 +0200
Subject: [PATCH 052/203] kernel/arm: flush the data cache when memory becomes
 non-cacheable

Memory that was mapped cacheable may still have lines in the data cache
when it is remapped non-cacheable, and a dirty line could later be
evicted over data written through the new mapping, e.g. by a DMA engine.
Write back and discard the level 1 data cache in
arch_vm_set_memory_type() for uncached and write combining memory.
---
 headers/private/kernel/arch/arm/arch_cpu.h |  1 +
 src/system/kernel/arch/arm/arch_cpu.cpp    | 30 ++++++++++++++++++++++
 src/system/kernel/arch/arm/arch_vm.cpp     |  6 +++++
 3 files changed, 37 insertions(+)

diff --git a/headers/private/kernel/arch/arm/arch_cpu.h b/headers/private/kernel/arch/arm/arch_cpu.h
index c68b57915c..f44e7ade16 100644
--- a/headers/private/kernel/arch/arm/arch_cpu.h
+++ b/headers/private/kernel/arch/arm/arch_cpu.h
@@ -147,6 +147,7 @@ arm_clean_dcache_range(const void* address, size_t size)
 
 void arch_cpu_invalidate_TLB_page(addr_t page);
 void arm_sync_icache_all(void);
+void arm_clean_invalidate_dcache_all(void);
 
 static inline void
 arch_cpu_pause(void)
diff --git a/src/system/kernel/arch/arm/arch_cpu.cpp b/src/system/kernel/arch/arm/arch_cpu.cpp
index bce39721b1..cee7c43d3b 100644
--- a/src/system/kernel/arch/arm/arch_cpu.cpp
+++ b/src/system/kernel/arch/arm/arch_cpu.cpp
@@ -331,6 +331,36 @@ arm_sync_icache_all(void)
 }
 
 
+/*!	Writes back and discards the whole level 1 data cache of the current CPU,
+	e.g. before memory that was cached is accessed through a non-cacheable
+	mapping, so that no dirty line can be evicted over it later.
+*/
+void
+arm_clean_invalidate_dcache_all(void)
+{
+	asm volatile ("mcr p15, 2, %0, c0, c0, 0" : : "r" (0));
+	asm volatile ("isb");
+	uint32 ccsidr;
+	asm volatile ("mrc p15, 1, %0, c0, c0, 0" : "=r" (ccsidr));
+
+	uint32 lineShift = (ccsidr & 7) + 4;
+	uint32 ways = ((ccsidr >> 3) & 0x3ff) + 1;
+	uint32 sets = ((ccsidr >> 13) & 0x7fff) + 1;
+	uint32 wayShift = ways > 1 ? __builtin_clz(ways - 1) : 0;
+
+	dsb();
+	for (uint32 way = 0; way < ways; way++) {
+		for (uint32 set = 0; set < sets; set++) {
+			// DCCISW: clean and invalidate by set/way
+			uint32 value = (way << wayShift) | (set << lineShift);
+			asm volatile ("mcr p15, 0, %0, c7, c14, 2" : : "r" (value)
+				: "memory");
+		}
+	}
+	dsb();
+}
+
+
 void
 arch_cpu_sync_icache(void *address, size_t len)
 {
diff --git a/src/system/kernel/arch/arm/arch_vm.cpp b/src/system/kernel/arch/arm/arch_vm.cpp
index 7a82d1b653..0d0d23dc38 100644
--- a/src/system/kernel/arch/arm/arch_vm.cpp
+++ b/src/system/kernel/arch/arm/arch_vm.cpp
@@ -181,5 +181,11 @@ status_t
 arch_vm_set_memory_type(VMArea *area, phys_addr_t physicalBase, uint32 type,
 	uint32 *effectiveType)
 {
+	// Memory that was mapped cacheable before may still have lines in the
+	// data cache; write them back and discard them, or they could later be
+	// evicted over data written through the new, non-cacheable mapping (e.g.
+	// by a DMA engine).
+	if (type == B_UNCACHED_MEMORY || type == B_WRITE_COMBINING_MEMORY)
+		arm_clean_invalidate_dcache_all();
 	return B_OK;
 }
