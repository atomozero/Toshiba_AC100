From 54c57d7023713f8b7852e8924eaf80b07c3fe009 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 19 Oct 2026 07:45:43 +0200
Subject: [PATCH 128/203] kernel/arm: switch branch prediction on for every CPU

The firmware switches branch prediction on for the boot CPU only; the other
CPUs come out of reset without it (SCTLR.Z clear), and a busy loop ran about
three times slower on the second CPU of the AC100. Switch it on in the per
CPU setup and log SCTLR and ACTLR of each CPU.
---
 src/system/kernel/arch/arm/arch_cpu.cpp | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/src/system/kernel/arch/arm/arch_cpu.cpp b/src/system/kernel/arch/arm/arch_cpu.cpp
index 22d5271761..9df0664e59 100644
--- a/src/system/kernel/arch/arm/arch_cpu.cpp
+++ b/src/system/kernel/arch/arm/arch_cpu.cpp
@@ -61,6 +61,23 @@ arch_cpu_init_percpu(kernel_args *args, int curr_cpu)
 	if (curr_cpu != 0)
 		arch_int_init_secondary_cpu(curr_cpu);
 
+	// Branch prediction: the firmware switches it on for the boot CPU only,
+	// the others come out of reset without; a busy loop then runs about
+	// three times slower on them
+	uint32 control;
+	asm volatile("mrc p15, 0, %0, c1, c0, 0" : "=r" (control));
+	uint32 auxControl;
+	asm volatile("mrc p15, 0, %0, c1, c0, 1" : "=r" (auxControl));
+	if ((control & (1 << 11)) == 0) {
+		asm volatile("mcr p15, 0, %0, c7, c5, 6; dsb; isb" : : "r" (0));
+			// BPIALL
+		asm volatile("mcr p15, 0, %0, c1, c0, 0; isb"
+			: : "r" (control | (1 << 11)));
+	}
+	dprintf("arm: CPU %d: SCTLR 0x%08" B_PRIx32 " (branch prediction %s),"
+		" ACTLR 0x%08" B_PRIx32 "\n", curr_cpu, control,
+		(control & (1 << 11)) != 0 ? "on" : "switched on", auxControl);
+
 	return B_OK;
 }
 
