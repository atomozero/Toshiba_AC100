diff --git a/headers/private/gpio/tegra.h b/headers/private/gpio/tegra.h
new file mode 100644
index 0000000000..ac08973a28
--- /dev/null
+++ b/headers/private/gpio/tegra.h
@@ -0,0 +1,84 @@
+/*
+ * Copyright 2026, Haiku, Inc. All Rights Reserved.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _GPIO_TEGRA_H
+#define _GPIO_TEGRA_H
+
+
+#include <device_manager.h>
+#include <KernelExport.h>
+
+
+/*!	Interface of the GPIO controller of NVIDIA Tegra 2.
+
+	The controller has 224 pins, numbered from 0 to 223 in the same way as
+	the device tree: the first 32 pins are controller 1, ports A to D, and
+	so on. Consumers request a pin, configure it and then read or write it.
+	A pin belongs to one consumer at a time; the owner string is only used
+	to report and to check that the right consumer releases the pin again.
+
+	The pins are configured in GPIO mode (GPIO_CNF set), but the pin mux and
+	the pad tristate are left alone: firmware and the other drivers decide
+	which function a pin has, and changing it here would break consumers
+	that share a pin group.
+*/
+
+#define TEGRA_GPIO_MODULE_NAME	"busses/gpio/tegra_gpio/interface_v1"
+
+// number of pins of the controller
+#define TEGRA_GPIO_PIN_COUNT	224
+
+// the largest owner string that is remembered
+#define TEGRA_GPIO_OWNER_LENGTH	32
+
+// interrupt modes
+#define TEGRA_GPIO_INTERRUPT_LEVEL_HIGH		0
+#define TEGRA_GPIO_INTERRUPT_LEVEL_LOW		1
+#define TEGRA_GPIO_INTERRUPT_RISING			2
+#define TEGRA_GPIO_INTERRUPT_FALLING		3
+#define TEGRA_GPIO_INTERRUPT_ANY_CHANGE		4
+
+
+/*!	Runs in interrupt context: it must not sleep or acquire a mutex.
+	An interrupt on a level (TEGRA_GPIO_INTERRUPT_LEVEL_*) is disabled before
+	the handler runs, as the level would fire again at once: the consumer
+	calls set_interrupt() again once the level is gone or reversed. Edge
+	interrupts stay enabled.
+*/
+typedef void (*tegra_gpio_interrupt_handler)(uint32 pin, void* data);
+
+
+typedef struct tegra_gpio_interface {
+	driver_module_info info;
+
+	//! Claims \a pin for \a owner. Fails if another owner holds the pin.
+	status_t	(*acquire)(uint32 pin, const char* owner);
+
+	//! Releases \a pin, if \a owner still holds it.
+	status_t	(*release)(uint32 pin, const char* owner);
+
+	//! Makes \a pin an output that drives \a level, as an electrical level.
+	status_t	(*configure_output)(uint32 pin, bool level);
+
+	//! Makes \a pin an input.
+	status_t	(*configure_input)(uint32 pin);
+
+	/*!	Drives the output \a pin to \a level, as an electrical level.
+		Takes no lock: it may be called from an interrupt handler. */
+	status_t	(*write)(uint32 pin, bool level);
+
+	/*!	Returns the electrical level of \a pin. Takes no lock either; any
+		pin may be read, also one another consumer owns. */
+	bool		(*read)(uint32 pin);
+
+	//! Makes \a pin an input that calls \a handler when \a mode happens.
+	status_t	(*set_interrupt)(uint32 pin, uint32 mode,
+					tegra_gpio_interrupt_handler handler, void* data);
+
+	//! Disables the interrupt of \a pin and clears its pending event.
+	status_t	(*clear_interrupt)(uint32 pin);
+} tegra_gpio_interface;
+
+
+#endif	// _GPIO_TEGRA_H
