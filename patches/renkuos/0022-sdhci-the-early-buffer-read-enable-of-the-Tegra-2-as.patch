From 500bbf3e2c54c4002bccfaaac807071b4ced9875 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Fri, 20 Nov 2026 21:59:48 +0100
Subject: [PATCH 22/32] sdhci: the early buffer read enable of the Tegra 2 as a
 quirk

ea5efa2823 made the buffer read enable bit of the present state count
only once the read transfer active bit is clear, for all controllers.
Other controllers set it only for a whole block, and in multi-block SDIO
reads, where read transfer active stays set, it is the fallback for a
buffer read ready status that was acknowledged: keep that for them, and
wait for the end of the block only with the new earlyBufferReadEnable
quirk, which sdhci_fdt sets for the Tegra 2.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/busses/mmc/sdhci.cpp     | 13 +++++++------
 src/add-ons/kernel/busses/mmc/sdhci.h       |  4 ++++
 src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp |  2 ++
 3 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/src/add-ons/kernel/busses/mmc/sdhci.cpp b/src/add-ons/kernel/busses/mmc/sdhci.cpp
index c6905e0b68..4ada09c794 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci.cpp
+++ b/src/add-ons/kernel/busses/mmc/sdhci.cpp
@@ -1201,14 +1201,15 @@ SdhciBus::_TransferChunk(uint8 command, uint32 argument, uint32 blockCount,
 					status = B_IO_ERROR;
 					break;
 				}
-				// The buffer enable bit of the present state counts only
-				// once the controller stopped receiving (read transfer
-				// active, bit 9, clear): the Tegra 2 sets it while a block
-				// is still coming in, and a block read then was half old
-				// data, the rest of the block left for the next read.
+				// With earlyBufferReadEnable (Tegra 2) the buffer read
+				// enable bit counts only once the controller stopped
+				// receiving (read transfer active, bit 9, clear): it is set
+				// while a block is still coming in, and a block read then was
+				// half old data, the rest of the block left for the next read.
 				uint32 present = fRegisters->present_state.Bits();
 				bool bufferEnabled = (present & bufferEnableBit) != 0
-					&& (isWrite || (present & (1 << 9)) == 0);
+					&& (isWrite || !fQuirks.earlyBufferReadEnable
+						|| (present & (1 << 9)) == 0);
 				if ((live & readyBit) != 0 || bufferEnabled)
 					break;
 				bigtime_t now = system_time();
diff --git a/src/add-ons/kernel/busses/mmc/sdhci.h b/src/add-ons/kernel/busses/mmc/sdhci.h
index 3d23870ae9..805c77b1cb 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci.h
+++ b/src/add-ons/kernel/busses/mmc/sdhci.h
@@ -79,6 +79,10 @@ struct SdhciQuirks {
 	bool	combinedCommandWrite;
 	// there is no high speed enable bit in the host control register
 	bool	noHighSpeedBit;
+	// the buffer read enable bit of the present state is set while a block
+	// is still coming in: in PIO reads it only counts once the read transfer
+	// active bit is clear
+	bool	earlyBufferReadEnable;
 };
 
 
diff --git a/src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp b/src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp
index 767ee81f0e..abd46435ec 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp
+++ b/src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp
@@ -246,6 +246,8 @@ tegra20_init(fdt_device_module_info* module, fdt_device* dev,
 	quirks.brokenTimeoutValue = true;
 	quirks.combinedCommandWrite = true;
 	quirks.noHighSpeedBit = true;
+	// seen on the AC100 eMMC: PIO reads returned the block before
+	quirks.earlyBufferReadEnable = true;
 
 	// Card detection is done through a GPIO on Tegra, not by the controller.
 	// TODO: use the "cd-gpios" GPIO for insertion and removal instead of
