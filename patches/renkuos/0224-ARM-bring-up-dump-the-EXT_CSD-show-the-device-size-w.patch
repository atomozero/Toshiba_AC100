From 1aa1fec754c24da3d3992412021c7c4e30da20dc Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 25 Oct 2026 19:03:39 +0100
Subject: [PATCH 224/270] ARM bring-up: dump the EXT_CSD, show the device size
 when an IO fails (not for merging)

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp b/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp
index 077ba4ce89..e3c3f742c8 100644
--- a/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp
+++ b/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp
@@ -285,8 +285,10 @@ mmc_disk_execute_iorequest(void* data, IOOperation* operation)
 
 	if (error != B_OK) {
 		dprintf("AC100: mmc_disk CMD%u at %" B_PRIdOFF ", %" B_PRIuGENADDR
-			" bytes failed: %s\n", command, operation->Offset(),
-			operation->Length(), strerror(error));
+			" bytes failed: %s (device of %" B_PRIu64 " sectors)\n", command,
+			operation->Offset(), operation->Length(), strerror(error),
+			(uint64)info->geometry.cylinder_count
+				* info->geometry.sectors_per_track);
 		info->scheduler->OperationCompleted(operation, error, 0);
 		return error;
 	}
@@ -808,6 +810,16 @@ mmc_disk_get_emmc_geometry(mmc_disk_driver_info* info, mmc_disk_csd& csd,
 	status_t error = mmc_disk_read_ext_csd_checked(info, extCsd,
 		largerThan2GB);
 	if (error == B_OK) {
+		// AC100 bring-up: the whole EXT_CSD, to find where a wrong
+		// SEC_COUNT read now and then comes from
+		for (int line = 0; line < kExtCsdSize / 32; line++) {
+			char hex[32 * 3 + 1];
+			for (int i = 0; i < 32; i++) {
+				snprintf(hex + i * 3, 4, "%02x ",
+					extCsd[line * 32 + i]);
+			}
+			dprintf("AC100: EXT_CSD %3d: %s\n", line * 32, hex);
+		}
 		sectorCount = ext_csd_sector_count(extCsd);
 		TRACE("EXT_CSD: revision %u, structure %u, device type %02x, "
 			"sectors %" B_PRIu64 " (%" B_PRIu64 " MB), bus width %u, "
