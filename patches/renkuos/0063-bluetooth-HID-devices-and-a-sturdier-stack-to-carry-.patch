+/*!	Sets the controller up from a known state. A reset first: a controller
+	that was open before, under a previous server, still has its links,
+	scan mode and event mask, which nobody here knows about. Then one command
+	at a time, each sent when the previous one completed: this controller
+	loses commands sent too close to each other, or right after it was
+	opened, so a command that gets no answer is sent again.
+*/
+void
+LocalDeviceImpl::StartInit()
+{
+	fInitStep = kInitReset;
+	fInitTries = 0;
+	_SendInitStep();
+}
+
+
+void
+LocalDeviceImpl::InitTimeout(int32 step, int32 tries)
+{
+	if (step != fInitStep || tries != fInitTries)
+		return;
+
+	if (++fInitTries < kInitMaxTries) {
+		TRACE_BT("LocalDeviceImpl: %s got no answer, sending it again\n",
+			BluetoothCommandOpcode(kInitOpcodes[fInitStep]));
+	} else {
+		syslog(LOG_WARNING, "bluetooth_server: %s got no answer\n",
+			BluetoothCommandOpcode(kInitOpcodes[fInitStep]));
+		fInitStep++;
+		fInitTries = 0;
+	}
+	_SendInitStep();
+}
+
+
+void
+LocalDeviceImpl::_SendInitStep()
+{
+	// the controllers before Bluetooth 2.1 (LMP 4) have no simple pairing
+	while ((fInitStep == kInitEventMask || fInitStep == kInitSimplePairing)
+		&& fLmpVersion < 4) {
+		fInitStep++;
+	}
+	if (fInitStep < 0 || fInitStep >= kInitDone) {
+		fInitStep = -1;
+		TRACE_BT("LocalDeviceImpl: controller ready\n");
+		return;
+	}
+
+	switch (fInitStep) {
+		case kInitReset:
+		{
+			BluetoothCommand<> reset(OGF_CONTROL_BASEBAND, OCF_RESET);
+			fHCIDelegate->IssueCommand(reset.Data(), reset.Size());
+			break;
+		}
+		case kInitReadVersion:
+		{
+			BluetoothCommand<> version(OGF_INFORMATIONAL_PARAM,
+				OCF_READ_LOCAL_VERSION);
+			fHCIDelegate->IssueCommand(version.Data(), version.Size());
+			break;
+		}
+		case kInitEventMask:
+		{
+			// the default mask of the version 2.0, plus the events of the
+			// simple pairing: IO capability request and response, user
+			// confirmation, passkey request, remote OOB data, pairing
+			// complete, extended inquiry result, passkey and keypress
+			// notification, remote host features
+			BluetoothCommand<typed_command(hci_cp_set_event_mask)>
+				mask(OGF_CONTROL_BASEBAND, OCF_SET_EVENT_MASK);
+			mask->mask = B_HOST_TO_LENDIAN_INT64(0x1c7f1fffffffffffULL);
+			fHCIDelegate->IssueCommand(mask.Data(), mask.Size());
+			break;
+		}
+		case kInitSimplePairing:
+		{
+			BluetoothCommand<typed_command(hci_cp_write_simple_pairing_mode)>
+				mode(OGF_CONTROL_BASEBAND, OCF_WRITE_SIMPLE_PAIRING_MODE);
+			mode->mode = 1;
+			fHCIDelegate->IssueCommand(mode.Data(), mode.Size());
+			break;
+		}
+		case kInitScan:
+			SetConnectable(fDiscoverable);
+			break;
+		case kInitLinkPolicy:
+			AllowRoleSwitch();
+			break;
+	}
+
+	BMessage timeout(kMsgInitTimeout);
+	timeout.AddInt32("hci_id", GetID());
+	timeout.AddInt32("step", fInitStep);
+	timeout.AddInt32("tries", fInitTries);
+	BMessageRunner::StartSending(be_app_messenger, &timeout,
+		fInitStep == kInitReset ? 3000000 : 1000000, 1);
+}
+
+
+void
+LocalDeviceImpl::_InitStepDone(uint16 opcode, uint8 status,
+	const uint8* params, size_t length)
+{
+	if (fInitStep < 0 || opcode != kInitOpcodes[fInitStep])
+		return;
+
+	if (fInitStep == kInitReadVersion && status == BT_OK
+		&& length >= sizeof(struct hci_rp_read_loc_version)) {
+		fLmpVersion = ((const struct hci_rp_read_loc_version*)params)
+			->lmp_version;
+	}
+
+	// a step that failed was reported: the next ones are still worth it
+	fInitStep++;
+	fInitTries = 0;
+	_SendInitStep();
+}
