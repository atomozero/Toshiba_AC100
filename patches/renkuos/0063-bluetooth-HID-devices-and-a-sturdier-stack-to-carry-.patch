+	text[0] = '\0';
+	for (size_t i = 0; i < length; i++)
+		snprintf(text + 3 * i, 4, " %02x", data[i]);
+
+	dprintf("l2cap: %s code %#x ident %u size %" B_PRIu32 ":%s\n", direction,
+		code, ident, buffer->size - (uint32)offset, text);
+}
