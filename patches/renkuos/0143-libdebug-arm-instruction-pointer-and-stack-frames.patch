From 073ab698c8278854d666cdd29499148b87e3f7fa Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 19 Oct 2026 22:07:31 +0200
Subject: [PATCH 143/270] libdebug/arm: instruction pointer and stack frames

The stack is scanned for return addresses (words in executable areas just
behind a BL or BLX), since ARM code is usually built without frame pointers.
debug_server can print stack traces of crashed teams again.
---
 .../debug/arch/arm/arch_debug_support.cpp     | 126 +++++++++++++++++-
 1 file changed, 123 insertions(+), 3 deletions(-)

diff --git a/src/kits/debug/arch/arm/arch_debug_support.cpp b/src/kits/debug/arch/arm/arch_debug_support.cpp
index ee287bb6e4..5706d0483e 100644
--- a/src/kits/debug/arch/arm/arch_debug_support.cpp
+++ b/src/kits/debug/arch/arm/arch_debug_support.cpp
@@ -1,5 +1,5 @@
 /*
- * Copyright 2012, Haiku, Inc.
+ * Copyright 2012-2026, Haiku, Inc.
  * Distributed under the terms of the MIT License.
  *
  * Authors:
@@ -11,11 +11,100 @@
 
 #include "arch_debug_support.h"
 
+
+/*!	Code built without frame pointers leaves no chain of frames to follow, so
+	the stack is scanned instead: a frame is reported for every word on it
+	that points just behind a call instruction (BL or BLX). That may also
+	report stale return addresses, but it does not depend on how the code
+	was compiled.
+*/
+
+
+static const int32 kMaxScanWords = 2048;
+static const int32 kChunkWords = 64;
+static const int32 kMaxCodeAreas = 128;
+
+
+struct code_areas {
+	int32	count;
+	addr_t	start[kMaxCodeAreas];
+	addr_t	end[kMaxCodeAreas];
+
+	void Init(team_id team)
+	{
+		count = 0;
+		area_info info;
+		ssize_t cookie = 0;
+		while (count < kMaxCodeAreas
+			&& get_next_area_info(team, &cookie, &info) == B_OK) {
+			if ((info.protection & B_EXECUTE_AREA) == 0)
+				continue;
+			start[count] = (addr_t)info.address;
+			end[count] = (addr_t)info.address + info.size;
+			count++;
+		}
+	}
+
+	bool Contains(addr_t address) const
+	{
+		for (int32 i = 0; i < count; i++) {
+			if (address >= start[i] && address < end[i])
+				return true;
+		}
+		return false;
+	}
+};
+
+
+static bool
+is_call_instruction(uint32 instruction)
+{
+	// BL <label> (any condition but "never")
+	if ((instruction & 0x0f000000) == 0x0b000000
+		&& (instruction & 0xf0000000) != 0xf0000000) {
+		return true;
+	}
+	// BLX <label>
+	if ((instruction & 0xfe000000) == 0xfa000000)
+		return true;
+	// BLX <register>
+	if ((instruction & 0x0ffffff0) == 0x012fff30)
+		return true;
+
+	return false;
+}
+
+
+static bool
+is_return_address(debug_context *context, const code_areas& areas,
+	uint32 address)
+{
+	if ((address & 3) != 0 || !areas.Contains(address - 4))
+		return false;
+
+	uint32 instruction;
+	if (debug_read_memory(context, (const void*)(address - 4), &instruction,
+			sizeof(instruction)) != sizeof(instruction)) {
+		return false;
+	}
+
+	return is_call_instruction(instruction);
+}
+
+
 status_t
 arch_debug_get_instruction_pointer(debug_context *context, thread_id thread,
 	void **ip, void **stackFrameAddress)
 {
-	return B_ERROR;
+	debug_cpu_state cpuState;
+	status_t error = debug_get_cpu_state(context, thread, NULL, &cpuState);
+	if (error != B_OK)
+		return error;
+
+	*ip = (void*)cpuState.r15;
+	*stackFrameAddress = (void*)cpuState.r13;
+
+	return B_OK;
 }
 
 
@@ -23,5 +112,36 @@ status_t
 arch_debug_get_stack_frame(debug_context *context, void *stackFrameAddress,
 	debug_stack_frame_info *stackFrameInfo)
 {
-	return B_ERROR;
+	uint32* address = (uint32*)stackFrameAddress;
+	if (address == NULL || ((addr_t)address & 3) != 0)
+		return B_BAD_VALUE;
+
+	// only look at what could point into code
+	code_areas areas;
+	areas.Init(context->team);
+
+	for (int32 scanned = 0; scanned < kMaxScanWords;
+			scanned += kChunkWords) {
+		uint32 words[kChunkWords];
+		ssize_t bytesRead = debug_read_memory(context, address + scanned,
+			words, sizeof(words));
+		if (bytesRead < (ssize_t)sizeof(uint32))
+			return bytesRead < 0 ? bytesRead : B_ERROR;
+
+		int32 count = bytesRead / sizeof(uint32);
+		for (int32 i = 0; i < count; i++) {
+			if (!is_return_address(context, areas, words[i]))
+				continue;
+
+			stackFrameInfo->frame = address + scanned + i;
+			stackFrameInfo->parent_frame = address + scanned + i + 1;
+			stackFrameInfo->return_address = (void*)words[i];
+			return B_OK;
+		}
+
+		if (count < kChunkWords)
+			break;
+	}
+
+	return B_ENTRY_NOT_FOUND;
 }
