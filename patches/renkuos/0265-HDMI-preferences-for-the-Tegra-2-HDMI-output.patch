index 0000000000..4b9f80b8fb
--- /dev/null
+++ b/src/preferences/hdmi/HDMI.cpp
@@ -0,0 +1,344 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+/*!	HDMI preferences of the NVIDIA Tegra 2 display driver (tegra_dc): shows
+	the screen plugged into the HDMI port and the mode it gets, and sets how
+	the driver chooses it. The choices go into the driver settings file,
+	which the driver reads again when told to restart the output.
+*/
+
+
+#include <Alert.h>
+#include <Application.h>
+#include <Box.h>
+#include <Catalog.h>
+#include <CheckBox.h>
+#include <Directory.h>
+#include <File.h>
+#include <FindDirectory.h>
+#include <LayoutBuilder.h>
+#include <MenuField.h>
+#include <MenuItem.h>
+#include <MessageRunner.h>
+#include <Path.h>
+#include <PopUpMenu.h>
+#include <SeparatorView.h>
+#include <String.h>
+#include <StringList.h>
+#include <StringView.h>
+#include <Window.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "tegra_dc_info.h"
+
+
+#undef B_TRANSLATION_CONTEXT
+#define B_TRANSLATION_CONTEXT "HDMI"
+
+
+static const char* kDevice = "/dev/" TEGRA_DC_DEVICE_NAME;
+
+enum {
+	kMsgModeChanged = 'mode',
+	kMsgDviChanged = 'dvi ',
+	kMsgSignalChanged = 'sgnl',
+	kMsgUpdateStatus = 'stat'
+};
+
+// what the driver settings say, as the popup menu has it
+enum mode_choice {
+	MODE_AUTOMATIC = 0,	// smallest mode that holds the panel's picture
+	MODE_PREFERRED,		// the screen's preferred mode, or the largest
+	MODE_720P
+};
+
+static const char* kModeValues[] = { NULL, "preferred", "720p" };
+
+
+/*!	The tegra_dc driver settings file: lines of "key value", kept as they
+	are except for the keys this panel owns.
+*/
+class DriverSettings {
+public:
+	DriverSettings()
+	{
+		find_directory(B_USER_SETTINGS_DIRECTORY, &fPath);
+		fPath.Append("kernel/drivers/tegra_dc");
+
+		BFile file(fPath.Path(), B_READ_ONLY);
+		off_t size;
+		if (file.InitCheck() != B_OK || file.GetSize(&size) != B_OK
+			|| size > 65536) {
+			return;
+		}
+		BString text;
+		char* buffer = text.LockBuffer(size + 1);
+		ssize_t bytes = file.Read(buffer, size);
+		text.UnlockBuffer(bytes >= 0 ? bytes : 0);
+		text.Split("\n", true, fLines);
+	}
+
+	const char* Get(const char* key) const
+	{
+		for (int32 i = 0; i < fLines.CountStrings(); i++) {
+			BString line = fLines.StringAt(i);
+			line.Trim();
+			int32 space = line.FindFirst(' ');
+			if (space < 0)
+				space = line.FindFirst('\t');
+			BString name;
+			line.CopyInto(name, 0, space >= 0 ? space : line.Length());
+			if (name == key) {
+				fValue = space >= 0 ? line.String() + space + 1 : "";
+				fValue.Trim();
+				return fValue.String();
+			}
+		}
+		return NULL;
+	}
+
+	void Set(const char* key, const char* value)
+	{
+		for (int32 i = fLines.CountStrings() - 1; i >= 0; i--) {
+			BString line = fLines.StringAt(i);
+			line.Trim();
+			if (line == key || line.StartsWith(BString(key) << " ")
+				|| line.StartsWith(BString(key) << "\t")) {
+				fLines.Remove(i);
+			}
+		}
+		if (value != NULL)
+			fLines.Add(BString(key) << " " << value);
+	}
+
+	status_t Save() const
+	{
+		BPath directory;
+		fPath.GetParent(&directory);
+		create_directory(directory.Path(), 0755);
+
+		BFile file(fPath.Path(), B_WRITE_ONLY | B_CREATE_FILE | B_ERASE_FILE);
+		if (file.InitCheck() != B_OK)
+			return file.InitCheck();
+		BString text = fLines.Join("\n");
+		text << "\n";
+		ssize_t written = file.Write(text.String(), text.Length());
+		return written == text.Length() ? B_OK : B_IO_ERROR;
+	}
+
+private:
+	BPath				fPath;
+	BStringList			fLines;
+	mutable BString		fValue;
+};
+
+
+class HDMIWindow : public BWindow {
+public:
+								HDMIWindow();
+
+	virtual	void				MessageReceived(BMessage* message);
+
+private:
+			void				_UpdateStatus();
+			void				_Apply();
+
+			BStringView*		fScreenView;
+			BStringView*		fModeView;
+			BPopUpMenu*			fModeMenu;
+			BCheckBox*			fDviCheckBox;
+			BCheckBox*			fSignalCheckBox;
+			BMessageRunner*		fStatusRunner;
+};
+
+
+HDMIWindow::HDMIWindow()
+	:
+	BWindow(BRect(100, 100, 500, 300), B_TRANSLATE_SYSTEM_NAME("HDMI"),
+		B_TITLED_WINDOW, B_NOT_RESIZABLE | B_NOT_ZOOMABLE
+			| B_AUTO_UPDATE_SIZE_LIMITS | B_QUIT_ON_WINDOW_CLOSE)
+{
+	fScreenView = new BStringView("screen", "");
+	fModeView = new BStringView("mode", "");
+
+	fModeMenu = new BPopUpMenu("mode");
+	fModeMenu->AddItem(new BMenuItem(
+		B_TRANSLATE("Automatic (sharpest for this display)"),
+		new BMessage(kMsgModeChanged)));
+	fModeMenu->AddItem(new BMenuItem(B_TRANSLATE("Screen's preferred mode"),
+		new BMessage(kMsgModeChanged)));
+	fModeMenu->AddItem(new BMenuItem(B_TRANSLATE("1280×720"),
+		new BMessage(kMsgModeChanged)));
+	BMenuField* modeField = new BMenuField("mode field",
+		B_TRANSLATE("Resolution:"), fModeMenu);
+
+	fDviCheckBox = new BCheckBox("dvi",
+		B_TRANSLATE("Plain DVI signal (no sound)"),
+		new BMessage(kMsgDviChanged));
+	fSignalCheckBox = new BCheckBox("signal",
+		B_TRANSLATE("Stronger signal (long cables)"),
+		new BMessage(kMsgSignalChanged));
+
+	BBox* statusBox = new BBox("status");
+	statusBox->SetLabel(B_TRANSLATE("Connected screen"));
+	BLayoutBuilder::Group<>(statusBox, B_VERTICAL, B_USE_SMALL_SPACING)
+		.SetInsets(B_USE_DEFAULT_SPACING, B_USE_BIG_SPACING,
+			B_USE_DEFAULT_SPACING, B_USE_DEFAULT_SPACING)
+		.Add(fScreenView)
+		.Add(fModeView);
+
+	BLayoutBuilder::Group<>(this, B_VERTICAL)
+		.SetInsets(B_USE_WINDOW_SPACING)
+		.Add(statusBox)
+		.Add(modeField)
+		.Add(fDviCheckBox)
+		.Add(fSignalCheckBox);
+
+	// the current settings
+	DriverSettings settings;
+	const char* mode = settings.Get("hdmi_mode");
+	int32 choice = MODE_AUTOMATIC;
+	for (int32 i = 1; i < (int32)B_COUNT_OF(kModeValues); i++) {
+		if (mode != NULL && strcmp(mode, kModeValues[i]) == 0)
+			choice = i;
+	}
+	fModeMenu->ItemAt(choice)->SetMarked(true);
+	const char* dvi = settings.Get("hdmi_dvi");
+	fDviCheckBox->SetValue(dvi != NULL && (strcmp(dvi, "true") == 0
+		|| strcmp(dvi, "on") == 0 || strcmp(dvi, "1") == 0));
+	const char* drive = settings.Get("hdmi_drive_current");
+	fSignalCheckBox->SetValue(drive != NULL && atoi(drive) > 15);
+
+	_UpdateStatus();
+	BMessage update(kMsgUpdateStatus);
+	fStatusRunner = new BMessageRunner(this, &update, 1000000);
+
+	CenterOnScreen();
+}
+
+
+void
+HDMIWindow::MessageReceived(BMessage* message)
+{
+	switch (message->what) {
+		case kMsgModeChanged:
+		case kMsgDviChanged:
+		case kMsgSignalChanged:
+			_Apply();
+			break;
+
+		case kMsgUpdateStatus:
+			_UpdateStatus();
+			break;
+
+		default:
+			BWindow::MessageReceived(message);
+	}
+}
+
+
+void
+HDMIWindow::_UpdateStatus()
+{
+	tegra_dc_hdmi_status status;
+	int device = open(kDevice, O_RDONLY);
+	bool known = device >= 0 && ioctl(device, TEGRA_DC_GET_HDMI_STATUS,
+		&status, sizeof(status)) == 0;
+	if (device >= 0)
+		close(device);
+
+	BString screen;
+	BString mode;
+	if (!known) {
+		screen = B_TRANSLATE("The display driver has no HDMI output.");
+	} else if (!status.plugged) {
+		screen = B_TRANSLATE("No screen is plugged in.");
+	} else {
+		if (status.screen_name[0] != '\0')
+			screen = status.screen_name;
+		else if (!status.has_edid)
+			screen = B_TRANSLATE("Unknown screen (no EDID)");
+		else
+			screen = B_TRANSLATE("Unnamed screen");
+		screen << " (" << (status.hdmi_sink ? "HDMI" : "DVI") << ")";
+
+		if (status.active) {
+			float refresh = status.pixel_clock * 1000.0f
+				/ ((float)status.h_total * status.v_total);
+			mode.SetToFormat(B_TRANSLATE("%u×%u, %.0f Hz, %s"),
+				status.width, status.height, refresh,
+				status.dvi ? B_TRANSLATE("DVI, no sound")
+					: B_TRANSLATE("HDMI with sound"));
+		} else
+			mode = B_TRANSLATE("The output is off.");
+	}
+
+	if (screen != fScreenView->Text())
+		fScreenView->SetText(screen);
+	if (mode != fModeView->Text())
+		fModeView->SetText(mode);
+}
+
+
+void
+HDMIWindow::_Apply()
+{
+	DriverSettings settings;
+	int32 choice = fModeMenu->IndexOf(fModeMenu->FindMarked());
+	settings.Set("hdmi_mode", choice > 0 && choice < (int32)B_COUNT_OF(kModeValues)
+		? kModeValues[choice] : NULL);
+	settings.Set("hdmi_dvi",
+		fDviCheckBox->Value() == B_CONTROL_ON ? "true" : NULL);
+	settings.Set("hdmi_drive_current",
+		fSignalCheckBox->Value() == B_CONTROL_ON ? "31" : NULL);
+
+	status_t status = settings.Save();
+	if (status == B_OK) {
+		int device = open(kDevice, O_RDONLY);
+		if (device < 0 || ioctl(device, TEGRA_DC_RECONNECT_HDMI, NULL, 0) != 0)
+			status = errno;
+		if (device >= 0)
+			close(device);
+	}
+	if (status != B_OK) {
+		BString text(B_TRANSLATE("Could not apply the HDMI settings: %error%"));
+		text.ReplaceFirst("%error%", strerror(status));
+		BAlert* alert = new BAlert(B_TRANSLATE("HDMI"), text,
+			B_TRANSLATE("OK"), NULL, NULL, B_WIDTH_AS_USUAL, B_STOP_ALERT);
+		alert->Go(NULL);
+	}
+	_UpdateStatus();
+}
+
+
+class HDMIApplication : public BApplication {
+public:
+	HDMIApplication()
+		:
+		BApplication("application/x-vnd.Haiku-HDMI")
+	{
+	}
+
+	virtual void ReadyToRun()
+	{
+		(new HDMIWindow())->Show();
+	}
+};
+
+
+int
+main()
+{
+	HDMIApplication application;
+	application.Run();
+	return 0;
+}
