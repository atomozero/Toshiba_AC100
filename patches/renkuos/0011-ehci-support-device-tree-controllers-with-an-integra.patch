+/*!	Constructor for controllers that are not on a PCI bus, e.g. described by a
+	device tree. \a capabilityOffset is the offset of the capability registers
+	from \a registers.
+*/
+EHCI::EHCI(phys_addr_t registers, size_t registersSize, size_t capabilityOffset,
+	uint32 irq, uint32 flags, Stack *stack, device_node* node)
+	:
+	EHCI(stack, node)
+{
+	fFlags = flags;
+
+	if (BusManager::InitCheck() != B_OK) {
+		TRACE_ERROR("bus manager failed to init\n");
+		return;
+	}
+
+	TRACE("constructing new EHCI host controller driver\n");
+	fInitOK = false;
+
+	size_t offset = registers % B_PAGE_SIZE;
+	if (_MapRegisters(registers - offset,
+			ROUNDUP(registersSize + offset, B_PAGE_SIZE),
+			offset + capabilityOffset) != B_OK) {
+		return;
+	}
+
+	_ReadCapabilities();
+
+	if (_PrepareController() != B_OK)
+		return;
+
+	if (_UsePolling()) {
+		TRACE_ALWAYS("enabling ehci polling\n");
+		fInterruptPollThread = spawn_kernel_thread(InterruptPollThread,
+			"ehci interrupt poll thread", B_NORMAL_PRIORITY, (void *)this);
+		resume_thread(fInterruptPollThread);
+	} else {
+		fIRQ = irq;
+		install_io_interrupt_handler(fIRQ, InterruptHandler, (void *)this, 0);
+	}
+
+	_FinishInit();
+}
+
+
+status_t
+EHCI::_MapRegisters(phys_addr_t physicalAddress, size_t mapSize,
+	size_t offset)
+{
+	fRegisterArea = map_physical_memory("EHCI memory mapped registers",
+		physicalAddress, mapSize, B_ANY_KERNEL_BLOCK_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+		(void **)&fCapabilityRegisters);
+	if (fRegisterArea < 0) {
+		TRACE_ERROR("failed to map register memory\n");
+		return fRegisterArea;
+	}
+
+	fCapabilityRegisters += offset;
+	fOperationalRegisters = fCapabilityRegisters + ReadCapReg8(EHCI_CAPLENGTH);
+	TRACE("mapped capability registers: 0x%p\n", fCapabilityRegisters);
+	TRACE("mapped operational registers: 0x%p\n", fOperationalRegisters);
+	return B_OK;
+}
+
