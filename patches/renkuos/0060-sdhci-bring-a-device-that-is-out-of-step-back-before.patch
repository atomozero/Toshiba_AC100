From 86d2ca4f64058f28684386da4d8844c211b66eba Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Thu, 29 Oct 2026 23:41:19 +0100
Subject: [PATCH 60/63] sdhci: bring a device that is out of step back before
 using it

Before the transfer self-test, and whenever two reads of the reference
blocks disagree, ask the device for its state and stop it if it is
still sending data, drain the controller's buffer and reset the data
line. The eMMC of a Toshiba AC100 returned the data of the previous
read for every read, with any transfer method, after its battery ran
out while the system wrote; U-Boot read it correctly.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/busses/mmc/sdhci.cpp | 74 +++++++++++++++++++++++--
 src/add-ons/kernel/busses/mmc/sdhci.h   |  1 +
 2 files changed, 70 insertions(+), 5 deletions(-)

diff --git a/src/add-ons/kernel/busses/mmc/sdhci.cpp b/src/add-ons/kernel/busses/mmc/sdhci.cpp
index b13d1d3b88..8c1059b82c 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci.cpp
+++ b/src/add-ons/kernel/busses/mmc/sdhci.cpp
@@ -1273,6 +1273,48 @@ SdhciBus::_TransferBlocks(bool isWrite, uint32 argument, uint32 argumentStep,
 }
 
 
+/*!	Brings the device and the controller back to step, when the data read
+	may be that of an earlier command: a device stuck sending data (in the
+	data state, as after a read whose end it did not get) is stopped, and
+	data left in the controller's buffer is thrown away.
+	Seen on the Toshiba AC100 eMMC, after a battery that ran out while the
+	system wrote: every read returned the data of the previous one, with
+	any transfer method, while U-Boot read the device correctly.
+*/
+void
+SdhciBus::_ResyncDevice(const char* when)
+{
+	uint32 present = fRegisters->present_state.Bits();
+	uint32 cardStatus = 0;
+	status_t status = ExecuteCommand(SEND_STATUS, fSelectedRca << 16,
+		&cardStatus);
+	uint32 state = (cardStatus >> 9) & 0xf;
+	TRACE_ALWAYS("%s: present state %08" B_PRIx32 ", card status %08" B_PRIx32
+		" (state %" B_PRIu32 ")%s\n", when, present, cardStatus, state,
+		status != B_OK ? ", CMD13 failed" : "");
+
+	// 5: data, 6: receive data. CMD12 is harmless in the transfer state.
+	if (status != B_OK || state == 5 || state == 6) {
+		uint32 response;
+		ExecuteCommand(SD_STOP_TRANSMISSION, 0, &response);
+		TRACE_ALWAYS("%s: stop transmission sent\n", when);
+	}
+
+	// data the controller still holds for the driver to read
+	uint32 drained = 0;
+	while ((fRegisters->present_state.Bits() & (1 << 11)) != 0
+		&& drained < 64 * 1024) {
+		(void)fRegisters->buffer_data_port;
+		drained += 4;
+	}
+	if (drained > 0)
+		TRACE_ALWAYS("%s: %" B_PRIu32 " stale bytes drained\n", when, drained);
+
+	fRegisters->software_reset.ResetDataLine();
+	fRegisters->interrupt_status = fRegisters->interrupt_status;
+}
+
+
 /*!	Decides how data is moved, the first time data is accessed.
 	The first two blocks of the device are read in the simplest possible way
 	(PIO, one block at a time) as a reference. Then the transfer methods are
@@ -1338,13 +1380,35 @@ SdhciBus::_SelectTransferMode()
 	uint8* reference = (uint8*)malloc(testLength);
 	bool haveReference = false;
 
+	_ResyncDevice("before the transfer self-test");
+
 	if (reference != NULL) {
-		status_t status = B_OK;
-		for (uint32 i = 0; i < 2 && status == B_OK; i++) {
-			status = _TransferChunk(SD_READ_SINGLE_BLOCK, i * step, 1,
-				kBlockSize, false, kDataModePio, kStopModeSingle, 0,
-				reference + i * kBlockSize, kSelfTestTimeout);
+		// A device out of step returns the data of the previous read: read
+		// the reference twice, and resync until both reads agree
+		uint8* again = (uint8*)malloc(testLength);
+		status_t status = B_ERROR;
+		for (int attempt = 0; attempt < 4; attempt++) {
+			status = B_OK;
+			for (uint32 i = 0; i < 2 && status == B_OK; i++) {
+				status = _TransferChunk(SD_READ_SINGLE_BLOCK, i * step, 1,
+					kBlockSize, false, kDataModePio, kStopModeSingle, 0,
+					reference + i * kBlockSize, kSelfTestTimeout);
+			}
+			for (uint32 i = 0; i < 2 && status == B_OK && again != NULL;
+					i++) {
+				status = _TransferChunk(SD_READ_SINGLE_BLOCK, i * step, 1,
+					kBlockSize, false, kDataModePio, kStopModeSingle, 0,
+					again + i * kBlockSize, kSelfTestTimeout);
+			}
+			if (status == B_OK && (again == NULL
+					|| memcmp(again, reference, testLength) == 0))
+				break;
+			ERROR("reference reads disagree (attempt %d): %s\n", attempt + 1,
+				status == B_OK ? "data out of step" : strerror(status));
+			_ResyncDevice("reference reads disagree");
+			status = B_ERROR;
 		}
+		free(again);
 		haveReference = status == B_OK;
 		if (haveReference) {
 			TRACE("reference read OK:%s%s\n",
diff --git a/src/add-ons/kernel/busses/mmc/sdhci.h b/src/add-ons/kernel/busses/mmc/sdhci.h
index 735866590a..2e312e9d58 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci.h
+++ b/src/add-ons/kernel/busses/mmc/sdhci.h
@@ -147,6 +147,7 @@ class SdhciBus {
 			void				_LogCardStatus(const char* when,
 									uint32 status);
 			status_t			_SelectTransferMode();
+			void				_ResyncDevice(const char* when);
 			status_t			_VerifyTransfers(const char* what);
 			status_t			_ExecuteTuning();
 
