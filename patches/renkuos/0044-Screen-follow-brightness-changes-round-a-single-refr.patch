From 1e8a7dc34b3145ab3144bd43adc4fcfb424d1838 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 27 Oct 2026 07:20:29 +0100
Subject: [PATCH 44/63] Screen: follow brightness changes, round a single
 refresh rate

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/preferences/screen/Constants.h      |  1 +
 src/preferences/screen/ScreenWindow.cpp | 25 ++++++++++++++++++++++++-
 src/preferences/screen/ScreenWindow.h   |  3 +++
 3 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/src/preferences/screen/Constants.h b/src/preferences/screen/Constants.h
index ae75798bd6..549c67cc04 100644
--- a/src/preferences/screen/Constants.h
+++ b/src/preferences/screen/Constants.h
@@ -37,6 +37,7 @@ static const uint32 UPDATE_DESKTOP_MSG = 'udsk';
 static const uint32 SLIDER_MODIFICATION_MSG = 'sldm';
 static const uint32 SLIDER_INVOKE_MSG = 'sldi';
 static const uint32 SLIDER_BRIGHTNESS_MSG = 'brig';
+static const uint32 UPDATE_BRIGHTNESS_MSG = 'ubrg';
 static const uint32 SET_CUSTOM_REFRESH_MSG = 'scrf';
 static const uint32 DIM_COUNT_MSG = 'scrf';
 static const uint32 MAKE_INITIAL_MSG = 'mkin';
diff --git a/src/preferences/screen/ScreenWindow.cpp b/src/preferences/screen/ScreenWindow.cpp
index ee8f1346e3..0bf9c4aaaa 100644
--- a/src/preferences/screen/ScreenWindow.cpp
+++ b/src/preferences/screen/ScreenWindow.cpp
@@ -35,6 +35,7 @@
 #include <MenuBar.h>
 #include <MenuField.h>
 #include <MenuItem.h>
+#include <MessageRunner.h>
 #include <Messenger.h>
 #include <Path.h>
 #include <PopUpMenu.h>
@@ -236,10 +237,17 @@ ScreenWindow::ScreenWindow(ScreenSettings* settings)
 		NULL, 0, 255, B_HORIZONTAL);
 	groupView->AddChild(fBrightnessSlider);
 
+	fBrightnessRunner = NULL;
 	if (screen.GetBrightness(&fOriginalBrightness) == B_OK) {
 		fBrightnessSlider->SetModificationMessage(
 			new BMessage(SLIDER_BRIGHTNESS_MSG));
 		fBrightnessSlider->SetValue(fOriginalBrightness * 255);
+
+		// The brightness may change elsewhere, as with the brightness keys
+		// of a laptop: keep the slider in sync
+		BMessage update(UPDATE_BRIGHTNESS_MSG);
+		fBrightnessRunner = new BMessageRunner(BMessenger(this), &update,
+			500000);
 	} else {
 		// The driver does not support changing the brightness,
 		// so hide the slider
@@ -422,7 +430,9 @@ ScreenWindow::ScreenWindow(ScreenSettings* settings)
 
 	if (min == max) {
 		// This is a special case for drivers that only support a single
-		// frequency, like the VESA driver
+		// frequency, like the VESA driver. Round it as the refresh rate of
+		// the selected mode is, or that one would not be found in the menu.
+		min = rint(10 * min) / 10;
 		BString name;
 		refresh_rate_to_string(min, name);
 		BMessage *message = new BMessage(POP_REFRESH_MSG);
@@ -622,6 +632,7 @@ ScreenWindow::ScreenWindow(ScreenSettings* settings)
 
 ScreenWindow::~ScreenWindow()
 {
+	delete fBrightnessRunner;
 	delete fSettings;
 }
 
@@ -1228,6 +1239,18 @@ ScreenWindow::MessageReceived(BMessage* message)
 			PostMessage(message, fMonitorView);
 			break;
 
+		case UPDATE_BRIGHTNESS_MSG:
+		{
+			BScreen screen(this);
+			float brightness;
+			if (screen.GetBrightness(&brightness) == B_OK) {
+				int32 value = (int32)(brightness * 255 + 0.5f);
+				if (value != fBrightnessSlider->Value())
+					fBrightnessSlider->SetValue(value);
+			}
+			break;
+		}
+
 		case SLIDER_BRIGHTNESS_MSG:
 		{
 			BScreen screen(this);
diff --git a/src/preferences/screen/ScreenWindow.h b/src/preferences/screen/ScreenWindow.h
index fa465bf52b..b6283c9165 100644
--- a/src/preferences/screen/ScreenWindow.h
+++ b/src/preferences/screen/ScreenWindow.h
@@ -18,6 +18,7 @@
 #include "ScreenMode.h"
 
 
+class BMessageRunner;
 class BBox;
 class BPopUpMenu;
 class BMenuField;
@@ -97,6 +98,8 @@ private:
 			BMenuField*		fTVStandardField;
 
 			BSlider*		fBrightnessSlider;
+			BMessageRunner*	fBrightnessRunner;
+				// follows brightness changes made elsewhere
 
 			BButton*		fDefaultsButton;
 			BButton*		fApplyButton;
-- 
2.39.5

