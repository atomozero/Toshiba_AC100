-/*!	The tegra_dc driver settings file: lines of "key value", kept as they
-	are except for the keys this panel owns.
-*/
-class DriverSettings {
-public:
-	DriverSettings()
-	{
-		find_directory(B_USER_SETTINGS_DIRECTORY, &fPath);
-		fPath.Append("kernel/drivers/tegra_dc");
-
-		BFile file(fPath.Path(), B_READ_ONLY);
-		off_t size;
-		if (file.InitCheck() != B_OK || file.GetSize(&size) != B_OK
-			|| size > 65536) {
-			return;
-		}
-		BString text;
-		char* buffer = text.LockBuffer(size + 1);
-		ssize_t bytes = file.Read(buffer, size);
-		text.UnlockBuffer(bytes >= 0 ? bytes : 0);
-		text.Split("\n", true, fLines);
-	}
-
-	const char* Get(const char* key) const
-	{
-		for (int32 i = 0; i < fLines.CountStrings(); i++) {
-			BString line = fLines.StringAt(i);
-			line.Trim();
-			int32 space = line.FindFirst(' ');
-			if (space < 0)
-				space = line.FindFirst('\t');
-			BString name;
-			line.CopyInto(name, 0, space >= 0 ? space : line.Length());
-			if (name == key) {
-				fValue = space >= 0 ? line.String() + space + 1 : "";
-				fValue.Trim();
-				return fValue.String();
-			}
-		}
-		return NULL;
-	}
-
-	void Set(const char* key, const char* value)
-	{
-		for (int32 i = fLines.CountStrings() - 1; i >= 0; i--) {
-			BString line = fLines.StringAt(i);
-			line.Trim();
-			if (line == key || line.StartsWith(BString(key) << " ")
-				|| line.StartsWith(BString(key) << "\t")) {
-				fLines.Remove(i);
-			}
-		}
-		if (value != NULL)
-			fLines.Add(BString(key) << " " << value);
-	}
-
-	status_t Save() const
-	{
-		BPath directory;
-		fPath.GetParent(&directory);
-		create_directory(directory.Path(), 0755);
-
-		BFile file(fPath.Path(), B_WRITE_ONLY | B_CREATE_FILE | B_ERASE_FILE);
-		if (file.InitCheck() != B_OK)
-			return file.InitCheck();
-		BString text = fLines.Join("\n");
-		text << "\n";
-		ssize_t written = file.Write(text.String(), text.Length());
-		return written == text.Length() ? B_OK : B_IO_ERROR;
-	}
-
-private:
-	BPath				fPath;
-	BStringList			fLines;
-	mutable BString		fValue;
-};
