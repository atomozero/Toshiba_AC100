 /*!	The video at the same place of the mirrored picture as on the panel. */
 static void
 program_overlay_window()
 {
+	if (sHdmi.video.enabled) {
+		program_video_window();
+		return;
+	}
+
 	const hdmi_overlay& overlay = sHdmi.overlay;
 	uint32 x = sHdmi.window_x + overlay.x * sHdmi.window_width / sHdmi.width;
 	uint32 y = sHdmi.window_y
@@ -1390,14 +1442,16 @@ disconnect()
 static void
 connect()
 {
-	status_t status = set_hdmi_power(true);
-	if (status != B_OK) {
-		ERROR("cannot power the HDMI block: %s\n", strerror(status));
-		return;
-	}
-
 	void* settings = load_driver_settings("tegra_dc");
 	tmds_settings& tmds = sHdmi.tmds;
+	// "hdmi_output false" leaves the HDMI block off with a screen plugged in
+	sHdmi.output_enabled = get_driver_boolean_parameter(settings,
+		"hdmi_output", true, true);
+	if (!sHdmi.output_enabled) {
+		unload_driver_settings(settings);
+		dprintf("tegra_dc: hdmi: output turned off in the settings\n");
+		return;
+	}
 	// "hdmi_dvi true" sends plain DVI even to HDMI sinks
 	tmds.force_dvi = get_driver_boolean_parameter(settings, "hdmi_dvi", false,
 		true);
@@ -1419,6 +1473,12 @@ connect()
 		"hdmi_vco_cap", "1", "1"), NULL, 0), 0xfu);
 	unload_driver_settings(settings);
 
+	status_t status = set_hdmi_power(true);
+	if (status != B_OK) {
+		ERROR("cannot power the HDMI block: %s\n", strerror(status));
+		return;
+	}
+
 	// The screen may need a while after the hot plug line rises before it
 	// answers on the DDC bus (a television took more than a second)
 	uint8 edid[EDID_SIZE];
@@ -1540,6 +1600,7 @@ hdmi_start(uint32 physical, uint16 width, uint16 height, uint32 colorDepth,
 {
 	memset(&sHdmi, 0, sizeof(sHdmi));
 	sHdmi.thread = -1;
+	sHdmi.output_enabled = true;
 
 	// "hdmi false" in the driver settings leaves the HDMI block off
 	void* settings = load_driver_settings("tegra_dc");
@@ -1649,6 +1710,8 @@ hdmi_get_status(tegra_dc_hdmi_status& status)
 	MutexLocker locker(sHdmi.lock);
 	status.plugged = sHdmi.plugged;
 	status.active = sHdmi.active;
+	status.enabled = sHdmi.output_enabled;
+	status.video = sHdmi.video.enabled;
 	status.has_edid = sHdmi.has_edid;
 	status.hdmi_sink = sHdmi.hdmi_sink;
 	status.dvi = sHdmi.sending_dvi;
@@ -1677,6 +1740,26 @@ hdmi_reconnect()
 }
 
 
+void
+hdmi_set_video(const hdmi_video& video)
+{
+	// thread ids are positive; before hdmi_start() it is 0
+	if (sHdmi.thread <= 0)
+		return;
+
+	MutexLocker locker(sHdmi.lock);
+	bool changed = video.enabled != sHdmi.video.enabled;
+	sHdmi.video = video;
+	if (!sHdmi.active)
+		return;
+	if (changed) {
+		program_mirror_window();
+		program_cursor_window();
+	}
+	program_overlay_window();
+}
