-		screen = B_TRANSLATE("No screen is plugged in.");
-	} else {
-		if (status.screen_name[0] != '\0')
-			screen = status.screen_name;
-		else if (!status.has_edid)
-			screen = B_TRANSLATE("Unknown screen (no EDID)");
-		else
-			screen = B_TRANSLATE("Unnamed screen");
-		screen << " (" << (status.hdmi_sink ? "HDMI" : "DVI") << ")";
-
-		if (status.active) {
-			float refresh = status.pixel_clock * 1000.0f
-				/ ((float)status.h_total * status.v_total);
-			mode.SetToFormat(B_TRANSLATE("%u×%u, %.0f Hz, %s"),
-				status.width, status.height, refresh,
-				status.dvi ? B_TRANSLATE("DVI, no sound")
-					: B_TRANSLATE("HDMI with sound"));
-		} else
-			mode = B_TRANSLATE("The output is off.");
-	}
-
-	if (screen != fScreenView->Text())
-		fScreenView->SetText(screen);
-	if (mode != fModeView->Text())
-		fModeView->SetText(mode);
-}
-
-
-void
-HDMIWindow::_Apply()
-{
-	DriverSettings settings;
-	int32 choice = fModeMenu->IndexOf(fModeMenu->FindMarked());
-	settings.Set("hdmi_mode", choice > 0 && choice < (int32)B_COUNT_OF(kModeValues)
-		? kModeValues[choice] : NULL);
-	settings.Set("hdmi_dvi",
-		fDviCheckBox->Value() == B_CONTROL_ON ? "true" : NULL);
-	settings.Set("hdmi_drive_current",
-		fSignalCheckBox->Value() == B_CONTROL_ON ? "31" : NULL);
-
-	status_t status = settings.Save();
-	if (status == B_OK) {
-		int device = open(kDevice, O_RDONLY);
-		if (device < 0 || ioctl(device, TEGRA_DC_RECONNECT_HDMI, NULL, 0) != 0)
-			status = errno;
-		if (device >= 0)
-			close(device);
-	}
-	if (status != B_OK) {
-		BString text(B_TRANSLATE("Could not apply the HDMI settings: %error%"));
-		text.ReplaceFirst("%error%", strerror(status));
-		BAlert* alert = new BAlert(B_TRANSLATE("HDMI"), text,
-			B_TRANSLATE("OK"), NULL, NULL, B_WIDTH_AS_USUAL, B_STOP_ALERT);
-		alert->Go(NULL);
-	}
-	_UpdateStatus();
-}
-
-
-class HDMIApplication : public BApplication {
-public:
-	HDMIApplication()
-		:
-		BApplication("application/x-vnd.Haiku-HDMI")
-	{
-	}
-
-	virtual void ReadyToRun()
-	{
-		(new HDMIWindow())->Show();
-	}
-};
-
-
-int
-main()
-{
-	HDMIApplication application;
-	application.Run();
-	return 0;
-}
