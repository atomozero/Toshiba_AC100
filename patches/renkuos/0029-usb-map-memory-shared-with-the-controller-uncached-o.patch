From 321cae37ba5b8dd677e7c37fc321273db8366062 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 22 Nov 2026 18:24:04 +0100
Subject: [PATCH 29/32] usb: map memory shared with the controller uncached on
 32-bit ARM too

The USB controllers of a Tegra 2 do not snoop the CPU caches, and since
the ARM kernel enables write-back caching the memory the USB stack shares
with them (descriptors, frame list, bounce buffers) was cacheable there:
descriptors the CPU had written could stay in its cache while the
controller read old ones from memory, and the CPU could read back a status
the controller had already changed. On a Toshiba AC100 a UVC camera's
video frames got pieces of other transfers in them while its microphone
streamed, and isochronous transactions looked as if they had never run.
Map it normal non-cacheable as on arm64; the cached lines are written back
when the memory type changes.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/bus_managers/usb/usb_dma.h | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/add-ons/kernel/bus_managers/usb/usb_dma.h b/src/add-ons/kernel/bus_managers/usb/usb_dma.h
index 78aa6af04a..eac6273e9b 100644
--- a/src/add-ons/kernel/bus_managers/usb/usb_dma.h
+++ b/src/add-ons/kernel/bus_managers/usb/usb_dma.h
@@ -27,6 +27,18 @@ usb_prepare_dma_area(area_id area, void* address, size_t size)
 		asm volatile("dc civac, %0" : : "r"(p) : "memory");
 	asm volatile("dsb sy" : : : "memory");
 
+	physical_entry entry;
+	if (get_memory_map(address, B_PAGE_SIZE, &entry, 1) == B_OK) {
+		vm_set_area_memory_type(area, entry.address,
+			B_WRITE_COMBINING_MEMORY);
+	}
+#elif defined(__arm__)
+	// The same on 32-bit ARM, where the USB controllers of a Tegra 2 do not
+	// snoop the caches either: the descriptors the CPU wrote could stay in
+	// its cache while the controller read old ones from memory, and the CPU
+	// read back a status the controller had already changed. Making the
+	// memory non-cacheable writes the cached lines back first.
+	(void)size;
 	physical_entry entry;
 	if (get_memory_map(address, B_PAGE_SIZE, &entry, 1) == B_OK) {
 		vm_set_area_memory_type(area, entry.address,
