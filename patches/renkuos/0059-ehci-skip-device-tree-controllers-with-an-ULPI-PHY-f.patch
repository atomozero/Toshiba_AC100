From a5f54398ceeb2d528f7391d81b1783184c2f4f4f Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 23:19:13 +0200
Subject: [PATCH 059/270] ehci: skip device tree controllers with an ULPI PHY
 for now

Their link clock, the reset GPIO and the external PHY are not set up by
anybody yet; on the Toshiba AC100 the registers of the ULPI controller
read back garbage.
---
 src/add-ons/kernel/busses/usb/ehci.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/add-ons/kernel/busses/usb/ehci.cpp b/src/add-ons/kernel/busses/usb/ehci.cpp
index 3f3018fadc..ec3651dbe4 100644
--- a/src/add-ons/kernel/busses/usb/ehci.cpp
+++ b/src/add-ons/kernel/busses/usb/ehci.cpp
@@ -287,6 +287,13 @@ supports_device(device_node* parent)
 		if (mode != NULL && strcmp(mode, "host") != 0)
 			return 0.0f;
 
+		// TODO: ULPI ports need their link clock, the reset GPIO and the
+		// external PHY set up, which nobody does yet
+		const char* phyType = (const char*)fdt->get_prop(fdtDevice,
+			"phy_type", &length);
+		if (phyType != NULL && strcmp(phyType, "ulpi") == 0)
+			return 0.0f;
+
 		TRACE_MODULE("EHCI device tree controller found!\n");
 		return 0.8f;
 	}
