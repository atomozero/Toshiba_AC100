+/*!	Cleans the data cache lines covering the given range to the point of
+	coherency. The translation table walker does not necessarily look into the
+	L1 data cache (e.g. on Cortex-A9 without ACTLR.SMP), so page table updates
+	must be pushed out before they are used.
+*/
+static inline void
+arm_clean_dcache_range(const void* address, size_t size)
+{
+	uint32 ctr;
+	asm volatile ("mrc p15, 0, %0, c0, c0, 1" : "=r" (ctr));
+	addr_t lineSize = 4 << ((ctr >> 16) & 0xf);
+
+	addr_t line = (addr_t)address & ~(lineSize - 1);
+	addr_t end = (addr_t)address + size;
+	dsb();
+	for (; line < end; line += lineSize)
+		asm volatile ("mcr p15, 0, %0, c7, c10, 1" : : "r" (line) : "memory");
+	dsb();
+}
+
+
 void arch_cpu_invalidate_TLB_page(addr_t page);
+void arm_sync_icache_all(void);
+void arm_local_tlb_invalidate(void);
+void arm_clean_invalidate_dcache_all(void);
+
+// The outer (level 2) cache is not reached by the CP15 cache maintenance
+// operations: memory shared with a DMA engine must also be cleaned or
+// invalidated there, by physical address. No-ops without an outer cache.
+void arm_outer_cache_clean_range(phys_addr_t address, size_t size);
+void arm_outer_cache_flush_range(phys_addr_t address, size_t size);
+	// clean and invalidate
 
 static inline void
 arch_cpu_pause(void)
diff --git a/src/system/kernel/arch/arm/arch_l2_cache.cpp b/src/system/kernel/arch/arm/arch_l2_cache.cpp
new file mode 100644
index 0000000000..b564488f87
--- /dev/null
+++ b/src/system/kernel/arch/arm/arch_l2_cache.cpp
@@ -0,0 +1,165 @@
+/*
+ * Copyright 2026, Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	The PL310 (L2C-310) outer cache of Cortex-A9 systems, e.g. 1 MB on the
+	NVIDIA Tegra 2. Firmwares may leave it off. It is only switched on when
+	the kernel settings say "arm_l2_cache true": on the Toshiba AC100 the
+	system hung after doing so (not understood yet).
+
+	The CP15 cache maintenance operations stop at the outer cache: memory
+	shared with a DMA engine must also be handled here, by physical address.
+	Table walks are outer cacheable (TTBR), so page table updates only need
+	to reach it.
+*/
+
+
+#include <KernelExport.h>
+
+#include <arch/cpu.h>
+#include <boot/kernel_args.h>
+#include <driver_settings.h>
+#include <smp.h>
+#include <util/AutoLock.h>
+#include <vm/vm.h>
+
+
+#define L2X0_CTRL				0x100
+#define L2X0_CTRL_ENABLE		(1U << 0)
+#define L2X0_AUX_CTRL			0x104
+#define L2X0_AUX_ASSOCIATIVITY	(1U << 16)	// 16 ways instead of 8
+#define L2X0_AUX_SHARED_OVERRIDE	(1U << 22)
+#define L2X0_AUX_INSTRUCTION_PREFETCH	(1U << 29)
+#define L2X0_AUX_DATA_PREFETCH	(1U << 28)
+#define L2X0_TAG_LATENCY		0x108
+#define L2X0_DATA_LATENCY		0x10c
+#define L2X0_CACHE_SYNC			0x730
+#define L2X0_INV_WAY			0x77c
+#define L2X0_CLEAN_LINE_PA		0x7b0
+#define L2X0_INV_LINE_PA		0x770
+#define L2X0_LINE_SIZE			32
+
+
+static volatile uint8* sL2;		// only set while the cache is on
+static spinlock sL2Lock = B_SPINLOCK_INITIALIZER;
+
+
+static inline uint32
+read_reg(volatile uint8* base, uint32 offset)
+{
+	return *(volatile uint32*)(base + offset);
+}
+
+
+static inline void
+write_reg(volatile uint8* base, uint32 offset, uint32 value)
+{
+	*(volatile uint32*)(base + offset) = value;
+}
+
+
+status_t
+arm_l2_cache_init(kernel_args* args)
+{
+	if (args->arch_args.l2Cache.start == 0)
+		return B_OK;
+
+	void* settings = load_driver_settings("kernel");
+	bool enable = get_driver_boolean_parameter(settings, "arm_l2_cache", false,
+		true);
+	unload_driver_settings(settings);
+
+	void* address;
+	area_id area = map_physical_memory("pl310 l2 cache",
+		args->arch_args.l2Cache.start, B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+	if (area < B_OK)
+		return area;
+	volatile uint8* l2 = (volatile uint8*)address;
+
+	if ((read_reg(l2, L2X0_CTRL) & L2X0_CTRL_ENABLE) != 0) {
+		dprintf("L2 cache: on already\n");
+		sL2 = l2;
+		return B_OK;
+	}
+	if (!enable) {
+		dprintf("L2 cache: left off (\"arm_l2_cache true\" switches it on)\n");
+		delete_area(area);
+		return B_OK;
+	}
+
+	// the latencies and the auxiliary control may only be set while it is off;
+	// all memory is shareable (for SMP), which older revisions would not cache
+	// without the override; no prefetching (errata on early revisions)
+	write_reg(l2, L2X0_AUX_CTRL, (read_reg(l2, L2X0_AUX_CTRL)
+		| L2X0_AUX_SHARED_OVERRIDE)
+		& ~(L2X0_AUX_INSTRUCTION_PREFETCH | L2X0_AUX_DATA_PREFETCH));
+	if (args->arch_args.l2TagLatency != 0)
+		write_reg(l2, L2X0_TAG_LATENCY, args->arch_args.l2TagLatency);
+	if (args->arch_args.l2DataLatency != 0)
+		write_reg(l2, L2X0_DATA_LATENCY, args->arch_args.l2DataLatency);
+
+	// it was off, so memory is up to date: just invalidate it
+	uint32 ways = (read_reg(l2, L2X0_AUX_CTRL) & L2X0_AUX_ASSOCIATIVITY) != 0
+		? 16 : 8;
+	uint32 wayMask = (1U << ways) - 1;
+	write_reg(l2, L2X0_INV_WAY, wayMask);
+	for (int32 i = 0; i < 1000000
+			&& (read_reg(l2, L2X0_INV_WAY) & wayMask) != 0; i++) {
+	}
+	write_reg(l2, L2X0_CACHE_SYNC, 0);
+
+	write_reg(l2, L2X0_CTRL, L2X0_CTRL_ENABLE);
+	asm volatile("dsb" : : : "memory");
+	sL2 = l2;
+
+	dprintf("L2 cache: on (cache id %#" B_PRIx32 "), %" B_PRIu32 " ways, aux %#"
+		B_PRIx32 ", latencies "
+		"%#" B_PRIx32 "/%#" B_PRIx32 "\n", read_reg(l2, 0), ways,
+		read_reg(l2, L2X0_AUX_CTRL),
+		read_reg(l2, L2X0_TAG_LATENCY), read_reg(l2, L2X0_DATA_LATENCY));
+	return B_OK;
+}
+
+
+/*!	Writes the lines of the range to the given register, one by one, then
+	waits for them. Clean and invalidate are done as two operations: the
+	combined one is broken on early PL310 revisions (erratum 588369).
+*/
+static void
+outer_cache_range(phys_addr_t address, size_t size, bool clean,
+	bool invalidate)
+{
+	if (sL2 == NULL || size == 0)
+		return;
+
+	phys_addr_t end = address + size;
+	address &= ~(phys_addr_t)(L2X0_LINE_SIZE - 1);
+
+	InterruptsSpinLocker locker(sL2Lock);
+	asm volatile("dsb" : : : "memory");
+	for (phys_addr_t line = address; line < end; line += L2X0_LINE_SIZE) {
+		if (clean)
+			write_reg(sL2, L2X0_CLEAN_LINE_PA, (uint32)line);
+		if (invalidate)
+			write_reg(sL2, L2X0_INV_LINE_PA, (uint32)line);
+	}
+	write_reg(sL2, L2X0_CACHE_SYNC, 0);
+	asm volatile("dsb" : : : "memory");
+}
+
+
+void
+arm_outer_cache_clean_range(phys_addr_t address, size_t size)
+{
+	outer_cache_range(address, size, true, false);
+}
+
+
+void
+arm_outer_cache_flush_range(phys_addr_t address, size_t size)
+{
+	outer_cache_range(address, size, true, true);
+}
diff --git a/src/system/kernel/arch/arm/arch_vm.cpp b/src/system/kernel/arch/arm/arch_vm.cpp
index e064889ee3..18a9967850 100644
--- a/src/system/kernel/arch/arm/arch_vm.cpp
+++ b/src/system/kernel/arch/arm/arch_vm.cpp
@@ -70,22 +70,42 @@ arch_vm_init_end(kernel_args *args)
 			continue;
 		}
 
-		phys_addr_t physicalAddress;
-		void *address = (void*)range.start;
-		if (vm_get_page_mapping(VMAddressSpace::KernelID(), range.start,
-			&physicalAddress) != B_OK)
-			panic("arch_vm_init_end(): No page mapping for %p\n", address);
-
-		area_id area = vm_map_physical_memory(VMAddressSpace::KernelID(),
-			"boot loader reserved area", &address,
-			B_EXACT_ADDRESS, range.size,
-			B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
-			physicalAddress, true);
-
-		if (area < 0) {
-			panic("arch_vm_init_end(): Failed to create area for boot loader "
-				"reserved area: %p - %p\n", (void*)range.start,
-				(void*)(range.start + range.size));
+		// The boot loader merges adjacent ranges, which need not be adjacent
+		// physically (e.g. the EFI runtime regions, or a device mapped next to
+		// them), so map every physically contiguous run on its own.
+		addr_t start = (addr_t)range.start;
+		addr_t end = start + (addr_t)range.size;
+		while (start < end) {
+			phys_addr_t physicalAddress;
+			if (vm_get_page_mapping(VMAddressSpace::KernelID(), start,
+					&physicalAddress) != B_OK) {
+				panic("arch_vm_init_end(): No page mapping for %p\n",
+					(void*)start);
+			}
+
+			addr_t runEnd = start + B_PAGE_SIZE;
+			phys_addr_t nextPhysicalAddress;
+			while (runEnd < end
+				&& vm_get_page_mapping(VMAddressSpace::KernelID(), runEnd,
+					&nextPhysicalAddress) == B_OK
+				&& nextPhysicalAddress == physicalAddress + (runEnd - start)) {
+				runEnd += B_PAGE_SIZE;
+			}
+
+			void* address = (void*)start;
+			area_id area = vm_map_physical_memory(VMAddressSpace::KernelID(),
+				"boot loader reserved area", &address,
+				B_EXACT_ADDRESS, runEnd - start,
+				B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+				physicalAddress, true);
+
+			if (area < 0) {
+				panic("arch_vm_init_end(): Failed to create area for boot "
+					"loader reserved area: %p - %p\n", (void*)start,
+					(void*)runEnd);
+			}
+
+			start = runEnd;
 		}
 	}
 
@@ -135,5 +155,13 @@ status_t
 arch_vm_set_memory_type(VMArea *area, phys_addr_t physicalBase, uint32 type,
 	uint32 *effectiveType)
 {
+	// Memory that was mapped cacheable before may still have lines in the
+	// data cache; write them back and discard them, or they could later be
+	// evicted over data written through the new, non-cacheable mapping (e.g.
+	// by a DMA engine).
+	if (type == B_UNCACHED_MEMORY || type == B_WRITE_COMBINING_MEMORY) {
+		arm_clean_invalidate_dcache_all();
+		arm_outer_cache_flush_range(physicalBase, area->Size());
+	}
 	return B_OK;
 }
