@@ -0,0 +1,12 @@
+SubDir HAIKU_TOP src add-ons kernel drivers graphics tegra_dc ;
+
+UsePrivateHeaders [ FDirName graphics common ] ;
+UsePrivateHeaders [ FDirName graphics tegra_dc ] ;
+UsePrivateKernelHeaders ;
+UseLibraryHeaders [ FDirName libfdt ] ;
+
+KernelAddon tegra_dc :
