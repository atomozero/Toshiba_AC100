diff --git a/src/add-ons/accelerants/tegra_dc/accelerant.cpp b/src/add-ons/accelerants/tegra_dc/accelerant.cpp
new file mode 100644
index 0000000000..a97df0adeb
--- /dev/null
+++ b/src/add-ons/accelerants/tegra_dc/accelerant.cpp
@@ -0,0 +1,172 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+/*!	Accelerant for the display controller of the NVIDIA Tegra 2. The kernel
+	driver owns the hardware; the accelerant offers its modes to app_server
+	and gives it a clone of the scanout memory.
+*/
+
+
+#include "accelerant.h"
+#include "accelerant_protos.h"
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <AutoDeleterOS.h>
+
+
+accelerant_info* gInfo;
+
+
+/*!	Common part of the primary accelerant and of its clones. */
+static status_t
+init_common(int device, bool isClone)
+{
+	gInfo = (accelerant_info*)calloc(1, sizeof(accelerant_info));
+	if (gInfo == NULL)
+		return B_NO_MEMORY;
+	MemoryDeleter infoDeleter(gInfo);
+
+	gInfo->is_clone = isClone;
+	gInfo->device = device;
+	gInfo->mode_list_area = -1;
+	gInfo->frame_buffer_area = -1;
+
+	area_id sharedArea;
+	if (ioctl(device, TEGRA_DC_GET_PRIVATE_DATA, &sharedArea,
+			sizeof(area_id)) != 0) {
+		return B_ERROR;
+	}
+
+	AreaDeleter sharedDeleter(clone_area("tegra_dc shared info",
+		(void**)&gInfo->shared_info, B_ANY_ADDRESS,
+		B_READ_AREA | B_WRITE_AREA, sharedArea));
+	status_t status = gInfo->shared_info_area = sharedDeleter.Get();
+	if (status < B_OK)
+		return status;
+
+	infoDeleter.Detach();
+	sharedDeleter.Detach();
+	return B_OK;
+}
+
+
+static void
+uninit_common()
+{
+	delete_area(gInfo->frame_buffer_area);
+	delete_area(gInfo->shared_info_area);
+
+	// only a clone opened the device itself
+	if (gInfo->is_clone)
+		close(gInfo->device);
+
+	free(gInfo);
+	gInfo = NULL;
+}
+
+
+//	#pragma mark - public accelerant functions
+
+
+status_t
+tegra_dc_init_accelerant(int device)
+{
+	status_t status = init_common(device, false);
+	if (status != B_OK)
+		return status;
+
+	status = create_mode_list();
+	if (status != B_OK) {
+		uninit_common();
+		return status;
+	}
+
+	area_info info;
+	if (ioctl(device, TEGRA_DC_CLONE_FRAME_BUFFER, &info, sizeof(info)) != 0) {
+		status = errno;
+		uninit_common();
+		return status;
+	}
+	gInfo->frame_buffer_area = info.area;
+	gInfo->frame_buffer = info.address;
+	return B_OK;
+}
+
+
+ssize_t
+tegra_dc_accelerant_clone_info_size(void)
+{
+	return B_PATH_NAME_LENGTH;
+}
+
+
+void
+tegra_dc_get_accelerant_clone_info(void* info)
+{
+	ioctl(gInfo->device, TEGRA_DC_GET_DEVICE_NAME, info, B_PATH_NAME_LENGTH);
+}
+
+
+status_t
+tegra_dc_clone_accelerant(void* info)
+{
+	char path[B_PATH_NAME_LENGTH];
+	strlcpy(path, "/dev/", sizeof(path));
+	strlcat(path, (const char*)info, sizeof(path));
+
+	int device = open(path, B_READ_WRITE);
+	if (device < 0)
+		return errno;
+
+	status_t status = init_common(device, true);
+	if (status != B_OK) {
+		close(device);
+		return status;
+	}
+
+	gInfo->mode_list_area = clone_area("tegra_dc cloned modes",
+		(void**)&gInfo->mode_list, B_ANY_ADDRESS, B_READ_AREA,
+		gInfo->shared_info->mode_list_area);
+	if (gInfo->mode_list_area < B_OK) {
+		status = gInfo->mode_list_area;
+		uninit_common();
+		return status;
+	}
+	return B_OK;
+}
+
+
+void
+tegra_dc_uninit_accelerant(void)
+{
+	delete_area(gInfo->mode_list_area);
+	uninit_common();
+}
+
+
+status_t
+tegra_dc_get_accelerant_device_info(accelerant_device_info* info)
+{
+	info->version = B_ACCELERANT_VERSION;
+	strlcpy(info->name, "NVIDIA Tegra 2 display controller",
+		sizeof(info->name));
+	strlcpy(info->chipset, "Tegra20 DC", sizeof(info->chipset));
+	strlcpy(info->serial_no, "None", sizeof(info->serial_no));
+	info->memory = gInfo->shared_info->frame_buffer_size;
+	info->dac_speed = gInfo->shared_info->timing.pixel_clock / 1000;
+	return B_OK;
+}
+
+
+sem_id
+tegra_dc_accelerant_retrace_semaphore(void)
+{
+	return gInfo->shared_info->vblank_sem;
+}
