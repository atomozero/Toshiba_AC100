+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef TEGRA_DC_INFO_H
+#define TEGRA_DC_INFO_H
+
+
+#include <Accelerant.h>
+#include <Drivers.h>
+#include <edid.h>
+
+
+#define TEGRA_DC_ACCELERANT_NAME	"tegra_dc.accelerant"
+#define TEGRA_DC_DEVICE_NAME		"graphics/tegra_dc"
+
+
+/*!	Shared between the kernel driver and the accelerant (cloned read-write
+	by it). The kernel driver owns the hardware: the accelerant only reads
+	this and asks for changes through the ioctls below.
+*/
+struct tegra_dc_shared_info {
+	area_id			mode_list_area;		// created by the primary accelerant
+	uint32			mode_count;
+
+	display_mode	current_mode;
+	uint32			bytes_per_row;
+
+	display_timing	timing;				// as the firmware set the panel up
+	uint32			frame_buffer_size;	// bytes mapped for scanout
+
+	sem_id			vblank_sem;
+	uint32			vblank_count;		// vertical blank interrupts so far
+
+	edid1_info		edid_info;
+	bool			has_edid;
+};
+
+
+enum {
+	TEGRA_DC_GET_PRIVATE_DATA = B_DEVICE_OP_CODES_END + 1,
+		// area_id of the shared info
+	TEGRA_DC_GET_DEVICE_NAME,
+		// char[B_PATH_NAME_LENGTH]
+	TEGRA_DC_CLONE_FRAME_BUFFER,
+		// area_info of a clone of the scanout memory in the caller
+	TEGRA_DC_SET_DISPLAY_MODE,
+		// display_mode
+};
+
+
+#endif	// TEGRA_DC_INFO_H
