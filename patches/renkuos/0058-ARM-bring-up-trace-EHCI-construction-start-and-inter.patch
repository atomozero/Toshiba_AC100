From ba1288d7be0fe7fc7aeff04c16c49965c5b81fe9 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 23:11:36 +0200
Subject: [PATCH 058/270] ARM bring-up: trace EHCI construction, start and
 interrupt rate (not for merging)

---
 src/add-ons/kernel/busses/usb/ehci.cpp | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/src/add-ons/kernel/busses/usb/ehci.cpp b/src/add-ons/kernel/busses/usb/ehci.cpp
index 8e286eb614..3f3018fadc 100644
--- a/src/add-ons/kernel/busses/usb/ehci.cpp
+++ b/src/add-ons/kernel/busses/usb/ehci.cpp
@@ -1026,7 +1026,9 @@ EHCI::_FinishInit()
 	fAsyncQueueHead->endpoint_caps = 1 << EHCI_QH_CAPS_MULT_SHIFT;
 	fAsyncQueueHead->overlay.next_phy = EHCI_ITEM_TERMINATE;
 
+	dprintf("AC100: ehci %p async list\n", fOperationalRegisters);
 	WriteOpReg(EHCI_ASYNCLISTADDR, (uint32)fAsyncQueueHead->this_phy);
+	dprintf("AC100: ehci %p constructed\n", fOperationalRegisters);
 	TRACE("set the async list addr to 0x%08" B_PRIx32 "\n",
 		ReadOpReg(EHCI_ASYNCLISTADDR));
 
@@ -1087,6 +1089,9 @@ status_t
 EHCI::Start()
 {
 	TRACE("starting EHCI host controller\n");
+	dprintf("AC100: ehci %p start, USBCMD %#" B_PRIx32 ", USBSTS %#" B_PRIx32
+		"\n", fOperationalRegisters, ReadOpReg(EHCI_USBCMD),
+		ReadOpReg(EHCI_USBSTS));
 	TRACE("usbcmd: 0x%08" B_PRIx32 "; usbsts: 0x%08" B_PRIx32 "\n",
 		ReadOpReg(EHCI_USBCMD), ReadOpReg(EHCI_USBSTS));
 
@@ -1137,6 +1142,10 @@ EHCI::Start()
 		return B_ERROR;
 	}
 
+	dprintf("AC100: ehci %p running, USBSTS %#" B_PRIx32 ", PORTSC %#"
+		B_PRIx32 "\n", fOperationalRegisters, ReadOpReg(EHCI_USBSTS),
+		ReadOpReg(EHCI_PORTSC));
+
 	// route all ports to us
 	WriteOpReg(EHCI_CONFIGFLAG, EHCI_CONFIGFLAG_FLAG);
 	snooze(10000);
@@ -1997,6 +2006,15 @@ EHCI::Interrupt()
 
 	// check if any interrupt was generated
 	uint32 status = ReadOpReg(EHCI_USBSTS) & EHCI_USBSTS_INTMASK;
+
+	// bring-up aid: tell an interrupt storm
+	static int32 sInterruptCount;
+	if (++sInterruptCount % 5000 == 0) {
+		dprintf("AC100: ehci %p %" B_PRId32 " interrupts, USBSTS %#" B_PRIx32
+			", enabled %#" B_PRIx32 ", PORTSC %#" B_PRIx32 "\n",
+			fOperationalRegisters, sInterruptCount, ReadOpReg(EHCI_USBSTS),
+			fEnabledInterrupts, ReadOpReg(EHCI_PORTSC));
+	}
 	if ((status & fEnabledInterrupts) == 0) {
 		if (status != 0) {
 			TRACE("discarding not enabled interrupts 0x%08" B_PRIx32 "\n",
