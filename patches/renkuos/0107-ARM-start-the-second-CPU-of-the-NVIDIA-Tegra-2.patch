 // 1 MHz counter (TIMERUS) used as clock source and the one-shot TMR1 used
 // for timer events. TMR2 ticks periodically so that the 32-bit TIMERUS
 // counter is sampled before it wraps.
+// With several CPUs the events come from the private timer (TWD) of each
+// CPU instead, as TMR1 and its interrupt are shared.
 class TegraTimer : public HardwareTimer {
 public:
 	void SetTimeout(bigtime_t timeout);
 	bigtime_t Time();
 	void Clear();
+	status_t PerCpuInit();
 
-	static status_t Init(phys_addr_t regBase, uint32 interrupt)
+	static status_t Init(phys_addr_t regBase, uint32 interrupt,
+		phys_addr_t twdBase = 0, uint32 twdInterrupt = 0,
+		uint32 twdFrequency = 0)
 	{
 		if (sInstance != NULL)
 			return B_OK;
 
-		TegraTimer* timer = new(std::nothrow) TegraTimer(regBase, interrupt);
+		TegraTimer* timer = new(std::nothrow) TegraTimer(regBase, interrupt,
+			twdBase, twdInterrupt, twdFrequency);
 		return timer != NULL ? B_OK : B_NO_MEMORY;
 	}
 
 private:
-	TegraTimer(phys_addr_t regBase, uint32 interrupt);
+	TegraTimer(phys_addr_t regBase, uint32 interrupt, phys_addr_t twdBase,
+		uint32 twdInterrupt, uint32 twdFrequency);
 
 	bigtime_t _TimeLocked();
 
 	static int32 _HandleEventInterrupt(void* data);
 	static int32 _HandleWrapInterrupt(void* data);
+	static int32 _HandleTWDInterrupt(void* data);
 
 	area_id fRegArea;
 	volatile uint32* fRegs;
@@ -48,6 +56,11 @@ private:
 	spinlock fLock;
 	uint32 fLastCount;
 	bigtime_t fHighTime;
+
+	area_id fTWDArea;
+	volatile uint32* fTWD;		// banked: each CPU sees its own timer
+	int32 fTWDInterrupt;
+	uint32 fTWDFrequency;
 };
 
 
