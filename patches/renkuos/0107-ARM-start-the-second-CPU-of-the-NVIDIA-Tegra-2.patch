-		int32 result = psci_call(PSCI_CPU_ON_32, sCpus[count].id, entry, 0);
-		if (result != 0) {
-			dprintf("smp: CPU %" B_PRIu32 " did not start: PSCI error %"
-				B_PRId32 "\n", count, result);
-			break;
-		}
+		if (sCpus[count].psci) {
+			int32 result = psci_call(PSCI_CPU_ON_32, sCpus[count].id, entry,
+				0);
+			if (result != 0) {
+				dprintf("smp: CPU %" B_PRIu32 " did not start: PSCI error %"
+					B_PRId32 "\n", count, result);
+				break;
+			}
+		} else
+			tegra20_start_cpu(count, entry);
 
 		// it writes with its caches off: drop our copy of the line
 		bool up = false;
