 arch_smp_get_current_cpu(void)
 {
@@ -85,7 +109,9 @@ arch_smp_get_current_cpu(void)
 static bool
 can_start(const platform_cpu_info& cpu)
 {
-	return cpu.psci && sPsciMethod != PSCI_NONE;
+	if (cpu.psci)
+		return sPsciMethod != PSCI_NONE;
+	return sTegra20FlowController != 0 && cpu.id == 1;
 }
 
 
@@ -139,6 +165,49 @@ psci_call(uint32 function, uint32 arg0, uint32 arg1, uint32 arg2)
 }
 
 
+/*!	The caches of the CPUs are only kept coherent by the snoop control unit,
+	which a firmware running on one CPU may have left off.
+*/
+static void
+enable_scu()
+{
+	addr_t peripherals;
+	asm volatile("mrc p15, 4, %0, c15, c0, 0" : "=r" (peripherals));	// CBAR
+	volatile uint32* scu = (volatile uint32*)(peripherals & ~0x1fffUL);
+	if ((scu[SCU_CTRL / 4] & SCU_ENABLE) != 0)
+		return;
+
+	scu[SCU_CTRL / 4] |= SCU_ENABLE;
+	asm volatile("dsb" : : : "memory");
+	clean_dcache_all();
+	dprintf("smp: SCU at %#lx enabled\n", (addr_t)scu);
+}
+
+
+static status_t
+tegra20_start_cpu(uint32 cpu, addr_t entry)
+{
+	volatile uint32* car = (volatile uint32*)TEGRA20_CAR_BASE;
+	volatile uint32* flow = (volatile uint32*)sTegra20FlowController;
+
+	enable_scu();
+
+	*(volatile uint32*)TEGRA20_EVP_CPU_RESET_VECTOR = entry;
+	asm volatile("dsb" : : : "memory");
+
+	// hold it in reset while the flow controller lets it go, then clock it
+	// and release the reset
+	car[TEGRA_RST_CPU_CMPLX_SET / 4] = TEGRA_CPU_RESET(cpu);
+	flow[TEGRA_FLOW_HALT_CPU1_EVENTS / 4] = 0;
+	car[TEGRA_CLK_CPU_CMPLX / 4] &= ~TEGRA_CPU_CLOCK(cpu);
+	flow[TEGRA_FLOW_CPU1_CSR / 4] = 0;
+	asm volatile("dsb" : : : "memory");
+	car[TEGRA_RST_CPU_CMPLX_CLR / 4] = TEGRA_CPU_RESET(cpu);
+	asm volatile("dsb" : : : "memory");
+	return B_OK;
+}
+
