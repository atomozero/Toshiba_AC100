--- a/src/system/kernel/arch/arm/soc_tegra.cpp
+++ b/src/system/kernel/arch/arm/soc_tegra.cpp
@@ -30,6 +30,13 @@
 // Well below the TIMERUS wrap time of 2^32 µs (about 71 minutes)
 #define WRAP_TICK_PERIOD	TMR_PTV_MAX
 
+// Cortex-A9 private timer, offsets in bytes
+#define TWD_LOAD				0x00
+#define TWD_CONTROL				0x08
+#define TWD_CONTROL_ENABLE		(1U << 0)
+#define TWD_CONTROL_IRQ_ENABLE	(1U << 2)
+#define TWD_INTERRUPT_STATUS	0x0c
+
 
 static inline uint32
 read_reg(volatile uint32* regs, uint32 offset)
@@ -45,12 +52,17 @@ write_reg(volatile uint32* regs, uint32 offset, uint32 value)
 }
 
 
-TegraTimer::TegraTimer(phys_addr_t regBase, uint32 interrupt)
+TegraTimer::TegraTimer(phys_addr_t regBase, uint32 interrupt,
+	phys_addr_t twdBase, uint32 twdInterrupt, uint32 twdFrequency)
 	:
 	fEventInterrupt(interrupt),
 	fWrapInterrupt(interrupt + TMR2_INTERRUPT_OFFSET),
 	fLock(B_SPINLOCK_INITIALIZER),
-	fHighTime(0)
