 #define PSCI_CPU_ON_32		0x84000003
 
+// NVIDIA Tegra 2: the second CPU waits in reset, with its clock stopped
+// (see arch/arm/mach-tegra/platsmp.c in Linux)
+#define TEGRA20_CAR_BASE				0x60006000
+#define TEGRA_CLK_CPU_CMPLX				0x4c
+#define TEGRA_CPU_CLOCK(cpu)			(1U << (8 + (cpu)))
+#define TEGRA_RST_CPU_CMPLX_SET			0x340
+#define TEGRA_RST_CPU_CMPLX_CLR			0x344
+#define TEGRA_CPU_RESET(cpu)			(0x1111U << (cpu))
+#define TEGRA20_EVP_CPU_RESET_VECTOR	0x6000f100
+#define TEGRA_FLOW_HALT_CPU1_EVENTS		0x14
+#define TEGRA_FLOW_CPU1_CSR				0x18
+
+// Cortex-A9 snoop control unit, at the base of the private peripherals
+#define SCU_CTRL						0x00
+#define SCU_ENABLE						(1U << 0)
+
 
 extern "C" void arch_enter_kernel(uint32_t ttbr, addr_t kernelArgs,
 	addr_t kernelEntry, addr_t kernelStackTop);
@@ -48,6 +64,7 @@ enum psci_method {
 	PSCI_SMC
 };
 static psci_method sPsciMethod = PSCI_NONE;
