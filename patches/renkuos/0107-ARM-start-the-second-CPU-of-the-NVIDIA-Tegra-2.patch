 {
 	fRegArea = vm_map_physical_memory(B_SYSTEM_TEAM, "timer-tegra",
 		(void**)&fRegs, B_ANY_KERNEL_ADDRESS, B_PAGE_SIZE,
@@ -64,9 +76,27 @@ TegraTimer::TegraTimer(phys_addr_t regBase, uint32 interrupt)
 	dprintf("Tegra: timer @ %#" B_PRIxPHYSADDR ", IRQs %" B_PRId32 "/%" B_PRId32
 		"\n", regBase, fEventInterrupt, fWrapInterrupt);
 
+	if (twdBase != 0 && twdFrequency != 0) {
+		fTWDArea = vm_map_physical_memory(B_SYSTEM_TEAM, "timer-a9-twd",
+			(void**)&fTWD, B_ANY_KERNEL_ADDRESS, B_PAGE_SIZE,
+			B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+			ROUNDDOWN(twdBase, B_PAGE_SIZE), false);
+		if (fTWDArea < 0)
+			fTWD = NULL;
+		else
+			fTWD += (twdBase % B_PAGE_SIZE) / sizeof(uint32);
+	}
+
 	Clear();
-	install_io_interrupt_handler(fEventInterrupt,
-		&TegraTimer::_HandleEventInterrupt, this, 0);
+	if (fTWD != NULL) {
+		dprintf("Tegra: events from the private timers, IRQ %" B_PRId32 ", %"
+			B_PRIu32 " Hz\n", fTWDInterrupt, fTWDFrequency);
+		install_io_interrupt_handler(fTWDInterrupt,
+			&TegraTimer::_HandleTWDInterrupt, this, 0);
+	} else {
+		install_io_interrupt_handler(fEventInterrupt,
+			&TegraTimer::_HandleEventInterrupt, this, 0);
+	}
 
 	write_reg(fRegs, TMR2_BASE + TMR_PCR, TMR_PCR_INTR_CLR);
 	install_io_interrupt_handler(fWrapInterrupt,
@@ -79,6 +109,21 @@ TegraTimer::TegraTimer(phys_addr_t regBase, uint32 interrupt)
 void
 TegraTimer::SetTimeout(bigtime_t timeout)
 {
+	if (fTWD != NULL) {
+		// one-shot on this CPU's private timer
+		uint64 ticks = (uint64)timeout * fTWDFrequency / 1000000;
+		if (ticks < 1)
+			ticks = 1;
+		if (ticks > 0xffffffff)
+			ticks = 0xffffffff;
+		write_reg(fTWD, TWD_CONTROL, 0);
+		write_reg(fTWD, TWD_INTERRUPT_STATUS, 1);
+		write_reg(fTWD, TWD_LOAD, (uint32)ticks);
+		write_reg(fTWD, TWD_CONTROL,
+			TWD_CONTROL_ENABLE | TWD_CONTROL_IRQ_ENABLE);
+		return;
+	}
+
 	// The counter fires when it reaches zero after PTV + 1 ticks
 	if (timeout < 1)
 		timeout = 1;
@@ -107,11 +152,30 @@ TegraTimer::Time()
 void
 TegraTimer::Clear()
 {
+	if (fTWD != NULL) {
+		write_reg(fTWD, TWD_CONTROL, 0);
+		write_reg(fTWD, TWD_INTERRUPT_STATUS, 1);
+		return;
+	}
+
 	write_reg(fRegs, TMR1_BASE + TMR_PTV, 0);
 	write_reg(fRegs, TMR1_BASE + TMR_PCR, TMR_PCR_INTR_CLR);
 }
 
 
+/*!	The private timer and its interrupt (a PPI) are banked per CPU. */
+status_t
+TegraTimer::PerCpuInit()
+{
+	if (fTWD == NULL)
+		return B_OK;
+
+	Clear();
+	InterruptController::Get()->EnableInterrupt(fTWDInterrupt);
+	return B_OK;
+}
+
+
 bigtime_t
 TegraTimer::_TimeLocked()
 {
@@ -134,6 +198,16 @@ TegraTimer::_HandleEventInterrupt(void* data)
 }
 
 
+int32
+TegraTimer::_HandleTWDInterrupt(void* data)
+{
+	TegraTimer* timer = (TegraTimer*)data;
+
+	write_reg(timer->fTWD, TWD_INTERRUPT_STATUS, 1);
+	return timer_interrupt();
+}
+
+
 int32
 TegraTimer::_HandleWrapInterrupt(void* data)
 {
diff --git a/src/system/kernel/arch/arm/soc_tegra.h b/src/system/kernel/arch/arm/soc_tegra.h
