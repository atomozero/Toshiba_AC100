From cd9970e97e0e3b48c6260a09b8f6e41537925685 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 19 Oct 2026 07:45:43 +0200
Subject: [PATCH 130/270] minimum image: the applications, preferences and
 add-ons of the regular image on ARM

Add the applications, preferences, demos, servers, translators, media and
print add-ons and screen savers of the regular image to the ARM image,
leaving out what needs packages not available there (fluidlite for libmidi:
MidiPlayer, PatchBay; WonderBrushTranslator). Media builds the MIDI settings
in when libmidi is not available, Cortex gets the uint32 casts the ARM
compiler needs.
---
 build/jam/images/definitions/minimum          | 154 ++++++++++++++++++
 .../Persistence/Wrappers/MediaFormatIO.cpp    |   6 +-
 src/preferences/media/Jamfile                 |  13 +-
 3 files changed, 169 insertions(+), 4 deletions(-)

diff --git a/build/jam/images/definitions/minimum b/build/jam/images/definitions/minimum
index 597883423d..2117eed1c1 100644
--- a/build/jam/images/definitions/minimum
+++ b/build/jam/images/definitions/minimum
@@ -214,8 +214,10 @@ rule HaikuImageGetSystemLibs
 			libdebug.so
 			libdebugger.so@primary
 			libdevice.so
+			libbluetooth.so@arm
 			libgame.so@arm
 			libgnu.so
+			libmail.so@arm
 			libmedia.so@arm
 			libmidi2.so@arm
 			libnetwork.so
@@ -477,3 +479,155 @@ if $(HAIKU_IS_BOOTSTRAP) != 1 {
 	AddFilesToHaikuImage system settings package-repositories
 		: $(thirdPartyRepositoryConfigs) ;
 }
+
+# The Toshiba AC100 (ARM) gets the applications of the regular image that can
+# be built for it: nothing needing OpenGL or ffmpeg, and the image translators
+# need libraries that are not available for ARM (PNG, JPEG, ...).
+if arm in $(HAIKU_PACKAGING_ARCHS) {
+	SYSTEM_BIN += [ FFilterByBuildFeatures
+		cddb_lookup
+		clipboard
+		CortexAddOnHost@expat
+		dpms
+		installsound
+		mail
+		mail2mbox
+		mbox2mail
+		media_client
+		pidof
+		recover
+		screenshot
+		setcontrollook
+		setdecor
+		spamdbm
+		translate
+		WindowShade
+	] ;
+
+	SYSTEM_APPS += [ FFilterByBuildFeatures
+		AutoRaise
+		CodyCam
+		HaikuDepot
+		Icon-O-Matic@expat
+		LaunchBox
+		LegacyPackageInstaller
+		Mail
+		MediaConverter
+		MediaPlayer
+		People
+		PoorMan
+		RemoteDesktop
+		SerialConnect
+		SoftwareUpdater
+		SoundRecorder
+	] ;
+
+	DESKBAR_APPLICATIONS +=
+		ActivityMonitor
+		CodyCam
+		HaikuDepot
+		Icon-O-Matic
+		Magnify
+		Mail
+		MediaConverter
+		MediaPlayer
+		People
+		PoorMan
+		SerialConnect
+		SoftwareUpdater
+		SoundRecorder
+	;
+
+	DESKBAR_DESKTOP_APPLETS +=
+		AutoRaise
+		LaunchBox
+	;
+
+	SYSTEM_PREFERENCES += [ FFilterByBuildFeatures
+		Bluetooth
+		DataTranslations
+		E-mail
+		Media
+		Printers
+		Repositories
+		ScreenSaver
+		Sounds
+	] ;
+
+	SYSTEM_DEMOS += [ FFilterByBuildFeatures
+		Cortex@expat
+		OverlayImage
+	] ;
+
+	SYSTEM_SERVERS += [ FFilterByBuildFeatures
+		mail_daemon
+		media_addon_server
+		media_server
+		midi_server
+		print_server
+		print_addon_server
+	] ;
+
+	SYSTEM_ADD_ONS_TRANSLATORS += [ FFilterByBuildFeatures
+		BMPTranslator
+		GIFTranslator
+		HVIFTranslator
+		ICOTranslator
+		PCXTranslator
+		PPMTranslator
+		PSDTranslator
+		RAWTranslator
+		RTFTranslator
+		SGITranslator
+		TGATranslator
+	] ;
+
+	SYSTEM_ADD_ONS_MEDIA += [ FFilterByBuildFeatures
+		cortex_audioadapter.media_addon
+		cortex_flanger.media_addon
+		cortex_logging_consumer.media_addon
+		equalizer.media_addon
+		hmulti_audio.media_addon
+		mixer.media_addon
+		tone_producer_demo.media_addon
+		usb_webcam.media_addon
+		video_mixer.media_addon
+		video_producer_demo.media_addon
+		video_window_demo.media_addon
+	] ;
+
+	SYSTEM_ADD_ONS_MEDIA_PLUGINS += [ FFilterByBuildFeatures
+		http_streamer
+		raw_decoder
+	] ;
+
+	SYSTEM_ADD_ONS_PRINT +=
+		Canon\ LIPS3\ Compatible
+		Canon\ LIPS4\ Compatible
+		PCL5\ Compatible
+		PCL6\ Compatible
+		PS\ Compatible
+		Preview
+	;
+
+	SYSTEM_ADD_ONS_PRINT_TRANSPORT +=
+		HP\ JetDirect
+		IPP
+		LPR
+		Print\ To\ File
+		Serial\ Port
+		USB\ Port
+	;
+
+	SYSTEM_ADD_ONS_SCREENSAVERS += [ FFilterByBuildFeatures
+		Butterfly
+		DebugNow
+		Icons
+		IFS
+		Leaves
+		Message
+		Nebula
+		Shelf
+		Spider
+	] ;
+}
diff --git a/src/apps/cortex/Persistence/Wrappers/MediaFormatIO.cpp b/src/apps/cortex/Persistence/Wrappers/MediaFormatIO.cpp
index 381231ed87..4c4e703074 100644
--- a/src/apps/cortex/Persistence/Wrappers/MediaFormatIO.cpp
+++ b/src/apps/cortex/Persistence/Wrappers/MediaFormatIO.cpp
@@ -552,7 +552,7 @@ void export_raw_audio_attr(
 	if(f.channel_count != w.channel_count)
 		context.writeAttr(gKey_channel_count, f.channel_count);
 	if(f.buffer_size != w.buffer_size)
-		context.writeAttr(gKey_buffer_size, f.buffer_size);
+		context.writeAttr(gKey_buffer_size, (uint32)f.buffer_size);
 
 	switch(f.format) {
 		case media_raw_audio_format::B_AUDIO_UCHAR:
@@ -827,7 +827,7 @@ void export_encoded_audio_attr(
 		context.writeAttr(gKey_bit_rate, f.bit_rate);
 
 	if(f.frame_size != w.frame_size)
-		context.writeAttr(gKey_frame_size, f.frame_size);
+		context.writeAttr(gKey_frame_size, (uint32)f.frame_size);
 }
 
 void export_encoded_audio_content(
@@ -863,7 +863,7 @@ void export_encoded_video_attr(
 	if(f.max_bit_rate != w.max_bit_rate)
 		context.writeAttr(gKey_max_bit_rate, f.max_bit_rate);
 	if(f.frame_size != w.frame_size)
-		context.writeAttr(gKey_frame_size, f.frame_size);
+		context.writeAttr(gKey_frame_size, (uint32)f.frame_size);
 	if(f.forward_history != w.forward_history)
 		context.writeAttr(gKey_forward_history, (int32)f.forward_history);
 	if(f.backward_history != w.backward_history)
diff --git a/src/preferences/media/Jamfile b/src/preferences/media/Jamfile
index 79bc24c51b..bb9542faae 100644
--- a/src/preferences/media/Jamfile
+++ b/src/preferences/media/Jamfile
@@ -2,6 +2,16 @@ SubDir HAIKU_TOP src preferences media ;
 
 UsePrivateHeaders media midi shared ;
 
+# libmidi needs fluidlite, which is not available everywhere (e.g. ARM): the
+# MIDI settings view only needs its settings functions then
+local midiSources ;
+local midiLibrary = midi ;
+if ! [ FIsBuildFeatureEnabled fluidlite ] {
+	SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src kits midi ] ;
+	midiSources = MidiSettings.cpp ;
+	midiLibrary = ;
+}
+
 Application Media :
 	Media.cpp
 	MediaIcons.cpp
@@ -9,7 +19,8 @@ Application Media :
 	MediaViews.cpp
 	MediaWindow.cpp
 	MidiSettingsView.cpp
-	: media midi be localestub [ TargetLibsupc++ ]
+	$(midiSources)
+	: media $(midiLibrary) be localestub [ TargetLibsupc++ ]
 	: media.rdef
 	;
 
