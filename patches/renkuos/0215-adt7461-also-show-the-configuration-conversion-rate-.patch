From e599f16f94d40b970df1af3ac6a38eb4bdaf0664 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 24 Oct 2026 23:54:28 +0200
Subject: [PATCH 215/270] adt7461: also show the configuration, conversion rate
 and offset

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../kernel/drivers/sensor/adt7461/adt7461.cpp        | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/add-ons/kernel/drivers/sensor/adt7461/adt7461.cpp b/src/add-ons/kernel/drivers/sensor/adt7461/adt7461.cpp
index dcff7c61a6..508ca15064 100644
--- a/src/add-ons/kernel/drivers/sensor/adt7461/adt7461.cpp
+++ b/src/add-ons/kernel/drivers/sensor/adt7461/adt7461.cpp
@@ -24,7 +24,9 @@
 #define ADT7461_REMOTE_TEMP_HIGH	0x01
 #define ADT7461_STATUS				0x02
 #define ADT7461_CONFIG				0x03
+#define ADT7461_CONVERSION_RATE		0x04
 #define ADT7461_REMOTE_TEMP_LOW		0x10
+#define ADT7461_REMOTE_OFFSET_HIGH	0x11
 #define ADT7461_MANUFACTURER_ID		0xfe
 #define ADT7461_DIE_REVISION		0xff
 
@@ -136,9 +138,15 @@ adt7461_read(void* cookie, off_t position, void* buffer, size_t* _length)
 	format_temperature(localText, sizeof(localText), local);
 	format_temperature(remoteText, sizeof(remoteText), remote);
 
-	char text[128];
+	uint8 config = 0, rate = 0, offset = 0;
+	read_register(ADT7461_CONFIG, &config);
+	read_register(ADT7461_CONVERSION_RATE, &rate);
+	read_register(ADT7461_REMOTE_OFFSET_HIGH, &offset);
+
+	char text[192];
 	size_t textLength = snprintf(text, sizeof(text), "cpu %s C\nboard %s C\n"
-		"status %#04x\n", remoteText, localText, status);
+		"status %#04x config %#04x rate %#04x offset %#04x\n", remoteText,
+		localText, status, config, rate, offset);
 
 	if (position < 0 || (size_t)position >= textLength) {
 		*_length = 0;
