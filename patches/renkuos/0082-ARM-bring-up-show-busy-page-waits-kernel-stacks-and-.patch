From bbeef76631c3b97c96a798a6d2d8913bbb69817c Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 12:33:31 +0200
Subject: [PATCH 082/203] ARM bring-up: show busy page waits, kernel stacks and
 prefetch I/O counts in the thread dump (not for merging)

---
 src/system/kernel/cache/file_cache.cpp | 16 +++++++-
 src/system/kernel/fs/vfs_boot.cpp      | 54 ++++++++++++++++++++++++--
 2 files changed, 65 insertions(+), 5 deletions(-)

diff --git a/src/system/kernel/cache/file_cache.cpp b/src/system/kernel/cache/file_cache.cpp
index c6e2e9a07b..a3c8ad33aa 100644
--- a/src/system/kernel/cache/file_cache.cpp
+++ b/src/system/kernel/cache/file_cache.cpp
@@ -173,13 +173,24 @@ PrecacheIO::Prepare(vm_page_reservation* reservation)
 }
 
 
+// bring-up aid: prefetches started and finished, last start failure
+extern "C" {
+int32 gPrecacheStarted;
+int32 gPrecacheFinished;
+status_t gPrecacheLastError;
+}
+
+
 void
 PrecacheIO::ReadAsync()
 {
 	// This object is going to be deleted after the I/O request has been
 	// fulfilled
-	vfs_asynchronous_read_pages(fRef->vnode, NULL, fOffset, fVecs, fVecCount,
-		fSize, B_PHYSICAL_IO_REQUEST, this);
+	atomic_add(&gPrecacheStarted, 1);
+	status_t status = vfs_asynchronous_read_pages(fRef->vnode, NULL, fOffset,
+		fVecs, fVecCount, fSize, B_PHYSICAL_IO_REQUEST, this);
+	if (status != B_OK)
+		gPrecacheLastError = status;
 }
 
 
@@ -187,6 +198,7 @@ void
 PrecacheIO::IOFinished(status_t status, bool partialTransfer,
 	generic_size_t bytesTransferred)
 {
+	atomic_add(&gPrecacheFinished, 1);
 	fCache->Lock();
 
 	// Make successfully loaded pages accessible again (partially
diff --git a/src/system/kernel/fs/vfs_boot.cpp b/src/system/kernel/fs/vfs_boot.cpp
index 1c9382bb4c..f7b44fa1ef 100644
--- a/src/system/kernel/fs/vfs_boot.cpp
+++ b/src/system/kernel/fs/vfs_boot.cpp
@@ -40,6 +40,8 @@
 #include <thread.h>
 #include <util/ThreadAutoLock.h>
 #include <image.h>
+#include <vm/vm_types.h>
+#include <vm/VMCache.h>
 #include <fcntl.h>
 #include <stdlib.h>
 #include <string.h>
@@ -258,21 +260,28 @@ esp_write_log(esp_log_file* file, char* buffer, size_t size)
 /*!	Bring-up aid: lists the threads of every userland team, with what they
 	wait for and how much CPU time they used, to see which one hangs.
 */
+extern "C" int32 gPrecacheStarted;
+extern "C" int32 gPrecacheFinished;
+extern "C" status_t gPrecacheLastError;
+
+
 static void
 dump_userland_threads()
 {
+	dprintf("AC100: prefetch I/O started %" B_PRId32 ", finished %" B_PRId32
+		", last start error %s\n", gPrecacheStarted, gPrecacheFinished,
+		strerror(gPrecacheLastError));
+
 	TeamListIterator teamIterator;
 	while (Team* team = teamIterator.Next()) {
 		BReference<Team> teamReference(team, true);
-		if (team == team_get_kernel_team())
-			continue;
 
 		bool busy = false;
 		TeamLocker teamLocker(team);
 		dprintf("AC100: team %" B_PRId32 " \"%s\"\n", team->id, team->Args());
 		for (Thread* thread = team->thread_list.Head(); thread != NULL;
 				thread = team->thread_list.GetNext(thread)) {
-			char wait[64] = "";
+			char wait[160] = "";
 			if (thread->state == B_THREAD_WAITING) {
 				switch (thread->wait.type) {
 					case THREAD_BLOCK_TYPE_SEMAPHORE:
@@ -305,6 +314,20 @@ dump_userland_threads()
 					case THREAD_BLOCK_TYPE_USER:
 						strlcpy(wait, "user", sizeof(wait));
 						break;
+					case THREAD_BLOCK_TYPE_OTHER_OBJECT:
+					{
+						// so far only a busy page (VMCache::WaitForPageEvents)
+						vm_page* page = (vm_page*)thread->wait.object;
+						VMCache* cache = page->Cache();
+						snprintf(wait, sizeof(wait), "page %#" B_PRIxPHYSADDR
+							" busy %d io %d state %d cache %p type %d offset %#"
+							B_PRIx64, (phys_addr_t)page->physical_page_number
+								* B_PAGE_SIZE, page->busy, page->busy_io,
+							page->State(), cache,
+							cache != NULL ? (int)cache->type : -1,
+							(uint64)page->cache_offset * B_PAGE_SIZE);
+						break;
+					}
 					default:
 						snprintf(wait, sizeof(wait), "type %" B_PRIu16,
 							thread->wait.type);
@@ -318,6 +341,31 @@ dump_userland_threads()
 				thread->user_time / 1000, thread->kernel_time / 1000,
 				thread->arch_info.lastUserPC, thread->arch_info.lastUserLR,
 				thread->arch_info.lastSyscall);
+			if (thread->state == B_THREAD_WAITING
+				&& thread->wait.type == THREAD_BLOCK_TYPE_OTHER_OBJECT) {
+				// its kernel stack: arm_context_switch() saved r0-r12 and lr,
+				// the frame pointer points at the saved return address
+				char trace[160];
+				size_t length = 0;
+				const uint32* saved = (const uint32*)thread->arch_info.sp;
+				addr_t base = thread->kernel_stack_base;
+				addr_t top = thread->kernel_stack_top;
+				if ((addr_t)saved >= base && (addr_t)saved + 14 * 4 <= top) {
+					uint32 ip = saved[13];
+					addr_t fp = saved[11];
+					for (int32 i = 0; i < 14 && length + 12 < sizeof(trace);
+							i++) {
+						length += snprintf(trace + length,
+							sizeof(trace) - length, " %" B_PRIx32, ip);
+						if (fp < base + 4 || fp + 4 > top)
+							break;
+						ip = *(uint32*)fp;
+						fp = *(uint32*)(fp - 4);
+					}
+				}
+				trace[length] = '\0';
+				dprintf("AC100:     kernel stack%s\n", trace);
+			}
 			const uint32* callers = thread->arch_info.lastCallers;
 			if (thread->state != B_THREAD_WAITING) {
 				dprintf("AC100:     callers %#" B_PRIx32 " %#" B_PRIx32 " %#"
