From a42ca7cae90dbb7385ec8cd96ae290cab29b5fea Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Thu, 29 Oct 2026 23:54:11 +0100
Subject: [PATCH 61/63] sdhci: use DMA for the self-test reference when PIO
 reads disagree

On the Toshiba AC100 eMMC, PIO reads once left a block behind in the
controller, so every PIO read returned the previous one. The self-test,
which took a PIO read as the reference, then rejected every DMA mode,
which worked, and kept PIO: all reads of the device were out of step.
Read the reference twice, and if PIO does not agree with itself, take
it with ADMA2 or SDMA instead.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/busses/mmc/sdhci.cpp | 66 +++++++++++++++++--------
 1 file changed, 45 insertions(+), 21 deletions(-)

diff --git a/src/add-ons/kernel/busses/mmc/sdhci.cpp b/src/add-ons/kernel/busses/mmc/sdhci.cpp
index 8c1059b82c..9ace9e9c1f 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci.cpp
+++ b/src/add-ons/kernel/busses/mmc/sdhci.cpp
@@ -1383,30 +1383,54 @@ SdhciBus::_SelectTransferMode()
 	_ResyncDevice("before the transfer self-test");
 
 	if (reference != NULL) {
-		// A device out of step returns the data of the previous read: read
-		// the reference twice, and resync until both reads agree
+		// The reference is read twice, one block at a time, and both reads
+		// must agree: on the AC100 eMMC, PIO reads once left a block behind
+		// in the controller, so that every PIO read returned the previous
+		// one, and the self-test then rejected the DMA modes, which worked,
+		// in favour of PIO. If PIO does not agree with itself, DMA is used
+		// for the reference instead.
+		static const int kReferenceModes[] = {
+			kDataModePio, kDataModeAdma2, kDataModeSdma
+		};
 		uint8* again = (uint8*)malloc(testLength);
 		status_t status = B_ERROR;
-		for (int attempt = 0; attempt < 4; attempt++) {
-			status = B_OK;
-			for (uint32 i = 0; i < 2 && status == B_OK; i++) {
-				status = _TransferChunk(SD_READ_SINGLE_BLOCK, i * step, 1,
-					kBlockSize, false, kDataModePio, kStopModeSingle, 0,
-					reference + i * kBlockSize, kSelfTestTimeout);
-			}
-			for (uint32 i = 0; i < 2 && status == B_OK && again != NULL;
-					i++) {
-				status = _TransferChunk(SD_READ_SINGLE_BLOCK, i * step, 1,
-					kBlockSize, false, kDataModePio, kStopModeSingle, 0,
-					again + i * kBlockSize, kSelfTestTimeout);
+		for (int mode : kReferenceModes) {
+			if ((mode == kDataModeAdma2 && !canAdma)
+				|| (mode == kDataModeSdma && !canSdma) || again == NULL)
+				continue;
+			for (int attempt = 0; attempt < 2; attempt++) {
+				status = B_OK;
+				for (int pass = 0; pass < 2 && status == B_OK; pass++) {
+					uint8* target = pass == 0 ? reference : again;
+					for (uint32 i = 0; i < 2 && status == B_OK; i++) {
+						if (mode == kDataModePio) {
+							status = _TransferChunk(SD_READ_SINGLE_BLOCK,
+								i * step, 1, kBlockSize, false, kDataModePio,
+								kStopModeSingle, 0, target + i * kBlockSize,
+								kSelfTestTimeout);
+						} else {
+							status = _TransferChunk(SD_READ_SINGLE_BLOCK,
+								i * step, 1, kBlockSize, false, mode,
+								kStopModeSingle, fBouncePhysical, NULL,
+								kSelfTestTimeout);
+							memcpy(target + i * kBlockSize, fBounceBuffer,
+								kBlockSize);
+						}
+					}
+				}
+				if (status == B_OK
+					&& memcmp(again, reference, testLength) == 0)
+					break;
+				ERROR("%s reference reads disagree (attempt %d): %s\n",
+					kDataModeNames[mode], attempt + 1,
+					status == B_OK ? "data out of step" : strerror(status));
+				_ResyncDevice("reference reads disagree");
+				status = B_ERROR;
 			}
-			if (status == B_OK && (again == NULL
-					|| memcmp(again, reference, testLength) == 0))
+			if (status == B_OK) {
+				TRACE_ALWAYS("reference read with %s\n", kDataModeNames[mode]);
 				break;
-			ERROR("reference reads disagree (attempt %d): %s\n", attempt + 1,
-				status == B_OK ? "data out of step" : strerror(status));
-			_ResyncDevice("reference reads disagree");
-			status = B_ERROR;
+			}
 		}
 		free(again);
 		haveReference = status == B_OK;
@@ -1417,7 +1441,7 @@ SdhciBus::_SelectTransferMode()
 				memcmp(reference + kBlockSize, "EFI PART", 8) == 0
 					? ", GPT header" : "");
 		} else {
-			ERROR("reference read (pio, one block at a time) FAILED: "
+			ERROR("no reference read (one block at a time) agreed: "
 				"%s\n", strerror(status));
 		}
 	}
