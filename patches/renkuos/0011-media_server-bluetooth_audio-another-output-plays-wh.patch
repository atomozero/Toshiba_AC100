index a59f0f47a5..33434543d7 100644
--- a/src/servers/media/DefaultManager.cpp
+++ b/src/servers/media/DefaultManager.cpp
@@ -61,6 +61,8 @@ DefaultManager::DefaultManager()
 	fRescanThread(-1),
 	fRescanRequested(0),
 	fRescanLock("rescan default manager"),
+	fUnavailableLock("default manager unavailable outputs"),
+	fUnavailableCount(0),
 	fRoster(NULL)
 {
 	strcpy(fPhysicalAudioOutInputName, "default");
@@ -361,6 +363,45 @@ DefaultManager::Get(media_node_id *nodeid, char *input_name, int32 *inputid,
 
 // this is called by the media_server *after* the initial add-on loading
 // has been done
+void
+DefaultManager::SetOutputAvailable(media_node_id node, bool available)
+{
+	{
+		BAutolock locker(fUnavailableLock);
+		int32 index = -1;
+		for (int32 i = 0; i < fUnavailableCount; i++) {
+			if (fUnavailable[i] == node)
+				index = i;
+		}
+		if (available == (index < 0))
+			return;
+		if (available)
+			fUnavailable[index] = fUnavailable[--fUnavailableCount];
+		else if (fUnavailableCount < kMaxUnavailable)
+			fUnavailable[fUnavailableCount++] = node;
+		else
+			return;
+	}
+	syslog(LOG_NOTICE, "media_server: output node %" B_PRId32 " %s\n", node,
+		available ? "can play again" : "cannot play for now");
+
+	// the rescan thread goes over to a stand-in, or back
+	Rescan();
+}
+
+
+bool
+DefaultManager::_IsUnavailable(media_node_id node)
+{
+	BAutolock locker(fUnavailableLock);
+	for (int32 i = 0; i < fUnavailableCount; i++) {
+		if (fUnavailable[i] == node)
+			return true;
+	}
+	return false;
+}
+
+
 status_t
 DefaultManager::Rescan()
 {
@@ -417,6 +458,23 @@ DefaultManager::_RescanThread()
 			_FindPhysical(&fPhysicalAudioIn, kMsgTypeAudioIn, true,
 				B_MEDIA_RAW_AUDIO);
 
+		// The output cannot play for now: another one stands in, as for
+		// a saved device that is absent, and the preference stays.
+		if (fPhysicalAudioOut != -1 && _IsUnavailable(fPhysicalAudioOut)) {
+			media_node_id standIn = -1;
+			_FindPhysical(&standIn, kMsgTypeAudioOut, false,
+				B_MEDIA_RAW_AUDIO);
+			if (standIn != -1 && standIn != fPhysicalAudioOut
+				&& !_IsUnavailable(standIn)) {
+				syslog(LOG_NOTICE, "media_server: the audio output cannot "
+					"play for now, the mixer goes over to another one\n");
+				fPhysicalAudioOut = standIn;
+				fUsingFallback[_TypeIndex(kMsgTypeAudioOut)] = true;
+				fMixerConnected = false;
+				fTimeSource = -1;
+			}
+		}
+
 		// A default that only stands in for an absent saved device goes
 		// back to that device once it has a node, e.g. a USB sound card
 		// plugged in after the media services started. The mixer is
@@ -578,6 +636,10 @@ DefaultManager::_FindPhysical(volatile media_node_id *id, uint32 default_type,
 					continue;
 			}
 		}
+		// an output that cannot play for now is no candidate
+		if (_IsUnavailable(info[i].node.node))
+			continue;
+
 		if (firstReal < 0)
 			firstReal = i;
 
