@@ -6,6 +6,9 @@
 
 #include "BluetoothAudioNode.h"
 
+#include <Messenger.h>
+#include <ServerInterface.h>
+
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -46,6 +49,9 @@ static const int32 kChunkFrames = 512;
 static const bigtime_t kSilenceSuspends = 30000000;
 // how often the speakers are called while sound waits for them
 static const bigtime_t kCallInterval = 15000000;
+// while the sound plays elsewhere, the speakers are called this often, to
+// take it back when they can be reached again
+static const bigtime_t kRecallInterval = 30000000;
 // how late speakers play, when they do not tell (A2DP delay reporting)
 static const bigtime_t kDefaultOutputDelay = 150000;
 // below this, a sample is silence (16-bit)
@@ -84,6 +90,7 @@ BluetoothAudioNode::BluetoothAudioNode(BluetoothAudioAddOn* addOn,
 	fRealBase(0),
 	fQuitting(false),
 	fOutputDelay(kDefaultOutputDelay),
+	fAvailable(true),
 	fVolume(-1.0f),
 	fVolumeChanged(0),
 	fVolumeDirty(false)
@@ -483,6 +490,25 @@ BluetoothAudioNode::_Drop(int32 keepFrames)
 }
 
 
+/*!	Tells the media server whether the speakers can play: while they
+	cannot, another output stands in for them, and the preference stays.
+*/
+void
+BluetoothAudioNode::_SetAvailable(bool available)
+{
+	if (available == fAvailable)
+		return;
+	fAvailable = available;
+	TRACE("%s: %s\n", fName.String(), available
+		? "the speakers can play again" : "the speakers cannot be reached, "
+			"the sound goes elsewhere meanwhile");
+	BMessage message(MEDIA_SERVER_SET_OUTPUT_AVAILABLE);
+	message.AddInt32("node", ID());
+	message.AddBool("available", available);
+	BMessenger(B_MEDIA_SERVER_SIGNATURE).SendMessage(&message);
+}
+
+
 /*!	When the sound began, after a silence. */
 bigtime_t
 BluetoothAudioNode::_SoundStarted()
@@ -621,23 +647,30 @@ BluetoothAudioNode::_Link()
 
 		if (!source.IsConnected()) {
 			_Drop(backlog);
-			// sound waits: the speakers are called, now and then
-			if (sound && now - calledAt > kCallInterval) {
+			// sound waits: the speakers are called, now and then; while
+			// the sound plays elsewhere, they are called all the same
+			if ((sound && now - calledAt > kCallInterval)
+				|| (!fAvailable && now - calledAt > kRecallInterval)) {
 				calledAt = now;
-				TRACE("%s: sound to play, calling the speakers\n",
-					fName.String());
+				TRACE("%s: %s, calling the speakers\n", fName.String(),
+					sound ? "sound to play" : "to take the sound back");
 				if (source.Connect(fAddress) == B_OK) {
 					TRACE("%s: connected (%" B_PRIu32 " Hz)\n",
 						fName.String(), source.SampleRate());
 					remotePaused = false;
+					_SetAvailable(true);
 					continue;
 				}
+				// out of reach: the sound does not wait for them
+				if (sound)
+					_SetAvailable(false);
 			}
 			// or they connect by themselves
 			bdaddr_t from;
 			if (source.WaitForSink(500000, &from) == B_OK) {
 				TRACE("%s: the speakers connected\n", fName.String());
 				remotePaused = false;
+				_SetAvailable(true);
 			}
 			continue;
 		}
