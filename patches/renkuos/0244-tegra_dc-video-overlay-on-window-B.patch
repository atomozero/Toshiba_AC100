From 9b3ff7cb28df768d22dcbf641f25ee9ed52058cb Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 25 Oct 2026 23:05:07 +0100
Subject: [PATCH 244/270] tegra_dc: video overlay on window B

Physically contiguous, write combining buffers for video frames,
cloned into the caller, and window B programmed to scale them with
its linear filters and convert YCbCr 4:2:2 with BT.601 coefficients.
Window B blends under window A by color key 0, or covers it without
a key, and stays under the cursor on window C.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../private/graphics/tegra_dc/tegra_dc_info.h |  34 ++
 .../drivers/graphics/tegra_dc/tegra_dc.cpp    | 374 +++++++++++++++++-
 2 files changed, 407 insertions(+), 1 deletion(-)

diff --git a/headers/private/graphics/tegra_dc/tegra_dc_info.h b/headers/private/graphics/tegra_dc/tegra_dc_info.h
index f63041e73a..4e78a4b608 100644
--- a/headers/private/graphics/tegra_dc/tegra_dc_info.h
+++ b/headers/private/graphics/tegra_dc/tegra_dc_info.h
@@ -61,6 +61,40 @@ enum {
 		// uint16[2], x and y of the hot spot
 	TEGRA_DC_SHOW_CURSOR,
 		// uint32, 0 hides
+	TEGRA_DC_ALLOCATE_OVERLAY_BUFFER,
+		// tegra_dc_overlay_buffer, size in, area and address out
+	TEGRA_DC_RELEASE_OVERLAY_BUFFER,
+		// area_id
+	TEGRA_DC_CONFIGURE_OVERLAY,
+		// tegra_dc_overlay_config
+};
+
+
+struct tegra_dc_overlay_buffer {
+	uint32			size;			// in
+	area_id			handle;			// the driver's area, to release it
+	area_id			area;			// a cloneable clone in the caller
+	void*			address;		// of that clone
+	uint32			physical;
+};
+
+struct tegra_dc_overlay_config {
+	uint32			enable;
+	area_id			handle;			// of the buffer to show
+	uint32			space;			// B_YCbCr422 or B_RGB32
+	uint32			bytes_per_row;
+	uint16			source_x;		// part of the buffer shown
+	uint16			source_y;
+	uint16			source_width;
+	uint16			source_height;
+	uint16			x;				// where on screen, inside it
+	uint16			y;
+	uint16			width;
+	uint16			height;
+	uint32			filter;			// bit 0 horizontal, bit 1 vertical
+	bool			color_key;		// show where window A has the key
+	uint32			key_lower;		// 0x00RRGGBB
+	uint32			key_upper;
 };
 
 
