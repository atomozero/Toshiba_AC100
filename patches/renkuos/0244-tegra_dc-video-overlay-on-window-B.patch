+#define WINC_H_FILTER_P00			0x601
+#define WINC_CSC_YOF				0x611
+#define WINC_CSC_KYRGB				0x612
+#define WINC_CSC_KUR				0x613
+#define WINC_CSC_KVR				0x614
+#define WINC_CSC_KUG				0x615
+#define WINC_CSC_KVG				0x616
+#define WINC_CSC_KUB				0x617
+#define WINC_CSC_KVB				0x618
+#define WINC_V_FILTER_P00			0x619
+
+#define DC_DISP_COLOR_KEY0_LOWER	0x436
+#define DC_DISP_COLOR_KEY0_UPPER	0x437
+
 #define WIN_OPTIONS					0x700
+#define WIN_BYTE_SWAP				0x701
 #define WIN_COLOR_DEPTH				0x703
 #define WIN_POSITION				0x704
 #define WIN_SIZE					0x705
@@ -142,7 +161,22 @@ extern void* gFDT;
 #define BLEND_CONTROL_ALPHA			(1u << 2)
 #define BLEND_CONTROL_DEPENDENT		(2u << 2)
 
+#define BLEND_CKEY0					1u
+
 #define WIN_OPTIONS_COLOR_EXPAND	(1u << 6)
+#define WIN_OPTIONS_H_FILTER		(1u << 8)
+#define WIN_OPTIONS_V_FILTER		(1u << 10)
+#define WIN_OPTIONS_CSC				(1u << 18)
+
+#define COLOR_DEPTH_YCbCr422		16
+#define BYTE_SWAP_SWAP2				1
+
+// Largest downscaling: the DDA steps are 4.12 fixed point
+#define MAX_H_DDA_2_BYTES			0x8000
+#define MAX_H_DDA_4_BYTES			0x4000
+#define MAX_V_DDA					0xf000
+
+#define MAX_OVERLAY_BUFFERS			16
 #define WIN_OPTIONS_ENABLE			(1u << 30)
 
 #define COLOR_DEPTH_B5G6R5			6
@@ -178,6 +212,15 @@ struct tegra_dc_device {
 	uint16				cursor_height;
 	uint16				cursor_hot_x;
 	uint16				cursor_hot_y;
