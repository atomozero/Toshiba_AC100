From bb84d765d5154944a4bdb37953a6f09548a8b88c Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 25 Oct 2026 22:46:05 +0100
Subject: [PATCH 243/270] tegra_dc: select windows through the window header
 register

The per window register apertures Linux uses (0xa00, 0xc00, 0xe00) are
not separate windows on the AC100: they all reach the window that
DC_CMD_DISPLAY_WINDOW_HEADER selects, window A as the firmware left it.
Programming the cursor through window C's aperture reprogrammed window A
into a small square showing the cursor image.

Select the window in the header and use the documented register offsets,
leaving window A selected. A mode change now also sets window A's
position, size and scaling again.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../drivers/graphics/tegra_dc/tegra_dc.cpp    | 135 ++++++++++--------
 .../misc/tegra_dc_diag/tegra_dc_diag.cpp      |  10 +-
 2 files changed, 77 insertions(+), 68 deletions(-)

diff --git a/src/add-ons/kernel/drivers/graphics/tegra_dc/tegra_dc.cpp b/src/add-ons/kernel/drivers/graphics/tegra_dc/tegra_dc.cpp
index 9b1513fcdc..750ccfed0d 100644
--- a/src/add-ons/kernel/drivers/graphics/tegra_dc/tegra_dc.cpp
+++ b/src/add-ons/kernel/drivers/graphics/tegra_dc/tegra_dc.cpp
@@ -105,41 +105,35 @@ extern void* gFDT;
 #define STATE_WIN_A_UPDATE			(1u << 9)
 #define STATE_WIN_C_UPDATE			(1u << 11)
 
-// Window A, through its own register aperture (as Linux addresses the
-// windows, which avoids the window header register; checked on the AC100)
-#define WIN_A_BASE					0xa00
-#define WIN_OPTIONS					(WIN_A_BASE + 0x180 + 0x00)
-#define WIN_COLOR_DEPTH				(WIN_A_BASE + 0x180 + 0x03)
-#define WIN_SIZE					(WIN_A_BASE + 0x180 + 0x05)
-#define WIN_PRESCALED_SIZE			(WIN_A_BASE + 0x180 + 0x06)
-#define WIN_LINE_STRIDE				(WIN_A_BASE + 0x180 + 0x0a)
-#define WINBUF_START_ADDR			(WIN_A_BASE + 0x1c0 + 0x00)
-#define WINBUF_ADDR_H_OFFSET		(WIN_A_BASE + 0x1c0 + 0x06)
-#define WINBUF_ADDR_V_OFFSET		(WIN_A_BASE + 0x1c0 + 0x08)
-
-// Window registers relative to a window's own WIN and WINBUF blocks
-#define WIN_C_BASE					0xe00
-#define WIN_REG(base, reg)			((base) + 0x180 + (reg))
-#define WINBUF_REG(base, reg)		((base) + 0x1c0 + (reg))
-#define REG_OPTIONS					0x00
-#define REG_COLOR_DEPTH				0x03
-#define REG_POSITION				0x04
-#define REG_SIZE					0x05
-#define REG_PRESCALED_SIZE			0x06
-#define REG_H_INITIAL_DDA			0x07
-#define REG_V_INITIAL_DDA			0x08
-#define REG_DDA_INCREMENT			0x09
-#define REG_LINE_STRIDE				0x0a
-#define REG_BUF_STRIDE				0x0b
-#define REG_BUFFER_ADDR_MODE		0x0d
-#define REG_BLEND_NOKEY				0x0f
-#define REG_BLEND_1WIN				0x10
-#define REG_BLEND_2WIN_X			0x11	// A: with B, C: with A
-#define REG_BLEND_2WIN_Y			0x12	// A: with C, C: with B
-#define REG_BLEND_3WIN				0x13
-#define REG_START_ADDR				0x00
-#define REG_ADDR_H_OFFSET			0x06
-#define REG_ADDR_V_OFFSET			0x08
+// The window registers (TRM 29.10 - 29.15) are those of the window that
+// DC_CMD_DISPLAY_WINDOW_HEADER selects. The per window apertures Linux uses
+// (0xa00, 0xc00, 0xe00) are not separate windows on the AC100: they all
+// reach the selected one.
+#define DC_CMD_DISPLAY_WINDOW_HEADER	0x042
+#define WINDOW_A_SELECT				(1u << 4)
+#define WINDOW_C_SELECT				(1u << 6)
+
+#define WIN_OPTIONS					0x700
+#define WIN_COLOR_DEPTH				0x703
+#define WIN_POSITION				0x704
+#define WIN_SIZE					0x705
+#define WIN_PRESCALED_SIZE			0x706
+#define WIN_H_INITIAL_DDA			0x707
+#define WIN_V_INITIAL_DDA			0x708
+#define WIN_DDA_INCREMENT			0x709
+#define WIN_LINE_STRIDE				0x70a
+#define WIN_BUF_STRIDE				0x70b
+#define WIN_BUFFER_ADDR_MODE		0x70d
+#define WIN_BLEND_NOKEY				0x70f
+#define WIN_BLEND_1WIN				0x710
+#define WIN_BLEND_2WIN_X			0x711	// A: with B, C: with A
+#define WIN_BLEND_2WIN_Y			0x712	// A: with C, C: with B
+#define WIN_BLEND_3WIN				0x713
+#define WINBUF_START_ADDR			0x800
+#define WINBUF_ADDR_H_OFFSET		0x806
+#define WINBUF_ADDR_V_OFFSET		0x808
+
+#define DDA_INCREMENT_1_TO_1		0x10001000
 
 // Blend control (TRM 29.10.18 - 29.10.21)
 #define BLEND_WEIGHT1(x)			((uint32)(x) << 16)
@@ -207,6 +201,16 @@ write_dc(uint32 word, uint32 value)
 }
 
 
+/*!	Selects the window whose registers the window register offsets reach.
+	Window A stays selected otherwise, as the firmware left it.
+*/
+static inline void
+select_window(uint32 select)
+{
+	write_dc(DC_CMD_DISPLAY_WINDOW_HEADER, select);
+}
+
+
 static volatile uint32*
 map_registers(const char* name, phys_addr_t base, size_t size, area_id* _area)
 {
@@ -317,6 +321,7 @@ program_display_mode(const display_mode& mode)
 	// Start from a black screen: app_server draws everything again
 	memset(sDevice.scanout, 0, bytesPerRow * PANEL_HEIGHT);
 
+	select_window(WINDOW_A_SELECT);
 	uint32 options = read_dc(WIN_OPTIONS) | WIN_OPTIONS_ENABLE;
 	if (bytesPerPixel == 2)
 		options |= WIN_OPTIONS_COLOR_EXPAND;
@@ -325,7 +330,12 @@ program_display_mode(const display_mode& mode)
 
 	write_dc(WIN_COLOR_DEPTH, colorDepth);
 	write_dc(WIN_OPTIONS, options);
+	write_dc(WIN_POSITION, 0);
+	write_dc(WIN_SIZE, (PANEL_HEIGHT << 16) | PANEL_WIDTH);
 	write_dc(WIN_PRESCALED_SIZE, (PANEL_HEIGHT << 16) | bytesPerRow);
+	write_dc(WIN_H_INITIAL_DDA, 0);
+	write_dc(WIN_V_INITIAL_DDA, 0);
+	write_dc(WIN_DDA_INCREMENT, DDA_INCREMENT_1_TO_1);
 	write_dc(WIN_LINE_STRIDE, bytesPerRow);
 	write_dc(WINBUF_START_ADDR, SCANOUT_BASE);
 	write_dc(WINBUF_ADDR_H_OFFSET, 0);
@@ -431,30 +441,30 @@ set_screen_power(uint32 mode)
 static void
 setup_cursor_window()
 {
-	const uint32 c = WIN_C_BASE;
-	write_dc(WIN_REG(c, REG_OPTIONS), 0);
-	write_dc(WIN_REG(c, REG_COLOR_DEPTH), COLOR_DEPTH_B8G8R8A8);
-	write_dc(WIN_REG(c, REG_H_INITIAL_DDA), 0);
-	write_dc(WIN_REG(c, REG_V_INITIAL_DDA), 0);
-	write_dc(WIN_REG(c, REG_DDA_INCREMENT), 0x10001000);
-	write_dc(WIN_REG(c, REG_LINE_STRIDE), CURSOR_BYTES_PER_ROW);
-	write_dc(WIN_REG(c, REG_BUF_STRIDE), 0);
-	write_dc(WIN_REG(c, REG_BUFFER_ADDR_MODE), 0);
-	write_dc(WINBUF_REG(c, REG_START_ADDR), SCANOUT_BASE + CURSOR_OFFSET);
+	select_window(WINDOW_C_SELECT);
+	write_dc(WIN_OPTIONS, 0);
+	write_dc(WIN_COLOR_DEPTH, COLOR_DEPTH_B8G8R8A8);
+	write_dc(WIN_H_INITIAL_DDA, 0);
+	write_dc(WIN_V_INITIAL_DDA, 0);
+	write_dc(WIN_DDA_INCREMENT, DDA_INCREMENT_1_TO_1);
+	write_dc(WIN_LINE_STRIDE, CURSOR_BYTES_PER_ROW);
+	write_dc(WIN_BUF_STRIDE, 0);
+	write_dc(WIN_BUFFER_ADDR_MODE, 0);
+	write_dc(WINBUF_START_ADDR, SCANOUT_BASE + CURSOR_OFFSET);
 
 	// Window C by the alpha of its pixels, wherever it is
 	const uint32 alpha = BLEND_CONTROL_ALPHA | BLEND_WEIGHT1(255)
 		| BLEND_WEIGHT0(255);
-	write_dc(WIN_REG(c, REG_BLEND_NOKEY), BLEND_WEIGHT1(255)
-		| BLEND_WEIGHT0(255));
-	write_dc(WIN_REG(c, REG_BLEND_1WIN), alpha);
-	write_dc(WIN_REG(c, REG_BLEND_2WIN_X), alpha);
-	write_dc(WIN_REG(c, REG_BLEND_2WIN_Y), alpha);
-	write_dc(WIN_REG(c, REG_BLEND_3WIN), alpha);
+	write_dc(WIN_BLEND_NOKEY, BLEND_WEIGHT1(255) | BLEND_WEIGHT0(255));
+	write_dc(WIN_BLEND_1WIN, alpha);
+	write_dc(WIN_BLEND_2WIN_X, alpha);
+	write_dc(WIN_BLEND_2WIN_Y, alpha);
+	write_dc(WIN_BLEND_3WIN, alpha);
 
 	// Window A takes what window C leaves
-	write_dc(WIN_REG(WIN_A_BASE, REG_BLEND_2WIN_Y), BLEND_CONTROL_DEPENDENT);
-	write_dc(WIN_REG(WIN_A_BASE, REG_BLEND_3WIN), BLEND_CONTROL_DEPENDENT);
+	select_window(WINDOW_A_SELECT);
+	write_dc(WIN_BLEND_2WIN_Y, BLEND_CONTROL_DEPENDENT);
+	write_dc(WIN_BLEND_3WIN, BLEND_CONTROL_DEPENDENT);
 
 	// High priority memory requests for window C too, as U-Boot set them for
 	// window A
@@ -482,7 +492,6 @@ setup_cursor_window()
 static void
 update_cursor_window()
 {
-	const uint32 c = WIN_C_BASE;
 	int32 left = sDevice.cursor_x - sDevice.cursor_hot_x;
 	int32 top = sDevice.cursor_y - sDevice.cursor_hot_y;
 	int32 right = left + sDevice.cursor_width;
@@ -497,18 +506,20 @@ update_cursor_window()
 	left += skipX;
 	top += skipY;
 
+	select_window(WINDOW_C_SELECT);
 	if (!sDevice.cursor_shown || right <= left || bottom <= top) {
-		write_dc(WIN_REG(c, REG_OPTIONS), 0);
+		write_dc(WIN_OPTIONS, 0);
 	} else {
 		uint32 width = right - left;
 		uint32 height = bottom - top;
-		write_dc(WIN_REG(c, REG_POSITION), (top << 16) | left);
-		write_dc(WIN_REG(c, REG_SIZE), (height << 16) | width);
-		write_dc(WIN_REG(c, REG_PRESCALED_SIZE), (height << 16) | (width * 4));
-		write_dc(WINBUF_REG(c, REG_ADDR_H_OFFSET), skipX * 4);
-		write_dc(WINBUF_REG(c, REG_ADDR_V_OFFSET), skipY);
-		write_dc(WIN_REG(c, REG_OPTIONS), WIN_OPTIONS_ENABLE);
+		write_dc(WIN_POSITION, (top << 16) | left);
+		write_dc(WIN_SIZE, (height << 16) | width);
+		write_dc(WIN_PRESCALED_SIZE, (height << 16) | (width * 4));
+		write_dc(WINBUF_ADDR_H_OFFSET, skipX * 4);
+		write_dc(WINBUF_ADDR_V_OFFSET, skipY);
+		write_dc(WIN_OPTIONS, WIN_OPTIONS_ENABLE);
 	}
+	select_window(WINDOW_A_SELECT);
 
 	write_dc(DC_CMD_STATE_CONTROL, STATE_WIN_C_UPDATE);
 	read_dc(DC_CMD_STATE_CONTROL);
@@ -669,6 +680,7 @@ init_device()
 	}
 
 	// The mode the firmware left
+	select_window(WINDOW_A_SELECT);
 	bool depth32 = read_dc(WIN_COLOR_DEPTH) == COLOR_DEPTH_B8G8R8A8;
 	fill_mode(info.current_mode, depth32 ? B_RGB32 : B_RGB16);
 	info.bytes_per_row = read_dc(WIN_LINE_STRIDE) & 0xffff;
@@ -922,6 +934,7 @@ init_hardware(void)
 		TEGRA20_DC_A_BASE, TEGRA20_DC_SIZE, &dcArea);
 	if (dc == NULL)
 		return B_ERROR;
+	dc[DC_CMD_DISPLAY_WINDOW_HEADER] = WINDOW_A_SELECT;
 	uint32 options = dc[WIN_OPTIONS];
 	uint32 start = dc[WINBUF_START_ADDR];
 	uint32 size = dc[WIN_SIZE];
diff --git a/src/add-ons/kernel/drivers/misc/tegra_dc_diag/tegra_dc_diag.cpp b/src/add-ons/kernel/drivers/misc/tegra_dc_diag/tegra_dc_diag.cpp
index 3e3f390488..018cbcfa22 100644
--- a/src/add-ons/kernel/drivers/misc/tegra_dc_diag/tegra_dc_diag.cpp
+++ b/src/add-ons/kernel/drivers/misc/tegra_dc_diag/tegra_dc_diag.cpp
@@ -276,14 +276,10 @@ report_dc(char* buffer, size_t size, size_t length, const char* name,
 			kDcRegisters[i].name, dc[kDcRegisters[i].word]);
 	}
 
-	// The window the header selects, through the documented registers
+	// The window the header selects. The per window apertures Linux uses
+	// (0xa00, 0xc00, 0xe00) all reach the selected window on the AC100, and
+	// selecting another one would change state: only this one is shown.
 	length = report_window(buffer, size, length, dc, 'h', 0x700, 0x800);
-	// Each window through its own aperture, as Linux addresses them
-	for (int i = 0; i < 3; i++) {
-		uint32 windowBase = 0xa00 + 0x200 * i;
-		length = report_window(buffer, size, length, dc, 'A' + i,
-			windowBase + 0x180, windowBase + 0x1c0);
-	}
 
 	delete_area(area);
 	return length;
