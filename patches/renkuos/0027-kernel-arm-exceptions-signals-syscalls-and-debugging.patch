  * Authors:
@@ -11,11 +11,100 @@
 
 #include "arch_debug_support.h"
 
+
+/*!	Code built without frame pointers leaves no chain of frames to follow, so
+	the stack is scanned instead: a frame is reported for every word on it
+	that points just behind a call instruction (BL or BLX). That may also
+	report stale return addresses, but it does not depend on how the code
+	was compiled.
+*/
+
+
+static const int32 kMaxScanWords = 2048;
+static const int32 kChunkWords = 64;
+static const int32 kMaxCodeAreas = 128;
+
+
+struct code_areas {
+	int32	count;
+	addr_t	start[kMaxCodeAreas];
+	addr_t	end[kMaxCodeAreas];
+
+	void Init(team_id team)
+	{
+		count = 0;
+		area_info info;
+		ssize_t cookie = 0;
+		while (count < kMaxCodeAreas
+			&& get_next_area_info(team, &cookie, &info) == B_OK) {
+			if ((info.protection & B_EXECUTE_AREA) == 0)
+				continue;
+			start[count] = (addr_t)info.address;
+			end[count] = (addr_t)info.address + info.size;
+			count++;
+		}
+	}
+
+	bool Contains(addr_t address) const
+	{
+		for (int32 i = 0; i < count; i++) {
+			if (address >= start[i] && address < end[i])
+				return true;
+		}
+		return false;
+	}
+};
+
+
+static bool
+is_call_instruction(uint32 instruction)
+{
+	// BL <label> (any condition but "never")
+	if ((instruction & 0x0f000000) == 0x0b000000
+		&& (instruction & 0xf0000000) != 0xf0000000) {
+		return true;
+	}
+	// BLX <label>
+	if ((instruction & 0xfe000000) == 0xfa000000)
+		return true;
+	// BLX <register>
+	if ((instruction & 0x0ffffff0) == 0x012fff30)
+		return true;
+
+	return false;
+}
+
+
+static bool
+is_return_address(debug_context *context, const code_areas& areas,
+	uint32 address)
+{
+	if ((address & 3) != 0 || !areas.Contains(address - 4))
+		return false;
+
+	uint32 instruction;
+	if (debug_read_memory(context, (const void*)(address - 4), &instruction,
+			sizeof(instruction)) != sizeof(instruction)) {
+		return false;
+	}
+
+	return is_call_instruction(instruction);
+}
+
+
 status_t
 arch_debug_get_instruction_pointer(debug_context *context, thread_id thread,
 	void **ip, void **stackFrameAddress)
 {
-	return B_ERROR;
+	debug_cpu_state cpuState;
+	status_t error = debug_get_cpu_state(context, thread, NULL, &cpuState);
+	if (error != B_OK)
+		return error;
+
+	*ip = (void*)cpuState.r15;
+	*stackFrameAddress = (void*)cpuState.r13;
+
+	return B_OK;
 }
 
 
@@ -23,5 +112,36 @@ status_t
 arch_debug_get_stack_frame(debug_context *context, void *stackFrameAddress,
 	debug_stack_frame_info *stackFrameInfo)
 {
-	return B_ERROR;
+	uint32* address = (uint32*)stackFrameAddress;
+	if (address == NULL || ((addr_t)address & 3) != 0)
+		return B_BAD_VALUE;
+
+	// only look at what could point into code
+	code_areas areas;
+	areas.Init(context->team);
+
+	for (int32 scanned = 0; scanned < kMaxScanWords;
+			scanned += kChunkWords) {
+		uint32 words[kChunkWords];
+		ssize_t bytesRead = debug_read_memory(context, address + scanned,
+			words, sizeof(words));
+		if (bytesRead < (ssize_t)sizeof(uint32))
+			return bytesRead < 0 ? bytesRead : B_ERROR;
+
+		int32 count = bytesRead / sizeof(uint32);
+		for (int32 i = 0; i < count; i++) {
+			if (!is_return_address(context, areas, words[i]))
+				continue;
+
+			stackFrameInfo->frame = address + scanned + i;
+			stackFrameInfo->parent_frame = address + scanned + i + 1;
+			stackFrameInfo->return_address = (void*)words[i];
+			return B_OK;
+		}
+
+		if (count < kChunkWords)
+			break;
+	}
+
+	return B_ENTRY_NOT_FOUND;
 }
diff --git a/src/system/kernel/arch/arm/arch_asm.S b/src/system/kernel/arch/arm/arch_asm.S
index e93a1c258a..b540fef868 100644
--- a/src/system/kernel/arch/arm/arch_asm.S
+++ b/src/system/kernel/arch/arm/arch_asm.S
@@ -69,16 +69,27 @@ FUNCTION(arm_context_switch):
 	stmfd   sp!, { r0-r12, lr }
 	str	sp, [r0]
 	ldr	sp, [r1]
+	/* drop any exclusive access of the previous thread (ldrex/strex) */
+	clrex
 	ldmfd   sp!, { r0-r12, lr }
 	bx	lr
 FUNCTION_END(arm_context_switch)
 
 
+/* d16-d31 are only touched when gARMHasVFPD32 is set, see arch_cpu.cpp */
+.fpu vfpv3
+
 /* void arm_save_fpu(struct arch_fpu_context* context); */
 FUNCTION(arm_save_fpu):
 	fstmiad		r0!, {d0-d15}
+	ldr			r1, =gARMHasVFPD32
+	ldrb		r1, [r1]
+	cmp			r1, #0
+	beq			1f
 	fstmiad		r0!, {d16-d31}
-	vmrs		r1, fpscr
+	b			2f
+1:	add			r0, r0, #128		/* keep fpscr at its fixed offset */
+2:	vmrs		r1, fpscr
 	str			r1, [r0]
 	bx			lr
 FUNCTION_END(arm_save_fpu)
@@ -87,8 +98,14 @@ FUNCTION_END(arm_save_fpu)
 /* void arm_restore_fpu(struct arch_fpu_context* context); */
 FUNCTION(arm_restore_fpu):
 	fldmiad		r0!, {d0-d15}
+	ldr			r1, =gARMHasVFPD32
+	ldrb		r1, [r1]
+	cmp			r1, #0
+	beq			1f
 	fldmiad		r0!, {d16-d31}
-	ldr			r1, [r0]
+	b			2f
+1:	add			r0, r0, #128		/* keep fpscr at its fixed offset */
+2:	ldr			r1, [r0]
 	vmsr		fpscr, r1
 	bx			lr
 FUNCTION_END(arm_restore_fpu)
@@ -250,7 +267,7 @@ FUNCTION(arch_return_to_userland):
 	mrs		ip, cpsr
 	bic		ip, ip, #(CPSR_MODE_MASK | CPSR_T | CPSR_F | CPSR_I)
 	orr		ip, ip, #(CPSR_MODE_USR | CPSR_F)
-	msr		spsr, ip
+	msr		spsr_fsxc, ip
 
 	// use system mode to load user mode SP and LR
 	ldr		r4, [r0, #IFRAME_usr_sp]
@@ -268,10 +285,16 @@ FUNCTION(arch_return_to_userland):
 	// load user mode entry point in LR
 	ldr		lr, [r0, #IFRAME_pc]
 
-	// load general purpose registers
-	mov		sp, r0
-	add		sp, sp, #4
-	ldmfd	sp!, { r0-r12 }
+	// The next exception from userland starts on the SVC stack: reset it to
+	// the top of the thread's kernel stack. The frame may sit deep inside it
+	// (exec(), fork()), and that whole call chain is dead from here on;
+	// leaving SP there leaks it on every exec() until the stack overflows.
+	mrc		p15, 0, ip, c13, c0, 4		// TPIDRPRW: current Thread*
+	ldr		sp, [ip, #THREAD_kernel_stack_top]
+
+	// load general purpose registers (base in the list, no writeback)
+	add		r0, r0, #4
+	ldmia	r0, { r0-r12 }
 
 	// jump to user mode entry point
 	movs	pc, lr
diff --git a/src/system/kernel/arch/arm/arch_atomic32.cpp b/src/system/kernel/arch/arm/arch_atomic32.cpp
index 12038f7506..01b45107ac 100644
--- a/src/system/kernel/arch/arm/arch_atomic32.cpp
+++ b/src/system/kernel/arch/arm/arch_atomic32.cpp
@@ -15,6 +15,62 @@
 
 #ifdef ATOMIC_FUNCS_ARE_SYSCALLS
 
+#if defined(__ARM_ARCH) && __ARM_ARCH >= 7
+
+/*
+ * ARMv7 has exclusive load/store instructions, so these do not need to disable
+ * interrupts. That matters: user_mutex.cpp runs them on user memory inside
+ * user_access(), and a page fault (e.g. on a copy-on-write page after fork())
+ * taken with interrupts disabled cannot be resolved and would make the operation
+ * fail (user_access() returns false).
+ */
+
+void
+atomic_set(int32 *value, int32 newValue)
+{
+	__atomic_store_n(value, newValue, __ATOMIC_SEQ_CST);
+}
+
+int32
+atomic_get_and_set(int32 *value, int32 newValue)
+{
+	return __atomic_exchange_n(value, newValue, __ATOMIC_SEQ_CST);
+}
+
+int32
+atomic_test_and_set(int32 *value, int32 newValue, int32 testAgainst)
+{
+	__atomic_compare_exchange_n(value, &testAgainst, newValue, false,
+		__ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+	return testAgainst;
+}
+
+int32
+atomic_add(int32 *value, int32 addValue)
+{
+	return __atomic_fetch_add(value, addValue, __ATOMIC_SEQ_CST);
+}
+
+int32
+atomic_and(int32 *value, int32 andValue)
+{
+	return __atomic_fetch_and(value, andValue, __ATOMIC_SEQ_CST);
+}
+
+int32
+atomic_or(int32 *value, int32 orValue)
+{
+	return __atomic_fetch_or(value, orValue, __ATOMIC_SEQ_CST);
+}
+
+int32
+atomic_get(int32 *value)
+{
+	return __atomic_load_n(value, __ATOMIC_SEQ_CST);
+}
+
+#else	// __ARM_ARCH < 7
+
 /*
  * NOTE: These functions are _intentionally_ not using spinlocks, unlike
  * the 64 bit versions. The reason for this is that they are used by the
@@ -90,6 +146,8 @@ atomic_get(int32 *value)
 	return oldValue;
 }
 
+#endif	// __ARM_ARCH < 7
+
 void
 _user_atomic_set(int32 *value, int32 newValue)
 {
diff --git a/src/system/kernel/arch/arm/arch_exceptions.S b/src/system/kernel/arch/arm/arch_exceptions.S
index 2ee1347613..5a9474f648 100644
--- a/src/system/kernel/arch/arm/arch_exceptions.S
+++ b/src/system/kernel/arch/arm/arch_exceptions.S
@@ -18,6 +18,28 @@
 	msr		cpsr_c, r0
 .endm
 
+/* Calls \handler with the iframe, around it saves and restores the VFP
+   registers: the kernel uses them too (the compiler does for 64 bit
+   copies), and an exception may interrupt code using them at any point.
+   The saved registers are right below the iframe, aligned down to 8 bytes
+   like the stack the handler is called with, see
+   arm_exception_fpu_context(). */
+#define EXCEPTION_FPU_AREA_SIZE	264		/* sizeof(arch_fpu_context) */
+.macro CALL_HANDLER_SAVING_VFP handler
+	mov		r4, sp						/* iframe */
+	sub		sp, sp, #EXCEPTION_FPU_AREA_SIZE
+	bic		sp, sp, #7					/* the AAPCS wants 8 byte alignment */
+	mov		r0, sp
+	bl		arm_save_fpu
+	mov		r0, r4
+	mov		fp, r0
+	bl		\handler
+	DISABLE_INTERRUPTS
+	mov		r0, sp
+	bl		arm_restore_fpu
+	mov		sp, r4
+.endm
+
 /* The following two macros are taken from FreeBSD... */
 
 .macro PUSH_FRAME_IN_SVC
@@ -33,7 +55,7 @@
 	str		r0, [sp, #-4]!				/* Push return address */
 	str		lr, [sp, #-4]!				/* Push SVC lr */
 	str		r2, [sp, #-4]!				/* Push SVC sp */
-	msr		spsr, r3					/* Restore correct spsr */
+	msr		spsr_fsxc, r3				/* Restore correct spsr */
 	ldmdb	r1, {r0-r3}					/* Restore 4 regs from xxx mode */
 	sub		sp, sp, #(4*15)				/* Adjust the stack pointer */
 	stmia	sp, {r0-r12}				/* Push the user mode registers */
@@ -46,7 +68,7 @@
 
 .macro PULL_FRAME_FROM_SVC_AND_EXIT
 	ldr		r0, [sp], #0x0004			/* Get the SPSR from stack */
-	msr		spsr, r0					/* restore SPSR */
+	msr		spsr_fsxc, r0				/* restore SPSR */
 	ldmia	sp, {r0-r14}^				/* Restore registers (usr mode) */
 	mov		r0, r0						/* NOP for previous instruction */
 	add		sp, sp, #(4*15)				/* Adjust the stack pointer */
@@ -70,7 +92,7 @@
 
 .macro	PULL_FRAME_AND_EXIT
 	ldr		r0, [sp], #4				/* Get SPSR from stack */
-	msr		spsr, r0
+	msr		spsr_fsxc, r0
 	ldmia	sp, {r0-r14}^				/* Restore user mode registers */
 	add		sp, sp, #(4*17)				/* Adjust the stack pointer */
 	ldr		lr, [sp], #4				/* Pull the return address */
@@ -121,48 +143,22 @@ _vectors_end:
 
 .data
 
-	.rept	64
-	.word	0xdeadbeef
-	.endr
-
-abort_stack:
