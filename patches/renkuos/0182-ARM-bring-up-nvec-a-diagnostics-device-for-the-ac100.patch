From 40e000ba36943bff62f6f3f7cc80015b03743c5d Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Fri, 23 Oct 2026 17:13:15 +0200
Subject: [PATCH 182/270] ARM bring-up: nvec: a diagnostics device for the
 ac100ec tool (not for merging)

/dev/misc/nvec_diag sends one request to the EC and returns the reply
with the same type and sub-command, so the EC can be examined from
userland.
---
 src/add-ons/kernel/busses/i2c/nvec/nvec.cpp | 83 +++++++++++++++++++++
 1 file changed, 83 insertions(+)

diff --git a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
index 6ed551b88d..6d7b6717d0 100644
--- a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
+++ b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
@@ -206,6 +206,13 @@ struct nvec_device {
 	thread_id			txThread;
 	volatile bool		stopping;
 
+	// bring-up: one request at a time from the ac100ec tool, and its reply
+	mutex				diagLock;
+	sem_id				diagSem;
+	volatile int32		diagClass;	// -1 when no request is waiting
+	volatile int32		diagSubCommand;
+	nvec_msg			diagReply;
+
 	// keyboard
 	spinlock			keyLock;
 	raw_key_info		keys[NVEC_KEY_COUNT];
@@ -265,6 +272,20 @@ enum nvec_device_kind {
 	NVEC_MOUSE,
 	NVEC_BATTERY,
 	NVEC_POWER_BUTTON,
+	NVEC_DIAG,
+};
+
+
+// Bring-up: /dev/misc/nvec_diag passes requests to the EC and returns its
+// reply (the ac100ec tool uses it)
+#define NVEC_DIAG_PATH				"misc/nvec_diag"
+#define NVEC_DIAG_REQUEST			0x4e563130	// 'NV10'
+
+struct nvec_diag_request {
+	uint8	size;				// of request, starting with the type
+	uint8	request[NVEC_MSG_SIZE - 1];
+	uint8	replySize;			// of reply, the type and count included
+	uint8	reply[NVEC_MSG_SIZE];
 };
 
 
@@ -1130,6 +1151,15 @@ rx_thread(void* data)
 			dump_message(is_event(&message) ? "event" : "reply", &message);
 		}
 
+		if (!is_event(&message) && device->diagClass >= 0
+			&& (message.data[0] & 0x8f) == device->diagClass
+			&& message.size >= 3
+			&& message.data[2] == device->diagSubCommand) {
+			device->diagReply = message;
+			device->diagClass = -1;
+			release_sem(device->diagSem);
+		}
+
 		switch (message.data[0] & 0x8f) {
 			case NVEC_KB_EVT:
 				device->keyEvents++;
@@ -1281,6 +1311,8 @@ nvec_open(void* cookie, const char* path, int openMode, void** _cookie)
 		handle->kind = NVEC_MOUSE;
 	else if (strstr(path, "button") != NULL)
 		handle->kind = NVEC_POWER_BUTTON;
+	else if (strcmp(path, NVEC_DIAG_PATH) == 0)
+		handle->kind = NVEC_DIAG;
 	else
 		handle->kind = NVEC_BATTERY;
 	*_cookie = handle;
@@ -1435,6 +1467,41 @@ read_movement(nvec_device* device, void* buffer)
 
 
 /*!	Looks like an ACPI battery to PowerStatus. */
+/*!	Sends one request to the EC and waits for the reply with the same type
+	and sub-command.
+*/
+static status_t
+diag_request(nvec_device* device, void* buffer, size_t length)
+{
+	nvec_diag_request request;
+	if (length < sizeof(request) || !IS_USER_ADDRESS(buffer)
+		|| user_memcpy(&request, buffer, sizeof(request)) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+	if (request.size < 2 || request.size > sizeof(request.request))
+		return B_BAD_VALUE;
+
+	MutexLocker locker(device->diagLock);
+	while (acquire_sem_etc(device->diagSem, 1, B_RELATIVE_TIMEOUT, 0) == B_OK)
+		;
+	device->diagSubCommand = request.request[1];
+	device->diagClass = request.request[0];
+
+	status_t status = nvec_write(device, request.request, request.size);
+	if (status == B_OK) {
+		status = acquire_sem_etc(device->diagSem, 1, B_RELATIVE_TIMEOUT,
+			1000000);
+	}
+	device->diagClass = -1;
+	if (status != B_OK)
+		return status;
+
+	request.replySize = min_c(device->diagReply.size, sizeof(request.reply));
+	memcpy(request.reply, device->diagReply.data, request.replySize);
+	return user_memcpy(buffer, &request, sizeof(request));
+}
+
+
 static status_t
 battery_control(nvec_device* device, uint32 op, void* buffer)
 {
@@ -1507,6 +1574,12 @@ nvec_control(void* cookie, uint32 op, void* buffer, size_t length)
 	if (handle->kind == NVEC_BATTERY)
 		return battery_control(device, op, buffer);
 
+	if (handle->kind == NVEC_DIAG) {
+		if (op != NVEC_DIAG_REQUEST)
+			return B_DEV_INVALID_IOCTL;
+		return diag_request(device, buffer, length);
+	}
+
 	if (handle->kind == NVEC_KEYBOARD) {
 		switch (op) {
 			case KB_READ:
@@ -1651,6 +1724,9 @@ nvec_init_driver(device_node* node, void** _cookie)
 	device->mouseLock = B_SPINLOCK_INITIALIZER;
 	device->batteryLock = B_SPINLOCK_INITIALIZER;
 	mutex_init(&device->powerButtonLock, "nvec power button");
+	mutex_init(&device->diagLock, "nvec diag");
+	device->diagSem = -1;
+	device->diagClass = -1;
 	device->registersArea = device->gpioArea = device->pwmArea = -1;
 	device->rxSem = device->txSem = device->transferSem = device->keySem
 		= device->mouseSem = -1;
@@ -1698,6 +1774,7 @@ nvec_init_driver(device_node* node, void** _cookie)
 	device->transferSem = create_sem(0, "nvec transfer");
 	device->keySem = create_sem(0, "nvec keys");
 	device->mouseSem = create_sem(0, "nvec movements");
+	device->diagSem = create_sem(0, "nvec diag");
 	if (device->rxSem < B_OK || device->txSem < B_OK
 		|| device->transferSem < B_OK || device->keySem < B_OK
 		|| device->mouseSem < B_OK) {
@@ -1737,6 +1814,8 @@ nvec_init_driver(device_node* node, void** _cookie)
 err:
 	TRACE_ALWAYS("init failed: %s\n", strerror(status));
 	mutex_destroy(&device->powerButtonLock);
+	mutex_destroy(&device->diagLock);
+	delete_sem(device->diagSem);
 	delete_sem(device->rxSem);
 	delete_sem(device->txSem);
 	delete_sem(device->transferSem);
@@ -1796,6 +1875,10 @@ nvec_register_child_devices(void* cookie)
 		status = gDeviceManager->publish_device(device->node,
 			"power/button/power_nvec", NVEC_DEVICE_MODULE_NAME);
 	}
+	if (status == B_OK) {
+		gDeviceManager->publish_device(device->node, NVEC_DIAG_PATH,
+			NVEC_DEVICE_MODULE_NAME);
+	}
 	return status;
 }
 
