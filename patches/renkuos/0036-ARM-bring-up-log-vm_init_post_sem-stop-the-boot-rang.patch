From 36f8970644c7a39ad40f0158ad99036657367cd7 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 19:05:39 +0200
Subject: [PATCH 036/270] ARM bring-up: log vm_init_post_sem, stop the boot
 range unmapping from wrapping around

---
 src/system/kernel/arch/arm/arch_vm.cpp | 5 +++++
 src/system/kernel/vm/vm.cpp            | 6 ++++++
 src/system/kernel/vm/vm_init.cpp       | 7 ++++++-
 3 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/src/system/kernel/arch/arm/arch_vm.cpp b/src/system/kernel/arch/arm/arch_vm.cpp
index 5c20dfcf3e..9f19bb4c71 100644
--- a/src/system/kernel/arch/arm/arch_vm.cpp
+++ b/src/system/kernel/arch/arm/arch_vm.cpp
@@ -73,6 +73,8 @@ arch_vm_init_end(kernel_args *args)
 			continue;
 		}
 
+		dprintf("AC100: keep range %d: %#" B_PRIxADDR ", size %#" B_PRIxSIZE
+			"\n", i, (addr_t)range.start, (size_t)range.size);
 		phys_addr_t physicalAddress;
 		void *address = (void*)range.start;
 		if (vm_get_page_mapping(VMAddressSpace::KernelID(), range.start,
@@ -85,6 +87,7 @@ arch_vm_init_end(kernel_args *args)
 			B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
 			physicalAddress, true);
 
+		dprintf("AC100:   -> area %" B_PRId32 "\n", area);
 		if (area < 0) {
 			panic("arch_vm_init_end(): Failed to create area for boot loader "
 				"reserved area: %p - %p\n", (void*)range.start,
@@ -93,7 +96,9 @@ arch_vm_init_end(kernel_args *args)
 	}
 
 	// Throw away all mappings that are unused by the kernel
+	dprintf("AC100: vm_free_unused_boot_loader_range\n");
 	vm_free_unused_boot_loader_range(KERNEL_LOAD_BASE, KERNEL_SIZE);
+	dprintf("AC100: vm_free_unused_boot_loader_range done\n");
 	arm_boot_marker(12);
 
 	return B_OK;
diff --git a/src/system/kernel/vm/vm.cpp b/src/system/kernel/vm/vm.cpp
index 23b55f4fe5..a42274e19c 100644
--- a/src/system/kernel/vm/vm.cpp
+++ b/src/system/kernel/vm/vm.cpp
@@ -3684,8 +3684,11 @@ vm_init_post_sem(kernel_args* args)
 {
 	// This frees all unused boot loader resources and makes its space available
 	// again
+	dprintf("AC100: arch_vm_init_end\n");
 	arch_vm_init_end(args);
+	dprintf("AC100: unreserve_boot_loader_ranges\n");
 	unreserve_boot_loader_ranges(args);
+	dprintf("AC100: arch_vm_translation_map_init_post_sem\n");
 
 	// fill in all of the semaphores that were not allocated before
 	// since we're still single threaded and only the kernel address space
@@ -3693,8 +3696,11 @@ vm_init_post_sem(kernel_args* args)
 
 	arch_vm_translation_map_init_post_sem(args);
 
+	dprintf("AC100: slab_init_post_sem\n");
 	slab_init_post_sem();
+	dprintf("AC100: heap_init_post_sem\n");
 	heap_init_post_sem();
+	dprintf("AC100: vm_init_post_sem done\n");
 
 	return B_OK;
 }
diff --git a/src/system/kernel/vm/vm_init.cpp b/src/system/kernel/vm/vm_init.cpp
index d319f9eff7..4976e52321 100644
--- a/src/system/kernel/vm/vm_init.cpp
+++ b/src/system/kernel/vm/vm_init.cpp
@@ -34,7 +34,10 @@ unmap_and_free_physical_pages(VMTranslationMap* map, addr_t start, addr_t end)
 	// free all physical pages in the specified range
 
 	vm_page_reservation reservation = {};
-	for (addr_t current = start; current < end; current += B_PAGE_SIZE) {
+	// current may wrap around to 0 when the range ends at the top of the
+	// address space, as the kernel address space does on 32 bit ARM
+	for (addr_t current = start; current >= start && current < end;
+			current += B_PAGE_SIZE) {
 		phys_addr_t physicalAddress;
 		uint32 flags;
 
@@ -105,6 +108,8 @@ vm_free_unused_boot_loader_range(addr_t start, addr_t size)
 		lastEnd = areaEnd + 1;
 	}
 
+	dprintf("AC100: free unused boot range: last end %#" B_PRIxADDR ", end %#"
+		B_PRIxADDR "\n", lastEnd, end);
 	if (lastEnd < end) {
 		// we can also get rid of some space at the end of the area
 		TRACE(("free boot range: also remove %p - %p\n", (void*)lastEnd,
