From 69e4a6ec0889fd4ce8a2a16e3c43971071f87ac2 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 19:46:00 +0200
Subject: [PATCH 109/203] efi/arm: switch the AC100 wireless module on without
 an rfkill node

U-Boot passes its own device tree of the Toshiba AC100, which has no rfkill
node: drive the GPIOs of Linux' one then (reset PD1, shutdown PK5).
---
 src/system/boot/platform/efi/arch/arm/arch_dtb.cpp | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp b/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
index 936b1a7589..d7009721ee 100644
--- a/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
+++ b/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
@@ -65,6 +65,7 @@ static struct {
 	bool activeLow;
 } sRadioGPIOs[4];
 static uint32 sRadioGPIOCount;
+static bool sIsAC100;
 
 
 /*!	The TWD runs at PERIPHCLK, whose rate the device tree usually doesn't
@@ -172,6 +173,11 @@ arch_handle_fdt(const void* fdt, int node)
 		&& dtb_has_fdt_string(compatible, compatibleLen, "nvidia,tegra20-gpio")) {
 		dtb_get_reg(fdt, node, 0, sTegraGPIORegs);
 	}
+	// U-Boot's own device tree of the Toshiba AC100 has no rfkill node: use
+	// the GPIOs of Linux' one (reset PD1, shutdown PK5, both active high)
+	if (dtb_has_fdt_string(compatible, compatibleLen, "compal,paz00"))
+		sIsAC100 = true;
+
 	// the wireless module stays in reset and powered down until its reset
 	// and shutdown GPIOs are driven active (cells: controller, pin, flags)
 	if (dtb_has_fdt_string(compatible, compatibleLen, "rfkill-gpio")) {
@@ -332,6 +338,14 @@ enable_radio_gpios(void)
 	if (sTegraGPIORegs.start == 0)
 		return;
 
+	if (sRadioGPIOCount == 0 && sIsAC100) {
+		sRadioGPIOs[0].pin = 25;
+		sRadioGPIOs[0].activeLow = false;
+		sRadioGPIOs[1].pin = 85;
+		sRadioGPIOs[1].activeLow = false;
+		sRadioGPIOCount = 2;
+	}
+
 	for (uint32 i = 0; i < sRadioGPIOCount; i++) {
 		uint32 pin = sRadioGPIOs[i].pin;
 		// 32 GPIOs per bank, 8 per port; the masked registers at 0x800 take
