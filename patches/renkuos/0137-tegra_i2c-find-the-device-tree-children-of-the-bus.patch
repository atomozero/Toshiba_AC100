From 1a041da0e80363e9f6490595a0003273986ba677 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 19 Oct 2026 19:44:38 +0200
Subject: [PATCH 137/270] tegra_i2c: find the device tree children of the bus

get_next_child_node() matches nothing without attributes, so the devices
on the bus, like the audio codec of the AC100, were never registered.
---
 src/add-ons/kernel/busses/i2c/tegra/tegra_i2c.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/add-ons/kernel/busses/i2c/tegra/tegra_i2c.cpp b/src/add-ons/kernel/busses/i2c/tegra/tegra_i2c.cpp
index 15f56842b3..717e15c187 100644
--- a/src/add-ons/kernel/busses/i2c/tegra/tegra_i2c.cpp
+++ b/src/add-ons/kernel/busses/i2c/tegra/tegra_i2c.cpp
@@ -312,8 +312,13 @@ tegra_i2c_scan_bus(i2c_bus_cookie cookie)
 	if (fdtNode == NULL)
 		return B_ERROR;
 
+	// only the device tree nodes, not this driver's own node
+	const device_attr fdtChildren[] = {
+		{ B_DEVICE_BUS, B_STRING_TYPE, { .string = "fdt" }},
+		{}
+	};
 	device_node* child = NULL;
-	while (gDeviceManager->get_next_child_node(fdtNode, NULL, &child)
+	while (gDeviceManager->get_next_child_node(fdtNode, fdtChildren, &child)
 			== B_OK) {
 		const char* name;
 		const char* compatible;
