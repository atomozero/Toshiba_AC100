From 893afe6e8784d1a40d596910b980c206b319a61a Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 15:20:49 +0200
Subject: [PATCH 096/270] kernel/arm: fix syscall arguments and signal handling
 on return to userland

- Copy the syscall arguments past the fourth from the user stack with
  interrupts enabled: the page may have to be faulted in (copy on write
  after a fork(), access flag); with interrupts disabled the copy failed and
  the syscall (e.g. read(), whose buffer and size are on the stack) returned
  an error without being executed.
- Do the kernel exit work on every return to userland: new threads and
  fork()ed children entered userland without handling the signals sent
  before, so the SIGNAL_CONTINUE_THREAD of resume_thread() stayed pending and
  interrupted the first blocking call of the thread (Terminal's pty reader
  quit at once). Interrupts and page faults from userland now handle pending
  signals too, so they reach threads running in userland.
---
 src/system/kernel/arch/arm/arch_int.cpp    | 94 +++++++++++++++-------
 src/system/kernel/arch/arm/arch_thread.cpp |  9 ++-
 2 files changed, 71 insertions(+), 32 deletions(-)

diff --git a/src/system/kernel/arch/arm/arch_int.cpp b/src/system/kernel/arch/arm/arch_int.cpp
index 574aa2c6c5..082f1f0fda 100644
--- a/src/system/kernel/arch/arm/arch_int.cpp
+++ b/src/system/kernel/arch/arm/arch_int.cpp
@@ -237,6 +237,25 @@ static struct arm_exception_record* arm_log_exception(uint32 type,
 	uint32 fsr, uint32 far, struct iframe* frame);
 
 
+/*!	The kernel exit work before returning to userland: handles the pending
+	signals, setting up their frames on \a iframe.
+	Interrupts must be disabled; they still are on return.
+*/
+extern "C" void
+arm_kernel_exit_to_userland(Thread* thread, struct iframe* iframe)
+{
+	thread->arch_info.userFrame = iframe;
+	if ((thread->flags & (THREAD_FLAGS_SIGNALS_PENDING
+			| THREAD_FLAGS_DEBUG_THREAD
+			| THREAD_FLAGS_TRAP_FOR_CORE_DUMP)) != 0) {
+		enable_interrupts();
+		thread_at_kernel_exit();
+	} else
+		thread_at_kernel_exit_no_signals();
+	thread->arch_info.userFrame = NULL;
+}
+
+
 extern "C" void
 arch_arm_undefined(struct iframe *iframe)
 {
@@ -259,15 +278,7 @@ arch_arm_undefined(struct iframe *iframe)
 		send_signal_to_thread(thread, signal, 0);
 
 		disable_interrupts();
-		if ((thread->flags & (THREAD_FLAGS_SIGNALS_PENDING
-				| THREAD_FLAGS_DEBUG_THREAD
-				| THREAD_FLAGS_TRAP_FOR_CORE_DUMP)) != 0) {
-			enable_interrupts();
-			thread_at_kernel_exit();
-		} else
-			thread_at_kernel_exit_no_signals();
-
-		thread->arch_info.userFrame = NULL;
+		arm_kernel_exit_to_userland(thread, iframe);
 		return;
 	}
 
@@ -291,25 +302,6 @@ arch_arm_syscall(struct iframe *iframe)
 	uint32_t syscall = *(uint32_t *)(iframe->pc-4) & 0x00ffffff;
 	TRACE("syscall number: %d\n", syscall);
 
-	uint32_t args[20];
-	if (syscall < kSyscallCount) {
-		TRACE("syscall(%s,%d)\n",
-			kExtendedSyscallInfos[syscall].name,
-			kExtendedSyscallInfos[syscall].parameter_count);
-
-		int argSize = kSyscallInfos[syscall].parameter_size;
-		memcpy(args, &iframe->r0, std::min<int>(argSize, 4 * sizeof(uint32)));
-		if (argSize > 4 * sizeof(uint32)) {
-			status_t res = user_memcpy(&args[4], (void *)iframe->usr_sp,
-				(argSize - 4 * sizeof(uint32)));
-			if (res < B_OK) {
-				dprintf("can't read syscall arguments on user stack\n");
-				iframe->r0 = res;
-				return;
-			}
-		}
-	}
-
 	thread_get_current_thread()->arch_info.userFrame = iframe;
 	thread_get_current_thread()->arch_info.oldR0 = iframe->r0;
 	thread_get_current_thread()->arch_info.oldR1 = iframe->r1;
@@ -340,8 +332,29 @@ arch_arm_syscall(struct iframe *iframe)
 		}
 	}
 
-	uint64 returnValue = 0;
-	syscall_dispatcher(syscall, (void*)args, &returnValue);
+	// The arguments past the fourth are on the user stack: copy them with
+	// interrupts enabled, since its page may need to be faulted in (after a
+	// fork(), or to set the access flag).
+	uint32_t args[20];
+	status_t argsStatus = B_OK;
+	if (syscall < kSyscallCount) {
+		TRACE("syscall(%s,%d)\n",
+			kExtendedSyscallInfos[syscall].name,
+			kExtendedSyscallInfos[syscall].parameter_count);
+
+		int argSize = kSyscallInfos[syscall].parameter_size;
+		memcpy(args, &iframe->r0, std::min<int>(argSize, 4 * sizeof(uint32)));
+		if (argSize > 4 * sizeof(uint32)) {
+			argsStatus = user_memcpy(&args[4], (void *)iframe->usr_sp,
+				(argSize - 4 * sizeof(uint32)));
+			if (argsStatus < B_OK)
+				dprintf("can't read syscall arguments on user stack\n");
+		}
+	}
+
+	uint64 returnValue = (uint64)(int64)argsStatus;
+	if (argsStatus == B_OK)
+		syscall_dispatcher(syscall, (void*)args, &returnValue);
 
 	TRACE("returning %" B_PRId64 "\n", returnValue);
 	// 64 bit results (system_time(), seek(), ...) come back in r0:r1
@@ -625,6 +638,9 @@ arch_arm_page_fault(struct iframe *frame, addr_t far, uint32 fsr, bool isWrite,
 		thread->arch_info.lastUserPC = frame->pc;
 		thread->arch_info.lastUserLR = frame->usr_lr;
 		thread->arch_info.lastFaultStatus = fsr;
+
+		thread->arch_info.userFrame = frame;
+		thread_at_kernel_entry(system_time());
 	}
 
 	enable_interrupts();
@@ -636,6 +652,12 @@ arch_arm_page_fault(struct iframe *frame, addr_t far, uint32 fsr, bool isWrite,
 		// IP the cpu will return to to be this ip
 		frame->pc = newip;
 	}
+
+	if (isUser) {
+		// e.g. deliver the SIGSEGV of an unresolved fault right away
+		disable_interrupts();
+		arm_kernel_exit_to_userland(thread, frame);
+	}
 }
 
 
@@ -666,10 +688,13 @@ arch_arm_irq(struct iframe *iframe)
 	arm_log_exception(3, 0, 0, iframe);
 	IFrameScope scope(iframe);
 
-	if ((iframe->spsr & CPSR_MODE_MASK) == CPSR_MODE_USR) {
+	bool fromUser = (iframe->spsr & CPSR_MODE_MASK) == CPSR_MODE_USR;
+	if (fromUser) {
 		Thread* current = thread_get_current_thread();
 		current->arch_info.lastUserPC = iframe->pc;
 		current->arch_info.lastUserLR = iframe->usr_lr;
+		current->arch_info.userFrame = iframe;
+		thread_at_kernel_entry(system_time());
 	}
 
 	InterruptController *ic = InterruptController::Get();
@@ -693,6 +718,13 @@ arch_arm_irq(struct iframe *iframe)
 		scheduler_reschedule(B_THREAD_READY);
 		schedulerLocker.Unlock();
 		restore_interrupts(state);
+	} else
+		restore_interrupts(state);
+
+	if (fromUser) {
+		// signals sent to a thread running in userland are handled here
+		disable_interrupts();
+		arm_kernel_exit_to_userland(thread_get_current_thread(), iframe);
 	}
 }
 
diff --git a/src/system/kernel/arch/arm/arch_thread.cpp b/src/system/kernel/arch/arm/arch_thread.cpp
index ab6963796f..4a6c12632d 100644
--- a/src/system/kernel/arch/arm/arch_thread.cpp
+++ b/src/system/kernel/arch/arm/arch_thread.cpp
@@ -31,6 +31,10 @@
 #include "ARMPagingStructures.h"
 #include "ARMVMTranslationMap.h"
 
+
+extern "C" void arm_kernel_exit_to_userland(Thread* thread, iframe* frame);
+
+
 //#define TRACE_ARCH_THREAD
 #ifdef TRACE_ARCH_THREAD
 #	define TRACE(x...) dprintf(x)
@@ -228,7 +232,9 @@ arch_thread_enter_userspace(Thread *thread, addr_t entry,
 	frame.usr_lr = threadExitAddress;
 	frame.pc = entry;
 
-	// return to userland
+	// handle the signals sent before the thread started (like the
+	// SIGNAL_CONTINUE_THREAD of resume_thread()), then return to userland
+	arm_kernel_exit_to_userland(thread, &frame);
 	arch_return_to_userland(&frame);
 
 	// normally we don't get here
@@ -401,5 +407,6 @@ void
 arch_restore_fork_frame(struct arch_fork_arg *arg)
 {
 	disable_interrupts();
+	arm_kernel_exit_to_userland(thread_get_current_thread(), &arg->frame);
 	arch_return_to_userland(&arg->frame);
 }
