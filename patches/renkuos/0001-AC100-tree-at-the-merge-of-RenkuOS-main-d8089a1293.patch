+int32
+SDPClient::ServiceClasses(uint16* classes, int32 max)
+{
+	int32 count = 0;
+	BMessage attrListMsg;
+	for (int i = 0; fRemoteDevice->services.FindMessage("service", i,
+			&attrListMsg) == B_OK; i++) {
+		const void* data;
+		ssize_t size;
+		if (attrListMsg.FindData("0x0001", B_RAW_TYPE, &data, &size) != B_OK)
+			continue;
+
+		BMallocIO attrListDataIO;
+		attrListDataIO.Write(data, size);
+		attrListDataIO.Seek(0, SEEK_SET);
+		SDPDataIO attrList(&attrListDataIO);
+		while (count < max) {
+			sdp_uuid uuid = attrList.ReadUUID();
+			if (attrList.ReadingStatus() != B_OK)
+				break;
+			if (uuid.type != SDP_UUID_16)
+				continue;
+			uint16 serviceClass = GET_UUID16(uuid);
+			bool known = false;
+			for (int32 j = 0; j < count; j++)
+				known = known || classes[j] == serviceClass;
+			if (!known)
+				classes[count++] = serviceClass;
+		}
+	}
+	return count;
+}
