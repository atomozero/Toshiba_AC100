+ */
+
+
+/*!	Scripting of the Bluetooth server, for hey and the like:
+
+	count Device, get Device <index|name|address>, delete Device <…>
+		the paired devices; delete forgets one
+	get Connected
+		the names of the connected devices
+	get Discoverable, set Discoverable to <bool>
+		whether the other devices find this computer when they look
+	do Scan
+		looks for devices for about ten seconds and lists them
+	do Pair <index|name|address>
+		pairs a device found by the last scan
+	do Connect <…>, do Disconnect <…>
+		connects or disconnects a paired device
+
+	Looking for, pairing and connecting devices go through the Bluetooth kit,
+	which talks to this server: they run in threads of their own, and the
+	reply comes when they are done.
+*/
+
+
+#include "BluetoothServer.h"
+
+#include <Autolock.h>
+#include <Locker.h>
+#include <PropertyInfo.h>
+#include <String.h>
+
+#include <bluetooth/bdaddrUtils.h>
+#include <bluetooth/DiscoveryAgent.h>
+#include <bluetooth/DiscoveryListener.h>
+#include <bluetooth/LocalDevice.h>
+#include <bluetooth/RemoteDevice.h>
+#include <bluetooth/bluetooth_error.h>
+
+#include "Debug.h"
+#include "HIDProfile.h"
+
+
+using Bluetooth::DiscoveryAgent;
+using Bluetooth::DiscoveryListener;
+using Bluetooth::LocalDevice;
+using Bluetooth::RemoteDevice;
+
+
+static property_info sProperties[] = {
+	{ "Device", { B_COUNT_PROPERTIES, 0 }, { B_DIRECT_SPECIFIER, 0 },
+		"Returns the count of paired devices.", 0, { B_INT32_TYPE } },
+	{ "Device", { B_GET_PROPERTY, 0 },
+		{ B_INDEX_SPECIFIER, B_NAME_SPECIFIER, 0 },
+		"Returns the name, address, kind, state and battery of a paired "
+		"device, by index, name or address.", 0, { B_MESSAGE_TYPE } },
+	{ "Device", { B_DELETE_PROPERTY, 0 },
+		{ B_INDEX_SPECIFIER, B_NAME_SPECIFIER, 0 },
+		"Disconnects and forgets a paired device.", 0, {} },
+	{ "Connected", { B_GET_PROPERTY, 0 }, { B_DIRECT_SPECIFIER, 0 },
+		"Returns the names of the connected devices.", 0, { B_STRING_TYPE } },
+	{ "Discoverable", { B_GET_PROPERTY, B_SET_PROPERTY, 0 },
+		{ B_DIRECT_SPECIFIER, 0 },
+		"Gets or sets whether other devices find this computer.", 0,
+		{ B_BOOL_TYPE } },
+	{ "Scan", { B_EXECUTE_PROPERTY, 0 }, { B_DIRECT_SPECIFIER, 0 },
+		"Looks for devices for about ten seconds and lists them.", 0,
