+// A2DP Audio Sink (A2DP 1.3, 5.3): a phone plays through this computer
+const uint8 kSinkHandle[] = { 0x0a, 0x00, 0x01, 0x00, 0x01 };
+const uint8 kSinkClasses[] = { 0x35, 0x03, 0x19, 0x11, 0x0b };
+const uint8 kSinkFeatures[] = { 0x09, 0x00, 0x02 };	// speaker
+const Attribute kSinkAttributes[] = {
+	ATTRIBUTE(0x0000, kSinkHandle),
+	ATTRIBUTE(0x0001, kSinkClasses),
+	ATTRIBUTE(0x0004, kSourceProtocols),
+	ATTRIBUTE(0x0005, kSourceBrowseGroups),
+	ATTRIBUTE(0x0009, kSourceProfiles),
+	ATTRIBUTE(0x0311, kSinkFeatures)
+};
+const uint16 kSinkUuids[] = { 0x110b, 0x0100, 0x0019, 0x1002, 0x110d };
+
+// AVRCP 1.6 Target: the phone sets our volume (absolute volume)
+const uint8 kRemoteHandle[] = { 0x0a, 0x00, 0x01, 0x00, 0x02 };
+const uint8 kRemoteTargetClasses[] = { 0x35, 0x03, 0x19, 0x11, 0x0c };
+const uint8 kRemoteProtocols[] = { 0x35, 0x10,
+	0x35, 0x06, 0x19, 0x01, 0x00, 0x09, 0x00, 0x17,	// L2CAP, PSM AVCTP
+	0x35, 0x06, 0x19, 0x00, 0x17, 0x09, 0x01, 0x04 };	// AVCTP 1.4
+const uint8 kRemoteProfiles[] = { 0x35, 0x08,
+	0x35, 0x06, 0x19, 0x11, 0x0e, 0x09, 0x01, 0x06 };	// AVRCP 1.6
+const uint8 kRemoteTargetFeatures[] = { 0x09, 0x00, 0x02 };	// amplifier
+const Attribute kRemoteTargetAttributes[] = {
+	ATTRIBUTE(0x0000, kRemoteHandle),
+	ATTRIBUTE(0x0001, kRemoteTargetClasses),
+	ATTRIBUTE(0x0004, kRemoteProtocols),
+	ATTRIBUTE(0x0005, kSourceBrowseGroups),
+	ATTRIBUTE(0x0009, kRemoteProfiles),
+	ATTRIBUTE(0x0311, kRemoteTargetFeatures)
+};
+const uint16 kRemoteTargetUuids[] = { 0x110c, 0x0100, 0x0017, 0x1002,
+	0x110e };
+
+// AVRCP 1.6 Controller: play, pause and the tracks of the phone
+const uint8 kRemoteControllerHandle[] = { 0x0a, 0x00, 0x01, 0x00, 0x03 };
+const uint8 kRemoteControllerClasses[] = { 0x35, 0x06, 0x19, 0x11, 0x0e,
+	0x19, 0x11, 0x0f };
+const uint8 kRemoteControllerFeatures[] = { 0x09, 0x00, 0x01 };	// player
+const Attribute kRemoteControllerAttributes[] = {
+	ATTRIBUTE(0x0000, kRemoteControllerHandle),
+	ATTRIBUTE(0x0001, kRemoteControllerClasses),
+	ATTRIBUTE(0x0004, kRemoteProtocols),
+	ATTRIBUTE(0x0005, kSourceBrowseGroups),
+	ATTRIBUTE(0x0009, kRemoteProfiles),
+	ATTRIBUTE(0x0311, kRemoteControllerFeatures)
+};
+const uint16 kRemoteControllerUuids[] = { 0x110e, 0x110f, 0x0100, 0x0017,
+	0x1002 };
+
+const Record kRecords[] = {
+	{ 0x00000000, kServerAttributes, B_COUNT_OF(kServerAttributes),
+		kServerUuids, B_COUNT_OF(kServerUuids) },
+	{ 0x00010000, kSourceAttributes, B_COUNT_OF(kSourceAttributes),
+		kSourceUuids, B_COUNT_OF(kSourceUuids) },
+	{ 0x00010001, kSinkAttributes, B_COUNT_OF(kSinkAttributes),
+		kSinkUuids, B_COUNT_OF(kSinkUuids) },
+	{ 0x00010002, kRemoteTargetAttributes,
+		B_COUNT_OF(kRemoteTargetAttributes), kRemoteTargetUuids,
+		B_COUNT_OF(kRemoteTargetUuids) },
+	{ 0x00010003, kRemoteControllerAttributes,
+		B_COUNT_OF(kRemoteControllerAttributes), kRemoteControllerUuids,
+		B_COUNT_OF(kRemoteControllerUuids) }
+};
+
+
+const uint8 kBaseUuid[12] = { 0x00, 0x00, 0x10, 0x00, 0x80, 0x00, 0x00,
+	0x80, 0x5f, 0x9b, 0x34, 0xfb };
+
+
+struct Buffer {
+	uint8	data[2048];
+	size_t	length;
+	bool	overflow;
+
+	Buffer() : length(0), overflow(false) {}
+
+	void Put(const void* bytes, size_t size)
+	{
+		if (length + size > sizeof(data)) {
+			overflow = true;
+			return;
+		}
+		memcpy(data + length, bytes, size);
+		length += size;
+	}
+	void Put8(uint8 value) { Put(&value, 1); }
+	void Put16(uint16 value)
+	{
+		uint8 bytes[2] = { (uint8)(value >> 8), (uint8)value };
+		Put(bytes, 2);
+	}
+	void Put32(uint32 value)
+	{
+		uint8 bytes[4] = { (uint8)(value >> 24), (uint8)(value >> 16),
+			(uint8)(value >> 8), (uint8)value };
+		Put(bytes, 4);
+	}
+	// a data element sequence header for a body of \a size bytes
+	void PutSequence(size_t size)
+	{
+		if (size < 256) {
+			Put8(0x35);
+			Put8((uint8)size);
+		} else {
+			Put8(0x36);
+			Put16((uint16)size);
+		}
+	}
+};
+
+
+uint16
+Read16(const uint8* data)
+{
+	return data[0] << 8 | data[1];
+}
+
+
+uint32
+Read32(const uint8* data)
+{
+	return (uint32)data[0] << 24 | data[1] << 16 | data[2] << 8 | data[3];
+}
+
+
+/*!	The data element at \a data: its type descriptor, where its body
+	starts, and its size. False if it does not fit in \a length.
+*/
+bool
+ReadElement(const uint8* data, size_t length, uint8& type, size_t& header,
+	size_t& size)
+{
+	if (length < 1)
+		return false;
+	type = data[0] >> 3;
+	uint8 sizeIndex = data[0] & 0x07;
+	header = 1;
+	switch (sizeIndex) {
+		case 0: size = type == 0 ? 0 : 1; break;
+		case 1: size = 2; break;
+		case 2: size = 4; break;
+		case 3: size = 8; break;
+		case 4: size = 16; break;
+		case 5:
+			if (length < 2)
+				return false;
+			size = data[1];
+			header = 2;
+			break;
+		case 6:
+			if (length < 3)
+				return false;
+			size = Read16(data + 1);
+			header = 3;
+			break;
+		default:
+			if (length < 5)
+				return false;
+			size = Read32(data + 1);
+			header = 5;
+			break;
+	}
+	return header + size <= length;
+}
+
+
+/*!	A UUID of the request, as a 16 or 32 bit one when it is in the
+	Bluetooth range: false for any other 128 bit one, which no record holds.
+*/
+bool
+ReadUuid(const uint8* data, size_t size, uint32& uuid)
+{
+	if (size == 2) {
+		uuid = Read16(data);
+		return true;
+	}
+	if (size == 4) {
+		uuid = Read32(data);
+		return true;
+	}
+	if (size == 16 && memcmp(data + 4, kBaseUuid, sizeof(kBaseUuid)) == 0) {
+		uuid = Read32(data);
+		return true;
+	}
+	return false;
+}
+
+
+/*!	The records holding all the UUIDs of a search pattern, a sequence of
+	UUIDs. Returns the size of the pattern element, 0 if it is wrong.
+*/
+size_t
+FindRecords(const uint8* data, size_t length, const Record** found,
+	int32& foundCount)
+{
+	uint8 type;
+	size_t header, size;
+	if (!ReadElement(data, length, type, header, size) || type != 6)
+		return 0;
+
+	uint32 uuids[12];
+	int32 uuidCount = 0;
+	bool unknown = false;
+	for (size_t offset = header; offset < header + size;) {
+		uint8 elementType;
+		size_t elementHeader, elementSize;
+		if (!ReadElement(data + offset, header + size - offset, elementType,
+				elementHeader, elementSize) || elementType != 3)
+			return 0;
+		uint32 uuid;
+		if (!ReadUuid(data + offset + elementHeader, elementSize, uuid))
+			unknown = true;
+		else if (uuidCount < 12)
+			uuids[uuidCount++] = uuid;
+		offset += elementHeader + elementSize;
+	}
+	if (uuidCount == 0 && !unknown)
+		return 0;
+
+	foundCount = 0;
+	for (size_t i = 0; !unknown && i < B_COUNT_OF(kRecords); i++) {
+		bool all = true;
+		for (int32 j = 0; all && j < uuidCount; j++) {
+			bool has = false;
+			for (int32 k = 0; k < kRecords[i].uuidCount; k++) {
+				if (kRecords[i].uuids[k] == uuids[j])
+					has = true;
+			}
+			all = has;
+		}
+		if (all)
+			found[foundCount++] = &kRecords[i];
+	}
+	return header + size;
+}
+
+
+/*!	The attribute identifier list of a request: identifiers and ranges.
+	Returns the size of the element, 0 if it is wrong.
+*/
+size_t
+ReadAttributeRanges(const uint8* data, size_t length, uint32* ranges,
+	int32& rangeCount)
+{
+	uint8 type;
+	size_t header, size;
+	if (!ReadElement(data, length, type, header, size) || type != 6)
+		return 0;
+
+	rangeCount = 0;
+	for (size_t offset = header; offset < header + size;) {
+		uint8 elementType;
+		size_t elementHeader, elementSize;
+		if (!ReadElement(data + offset, header + size - offset, elementType,
+				elementHeader, elementSize) || elementType != 1)
+			return 0;
+		const uint8* value = data + offset + elementHeader;
+		uint32 range;
+		if (elementSize == 2)
+			range = (uint32)Read16(value) << 16 | Read16(value);
+		else if (elementSize == 4)
+			range = Read32(value);
+		else
+			return 0;
+		if (rangeCount < 16)
+			ranges[rangeCount++] = range;
+		offset += elementHeader + elementSize;
+	}
+	return rangeCount > 0 ? header + size : 0;
+}
+
+
+void
+PutAttributes(Buffer& buffer, const Record& record, const uint32* ranges,
+	int32 rangeCount)
+{
+	size_t size = 0;
+	for (int pass = 0; pass < 2; pass++) {
+		if (pass == 1)
+			buffer.PutSequence(size);
+		for (int32 i = 0; i < record.count; i++) {
+			const Attribute& attribute = record.attributes[i];
+			bool wanted = false;
+			for (int32 j = 0; j < rangeCount; j++) {
+				if (attribute.id >= (ranges[j] >> 16)
+					&& attribute.id <= (ranges[j] & 0xffff))
+					wanted = true;
+			}
+			if (!wanted)
+				continue;
+			if (pass == 0)
+				size += 3 + attribute.length;
+			else {
+				buffer.Put8(0x09);
+				buffer.Put16(attribute.id);
+				buffer.Put(attribute.value, attribute.length);
+			}
+		}
+	}
+}
+
+
+size_t
+AttributesSize(const Record& record, const uint32* ranges, int32 rangeCount)
+{
+	Buffer buffer;
+	PutAttributes(buffer, record, ranges, rangeCount);
+	return buffer.length;
+}
+
+
+/*!	What is left of an answer too long for the byte count the client takes,
+	sent piece by piece with a continuation state: two bytes, the offset.
+*/
+struct Continuation {
+	Buffer	answer;
+	uint8	pdu;
+};
+
+
+void
+SendPdu(int fd, uint8 pdu, uint16 transaction, const Buffer& parameters)
+{
+	Buffer packet;
+	packet.Put8(pdu);
+	packet.Put16(transaction);
+	packet.Put16((uint16)parameters.length);
+	packet.Put(parameters.data, parameters.length);
+	send(fd, packet.data, packet.length, 0);
+}
+
+
+void
+SendError(int fd, uint16 transaction, uint16 error)
+{
+	Buffer parameters;
+	parameters.Put16(error);
+	SendPdu(fd, kErrorResponse, transaction, parameters);
+}
+
+
+/*!	Sends \a answer, or as much of it from \a offset as \a maxBytes allows,
+	with its byte count and the continuation state.
+*/
+void
+SendPiece(int fd, uint8 pdu, uint16 transaction, const Buffer& answer,
+	size_t offset, size_t maxBytes)
+{
+	size_t piece = answer.length - offset;
+	if (piece > maxBytes)
+		piece = maxBytes;
+
+	Buffer parameters;
+	parameters.Put16((uint16)piece);
+	parameters.Put(answer.data + offset, piece);
+	if (offset + piece < answer.length) {
+		parameters.Put8(2);
+		parameters.Put16((uint16)(offset + piece));
+	} else
+		parameters.Put8(0);
+	SendPdu(fd, pdu, transaction, parameters);
+}
+
+
+void
+HandleRequest(int fd, const uint8* packet, size_t length,
+	Continuation& continuation)
+{
+	if (length < 5)
+		return;
+	uint8 pdu = packet[0];
+	uint16 transaction = Read16(packet + 1);
+	size_t parameterLength = Read16(packet + 3);
+	if (parameterLength != length - 5) {
+		SendError(fd, transaction, kErrorInvalidPduSize);
+		return;
+	}
+	const uint8* data = packet + 5;
+	size_t left = parameterLength;
+
+	switch (pdu) {
+		case kServiceSearchRequest:
+		{
+			const Record* found[B_COUNT_OF(kRecords)];
+			int32 foundCount;
+			size_t used = FindRecords(data, left, found, foundCount);
+			if (used == 0 || left < used + 3) {
+				SendError(fd, transaction, kErrorInvalidSyntax);
+				return;
+			}
+			uint16 maxCount = Read16(data + used);
+			if (foundCount > maxCount)
+				foundCount = maxCount;
+
+			Buffer parameters;
+			parameters.Put16((uint16)foundCount);
+			parameters.Put16((uint16)foundCount);
+			for (int32 i = 0; i < foundCount; i++)
+				parameters.Put32(found[i]->handle);
+			parameters.Put8(0);
+			SendPdu(fd, kServiceSearchResponse, transaction, parameters);
+			return;
+		}
+
+		case kServiceAttributeRequest:
+		case kServiceSearchAttributeRequest:
+		{
+			const Record* found[B_COUNT_OF(kRecords)];
+			int32 foundCount = 0;
+			size_t used;
+			if (pdu == kServiceAttributeRequest) {
+				if (left < 4) {
+					SendError(fd, transaction, kErrorInvalidSyntax);
+					return;
+				}
+				uint32 handle = Read32(data);
+				for (size_t i = 0; i < B_COUNT_OF(kRecords); i++) {
+					if (kRecords[i].handle == handle)
+						found[foundCount++] = &kRecords[i];
+				}
+				if (foundCount == 0) {
+					SendError(fd, transaction, kErrorInvalidHandle);
+					return;
+				}
+				used = 4;
+			} else {
+				used = FindRecords(data, left, found, foundCount);
+				if (used == 0) {
+					SendError(fd, transaction, kErrorInvalidSyntax);
+					return;
+				}
+			}
+			if (left < used + 2) {
+				SendError(fd, transaction, kErrorInvalidSyntax);
+				return;
+			}
+			size_t maxBytes = Read16(data + used);
+			used += 2;
+
+			uint32 ranges[16];
+			int32 rangeCount;
+			size_t rangesSize = ReadAttributeRanges(data + used, left - used,
+				ranges, rangeCount);
+			if (rangesSize == 0 || maxBytes < 7) {
+				SendError(fd, transaction, kErrorInvalidSyntax);
+				return;
+			}
+			used += rangesSize;
+
+			// a continuation of an answer already made
+			if (used < left && data[used] == 2 && used + 3 <= left) {
+				size_t offset = Read16(data + used + 1);
+				uint8 responsePdu = pdu + 1;
+				if (continuation.pdu != responsePdu
+					|| offset >= continuation.answer.length) {
+					SendError(fd, transaction, kErrorInvalidContinuation);
+					return;
+				}
+				SendPiece(fd, responsePdu, transaction, continuation.answer,
+					offset, maxBytes);
+				return;
+			}
+
+			Buffer& answer = continuation.answer;
+			answer.length = 0;
+			answer.overflow = false;
+			if (pdu == kServiceAttributeRequest)
+				PutAttributes(answer, *found[0], ranges, rangeCount);
+			else {
+				size_t size = 0;
+				for (int32 i = 0; i < foundCount; i++) {
+					size_t attributes = AttributesSize(*found[i], ranges,
+						rangeCount);
+					size += attributes;
+				}
+				answer.PutSequence(size);
+				for (int32 i = 0; i < foundCount; i++)
+					PutAttributes(answer, *found[i], ranges, rangeCount);
+			}
+			continuation.pdu = pdu + 1;
+			SendPiece(fd, pdu + 1, transaction, answer, 0, maxBytes);
+			return;
+		}
+
+		default:
+			SendError(fd, transaction, kErrorInvalidSyntax);
+			return;
+	}
+}
+
