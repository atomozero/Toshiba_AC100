diff --git a/src/servers/bluetooth/Notifications.cpp b/src/servers/bluetooth/Notifications.cpp
new file mode 100644
index 0000000000..ca2fc31c53
--- /dev/null
+++ b/src/servers/bluetooth/Notifications.cpp
@@ -0,0 +1,182 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+#include "Notifications.h"
+
+#include <Alert.h>
+#include <Application.h>
+#include <Catalog.h>
+#include <Invoker.h>
+#include <Messenger.h>
+#include <Notification.h>
+#include <String.h>
+
+#include <bluetooth/bdaddrUtils.h>
+#include <bluetoothserver_p.h>
+
+#include "LocalDeviceImpl.h"
+
+
+#undef B_TRANSLATION_CONTEXT
+#define B_TRANSLATION_CONTEXT "Notifications"
+
+
+namespace {
+
+
+BString
+DeviceName(const ServerRemoteDevice* device)
+{
+	if (!device->friendly_name.IsEmpty())
+		return device->friendly_name;
+
+	BString name(B_TRANSLATE("Bluetooth device %address%"));
+	name.ReplaceFirst("%address%",
+		bdaddrUtils::ToString(device->bdaddr).String());
+	return name;
+}
+
+
+void
+Send(const ServerRemoteDevice* device, notification_type type,
+	const char* title, const char* content)
+{
+	BNotification notification(type);
+	notification.SetGroup(B_TRANSLATE("Bluetooth"));
+	// one notification per device: the newest replaces the older
+	notification.SetMessageID(bdaddrUtils::ToString(device->bdaddr));
+	notification.SetTitle(title);
+
+	BString text(content);
+	text.ReplaceAll("%device%", DeviceName(device).String());
+	notification.SetContent(text);
+
+	notification.SetOnClickApp(BLUETOOTH_APP_SIGNATURE);
+	notification.Send();
+}
+
+
+}	// namespace
+
+
+void
+Notifications::Connected(const ServerRemoteDevice* device)
+{
+	if (device == NULL)
+		return;
+	Send(device, B_INFORMATION_NOTIFICATION, B_TRANSLATE("Connected"),
+		B_TRANSLATE("%device% is connected."));
+}
+
+
+void
+Notifications::Disconnected(const ServerRemoteDevice* device)
+{
+	if (device == NULL)
+		return;
+	Send(device, B_INFORMATION_NOTIFICATION, B_TRANSLATE("Disconnected"),
+		B_TRANSLATE("%device% is disconnected."));
+}
+
+
+void
+Notifications::Paired(const ServerRemoteDevice* device, bool success)
+{
+	if (device == NULL)
+		return;
+	if (success) {
+		Send(device, B_INFORMATION_NOTIFICATION, B_TRANSLATE("Paired"),
+			B_TRANSLATE("%device% is paired and connects when it is switched "
+				"on."));
+	} else {
+		Send(device, B_ERROR_NOTIFICATION, B_TRANSLATE("Pairing failed"),
+			B_TRANSLATE("%device% could not be paired. Put it in pairing mode "
+				"and try again."));
+	}
+}
+
+
+namespace {
+
+// the window of the pairing under way, if any: a messenger, as the window
+// deletes itself when it is answered
+BMessenger sPairingWindow;
+bdaddr_t sPairingAddress;
+
+
+BString
+FormatPasskey(uint32 passkey)
+{
+	BString text;
+	text.SetToFormat("%06" B_PRIu32, passkey % 1000000);
+	return text;
+}
+
+
+void
+ShowPairingWindow(const bdaddr_t& address, BAlert* alert, BInvoker* invoker)
+{
+	Notifications::ClosePairingWindows(sPairingAddress);
+	alert->SetFlags(alert->Flags() | B_CLOSE_ON_ESCAPE);
+	sPairingAddress = address;
+	sPairingWindow = BMessenger(alert);
+	alert->Go(invoker);
+}
+
+}	// namespace
+
+
+void
+Notifications::ConfirmPairing(const ServerRemoteDevice* device,
+	uint32 passkey, int32 hciId)
+{
+	if (device == NULL)
+		return;
+
+	BString text(B_TRANSLATE("%device% wants to pair.\n\nCheck that it shows "
+		"the same number:\n\n%passkey%"));
+	text.ReplaceAll("%device%", DeviceName(device).String());
+	text.ReplaceAll("%passkey%", FormatPasskey(passkey).String());
+
+	BAlert* alert = new BAlert(B_TRANSLATE("Bluetooth pairing"), text.String(),
+		B_TRANSLATE("Cancel"), B_TRANSLATE("Pair"), NULL, B_WIDTH_AS_USUAL,
+		B_IDEA_ALERT);
+	alert->SetShortcut(0, B_ESCAPE);
+
+	BMessage* message = new BMessage(kMsgPairingConfirmation);
+	message->AddInt32("hci_id", hciId);
+	message->AddData("bdaddr", B_ANY_TYPE, &device->bdaddr, sizeof(bdaddr_t));
+	ShowPairingWindow(device->bdaddr, alert,
+		new BInvoker(message, be_app_messenger));
+}
+
+
+void
+Notifications::ShowPasskey(const ServerRemoteDevice* device, uint32 passkey)
+{
+	if (device == NULL)
+		return;
+
+	BString text(B_TRANSLATE("To pair %device%, type on it:\n\n%passkey%\n\n"
+		"then press Enter."));
+	text.ReplaceAll("%device%", DeviceName(device).String());
+	text.ReplaceAll("%passkey%", FormatPasskey(passkey).String());
+
+	BAlert* alert = new BAlert(B_TRANSLATE("Bluetooth pairing"), text.String(),
+		B_TRANSLATE("OK"), NULL, NULL, B_WIDTH_AS_USUAL, B_INFO_ALERT);
+	ShowPairingWindow(device->bdaddr, alert, NULL);
+}
+
+
+void
+Notifications::ClosePairingWindows(const bdaddr_t& address)
+{
+	if (!bdaddrUtils::Compare(address, sPairingAddress))
+		return;
+	if (sPairingWindow.IsValid())
+		sPairingWindow.SendMessage(B_QUIT_REQUESTED);
+	sPairingWindow = BMessenger();
+}
