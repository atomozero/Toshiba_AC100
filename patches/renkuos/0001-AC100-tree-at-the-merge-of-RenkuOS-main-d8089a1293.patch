+
+static status_t
+nvec_close(void* cookie)
+{
+	return B_OK;
+}
+
+
+static status_t
+nvec_free(void* cookie)
+{
+	delete (nvec_handle*)cookie;
+	return B_OK;
+}
+
+
+static status_t
+nvec_read(void* cookie, off_t position, void* buffer, size_t* _length)
+{
+	nvec_handle* handle = (nvec_handle*)cookie;
+	if (handle->kind != NVEC_POWER_BUTTON || *_length < 1) {
+		*_length = 0;
+		return B_NOT_ALLOWED;
+	}
+
+	// 1 if the button was pressed since the last read
+	nvec_device* device = handle->device;
+	MutexLocker locker(device->powerButtonLock);
+	uint8 pressed = device->powerButtonPressed;
+	device->powerButtonPressed = 0;
+	locker.Unlock();
+
+	if (!IS_USER_ADDRESS(buffer)
+		|| user_memcpy(buffer, &pressed, sizeof(pressed)) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+	*_length = 1;
+	return B_OK;
+}
+
+
+static status_t
+nvec_select(void* cookie, uint8 event, selectsync* sync)
+{
+	nvec_handle* handle = (nvec_handle*)cookie;
+	if (handle->kind != NVEC_POWER_BUTTON || event != B_SELECT_READ)
+		return B_BAD_VALUE;
+
+	nvec_device* device = handle->device;
+	MutexLocker locker(device->powerButtonLock);
+	status_t status = add_select_sync_pool_entry(
+		&device->powerButtonSelectPool, sync, event);
+	if (status == B_OK && device->powerButtonPressed != 0)
+		notify_select_event(sync, event);
+	return status;
+}
+
+
+static status_t
+nvec_deselect(void* cookie, uint8 event, selectsync* sync)
+{
+	nvec_handle* handle = (nvec_handle*)cookie;
+	if (handle->kind != NVEC_POWER_BUTTON || event != B_SELECT_READ)
+		return B_BAD_VALUE;
+
+	nvec_device* device = handle->device;
+	MutexLocker locker(device->powerButtonLock);
+	return remove_select_sync_pool_entry(&device->powerButtonSelectPool, sync,
+		event);
+}
+
+
+static status_t
+nvec_write_hook(void* cookie, off_t position, const void* buffer,
+	size_t* _length)
+{
+	*_length = 0;
+	return B_NOT_ALLOWED;
+}
+
+
+static status_t
+read_key(nvec_device* device, void* buffer)
+{
+	while (true) {
+		status_t status = acquire_sem_etc(device->keySem, 1,
+			B_CAN_INTERRUPT | B_RELATIVE_TIMEOUT,
+			device->repeatKey != 0 ? device->currentRepeatDelay
+				: B_INFINITE_TIMEOUT);
+
+		raw_key_info info;
+		if (status == B_TIMED_OUT) {
+			// the EC does not repeat keys itself
+			if (device->repeatKey == 0)
+				continue;
+			info.timestamp = system_time();
+			info.keycode = device->repeatKey;
+			info.is_keydown = true;
+			device->currentRepeatDelay = device->repeatRate;
+		} else if (status != B_OK) {
+			return status;
+		} else {
+			InterruptsSpinLocker locker(device->keyLock);
+			if (device->keyTail == device->keyHead)
+				continue;
+			info = device->keys[device->keyTail % NVEC_KEY_COUNT];
+			device->keyTail++;
+			locker.Unlock();
+
+			if (info.is_keydown) {
+				device->repeatKey = info.keycode;
+				device->currentRepeatDelay = device->repeatDelay;
+			} else if (info.keycode == device->repeatKey)
+				device->repeatKey = 0;
+		}
+
+		if (!IS_USER_ADDRESS(buffer))
+			return B_BAD_ADDRESS;
+		return user_memcpy(buffer, &info, sizeof(info));
+	}
+}
+
+
+static status_t
+read_movement(nvec_device* device, void* buffer)
+{
+	while (true) {
+		status_t status = acquire_sem_etc(device->mouseSem, 1, B_CAN_INTERRUPT,
+			0);
+		if (status != B_OK)
+			return status;
+
+		InterruptsSpinLocker locker(device->mouseLock);
+		if (device->movementTail == device->movementHead)
+			continue;
+		mouse_movement movement
+			= device->movements[device->movementTail % NVEC_MOUSE_COUNT];
+		device->movementTail++;
+		locker.Unlock();
+
+		if (!IS_USER_ADDRESS(buffer))
+			return B_BAD_ADDRESS;
+		return user_memcpy(buffer, &movement, sizeof(movement));
+	}
+}
+
+
+/*!	Looks like an ACPI battery to PowerStatus. */
+/*!	Sends one request to the EC and waits for the reply with the same type
+	and sub-command.
+*/
+/*!	Copies the log of the touchpad bytes, the oldest entry first. */
+static status_t
+diag_mouse_log(nvec_device* device, void* buffer, size_t length)
+{
+	if (length < sizeof(nvec_mouse_log) || !IS_USER_ADDRESS(buffer))
+		return B_BAD_ADDRESS;
+
+	nvec_mouse_log* log = new(std::nothrow) nvec_mouse_log;
+	if (log == NULL)
+		return B_NO_MEMORY;
+	memset(log, 0, sizeof(*log));
+
+	InterruptsSpinLocker locker(device->mouseLock);
+	log->count = device->mouseLogCount;
+	uint32 kept = min_c(log->count, (uint32)NVEC_MOUSE_LOG_COUNT);
+	for (uint32 i = 0; i < kept; i++) {
+		log->entries[i] = device->mouseLog[
+			(log->count - kept + i) % NVEC_MOUSE_LOG_COUNT];
+	}
+	locker.Unlock();
+
+	status_t status = user_memcpy(buffer, log, sizeof(*log));
+	delete log;
+	return status;
+}
+
+
+static status_t
+diag_request(nvec_device* device, void* buffer, size_t length)
+{
+	nvec_diag_request request;
+	if (length < sizeof(request) || !IS_USER_ADDRESS(buffer)
+		|| user_memcpy(&request, buffer, sizeof(request)) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+	if (request.size < 2 || request.size > sizeof(request.request))
+		return B_BAD_VALUE;
+
+	MutexLocker locker(device->diagLock);
+	while (acquire_sem_etc(device->diagSem, 1, B_RELATIVE_TIMEOUT, 0) == B_OK)
+		;
+	device->diagSubCommand = request.request[1];
+	device->diagClass = request.request[0];
+
+	status_t status = nvec_write(device, request.request, request.size);
+	if (status == B_OK) {
+		status = acquire_sem_etc(device->diagSem, 1, B_RELATIVE_TIMEOUT,
+			1000000);
+	}
+	device->diagClass = -1;
+	if (status != B_OK)
+		return status;
+
+	request.replySize = min_c(device->diagReply.size, sizeof(request.reply));
+	memcpy(request.reply, device->diagReply.data, request.replySize);
+	return user_memcpy(buffer, &request, sizeof(request));
+}
+
+
+static status_t
+battery_control(nvec_device* device, uint32 op, void* buffer)
+{
+	if (!IS_USER_ADDRESS(buffer))
+		return B_BAD_ADDRESS;
+
+	switch (op) {
+		case IDENTIFY_DEVICE:
+		{
+			uint32 magic = kMagicACPIBatteryID;
+			return user_memcpy(buffer, &magic, sizeof(magic));
+		}
+
+		case GET_BATTERY_INFO:
+		{
+			acpi_battery_info info = {};
+			InterruptsSpinLocker locker(device->batteryLock);
+			if (device->batteryPresent) {
+				info.state = device->batteryState;
+				if (device->critical != 0
+					&& device->remaining <= device->critical) {
+					info.state |= BATTERY_CRITICAL_STATE;
+				}
+				info.current_rate = device->current < 0 ? -device->current
+					: device->current;
+				// the EC reports the charge in percent more reliably
+				info.capacity = device->lastFull != 0
+					? device->lastFull * device->batteryPercent / 100
+					: device->remaining;
+				info.voltage = device->voltage;
+			}
+			locker.Unlock();
+			return user_memcpy(buffer, &info, sizeof(info));
+		}
+
+		case GET_EXTENDED_BATTERY_INFO:
+		{
+			acpi_extended_battery_info info = {};
+			InterruptsSpinLocker locker(device->batteryLock);
+			info.power_unit = ACPI_BATTERY_UNIT_MA;
+			info.design_capacity = device->design;
+			info.last_full_charge = device->lastFull != 0 ? device->lastFull
+				: device->design;
+			info.technology = 1;	// rechargeable
+			info.design_voltage = device->voltage;
+			info.design_capacity_warning = info.last_full_charge / 10;
+			info.design_capacity_low = device->critical;
+			info.capacity_granularity_1 = 1;
+			info.capacity_granularity_2 = 1;
+			strlcpy(info.model_number, device->model,
+				sizeof(info.model_number));
+			strlcpy(info.type, device->type, sizeof(info.type));
+			strlcpy(info.oem_info, device->manufacturer,
+				sizeof(info.oem_info));
+			info.revision = ACPI_BATTERY_REVISION_BIF;
+			locker.Unlock();
+			return user_memcpy(buffer, &info, sizeof(info));
+		}
+	}
+	return B_DEV_INVALID_IOCTL;
+}
+
+
+static status_t
+nvec_control(void* cookie, uint32 op, void* buffer, size_t length)
+{
+	nvec_handle* handle = (nvec_handle*)cookie;
+	nvec_device* device = handle->device;
+
+	if (handle->kind == NVEC_BATTERY)
+		return battery_control(device, op, buffer);
+
+	if (handle->kind == NVEC_DIAG) {
+		if (op == NVEC_DIAG_MOUSE_LOG)
+			return diag_mouse_log(device, buffer, length);
+		if (op != NVEC_DIAG_REQUEST)
+			return B_DEV_INVALID_IOCTL;
+		return diag_request(device, buffer, length);
+	}
+
+	if (handle->kind == NVEC_KEYBOARD) {
+		switch (op) {
+			case KB_READ:
+				return read_key(device, buffer);
+
+			case KB_GET_KEYBOARD_ID:
+			{
+				uint16 id = 0xab83;
+				if (!IS_USER_ADDRESS(buffer))
+					return B_BAD_ADDRESS;
+				return user_memcpy(buffer, &id, sizeof(id));
+			}
+
+			case KB_SET_LEDS:
+			{
+				uint8 leds[3];
+				if (!IS_USER_ADDRESS(buffer)
+					|| user_memcpy(leds, buffer, sizeof(leds)) != B_OK) {
+					return B_BAD_ADDRESS;
+				}
+				// all three bits are needed for the caps lock LED to light
+				// up (as in Linux, a firmware bug?)
+				uint8 message[] = { NVEC_KBD, KBD_SET_LEDS,
+					(uint8)(leds[1] ? 7 : 0) };
+				return nvec_write(device, message, sizeof(message));
+			}
+
+			case KB_SET_KEY_REPEAT_RATE:
+			{
+				int32 rate;
+				if (!IS_USER_ADDRESS(buffer)
+					|| user_memcpy(&rate, buffer, sizeof(rate)) != B_OK) {
+					return B_BAD_ADDRESS;
+				}
+				if (rate <= 0 || rate > 1000000)
+					return B_BAD_VALUE;
+				device->repeatRate = 10000000 / rate;
+				return B_OK;
+			}
+
+			case KB_GET_KEY_REPEAT_RATE:
+			{
+				int32 rate = 10000000 / device->repeatRate;
+				if (!IS_USER_ADDRESS(buffer))
+					return B_BAD_ADDRESS;
+				return user_memcpy(buffer, &rate, sizeof(rate));
+			}
+
+			case KB_SET_KEY_REPEAT_DELAY:
+				if (!IS_USER_ADDRESS(buffer))
+					return B_BAD_ADDRESS;
+				return user_memcpy(&device->repeatDelay, buffer,
+					sizeof(bigtime_t));
+
+			case KB_GET_KEY_REPEAT_DELAY:
+				if (!IS_USER_ADDRESS(buffer))
+					return B_BAD_ADDRESS;
+				return user_memcpy(buffer, &device->repeatDelay,
+					sizeof(bigtime_t));
+
+			case KB_SET_CONTROL_ALT_DEL_TIMEOUT:
+			case KB_CANCEL_CONTROL_ALT_DEL:
+			case KB_DELAY_CONTROL_ALT_DEL:
+				return B_OK;
+		}
+		return B_DEV_INVALID_IOCTL;
+	}
+
+	switch (op) {
+		case MS_READ:
+			return read_movement(device, buffer);
+
+		case MS_NUM_EVENTS:
+		{
+			int32 count;
+			get_sem_count(device->mouseSem, &count);
+			return count;
+		}
+
+		case MS_SET_CLICKSPEED:
+			if (!IS_USER_ADDRESS(buffer))
+				return B_BAD_ADDRESS;
+			return user_memcpy(&device->clickSpeed, buffer,
+				sizeof(bigtime_t));
+	}
+	return B_DEV_INVALID_IOCTL;
+}
+
+
+//	#pragma mark - driver module API
+
+
+static float
+nvec_supports_device(device_node* parent)
+{
+	const char* compatible;
+	if (gDeviceManager->get_attr_string(parent, "fdt/compatible", &compatible,
+			false) != B_OK || strcmp(compatible, "nvidia,nvec") != 0) {
+		return -1.0f;
+	}
+
+	return 0.8f;
+}
+
+
+static status_t
+nvec_register_device(device_node* parent)
+{
+	device_attr attrs[] = {
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE,
+			{ .string = "NVIDIA embedded controller" }},
+		{}
+	};
+
+	return gDeviceManager->register_node(parent, NVEC_DRIVER_MODULE_NAME,
+		attrs, NULL, NULL);
+}
+
+
+static uint32
+fdt_get_uint32(fdt_device_module_info* module, fdt_device* dev,
+	const char* name, uint32 index, uint32 defaultValue)
+{
+	int length;
+	const uint32* cells = (const uint32*)module->get_prop(dev, name, &length);
+	if (cells == NULL || length < (int)((index + 1) * sizeof(uint32)))
+		return defaultValue;
+	return B_BENDIAN_TO_HOST_INT32(cells[index]);
+}
+
+
+static status_t
+nvec_init_driver(device_node* node, void** _cookie)
+{
+	nvec_device* device = new(std::nothrow) nvec_device;
+	if (device == NULL)
+		return B_NO_MEMORY;
+	memset((void*)device, 0, sizeof(*device));
+	device->node = node;
+	device->lock = B_SPINLOCK_INITIALIZER;
+	device->keyLock = B_SPINLOCK_INITIALIZER;
+	device->mouseLock = B_SPINLOCK_INITIALIZER;
+	device->batteryLock = B_SPINLOCK_INITIALIZER;
+	mutex_init(&device->powerButtonLock, "nvec power button");
+	mutex_init(&device->diagLock, "nvec diag");
+	device->diagSem = -1;
+	device->diagClass = -1;
+	device->registersArea = device->gpioArea = device->pwmArea = -1;
+	device->rxSem = device->txSem = device->transferSem = device->keySem
+		= device->mouseSem = -1;
+	device->repeatDelay = 300000;
+	device->repeatRate = 35000;
+	device->clickSpeed = 500000;
+
+	status_t status;
+	{
+		device_node* parent = gDeviceManager->get_parent_node(node);
+		fdt_device_module_info* fdt;
+		fdt_device* fdtDevice;
+		status = gDeviceManager->get_driver(parent,
+			(driver_module_info**)&fdt, (void**)&fdtDevice);
+		gDeviceManager->put_node(parent);
+		if (status != B_OK)
+			goto err;
+
+		uint64 registers, length;
+		if (!fdt->get_reg(fdtDevice, 0, &registers, &length)
+			|| !fdt->get_interrupt(fdtDevice, 0, NULL, &device->irq)) {
+			status = B_BAD_DATA;
+			goto err;
+		}
+		// <phandle gpio flags>
+		device->requestGPIO = fdt_get_uint32(fdt, fdtDevice, "request-gpios",
+			1, 0xaa);
+		device->requestActiveLow = (fdt_get_uint32(fdt, fdtDevice,
+			"request-gpios", 2, 0) & 1) != 0;
+		device->slaveAddress = fdt_get_uint32(fdt, fdtDevice, "slave-addr", 0,
+			0x8a);
+
+		status = map_registers("nvec", registers, &device->registersArea,
+			&device->registers);
+		if (status != B_OK)
+			goto err;
+		TRACE_ALWAYS("controller at %#" B_PRIx64 ", IRQ %" B_PRIu64
+			", request GPIO %" B_PRIu32 ", address %#" B_PRIx32 "\n",
+			registers, device->irq, device->requestGPIO,
+			device->slaveAddress);
+	}
+
+	device->rxSem = create_sem(0, "nvec rx");
+	device->txSem = create_sem(0, "nvec tx");
+	device->transferSem = create_sem(0, "nvec transfer");
+	device->keySem = create_sem(0, "nvec keys");
+	device->mouseSem = create_sem(0, "nvec movements");
+	device->diagSem = create_sem(0, "nvec diag");
+	if (device->rxSem < B_OK || device->txSem < B_OK
+		|| device->transferSem < B_OK || device->keySem < B_OK
+		|| device->mouseSem < B_OK) {
+		status = B_NO_MORE_SEMS;
+		goto err;
+	}
+
+	status = setup_hardware(device);
+	if (status != B_OK)
+		goto err;
+	setup_backlight(device);
+
+	status = install_io_interrupt_handler(device->irq, nvec_interrupt, device,
+		0);
+	if (status != B_OK)
+		goto err;
+
+	device->rxThread = spawn_kernel_thread(rx_thread, "nvec rx",
+		B_URGENT_DISPLAY_PRIORITY, device);
+	device->txThread = spawn_kernel_thread(tx_thread, "nvec tx",
+		B_URGENT_DISPLAY_PRIORITY, device);
+	resume_thread(device->rxThread);
+	resume_thread(device->txThread);
+
+	start_ec(device);
+
+	device->pollThread = spawn_kernel_thread(poll_thread, "nvec poll",
+		B_LOW_PRIORITY, device);
+	resume_thread(device->pollThread);
+
+	sPowerOffDevice = device;
+	gArmPowerOffHook = &nvec_power_off;
+
+	*_cookie = device;
+	return B_OK;
+
+err:
+	TRACE_ALWAYS("init failed: %s\n", strerror(status));
+	mutex_destroy(&device->powerButtonLock);
+	mutex_destroy(&device->diagLock);
+	delete_sem(device->diagSem);
+	delete_sem(device->rxSem);
+	delete_sem(device->txSem);
+	delete_sem(device->transferSem);
+	delete_sem(device->keySem);
+	delete_sem(device->mouseSem);
+	delete_area(device->registersArea);
+	delete_area(device->gpioArea);
+	delete_area(device->pwmArea);
+	delete device;
+	return status;
+}
+
+
+static void
+nvec_uninit_driver(void* cookie)
+{
+	nvec_device* device = (nvec_device*)cookie;
+
+	gArmPowerOffHook = NULL;
+	sPowerOffDevice = NULL;
+
+	device->stopping = true;
+	remove_io_interrupt_handler(device->irq, nvec_interrupt, device);
+	mutex_destroy(&device->powerButtonLock);
+	delete_sem(device->rxSem);
+	delete_sem(device->txSem);
+	delete_sem(device->transferSem);
+	delete_sem(device->keySem);
+	delete_sem(device->mouseSem);
+	status_t result;
+	wait_for_thread(device->rxThread, &result);
+	wait_for_thread(device->txThread, &result);
+	wait_for_thread(device->pollThread, &result);
+	delete_area(device->registersArea);
+	delete_area(device->gpioArea);
+	delete_area(device->pwmArea);
+	delete device;
+}
+
+
+static status_t
+nvec_register_child_devices(void* cookie)
+{
+	nvec_device* device = (nvec_device*)cookie;
+
+	status_t status = gDeviceManager->publish_device(device->node,
+		"input/keyboard/nvec/0", NVEC_DEVICE_MODULE_NAME);
+	if (status == B_OK) {
+		status = gDeviceManager->publish_device(device->node,
+			"input/mouse/nvec/0", NVEC_DEVICE_MODULE_NAME);
+	}
+	if (status == B_OK) {
+		status = gDeviceManager->publish_device(device->node,
+			"power/nvec_battery/0", NVEC_DEVICE_MODULE_NAME);
+	}
+	if (status == B_OK) {
+		status = gDeviceManager->publish_device(device->node,
+			"power/button/power_nvec", NVEC_DEVICE_MODULE_NAME);
+	}
+	if (status == B_OK) {
+		gDeviceManager->publish_device(device->node, NVEC_DIAG_PATH,
+			NVEC_DEVICE_MODULE_NAME);
+	}
+	return status;
+}
+
