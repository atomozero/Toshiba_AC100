+
+status_t
+AvdtpSession::DiscoverEndpoints(avdtp_sep_info* seps, uint8* count,
+	uint8 maxSeps)
+{
+	if (fSignalingSocket < 0)
+		return B_NO_INIT;
+
+	/* Send AVDTP_DISCOVER (no parameters) */
+	status_t err = _SendSignal(AVDTP_DISCOVER, NULL, 0);
+	if (err != B_OK)
+		return err;
+
+	/* Receive response */
+	uint8 buf[AVDTP_SIGNAL_BUF_SIZE];
+	ssize_t received = _RecvSignal(buf, sizeof(buf), 5000000);
+	if (received < AVDTP_HEADER_SIZE)
+		return B_TIMED_OUT;
+
+	uint8 msgType = AVDTP_GET_MSG_TYPE(buf[0]);
+	if (msgType == AVDTP_MSG_TYPE_RESPONSE_REJECT) {
+		TRACE_AVDTP("Discover rejected: error 0x%02x\n",
+			received > AVDTP_HEADER_SIZE ? buf[AVDTP_HEADER_SIZE] : 0);
+		return B_ERROR;
+	}
+
+	if (msgType != AVDTP_MSG_TYPE_RESPONSE_ACCEPT) {
+		TRACE_AVDTP("Discover: unexpected message type %u\n", msgType);
+		return B_ERROR;
+	}
+
+	/* Parse SEP info entries (2 bytes each) */
+	size_t payloadLen = received - AVDTP_HEADER_SIZE;
+	uint8 sepCount = payloadLen / sizeof(avdtp_sep_info);
+	if (sepCount > maxSeps)
+		sepCount = maxSeps;
+
+	memcpy(seps, buf + AVDTP_HEADER_SIZE,
+		sepCount * sizeof(avdtp_sep_info));
+	*count = sepCount;
+
+	TRACE_AVDTP("Discovered %u endpoints\n", sepCount);
+	for (uint8 i = 0; i < sepCount; i++) {
+		TRACE_AVDTP("  SEP[%u]: SEID=%u type=%s media=%u inUse=%u\n",
+			i, AVDTP_SEP_SEID(&seps[i]),
+			AVDTP_SEP_TSEP(&seps[i]) == AVDTP_SEP_SINK
+				? "Sink" : "Source",
+			AVDTP_SEP_MEDIA_TYPE(&seps[i]),
+			AVDTP_SEP_IN_USE(&seps[i]));
+	}
+
+	return B_OK;
+}
+
+
+status_t
+AvdtpSession::GetCapabilities(uint8 remoteSeid, AvdtpCapability* caps,
+	uint8* count, uint8 maxCaps)
+{
+	if (fSignalingSocket < 0)
+		return B_NO_INIT;
+
+	/* Get All Capabilities first (AVDTP 1.3: it tells of delay
+	 * reporting too), Get Capabilities from a device that does not know
+	 * it */
+	uint8 param = (remoteSeid << 2);
+	uint8 buf[AVDTP_SIGNAL_BUF_SIZE];
+	ssize_t received = 0;
+	uint8 msgType = AVDTP_MSG_TYPE_RESPONSE_REJECT;
+	const uint8 signals[] = { AVDTP_GET_ALL_CAPABILITIES,
+		AVDTP_GET_CAPABILITIES };
+	for (size_t i = 0; i < sizeof(signals); i++) {
+		status_t err = _SendSignal(signals[i], &param, 1);
+		if (err != B_OK)
+			return err;
+		received = _RecvSignal(buf, sizeof(buf), 5000000);
+		if (received < AVDTP_HEADER_SIZE)
+			return B_TIMED_OUT;
+		msgType = AVDTP_GET_MSG_TYPE(buf[0]);
+		if (msgType == AVDTP_MSG_TYPE_RESPONSE_ACCEPT)
+			break;
+	}
+	if (msgType == AVDTP_MSG_TYPE_RESPONSE_REJECT) {
+		TRACE_AVDTP("GetCapabilities rejected: error 0x%02x\n",
+			received > AVDTP_HEADER_SIZE + 1
+				? buf[AVDTP_HEADER_SIZE + 1] : 0);
+		return B_ERROR;
+	}
+
+	if (msgType != AVDTP_MSG_TYPE_RESPONSE_ACCEPT)
+		return B_ERROR;
+
+	/* Parse capability entries: [category, length, data...] */
+	const uint8* p = buf + AVDTP_HEADER_SIZE;
+	size_t remaining = received - AVDTP_HEADER_SIZE;
+	uint8 capCount = 0;
+
+	while (remaining >= 2 && capCount < maxCaps) {
+		uint8 category = p[0];
+		uint8 dataLen = p[1];
+		p += 2;
+		remaining -= 2;
+
+		if (dataLen > remaining)
+			break;
+
+		caps[capCount].category = category;
+		caps[capCount].dataLen = (dataLen > 32) ? 32 : dataLen;
+		if (dataLen > 0)
+			memcpy(caps[capCount].data, p, caps[capCount].dataLen);
+
+		TRACE_AVDTP("  Capability: category=0x%02x len=%u\n",
+			category, dataLen);
+
+		p += dataLen;
+		remaining -= dataLen;
+		capCount++;
+	}
+
+	*count = capCount;
+
+	return B_OK;
+}
+
+
+status_t
+AvdtpSession::SetConfiguration(uint8 remoteSeid, uint8 localSeid,
+	const AvdtpCapability* caps, uint8 capCount)
+{
+	if (fSignalingSocket < 0)
+		return B_NO_INIT;
+
+	/* Build parameter: ACP SEID (1) + INT SEID (1) + capabilities */
+	uint8 params[256];
+	size_t offset = 0;
+
+	params[offset++] = (remoteSeid << 2);
+	params[offset++] = (localSeid << 2);
+
+	for (uint8 i = 0; i < capCount; i++) {
+		params[offset++] = caps[i].category;
+		params[offset++] = caps[i].dataLen;
+		if (caps[i].dataLen > 0) {
+			memcpy(params + offset, caps[i].data, caps[i].dataLen);
+			offset += caps[i].dataLen;
+		}
+	}
+
+	status_t err = _SendSignal(AVDTP_SET_CONFIGURATION, params, offset);
+	if (err != B_OK)
+		return err;
+
+	/* Receive response */
+	uint8 buf[AVDTP_SIGNAL_BUF_SIZE];
+	ssize_t received = _RecvSignal(buf, sizeof(buf), 5000000);
+	if (received < AVDTP_HEADER_SIZE)
+		return B_TIMED_OUT;
+
+	uint8 msgType = AVDTP_GET_MSG_TYPE(buf[0]);
+	if (msgType == AVDTP_MSG_TYPE_RESPONSE_REJECT) {
+		TRACE_AVDTP("SetConfiguration rejected: cat=0x%02x err=0x%02x\n",
+			received > AVDTP_HEADER_SIZE
+				? buf[AVDTP_HEADER_SIZE] : 0,
+			received > AVDTP_HEADER_SIZE + 1
+				? buf[AVDTP_HEADER_SIZE + 1] : 0);
+		return B_ERROR;
+	}
+
+	if (msgType != AVDTP_MSG_TYPE_RESPONSE_ACCEPT)
+		return B_ERROR;
+
+	// told back to a Get Configuration of the other side
+	fLocalSeid = localSeid;
+	fConfigurationLength = 0;
+	if (offset - 2 <= sizeof(fConfiguration)) {
+		memcpy(fConfiguration, params + 2, offset - 2);
+		fConfigurationLength = offset - 2;
+	}
+	fRemoteStopped = false;
+
+	TRACE_AVDTP("Configuration set for remote SEID %u\n", remoteSeid);
+	return B_OK;
+}
+
+
+status_t
+AvdtpSession::Open(uint8 remoteSeid)
+{
+	if (fSignalingSocket < 0)
+		return B_NO_INIT;
+
+	uint8 param = (remoteSeid << 2);
+	status_t err = _SendSignal(AVDTP_OPEN, &param, 1);
+	if (err != B_OK)
+		return err;
+
+	uint8 buf[AVDTP_SIGNAL_BUF_SIZE];
+	ssize_t received = _RecvSignal(buf, sizeof(buf), 5000000);
+	if (received < AVDTP_HEADER_SIZE)
+		return B_TIMED_OUT;
+
+	uint8 msgType = AVDTP_GET_MSG_TYPE(buf[0]);
+	if (msgType != AVDTP_MSG_TYPE_RESPONSE_ACCEPT) {
+		TRACE_AVDTP("Open rejected\n");
+		return B_ERROR;
+	}
+
+	TRACE_AVDTP("Stream opened for SEID %u\n", remoteSeid);
+	return B_OK;
+}
+
+
+status_t
+AvdtpSession::Start(uint8 remoteSeid)
+{
+	if (fSignalingSocket < 0)
+		return B_NO_INIT;
+
+	uint8 param = (remoteSeid << 2);
+	status_t err = _SendSignal(AVDTP_START, &param, 1);
+	if (err != B_OK)
+		return err;
+
+	uint8 buf[AVDTP_SIGNAL_BUF_SIZE];
+	ssize_t received = _RecvSignal(buf, sizeof(buf), 5000000);
+	if (received < AVDTP_HEADER_SIZE)
+		return B_TIMED_OUT;
+
+	uint8 msgType = AVDTP_GET_MSG_TYPE(buf[0]);
+	if (msgType != AVDTP_MSG_TYPE_RESPONSE_ACCEPT) {
+		TRACE_AVDTP("Start rejected\n");
+		return B_ERROR;
+	}
+
+	TRACE_AVDTP("Stream started for SEID %u\n", remoteSeid);
+	return B_OK;
+}
+
+
+status_t
+AvdtpSession::Suspend(uint8 remoteSeid)
+{
+	if (fSignalingSocket < 0)
+		return B_NO_INIT;
+
+	uint8 param = (remoteSeid << 2);
+	// a stream we suspend is started again by us: a Start the device sent
+	// before does not count any more
+	fRemoteStarted = false;
+	status_t err = _SendSignal(AVDTP_SUSPEND, &param, 1);
+	if (err != B_OK) {
+		TRACE_AVDTP("Suspend: SendSignal failed: %s\n", strerror(err));
+		return err;
+	}
+
+	/* If the remote already disconnected, recv may crash or block
+	 * indefinitely.  Use a short timeout and handle errors. */
+	uint8 buf[AVDTP_SIGNAL_BUF_SIZE];
+	ssize_t received = _RecvSignal(buf, sizeof(buf), 2000000);
+	if (received <= 0)
+		return B_TIMED_OUT;
+	if (received < (ssize_t)AVDTP_HEADER_SIZE)
+		return B_TIMED_OUT;
+
+	uint8 msgType = AVDTP_GET_MSG_TYPE(buf[0]);
+	if (msgType != AVDTP_MSG_TYPE_RESPONSE_ACCEPT) {
+		TRACE_AVDTP("Suspend rejected\n");
+		return B_ERROR;
+	}
+
+	return B_OK;
+}
+
+
+status_t
+AvdtpSession::Close(uint8 remoteSeid)
+{
+	if (fSignalingSocket < 0) {
+		/* Socket already gone — just clean up media channel */
+		if (fMediaSocket >= 0) {
+			close(fMediaSocket);
+			fMediaSocket = -1;
+		}
+		return B_NO_INIT;
+	}
+
+	uint8 param = (remoteSeid << 2);
+	status_t err = _SendSignal(AVDTP_CLOSE, &param, 1);
+	if (err != B_OK) {
+		TRACE_AVDTP("Close: SendSignal failed: %s\n", strerror(err));
+		/* Remote likely disconnected — close media channel anyway */
+		if (fMediaSocket >= 0) {
+			close(fMediaSocket);
+			fMediaSocket = -1;
+		}
+		return err;
+	}
+
+	uint8 buf[AVDTP_SIGNAL_BUF_SIZE];
+	ssize_t received = _RecvSignal(buf, sizeof(buf), 5000000);
+	if (received < (ssize_t)AVDTP_HEADER_SIZE) {
+		if (fMediaSocket >= 0) {
+			close(fMediaSocket);
+			fMediaSocket = -1;
+		}
+		return B_TIMED_OUT;
+	}
+
+	uint8 msgType = AVDTP_GET_MSG_TYPE(buf[0]);
+	if (msgType != AVDTP_MSG_TYPE_RESPONSE_ACCEPT) {
+		TRACE_AVDTP("Close rejected\n");
+	}
+
+	/* Close media channel */
+	if (fMediaSocket >= 0) {
+		close(fMediaSocket);
+		fMediaSocket = -1;
+	}
+
+	return B_OK;
+}
+
+
+status_t
+AvdtpSession::Abort(uint8 remoteSeid)
+{
+	if (fSignalingSocket < 0)
+		return B_NO_INIT;
+
+	uint8 param = (remoteSeid << 2);
+	_SendSignal(AVDTP_ABORT, &param, 1);
+
+	/* Read and discard response */
+	uint8 buf[AVDTP_SIGNAL_BUF_SIZE];
+	_RecvSignal(buf, sizeof(buf), 2000000);
+
+	if (fMediaSocket >= 0) {
+		close(fMediaSocket);
+		fMediaSocket = -1;
+	}
+
+	return B_OK;
+}
+
+
+status_t
+AvdtpSession::OpenMediaChannel(const bdaddr_t& remote)
+{
+	if (fMediaSocket >= 0)
+		return B_BUSY;
+
+	/* Create L2CAP socket for media transport.
+	 * Ideally SOCK_SEQPACKET to preserve RTP packet boundaries,
+	 * but Haiku's L2CAP only supports SOCK_STREAM. Each send()
+	 * on SOCK_STREAM should still produce a separate L2CAP PDU
+	 * as long as we don't send faster than the link can transmit. */
+	fMediaSocket = socket(PF_BLUETOOTH, SOCK_SEQPACKET,
+		BLUETOOTH_PROTO_L2CAP);
+	if (fMediaSocket < 0) {
+		TRACE_AVDTP("media socket() failed: %s\n", strerror(errno));
+		return B_ERROR;
+	}
+
+	/* Longer timeout for media — 30 seconds */
+	struct timeval tv;
+	tv.tv_sec = 30;
+	tv.tv_usec = 0;
+	setsockopt(fMediaSocket, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+
+	struct sockaddr_l2cap addr;
+	memset(&addr, 0, sizeof(addr));
+	addr.l2cap_len = sizeof(addr);
+	addr.l2cap_family = PF_BLUETOOTH;
+	addr.l2cap_psm = L2CAP_PSM_AVDTP;
+	memcpy(&addr.l2cap_bdaddr, &remote, sizeof(bdaddr_t));
+
+	TRACE_AVDTP("Opening media transport channel...\n");
+	if (connect(fMediaSocket, (struct sockaddr*)&addr,
+			sizeof(addr)) < 0) {
+		TRACE_AVDTP("media connect() failed: %s\n", strerror(errno));
+		close(fMediaSocket);
+		fMediaSocket = -1;
+		return B_ERROR;
+	}
+
+	TRACE_AVDTP("Media transport channel connected.\n");
+	return B_OK;
+}
+
+
+/* =========================================================================
+ * Private helpers
+ * ========================================================================= */
+
+status_t
+AvdtpSession::_SendSignal(uint8 signalId, const uint8* params,
+	size_t paramLen)
+{
+	uint8 buf[AVDTP_SIGNAL_BUF_SIZE];
+
+	if (AVDTP_HEADER_SIZE + paramLen > sizeof(buf))
+		return B_BUFFER_OVERFLOW;
+
+	uint8 label = _NextTxLabel();
+	buf[0] = AVDTP_SET_HEADER(label, AVDTP_PKT_TYPE_SINGLE,
+		AVDTP_MSG_TYPE_COMMAND);
+	buf[1] = signalId;
+
+	if (paramLen > 0)
+		memcpy(buf + AVDTP_HEADER_SIZE, params, paramLen);
+
+	size_t totalLen = AVDTP_HEADER_SIZE + paramLen;
+
+	TRACE_AVDTP("Send signal 0x%02x label=%u len=%zu\n",
+		signalId, label, totalLen);
+
+	ssize_t sent = send(fSignalingSocket, buf, totalLen, 0);
+	if (sent < 0) {
+		TRACE_AVDTP("send() failed: %s\n", strerror(errno));
+		return B_ERROR;
+	}
+
+	return B_OK;
+}
+
+
+/*!	The answer to our command. The other side may send a command of its own
+	meanwhile: it is answered, and the wait goes on.
+*/
+ssize_t
+AvdtpSession::_RecvSignal(uint8* buf, size_t maxLen, bigtime_t timeout)
+{
+	if (fSignalingSocket < 0)
+		return -1;
+
+	bigtime_t deadline = system_time() + timeout;
+	while (true) {
+		bigtime_t left = deadline - system_time();
+		if (left <= 0)
+			return -1;
+
+		struct timeval tv;
+		tv.tv_sec = left / 1000000;
+		tv.tv_usec = left % 1000000;
+		setsockopt(fSignalingSocket, SOL_SOCKET, SO_RCVTIMEO, &tv,
+			sizeof(tv));
+
+		ssize_t received = recv(fSignalingSocket, buf, maxLen, 0);
+		if (received < 0) {
+			TRACE_AVDTP("recv() failed: %s\n", strerror(errno));
+			return -1;
+		}
+
+		if (received >= AVDTP_HEADER_SIZE) {
+			TRACE_AVDTP("Recv signal: label=%u pkt=%u msg=%u sig=0x%02x "
+				"len=%zd\n",
+				AVDTP_GET_TX_LABEL(buf[0]),
+				AVDTP_GET_PKT_TYPE(buf[0]),
+				AVDTP_GET_MSG_TYPE(buf[0]),
+				buf[1], received);
+			if (AVDTP_GET_MSG_TYPE(buf[0]) == AVDTP_MSG_TYPE_COMMAND) {
+				_HandleCommand(buf, received);
+				continue;
+			}
+		}
+
+		return received;
+	}
+}
+
+
+void
+AvdtpSession::PollSignals()
+{
+	if (fSignalingSocket < 0)
+		return;
+
+	uint8 buf[AVDTP_SIGNAL_BUF_SIZE];
+	while (true) {
+		ssize_t received = recv(fSignalingSocket, buf, sizeof(buf),
+			MSG_DONTWAIT);
+		if (received == 0 || (received < 0 && errno != B_WOULD_BLOCK
+				&& errno != EAGAIN && errno != B_INTERRUPTED
+				&& errno != B_TIMED_OUT)) {
+			// the device closed the channel, or the link went
+			TRACE_AVDTP("The signaling channel is gone\n");
+			close(fSignalingSocket);
+			fSignalingSocket = -1;
+			return;
+		}
+		if (received < AVDTP_HEADER_SIZE)
+			return;
+		if (AVDTP_GET_MSG_TYPE(buf[0]) == AVDTP_MSG_TYPE_COMMAND)
+			_HandleCommand(buf, received);
+		else {
+			TRACE_AVDTP("Late answer dropped: sig=0x%02x\n", buf[1]);
+		}
+	}
+}
+
+
+/*!	Every command gets an answer (AVDTP 8.4): accepted, refused with an error
+	code, or a general reject for a signal we do not know.
+*/
+void
+AvdtpSession::_HandleCommand(const uint8* buf, size_t length)
+{
+	uint8 label = AVDTP_GET_TX_LABEL(buf[0]);
+	uint8 signalId = buf[1] & 0x3f;
+	const uint8* params = buf + AVDTP_HEADER_SIZE;
+	size_t paramLen = length - AVDTP_HEADER_SIZE;
+
+	TRACE_AVDTP("Command from the device: sig=0x%02x\n", signalId);
+
+	// commands on one stream endpoint name it first: it must be ours
+	bool needsSeid = signalId != AVDTP_DISCOVER;
+	uint8 seid = paramLen > 0 ? params[0] >> 2 : 0;
+	if (needsSeid && signalId <= AVDTP_DELAY_REPORT
+		&& (paramLen < 1 || seid != fLocalSeid)) {
+		uint8 error[2] = { (uint8)(paramLen < 1 ? AVDTP_ERR_BAD_LENGTH
+			: AVDTP_ERR_BAD_ACP_SEID), 0 };
+		size_t errorLen = 1;
+		if (signalId == AVDTP_SET_CONFIGURATION
+			|| signalId == AVDTP_RECONFIGURE) {
+			// service category, then the error
+			error[1] = error[0];
+			error[0] = 0;
+			errorLen = 2;
+		} else if (signalId == AVDTP_START || signalId == AVDTP_SUSPEND) {
+			// the endpoint first, then the error
+			error[1] = error[0];
+			error[0] = seid << 2;
+			errorLen = 2;
+		}
+		_SendResponse(label, AVDTP_MSG_TYPE_RESPONSE_REJECT, signalId, error,
+			errorLen);
+		return;
+	}
+
+	switch (signalId) {
+		case AVDTP_DISCOVER:
+		{
+			// one audio source, in use once configured
+			uint8 sep[2];
+			sep[0] = (fLocalSeid << 2)
+				| (fConfigurationLength > 0 ? 0x02 : 0);
+			sep[1] = (AVDTP_MEDIA_TYPE_AUDIO << 4)
+				| (AVDTP_SEP_SOURCE << 3);
+			_SendResponse(label, AVDTP_MSG_TYPE_RESPONSE_ACCEPT, signalId,
+				sep, sizeof(sep));
+			break;
+		}
+
+		case AVDTP_GET_CAPABILITIES:
+		case AVDTP_GET_ALL_CAPABILITIES:
+		{
+			// Media transport, and SBC at 44.1 kHz in every mode, block
+			// count, subband count and allocation. Only 44.1 kHz, which
+			// every sink takes (A2DP 4.3.2): music comes at that rate, and
+			// a Google Home that configured the stream itself chose 48 kHz,
+			// which our resampling made sound metallic.
+			static const uint8 kCapabilities[] = {
+				AVDTP_MEDIA_TRANSPORT, 0,
+				AVDTP_MEDIA_CODEC, 6, AVDTP_MEDIA_TYPE_AUDIO << 4,
+					AVDTP_CODEC_SBC, 0x2f, 0xff, 2, 53,
+				// the device may tell how late it plays: video is kept in
+				// time with the sound by it
+				AVDTP_DELAY_REPORTING, 0
+			};
+			// delay reporting is AVDTP 1.3: only Get All Capabilities tells
+			// of it (AVDTP 8.8)
+			size_t length = sizeof(kCapabilities);
+			if (signalId == AVDTP_GET_CAPABILITIES)
+				length -= 2;
+			_SendResponse(label, AVDTP_MSG_TYPE_RESPONSE_ACCEPT, signalId,
+				kCapabilities, length);
+			break;
+		}
+
+		case AVDTP_GET_CONFIGURATION:
+			if (fConfigurationLength == 0) {
+				uint8 error = AVDTP_ERR_SEP_NOT_IN_USE;
+				_SendResponse(label, AVDTP_MSG_TYPE_RESPONSE_REJECT, signalId,
+					&error, 1);
+			} else {
+				_SendResponse(label, AVDTP_MSG_TYPE_RESPONSE_ACCEPT, signalId,
+					fConfiguration, fConfigurationLength);
+			}
+			break;
+
+		case AVDTP_SET_CONFIGURATION:
+		{
+			// the device configures our endpoint when it connected to us:
+			// ACP SEID, INT SEID, then the service capabilities, of which
+			// the SBC codec must be one we encode
+			const uint8* codec = NULL;
+			for (size_t offset = 2; offset + 2 <= paramLen;) {
+				uint8 size = params[offset + 1];
+				if (offset + 2 + size > paramLen)
+					break;
+				if (params[offset] == AVDTP_MEDIA_CODEC && size >= 6
+					&& params[offset + 3] == AVDTP_CODEC_SBC)
+					codec = params + offset + 2;
+				offset += 2 + size;
+			}
+			if (fConfigurationLength > 0 || paramLen < 2 || codec == NULL
+				|| paramLen - 2 > sizeof(fConfiguration)) {
+				uint8 error[2] = { AVDTP_MEDIA_CODEC,
+					(uint8)(fConfigurationLength > 0 ? AVDTP_ERR_SEP_IN_USE
+						: AVDTP_ERR_BAD_PAYLOAD_FORMAT) };
+				_SendResponse(label, AVDTP_MSG_TYPE_RESPONSE_REJECT,
+					signalId, error, sizeof(error));
+				break;
+			}
+			fRemoteSeid = params[1] >> 2;
+			fConfigurationLength = paramLen - 2;
+			memcpy(fConfiguration, params + 2, fConfigurationLength);
+			TRACE_AVDTP("The device configured SBC %02x %02x, bitpool %u-%u "
+				"(its SEID %u)\n", codec[2], codec[3], codec[4], codec[5],
+				fRemoteSeid);
+			_SendResponse(label, AVDTP_MSG_TYPE_RESPONSE_ACCEPT, signalId,
+				NULL, 0);
+			break;
+		}
+
+		case AVDTP_RECONFIGURE:
+		{
+			uint8 error[2] = { 0, AVDTP_ERR_NOT_SUPPORTED_COMMAND };
+			_SendResponse(label, AVDTP_MSG_TYPE_RESPONSE_REJECT, signalId,
+				error, sizeof(error));
+			break;
+		}
+
+		case AVDTP_OPEN:
+			fOpened = true;
+			_SendResponse(label, AVDTP_MSG_TYPE_RESPONSE_ACCEPT, signalId,
+				NULL, 0);
+			break;
+
+		case AVDTP_START:
+			fRemoteStarted = true;
+			fRemoteStopped = false;
+			_SendResponse(label, AVDTP_MSG_TYPE_RESPONSE_ACCEPT, signalId,
+				NULL, 0);
+			break;
+
+		case AVDTP_DELAY_REPORT:
+			// ACP SEID, then the delay in tenths of a millisecond
+			if (paramLen >= 3) {
+				fRemoteDelay = (bigtime_t)(params[1] << 8 | params[2]) * 100;
+				TRACE_AVDTP("The device plays %" B_PRId64 " ms late\n",
+					fRemoteDelay / 1000);
+			}
+			_SendResponse(label, AVDTP_MSG_TYPE_RESPONSE_ACCEPT, signalId,
+				NULL, 0);
+			break;
+
+		case AVDTP_SUSPEND:
+		case AVDTP_CLOSE:
+		case AVDTP_ABORT:
+			// the device stops the stream: no more audio to send
+			_SendResponse(label, AVDTP_MSG_TYPE_RESPONSE_ACCEPT, signalId,
+				NULL, 0);
+			fRemoteStopped = true;
+			fRemoteStarted = false;
+			if (signalId != AVDTP_SUSPEND)
+				fConfigurationLength = 0;
+			break;
+
+		case AVDTP_SECURITY_CONTROL:
+		{
+			uint8 error = AVDTP_ERR_NOT_SUPPORTED_COMMAND;
+			_SendResponse(label, AVDTP_MSG_TYPE_RESPONSE_REJECT, signalId,
+				&error, 1);
+			break;
+		}
+
+		default:
+			_SendResponse(label, AVDTP_MSG_TYPE_GENERAL_REJECT, signalId,
+				NULL, 0);
+			break;
+	}
+}
+
+
+status_t
+AvdtpSession::_SendResponse(uint8 label, uint8 msgType, uint8 signalId,
+	const uint8* params, size_t paramLen)
+{
+	uint8 buf[AVDTP_SIGNAL_BUF_SIZE];
+	if (AVDTP_HEADER_SIZE + paramLen > sizeof(buf))
+		return B_BUFFER_OVERFLOW;
+
+	buf[0] = AVDTP_SET_HEADER(label, AVDTP_PKT_TYPE_SINGLE, msgType);
+	buf[1] = signalId;
+	if (paramLen > 0)
+		memcpy(buf + AVDTP_HEADER_SIZE, params, paramLen);
+
+	TRACE_AVDTP("Answer to sig=0x%02x: msg=%u len=%zu\n", signalId, msgType,
+		AVDTP_HEADER_SIZE + paramLen);
+	ssize_t sent = send(fSignalingSocket, buf, AVDTP_HEADER_SIZE + paramLen,
+		0);
+	return sent < 0 ? errno : B_OK;
+}
+
+
+status_t
+AvdtpSession::Listen(uint8 localSeid)
+{
+	if (fListenSocket >= 0)
+		return B_OK;
+	fLocalSeid = localSeid;
+	fListenSocket = socket(PF_BLUETOOTH, SOCK_SEQPACKET,
+		BLUETOOTH_PROTO_L2CAP);
+	if (fListenSocket < 0)
+		return errno;
+	struct sockaddr_l2cap addr;
+	memset(&addr, 0, sizeof(addr));
+	addr.l2cap_len = sizeof(addr);
+	addr.l2cap_family = PF_BLUETOOTH;
+	addr.l2cap_psm = L2CAP_PSM_AVDTP;
+	addr.l2cap_bdaddr = BDADDR_ANY;
+	if (bind(fListenSocket, (struct sockaddr*)&addr, sizeof(addr)) < 0
+		|| listen(fListenSocket, 2) < 0) {
+		status_t status = errno;
+		TRACE_AVDTP("listen on PSM 0x19: %s\n", strerror(status));
+		close(fListenSocket);
+		fListenSocket = -1;
+		return status;
+	}
+	// accept() gives up after a moment: poll() on a listening L2CAP
+	// socket tells of a connection that comes while it waits, not of one
+	// that came just before, so we also ask each time round
+	struct timeval tv = { 0, 50000 };
+	setsockopt(fListenSocket, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+	TRACE_AVDTP("Waiting for the device on PSM 0x19\n");
+	return B_OK;
+}
+
+
+status_t
+AvdtpSession::_Accept(int* fd, bigtime_t timeout)
+{
+	// accept() waits 50 ms each time (see Listen())
+	bigtime_t deadline = timeout < 0 ? B_INFINITE_TIMEOUT
+		: system_time() + timeout;
+	struct sockaddr_l2cap peer;
+	while (true) {
+		socklen_t peerLength = sizeof(peer);
+		*fd = accept(fListenSocket, (struct sockaddr*)&peer, &peerLength);
+		if (*fd >= 0)
+			break;
+		if (errno != B_TIMED_OUT && errno != B_WOULD_BLOCK
+			&& errno != B_INTERRUPTED)
+			return errno;
+		if (system_time() >= deadline)
+			return B_TIMED_OUT;
+	}
+	// it may have taken the short timeout of the listening socket
+	struct timeval tv = { 10, 0 };
+	setsockopt(*fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+	if (fSignalingSocket < 0)
+		memcpy(&fRemoteAddr, &peer.l2cap_bdaddr, sizeof(bdaddr_t));
+	return B_OK;
+}
+
+
+/*!	The device connects the signaling channel, discovers our endpoint,
+	configures it and opens the stream, then connects the media channel
+	(AVDTP 6.11, the device as initiator).
+*/
+status_t
+AvdtpSession::WaitForStream(bigtime_t timeout, bdaddr_t* remote)
+{
+	if (fListenSocket < 0)
+		return B_NO_INIT;
+
+	status_t status = _Accept(&fSignalingSocket, timeout);
+	if (status != B_OK)
+		return status;
+	*remote = fRemoteAddr;
+	TRACE_AVDTP("The device connected the signaling channel\n");
+
+	// Its commands, until the stream is open. A Google Home connects a
+	// second channel right after the first one, closes the first and goes
+	// on with the second: a channel that comes now takes over.
+	fConfigurationLength = 0;
+	fOpened = fRemoteStarted = fRemoteStopped = false;
+	bigtime_t deadline = system_time() + 20000000;
+	uint8 buf[AVDTP_SIGNAL_BUF_SIZE];
+	while (!fOpened && system_time() < deadline) {
+		int fd;
+		if (_Accept(&fd, 0) == B_OK) {
+			{
+				TRACE_AVDTP("The device connected another signaling "
+					"channel: it takes over\n");
+				if (fSignalingSocket >= 0)
+					close(fSignalingSocket);
+				fSignalingSocket = fd;
+				fConfigurationLength = 0;
+				fOpened = false;
+			}
+			continue;
+		}
+		if (fSignalingSocket < 0)
+			continue;
+		struct pollfd poller = { fSignalingSocket, POLLIN, 0 };
+		if (poll(&poller, 1, 200) <= 0)
+			continue;
+
+		ssize_t received = recv(fSignalingSocket, buf, sizeof(buf), 0);
+		if (received <= 0) {
+			// it may come back on another channel, within the deadline
+			TRACE_AVDTP("The device closed the signaling channel\n");
+			close(fSignalingSocket);
+			fSignalingSocket = -1;
+			fConfigurationLength = 0;
+			continue;
+		}
+		if (received >= AVDTP_HEADER_SIZE
+			&& AVDTP_GET_MSG_TYPE(buf[0]) == AVDTP_MSG_TYPE_COMMAND)
+			_HandleCommand(buf, received);
+	}
+	if (!fOpened || fConfigurationLength == 0) {
+		TRACE_AVDTP("The device did not open a stream\n");
+		return B_TIMED_OUT;
+	}
+
+	// then the media channel
+	status = _Accept(&fMediaSocket, 10000000);
+	if (status != B_OK) {
+		TRACE_AVDTP("No media channel: %s\n", strerror(status));
+		return status;
+	}
+	TRACE_AVDTP("The device connected the media channel\n");
+	return B_OK;
+}
+
+
+uint8
+AvdtpSession::_NextTxLabel()
+{
+	uint8 label = fTxLabel;
+	fTxLabel = (fTxLabel + 1) & 0x0F;
+	return label;
+}
