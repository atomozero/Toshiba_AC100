+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+/*!	HDMI output of the Tegra 2: while a screen is plugged in, display
+	controller B scans out the panel's frame buffer, scaled to the screen's
+	mode, and the HDMI block sends it out as TMDS.
+
+	The register descriptions of the HDMI block are not in the public
+	Technical Reference Manual; the register layout and the power up
+	sequence follow the Linux tegra-drm driver, used as documentation only.
+	On the Toshiba AC100 the HDMI block is powered by LDO7 (AVDD_HDMI,
+	3.3 V) and LDO8 (AVDD_HDMI_PLL, 1.8 V) of the TPS6586x, the hot plug
+	detect line is GPIO N7 and the DDC bus is I2C2.
+*/
+
+
+#include "hdmi.h"
+#include "tegra_dc_info.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <KernelExport.h>
+#include <OS.h>
+#include <driver_settings.h>
+#include <lock.h>
+#include <util/AutoLock.h>
+
+
+#define ERROR(x...) dprintf("tegra_dc: hdmi: " x)
+
+
+extern "C" status_t arm_dvc_i2c_read(uint8 address, uint8 reg, uint8* data,
+	uint32 length);
+extern "C" status_t arm_dvc_i2c_write(uint8 address, uint8 reg,
+	const uint8* data, uint32 length);
+
+
+// TPS6586x power management IC
+#define TPS6586X_ADDRESS			0x34
+#define TPS6586X_SUPPLYENC			0x12
+#define TPS6586X_SUPPLYEND			0x13
+#define TPS6586X_LDO7				(1 << 5)	// AVDD_HDMI
+#define TPS6586X_LDO8				(1 << 6)	// AVDD_HDMI_PLL
+
+// Clock and reset controller
+#define TEGRA20_CAR_BASE			0x60006000
+#define CAR_RST_DEVICES_L			0x004
+#define CAR_RST_DEVICES_H			0x008
+#define CAR_CLK_OUT_ENB_L			0x010
+#define CAR_CLK_OUT_ENB_H			0x014
+#define CAR_PLLD_BASE				0x0d0
+#define CAR_PLLD_MISC				0x0dc
+#define CAR_CLK_SOURCE_DISP2		0x13c
+#define CAR_CLK_SOURCE_HDMI			0x18c
+#define CAR_CLK_SOURCE_I2C2			0x198
+#define CAR_DISP2_BIT				(1u << 26)	// in the L registers
+#define CAR_HDMI_BIT				(1u << 19)	// in the H registers
+#define CAR_I2C2_BIT				(1u << 22)	// in the H registers
+#define CAR_SOURCE_PLL_D_OUT0		(1u << 30)
+#define CAR_SOURCE_PLL_P			(0u << 30)
+
+#define PLLD_BYPASS					(1u << 31)
