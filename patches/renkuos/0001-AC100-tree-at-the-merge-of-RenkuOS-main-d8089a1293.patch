@@ -0,0 +1,608 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+#include "AvrcpTarget.h"
+
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <Autolock.h>
+#include <OS.h>
+
+#include <bluetooth/L2CAP/btL2CAP.h>
+
+
+static const uint16 kPsmAvctp = 0x0017;
+static const uint16 kAvrcpProfile = 0x110e;
+static const uint8 kPanel = 0x09 << 3;
+
+enum {
+	kCtypeControl = 0x0,
+	kCtypeStatus = 0x1,
+	kCtypeNotify = 0x3,
+	kResponseNotImplemented = 0x8,
+	kResponseAccepted = 0x9,
+	kResponseRejected = 0xa,
+	kResponseStable = 0xc,
+	kResponseChanged = 0xd,
+	kResponseInterim = 0xf
+};
+
+enum {
+	kOpcodeVendor = 0x00,
+	kOpcodeUnitInfo = 0x30,
+	kOpcodeSubunitInfo = 0x31,
+	kOpcodePassThrough = 0x7c
+};
+
+enum {
+	kPduGetCapabilities = 0x10,
+	kPduListSettingAttributes = 0x11,
+	kPduInformCharacterSet = 0x17,
+	kPduInformBattery = 0x18,
+	kPduGetElementAttributes = 0x20,
+	kPduGetPlayStatus = 0x30,
+	kPduRegisterNotification = 0x31,
+	kPduSetAbsoluteVolume = 0x50
+};
+
+enum {
+	kEventPlaybackStatus = 0x01,
+	kEventTrackChanged = 0x02,
+	kEventVolumeChanged = 0x0d
+};
+
+enum {
+	kErrorInvalidCommand = 0x00,
+	kErrorInvalidParameter = 0x01
+};
+
+
+static void
+Write32(uint8* data, uint32 value)
+{
+	data[0] = value >> 24;
+	data[1] = value >> 16;
+	data[2] = value >> 8;
+	data[3] = value;
+}
+
+
+AvrcpTarget::AvrcpTarget()
+	:
+	fLock("avrcp target"),
+	fServer(-1),
+	fChannel(-1),
+	fNextLabel(0),
+	fLength(-1),
+	fPlaying(false),
+	fPosition(0),
+	fStatusLabel(-1),
+	fTrackLabel(-1),
+	fWantedVolume(-1),
+	fRemoteVolume(-1),
+	fButton(0)
+{
+}
+
+
+AvrcpTarget::~AvrcpTarget()
+{
+	if (fServer >= 0)
+		close(fServer);
+	if (fChannel >= 0)
+		close(fChannel);
+}
+
+
+status_t
+AvrcpTarget::Listen()
+{
+	fServer = socket(PF_BLUETOOTH, SOCK_SEQPACKET, BLUETOOTH_PROTO_L2CAP);
+	if (fServer < 0)
+		return errno;
+	struct sockaddr_l2cap address;
+	memset(&address, 0, sizeof(address));
+	address.l2cap_len = sizeof(address);
+	address.l2cap_family = AF_BLUETOOTH;
+	address.l2cap_psm = kPsmAvctp;
+	address.l2cap_bdaddr = BDADDR_ANY;
+	if (bind(fServer, (struct sockaddr*)&address, sizeof(address)) < 0
+		|| listen(fServer, 2) < 0) {
+		status_t status = errno;
+		printf("AVRCP: listen on PSM 0x17: %s\n", strerror(status));
+		close(fServer);
+		fServer = -1;
+		return status;
+	}
+	resume_thread(spawn_thread(_ListenThread, "avrcp listen",
+		B_NORMAL_PRIORITY, this));
+	return B_OK;
+}
+
+
+status_t
+AvrcpTarget::Connect(const bdaddr_t& address)
+{
+	if (fChannel >= 0)
+		return B_OK;
+	int fd = socket(PF_BLUETOOTH, SOCK_SEQPACKET, BLUETOOTH_PROTO_L2CAP);
+	if (fd < 0)
+		return errno;
+	struct sockaddr_l2cap remote;
+	memset(&remote, 0, sizeof(remote));
+	remote.l2cap_len = sizeof(remote);
+	remote.l2cap_family = AF_BLUETOOTH;
+	remote.l2cap_psm = kPsmAvctp;
+	remote.l2cap_bdaddr = address;
+	if (connect(fd, (struct sockaddr*)&remote, sizeof(remote)) < 0) {
+		status_t status = errno;
+		close(fd);
+		return status;
+	}
+	if (fChannel >= 0) {
+		// the speakers were quicker
+		close(fd);
+		return B_OK;
+	}
+	printf("AVRCP: remote control channel opened\n");
+	_Start(fd);
+	return B_OK;
+}
+
+
+void
+AvrcpTarget::SetTrack(const char* title, const char* artist,
+	const char* album, int32 lengthMs)
+{
+	int32 label;
+	{
+		BAutolock _(fLock);
+		fTitle = title;
+		fArtist = artist;
+		fAlbum = album;
+		fLength = lengthMs;
+		label = fTrackLabel;
+		fTrackLabel = -1;
+	}
+	if (label >= 0) {
+		uint8 answer[9] = { kEventTrackChanged };
+		_SendVendor(label, true, kResponseChanged, kPduRegisterNotification,
+			answer, sizeof(answer));
+	}
+}
+
+
+void
+AvrcpTarget::SetStatus(bool playing, int32 positionMs)
+{
+	int32 label = -1;
+	{
+		BAutolock _(fLock);
+		fPosition = positionMs;
+		if (playing == fPlaying)
+			return;
+		fPlaying = playing;
+		label = fStatusLabel;
+		fStatusLabel = -1;
+	}
+	if (label >= 0) {
+		uint8 answer[] = { kEventPlaybackStatus, (uint8)(playing ? 1 : 2) };
+		_SendVendor(label, true, kResponseChanged, kPduRegisterNotification,
+			answer, sizeof(answer));
+	}
+}
+
+
+void
+AvrcpTarget::SetRemoteVolume(int32 volume)
+{
+	fWantedVolume = volume > 127 ? 127 : volume;
+	if (fChannel >= 0 && fWantedVolume >= 0) {
+		uint8 value = fWantedVolume;
+		_SendVendor(_NextLabel(), false, kCtypeControl,
+			kPduSetAbsoluteVolume, &value, 1);
+	}
+}
+
+
+int32
+AvrcpTarget::TakeButton()
+{
+	return atomic_get_and_set(&fButton, 0);
+}
+
+
+// #pragma mark - private
+
+
+status_t
+AvrcpTarget::_ListenThread(void* self)
+{
+	AvrcpTarget* target = (AvrcpTarget*)self;
+	while (true) {
+		struct sockaddr_l2cap peer;
+		socklen_t peerLength = sizeof(peer);
+		int fd = accept(target->fServer, (struct sockaddr*)&peer,
+			&peerLength);
+		if (fd < 0) {
+			if (errno == B_INTERRUPTED)
+				continue;
+			break;
+		}
+		if (target->fChannel >= 0) {
+			close(fd);
+			continue;
+		}
+		printf("AVRCP: the speakers opened the remote control channel\n");
+		target->_Start(fd);
+	}
+	return B_OK;
+}
+
+
+void
+AvrcpTarget::_Start(int fd)
+{
+	fChannel = fd;
+	resume_thread(spawn_thread(_ReceiveThread, "avrcp", B_NORMAL_PRIORITY,
+		this));
+	resume_thread(spawn_thread(_SetUpThread, "avrcp set up",
+		B_NORMAL_PRIORITY, this));
+}
+
+
+/*!	As a controller: their volume, which they tell us when it changes. */
+status_t
+AvrcpTarget::_SetUpThread(void* self)
+{
+	AvrcpTarget* target = (AvrcpTarget*)self;
+	snooze(500000);
+	uint8 params[] = { kEventVolumeChanged, 0, 0, 0, 0 };
+	target->_SendVendor(target->_NextLabel(), false, kCtypeNotify,
+		kPduRegisterNotification, params, sizeof(params));
+	if (target->fWantedVolume >= 0) {
+		snooze(200000);
+		target->SetRemoteVolume(target->fWantedVolume);
+	}
+	return B_OK;
+}
+
+
+status_t
+AvrcpTarget::_ReceiveThread(void* self)
+{
+	AvrcpTarget* target = (AvrcpTarget*)self;
+	uint8 packet[1024];
+	while (true) {
+		ssize_t received = recv(target->fChannel, packet, sizeof(packet), 0);
+		if (received < 0 && errno == B_INTERRUPTED)
+			continue;
+		if (received <= 0)
+			break;
+		// single packets only
+		if (received < 6 || ((packet[0] >> 2) & 0x3) != 0)
+			continue;
+		uint8 label = packet[0] >> 4;
+		bool response = (packet[0] & 0x02) != 0;
+		uint16 profile = packet[1] << 8 | packet[2];
+		if (profile != kAvrcpProfile) {
+			if (!response) {
+				// "invalid profile identifier"
+				packet[0] |= 0x03;
+				send(target->fChannel, packet, 3, 0);
+			}
+			continue;
+		}
+		if (response)
+			target->_HandleResponse(packet + 3, received - 3);
+		else
+			target->_HandleCommand(label, packet + 3, received - 3);
+	}
+
+	printf("AVRCP: remote control channel closed\n");
+	int channel = target->fChannel;
+	target->fChannel = -1;
+	close(channel);
+	BAutolock _(target->fLock);
+	target->fStatusLabel = target->fTrackLabel = -1;
+	return B_OK;
+}
+
+
+uint8
+AvrcpTarget::_NextLabel()
+{
+	return (uint8)(atomic_add(&fNextLabel, 1) & 0x0f);
+}
+
+
+void
+AvrcpTarget::_Send(uint8 label, bool response, const uint8* frame,
+	size_t length)
+{
+	int channel = fChannel;
+	if (channel < 0)
+		return;
+	uint8 packet[515];
+	packet[0] = label << 4 | (response ? 0x02 : 0x00);
+	packet[1] = kAvrcpProfile >> 8;
+	packet[2] = kAvrcpProfile & 0xff;
+	if (length > sizeof(packet) - 3)
+		length = sizeof(packet) - 3;
+	memcpy(packet + 3, frame, length);
+	send(channel, packet, 3 + length, 0);
+}
+
+
+void
+AvrcpTarget::_SendVendor(uint8 label, bool response, uint8 code, uint8 pdu,
+	const uint8* data, uint16 length)
+{
+	uint8 frame[512];
+	frame[0] = code;
+	frame[1] = kPanel;
+	frame[2] = kOpcodeVendor;
+	frame[3] = 0x00;
+	frame[4] = 0x19;
+	frame[5] = 0x58;
+	frame[6] = pdu;
+	frame[7] = 0;	// single packet
+	if (length > sizeof(frame) - 10)
+		length = sizeof(frame) - 10;
+	frame[8] = length >> 8;
+	frame[9] = length & 0xff;
+	if (length > 0)
+		memcpy(frame + 10, data, length);
+	_Send(label, response, frame, 10 + length);
+}
+
+
+void
+AvrcpTarget::_HandleCommand(uint8 label, const uint8* frame, size_t length)
+{
+	if (length < 3)
+		return;
+	switch (frame[2]) {
+		case kOpcodeUnitInfo:
+		{
+			uint8 answer[] = { kResponseStable, 0xff, kOpcodeUnitInfo, 0x07,
+				kPanel, 0x00, 0x19, 0x58 };
+			_Send(label, true, answer, sizeof(answer));
+			break;
+		}
+
+		case kOpcodeSubunitInfo:
+		{
+			uint8 answer[] = { kResponseStable, 0xff, kOpcodeSubunitInfo,
+				0x07, kPanel, 0xff, 0xff, 0xff };
+			_Send(label, true, answer, sizeof(answer));
+			break;
+		}
+
+		case kOpcodeVendor:
+			_HandleVendor(label, frame, length);
+			break;
+
+		case kOpcodePassThrough:
+		{
+			if (length >= 4 && (frame[3] & 0x80) == 0) {
+				uint8 operation = frame[3] & 0x7f;
+				printf("AVRCP: button %#x on the speakers\n", operation);
+				atomic_set(&fButton, operation);
+			}
+			uint8 copy[16];
+			size_t size = min_c(length, sizeof(copy));
+			memcpy(copy, frame, size);
+			copy[0] = kResponseAccepted;
+			_Send(label, true, copy, size);
+			break;
+		}
+
+		default:
+		{
+			uint8 copy[16];
+			size_t size = min_c(length, sizeof(copy));
+			memcpy(copy, frame, size);
+			copy[0] = kResponseNotImplemented;
+			_Send(label, true, copy, size);
+			break;
+		}
+	}
+}
+
+
+void
+AvrcpTarget::_HandleVendor(uint8 label, const uint8* frame, size_t length)
+{
+	if (length < 10) {
+		uint8 copy[16];
+		memcpy(copy, frame, min_c(length, sizeof(copy)));
+		copy[0] = kResponseNotImplemented;
+		_Send(label, true, copy, min_c(length, sizeof(copy)));
+		return;
+	}
+	uint8 pdu = frame[6];
+	const uint8* params = frame + 10;
+	size_t paramLength = frame[8] << 8 | frame[9];
+	if (10 + paramLength > length)
+		paramLength = length - 10;
+	printf("AVRCP: the speakers ask PDU %#x\n", pdu);
+
+	switch (pdu) {
+		case kPduGetCapabilities:
+			if (paramLength >= 1 && params[0] == 0x02) {
+				uint8 answer[] = { 0x02, 1, 0x00, 0x19, 0x58 };
+				_SendVendor(label, true, kResponseStable, pdu, answer,
+					sizeof(answer));
+			} else if (paramLength >= 1 && params[0] == 0x03) {
+				uint8 answer[] = { 0x03, 2, kEventPlaybackStatus,
+					kEventTrackChanged };
+				_SendVendor(label, true, kResponseStable, pdu, answer,
+					sizeof(answer));
+			} else {
+				uint8 error = kErrorInvalidParameter;
+				_SendVendor(label, true, kResponseRejected, pdu, &error, 1);
+			}
+			break;
+
+		case kPduListSettingAttributes:
+		{
+			// no equalizer, repeat or shuffle settings
+			uint8 none = 0;
+			_SendVendor(label, true, kResponseStable, pdu, &none, 1);
+			break;
+		}
+
+		case kPduInformCharacterSet:
+		case kPduInformBattery:
+			_SendVendor(label, true, kResponseAccepted, pdu, NULL, 0);
+			break;
+
+		case kPduGetElementAttributes:
+			_SendElementAttributes(label, params, paramLength);
+			break;
+
+		case kPduGetPlayStatus:
+		{
+			uint8 answer[9];
+			BAutolock _(fLock);
+			Write32(answer, fLength >= 0 ? fLength : 0xffffffff);
+			Write32(answer + 4, fPosition);
+			answer[8] = fPlaying ? 1 : 2;
+			_SendVendor(label, true, kResponseStable, pdu, answer,
+				sizeof(answer));
+			break;
+		}
+
+		case kPduRegisterNotification:
+		{
+			uint8 event = paramLength >= 1 ? params[0] : 0;
+			BAutolock _(fLock);
+			if (event == kEventPlaybackStatus) {
+				fStatusLabel = label;
+				uint8 answer[] = { event, (uint8)(fPlaying ? 1 : 2) };
+				_SendVendor(label, true, kResponseInterim, pdu, answer,
+					sizeof(answer));
+			} else if (event == kEventTrackChanged) {
+				fTrackLabel = label;
+				// identifier 0: a track is selected
+				uint8 answer[9] = { event };
+				_SendVendor(label, true, kResponseInterim, pdu, answer,
+					sizeof(answer));
+			} else {
+				uint8 error = kErrorInvalidParameter;
+				_SendVendor(label, true, kResponseRejected, pdu, &error, 1);
+			}
+			break;
+		}
+
+		default:
+		{
+			uint8 error = kErrorInvalidCommand;
+			_SendVendor(label, true, kResponseRejected, pdu, &error, 1);
+			break;
+		}
+	}
+}
+
+
+/*!	Title, artist, album and length (in ms, as text): those asked for, or
+	all of them when none is named.
+*/
+void
+AvrcpTarget::_SendElementAttributes(uint8 label, const uint8* params,
+	size_t length)
+{
+	uint32 wanted[8];
+	uint8 count = 0;
+	if (length >= 9 && params[8] > 0) {
+		for (uint8 i = 0; i < params[8] && count < 8
+				&& 9 + 4 * (size_t)i + 4 <= length; i++) {
+			const uint8* id = params + 9 + 4 * i;
+			wanted[count++] = (uint32)id[0] << 24 | id[1] << 16 | id[2] << 8
+				| id[3];
+		}
+	} else {
+		wanted[0] = 1;
+		wanted[1] = 2;
+		wanted[2] = 3;
+		wanted[3] = 7;
+		count = 4;
+	}
+
+	BAutolock _(fLock);
+	uint8 answer[500];
+	size_t offset = 1;
+	uint8 written = 0;
+	for (uint8 i = 0; i < count; i++) {
+		BString value;
+		switch (wanted[i]) {
+			case 1: value = fTitle; break;
+			case 2: value = fArtist; break;
+			case 3: value = fAlbum; break;
+			case 7:
+				if (fLength >= 0)
+					value.SetToFormat("%" B_PRId32, fLength);
+				break;
+			default:
+				continue;
+		}
+		size_t size = min_c((size_t)value.Length(), (size_t)120);
+		if (offset + 8 + size > sizeof(answer))
+			break;
+		Write32(answer + offset, wanted[i]);
+		answer[offset + 4] = 0x00;	// UTF-8
+		answer[offset + 5] = 0x6a;
+		answer[offset + 6] = size >> 8;
+		answer[offset + 7] = size & 0xff;
+		memcpy(answer + offset + 8, value.String(), size);
+		offset += 8 + size;
+		written++;
+	}
+	answer[0] = written;
+	_SendVendor(label, true, kResponseStable, kPduGetElementAttributes,
+		answer, offset);
+}
+
+
+/*!	The answers of the speakers to our commands: their volume. */
+void
+AvrcpTarget::_HandleResponse(const uint8* frame, size_t length)
+{
+	if (length < 10 || frame[2] != kOpcodeVendor)
+		return;
+	uint8 code = frame[0] & 0x0f;
+	uint8 pdu = frame[6];
+	const uint8* params = frame + 10;
+	size_t paramLength = frame[8] << 8 | frame[9];
+	if (10 + paramLength > length)
+		paramLength = length - 10;
+
+	if (code == kResponseRejected || code == kResponseNotImplemented) {
+		printf("AVRCP: the speakers refused PDU %#x\n", pdu);
+		return;
+	}
+
+	if (pdu == kPduRegisterNotification && paramLength >= 2
+		&& params[0] == kEventVolumeChanged) {
+		fRemoteVolume = params[1] & 0x7f;
+		printf("AVRCP: speaker volume %" B_PRId32 "/127 (%" B_PRId32 "%%)\n",
+			fRemoteVolume, fRemoteVolume * 100 / 127);
+		if (code == kResponseChanged) {
+			uint8 again[] = { kEventVolumeChanged, 0, 0, 0, 0 };
+			_SendVendor(_NextLabel(), false, kCtypeNotify,
+				kPduRegisterNotification, again, sizeof(again));
+		}
+	} else if (pdu == kPduSetAbsoluteVolume && paramLength >= 1) {
+		fRemoteVolume = params[0] & 0x7f;
+		printf("AVRCP: speaker volume set to %" B_PRId32 "/127\n",
+			fRemoteVolume);
+	}
+}
