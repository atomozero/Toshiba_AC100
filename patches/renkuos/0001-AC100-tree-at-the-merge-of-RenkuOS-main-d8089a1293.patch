@@ -0,0 +1,90 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ *
+ * AvrcpTarget: the remote control side of an A2DP source. The speakers
+ * (a Google Home, headphones) open AVCTP to the source to show and control
+ * what it plays: the target answers with the song and the playback status,
+ * takes their buttons, and sets their volume (AVRCP 1.4 absolute volume).
+ */
+#ifndef AVRCP_TARGET_H
+#define AVRCP_TARGET_H
+
+
+#include <Locker.h>
+#include <String.h>
+
+#include <bluetooth/bluetooth.h>
+
+
+class AvrcpTarget {
+public:
+								AvrcpTarget();
+								~AvrcpTarget();
+
+			// waits for the speakers on PSM 0x17
+			status_t			Listen();
+			// opens the channel if the speakers did not
+			status_t			Connect(const bdaddr_t& address);
+			bool				IsConnected() const { return fChannel >= 0; }
+
+			void				SetTrack(const char* title,
+									const char* artist, const char* album,
+									int32 lengthMs);
+			// tells the speakers when the status changed
+			void				SetStatus(bool playing, int32 positionMs);
+
+			// the speakers' volume, 0 to 127, set as soon as the channel is
+			// up; -1 leaves it as it is
+			void				SetRemoteVolume(int32 volume);
+			int32				RemoteVolume() const { return fRemoteVolume; }
+
+			// a button pressed on the speakers (AV/C operation: play 0x44,
+			// stop 0x45, pause 0x46, next 0x4b, previous 0x4c), 0 if none
+			int32				TakeButton();
+
+private:
+	static	status_t			_ListenThread(void* self);
+	static	status_t			_ReceiveThread(void* self);
+	static	status_t			_SetUpThread(void* self);
+
+			void				_Start(int fd);
+			void				_Send(uint8 label, bool response,
+									const uint8* frame, size_t length);
+			void				_SendVendor(uint8 label, bool response,
+									uint8 code, uint8 pdu, const uint8* data,
+									uint16 length);
+			uint8				_NextLabel();
+
+			void				_HandleCommand(uint8 label,
+									const uint8* frame, size_t length);
+			void				_HandleVendor(uint8 label,
+									const uint8* frame, size_t length);
+			void				_HandleResponse(const uint8* frame,
+									size_t length);
+			void				_SendElementAttributes(uint8 label,
+									const uint8* params, size_t length);
+
+private:
+			BLocker				fLock;
+			int					fServer;
+			int					fChannel;
+			int32				fNextLabel;
+
+			BString				fTitle;
+			BString				fArtist;
+			BString				fAlbum;
+			int32				fLength;
+			bool				fPlaying;
+			int32				fPosition;
+
+			int32				fStatusLabel;
+			int32				fTrackLabel;
+
+			int32				fWantedVolume;
+			int32				fRemoteVolume;
+			int32				fButton;
+};
+
+
+#endif	// AVRCP_TARGET_H
