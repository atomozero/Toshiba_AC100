@@ -0,0 +1,138 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ *
+ * BluetoothAudioNode: an audio output of the Media Kit that plays through
+ * Bluetooth speakers or headphones (A2DP source).
+ *
+ * The node only puts the audio of the mixer in a ring; a thread of its own
+ * looks after the link: it sends what the ring holds while the stream
+ * runs, calls the speakers when sound comes and they are not there, takes
+ * them when they connect by themselves, and suspends the stream after a
+ * few seconds of silence, so that they can go to sleep.
+ */
+#ifndef BLUETOOTH_AUDIO_NODE_H
+#define BLUETOOTH_AUDIO_NODE_H
+
+
+#include <BufferConsumer.h>
+#include <Controllable.h>
+#include <Locker.h>
+#include <MediaEventLooper.h>
+#include <String.h>
+#include <TimeSource.h>
+
+#include <bluetooth/bluetooth.h>
+
+
+class BluetoothAudioAddOn;
+
+
+class BluetoothAudioNode : public BBufferConsumer, public BControllable,
+	public BTimeSource, public BMediaEventLooper {
+public:
+								BluetoothAudioNode(BluetoothAudioAddOn* addOn,
+									int32 flavorId, const bdaddr_t& address,
+									const char* name);
+	virtual						~BluetoothAudioNode();
+
+	// BMediaNode
+	virtual	BMediaAddOn*		AddOn(int32* _internalId) const;
+	virtual	void				NodeRegistered();
+	virtual	status_t			HandleMessage(int32 message,
+									const void* data, size_t size);
+
+	// BMediaEventLooper
+	virtual	void				HandleEvent(const media_timed_event* event,
+									bigtime_t lateness,
+									bool realTimeEvent = false);
+
+	// BBufferConsumer
+	virtual	status_t			AcceptFormat(
+									const media_destination& destination,
+									media_format* format);
+	virtual	status_t			GetNextInput(int32* cookie,
+									media_input* _input);
+	virtual	void				DisposeInputCookie(int32 cookie);
+	virtual	void				BufferReceived(BBuffer* buffer);
+	virtual	void				ProducerDataStatus(
+									const media_destination& forWhom,
+									int32 status,
+									bigtime_t atPerformanceTime);
+	virtual	status_t			GetLatencyFor(
+									const media_destination& forWhom,
+									bigtime_t* _latency,
+									media_node_id* _timesource);
+	virtual	status_t			Connected(const media_source& producer,
+									const media_destination& where,
+									const media_format& withFormat,
+									media_input* _input);
+	virtual	void				Disconnected(const media_source& producer,
+									const media_destination& where);
+	virtual	status_t			FormatChanged(const media_source& producer,
+									const media_destination& consumer,
+									int32 changeTag,
+									const media_format& format);
+
+	// BTimeSource: the clock of the output, as with a sound card; the
+	// media server takes the default output for the clock of the system
+	virtual	status_t			TimeSourceOp(const time_source_op_info& op,
+									void* _reserved);
+	virtual	void				SetRunMode(run_mode mode);
+
+	// BControllable
+	virtual	status_t			GetParameterValue(int32 id,
+									bigtime_t* lastChange, void* value,
+									size_t* ioSize);
+	virtual	void				SetParameterValue(int32 id, bigtime_t when,
+									const void* value, size_t size);
+
+private:
+	static	status_t			_ClockThread(void* self);
+	static	status_t			_LinkThread(void* self);
+			void				_Link();
+			void				_Put(const int16* samples, int32 frames);
+			int32				_Get(int16* samples, int32 frames);
+			int32				_Available();
+			void				_Drop(int32 keepFrames);
+			bool				_SoundSince(bigtime_t time);
+			bigtime_t			_SoundStarted();
+			void				_ControlPlayer(int32 button);
+
+private:
+			BluetoothAudioAddOn* fAddOn;
+			int32				fFlavorId;
+			bdaddr_t			fAddress;
+			BString				fName;
+
+			media_input			fInput;
+
+			// the audio of the mixer: 44.1 kHz stereo, 16-bit
+			BLocker				fRingLock;
+			int16*				fRing;
+			int32				fRingFrames;
+			int32				fRead;
+			int32				fWrite;
+			sem_id				fDataSem;
+			bigtime_t			fLastSound;
+			bigtime_t			fSoundStarted;
+
+			thread_id			fLinkThread;
+			thread_id			fClockThread;
+			BLocker				fClockLock;
+			bool				fClockRunning;
+			bigtime_t			fPerformanceBase;	// at fRealBase
+			bigtime_t			fRealBase;
+			volatile bool		fQuitting;
+
+			// how late the speakers play what they get: the latency of the
+			// output, so that video keeps time with the sound
+			bigtime_t			fOutputDelay;
+
+			float				fVolume;		// of the speakers, 0 to 1
+			bigtime_t			fVolumeChanged;
+			volatile bool		fVolumeDirty;
+};
+
+
+#endif	// BLUETOOTH_AUDIO_NODE_H
diff --git a/src/add-ons/media/media-add-ons/bluetooth_audio/FfmpegSbc.c b/src/add-ons/media/media-add-ons/bluetooth_audio/FfmpegSbc.c
new file mode 100644
index 0000000000..6cb0b683f5
--- /dev/null
+++ b/src/add-ons/media/media-add-ons/bluetooth_audio/FfmpegSbc.c
@@ -0,0 +1,153 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ *
+ * The SBC encoder of FFmpeg, for A2DP.
+ *
+ * FFmpeg picks the frame layout from the bit rate and the delay: joint
+ * stereo only below 180 kbit/s or above 420 kbit/s, 4 subbands above
+ * 420 kbit/s or 270 kbit/s (mono), the blocks from the delay. The bitpool
+ * is set apart with global_quality. So the bit rate here only chooses the
+ * layout, and the first frame is checked against what A2DP negotiated.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <libavcodec/avcodec.h>
+#include <libavutil/channel_layout.h>
+#include <libavutil/opt.h>
+
+#include "FfmpegSbc.h"
+
+
+struct ffsbc {
+	AVCodecContext*	context;
+	AVFrame*		frame;
+	AVPacket*		packet;
+	uint8_t			header[3];
+	int				checked;
+};
+
+
+struct ffsbc*
+ffsbc_open(int rate, int channels, int blocks, int subbands, int mode,
+	int allocation, int bitpool)
+{
+	if (allocation != 0) {
+		fprintf(stderr, "FFmpeg SBC: only the loudness allocation\n");
+		return NULL;
+	}
+	if (mode == 1) {
+		fprintf(stderr, "FFmpeg SBC: no dual channel\n");
+		return NULL;
+	}
+	const AVCodec* codec = avcodec_find_encoder(AV_CODEC_ID_SBC);
+	if (codec == NULL)
+		return NULL;
+
+	struct ffsbc* sbc = calloc(1, sizeof(*sbc));
+	sbc->context = avcodec_alloc_context3(codec);
+	AVCodecContext* c = sbc->context;
+	c->sample_rate = rate;
+	c->sample_fmt = AV_SAMPLE_FMT_S16;
+	av_channel_layout_default(&c->ch_layout, channels);
+
+	// the layout: joint stereo below 180 kbit/s, stereo between 180 and
+	// 420, 8 subbands unless above 420
+	if (mode == 3)
+		c->bit_rate = subbands == 8 ? 170000 : 500000;
+	else
+		c->bit_rate = subbands == 8 ? 200000 : 430000;
+	if (mode == 2 && subbands == 4) {
+		fprintf(stderr, "FFmpeg SBC: no stereo with 4 subbands\n");
+		avcodec_free_context(&sbc->context);
+		free(sbc);
+		return NULL;
+	}
+	c->global_quality = bitpool * FF_QP2LAMBDA;
+
+	// the blocks come from the delay: ((blocks + 10) * subbands) / rate
+	char delay[32];
+	snprintf(delay, sizeof(delay), "%dus",
+		(int)((int64_t)(blocks + 10) * subbands * 1000000 / rate) + 1);
+	AVDictionary* options = NULL;
+	av_dict_set(&options, "sbc_delay", delay, 0);
+	int error = avcodec_open2(c, codec, &options);
+	av_dict_free(&options);
+	if (error < 0) {
+		fprintf(stderr, "FFmpeg SBC: cannot open the encoder\n");
+		avcodec_free_context(&sbc->context);
+		free(sbc);
+		return NULL;
+	}
+
+	sbc->frame = av_frame_alloc();
+	sbc->frame->nb_samples = c->frame_size;
+	sbc->frame->format = AV_SAMPLE_FMT_S16;
+	av_channel_layout_copy(&sbc->frame->ch_layout, &c->ch_layout);
+	av_frame_get_buffer(sbc->frame, 0);
+	sbc->packet = av_packet_alloc();
+
+	// the header A2DP expects: rate, blocks, mode, allocation, subbands
+	int rates[] = { 16000, 32000, 44100, 48000 };
+	int rateIndex = 0;
+	for (int i = 0; i < 4; i++)
+		if (rates[i] == rate)
+			rateIndex = i;
+	sbc->header[0] = 0x9c;
+	sbc->header[1] = rateIndex << 6 | ((blocks >> 2) - 1) << 4 | mode << 2
+		| allocation << 1 | (subbands == 8);
+	sbc->header[2] = bitpool;
+	if (c->frame_size != blocks * subbands)
+		fprintf(stderr, "FFmpeg SBC: %d samples a frame, not %d\n",
+			c->frame_size, blocks * subbands);
+	return sbc;
+}
+
+
+int
+ffsbc_encode(struct ffsbc* sbc, const int16_t* input, uint8_t* output,
+	int size)
+{
+	AVCodecContext* c = sbc->context;
+	av_frame_make_writable(sbc->frame);
+	memcpy(sbc->frame->data[0], input,
+		c->frame_size * c->ch_layout.nb_channels * sizeof(int16_t));
+	if (avcodec_send_frame(c, sbc->frame) < 0
+		|| avcodec_receive_packet(c, sbc->packet) < 0)
+		return -1;
+
+	int length = sbc->packet->size;
+	if (length > size)
+		length = -1;
+	else
+		memcpy(output, sbc->packet->data, length);
+	av_packet_unref(sbc->packet);
+
+	if (!sbc->checked && length > 3) {
+		sbc->checked = 1;
+		if (memcmp(output, sbc->header, 3) != 0) {
+			fprintf(stderr, "FFmpeg SBC: header %02x %02x %02x, A2DP wants "
+				"%02x %02x %02x\n", output[0], output[1], output[2],
+				sbc->header[0], sbc->header[1], sbc->header[2]);
+			return -1;
+		}
+		fprintf(stderr, "FFmpeg SBC: header %02x %02x %02x as negotiated\n",
+			output[0], output[1], output[2]);
+	}
+	return length;
+}
+
+
+void
+ffsbc_close(struct ffsbc* sbc)
+{
+	if (sbc == NULL)
+		return;
+	av_packet_free(&sbc->packet);
+	av_frame_free(&sbc->frame);
+	avcodec_free_context(&sbc->context);
+	free(sbc);
+}
