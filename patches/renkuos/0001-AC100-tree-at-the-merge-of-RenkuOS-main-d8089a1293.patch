+
+/*!	What a service class (Bluetooth Assigned Numbers) means to the user. The
+	roles of a profile go under one name, and what only the stack cares about
+	(device identification, generic audio) under none.
+*/
+static const char*
+ServiceName(uint16 serviceClass)
+{
+	switch (serviceClass) {
+		case 0x1101: return B_TRANSLATE("Serial port");
+		case 0x1103: return B_TRANSLATE("Dial-up networking");
+		case 0x1105:
+		case 0x1106: return B_TRANSLATE("File transfer");
+		case 0x1108:
+		case 0x1112: return B_TRANSLATE("Headset");
+		case 0x110a: return B_TRANSLATE("Audio source");
+		case 0x110b: return B_TRANSLATE("Speakers or headphones");
+		case 0x110c:
+		case 0x110e:
+		case 0x110f: return B_TRANSLATE("Remote control");
+		case 0x1115:
+		case 0x1116: return B_TRANSLATE("Network");
+		case 0x111e:
+		case 0x111f: return B_TRANSLATE("Hands-free");
+		case 0x1124: return B_TRANSLATE("Input device");
+		case 0x112d: return B_TRANSLATE("SIM access");
+		case 0x112f: return B_TRANSLATE("Phone book");
+		case 0x1132: return B_TRANSLATE("Messages");
+		default: return NULL;
+	}
+}
+
+
+/*!	What the pairing is worth, from the type of the link key. */
+static const char*
+PairingName(bool paired, uint8 keyType)
+{
+	if (!paired)
+		return B_TRANSLATE("Not paired");
+	switch (keyType) {
+		case 0x00:
+			return B_TRANSLATE("Paired (PIN code)");
+		case 0x04:
+		case 0x07:
+			return B_TRANSLATE("Paired, without confirmation (Just Works)");
+		case 0x05:
+		case 0x08:
+			return B_TRANSLATE("Paired, confirmed by number");
+		default:
+			return B_TRANSLATE("Paired");
+	}
+}
