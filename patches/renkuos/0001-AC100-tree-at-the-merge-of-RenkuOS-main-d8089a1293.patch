+				conn->authenticated = true;
+				conn->securityFailed = false;
+			} else
+				conn->securityFailed = true;
+			break;
+		}
+
+		case HCI_EVENT_ENCRYPT_CHANGE:
+		{
+			struct hci_ev_encrypt_change* data
