+
+
+void
+DeviceWindow::MessageReceived(BMessage* message)
+{
+	switch (message->what) {
+		case kMsgUpdate:
+			_Update();
+			break;
+
+		case kMsgAudioOutput:
+			UseAsAudioOutput();
+			break;
+
+		case kMsgVolume:
+			fVolumeTouched = system_time();
+			_SetSpeakerVolume(fVolumeSlider->Value());
+			break;
+
+		case kMsgConnect:
+			_Connect(!fConnected);
+			break;
+
+		case kMsgForget:
+			_Forget();
+			break;
+
+		default:
+			BWindow::MessageReceived(message);
+			break;
+	}
+}
+
+
+void
+DeviceWindow::_Update()
+{
+	BMessage request(BT_MSG_GET_DEVICE_INFO);
+	request.AddString("address", fAddress);
+	BMessage info;
+	if (BMessenger(BLUETOOTH_SIGNATURE).SendMessage(&request, &info, 1000000,
+			1000000) != B_OK || !info.HasString("name")) {
+		fStatusView->SetText(B_TRANSLATE("The Bluetooth server does not "
+			"know this device"));
+		fConnectButton->SetEnabled(false);
+		fForgetButton->SetEnabled(false);
+		return;
+	}
+
+	fName = info.GetString("name", "");
+	BString title(fName.IsEmpty() ? fAddress : fName);
+	SetTitle(title.String());
+	fNameView->SetText(title.String());
+
+	fConnected = info.GetInt8("connection state", -1)
+		== RemoteDevice::CONNECTED;
+	bool encrypted = info.GetBool("encrypted", false);
+	BString status;
+	if (fConnected) {
+		status = encrypted ? B_TRANSLATE("Connected, encrypted")
+			: B_TRANSLATE("Connected");
+	} else
+		status = B_TRANSLATE("Not connected");
+	fStatusView->SetText(status.String());
+
+	const uint8* deviceClass;
+	ssize_t size;
+	device_kind kind = DEVICE_KIND_OTHER;
+	if (info.FindData("class_of_device", B_RAW_TYPE,
+			(const void**)&deviceClass, &size) == B_OK && size == 3) {
+		kind = DeviceKind(deviceClass[1] & 0x1f, (deviceClass[0] >> 2) & 0x3f);
+	}
+
+	// the services, as the device told them (SDP)
+	fAudioSink = false;
+	BString services;
+	BStringList names;
+	uint16 serviceClass;
+	for (int32 i = 0; info.FindUInt16("service class", i, &serviceClass)
+			== B_OK; i++) {
+		fAudioSink = fAudioSink || serviceClass == kAudioSink;
+		const char* name = ServiceName(serviceClass);
+		if (name == NULL || names.HasString(name))
+			continue;
+		names.Add(name);
+	}
+	if (names.IsEmpty())
+		names.Add(B_TRANSLATE("Not known until connected"));
+	services = names.Join("\n");
+	if (services != fServicesView->Text()) {
+		// one per line, and the view as tall as they are
+		fServicesView->SetText(services.String());
+		float width = 0;
+		for (int32 i = 0; i < names.CountStrings(); i++)
+			width = std::max(width, be_plain_font->StringWidth(names.StringAt(i)));
+		font_height height;
+		be_plain_font->GetHeight(&height);
+		BSize size(width + 4, names.CountStrings()
+			* ceilf(height.ascent + height.descent + height.leading) + 2);
+		fServicesView->SetExplicitMinSize(size);
+		fServicesView->SetExplicitPreferredSize(size);
+	}
+
+	// a device of no class that is speakers still looks like speakers
+	if (kind == DEVICE_KIND_OTHER && fAudioSink)
+		kind = DEVICE_KIND_AUDIO;
+	fIcon->SetKind(kind);
+	fTypeView->SetText(DeviceKindName(kind));
+	fPairingView->SetText(PairingName(info.GetBool("paired", false),
+		info.GetUInt8("key type", 0xff)));
+
+	int32 battery = info.GetInt32("battery", -1);
+	if (battery >= 0) {
+		BString text;
+		text << battery << "%";
+		fBatteryView->SetText(text.String());
+		if (fBatteryView->IsHidden()) {
+			fBatteryLabel->Show();
+			fBatteryView->Show();
+		}
+	} else if (!fBatteryView->IsHidden()) {
+		// most devices do not tell
+		fBatteryLabel->Hide();
+		fBatteryView->Hide();
+	}
+
+	fConnectButton->SetLabel(fConnected ? B_TRANSLATE("Disconnect")
+		: B_TRANSLATE("Connect"));
+	fConnectButton->SetEnabled(true);
+	fForgetButton->SetEnabled(true);
+
+	_UpdateAudio(fConnected);
+}
+
+
+/*!	The audio part, for speakers and headphones only: whether they are the
+	audio output of the system, and their volume.
+*/
+void
+DeviceWindow::_UpdateAudio(bool connected)
+{
+	if (!fAudioSink) {
+		if (!fAudioBox->IsHidden())
+			fAudioBox->Hide();
+		return;
+	}
+	if (fAudioBox->IsHidden())
+		fAudioBox->Show();
+
+	media_node node;
+	BString outputName;
+	if (!_FindOutput(&node, &outputName)) {
+		fAudioStatus->SetText(B_TRANSLATE("Not an audio output yet: restart "
+			"the media services"));
+		fAudioOutputButton->SetEnabled(false);
+		fVolumeSlider->SetEnabled(false);
+		return;
+	}
+
+	BMediaRoster* roster = BMediaRoster::Roster();
+	media_node current;
+	bool isOutput = roster->GetAudioOutput(&current) == B_OK
+		&& current.node == node.node;
+	roster->ReleaseNode(current);
+
+	fAudioStatus->SetText(isOutput ? B_TRANSLATE("The audio output of the "
+		"system") : B_TRANSLATE("Not the audio output"));
+	fAudioOutputButton->SetEnabled(!isOutput);
+
+	float percent;
+	bool known = _SpeakerVolume(&percent);
+	fVolumeSlider->SetEnabled(known);
+	// not while the slider is moved: the old value would come back
+	if (known && system_time() - fVolumeTouched > 1500000)
+		fVolumeSlider->SetValue((int32)(percent + 0.5f));
+	roster->ReleaseNode(node);
+}
+
+
+/*!	The live audio output of the device: the Bluetooth audio media add-on
+	names it after the device.
+*/
+bool
+DeviceWindow::_FindOutput(media_node* node, BString* outputName)
+{
+	outputName->SetToFormat("%s (Bluetooth)", fName.String());
+	BMediaRoster* roster = BMediaRoster::Roster();
+	if (roster == NULL)
+		return false;
+
+	live_node_info live[32];
+	int32 count = 32;
+	media_format format;
+	format.type = B_MEDIA_RAW_AUDIO;
+	if (roster->GetLiveNodes(live, &count, &format, NULL, NULL,
+			B_BUFFER_CONSUMER | B_PHYSICAL_OUTPUT) != B_OK)
+		return false;
+	for (int32 i = 0; i < count; i++) {
+		if (*outputName == live[i].name)
+			return roster->GetNodeFor(live[i].node.node, node) == B_OK;
+	}
+	return false;
+}
+
+
+void
+DeviceWindow::UseAsAudioOutput()
+{
+	BString outputName;
+	outputName.SetToFormat("%s (Bluetooth)", fName.String());
+	BMediaRoster* roster = BMediaRoster::Roster();
+	if (roster == NULL)
+		return;
+
+	dormant_node_info outputs[32];
+	int32 count = 32;
+	media_format format;
+	format.type = B_MEDIA_RAW_AUDIO;
+	format.u.raw_audio = media_raw_audio_format::wildcard;
+	if (roster->GetDormantNodes(outputs, &count, &format, NULL, NULL,
+			B_BUFFER_CONSUMER | B_PHYSICAL_OUTPUT) != B_OK)
+		return;
+	for (int32 i = 0; i < count; i++) {
+		if (outputName != outputs[i].name)
+			continue;
+		status_t status = roster->SetAudioOutput(outputs[i]);
+		if (status != B_OK) {
+			BString text;
+			text.SetToFormat(B_TRANSLATE("%s could not be made the audio "
+				"output: %s"), fName.String(), strerror(status));
+			(new BAlert(B_TRANSLATE("Bluetooth"), text.String(),
+				B_TRANSLATE("OK")))->Go(NULL);
+		}
+		break;
+	}
+	_Update();
+}
+
+
+static BContinuousParameter*
+SpeakerVolumeParameter(BParameterWeb* web)
+{
+	for (int32 i = 0; web != NULL && i < web->CountParameters(); i++) {
+		BContinuousParameter* parameter
+			= dynamic_cast<BContinuousParameter*>(web->ParameterAt(i));
+		if (parameter != NULL && strcmp(parameter->Kind(), B_GAIN) == 0)
+			return parameter;
+	}
+	return NULL;
+}
+
+
+bool
+DeviceWindow::_SpeakerVolume(float* percent)
+{
+	media_node node;
+	BString outputName;
+	if (!_FindOutput(&node, &outputName))
+		return false;
+	BParameterWeb* web = NULL;
+	bool found = false;
+	if (BMediaRoster::Roster()->GetParameterWebFor(node, &web) == B_OK) {
+		BContinuousParameter* parameter = SpeakerVolumeParameter(web);
+		float value;
+		size_t size = sizeof(value);
+		bigtime_t when;
+		if (parameter != NULL
+			&& parameter->GetValue(&value, &size, &when) == B_OK) {
+			*percent = value;
+			found = true;
+		}
+	}
+	delete web;
+	BMediaRoster::Roster()->ReleaseNode(node);
+	return found;
+}
+
+
+void
+DeviceWindow::_SetSpeakerVolume(float percent)
+{
+	media_node node;
+	BString outputName;
+	if (!_FindOutput(&node, &outputName))
+		return;
+	BParameterWeb* web = NULL;
+	if (BMediaRoster::Roster()->GetParameterWebFor(node, &web) == B_OK) {
+		BContinuousParameter* parameter = SpeakerVolumeParameter(web);
+		if (parameter != NULL)
+			parameter->SetValue(&percent, sizeof(percent), system_time());
+	}
+	delete web;
+	BMediaRoster::Roster()->ReleaseNode(node);
+}
+
+
+void
+DeviceWindow::_Connect(bool connect)
+{
+	LocalDevice* local = LocalDevice::GetLocalDevice();
+	if (local == NULL)
+		return;
+	bdaddr_t address = bdaddrUtils::FromString(fAddress.String());
+	BObjectList<RemoteDevice> devices = RemoteDevice::GetRemoteDevices(local);
+	for (int32 i = 0; i < devices.CountItems(); i++) {
+		RemoteDevice* device = devices.ItemAt(i);
+		if (!bdaddrUtils::Compare(device->GetBluetoothAddress(), address))
+			continue;
+		if (connect)
+			device->Connect();
+		else
+			device->Disconnect(false);
+		break;
+	}
+	fStatusView->SetText(connect ? B_TRANSLATE("Connecting" B_UTF8_ELLIPSIS)
+		: B_TRANSLATE("Disconnecting" B_UTF8_ELLIPSIS));
+}
+
+
+void
+DeviceWindow::_Forget()
+{
+	BString text;
+	text.SetToFormat(B_TRANSLATE("Forget %s?\n\nTo use it again, it has to be "
+		"paired anew, and devices that keep the old pairing "
+		"have to forget this computer too."), fName.String());
+	BAlert* alert = new BAlert(B_TRANSLATE("Forget the device"), text.String(),
+		B_TRANSLATE("Cancel"), B_TRANSLATE("Forget"), NULL,
+		B_WIDTH_AS_USUAL, B_WARNING_ALERT);
+	alert->SetShortcut(0, B_ESCAPE);
+	if (alert->Go() != 1)
+		return;
+
+	LocalDevice* local = LocalDevice::GetLocalDevice();
+	if (local == NULL)
+		return;
+	bdaddr_t address = bdaddrUtils::FromString(fAddress.String());
+	BObjectList<RemoteDevice> devices = RemoteDevice::GetRemoteDevices(local);
+	for (int32 i = 0; i < devices.CountItems(); i++) {
+		if (bdaddrUtils::Compare(devices.ItemAt(i)->GetBluetoothAddress(),
+				address)) {
+			devices.ItemAt(i)->Disconnect(true);
+			break;
+		}
+	}
+	PostMessage(B_QUIT_REQUESTED);
+}
