+static void
+send_hci_command(HciConnection* connection, uint16 ocf, const void* params,
+	uint8 length)
+{
+	net_buffer* buffer = gBufferModule->create(16);
+	if (buffer == NULL)
+		return;
+	struct hci_command_header header;
+	header.opcode = B_HOST_TO_LENDIAN_INT16(PACK_OPCODE(OGF_LINK_CONTROL, ocf));
+	header.clen = length;
+	if (gBufferModule->append(buffer, &header, sizeof(header)) == B_OK
+		&& gBufferModule->append(buffer, params, length) == B_OK)
+		btDevices->PostCommand(connection->Hid, buffer);
+	// the driver copied it
+	gBufferModule->free(buffer);
