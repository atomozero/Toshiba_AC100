+// A laptop with audio, capturing and networking services. A controller
+// starts with no class at all after its reset: other devices then list
+// this computer as of an unknown kind, and the class picked in the
+// Bluetooth preferences was lost at the next start.
+static const uint32 kDefaultDeviceClass = 0x2a010c;
+
+
+/*!	The class the user picked in the Bluetooth preferences, or the default
+	one.
+*/
+static bool
+LoadBluetoothSettings(BMessage& settings)
+{
+	BPath path;
+	if (find_directory(B_USER_SETTINGS_DIRECTORY, &path) != B_OK
+		|| path.Append("Bluetooth_settings") != B_OK)
+		return false;
+	BFile file(path.Path(), B_READ_ONLY);
+	return file.InitCheck() == B_OK && settings.Unflatten(&file) == B_OK;
+}
+
+
+static uint32
+LocalDeviceClass()
+{
+	BMessage settings;
+	const void* data;
+	ssize_t size;
+	if (LoadBluetoothSettings(settings)
+		&& settings.FindData("DeviceClass", B_RAW_TYPE, &data, &size) == B_OK
+		&& size == sizeof(uint32)) {
+		uint32 record;
+		memcpy(&record, data, sizeof(record));
+		record &= 0xffffff;
+		if (record != 0)
+			return record;
+	}
+	return kDefaultDeviceClass;
+}
+
+
+/*!	The name the user gave this computer in the Bluetooth preferences, or
+	its host name: a controller starts with the name its maker gave it
+	("CSR - bc4").
+*/
+static BString
+LocalDeviceName()
+{
+	BMessage settings;
+	BString name;
+	if (LoadBluetoothSettings(settings)
+		&& settings.FindString("Name", &name) == B_OK && !name.IsEmpty())
+		return name;
+	char host[HCI_DEVICE_NAME_SIZE];
+	if (gethostname(host, sizeof(host)) == 0 && host[0] != '\0') {
+		host[sizeof(host) - 1] = '\0';
+		return host;
+	}
+	return "Haiku";
+}
