+
+AvdtpSession::AvdtpSession()
+	:
+	fListenSocket(-1),
+	fSignalingSocket(-1),
+	fMediaSocket(-1),
+	fTxLabel(0),
+	fLocalSeid(1),
+	fConfigurationLength(0),
+	fRemoteStopped(false),
+	fRemoteStarted(false),
+	fOpened(false),
+	fRemoteSeid(0),
+	fRemoteDelay(-1)
+{
+	memset(&fRemoteAddr, 0, sizeof(fRemoteAddr));
+}
+
+
+AvdtpSession::~AvdtpSession()
+{
+	Disconnect();
+	if (fListenSocket >= 0)
+		close(fListenSocket);
+}
