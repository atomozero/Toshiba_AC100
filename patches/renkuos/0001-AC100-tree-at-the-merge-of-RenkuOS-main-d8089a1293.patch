@@ -0,0 +1,711 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+#include "BluetoothAudioNode.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+
+#include <Autolock.h>
+#include <Buffer.h>
+#include <Messenger.h>
+#include <ParameterWeb.h>
+#include <TimeSource.h>
+
+#include "A2dpSource.h"
+#include <bluetooth/bdaddrUtils.h>
+
+#include "AvrcpTarget.h"
+#include "BluetoothAudioAddOn.h"
+
+
+// media_addon_server has no terminal: the traces go to the syslog
+#define TRACE(x...) syslog(LOG_INFO, "bluetooth_audio: " x)
+
+using Bluetooth::A2dpSource;
+
+static const float kFrameRate = 44100.0f;
+static const int32 kChannels = 2;
+
+// what the node takes to put a buffer in the ring
+static const bigtime_t kEventLatency = 5000;
+// the audio kept for the stream when it starts: what came while it started
+// (some 40 ms when it was suspended); more would be played late all along,
+// and the speakers would answer pause and volume as late
+static const bigtime_t kStartBacklog = 40000;
+// the frames sent at a time: 4 SBC frames of 128
+static const int32 kChunkFrames = 512;
+// silence that ends the stream, so that the speakers can sleep: long
+// enough that sound after a short pause comes at once, while speakers
+// that start the stream again take a while to wake up
+static const bigtime_t kSilenceSuspends = 30000000;
+// how often the speakers are called while sound waits for them
+static const bigtime_t kCallInterval = 15000000;
+// how late speakers play, when they do not tell (A2DP delay reporting)
+static const bigtime_t kDefaultOutputDelay = 150000;
+// below this, a sample is silence (16-bit)
+static const int16 kSilence = 16;
+
+enum {
+	kParameterVolume = 1
+};
+
+
+BluetoothAudioNode::BluetoothAudioNode(BluetoothAudioAddOn* addOn,
+	int32 flavorId, const bdaddr_t& address, const char* name)
+	:
+	BMediaNode(name),
+	BBufferConsumer(B_MEDIA_RAW_AUDIO),
+	BControllable(),
+	BTimeSource(),
+	BMediaEventLooper(),
+	fAddOn(addOn),
+	fFlavorId(flavorId),
+	fAddress(address),
+	fName(name),
+	fRingLock("bluetooth audio ring"),
+	fRing(NULL),
+	fRingFrames((int32)kFrameRate),
+	fRead(0),
+	fWrite(0),
+	fDataSem(-1),
+	fLastSound(0),
+	fSoundStarted(0),
+	fLinkThread(-1),
+	fClockThread(-1),
+	fClockLock("bluetooth audio clock"),
+	fClockRunning(false),
+	fPerformanceBase(0),
+	fRealBase(0),
+	fQuitting(false),
+	fOutputDelay(kDefaultOutputDelay),
+	fVolume(-1.0f),
+	fVolumeChanged(0),
+	fVolumeDirty(false)
+{
+	// a sound card, for the media server: it finds the default output
+	// among the live physical outputs
+	AddNodeKind(B_PHYSICAL_OUTPUT);
+
+	fRing = new(std::nothrow) int16[fRingFrames * kChannels];
+	fDataSem = create_sem(0, "bluetooth audio data");
+}
+
+
+BluetoothAudioNode::~BluetoothAudioNode()
+{
+	fQuitting = true;
+	delete_sem(fDataSem);
+	status_t result;
+	if (fLinkThread >= 0)
+		wait_for_thread(fLinkThread, &result);
+	if (fClockThread >= 0)
+		wait_for_thread(fClockThread, &result);
+	Quit();
+	delete[] fRing;
+}
+
+
+BMediaAddOn*
+BluetoothAudioNode::AddOn(int32* _internalId) const
+{
+	if (_internalId != NULL)
+		*_internalId = fFlavorId;
+	return fAddOn;
+}
+
+
+void
+BluetoothAudioNode::NodeRegistered()
+{
+	fInput.destination.port = ControlPort();
+	fInput.destination.id = 0;
+	fInput.node = Node();
+	fInput.format.type = B_MEDIA_RAW_AUDIO;
+	fInput.format.u.raw_audio = media_raw_audio_format::wildcard;
+	fInput.format.u.raw_audio.frame_rate = kFrameRate;
+	fInput.format.u.raw_audio.channel_count = kChannels;
+	fInput.format.u.raw_audio.format = media_raw_audio_format::B_AUDIO_SHORT;
+	fInput.format.u.raw_audio.byte_order = B_MEDIA_HOST_ENDIAN;
+	strlcpy(fInput.name, "Bluetooth speakers", sizeof(fInput.name));
+
+	SetPriority(B_URGENT_PRIORITY);
+	SetEventLatency(kEventLatency);
+
+	// the volume of the speakers (AVRCP absolute volume)
+	BParameterWeb* web = new BParameterWeb;
+	BParameterGroup* group = web->MakeGroup(fName.String());
+	group->MakeContinuousParameter(kParameterVolume, B_MEDIA_RAW_AUDIO,
+		"Speaker volume", B_GAIN, "%", 0.0f, 100.0f, 1.0f);
+	SetParameterWeb(web);
+
+	Run();
+
+	fLinkThread = spawn_thread(_LinkThread, "bluetooth audio link",
+		B_URGENT_DISPLAY_PRIORITY, this);
+	if (fLinkThread >= 0)
+		resume_thread(fLinkThread);
+	fClockThread = spawn_thread(_ClockThread, "bluetooth audio clock",
+		B_URGENT_PRIORITY, this);
+	if (fClockThread >= 0)
+		resume_thread(fClockThread);
+}
+
+
+status_t
+BluetoothAudioNode::HandleMessage(int32 message, const void* data,
+	size_t size)
+{
+	if (BBufferConsumer::HandleMessage(message, data, size) == B_OK
+		|| BControllable::HandleMessage(message, data, size) == B_OK
+		|| BTimeSource::HandleMessage(message, data, size) == B_OK)
+		return B_OK;
+	return BMediaNode::HandleMessage(message, data, size);
+}
+
+
+void
+BluetoothAudioNode::HandleEvent(const media_timed_event* event,
+	bigtime_t lateness, bool realTimeEvent)
+{
+	if (event->type != BTimedEventQueue::B_HANDLE_BUFFER)
+		return;
+
+	BBuffer* buffer = (BBuffer*)event->pointer;
+	if (buffer == NULL)
+		return;
+	const media_raw_audio_format& raw = fInput.format.u.raw_audio;
+	if (raw.format == media_raw_audio_format::B_AUDIO_SHORT
+		&& raw.channel_count == kChannels) {
+		_Put((const int16*)buffer->Data(),
+			buffer->SizeUsed() / (kChannels * sizeof(int16)));
+	}
+	buffer->Recycle();
+}
+
+
+/*!	44.1 kHz, stereo, 16-bit: the mixer converts to it, A2DP needs it. */
+status_t
+BluetoothAudioNode::AcceptFormat(const media_destination& destination,
+	media_format* format)
+{
+	if (destination != fInput.destination)
+		return B_MEDIA_BAD_DESTINATION;
+	if (format->type == B_MEDIA_NO_TYPE)
+		format->type = B_MEDIA_RAW_AUDIO;
+	if (format->type != B_MEDIA_RAW_AUDIO)
+		return B_MEDIA_BAD_FORMAT;
+
+	media_raw_audio_format& raw = format->u.raw_audio;
+	media_raw_audio_format wildcard = media_raw_audio_format::wildcard;
+	if (raw.frame_rate != wildcard.frame_rate && raw.frame_rate != kFrameRate)
+		return B_MEDIA_BAD_FORMAT;
+	if (raw.channel_count != wildcard.channel_count
+		&& raw.channel_count != (uint32)kChannels)
+		return B_MEDIA_BAD_FORMAT;
+	if (raw.format != wildcard.format
+		&& raw.format != media_raw_audio_format::B_AUDIO_SHORT)
+		return B_MEDIA_BAD_FORMAT;
+	if (raw.byte_order != wildcard.byte_order
+		&& raw.byte_order != B_MEDIA_HOST_ENDIAN)
+		return B_MEDIA_BAD_FORMAT;
+
+	raw.frame_rate = kFrameRate;
+	raw.channel_count = kChannels;
+	raw.format = media_raw_audio_format::B_AUDIO_SHORT;
+	raw.byte_order = B_MEDIA_HOST_ENDIAN;
+	if (raw.buffer_size == wildcard.buffer_size)
+		raw.buffer_size = 2048;
+	return B_OK;
+}
+
+
+status_t
+BluetoothAudioNode::GetNextInput(int32* cookie, media_input* _input)
+{
+	if (*cookie != 0)
+		return B_BAD_INDEX;
+	*_input = fInput;
+	(*cookie)++;
+	return B_OK;
+}
+
+
+void
+BluetoothAudioNode::DisposeInputCookie(int32 cookie)
+{
+}
+
+
+void
+BluetoothAudioNode::BufferReceived(BBuffer* buffer)
+{
+
+	if (buffer->Header()->destination != fInput.destination.id) {
+		buffer->Recycle();
+		return;
+	}
+	media_timed_event event(buffer->Header()->start_time,
+		BTimedEventQueue::B_HANDLE_BUFFER, buffer,
+		BTimedEventQueue::B_RECYCLE_BUFFER);
+	if (EventQueue()->AddEvent(event) != B_OK)
+		buffer->Recycle();
+}
+
+
+void
+BluetoothAudioNode::ProducerDataStatus(const media_destination& forWhom,
+	int32 status, bigtime_t atPerformanceTime)
+{
+}
+
+
+status_t
+BluetoothAudioNode::GetLatencyFor(const media_destination& forWhom,
+	bigtime_t* _latency, media_node_id* _timesource)
+{
+	if (forWhom != fInput.destination)
+		return B_MEDIA_BAD_DESTINATION;
+	*_latency = EventLatency() + SchedulingLatency() + fOutputDelay;
+	*_timesource = TimeSource()->ID();
+	return B_OK;
+}
+
+
+status_t
+BluetoothAudioNode::Connected(const media_source& producer,
+	const media_destination& where, const media_format& withFormat,
+	media_input* _input)
+{
+	if (where != fInput.destination)
+		return B_MEDIA_BAD_DESTINATION;
+	fInput.source = producer;
+	fInput.format = withFormat;
+	*_input = fInput;
+	TRACE("%s: the mixer is connected (%.0f Hz, %" B_PRIu32 " channels)\n",
+		fName.String(), withFormat.u.raw_audio.frame_rate,
+		withFormat.u.raw_audio.channel_count);
+	return B_OK;
+}
+
+
+void
+BluetoothAudioNode::Disconnected(const media_source& producer,
+	const media_destination& where)
+{
+	if (where != fInput.destination || producer != fInput.source)
+		return;
+	fInput.source = media_source::null;
+}
+
+
+status_t
+BluetoothAudioNode::FormatChanged(const media_source& producer,
+	const media_destination& consumer, int32 changeTag,
+	const media_format& format)
+{
+	return B_NOT_SUPPORTED;
+}
+
+
+/*!	The clock runs with the real time: the mixer gives the audio as the
+	clock goes, and it leaves for the speakers as it comes, which buffer it.
+*/
+status_t
+BluetoothAudioNode::TimeSourceOp(const time_source_op_info& op,
+	void* _reserved)
+{
+	BAutolock _(fClockLock);
+	switch (op.op) {
+		case B_TIMESOURCE_START:
+			if (!fClockRunning) {
+				fClockRunning = true;
+				fPerformanceBase = op.performance_time;
+				fRealBase = op.real_time;
+			}
+			PublishTime(fPerformanceBase, fRealBase, 1.0f);
+			break;
+
+		case B_TIMESOURCE_STOP:
+		case B_TIMESOURCE_STOP_IMMEDIATELY:
+			// The clock keeps running, as that of a sound card does: the
+			// media add-on server stops it first when it quits, and the
+			// mixer, which goes by it, then waited for a time that did not
+			// come, and was released after its add-on had been unloaded
+			// (a segment violation in BMediaNode::Release()).
+			break;
+
+		case B_TIMESOURCE_SEEK:
+			fPerformanceBase = op.performance_time;
+			fRealBase = op.real_time;
+			if (fClockRunning)
+				PublishTime(fPerformanceBase, fRealBase, 1.0f);
+			BroadcastTimeWarp(op.real_time, op.performance_time);
+			break;
+
+		default:
+			break;
+	}
+	return B_OK;
+}
+
+
+/*!	Both BTimeSource and BMediaEventLooper have one: the looper's is the
+	one that schedules the buffers.
+*/
+void
+BluetoothAudioNode::SetRunMode(run_mode mode)
+{
+	BMediaEventLooper::SetRunMode(mode);
+}
+
+
+status_t
+BluetoothAudioNode::_ClockThread(void* self)
+{
+	BluetoothAudioNode* node = (BluetoothAudioNode*)self;
+	while (!node->fQuitting) {
+		snooze(50000);
+		BAutolock _(node->fClockLock);
+		if (!node->fClockRunning)
+			continue;
+		bigtime_t now = system_time();
+		node->PublishTime(node->fPerformanceBase + now - node->fRealBase, now,
+			1.0f);
+	}
+	return B_OK;
+}
+
+
+status_t
+BluetoothAudioNode::GetParameterValue(int32 id, bigtime_t* lastChange,
+	void* value, size_t* ioSize)
+{
+	if (id != kParameterVolume)
+		return B_BAD_VALUE;
+	if (*ioSize < sizeof(float))
+		return B_NO_MEMORY;
+	*(float*)value = fVolume < 0 ? 50.0f : fVolume * 100.0f;
+	*lastChange = fVolumeChanged;
+	*ioSize = sizeof(float);
+	return B_OK;
+}
+
+
+void
+BluetoothAudioNode::SetParameterValue(int32 id, bigtime_t when,
+	const void* value, size_t size)
+{
+	if (id != kParameterVolume || size < sizeof(float))
+		return;
+	float volume = *(const float*)value / 100.0f;
+	fVolume = volume < 0 ? 0 : volume > 1 ? 1 : volume;
+	fVolumeChanged = when;
+	fVolumeDirty = true;
+		// the link thread tells the speakers
+	float percent = fVolume * 100.0f;
+	BroadcastNewParameterValue(when, kParameterVolume, &percent,
+		sizeof(percent));
+}
+
+
+// #pragma mark - the ring
+
+
+void
+BluetoothAudioNode::_Put(const int16* samples, int32 frames)
+{
+	if (fRing == NULL || frames <= 0)
+		return;
+
+	bool sound = false;
+	for (int32 i = 0; i < frames * kChannels; i++) {
+		if (samples[i] > kSilence || samples[i] < -kSilence) {
+			sound = true;
+			break;
+		}
+	}
+
+	BAutolock _(fRingLock);
+	if (sound) {
+		bigtime_t now = system_time();
+		if (now - fLastSound > 1000000)
+			fSoundStarted = now;
+		fLastSound = now;
+	}
+	for (int32 i = 0; i < frames; i++) {
+		int32 next = (fWrite + 1) % fRingFrames;
+		if (next == fRead)
+			fRead = (fRead + 1) % fRingFrames;	// full: the oldest goes
+		memcpy(fRing + fWrite * kChannels, samples + i * kChannels,
+			kChannels * sizeof(int16));
+		fWrite = next;
+	}
+	release_sem_etc(fDataSem, 1, B_DO_NOT_RESCHEDULE);
+}
+
+
+int32
+BluetoothAudioNode::_Available()
+{
+	BAutolock _(fRingLock);
+	return (fWrite - fRead + fRingFrames) % fRingFrames;
+}
+
+
+int32
+BluetoothAudioNode::_Get(int16* samples, int32 frames)
+{
+	BAutolock _(fRingLock);
+	int32 got = 0;
+	while (got < frames && fRead != fWrite) {
+		memcpy(samples + got * kChannels, fRing + fRead * kChannels,
+			kChannels * sizeof(int16));
+		fRead = (fRead + 1) % fRingFrames;
+		got++;
+	}
+	return got;
+}
+
+
+void
+BluetoothAudioNode::_Drop(int32 keepFrames)
+{
+	BAutolock _(fRingLock);
+	int32 available = (fWrite - fRead + fRingFrames) % fRingFrames;
+	if (available > keepFrames)
+		fRead = (fRead + available - keepFrames) % fRingFrames;
+}
+
+
+/*!	When the sound began, after a silence. */
+bigtime_t
+BluetoothAudioNode::_SoundStarted()
+{
+	BAutolock _(fRingLock);
+	return fSoundStarted;
+}
+
+
+bool
+BluetoothAudioNode::_SoundSince(bigtime_t time)
+{
+	BAutolock _(fRingLock);
+	return fLastSound != 0 && fLastSound >= time;
+}
+
+
+// #pragma mark - the buttons of the speakers
+
+
+/*!	The buttons of the speakers (AVRCP: play 0x44, stop 0x45, pause 0x46,
+	next 0x4b, previous 0x4c) go to the media player, through its
+	scripting: Haiku has no system-wide media keys.
+*/
+void
+BluetoothAudioNode::_ControlPlayer(int32 button)
+{
+	const char* command;
+	switch (button) {
+		case 0x44: command = "Play"; break;
+		case 0x45: command = "Stop"; break;
+		case 0x46: command = "Pause"; break;
+		case 0x4b: command = "Next"; break;
+		case 0x4c: command = "Prev"; break;
+		default: return;
+	}
+
+	BMessenger player("application/x-vnd.Haiku-MediaPlayer");
+	if (!player.IsValid()) {
+		TRACE("%s: button %#" B_PRIx32 ", but no media player\n",
+			fName.String(), button);
+		return;
+	}
+	BMessage message(B_EXECUTE_PROPERTY);
+	message.AddSpecifier(command);
+	message.AddSpecifier("Window", (int32)0);
+	BMessage reply;
+	status_t status = player.SendMessage(&message, &reply, 500000, 500000);
+	TRACE("%s: %s on the media player: %s\n", fName.String(), command,
+		strerror(status));
+}
+
+
+// #pragma mark - the link
+
+
+status_t
+BluetoothAudioNode::_LinkThread(void* self)
+{
+	((BluetoothAudioNode*)self)->_Link();
+	return B_OK;
+}
+
+
+void
+BluetoothAudioNode::_Link()
+{
+	A2dpSource source;
+	source.SetPacingEnabled(false);
+		// the mixer gives the audio as it plays
+	AvrcpTarget remote;
+	bool remoteListening = false;
+	remote.SetTrack(fName.String(), "RenkuOS", "", -1);
+
+	const int32 backlog = (int32)(kFrameRate * kStartBacklog / 1000000);
+	int16 chunk[kChunkFrames * kChannels];
+	bigtime_t calledAt = 0;
+	bool remotePaused = false;
+	int32 lastRemoteVolume = -1;
+
+	while (!fQuitting) {
+		// a node that is not the output of the mixer leaves the radio alone
+		if (fInput.source == media_source::null) {
+			if (source.IsConnected()) {
+				TRACE("%s: no longer the audio output\n", fName.String());
+				if (source.IsStreaming())
+					source.StopStream();
+				source.Disconnect();
+				remote.SetStatus(false, 0);
+			}
+			_Drop(0);
+			// woken at once when the node goes (the semaphore is deleted)
+			acquire_sem_etc(fDataSem, 1, B_RELATIVE_TIMEOUT, 500000);
+			continue;
+		}
+
+		if (!remoteListening)
+			remoteListening = remote.Listen() == B_OK;
+
+		// a button pressed on the speakers
+		int32 button = remote.TakeButton();
+		if (button != 0) {
+			_ControlPlayer(button);
+			if (button == 0x44)
+				remotePaused = false;
+		}
+
+		bigtime_t now = system_time();
+		bool sound = _SoundSince(now - 2000000);
+
+		// the delay the speakers told: the latency the mixer plans with
+		bigtime_t delay = source.RemoteDelay();
+		if (delay > 0 && (delay > fOutputDelay + 5000
+				|| delay < fOutputDelay - 5000)) {
+			fOutputDelay = delay;
+			TRACE("%s: the speakers play %" B_PRId64 " ms late\n",
+				fName.String(), delay / 1000);
+			SendLatencyChange(fInput.source, fInput.destination,
+				EventLatency() + SchedulingLatency() + fOutputDelay);
+		}
+
+		// the volume, both ways
+		if (fVolumeDirty) {
+			fVolumeDirty = false;
+			remote.SetRemoteVolume((int32)(fVolume * 127 + 0.5f));
+		}
+		int32 remoteVolume = remote.RemoteVolume();
+		if (remoteVolume >= 0 && remoteVolume != lastRemoteVolume) {
+			lastRemoteVolume = remoteVolume;
+			fVolume = remoteVolume / 127.0f;
+			fVolumeChanged = now;
+			float percent = fVolume * 100.0f;
+			BroadcastNewParameterValue(now, kParameterVolume, &percent,
+				sizeof(percent));
+		}
+
+		if (!source.IsConnected()) {
+			_Drop(backlog);
+			// sound waits: the speakers are called, now and then
+			if (sound && now - calledAt > kCallInterval) {
+				calledAt = now;
+				TRACE("%s: sound to play, calling the speakers\n",
+					fName.String());
+				if (source.Connect(fAddress) == B_OK) {
+					TRACE("%s: connected (%" B_PRIu32 " Hz)\n",
+						fName.String(), source.SampleRate());
+					remotePaused = false;
+					continue;
+				}
+			}
+			// or they connect by themselves
+			bdaddr_t from;
+			if (source.WaitForSink(500000, &from) == B_OK) {
+				TRACE("%s: the speakers connected\n", fName.String());
+				remotePaused = false;
+			}
+			continue;
+		}
+
+		if (!source.IsStreaming()) {
+			if (!source.CheckStream()) {
+				TRACE("%s: the speakers closed the stream\n", fName.String());
+				source.Disconnect();
+				remote.SetStatus(false, 0);
+				continue;
+			}
+			if (remotePaused) {
+				// paused on the speakers: until they start the stream again
+				// (their play button clears this above), or the sound stops
+				if (source.WaitForStart(200000) || !sound) {
+					remotePaused = false;
+					if (!sound)
+						continue;
+				} else
+					continue;
+			}
+			if (!sound || source.SampleRate() != (uint32)kFrameRate) {
+				_Drop(backlog);
+				acquire_sem_etc(fDataSem, 1, B_RELATIVE_TIMEOUT, 100000);
+				continue;
+			}
+			_Drop(backlog);
+			if (source.StartStream() != B_OK) {
+				TRACE("%s: the stream did not start\n", fName.String());
+				source.Disconnect();
+				continue;
+			}
+			TRACE("%s: streaming, %" B_PRId64 " ms after the sound came\n",
+				fName.String(), (system_time() - _SoundStarted()) / 1000);
+			remote.SetStatus(true, 0);
+			continue;
+		}
+
+		// streaming: what the ring holds goes out
+		if (!_SoundSince(now - kSilenceSuspends)) {
+			TRACE("%s: silence, suspending the stream\n", fName.String());
+			source.StopStream();
+			remote.SetStatus(false, 0);
+			continue;
+		}
+		if (_Available() < kChunkFrames) {
+			acquire_sem_etc(fDataSem, 1, B_RELATIVE_TIMEOUT, 50000);
+			continue;
+		}
+		int32 frames = _Get(chunk, kChunkFrames);
+		status_t status = source.SendAudio(chunk, frames);
+		if (status == B_OK)
+			continue;
+
+		if (source.IsSuspended()) {
+			TRACE("%s: paused on the speakers\n", fName.String());
+			remotePaused = true;
+			remote.SetStatus(false, 0);
+		} else {
+			TRACE("%s: the link went (%s)\n", fName.String(),
+				strerror(status));
+			source.Disconnect();
+			remote.SetStatus(false, 0);
+			calledAt = system_time();
+		}
+	}
+
+	if (source.IsStreaming())
+		source.StopStream();
+	source.Disconnect();
+}
diff --git a/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioNode.h b/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioNode.h
new file mode 100644
index 0000000000..aa12a16225
