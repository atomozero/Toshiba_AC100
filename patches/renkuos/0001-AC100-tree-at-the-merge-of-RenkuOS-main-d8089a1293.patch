+	if (reason != BT_PIN_OR_KEY_MISSING && reason != BT_AUTHENTICATION_FAILURE)
+		return;
+
+	linkkey_t nullKey = LinkKeyUtils::NullKey();
+	if (LinkKeyUtils::Compare(&rd->link_key, &nullKey))
+		return;
+
+	syslog(LOG_NOTICE, "bluetooth_server: %s refused its key (%s), it pairs "
+		"again next time\n", bdaddrUtils::ToString(rd->bdaddr).String(),
+		BluetoothError(reason));
+	rd->link_key = nullKey;
+	SaveRemoteDevices();
+}
+
+
 void
 LocalDeviceImpl::EncryptChange(struct hci_ev_encrypt_change* event)
 {
@@ -1909,8 +2681,78 @@ LocalDeviceImpl::EncryptChange(struct hci_ev_encrypt_change* event)
 		return;
 
 	rd->encryption_enabled = event->encrypt;
-	if (rd->encryption_enabled != 0)
-		((BluetoothServer*)be_app)->NotifyServices(rd);
+	rd->keySizeChecked = false;
+	if (event->status != BT_OK || rd->encryption_enabled == 0)
+		return;
+
+	// A key shortened to a byte or two can be broken while the link runs
+	// (KNOB): the specification asks to drop links with less than 7 bytes.
+	// The services start once the size is known. A controller before
+	// Bluetooth 3.0 (LMP 5) does not know the command: not asked, its
+	// answer would only delay the services, or keep them off if it got lost.
+	if (fLmpVersion < 5) {
+		_LinkSecured(rd);
+		return;
+	}
+	BluetoothCommand<typed_command(hci_cp_read_encryption_key_size)> command(
+		OGF_STATUS_PARAM, OCF_READ_ENCRYPTION_KEY_SIZE);
+	command->handle = event->handle;
+	if (fHCIDelegate->IssueCommand(command.Data(), command.Size()) == B_ERROR)
+		_LinkSecured(rd);
+}
+
+
+void
+LocalDeviceImpl::EncryptionKeySize(
+	const struct hci_rp_read_encryption_key_size* reply, size_t length)
+{
+	if (length < 1)
+		return;
+	if (reply->status != BT_OK) {
+		// a controller before Bluetooth 3.0 does not know the command:
+		// nothing tells the size then, taken as the full 16 bytes as Linux
+		// does. The handle of the link is not told with the failure: every
+		// encrypted link still waiting goes on.
+		for (int32 i = 0; i < fRemoteDevicesList.CountItems(); i++) {
+			ServerRemoteDevice* rd = fRemoteDevicesList.ItemAt(i);
+			if (rd->conn_state == RemoteDevice::CONNECTED
+				&& rd->encryption_enabled != 0 && !rd->keySizeChecked)
+				_LinkSecured(rd);
+		}
+		return;
+	}
+	if (length < sizeof(*reply))
+		return;
+
+	ServerRemoteDevice* rd = RemoteDeviceByHandle(reply->handle);
+	if (rd == NULL)
+		return;
+	if (reply->key_size < 7) {
+		syslog(LOG_WARNING, "bluetooth_server: %s encrypts with a key of %u "
+			"bytes, too short: disconnecting\n",
+			bdaddrUtils::ToString(rd->bdaddr).String(), reply->key_size);
+		BluetoothCommand<typed_command(hci_disconnect)> command(
+			OGF_LINK_CONTROL, OCF_DISCONNECT);
+		command->handle = rd->handle;
+		command->reason = BT_AUTHENTICATION_FAILURE;
+		fHCIDelegate->IssueCommand(command.Data(), command.Size());
+		return;
+	}
+	_LinkSecured(rd);
+}
+
+
+void
+LocalDeviceImpl::_LinkSecured(ServerRemoteDevice* rd)
+{
+	rd->keySizeChecked = true;
+	if (rd->outgoing)
+		((BluetoothServer*)be_app)->StartServices(rd);
+	else {
+		// a device that connects to us opens its channels itself
+		TRACE_BT("LocalDeviceImpl: %s connected to us\n",
+			bdaddrUtils::ToString(rd->bdaddr).String());
+	}
 }
 
 
