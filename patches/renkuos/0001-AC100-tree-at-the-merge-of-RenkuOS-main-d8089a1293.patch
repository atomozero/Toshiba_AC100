+		connection->securityRequests++;
+		struct hci_cp_auth_requested command;
+		command.handle = B_HOST_TO_LENDIAN_INT16(connection->handle);
+		send_hci_command(connection, OCF_AUTH_REQUESTED, &command,
+			sizeof(command));
+	}
+	fSecurityAskAt = now + 5000000;
+	return LINK_SECURING;
+}
+
+
+/*!	The timer of a channel the device opened, while it waits for the
+	security of the link: the final answer to its request, once known.
+*/
+bool
+L2capEndpoint::_SecurityWait()
+{
+	ASSERT_LOCKED_MUTEX(&fLock);
+
+	link_security security = _LinkSecurity();
+	if (security == LINK_SECURING) {
+		gStackModule->set_timer(&fConfigTimer, 100000);
+		return false;
+	}
+
+	uint8 ident = fPendingIdent;
+	fPendingIdent = L2CAP_NULL_IDENT;
+
+	if (security == LINK_NOT_SECURE) {
+		ERROR("l2cap: link not secured, channel %d refused\n", fChannelID);
+		if (fConnection != NULL) {
+			send_l2cap_connection_rsp(fConnection, ident, fChannelID,
+				fDestinationChannelID,
+				l2cap_connection_rsp::RESULT_SECURITY_BLOCK, 0);
+		}
+		_MarkClosed();
+		return true;
+	}
+
+	ERROR("l2cap: link secured, channel %d accepted\n", fChannelID);
+	fState = CONFIGURATION;
+	send_l2cap_connection_rsp(fConnection, ident, fChannelID,
+		fDestinationChannelID, l2cap_connection_rsp::RESULT_SUCCESS, 0);
+	// as for a channel accepted at once
+	gStackModule->set_timer(&fConfigTimer, 200000);
+	return false;
+}
