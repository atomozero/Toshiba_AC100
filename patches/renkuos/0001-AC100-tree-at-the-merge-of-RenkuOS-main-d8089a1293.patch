+	}
+
+	~ScanListener()
+	{
+		delete_sem(fDone);
+	}
+
+	virtual void InquiryResponse(int type)
+	{
+		release_sem(fDone);
+	}
+
+	status_t Wait(bigtime_t timeout)
+	{
+		return acquire_sem_etc(fDone, 1, B_RELATIVE_TIMEOUT, timeout);
+	}
+
+private:
+	sem_id	fDone;
+};
+
+
+// the devices found by the last scan, for "Pair"; their listener keeps them
+BLocker sScanLock("bluetooth scan");
+ScanListener* sLastScan = NULL;
+BObjectList<RemoteDevice> sLastDevices;
+
+
+LocalDevice*
+ScriptingLocalDevice()
+{
+	// the kit talks to the server: only from a thread other than its looper
+	static LocalDevice* sLocalDevice = LocalDevice::GetLocalDevice();
+	return sLocalDevice;
+}
+
+
+const char*
+DeviceKind(const uint8* deviceClass)
+{
+	switch (deviceClass[1] & 0x1f) {
+		case 1:
+			return "computer";
+		case 2:
+			return "phone";
+		case 4:
+			return "audio";
+		case 5:
+		{
+			uint8 minor = deviceClass[0] >> 2;
+			if ((minor & 0x0f) == 1)
+				return "joystick";
+			if ((minor & 0x0f) == 2)
+				return "gamepad";
+			if ((minor & 0x30) == 0x10)
+				return "keyboard";
+			if ((minor & 0x30) == 0x20)
+				return "mouse";
+			return "peripheral";
+		}
+	}
+	return "device";
+}
+
+
+bool
+MatchesName(const BString& name, const bdaddr_t& address, const char* wanted)
+{
+	return name.ICompare(wanted) == 0
+		|| bdaddrUtils::ToString(address).ICompare(wanted) == 0;
+}
+
+
+void
+SendReply(BMessage* message, BMessage& reply, status_t status)
+{
+	reply.what = B_REPLY;
+	reply.AddInt32("error", status);
+	if (status != B_OK)
+		reply.AddString("message", strerror(status));
+	message->SendReply(&reply);
+}
+
+
+status_t
+ScanThread(void* data)
+{
+	BMessage* message = (BMessage*)data;
+	BMessage reply;
+	status_t status = B_ERROR;
+	BObjectList<RemoteDevice> found;
+
+	LocalDevice* local = ScriptingLocalDevice();
+	ScanListener* listener = new(std::nothrow) ScanListener;
+	if (local != NULL && listener != NULL) {
+		DiscoveryAgent* agent = local->GetDiscoveryAgent();
+		// 8 units of 1.28 s
+		status = agent->StartInquiry(BT_GIAC, listener, 8);
+		if (status == B_OK && listener->Wait(20000000) == B_OK) {
+			Bluetooth::RemoteDevicesList devices = agent->RetrieveDevices(0);
+			for (int32 i = 0; i < devices.CountItems(); i++) {
+				RemoteDevice* device = devices.ItemAt(i);
+				found.AddItem(device);
+				BString address = bdaddrUtils::ToString(
+					device->GetBluetoothAddress());
+				BString name = device->GetFriendlyName();
+				BString line;
+				line << i << ": " << (name.IsEmpty() ? address : name)
+					<< " (" << address << ")";
+				reply.AddString("result", line);
+			}
+		} else if (status == B_OK)
+			status = B_TIMED_OUT;
+	}
+
+	if (status == B_OK) {
+		BAutolock locker(sScanLock);
+		if (sLastScan != NULL && sLastScan->Lock())
+			sLastScan->Quit();
+		sLastScan = listener;
+		sLastDevices.MakeEmpty();
+		sLastDevices.AddList(&found);
+	} else if (listener != NULL && listener->Lock())
+		listener->Quit();
+
+	SendReply(message, reply, status);
+	delete message;
+	return B_OK;
+}
+
+
+struct ConnectRequest {
+	BMessage*		message;
+	RemoteDevice*	device;
+		// NULL: a paired device, made from description
+	BMessage		description;
+};
+
+
+status_t
+ConnectThread(void* data)
+{
+	ConnectRequest* request = (ConnectRequest*)data;
+	BMessage reply;
+	status_t status = B_NO_MEMORY;
+	RemoteDevice* device = request->device;
+	if (device == NULL) {
+		device = RemoteDevice::ParseRemoteDevice(ScriptingLocalDevice(),
+			&request->description);
+	}
+	if (device != NULL)
+		status = device->Connect();
+	if (status == B_OK)
+		reply.AddString("result", "connecting");
+	SendReply(request->message, reply, status);
+	delete request->message;
+	delete request;
+	return B_OK;
+}
+
+
+status_t
+StartConnecting(BMessage* message, RemoteDevice* device,
+	const BMessage* description = NULL)
+{
+	ConnectRequest* request = new(std::nothrow) ConnectRequest;
+	if (request == NULL)
+		return B_NO_MEMORY;
+	request->message = message;
+	request->device = device;
+	if (description != NULL)
+		request->description = *description;
+
+	thread_id thread = spawn_thread(ConnectThread, "bluetooth connect",
+		B_NORMAL_PRIORITY, request);
+	if (thread < 0) {
+		delete request;
+		return thread;
+	}
+	return resume_thread(thread);
+}
+
+
+}	// namespace
+
+
+BHandler*
+BluetoothServer::ResolveSpecifier(BMessage* message, int32 index,
+	BMessage* specifier, int32 what, const char* property)
+{
+	BPropertyInfo propertyInfo(sProperties);
+	if (propertyInfo.FindMatch(message, index, specifier, what, property)
+			>= 0)
+		return this;
+
+	return BApplication::ResolveSpecifier(message, index, specifier, what,
+		property);
+}
+
+
+status_t
+BluetoothServer::GetSupportedSuites(BMessage* data)
+{
+	data->AddString("suites", "suite/vnd.Haiku-bluetooth_server");
+	BPropertyInfo propertyInfo(sProperties);
+	data->AddFlat("messages", &propertyInfo);
+	return BApplication::GetSupportedSuites(data);
+}
+
+
+ServerRemoteDevice*
+BluetoothServer::_FindDevice(LocalDeviceImpl* local, BMessage* specifier,
+	int32 what)
+{
+	RemoteDevicesList* devices = local->GetRemoteDevicesList();
+
+	if (what == B_INDEX_SPECIFIER) {
+		int32 index;
+		if (specifier->FindInt32("index", &index) != B_OK)
+			return NULL;
+		return devices->ItemAt(index);
+	}
+
+	const char* name;
+	if (what != B_NAME_SPECIFIER || specifier->FindString("name", &name) != B_OK)
+		return NULL;
+	for (int32 i = 0; i < devices->CountItems(); i++) {
+		ServerRemoteDevice* device = devices->ItemAt(i);
+		if (MatchesName(device->friendly_name, device->bdaddr, name))
+			return device;
+	}
+	return NULL;
+}
+
+
+bool
+BluetoothServer::_HandleScripting(BMessage* message)
+{
+	int32 index;
+	BMessage specifier;
+	int32 what;
+	const char* property;
+	if (message->GetCurrentSpecifier(&index, &specifier, &what, &property)
+			!= B_OK) {
+		return false;
+	}
+
+	BPropertyInfo propertyInfo(sProperties);
+	if (propertyInfo.FindMatch(message, index, &specifier, what, property)
+			< 0) {
+		return false;
+	}
+
+	BMessage reply;
+	LocalDeviceImpl* local = fLocalDevicesList.ItemAt(0);
+	if (local == NULL) {
+		SendReply(message, reply, B_DEV_NOT_READY);
+		return true;
+	}
+
+	BString name(property);
+	status_t status = B_OK;
+
+	if (name == "Device") {
+		if (message->what == B_COUNT_PROPERTIES) {
+			reply.AddInt32("result",
+				local->GetRemoteDevicesList()->CountItems());
+		} else {
+			ServerRemoteDevice* device = _FindDevice(local, &specifier, what);
+			if (device == NULL)
+				status = B_NAME_NOT_FOUND;
+			else if (message->what == B_DELETE_PROPERTY) {
+				BMessage request;
+				request.AddData("bdaddr", B_ANY_TYPE, &device->bdaddr,
+					sizeof(bdaddr_t));
+				request.AddUInt8("reason", BT_REMOTE_USER_ENDED_CONNECTION);
+				local->Disconnect(&request);
+				local->RemoveRemoteDevice(device);
+			} else {
+				reply.AddString("name", device->friendly_name);
+				reply.AddString("address",
+					bdaddrUtils::ToString(device->bdaddr));
+				reply.AddString("kind", DeviceKind(device->classOfDevice));
+				reply.AddBool("connected",
+					device->conn_state == RemoteDevice::CONNECTED);
+				int32 battery = HIDProfile::BatteryLevel(device->bdaddr);
+				if (battery >= 0)
+					reply.AddInt32("battery", battery);
+			}
+		}
+	} else if (name == "Connected") {
+		RemoteDevicesList* devices = local->GetRemoteDevicesList();
+		for (int32 i = 0; i < devices->CountItems(); i++) {
+			ServerRemoteDevice* device = devices->ItemAt(i);
+			if (device->conn_state != RemoteDevice::CONNECTED)
+				continue;
+			reply.AddString("result", device->friendly_name.IsEmpty()
+				? bdaddrUtils::ToString(device->bdaddr)
+				: device->friendly_name);
+		}
+	} else if (name == "Discoverable") {
+		if (message->what == B_SET_PROPERTY) {
+			bool discoverable;
+			if (message->FindBool("data", &discoverable) != B_OK)
+				status = B_BAD_VALUE;
+			else
+				local->SetConnectable(discoverable);
+		} else
+			reply.AddBool("result", local->IsDiscoverable());
+	} else if (name == "Scan") {
+		BMessage* detached = DetachCurrentMessage();
+		thread_id thread = spawn_thread(ScanThread, "bluetooth scan",
+			B_NORMAL_PRIORITY, detached);
+		if (thread >= 0 && resume_thread(thread) == B_OK)
+			return true;
+		SendReply(detached, reply, thread < 0 ? thread : B_ERROR);
+		delete detached;
+		return true;
+	} else if (name == "Pair") {
+		RemoteDevice* device = NULL;
+		{
+			BAutolock locker(sScanLock);
+			if (sLastScan != NULL) {
+				BObjectList<RemoteDevice>& devices = sLastDevices;
+				const char* wanted;
+				if (what == B_INDEX_SPECIFIER)
+					device = devices.ItemAt(specifier.GetInt32("index", -1));
+				else if (specifier.FindString("name", &wanted) == B_OK) {
+					for (int32 i = 0; i < devices.CountItems(); i++) {
+						RemoteDevice* candidate = devices.ItemAt(i);
+						if (MatchesName(candidate->GetCachedFriendlyName(),
+								candidate->GetBluetoothAddress(), wanted))
+							device = candidate;
+					}
+				}
+			}
+		}
+		if (device == NULL)
+			status = B_NAME_NOT_FOUND;
+		else {
+			BMessage* detached = DetachCurrentMessage();
+			status = StartConnecting(detached, device);
+			if (status == B_OK)
+				return true;
+			SendReply(detached, reply, status);
+			delete detached;
+			return true;
+		}
+	} else if (name == "Connect" || name == "Disconnect") {
+		ServerRemoteDevice* device = _FindDevice(local, &specifier, what);
+		if (device == NULL)
+			status = B_NAME_NOT_FOUND;
+		else if (name == "Disconnect") {
+			BMessage request;
+			request.AddData("bdaddr", B_ANY_TYPE, &device->bdaddr,
+				sizeof(bdaddr_t));
+			request.AddUInt8("reason", BT_REMOTE_USER_ENDED_CONNECTION);
+			local->Disconnect(&request);
+		} else {
+			BMessage description;
+			description.AddData("bdaddr", B_ANY_TYPE, &device->bdaddr,
+				sizeof(bdaddr_t));
+			description.AddData("class_of_device", B_ANY_TYPE,
+				device->classOfDevice, sizeof(device->classOfDevice));
+			description.AddString("name", device->friendly_name);
+			BMessage* detached = DetachCurrentMessage();
+			status = StartConnecting(detached, NULL, &description);
+			if (status == B_OK)
+				return true;
+			SendReply(detached, reply, status);
+			delete detached;
+			return true;
+		}
+	}
+
+	SendReply(message, reply, status);
+	return true;
+}
