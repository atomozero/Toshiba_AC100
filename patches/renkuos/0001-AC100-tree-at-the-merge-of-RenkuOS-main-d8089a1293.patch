+*/
+void
+DeviceListItem::_UpdateKind()
+{
+	fKind = DeviceKind(fClass.MajorDeviceClass(), fClass.MinorDeviceClass());
+	if (fKind != DEVICE_KIND_OTHER)
+		return;
+
+	BMessage request(BT_MSG_GET_DEVICE_INFO);
+	request.AddString("address", bdaddrUtils::ToString(fAddress));
+	BMessage info;
+	if (BMessenger(BLUETOOTH_SIGNATURE).SendMessage(&request, &info, 500000,
+			500000) != B_OK)
+		return;
+	uint16 serviceClass;
+	for (int32 i = 0; info.FindUInt16("service class", i, &serviceClass)
+			== B_OK; i++) {
+		if (serviceClass == 0x110b) {
+			fKind = DEVICE_KIND_AUDIO;
+			return;
+		}
+	}
