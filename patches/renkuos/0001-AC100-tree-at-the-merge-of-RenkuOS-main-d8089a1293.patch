+static void
+tx_put_back(bt_usb_dev* bdev, int type, void* item)
+{
+	mutex_lock(&bdev->txLock);
+	list_insert_item_before(&bdev->nbuffersTx[type],
+		list_get_first_item(&bdev->nbuffersTx[type]), item);
+	mutex_unlock(&bdev->txLock);
+}
+
