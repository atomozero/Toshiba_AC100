@@ -0,0 +1,33 @@
+SubDir HAIKU_TOP src add-ons media media-add-ons bluetooth_audio ;
+
+UsePrivateHeaders bluetooth shared ;
+
+SubDirC++Flags -D__STDC_CONSTANT_MACROS ;
+
+local sources =
+	A2dpSource.cpp
+	AvdtpSession.cpp
+	AvrcpTarget.cpp
+	BluetoothAudioAddOn.cpp
+	BluetoothAudioNode.cpp
+	FfmpegSbc.c
+	SbcEncoder.cpp
+	;
+
+local architectureObject ;
+for architectureObject in [ MultiArchSubDirSetup ] {
+	on $(architectureObject) {
+		UseBuildFeatureHeaders ffmpeg ;
+		Includes [ FGristFiles $(sources) ]
+			: [ BuildFeatureAttribute ffmpeg : headers ] ;
+
+		Addon [ MultiArchDefaultGristFiles bluetooth_audio.media_addon ] :
+			$(sources)
+			:
+			# the SBC encoder is FFmpeg's
+			[ BuildFeatureAttribute ffmpeg : libraries ]
+
+			be libbluetooth.so media network [ TargetLibsupc++ ]
+		;
+	}
+}
diff --git a/src/add-ons/media/media-add-ons/bluetooth_audio/SbcEncoder.cpp b/src/add-ons/media/media-add-ons/bluetooth_audio/SbcEncoder.cpp
new file mode 100644
index 0000000000..11cead4f4b
--- /dev/null
+++ b/src/add-ons/media/media-add-ons/bluetooth_audio/SbcEncoder.cpp
@@ -0,0 +1,85 @@
+/*
+ * Copyright 2026 Haiku, Inc.
+ * All rights reserved. Distributed under the terms of the MIT License.
+ *
+ * SbcEncoder — the SBC encoder of A2DP, with FFmpeg's (FfmpegSbc).
+ */
+
+#include "SbcEncoder.h"
+
+#include "FfmpegSbc.h"
+
+
+SbcEncoder::SbcEncoder()
+	:
+	fFfmpeg(NULL),
+	fSampleRate(44100),
+	fChannels(2),
+	fBlocks(16),
+	fSubbands(8),
+	fChannelMode(3),
+	fAllocMethod(0),
+	fBitpool(53)
+{
+}
+
+
+SbcEncoder::~SbcEncoder()
+{
+	ffsbc_close(fFfmpeg);
+}
+
+
+status_t
+SbcEncoder::Configure(uint32 sampleRate, uint8 channels, uint8 blocks,
+	uint8 subbands, uint8 channelMode, uint8 allocMethod, uint8 bitpool)
+{
+	if (subbands != 4 && subbands != 8)
+		return B_BAD_VALUE;
+	if (blocks != 4 && blocks != 8 && blocks != 12 && blocks != 16)
+		return B_BAD_VALUE;
+	if (channelMode > 3)
+		return B_BAD_VALUE;
+	if (sampleRate != 16000 && sampleRate != 32000 && sampleRate != 44100
+		&& sampleRate != 48000)
+		return B_BAD_VALUE;
+
+	fSampleRate = sampleRate;
+	fChannels = channels;
+	fBlocks = blocks;
+	fSubbands = subbands;
+	fChannelMode = channelMode;
+	fAllocMethod = allocMethod;
+	fBitpool = bitpool;
+
+	ffsbc_close(fFfmpeg);
+	fFfmpeg = ffsbc_open(sampleRate, channels, blocks, subbands, channelMode,
+		allocMethod, bitpool);
+	return fFfmpeg != NULL ? B_OK : B_ERROR;
+}
+
+
+ssize_t
+SbcEncoder::EncodeFrame(const int16* input, uint8* output,
+	size_t maxOutputLen)
+{
+	if (fFfmpeg == NULL)
+		return -1;
+	return ffsbc_encode(fFfmpeg, input, output, maxOutputLen);
+}
+
+
+/*!	The length of a frame (A2DP 12.9): the header with its scale factors,
+	then the samples.
+*/
+uint16
+SbcEncoder::FrameLength() const
+{
+	uint8 channels = fChannelMode == 0 ? 1 : 2;
+	uint32 bits = (uint32)fBlocks * fBitpool;
+	if (fChannelMode == 1)
+		bits *= 2;	// dual channel: a bitpool for each
+	if (fChannelMode == 3)
+		bits += fSubbands;	// joint stereo: a bit for each subband
+	return 4 + (4 * fSubbands * channels) / 8 + (bits + 7) / 8;
+}
diff --git a/src/add-ons/media/media-add-ons/bluetooth_audio/SbcEncoder.h b/src/add-ons/media/media-add-ons/bluetooth_audio/SbcEncoder.h
