+	nvec_control,
+	nvec_select,
+	nvec_deselect,
+};
+
+
+static struct driver_module_info sNvecDriver = {
+	{
+		NVEC_DRIVER_MODULE_NAME,
+		0,
+		NULL
+	},
+
+	nvec_supports_device,
+	nvec_register_device,
+	nvec_init_driver,
+	nvec_uninit_driver,
+	nvec_register_child_devices,
+	NULL,	// rescan
+	NULL,	// device_removed
+};
+
