+	fConnectButton = new BButton("connect", B_TRANSLATE("Connect"),
+		new BMessage(kMsgConnect));
+	fForgetButton = new BButton("forget", B_TRANSLATE("Forget" B_UTF8_ELLIPSIS),
+		new BMessage(kMsgForget));
