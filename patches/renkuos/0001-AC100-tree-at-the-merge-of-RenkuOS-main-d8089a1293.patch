+	// The power management IC keeps its registers with the machine off:
+	// never write it unless reading it worked, nor while booting (the
+	// kernel sets the clock to what it just read).
+	if (sDVC != NULL && sTPS6586xRead && !gKernelStartup)
+		tps6586x_set_time(seconds);
 }
 
 
+/*!	Userland reads the offset without a lock: it reads the copy the version
+	points to, and again if the version changed meanwhile.
+*/
 void
 arch_rtc_set_system_time_offset(struct real_time_data *data, bigtime_t offset)
 {
+	int32 version = data->arch_data.version + 1;
