+#define I2C_PACKET_ID(id)			((uint32)(id) << 16)
+#define I2C_HEADER_REPEAT_START		(1u << 16)
+#define I2C_HEADER_IE_ENABLE		(1u << 17)
+#define I2C_HEADER_READ				(1u << 19)
