+/*!	Whether the device can have no keys to type a PIN with, from its class:
+	audio and video devices, and the peripherals that are not keyboards.
+*/
+bool
+LocalDeviceImpl::_HasNoKeypad(ServerRemoteDevice* rd)
+{
+	// major class in bits 8-12, the keyboard bit of the peripherals in 6
+	uint8 major = rd->classOfDevice[1] & 0x1f;
+	if (major == 0x04)
+		return true;
+	if (major == 0x05)
+		return (rd->classOfDevice[0] & 0x40) == 0;
+	return false;
+}
