+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+#include "BluetoothAudioAddOn.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+
+#include <File.h>
+#include <image.h>
+#include <FindDirectory.h>
+#include <Message.h>
+#include <Path.h>
+
+#include "BluetoothAudioNode.h"
+
+
+BluetoothAudioAddOn::BluetoothAudioAddOn(image_id image)
+	:
+	BMediaAddOn(image)
+{
+	_LoadDevices();
+	syslog(LOG_INFO, "bluetooth_audio: %" B_PRId32 " outputs\n",
+		fDevices.CountItems());
+}
+
+
+BluetoothAudioAddOn::~BluetoothAudioAddOn()
+{
+	for (int32 i = 0; i < fDevices.CountItems(); i++) {
+		free((char*)fDevices.ItemAt(i)->flavor.name);
+		free((char*)fDevices.ItemAt(i)->flavor.info);
+	}
+}
+
+
+status_t
+BluetoothAudioAddOn::InitCheck(const char** _failureText)
+{
+	return B_OK;
+}
+
+
+int32
+BluetoothAudioAddOn::CountFlavors()
+{
+	return fDevices.CountItems();
+}
+
+
+status_t
+BluetoothAudioAddOn::GetFlavorAt(int32 index, const flavor_info** _info)
+{
+	BluetoothAudioDevice* device = fDevices.ItemAt(index);
+	if (device == NULL)
+		return B_BAD_INDEX;
+	*_info = &device->flavor;
+	return B_OK;
+}
+
+
+BMediaNode*
+BluetoothAudioAddOn::InstantiateNodeFor(const flavor_info* info,
+	BMessage* config, status_t* _error)
+{
+	BluetoothAudioDevice* device = fDevices.ItemAt(info->internal_id);
+	if (device == NULL) {
+		*_error = B_BAD_INDEX;
+		return NULL;
+	}
+
+	// named as the flavor: the media server finds the default output again
+	// by the name of the node
+	BluetoothAudioNode* node = new(std::nothrow) BluetoothAudioNode(this,
+		info->internal_id, device->address, info->name);
+	*_error = node != NULL ? B_OK : B_NO_MEMORY;
+	return node;
+}
+
+
+/*!	The paired devices that are speakers or headphones: those with an
+	Audio Sink record, as bluetooth_server kept them. For a device whose
+	records were not read yet, the class says: audio and video, or nothing
+	(a Google Home has no class at all); phones, computers, peripherals such
+	as keyboards and game pads, and imaging devices are left out.
+*/
+void
+BluetoothAudioAddOn::_LoadDevices()
+{
+	BPath path;
+	if (find_directory(B_USER_SETTINGS_DIRECTORY, &path) != B_OK
+		|| path.Append("Bluetooth_paired_devices") != B_OK)
+		return;
+	BFile file(path.Path(), B_READ_ONLY);
+	BMessage devices;
+	if (file.InitCheck() != B_OK || devices.Unflatten(&file) != B_OK)
+		return;
+
+	BMessage remote;
+	for (int32 i = 0; devices.FindMessage("remote", i, &remote) == B_OK;
+			i++) {
+		const bdaddr_t* address;
+		ssize_t size;
+		if (remote.FindData("bdaddr", B_ANY_TYPE, (const void**)&address,
+				&size) != B_OK || size != sizeof(bdaddr_t))
+			continue;
+
+		// the service classes bluetooth_server kept from the SDP records:
+		// speakers have an Audio Sink (0x110b)
+		uint16 serviceClass;
+		bool servicesKnown = false;
+		bool sink = false;
+		for (int32 j = 0; remote.FindUInt16("service class", j,
+				&serviceClass) == B_OK; j++) {
+			servicesKnown = true;
+			sink = sink || serviceClass == 0x110b;
+		}
+		if (servicesKnown && !sink)
+			continue;
+		if (!servicesKnown) {
+			// not read yet: the class of the device, when it says
+			// something; 1 computer, 2 phone, 5 peripheral, 6 imaging
+			uint32 major = 0x1f;
+			const uint8* deviceClass;
+			if (remote.FindData("class_of_device", B_RAW_TYPE,
+					(const void**)&deviceClass, &size) == B_OK && size == 3)
+				major = deviceClass[1] & 0x1f;
+			if (major == 1 || major == 2 || major == 5 || major == 6)
+				continue;
+		}
+
+		BluetoothAudioDevice* device = new(std::nothrow) BluetoothAudioDevice;
+		if (device == NULL)
+			return;
+		memcpy(&device->address, address, sizeof(bdaddr_t));
+		device->name = remote.GetString("name", "");
+		if (device->name.IsEmpty())
+			device->name = "Bluetooth";
+
+		BString flavorName;
+		flavorName.SetToFormat("%s (Bluetooth)", device->name.String());
+
+		device->format.type = B_MEDIA_RAW_AUDIO;
+		device->format.u.raw_audio = media_raw_audio_format::wildcard;
+
+		flavor_info& flavor = device->flavor;
+		flavor.name = strdup(flavorName.String());
+		flavor.info = strdup("Plays through Bluetooth speakers or "
+			"headphones (A2DP)");
+		flavor.kinds = B_BUFFER_CONSUMER | B_CONTROLLABLE | B_PHYSICAL_OUTPUT
+			| B_TIME_SOURCE;
+		flavor.flavor_flags = 0;
+		flavor.internal_id = fDevices.CountItems();
+		flavor.possible_count = 1;
+		flavor.in_format_count = 1;
+		flavor.in_format_flags = 0;
+		flavor.in_formats = &device->format;
+		flavor.out_format_count = 0;
+		flavor.out_format_flags = 0;
+		flavor.out_formats = NULL;
+
+		fDevices.AddItem(device);
+	}
+}
+
+
+extern "C" _EXPORT BMediaAddOn*
+bluetooth_audio_instantiate(image_id image)
+{
+	return new(std::nothrow) BluetoothAudioAddOn(image);
+}
+
+
+/*!	The add-on and its nodes live in a second copy of the image, which is
+	never unloaded. The media add-on server releases the nodes as it stops,
+	which they do a little later in a thread of the media roster, and
+	unloads the add-on right after: a node released then ran code that was
+	gone (a segment violation in BMediaNode::Release(), and a shutdown
+	that hung). load_add_on() loads another copy of an image rather than
+	counting the one there, so the copy is where everything runs.
+*/
+extern "C" _EXPORT BMediaAddOn*
+make_media_addon(image_id image)
+{
+	image_info info;
+	if (get_image_info(image, &info) == B_OK) {
+		image_id copy = load_add_on(info.name);
+		if (copy >= 0) {
+			BMediaAddOn* (*instantiate)(image_id);
+			if (get_image_symbol(copy, "bluetooth_audio_instantiate",
+					B_SYMBOL_TYPE_TEXT, (void**)&instantiate) == B_OK) {
+				BMediaAddOn* addOn = instantiate(image);
+				if (addOn != NULL)
+					return addOn;
+			}
+			unload_add_on(copy);
+		}
+	}
+	return new(std::nothrow) BluetoothAudioAddOn(image);
+}
