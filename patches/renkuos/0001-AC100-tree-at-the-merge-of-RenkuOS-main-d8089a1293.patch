@@ -0,0 +1,127 @@
+/*
+ * Copyright 2025 Haiku, Inc.
+ * All rights reserved. Distributed under the terms of the MIT License.
+ *
+ * AvdtpSession — Audio/Video Distribution Transport Protocol session
+ * over L2CAP PSM 0x0019.
+ * Private to libbluetooth.so; not installed as a public header.
+ */
+#ifndef _AVDTP_SESSION_H_
+#define _AVDTP_SESSION_H_
+
+#include <OS.h>
+#include <SupportDefs.h>
+
+#include <bluetooth/bluetooth.h>
+#include "avdtp.h"
+
+
+#define AVDTP_MAX_SEPS			16
+#define AVDTP_MAX_CAPABILITIES	8
+#define AVDTP_SIGNAL_BUF_SIZE	512
+#define AVDTP_MEDIA_BUF_SIZE	4096
+
+
+struct AvdtpCapability {
+	uint8	category;
+	uint8	dataLen;
+	uint8	data[32];
+};
+
+
+class AvdtpSession {
+public:
+								AvdtpSession();
+								~AvdtpSession();
+
+	/* Signaling connection (client — initiator) */
+	status_t					Connect(const bdaddr_t& remote);
+	void						Disconnect();
+	bool						IsConnected() const
+									{ return fSignalingSocket >= 0; }
+
+	/* Signaling connection (server — acceptor): the device connects to us,
+	   configures our source endpoint, opens the stream and the media
+	   channel. Listen() before the device comes, then WaitForStream(). */
+	status_t					Listen(uint8 localSeid);
+	status_t					WaitForStream(bigtime_t timeout,
+									bdaddr_t* remote);
+	uint8						RemoteSeid() const { return fRemoteSeid; }
+	const uint8*				Configuration(size_t* length) const
+									{ *length = fConfigurationLength;
+									  return fConfiguration; }
+	bool						RemoteStarted() const
+									{ return fRemoteStarted; }
+	/* How late the device plays (AVDTP 1.3 delay reporting), -1 when it
+	   did not say */
+	bigtime_t					RemoteDelay() const { return fRemoteDelay; }
+
+	/* AVDTP discovery and configuration */
+	status_t					DiscoverEndpoints(
+									avdtp_sep_info* seps,
+									uint8* count, uint8 maxSeps);
+	status_t					GetCapabilities(uint8 remoteSeid,
+									AvdtpCapability* caps,
+									uint8* count, uint8 maxCaps);
+	status_t					SetConfiguration(uint8 remoteSeid,
+									uint8 localSeid,
+									const AvdtpCapability* caps,
+									uint8 capCount);
+	status_t					Open(uint8 remoteSeid);
+	status_t					Start(uint8 remoteSeid);
+	status_t					Suspend(uint8 remoteSeid);
+	status_t					Close(uint8 remoteSeid);
+	status_t					Abort(uint8 remoteSeid);
+
+	/* Commands from the other side: answered whenever signals are read.
+	   PollSignals() reads them without waiting, as a stream goes on. */
+	void						PollSignals();
+	bool						RemoteStopped() const
+									{ return fRemoteStopped; }
+	void						ClearRemoteStopped()
+									{ fRemoteStopped = false; }
+	/* configured and open, maybe suspended */
+	bool						StreamOpen() const
+									{ return fSignalingSocket >= 0
+										&& fMediaSocket >= 0
+										&& fConfigurationLength > 0; }
+
+	/* Media transport socket (valid after Open+Start) */
+	int							MediaSocket() const
+									{ return fMediaSocket; }
+	status_t					OpenMediaChannel(
+									const bdaddr_t& remote);
+
+private:
+	/* Signaling helpers */
+	status_t					_SendSignal(uint8 signalId,
+									const uint8* params,
+									size_t paramLen);
+	ssize_t						_RecvSignal(uint8* buf, size_t maxLen,
+									bigtime_t timeout);
+	uint8						_NextTxLabel();
+	void						_HandleCommand(const uint8* buf,
+									size_t length);
+	status_t					_SendResponse(uint8 label, uint8 msgType,
+									uint8 signalId, const uint8* params,
+									size_t paramLen);
+
+	status_t					_Accept(int* socket, bigtime_t timeout);
+
+	int							fListenSocket;
+	int							fSignalingSocket;
+	int							fMediaSocket;
+	uint8						fTxLabel;
+	bdaddr_t					fRemoteAddr;
+	uint8						fLocalSeid;
+	uint8						fConfiguration[64];
+	size_t						fConfigurationLength;
+	bool						fRemoteStopped;
+	bool						fRemoteStarted;
+	bool						fOpened;
+	uint8						fRemoteSeid;
+	bigtime_t					fRemoteDelay;
+};
+
+
+#endif /* _AVDTP_SESSION_H_ */
diff --git a/src/add-ons/media/media-add-ons/bluetooth_audio/AvrcpTarget.cpp b/src/add-ons/media/media-add-ons/bluetooth_audio/AvrcpTarget.cpp
