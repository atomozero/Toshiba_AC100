+{
+	rx_recovery* recovery = (rx_recovery*)cookie;
+	bt_usb_dev* bdev = recovery->bdev;
+	const usb_endpoint_info* endpoint = recovery->event
+		? bdev->intr_in_ep : bdev->bulk_in_ep;
