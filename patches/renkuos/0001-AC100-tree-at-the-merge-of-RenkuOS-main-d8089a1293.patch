+		.Add(fServicesView);
+
+	BLayoutBuilder::Group<>(fAudioBox, B_VERTICAL, spacing / 2)
+		.SetInsets(spacing, spacing * 2, spacing, spacing)
+		.AddGroup(B_HORIZONTAL, spacing)
