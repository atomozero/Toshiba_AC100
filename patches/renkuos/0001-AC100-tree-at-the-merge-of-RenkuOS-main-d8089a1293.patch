+ */
+#ifndef FFMPEG_SBC_H
+#define FFMPEG_SBC_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct ffsbc;
+
+// mode: 0 mono, 1 dual channel, 2 stereo, 3 joint stereo; allocation:
+// 0 loudness, 1 SNR
+struct ffsbc*	ffsbc_open(int rate, int channels, int blocks, int subbands,
+					int mode, int allocation, int bitpool);
+int				ffsbc_encode(struct ffsbc* sbc, const int16_t* input,
+					uint8_t* output, int size);
+void			ffsbc_close(struct ffsbc* sbc);
+
+#ifdef __cplusplus
+}
+#endif
