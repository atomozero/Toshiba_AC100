+		PACK_OPCODE(OGF_LINK_CONTROL, OCF_REMOTE_NAME_REQUEST));
+	request->AddInt16("eventExpected", HCI_EVENT_REMOTE_NAME_REQUEST_COMPLETE);
+	AddWantedEvent(request);
+
+	if (fHCIDelegate->IssueCommand(command, size) == B_ERROR) {
+		TRACE_BT("LocalDeviceImpl: Command issued error for %s\n", __FUNCTION__);
+		ClearWantedEvent(request);
+	}
+	free(command);
+}
+
+
+void
+LocalDeviceImpl::SetConnectable(bool discoverable)
+{
+	// page scan: the devices paired before can connect to us; inquiry scan:
+	// the others can find us
+	fDiscoverable = discoverable;
+	size_t size;
+	void* command = buildWriteScan(discoverable
+		? HCI_SCAN_INQUIRY_PAGE : HCI_SCAN_PAGE, &size);
+	if (command == NULL)
+		return;
+
+	if (fHCIDelegate->IssueCommand(command, size) == B_ERROR)
+		TRACE_BT("LocalDeviceImpl: Command issued error for %s\n", __FUNCTION__);
+	free(command);
+}
+
+
+void
+LocalDeviceImpl::AllowRoleSwitch()
+{
+	// Allow role switches on the links: the controller starts with none
+	BluetoothCommand<typed_command(hci_cp_write_default_link_policy)>
+		policy(OGF_LINK_POLICY, OCF_WRITE_DEFAULT_LINK_POLICY);
+	policy->policy = B_HOST_TO_LENDIAN_INT16(HCI_LINK_POLICY_ROLE_SWITCH);
+	if (fHCIDelegate->IssueCommand(policy.Data(), policy.Size()) == B_ERROR)
+		TRACE_BT("LocalDeviceImpl: Command issued error for link policy\n");
+}
+
+
+/*!	Sets the controller up from a known state. A reset first: a controller
+	that was open before, under a previous server, still has its links,
+	scan mode and event mask, which nobody here knows about. Then one command
+	at a time, each sent when the previous one completed: this controller
+	loses commands sent too close to each other, or right after it was
+	opened, so a command that gets no answer is sent again.
+*/
+void
+LocalDeviceImpl::StartInit()
+{
+	fInitStep = kInitReset;
+	fInitTries = 0;
+	_SendInitStep();
+}
+
+
+void
+LocalDeviceImpl::InitTimeout(int32 step, int32 tries)
+{
+	if (step != fInitStep || tries != fInitTries)
+		return;
+
+	if (++fInitTries < kInitMaxTries) {
+		TRACE_BT("LocalDeviceImpl: %s got no answer, sending it again\n",
+			BluetoothCommandOpcode(kInitOpcodes[fInitStep]));
+	} else {
+		syslog(LOG_WARNING, "bluetooth_server: %s got no answer\n",
+			BluetoothCommandOpcode(kInitOpcodes[fInitStep]));
+		fInitStep++;
+		fInitTries = 0;
+	}
+	_SendInitStep();
+}
+
+
+void
+LocalDeviceImpl::_SendInitStep()
+{
+	// the controllers before Bluetooth 2.1 (LMP 4) have no simple pairing
+	while ((fInitStep == kInitEventMask || fInitStep == kInitSimplePairing
+			|| fInitStep == kInitInquiryResponse)
+		&& fLmpVersion < 4) {
+		fInitStep++;
+	}
+	if (fInitStep < 0 || fInitStep >= kInitDone) {
+		fInitStep = -1;
+		TRACE_BT("LocalDeviceImpl: controller ready\n");
+		return;
+	}
+
+	switch (fInitStep) {
+		case kInitReset:
+		{
+			BluetoothCommand<> reset(OGF_CONTROL_BASEBAND, OCF_RESET);
+			fHCIDelegate->IssueCommand(reset.Data(), reset.Size());
+			break;
+		}
+		case kInitReadVersion:
+		{
+			BluetoothCommand<> version(OGF_INFORMATIONAL_PARAM,
+				OCF_READ_LOCAL_VERSION);
+			fHCIDelegate->IssueCommand(version.Data(), version.Size());
+			break;
+		}
+		case kInitReadBufferSize:
+		{
+			// The host shall read it before it sends data (Vol 4, Part E
+			// 4.1.1): the driver learns from the answer how many ACL packets
+			// the controller takes, and their size. Only the preferences
+			// asked for it, when they happened to be open.
+			BluetoothCommand<> bufferSize(OGF_INFORMATIONAL_PARAM,
+				OCF_READ_BUFFER_SIZE);
+			fHCIDelegate->IssueCommand(bufferSize.Data(), bufferSize.Size());
+			break;
+		}
+		case kInitEventMask:
+		{
+			// the default mask of the version 2.0, plus the events of the
+			// simple pairing: IO capability request and response, user
+			// confirmation, passkey request, remote OOB data, pairing
+			// complete, extended inquiry result, passkey and keypress
+			// notification, remote host features
+			BluetoothCommand<typed_command(hci_cp_set_event_mask)>
+				mask(OGF_CONTROL_BASEBAND, OCF_SET_EVENT_MASK);
+			mask->mask = B_HOST_TO_LENDIAN_INT64(0x1c7f1fffffffffffULL);
+			fHCIDelegate->IssueCommand(mask.Data(), mask.Size());
+			break;
+		}
+		case kInitSimplePairing:
+		{
+			BluetoothCommand<typed_command(hci_cp_write_simple_pairing_mode)>
+				mode(OGF_CONTROL_BASEBAND, OCF_WRITE_SIMPLE_PAIRING_MODE);
+			mode->mode = 1;
+			fHCIDelegate->IssueCommand(mode.Data(), mode.Size());
+			break;
+		}
+		case kInitScan:
+			SetConnectable(fDiscoverable);
+			break;
+		case kInitLinkPolicy:
+			AllowRoleSwitch();
+			break;
+		case kInitClass:
+		{
+			uint32 record = LocalDeviceClass();
+			BluetoothCommand<typed_command(hci_write_dev_class)>
+				deviceClass(OGF_CONTROL_BASEBAND, OCF_WRITE_CLASS_OF_DEV);
+			deviceClass->dev_class[0] = record & 0xff;
+			deviceClass->dev_class[1] = (record >> 8) & 0xff;
+			deviceClass->dev_class[2] = (record >> 16) & 0xff;
+			fHCIDelegate->IssueCommand(deviceClass.Data(), deviceClass.Size());
+			break;
+		}
+		case kInitName:
+		{
+			BString name = LocalDeviceName();
+			BluetoothCommand<typed_command(hci_write_local_name)>
+				localName(OGF_CONTROL_BASEBAND, OCF_WRITE_LOCAL_NAME);
+			memset(localName->local_name, 0, HCI_DEVICE_NAME_SIZE);
+			strlcpy(localName->local_name, name.String(),
+				HCI_DEVICE_NAME_SIZE);
+			fHCIDelegate->IssueCommand(localName.Data(), localName.Size());
+			break;
+		}
+		case kInitInquiryResponse:
+		{
+			// The name and the services, in the answer to an inquiry: the
+			// devices that look for us show the name without asking for
+			// it, and some (a Google Home) show the address otherwise.
+			BluetoothCommand<typed_command(write_extended_inquiry_response)>
+				response(OGF_CONTROL_BASEBAND, 0x0052);
+			memset(response->data, 0, sizeof(response->data));
+			response->fec_required = 0;
+			uint8* data = response->data;
+			BString name = LocalDeviceName();
+			size_t nameLength = min_c((size_t)name.Length(), (size_t)200);
+			data[0] = nameLength + 1;
+			data[1] = 0x09;	// complete local name
+			memcpy(data + 2, name.String(), nameLength);
+			data += 2 + nameLength;
+			// complete list of 16-bit service UUIDs: A2DP source and sink,
+			// AVRCP target and controller
+			static const uint16 kServices[] = { 0x110a, 0x110b, 0x110c,
+				0x110e };
+			data[0] = 1 + 2 * B_COUNT_OF(kServices);
+			data[1] = 0x03;
+			for (size_t i = 0; i < B_COUNT_OF(kServices); i++) {
+				data[2 + 2 * i] = kServices[i] & 0xff;
+				data[3 + 2 * i] = kServices[i] >> 8;
+			}
+			fHCIDelegate->IssueCommand(response.Data(), response.Size());
+			break;
+		}
+	}
+
+	BMessage timeout(kMsgInitTimeout);
+	timeout.AddInt32("hci_id", GetID());
+	timeout.AddInt32("step", fInitStep);
+	timeout.AddInt32("tries", fInitTries);
+	BMessageRunner::StartSending(be_app_messenger, &timeout,
+		fInitStep == kInitReset ? 3000000 : 1000000, 1);
+}
+
+
+void
+LocalDeviceImpl::_InitStepDone(uint16 opcode, uint8 status,
+	const uint8* params, size_t length)
+{
+	if (fInitStep < 0 || opcode != kInitOpcodes[fInitStep])
+		return;
+
+	if (fInitStep == kInitReadVersion && status == BT_OK
+		&& length >= sizeof(struct hci_rp_read_loc_version)) {
+		fLmpVersion = ((const struct hci_rp_read_loc_version*)params)
+			->lmp_version;
+	}
+
+	// a step that failed was reported: the next ones are still worth it
+	fInitStep++;
+	fInitTries = 0;
+	_SendInitStep();
+}
