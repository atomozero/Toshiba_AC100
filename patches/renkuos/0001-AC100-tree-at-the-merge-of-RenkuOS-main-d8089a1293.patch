+
+// The lists are indexed by packet type, but there are only
+// BT_DRIVER_TXCOVERAGE of them: BT_SCO (3) has none
+static inline bool
+tx_has_list(int type)
+{
+	return type >= 0 && type < BT_DRIVER_TXCOVERAGE && type != BT_EVENT;
+}
+
+
+static void*
+tx_take(bt_usb_dev* bdev, int type)
+{
+	if (!tx_has_list(type))
+		return NULL;
+	mutex_lock(&bdev->txLock);
+	void* item = list_remove_head_item(&bdev->nbuffersTx[type]);
+	mutex_unlock(&bdev->txLock);
+	return item;
+}
+
+
+/*!	The first ACL packet whose link is not being secured: one link pairing
+	does not stop the others. The packets of one link keep their order.
+*/
+static net_buffer*
+tx_take_acl(bt_usb_dev* bdev)
+{
+	// the handles passed over: their later packets wait too
+	uint16 held[ACL_FLOW_HANDLES];
+	int32 heldCount = 0;
+
+	mutex_lock(&bdev->txLock);
+	net_buffer* nbuf = (net_buffer*)list_get_first_item(
+		&bdev->nbuffersTx[BT_ACL]);
+	while (nbuf != NULL) {
+		uint8 header[2];
+		uint16 handle = 0xffff;
+		if (nb->read(nbuf, 0, header, sizeof(header)) == B_OK)
+			handle = (header[0] | header[1] << 8) & 0x0fff;
+
+		bool skip = false;
+		for (int32 i = 0; i < heldCount; i++) {
+			if (held[i] == handle)
+				skip = !acl_flow_overtakes(bdev, nbuf);
+		}
+		if (!skip && acl_flow_held(bdev, nbuf)) {
+			if (heldCount == ACL_FLOW_HANDLES) {
+				// more links held than counted: wait for the first
+				nbuf = NULL;
+				break;
+			}
+			held[heldCount++] = handle;
+			skip = true;
+		}
+		if (!skip)
+			break;
+		nbuf = (net_buffer*)list_get_next_item(&bdev->nbuffersTx[BT_ACL],
+			nbuf);
+	}
+	if (nbuf != NULL)
+		list_remove_item(&bdev->nbuffersTx[BT_ACL], nbuf);
+	mutex_unlock(&bdev->txLock);
+	return nbuf;
+}
