+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ *
+ * DeviceWindow: what is known of one paired device, and what can be done
+ * with it. The window adapts to what the device offers: speakers and
+ * headphones (an Audio Sink) get the audio output of the system and their
+ * volume, devices with a battery show its level.
+ */
+#ifndef DEVICE_WINDOW_H
+#define DEVICE_WINDOW_H
+
+
+#include <String.h>
+#include <Window.h>
+
+#include <MediaNode.h>
+
+
+class BBox;
+class BButton;
+class BMessageRunner;
+class BSlider;
+class BStringView;
+class BTextView;
+class DeviceIconView;
+
+
+class DeviceWindow : public BWindow {
+public:
+								DeviceWindow(const char* address);
+	virtual						~DeviceWindow();
+
+	virtual	void				MessageReceived(BMessage* message);
+
+			const BString&		Address() const { return fAddress; }
+
+			// makes the device the audio output of the system
+			void				UseAsAudioOutput();
+
+private:
+			void				_Update();
+			void				_UpdateAudio(bool connected);
+			bool				_FindOutput(media_node* node,
+									BString* outputName);
+			void				_SetSpeakerVolume(float percent);
+			bool				_SpeakerVolume(float* percent);
+			void				_Connect(bool connect);
+			void				_Forget();
+
+private:
+			BString				fAddress;
+			BString				fName;
+			bool				fConnected;
+			bool				fAudioSink;
+
+			DeviceIconView*		fIcon;
+			BStringView*		fNameView;
+			BStringView*		fStatusView;
+			BStringView*		fTypeView;
+			BStringView*		fAddressView;
+			BStringView*		fPairingView;
+			BStringView*		fBatteryLabel;
+			BStringView*		fBatteryView;
+			BTextView*			fServicesView;
+
+			BBox*				fAudioBox;
+			BStringView*		fAudioStatus;
+			BButton*			fAudioOutputButton;
+			BSlider*			fVolumeSlider;
+			bigtime_t			fVolumeTouched;
+
+			BButton*			fConnectButton;
+			BButton*			fForgetButton;
+			BMessageRunner*		fPoller;
+};
+
+
+#endif	// DEVICE_WINDOW_H
