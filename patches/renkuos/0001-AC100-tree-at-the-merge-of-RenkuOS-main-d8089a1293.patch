+				.Add(fNameView)
+				.Add(fStatusView)
+				.AddGlue()
+			.End()
+			.AddGlue()
+		.End()
+		.AddGroup(B_HORIZONTAL, spacing)
+			.Add(deviceBox)
+			.Add(servicesBox)
