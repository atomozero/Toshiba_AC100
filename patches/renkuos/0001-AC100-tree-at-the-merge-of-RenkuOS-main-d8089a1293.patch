 static __inline int
 fesetround(int __round)
 {
+	fexcept_t __fpsr;
+	uint32_t __rmode;
+
+	switch (__round) {
+	case FE_TONEAREST:
+		__rmode = 0;
+		break;
+	case FE_UPWARD:
+		__rmode = 1;
+		break;
+	case FE_DOWNWARD:
+		__rmode = 2;
+		break;
+	case FE_TOWARDZERO:
+		__rmode = 3;
