index 0000000000..b6797364bd
--- /dev/null
+++ b/src/add-ons/kernel/drivers/bluetooth/h2/h2generic/h2flow.cpp
@@ -0,0 +1,743 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	HCI flow control of the ACL packets sent to the controller.
+
+	A controller has room for a fixed number of ACL packets (Read Buffer
+	Size), and tells with Number Of Completed Packets when it has sent some
+	and their room is free again. The host must not send more than there is
+	room for. Nothing kept count before: input devices send little, but an
+	audio stream fills a CSR BC4 in seconds, and it then refuses everything
+	on its bulk endpoint.
+
+	The driver sees the events before the stack does, so it follows them
+	here: until the size is known, packets go out as before.
+*/
+
+
+#include "h2flow.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#include <KernelExport.h>
+
+#include "h2debug.h"
+#include "h2upper.h"
+
+
+static const uint16 kOpcodeReset = 0x0c03;
+static const uint16 kOpcodeReadBufferSize = 0x1005;
+static const uint8 kEventDisconnectionComplete = 0x05;
+static const uint8 kEventCommandComplete = 0x0e;
+static const uint8 kEventCommandStatus = 0x0f;
+static const uint8 kEventNumberOfCompletedPackets = 0x13;
+static const uint8 kEventAuthenticationComplete = 0x06;
+static const uint8 kEventEncryptionChange = 0x08;
+static const uint8 kEventEncryptionKeyRefreshComplete = 0x30;
+static const uint8 kEventPinCodeRequest = 0x16;
+static const uint8 kEventLinkKeyRequest = 0x17;
+static const uint8 kEventIOCapabilityRequest = 0x31;
+static const uint8 kEventUserConfirmationRequest = 0x33;
+static const uint8 kEventSimplePairingComplete = 0x36;
+
+static const uint8 kEventConnectionComplete = 0x03;
+static const uint8 kEventUserPasskeyRequest = 0x34;
+
+// how long ACL data waits at most for a link to be secured: the controllers
+// between them answer in a second or two, a person typing a PIN or checking
+// a number takes longer
+static const bigtime_t kSecuringHold = 5000000;
+static const bigtime_t kConfirmationHold = 30000000;
+static const bigtime_t kPinCodeHold = 60000000;
+
+
+static acl_link*
+link_by_handle(bt_usb_dev* bdev, uint16 handle)
+{
+	for (int32 i = 0; i < ACL_FLOW_HANDLES; i++) {
+		if (bdev->aclLinks[i].used && bdev->aclLinks[i].handle == handle)
+			return &bdev->aclLinks[i];
+	}
+	return NULL;
+}
+
+
+static acl_link*
+link_by_address(bt_usb_dev* bdev, const uint8* bdaddr)
+{
+	for (int32 i = 0; i < ACL_FLOW_HANDLES; i++) {
+		if (bdev->aclLinks[i].used
+			&& memcmp(bdev->aclLinks[i].bdaddr, bdaddr, 6) == 0)
+			return &bdev->aclLinks[i];
+	}
+	return NULL;
+}
+
+
+/*!	Holds the data of the link to  bdaddr, or of all links when it is not
+	known (more links than the table has room for).
+*/
+static void
+hold_link(bt_usb_dev* bdev, const uint8* bdaddr, bigtime_t duration)
+{
+	acl_link* link = link_by_address(bdev, bdaddr);
+	if (link != NULL)
+		link->holdUntil = system_time() + duration;
+	else
+		bdev->aclHoldUntil = system_time() + duration;
+}
+
+
+static void
+release_link(bt_usb_dev* bdev, acl_link* link)
+{
+	if (link != NULL)
+		link->holdUntil = 0;
+	bdev->aclHoldUntil = 0;
+}
+
+
+static const uint16 kL2capSignalingChannel = 0x0001;
+
+
+/*!	What an ACL packet carries: \a header holds its 4 bytes and the 4 of the
+	L2CAP header that follow in a first fragment.
+*/
+static void
+packet_kind(const uint8* header, size_t length, uint16* handle, bool* start,
+	bool* signaling)
+{
+	*handle = (header[0] | header[1] << 8) & 0x0fff;
+	// packet boundary: 1 continues a fragmented one
+	*start = ((header[1] >> 4) & 0x3) != 0x1;
+	*signaling = *start && length >= 8
+		&& (header[6] | header[7] << 8) == kL2capSignalingChannel;
+}
+
+
+/*!	The data of a link being secured waits; its L2CAP signaling does not:
+	a device opening its channels while it pairs (an Xbox controller does)
+	gave up after three seconds without answers. The decision is taken for a
+	whole L2CAP packet, at its first fragment: the fragments that follow one
+	sent go too, or the other side gets a packet cut by another. The packets
+	of a link leave in their order (tx_take_acl()).
+*/
+static bool
+link_held(bt_usb_dev* bdev, uint16 handle, bool start, bool signaling)
+{
+	if (!start || signaling)
+		return false;
+	acl_link* link = link_by_handle(bdev, handle);
+
+	bigtime_t now = system_time();
+	if (bdev->aclHoldUntil != 0 && now < bdev->aclHoldUntil)
+		return true;
+	return link != NULL && link->holdUntil != 0 && now < link->holdUntil;
+}
+
+
+bool gDiagnostics = false;
+
+
+static acl_flow_slot*
+find_slot(bt_usb_dev* bdev, uint16 handle, bool create)
+{
+	acl_flow_slot* free = NULL;
+	for (int32 i = 0; i < ACL_FLOW_HANDLES; i++) {
+		acl_flow_slot& slot = bdev->aclFlow[i];
+		if (slot.pending > 0 && slot.handle == handle)
+			return &slot;
+		if (slot.pending == 0 && free == NULL)
+			free = &slot;
+	}
+	if (create && free != NULL)
+		free->handle = handle;
+	return create ? free : NULL;
+}
+
+
+static status_t
+acl_flow_thread(void* data)
+{
+	bt_usb_dev* bdev = (bt_usb_dev*)data;
+	while (atomic_get(&bdev->txQuit) == 0) {
+		// a timeout too, for the packets held while a link is secured
+		status_t status = acquire_sem_etc(bdev->txWakeUp, 1,
+			B_RELATIVE_TIMEOUT, 100000);
+		if ((status != B_OK && status != B_TIMED_OUT)
+			|| atomic_get(&bdev->txQuit) != 0)
+			break;
+		sched_tx_processing(bdev);
+	}
+	return B_OK;
+}
+
+
+void
+acl_flow_init(bt_usb_dev* bdev)
+{
+	B_INITIALIZE_SPINLOCK(&bdev->aclFlowLock);
+	bdev->aclCredits = -1;
+	bdev->aclInFlight = 0;
+	bdev->helperThreads = 0;
+	bdev->aclHoldUntil = 0;
+	bdev->cmdCredits = 1;
+	bdev->cmdSentAt = 0;
+	bdev->cmdRetried = NULL;
+	bdev->eventSkip = 0;
+	bdev->aclNoCreditsSince = 0;
+	bdev->aclCreditsReset = false;
+	memset(bdev->aclLinks, 0, sizeof(bdev->aclLinks));
+	bdev->aclSent = 0;
+	bdev->aclCompleted = 0;
+	bdev->aclQueued = 0;
+	bdev->aclToldAt = 0;
+	bdev->aclMaxPackets = 0;
+	bdev->aclMtu = 0;
+	bdev->aclReported = false;
+	memset(bdev->aclFlow, 0, sizeof(bdev->aclFlow));
+
+	bdev->txQuit = 0;
+	bdev->txWakeUp = create_sem(0, "h2generic tx wake up");
+	bdev->txThread = -1;
+	if (bdev->txWakeUp >= 0) {
+		bdev->txThread = spawn_kernel_thread(acl_flow_thread, "h2generic tx",
+			B_URGENT_DISPLAY_PRIORITY, bdev);
+		if (bdev->txThread >= 0)
+			resume_thread(bdev->txThread);
+	}
+}
+
+
+bool
+helper_thread_start(bt_usb_dev* bdev, thread_func function, const char* name,
+	void* cookie)
+{
+	// none after the device began to close: nobody would wait for it
+	if (atomic_get(&bdev->txQuit) != 0)
+		return false;
+	atomic_add(&bdev->helperThreads, 1);
+	thread_id thread = spawn_kernel_thread(function, name, B_NORMAL_PRIORITY,
+		cookie);
+	if (thread >= 0 && resume_thread(thread) == B_OK)
+		return true;
+	atomic_add(&bdev->helperThreads, -1);
+	return false;
+}
+
+
+void
+helper_thread_done(bt_usb_dev* bdev)
+{
+	atomic_add(&bdev->helperThreads, -1);
+}
+
+
+bool
+helper_device_gone(bt_usb_dev* bdev)
+{
+	return !bdev->connected || (bdev->state & RUNNING) == 0
+		|| atomic_get(&bdev->txQuit) != 0;
+}
+
+
+void
+helper_threads_stop(bt_usb_dev* bdev)
+{
+	atomic_set(&bdev->txQuit, 1);
+
+	// the resend and recovery threads use the device and the code of this
+	// driver: when the controller reset in the middle of a stream, the driver
+	// was closed and unloaded under a thread still clearing a halt. Wait for
+	// them before the transfers are cancelled, so that none queues one after.
+	for (int32 i = 0; i < 1000 && atomic_get(&bdev->helperThreads) > 0; i++)
+		snooze(5000);
+	if (atomic_get(&bdev->helperThreads) > 0) {
+		ERROR("%s: %" B_PRId32 " helper threads still running\n", __func__,
+			atomic_get(&bdev->helperThreads));
+	}
+}
+
+
+void
+acl_flow_uninit(bt_usb_dev* bdev)
+{
+	atomic_set(&bdev->txQuit, 1);
+	if (bdev->txWakeUp >= 0)
+		delete_sem(bdev->txWakeUp);
+	if (bdev->txThread >= 0) {
+		status_t status;
+		wait_for_thread(bdev->txThread, &status);
+	}
+	bdev->txWakeUp = -1;
+	bdev->txThread = -1;
+}
+
+
+/*!	HCI command flow control (Vol 4, Part E 4.4): the controller tells in
+	every Command Complete and Command Status how many commands it takes.
+	A CSR BC4 takes one: a second one sent right behind it failed on the
+	control endpoint, both were lost (after a connection, the link policy
+	and the authentication, so a device never got its services).
+*/
+bool
+command_flow_take(bt_usb_dev* bdev)
+{
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&bdev->aclFlowLock);
+
+	bigtime_t now = system_time();
+	if (bdev->cmdCredits <= 0 && now - bdev->cmdSentAt > 2000000) {
+		// no answer to the last one: as Linux does, go on after 2 s
+		bdev->cmdCredits = 1;
+		dprintf("h2generic: no answer to the last command, going on\n");
+	}
+	bool take = bdev->cmdCredits > 0;
+	if (take) {
+		bdev->cmdCredits--;
+		bdev->cmdSentAt = now;
+	}
+
+	release_spinlock(&bdev->aclFlowLock);
+	restore_interrupts(state);
+	return take;
+}
+
+
+void
+command_flow_give_back(bt_usb_dev* bdev, bool wakeUp)
+{
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&bdev->aclFlowLock);
+	bdev->cmdCredits++;
+	release_spinlock(&bdev->aclFlowLock);
+	restore_interrupts(state);
+
+	// not when nothing was there to send: the thread woke itself up for
+	// ever, a core busy while the controller sat idle
+	if (wakeUp && bdev->txWakeUp >= 0)
+		release_sem_etc(bdev->txWakeUp, 1, B_DO_NOT_RESCHEDULE);
+}
+
+
+bool
+acl_flow_take(bt_usb_dev* bdev, net_buffer* nbuf)
+{
+	uint8 header[8];
+	size_t length = min_c(sizeof(header), nbuf->size);
+	if (length < 4 || nb->read(nbuf, 0, header, length) != B_OK)
+		return true;
+	uint16 handle;
+	bool start, signaling;
+	packet_kind(header, length, &handle, &start, &signaling);
+
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&bdev->aclFlowLock);
+
+	bool send = true;
+	if (bdev->aclCredits == 0 && bdev->aclMaxPackets > 0
+		&& system_time() - bdev->aclNoCreditsSince > 5000000) {
+		// No Number Of Completed Packets for 5 s with the controller full:
+		// one got lost (an event cut by its transfer). Waiting stopped the
+		// ACL data for good; the room is taken back instead.
+		bdev->aclCredits = bdev->aclMaxPackets;
+		memset(bdev->aclFlow, 0, sizeof(bdev->aclFlow));
+		bdev->aclCreditsReset = true;
+	}
+	if (link_held(bdev, handle, start, signaling))
+		send = false;
+	else if (bdev->aclCredits == 0)
+		send = false;
+	else if (bdev->aclCredits > 0) {
+		acl_flow_slot* slot = find_slot(bdev, handle, true);
+		if (slot == NULL) {
+			// more links than slots: count it against no handle
+			bdev->aclCredits--;
+		} else {
+			bdev->aclCredits--;
+			slot->pending++;
+		}
+		if (bdev->aclCredits == 0)
+			bdev->aclNoCreditsSince = system_time();
+	}
+	if (send) {
+		// how much of a signaling packet its fragments still carry
+		acl_link* link = link_by_handle(bdev, handle);
+		if (link != NULL) {
+			int32 fragment = header[2] | header[3] << 8;
+			if (start) {
+				link->signalingLeft = signaling && length >= 8
+					? max_c(0, (header[4] | header[5] << 8) + 4 - fragment)
+					: 0;
+			} else if (link->signalingLeft > 0)
+				link->signalingLeft = max_c(0, link->signalingLeft - fragment);
+		}
+	}
+
+	bool creditsReset = bdev->aclCreditsReset;
+	bdev->aclCreditsReset = false;
+	release_spinlock(&bdev->aclFlowLock);
+	restore_interrupts(state);
+
+	if (creditsReset)
+		ERROR("ACL credits not returned for 5 s, taken back\n");
+	return send;
+}
+
+
+/*!	The data of a link waiting for its security is held, the packets behind
+	it wait their turn; L2CAP signaling goes past them, with its fragments,
+	as it is on a channel of its own.
+*/
+bool
+acl_flow_overtakes(bt_usb_dev* bdev, net_buffer* nbuf)
+{
+	uint8 header[8];
+	size_t length = min_c(sizeof(header), nbuf->size);
+	if (length < 4 || nb->read(nbuf, 0, header, length) != B_OK)
+		return false;
+	uint16 handle;
+	bool start, signaling;
+	packet_kind(header, length, &handle, &start, &signaling);
+	if (start)
+		return signaling;
+
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&bdev->aclFlowLock);
+	acl_link* link = link_by_handle(bdev, handle);
+	bool overtakes = link != NULL && link->signalingLeft > 0;
+	release_spinlock(&bdev->aclFlowLock);
+	restore_interrupts(state);
+	return overtakes;
+}
+
+
+bool
+acl_flow_held(bt_usb_dev* bdev, net_buffer* nbuf)
+{
+	uint8 header[8];
+	size_t length = min_c(sizeof(header), nbuf->size);
+	if (length < 4 || nb->read(nbuf, 0, header, length) != B_OK)
+		return false;
+	uint16 handle;
+	bool start, signaling;
+	packet_kind(header, length, &handle, &start, &signaling);
+
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&bdev->aclFlowLock);
+	bool held = link_held(bdev, handle, start, signaling);
+	release_spinlock(&bdev->aclFlowLock);
+	restore_interrupts(state);
+	return held;
+}
+
+
+void
+acl_flow_give_back(bt_usb_dev* bdev, net_buffer* nbuf)
+{
+	uint8 header[2];
+	if (nb->read(nbuf, 0, header, sizeof(header)) != B_OK)
+		return;
+	uint16 handle = (header[0] | header[1] << 8) & 0x0fff;
+
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&bdev->aclFlowLock);
+	if (bdev->aclCredits >= 0) {
+		acl_flow_slot* slot = find_slot(bdev, handle, false);
+		if (slot != NULL && slot->pending > 0)
+			slot->pending--;
+		// a packet the controller refused halfway may have been counted as
+		// completed as well: never more room than the controller has
+		if (bdev->aclCredits < bdev->aclMaxPackets)
+			bdev->aclCredits++;
+	}
+	release_spinlock(&bdev->aclFlowLock);
+	restore_interrupts(state);
+}
+
+
+void
+acl_flow_transfer_done(bt_usb_dev* bdev)
+{
+	atomic_set(&bdev->aclInFlight, 0);
+	// sent by the thread: this is the completion of a USB transfer
+	if (bdev->txWakeUp >= 0)
+		release_sem_etc(bdev->txWakeUp, 1, B_DO_NOT_RESCHEDULE);
+}
+
+
+static void acl_flow_one_event(bt_usb_dev* bdev, const uint8* event);
+
+
+void
+acl_flow_event(bt_usb_dev* bdev, const void* data, size_t length)
+{
+	// An interrupt transfer ends with a short packet: an event whose size is
+	// a multiple of the endpoint's packet size runs on into the next one, and
+	// a Number Of Completed Packets missed this way is room lost for good.
+	const uint8* event = (const uint8*)data;
+
+	// the rest of an event the previous transfer cut: not one of its own
+	if (bdev->eventSkip < 0 && length > 0) {
+		// its length came now: the parameters follow
+		bdev->eventSkip = 1 + event[0];
+	}
+	if (bdev->eventSkip > 0) {
+		size_t skip = min_c((size_t)bdev->eventSkip, length);
+		bdev->eventSkip -= skip;
+		event += skip;
+		length -= skip;
+	}
+
+	while (length >= 2 && length >= (size_t)2 + event[1]) {
+		acl_flow_one_event(bdev, event);
+		length -= 2 + event[1];
+		event += 2 + event[1];
+	}
+	if (length >= 2)
+		bdev->eventSkip = 2 + event[1] - length;
+	else if (length == 1)
+		bdev->eventSkip = -1;
+}
+
+
+static void
+acl_flow_one_event(bt_usb_dev* bdev, const uint8* event)
+{
+	const uint8* parameters = event + 2;
+	uint8 size = event[1];
+	bool freed = false;
+
+	// what the controller tells besides the routine: a link that goes away,
+	// a mode change or a hardware error while a stream runs
+	if (gDiagnostics && event[0] != kEventNumberOfCompletedPackets) {
+		static int32 sTold = 0;
+		if (atomic_add(&sTold, 1) < 2000) {
+			// one line: printed byte by byte, it got cut by other output
+			char line[64];
+			size_t used = 0;
+			line[0] = '\0';
+			for (uint8 i = 0; i < size && i < 12; i++) {
+				used += snprintf(line + used, sizeof(line) - used, " %02x",
+					parameters[i]);
+			}
+			dprintf("h2generic: event 0x%02x at %" B_PRId64 " ms:%s\n",
+				event[0], system_time() / 1000, line);
+		}
+	}
+
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&bdev->aclFlowLock);
+
+	switch (event[0]) {
+		// A CSR BC4 refuses the ACL data (stalls its bulk endpoint) while it
+		// pairs or starts the encryption of a link. An audio stream that keeps
+		// sending then floods the bus with errors, the pairing events no
+		// longer come through and the controller resets. Hold the data until
+		// the link is secured, as a profile that asks for security would.
+		// Only the link being secured waits: the others go on.
+		case kEventConnectionComplete:
+		{
+			// status, handle (2), address (6), link type: ACL is 1
+			if (size < 10 || parameters[0] != 0 || parameters[9] != 1)
+				break;
+			uint16 handle = (parameters[1] | parameters[2] << 8) & 0x0fff;
+			acl_link* link = link_by_handle(bdev, handle);
+			for (int32 i = 0; link == NULL && i < ACL_FLOW_HANDLES; i++) {
+				if (!bdev->aclLinks[i].used)
+					link = &bdev->aclLinks[i];
+			}
+			if (link != NULL) {
+				link->used = true;
+				link->handle = handle;
+				memcpy(link->bdaddr, parameters + 3, 6);
+				link->holdUntil = 0;
+			}
+			break;
+		}
+
+		case kEventLinkKeyRequest:
+		case kEventIOCapabilityRequest:
+			if (size >= 6)
+				hold_link(bdev, parameters, kSecuringHold);
+			break;
+		case kEventUserConfirmationRequest:
+			if (size >= 6)
+				hold_link(bdev, parameters, kConfirmationHold);
+			break;
+		case kEventPinCodeRequest:
+		case kEventUserPasskeyRequest:
+			if (size >= 6)
+				hold_link(bdev, parameters, kPinCodeHold);
+			break;
+
+		case kEventSimplePairingComplete:
+		{
+			// status, address: the encryption follows a success
+			if (size < 7)
+				break;
+			acl_link* link = link_by_address(bdev, parameters + 1);
+			if (parameters[0] != 0)
+				release_link(bdev, link);
+			else
+				hold_link(bdev, parameters + 1, kSecuringHold);
+			freed = true;
+			break;
+		}
+
+		case kEventAuthenticationComplete:
+		{
+			// status, handle: the encryption follows a success
+			if (size < 3)
+				break;
+			uint16 handle = (parameters[1] | parameters[2] << 8) & 0x0fff;
+			acl_link* link = link_by_handle(bdev, handle);
+			if (parameters[0] != 0)
+				release_link(bdev, link);
+			else if (link != NULL && link->holdUntil != 0)
+				link->holdUntil = system_time() + kSecuringHold;
+			freed = true;
+			break;
+		}
+
+		case kEventEncryptionKeyRefreshComplete:
+		case kEventEncryptionChange:
+		{
+			// status, handle, enabled
+			if (size < 3)
+				break;
+			uint16 handle = (parameters[1] | parameters[2] << 8) & 0x0fff;
+			release_link(bdev, link_by_handle(bdev, handle));
+			freed = true;
+			break;
+		}
+
+		case kEventCommandStatus:
+			// status, number of commands, opcode
+			if (size >= 2) {
+				bdev->cmdCredits = parameters[1];
+				freed = true;
+			}
+			break;
+
+		case kEventCommandComplete:
+		{
+			// number of commands, opcode, then the return parameters
+			if (size >= 1) {
+				bdev->cmdCredits = parameters[0];
+				freed = true;
+			}
+			if (size < 4)
+				break;
+			uint16 opcode = parameters[1] | parameters[2] << 8;
+			const uint8* reply = parameters + 3;
+			if (opcode == kOpcodeReadBufferSize && size >= 3 + 8
+				&& reply[0] == 0) {
+				// status, ACL MTU (2), SCO MTU (1), ACL packets (2)
+				uint16 size = reply[1] | reply[2] << 8;
+				int32 packets = reply[4] | reply[5] << 8;
+				// asked again (the preferences do) while packets are in
+				// flight: the credits stay as they are
+				if (packets > 0 && packets != bdev->aclMaxPackets) {
+					bdev->aclMaxPackets = packets;
+					bdev->aclCredits = packets;
+					memset(bdev->aclFlow, 0, sizeof(bdev->aclFlow));
+					freed = true;
+				}
+				// the stack cuts the L2CAP packets at this size: it stayed at
+				// the L2CAP minimum of 48 bytes, about ten ACL packets for
+				// one of audio
+				if (size >= 48 && bdev->ndev != NULL)
+					bdev->ndev->mtu = size;
+				bdev->aclReported = true;
+				bdev->aclMtu = size;
+			} else if (opcode == kOpcodeReset) {
+				// no links any more
+				memset(bdev->aclLinks, 0, sizeof(bdev->aclLinks));
+				bdev->aclHoldUntil = 0;
+			}
+			if (opcode == kOpcodeReset && bdev->aclMaxPackets > 0) {
+				// the controller forgot what it held
+				bdev->aclCredits = bdev->aclMaxPackets;
+				memset(bdev->aclFlow, 0, sizeof(bdev->aclFlow));
+				freed = true;
+			}
+			break;
+		}
+
+		case kEventNumberOfCompletedPackets:
+		{
+			if (size < 1 || bdev->aclCredits < 0)
+				break;
+			uint8 handles = parameters[0];
+			if (size < 1 + 4 * handles)
+				break;
+			for (uint8 i = 0; i < handles; i++) {
+				const uint8* entry = parameters + 1 + 4 * i;
+				uint16 handle = (entry[0] | entry[1] << 8) & 0x0fff;
+				int32 count = entry[2] | entry[3] << 8;
+				bdev->aclCredits += count;
+				bdev->aclCompleted += count;
+				acl_flow_slot* slot = find_slot(bdev, handle, false);
+				if (slot != NULL)
+					slot->pending = max_c(0, slot->pending - count);
+			}
+			if (bdev->aclCredits > bdev->aclMaxPackets)
+				bdev->aclCredits = bdev->aclMaxPackets;
+			freed = true;
+			break;
+		}
+
+		case kEventDisconnectionComplete:
+		{
+			if (size >= 3 && parameters[0] == 0) {
+				acl_link* link = link_by_handle(bdev,
+					(parameters[1] | parameters[2] << 8) & 0x0fff);
+				release_link(bdev, link);
+				if (link != NULL)
+					link->used = false;
+			}
+			// the packets of a link that went away are not counted as
+			// completed: their room is free all the same
+			if (size < 3 || parameters[0] != 0 || bdev->aclCredits < 0)
+				break;
+			uint16 handle = (parameters[1] | parameters[2] << 8) & 0x0fff;
+			acl_flow_slot* slot = find_slot(bdev, handle, false);
+			if (slot != NULL) {
+				bdev->aclCredits += slot->pending;
+				slot->pending = 0;
+				if (bdev->aclCredits > bdev->aclMaxPackets)
+					bdev->aclCredits = bdev->aclMaxPackets;
+				freed = true;
+			}
+			break;
+		}
+	}
+
+	release_spinlock(&bdev->aclFlowLock);
+	restore_interrupts(state);
+
+	if (gDiagnostics && bdev->aclSent > 0
+		&& system_time() - bdev->aclToldAt > 5000000) {
+		bdev->aclToldAt = system_time();
+		dprintf("h2generic: ACL sent %" B_PRId32 ", completed %" B_PRId32
+			", queued %" B_PRId32 ", credits %" B_PRId32 ", hold %s\n",
+			bdev->aclSent, bdev->aclCompleted, bdev->aclQueued,
+			bdev->aclCredits, bdev->aclHoldUntil > system_time() ? "on" : "off");
+	}
+
+	if (bdev->aclReported) {
+		bdev->aclReported = false;
+		dprintf("h2generic: the controller takes %" B_PRId32 " ACL packets of "
+			"%u bytes\n", bdev->aclMaxPackets, bdev->aclMtu);
+	}
+
+	// the packets that waited for room, from the thread: this is the
+	// completion of a USB transfer
+	if (freed && bdev->txWakeUp >= 0)
+		release_sem_etc(bdev->txWakeUp, 1, B_DO_NOT_RESCHEDULE);
+}
