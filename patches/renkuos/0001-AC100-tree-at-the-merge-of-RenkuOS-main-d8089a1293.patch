+/*!	Tells L2CAP how many more ACL packets the driver takes: it waits instead
+	of having them dropped.
+*/
+static void
+update_acl_room(bt_usb_dev* bdev)
+{
+	if (bdev->ndev != NULL) {
+		bdev->ndev->aclRoom = max_c(0,
+			kMaxQueuedAclPackets - atomic_get(&bdev->aclQueued));
+	}
+}
+
