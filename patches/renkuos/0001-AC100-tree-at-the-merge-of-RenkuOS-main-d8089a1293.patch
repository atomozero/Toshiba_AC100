+class DeviceIconView : public BView {
+public:
+	DeviceIconView()
+		:
+		BView("icon", B_WILL_DRAW),
+		fKind(DEVICE_KIND_OTHER)
+	{
+		float size = be_control_look->DefaultLabelSpacing() * 8;
+		SetExplicitSize(BSize(size, size));
+		SetViewUIColor(B_PANEL_BACKGROUND_COLOR);
+	}
+
+	void SetKind(device_kind kind)
+	{
+		if (kind == fKind)
+			return;
+		fKind = kind;
+		Invalidate();
+	}
+
+	virtual void Draw(BRect updateRect)
+	{
+		DrawDeviceIcon(this, Bounds(), fKind);
+	}
+
+private:
+	device_kind	fKind;
+};
