+			| B_AUTO_UPDATE_SIZE_LIMITS | B_ASYNCHRONOUS_CONTROLS),
+	fAddress(address),
+	fConnected(false),
+	fAudioSink(false),
+	fVolumeTouched(0),
+	fPoller(NULL)
+{
+	fIcon = new DeviceIconView();
+	fNameView = new BStringView("name", "");
+	BFont font(be_bold_font);
+	font.SetSize(font.Size() * 1.4f);
+	fNameView->SetFont(&font);
+	fStatusView = new BStringView("status", "");
+
+	fTypeView = new BStringView("type", "");
+	fAddressView = new BStringView("address", address);
+	fPairingView = new BStringView("pairing", "");
+	fBatteryLabel = new BStringView("battery label", B_TRANSLATE("Battery:"));
+	fBatteryView = new BStringView("battery", "");
+
+	fServicesView = new BTextView("services");
+	fServicesView->MakeEditable(false);
+	fServicesView->MakeSelectable(false);
+	fServicesView->SetViewUIColor(B_PANEL_BACKGROUND_COLOR);
+
+	fAudioStatus = new BStringView("audio status", "");
+	fAudioOutputButton = new BButton("audio output",
+		B_TRANSLATE("Use as audio output"), new BMessage(kMsgAudioOutput));
+	fVolumeSlider = new BSlider("volume", B_TRANSLATE("Speaker volume"),
+		new BMessage(kMsgVolume), 0, 100, B_HORIZONTAL);
+	fVolumeSlider->SetModificationMessage(new BMessage(kMsgVolume));
+	fVolumeSlider->SetHashMarks(B_HASH_MARKS_NONE);
