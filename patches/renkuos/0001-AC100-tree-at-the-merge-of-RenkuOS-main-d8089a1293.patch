+static status_t
+tx_add(bt_usb_dev* bdev, int type, void* item)
+{
+	if (!tx_has_list(type))
+		return B_NOT_SUPPORTED;
+	mutex_lock(&bdev->txLock);
+	list_add_item(&bdev->nbuffersTx[type], item);
+	bdev->nbuffersPendingTx[type]++;
+	mutex_unlock(&bdev->txLock);
+	return B_OK;
+}
