From 09a7b01cd49ecab9f5c8dbe7dd5316731d0abf8a Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 26 Oct 2026 20:11:20 +0100
Subject: [PATCH 260/270] tegra_dc: 6 mA HDMI pre-emphasis, settings for audio
 experiments

The pre-emphasis current was 3 mA (code 6) where Linux has 6 mA (code
12) for the Tegra 2; with it a television kept the 1080p picture.

'hdmi_mode 720p', 'hdmi_hw_cts true' and 'hdmi_audio_auto true' in the
driver settings, read again at each hot plug, help to find out why the
HDMI audio sounds metallic.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../kernel/drivers/graphics/tegra_dc/hdmi.cpp | 30 ++++++++++++++-----
 1 file changed, 23 insertions(+), 7 deletions(-)

diff --git a/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp b/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
index 716a67dfe9..11e610361a 100644
--- a/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
+++ b/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
@@ -289,7 +289,6 @@ extern "C" status_t arm_dvc_i2c_write(uint8 address, uint8 reg,
 #define HDMI_VIDEO_RANGE_LIMITED	(1u << 1)
 #define HDMI_PE_CURRENT				0x99
 #define PE_CURRENT_ALL(x)			((uint32)(x) * 0x01010101)
-#define PE_CURRENT_6_MA				0x6
 
 #define POLL_INTERVAL				500000
 #define EDID_SIZE					256
@@ -318,6 +317,11 @@ struct tmds_settings {
 	uint32	pre_emphasis;	// PE_CURRENT units of 0.5 mA, 0 = off
 	uint32	drive_current;	// DRIVE_CURRENT code, 1.5 mA + n * 0.375 mA
 	uint32	vco_cap;
+
+	// experiments with the HDMI audio, also from the driver settings
+	bool	force_720p;		// "hdmi_mode 720p"
+	bool	hardware_cts;	// "hdmi_hw_cts": the block measures CTS itself
+	bool	audio_auto;		// "hdmi_audio_auto": source chosen by the block
 };
 
 
@@ -1165,7 +1169,8 @@ setup_audio_packets()
 		+ 128 * 44100 / 2) / (128 * 44100));
 
 	write_hdmi(HDMI_AUDIO_CNTRL0, AUDIO_CNTRL0_FRAMES_PER_BLOCK(0xc0)
-		| AUDIO_CNTRL0_ERROR_TOLERANCE(6) | AUDIO_CNTRL0_SOURCE_SPDIF);
+		| AUDIO_CNTRL0_ERROR_TOLERANCE(6)
+		| (sHdmi.tmds.audio_auto ? 0 : AUDIO_CNTRL0_SOURCE_SPDIF));
 
 	write_hdmi(HDMI_ACR_CTRL, 0);
 	write_hdmi(HDMI_AUDIO_N, AUDIO_N_RESETF | AUDIO_N_GENERATE_ALTERNATE
@@ -1178,7 +1183,8 @@ setup_audio_packets()
 		write_hdmi(HDMI_ACR_SUBPACK_LOW(i), i == 1
 			? ACR_SUBPACK_CTS(cts) : 0);
 	}
-	write_hdmi(HDMI_SPARE, SPARE_HW_CTS | SPARE_FORCE_SW_CTS
+	write_hdmi(HDMI_SPARE, SPARE_HW_CTS
+		| (sHdmi.tmds.hardware_cts ? 0 : SPARE_FORCE_SW_CTS)
 		| SPARE_CTS_RESET_VAL(1));
 	write_hdmi(HDMI_AUDIO_N, read_hdmi(HDMI_AUDIO_N) & ~AUDIO_N_RESETF);
 
@@ -1369,9 +1375,17 @@ connect()
 	tmds.force_dvi = get_driver_boolean_parameter(settings, "hdmi_dvi", false,
 		true);
 	tmds.pre_emphasis = min_c(strtoul(get_driver_parameter(settings,
-		"hdmi_pre_emphasis", "6", "6"), NULL, 0), 0xfu);
+		"hdmi_pre_emphasis", "12", "12"), NULL, 0), 0xfu);
+		// 12 = 6 mA, as Linux has it for the Tegra 2
 	tmds.drive_current = min_c(strtoul(get_driver_parameter(settings,
 		"hdmi_drive_current", "15", "15"), NULL, 0), 0x3fu);
+	const char* modeName = get_driver_parameter(settings, "hdmi_mode", NULL,
+		NULL);
+	tmds.force_720p = modeName != NULL && strcmp(modeName, "720p") == 0;
+	tmds.hardware_cts = get_driver_boolean_parameter(settings, "hdmi_hw_cts",
+		false, true);
+	tmds.audio_auto = get_driver_boolean_parameter(settings,
+		"hdmi_audio_auto", false, true);
 	tmds.vco_cap = min_c(strtoul(get_driver_parameter(settings,
 		"hdmi_vco_cap", "1", "1"), NULL, 0), 0xfu);
 	unload_driver_settings(settings);
@@ -1395,7 +1409,7 @@ connect()
 	if (status == B_OK) {
 		hdmiSink = is_hdmi_sink(edid, edidSize);
 		hdmi_mode chosen;
-		if (choose_mode(edid, edidSize, chosen))
+		if (!tmds.force_720p && choose_mode(edid, edidSize, chosen))
 			sHdmi.mode = chosen;
 		char name[14] = "unknown";
 		for (uint32 offset = 0x36; offset < 0x7e; offset += 18) {
@@ -1436,9 +1450,11 @@ connect()
 
 	dprintf("tegra_dc: hdmi: %ux%u, %" B_PRIu32 " kHz, totals %ux%u, VIC %u, "
 		"%s, pre-emphasis %" B_PRIu32 ", drive %" B_PRIu32 ", VCO cap %"
-		B_PRIu32 "\n", mode.h_display, mode.v_display, mode.pixel_clock,
+		B_PRIu32 "%s%s\n", mode.h_display, mode.v_display, mode.pixel_clock,
 		mode.h_total, mode.v_total, mode.vic, hdmiSink ? "HDMI" : "DVI",
-		tmds.pre_emphasis, tmds.drive_current, tmds.vco_cap);
+		tmds.pre_emphasis, tmds.drive_current, tmds.vco_cap,
+		tmds.hardware_cts ? ", hardware CTS" : "",
+		tmds.audio_auto ? ", audio source auto" : "");
 }
 
 
