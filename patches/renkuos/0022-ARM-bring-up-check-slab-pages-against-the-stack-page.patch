From 1aada42055feb508cf1f76490ae36d649e8dd0bb Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 17:03:38 +0200
Subject: [PATCH 022/270] ARM bring-up: check slab pages against the stack page
 (not for merging)

---
 src/system/kernel/slab/ObjectCache.cpp | 41 ++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/src/system/kernel/slab/ObjectCache.cpp b/src/system/kernel/slab/ObjectCache.cpp
index 0601d39569..75cd3d4eee 100644
--- a/src/system/kernel/slab/ObjectCache.cpp
+++ b/src/system/kernel/slab/ObjectCache.cpp
@@ -17,6 +17,12 @@
 
 #include "MemoryManager.h"
 #include "slab_private.h"
+#ifdef __ARM__
+#	include <arch/arm/arm_boot_marker.h>
+#	include <kernel.h>
+#	include <vm/vm.h>
+#	include <vm/VMAddressSpace.h>
+#endif
 
 
 RANGE_MARKER_FUNCTION_BEGIN(SlabObjectCache)
@@ -123,6 +129,41 @@ ObjectCache::InitSlab(slab* slab, void* pages, size_t byteCount, uint32 flags)
 	TRACE_CACHE(this, "construct (%p, %p .. %p, %lu)", slab, pages,
 		((uint8*)pages) + byteCount, byteCount);
 
+#ifdef __ARM__
+	VMAddressSpace* kernelSpace = VMAddressSpace::Kernel();
+	if (gKernelStartup && kernelSpace != NULL) {
+		// bring-up aid: check that the slab pages do not share a physical page
+		// with the current stack
+		VMTranslationMap* map = kernelSpace->TranslationMap();
+		addr_t stack = ROUNDDOWN((addr_t)__builtin_frame_address(0),
+			B_PAGE_SIZE);
+		phys_addr_t stackPhysical = 0;
+		uint32 flags;
+		bool stackMapped = map->Query(stack, &stackPhysical, &flags) == B_OK
+			&& (flags & PAGE_PRESENT) != 0;
+		for (addr_t address = ROUNDDOWN((addr_t)pages, B_PAGE_SIZE);
+				stackMapped && address < (addr_t)pages + byteCount;
+				address += B_PAGE_SIZE) {
+			phys_addr_t physical = 0;
+			if (map->Query(address, &physical, &flags) != B_OK
+				|| (flags & PAGE_PRESENT) == 0) {
+				continue;
+			}
+			if (physical == stackPhysical || address == stack) {
+				arm_boot_marker(40);
+				arm_boot_marker_value(7, (uint32)address);
+				arm_boot_marker_value(8, (uint32)physical);
+				arm_boot_marker_value(9, (uint32)stack);
+				arm_boot_marker_value(10, (uint32)stackPhysical);
+				panic("slab page %p (phys %#" B_PRIxPHYSADDR ") is also the stack "
+					"page %p", (void*)address, physical, (void*)stack);
+			}
+		}
+		arm_boot_marker_value(11, (uint32)stack);
+		arm_boot_marker_value(12, (uint32)stackPhysical);
+	}
+#endif
+
 	slab->pages = pages;
 	slab->count = slab->size = byteCount / object_size;
 	slab->free.Init();
