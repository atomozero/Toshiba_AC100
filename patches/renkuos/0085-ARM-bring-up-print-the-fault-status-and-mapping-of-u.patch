From b2dad1665c7f700649fc2453f8b49f9fd27751c9 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 13:19:14 +0200
Subject: [PATCH 085/270] ARM bring-up: print the fault status and mapping of
 unhandled user faults (not for merging)

---
 .../kernel/arch/arm/arch_thread_types.h       |  1 +
 src/system/kernel/arch/arm/arch_int.cpp       | 26 +++++++++++++++++++
 src/system/kernel/vm/vm.cpp                   |  6 +++++
 3 files changed, 33 insertions(+)

diff --git a/headers/private/kernel/arch/arm/arch_thread_types.h b/headers/private/kernel/arch/arm/arch_thread_types.h
index c068fa6790..0924f3edd8 100644
--- a/headers/private/kernel/arch/arm/arch_thread_types.h
+++ b/headers/private/kernel/arch/arm/arch_thread_types.h
@@ -59,6 +59,7 @@ struct arch_thread {
 	uint32	lastUserLR;
 	uint32	lastSyscall;
 	uint32	lastCallers[4];
+	uint32	lastFaultStatus;
 };
 
 struct arch_team {
diff --git a/src/system/kernel/arch/arm/arch_int.cpp b/src/system/kernel/arch/arm/arch_int.cpp
index 69faee35ca..4575cf29e0 100644
--- a/src/system/kernel/arch/arm/arch_int.cpp
+++ b/src/system/kernel/arch/arm/arch_int.cpp
@@ -365,6 +365,31 @@ arch_arm_syscall(struct iframe *iframe)
 }
 
 
+/*!	Bring-up aid, called by vm_page_fault() for a user fault it could not
+	resolve: the fault status and how the address is mapped.
+*/
+extern "C" void
+arm_debug_print_user_fault(addr_t address)
+{
+	Thread* thread = thread_get_current_thread();
+	VMAddressSpace* addressSpace = VMAddressSpace::GetCurrent();
+	phys_addr_t physical = 0;
+	uint32 flags = 0;
+	if (addressSpace != NULL) {
+		VMTranslationMap* map = addressSpace->TranslationMap();
+		map->Lock();
+		map->Query(address, &physical, &flags);
+		map->Unlock();
+		addressSpace->Put();
+	}
+	dprintf("vm_page_fault: FSR %#" B_PRIx32 ", mapping: physical %#"
+		B_PRIxPHYSADDR ", flags %#" B_PRIx32 " (present %d accessed %d "
+		"modified %d)\n", thread->arch_info.lastFaultStatus, physical, flags,
+		(flags & PAGE_PRESENT) != 0, (flags & PAGE_ACCESSED) != 0,
+		(flags & PAGE_MODIFIED) != 0);
+}
+
+
 static bool
 arch_arm_handle_access_flag_fault(addr_t far, uint32 fsr, bool isWrite, bool isExec)
 {
@@ -582,6 +607,7 @@ arch_arm_page_fault(struct iframe *frame, addr_t far, uint32 fsr, bool isWrite,
 		// bring-up aid: where a crashing thread was
 		thread->arch_info.lastUserPC = frame->pc;
 		thread->arch_info.lastUserLR = frame->usr_lr;
+		thread->arch_info.lastFaultStatus = fsr;
 	}
 
 	enable_interrupts();
diff --git a/src/system/kernel/vm/vm.cpp b/src/system/kernel/vm/vm.cpp
index 4dbd8da7b8..35fbf613ea 100644
--- a/src/system/kernel/vm/vm.cpp
+++ b/src/system/kernel/vm/vm.cpp
@@ -72,6 +72,9 @@
 
 //#define TRACE_VM
 //#define TRACE_FAULTS
+#ifdef __ARM__
+extern "C" void arm_debug_print_user_fault(addr_t address);
+#endif
 #ifdef TRACE_VM
 #	define TRACE(x) dprintf x
 #else
@@ -3849,6 +3852,9 @@ vm_page_fault(addr_t address, addr_t faultAddress, bool isWrite, bool isExecute,
 				}
 				addressSpace->ReadUnlock();
 			}
+#ifdef __ARM__
+			arm_debug_print_user_fault(address);
+#endif
 #endif	// bring-up aid
 
 			// If the thread has a signal handler for SIGSEGV, we simply
