@@ -114,9 +115,28 @@ enum {
 #define KBD_ENABLE					0xf4
 #define PS2_SEND_COMMAND			1	// NVEC_PS2
 #define PS2_AUTO_RECEIVE_N			3
+#define GET_SYSTEM_STATUS			0	// NVEC_SYS
 #define LID_SWITCH					(1 << 1)
 #define PWR_BUTTON					(1 << 15)
 
+// NVEC_BAT requests
+enum {
+	BAT_SLOT_STATUS,
+	BAT_VOLTAGE,
+	BAT_TIME_REMAINING,
+	BAT_CURRENT,
+	BAT_AVERAGE_CURRENT,
+	BAT_AVERAGING_TIME_INTERVAL,
+	BAT_CAPACITY_REMAINING,
+	BAT_LAST_FULL_CHARGE_CAPACITY,
+	BAT_DESIGN_CAPACITY,
+	BAT_CRITICAL_CAPACITY,
+	BAT_TEMPERATURE,
+	BAT_MANUFACTURER,
+	BAT_MODEL,
+	BAT_TYPE,
+};
+
 #define NVEC_MSG_SIZE				34
 #define NVEC_RX_COUNT				16	// powers of two
 #define NVEC_TX_COUNT				16
@@ -188,12 +208,36 @@ struct nvec_device {
 	int32				clicks;
 	bigtime_t			lastClick;
 	bigtime_t			clickSpeed;
+
+	// battery and power supply, polled
+	spinlock			batteryLock;
+	thread_id			pollThread;
+	bool				acOnline;
+	bool				batteryPresent;
+	uint32				batteryState;
+	uint32				batteryPercent;
+	uint32				voltage;		// mV
+	int32				current;		// mA, negative when discharging
+	uint32				remaining;		// mAh
+	uint32				lastFull;		// mAh
+	uint32				design;			// mAh
+	uint32				critical;		// mAh
+	char				manufacturer[BATTERY_MAX_STRING_LENGTH];
+	char				model[BATTERY_MAX_STRING_LENGTH];
+	char				type[BATTERY_MAX_STRING_LENGTH];
+};
+
+
+enum nvec_device_kind {
+	NVEC_KEYBOARD,
+	NVEC_MOUSE,
+	NVEC_BATTERY,
 };
 
 
 struct nvec_handle {
-	nvec_device*	device;
-	bool			keyboard;
+	nvec_device*		device;
+	nvec_device_kind	kind;
 };
 
 
@@ -672,6 +716,135 @@ handle_mouse_byte(nvec_device* device, uint8 byte)
 }
 
 
+static uint16
+message_uint16(const nvec_msg* message)
+{
+	return message->data[4] | (message->data[5] << 8);
+}
+
+
+static void
+message_string(const nvec_msg* message, char* string)
+{
+	uint32 length = min_c(message->size > 4 ? message->size - 4 : 0,
+		(uint32)BATTERY_MAX_STRING_LENGTH - 1);
+	memcpy(string, message->data + 4, length);
+	string[length] = '\0';
+}
+
+
+static void
+request_battery_details(nvec_device* device)
+{
+	static const uint8 kDetails[] = { BAT_LAST_FULL_CHARGE_CAPACITY,
+		BAT_DESIGN_CAPACITY, BAT_CRITICAL_CAPACITY, BAT_MANUFACTURER,
+		BAT_MODEL, BAT_TYPE };
+	for (size_t i = 0; i < B_COUNT_OF(kDetails); i++) {
+		uint8 request[] = { NVEC_BAT, kDetails[i] };
+		nvec_write(device, request, sizeof(request));
+	}
+}
+
+
+/*!	Answers to the requests of the poll thread: the type byte, the length,
+	the request, a status, then the payload (16 bit values little endian).
+*/
+static void
+handle_battery_message(nvec_device* device, const nvec_msg* message)
+{
+	if (message->size < 6 && message->data[2] != BAT_SLOT_STATUS)
+		return;
+
+	bool requestDetails = false;
+	InterruptsSpinLocker locker(device->batteryLock);
+	switch (message->data[2]) {
+		case BAT_SLOT_STATUS:
+		{
+			if (message->size < 6)
+				return;
+			uint8 status = message->data[4];
+			bool present = (status & 1) != 0;
+			requestDetails = present && !device->batteryPresent;
+			device->batteryPresent = present;
+			switch ((status >> 1) & 3) {
+				case 0:
+					device->batteryState = BATTERY_NOT_CHARGING;
+					break;
+				case 1:
+					device->batteryState = BATTERY_CHARGING;
+					break;
+				case 2:
+					device->batteryState = BATTERY_DISCHARGING;
+					break;
+				default:
+					device->batteryState = 0;
+					break;
+			}
+			device->batteryPercent = message->data[5];
+			break;
+		}
+		case BAT_VOLTAGE:
+			device->voltage = message_uint16(message);
+			break;
+		case BAT_CURRENT:
+			device->current = (int16)message_uint16(message);
+			break;
+		case BAT_CAPACITY_REMAINING:
+			device->remaining = message_uint16(message);
+			break;
+		case BAT_LAST_FULL_CHARGE_CAPACITY:
+			device->lastFull = message_uint16(message);
+			break;
+		case BAT_DESIGN_CAPACITY:
+			device->design = message_uint16(message);
+			break;
+		case BAT_CRITICAL_CAPACITY:
+			device->critical = message_uint16(message);
+			break;
+		case BAT_MANUFACTURER:
+			message_string(message, device->manufacturer);
+			break;
+		case BAT_MODEL:
+			message_string(message, device->model);
+			break;
+		case BAT_TYPE:
+			message_string(message, device->type);
+			break;
+	}
+	locker.Unlock();
+
+	if (requestDetails)
+		request_battery_details(device);
+}
+
+
+/*!	Asks for the power supply and one battery value every 5 seconds, in turn:
+	all at once seems to overload the EC (as in Linux).
+*/
+static status_t
+poll_thread(void* data)
+{
+	nvec_device* device = (nvec_device*)data;
+	static const uint8 kBatteryValues[] = { BAT_SLOT_STATUS, BAT_VOLTAGE,
+		BAT_CURRENT, BAT_CAPACITY_REMAINING };
+	uint32 next = 0;
+
+	while (!device->stopping) {
+		static const uint8 kSystemStatus[] = { NVEC_SYS, GET_SYSTEM_STATUS };
+		nvec_write(device, kSystemStatus, sizeof(kSystemStatus));
+		snooze(100000);
+
+		uint8 request[] = { NVEC_BAT,
+			kBatteryValues[next++ % B_COUNT_OF(kBatteryValues)] };
+		nvec_write(device, request, sizeof(request));
+
+		for (int32 i = 0; i < 50 && !device->stopping; i++)
+			snooze(100000);
+	}
+	return B_OK;
+}
+
+
 static void
 dump_message(const char* what, const nvec_msg* message)
 {
@@ -717,6 +890,19 @@ rx_thread(void* data)
 				}
 				break;
 
+			case NVEC_BAT:
+				handle_battery_message(device, &message);
+				break;
+
+			case NVEC_SYS:
+				if (message.size >= 6 && message.data[2] == GET_SYSTEM_STATUS) {
+					device->acOnline = message_uint16(&message) != 0;
+					break;
+				}
+				if (reported++ < 64)
+					dump_message("message", &message);
+				break;
+
 			case NVEC_CNTL:
 				if (message.size >= 8 && message.data[2] == GET_FIRMWARE_VERSION) {
 					TRACE_ALWAYS("EC firmware version %02x.%02x.%02x / %02x\n",
@@ -822,7 +1008,12 @@ nvec_open(void* cookie, const char* path, int openMode, void** _cookie)
 		return B_NO_MEMORY;
 
 	handle->device = (nvec_device*)cookie;
-	handle->keyboard = strstr(path, "keyboard") != NULL;
+	if (strstr(path, "keyboard") != NULL)
+		handle->kind = NVEC_KEYBOARD;
+	else if (strstr(path, "mouse") != NULL)
+		handle->kind = NVEC_MOUSE;
+	else
+		handle->kind = NVEC_BATTERY;
 	*_cookie = handle;
 	return B_OK;
 }
@@ -926,13 +1117,80 @@ read_movement(nvec_device* device, void* buffer)
 }
 
 
+/*!	Looks like an ACPI battery to PowerStatus. */
+static status_t
+battery_control(nvec_device* device, uint32 op, void* buffer)
+{
+	if (!IS_USER_ADDRESS(buffer))
+		return B_BAD_ADDRESS;
+
+	switch (op) {
+		case IDENTIFY_DEVICE:
+		{
+			uint32 magic = kMagicACPIBatteryID;
+			return user_memcpy(buffer, &magic, sizeof(magic));
+		}
+
+		case GET_BATTERY_INFO:
+		{
+			acpi_battery_info info = {};
+			InterruptsSpinLocker locker(device->batteryLock);
+			if (device->batteryPresent) {
+				info.state = device->batteryState;
+				if (device->critical != 0
+					&& device->remaining <= device->critical) {
+					info.state |= BATTERY_CRITICAL_STATE;
+				}
+				info.current_rate = device->current < 0 ? -device->current
+					: device->current;
+				// the EC reports the charge in percent more reliably
+				info.capacity = device->lastFull != 0
+					? device->lastFull * device->batteryPercent / 100
+					: device->remaining;
+				info.voltage = device->voltage;
+			}
+			locker.Unlock();
+			return user_memcpy(buffer, &info, sizeof(info));
+		}
+
+		case GET_EXTENDED_BATTERY_INFO:
+		{
+			acpi_extended_battery_info info = {};
+			InterruptsSpinLocker locker(device->batteryLock);
+			info.power_unit = ACPI_BATTERY_UNIT_MA;
+			info.design_capacity = device->design;
+			info.last_full_charge = device->lastFull != 0 ? device->lastFull
+				: device->design;
+			info.technology = 1;	// rechargeable
+			info.design_voltage = device->voltage;
+			info.design_capacity_warning = info.last_full_charge / 10;
+			info.design_capacity_low = device->critical;
+			info.capacity_granularity_1 = 1;
+			info.capacity_granularity_2 = 1;
+			strlcpy(info.model_number, device->model,
+				sizeof(info.model_number));
+			strlcpy(info.type, device->type, sizeof(info.type));
+			strlcpy(info.oem_info, device->manufacturer,
+				sizeof(info.oem_info));
+			info.revision = ACPI_BATTERY_REVISION_BIF;
+			locker.Unlock();
+			return user_memcpy(buffer, &info, sizeof(info));
+		}
+	}
+	return B_DEV_INVALID_IOCTL;
+}
+
+
 static status_t
 nvec_control(void* cookie, uint32 op, void* buffer, size_t length)
 {
 	nvec_handle* handle = (nvec_handle*)cookie;
 	nvec_device* device = handle->device;
 
-	if (handle->keyboard) {
+	if (handle->kind == NVEC_BATTERY)
+		return battery_control(device, op, buffer);
+
+	if (handle->kind == NVEC_KEYBOARD) {
 		switch (op) {
 			case KB_READ:
 				return read_key(device, buffer);
@@ -1074,6 +1332,7 @@ nvec_init_driver(device_node* node, void** _cookie)
 	device->lock = B_SPINLOCK_INITIALIZER;
 	device->keyLock = B_SPINLOCK_INITIALIZER;
 	device->mouseLock = B_SPINLOCK_INITIALIZER;
+	device->batteryLock = B_SPINLOCK_INITIALIZER;
 	device->registersArea = device->gpioArea = -1;
 	device->rxSem = device->txSem = device->transferSem = device->keySem
 		= device->mouseSem = -1;
@@ -1146,6 +1405,10 @@ nvec_init_driver(device_node* node, void** _cookie)
 
 	start_ec(device);
 
+	device->pollThread = spawn_kernel_thread(poll_thread, "nvec poll",
+		B_LOW_PRIORITY, device);
+	resume_thread(device->pollThread);
+
 	sPowerOffDevice = device;
 	gArmPowerOffHook = &nvec_power_off;
 
@@ -1184,6 +1447,7 @@ nvec_uninit_driver(void* cookie)
 	status_t result;
 	wait_for_thread(device->rxThread, &result);
 	wait_for_thread(device->txThread, &result);
+	wait_for_thread(device->pollThread, &result);
 	delete_area(device->registersArea);
 	delete_area(device->gpioArea);
 	delete device;
@@ -1201,6 +1465,10 @@ nvec_register_child_devices(void* cookie)
 		status = gDeviceManager->publish_device(device->node,
 			"input/mouse/nvec/0", NVEC_DEVICE_MODULE_NAME);
 	}
+	if (status == B_OK) {
+		status = gDeviceManager->publish_device(device->node,
+			"power/nvec_battery/0", NVEC_DEVICE_MODULE_NAME);
+	}
 	return status;
 }
 
