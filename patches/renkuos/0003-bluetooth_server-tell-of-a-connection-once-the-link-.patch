From 2764dc7f4dbdbee88ce0a53f7648672403140693 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Thu, 19 Nov 2026 19:33:36 +0100
Subject: [PATCH 03/32] bluetooth_server: tell of a connection once the link is
 secured

A device that refuses to be called, as a Google Home does, still brings
the link up for a moment before the authentication fails. The Bluetooth
audio add-on calls the speakers back every 30 s while they are away, so
"connected" and "disconnected" came up twice a minute. The user now
hears of a connection once its link is secured, and of a disconnection
only after that.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/servers/bluetooth/LocalDeviceImpl.cpp | 17 +++++++++++++----
 src/servers/bluetooth/LocalDeviceImpl.h   |  2 ++
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/src/servers/bluetooth/LocalDeviceImpl.cpp b/src/servers/bluetooth/LocalDeviceImpl.cpp
index b299dc28cb..94d1780375 100644
--- a/src/servers/bluetooth/LocalDeviceImpl.cpp
+++ b/src/servers/bluetooth/LocalDeviceImpl.cpp
@@ -419,17 +419,20 @@ LocalDeviceImpl::_LinkUp(ServerRemoteDevice* rd, uint16 handle)
 {
 	rd->handle = handle;
 	rd->conn_state = RemoteDevice::CONNECTED;
-	Notifications::Connected(rd);
+	// the user hears of it once the link is secured: a device that refuses
+	// to be called (a Google Home does) brings a link up for a moment only
+	rd->announced = false;
 }
 
 
-/*!	The link to \a rd is gone, or it never came up. The watchers and the user
-	hear about it only when it had been up.
+/*!	The link to \a rd is gone, or it never came up. The watchers hear about
+	it only when it had been up, the user only when it had been told of it.
 */
 void
 LocalDeviceImpl::_LinkDown(ServerRemoteDevice* rd)
 {
 	bool wasConnected = rd->conn_state == RemoteDevice::CONNECTED;
+	bool wasAnnounced = wasConnected && rd->announced;
 
 	rd->conn_state = RemoteDevice::DISCONNECTED;
 	rd->handle = kInvalidHandle;
@@ -437,11 +440,13 @@ LocalDeviceImpl::_LinkDown(ServerRemoteDevice* rd)
 	rd->keySizeChecked = false;
 	rd->remoteIOKnown = false;
 	rd->outgoing = false;
+	rd->announced = false;
 
 	if (!wasConnected)
 		return;
 
-	Notifications::Disconnected(rd);
+	if (wasAnnounced)
+		Notifications::Disconnected(rd);
 
 	BMessage notice(BT_MSG_DISCONN_COMPLETED);
 	notice.AddUInt8("status", BT_OK);
@@ -2835,6 +2840,10 @@ void
 LocalDeviceImpl::_LinkSecured(ServerRemoteDevice* rd)
 {
 	rd->keySizeChecked = true;
+	if (!rd->announced) {
+		rd->announced = true;
+		Notifications::Connected(rd);
+	}
 	if (rd->outgoing)
 		((BluetoothServer*)be_app)->StartServices(rd);
 	else {
diff --git a/src/servers/bluetooth/LocalDeviceImpl.h b/src/servers/bluetooth/LocalDeviceImpl.h
index a22ea0a7a6..1b863c325b 100644
--- a/src/servers/bluetooth/LocalDeviceImpl.h
+++ b/src/servers/bluetooth/LocalDeviceImpl.h
@@ -50,6 +50,8 @@ struct ServerRemoteDevice
 	BMessage			services;
 	bool				outgoing;
 		// we opened the connection, rather than the device
+	bool				announced;
+		// the user was told that the device is connected
 };
 
 // no link uses it: the handles go up to 0x0eff
-- 
