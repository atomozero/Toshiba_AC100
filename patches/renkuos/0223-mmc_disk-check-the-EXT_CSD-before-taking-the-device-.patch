From c57d1fd58ee2dea1b981e2cf73abd4d482bc76f2 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 25 Oct 2026 18:05:57 +0100
Subject: [PATCH 223/270] mmc_disk: check the EXT_CSD before taking the device
 size from it

The size of an eMMC device comes from the SEC_COUNT field of its
EXT_CSD, which was read once and trusted. On the Toshiba AC100 that
first read came back corrupted at times: a sector count of 1.96 TB for a
16 GB device. The partition scan then kept reading past the end of the
device (ADDRESS_OUT_OF_RANGE), the boot volume was never found and the
boot hung.

Read the EXT_CSD until two reads agree on the fields that never change
and these make sense (structure, revision, and a size above 2GB when the
CSD says so), up to five times.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../kernel/drivers/disk/mmc/mmc_disk.cpp      | 57 ++++++++++++++++++-
 1 file changed, 56 insertions(+), 1 deletion(-)

diff --git a/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp b/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp
index 9d64cd0c6b..077ba4ce89 100644
--- a/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp
+++ b/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp
@@ -306,6 +306,57 @@ mmc_disk_read_ext_csd(mmc_disk_driver_info* info, uint8* extCsd)
 }
 
 
+/*!	Reads the EXT_CSD until two reads agree on the fields that never change
+	and these make sense. The size of the device comes from it: on the
+	Toshiba AC100 the first read came back corrupted at times, with a sector
+	count of 1.96 TB for a 16 GB eMMC, and the partition scan then kept
+	reading past the end of the device, so the boot volume was never found.
+*/
+static status_t
+mmc_disk_read_ext_csd_checked(mmc_disk_driver_info* info, uint8* extCsd,
+	bool largerThan2GB)
+{
+	uint8* check = (uint8*)malloc(kExtCsdSize);
+	if (check == NULL)
+		return B_NO_MEMORY;
+
+	status_t error = B_ERROR;
+	for (int attempt = 0; attempt < 5; attempt++) {
+		if (attempt > 0)
+			snooze(10000);
+
+		error = mmc_disk_read_ext_csd(info, extCsd);
+		if (error != B_OK)
+			continue;
+		error = mmc_disk_read_ext_csd(info, check);
+		if (error != B_OK)
+			continue;
+
+		// EXT_CSD_STRUCTURE is at most 2 and EXT_CSD_REV at most 8 (eMMC
+		// 5.1); a device larger than 2GB has its size in SEC_COUNT only
+		uint32 sectors = ext_csd_sector_count(extCsd);
+		bool plausible = extCsd[kExtCsdStructure] <= 2
+			&& extCsd[kExtCsdRevision] <= 8
+			&& (!largerThan2GB
+				|| (uint64)sectors * kBlockSize > 2LL * 1024 * 1024 * 1024);
+		if (plausible && ext_csd_same_device(extCsd, check)) {
+			free(check);
+			return B_OK;
+		}
+
+		ERROR("EXT_CSD read %d not usable: sectors %" B_PRIu32 " and %"
+			B_PRIu32 ", revision %u and %u, structure %u and %u\n", attempt,
+			sectors, ext_csd_sector_count(check), extCsd[kExtCsdRevision],
+			check[kExtCsdRevision], extCsd[kExtCsdStructure],
+			check[kExtCsdStructure]);
+		error = B_IO_ERROR;
+	}
+
+	free(check);
+	return error;
+}
+
+
 /*!	Polls CMD13 (SEND_STATUS) until the device is back in the transfer state
 	and ready for data, for example after the busy phase of CMD6.
 */
@@ -751,7 +802,11 @@ mmc_disk_get_emmc_geometry(mmc_disk_driver_info* info, mmc_disk_csd& csd,
 		return B_NO_MEMORY;
 
 	memset(extCsd, 0, kExtCsdSize);
-	status_t error = mmc_disk_read_ext_csd(info, extCsd);
+	// C_SIZE 0xFFF in the CSD: the device is larger than 2GB
+	bool largerThan2GB = ((csd.bits[0] >> 54) & 0x3FF)
+		== 0x3FF && (csd.bits[1] & 0x3) == 0x3;
+	status_t error = mmc_disk_read_ext_csd_checked(info, extCsd,
+		largerThan2GB);
 	if (error == B_OK) {
 		sectorCount = ext_csd_sector_count(extCsd);
 		TRACE("EXT_CSD: revision %u, structure %u, device type %02x, "
