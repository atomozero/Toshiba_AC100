From 10326dc8fe2ef0cddb22fcdd1a23a457aea7d623 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Fri, 23 Oct 2026 14:08:45 +0200
Subject: [PATCH 180/203] ARM bring-up: tegra_audio: a diagnostics device for
 the ac100audio tool (not for merging)

/dev/audio/tegra_audio_diag can be opened next to the media server and
reads and writes Tegra peripheral and codec registers and plays tones,
so the audio path can be examined without building a new image.
---
 .../drivers/audio/tegra/tegra_audio.cpp       | 216 ++++++++++++++++--
 1 file changed, 203 insertions(+), 13 deletions(-)

diff --git a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
index 1fcd2cbbac..0aed59c3da 100644
--- a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
+++ b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
@@ -37,6 +37,30 @@
 #define TEGRA_AUDIO_DRIVER_MODULE_NAME	"drivers/audio/hmulti/tegra_audio/driver_v1"
 #define TEGRA_AUDIO_DEVICE_MODULE_NAME	"drivers/audio/hmulti/tegra_audio/device_v1"
 
+// Bring-up: a second device, /dev/audio/tegra_audio_diag, that can be opened
+// next to the media server's and takes only these requests (the ac100audio
+// tool uses it)
+#define TEGRA_AUDIO_DIAG_PATH		"audio/tegra_audio_diag"
+#define TEGRA_AUDIO_DIAG			0x41433130	// 'AC10'
+
+enum {
+	TEGRA_DIAG_READ32 = 1,		// args[0] physical address -> result[0]
+	TEGRA_DIAG_WRITE32,			// args[0] physical address, args[1] value
+	TEGRA_DIAG_CODEC_READ,		// args[0] register -> result[0]
+	TEGRA_DIAG_CODEC_WRITE,		// args[0] register, args[1] value
+	TEGRA_DIAG_TONE,			// args[0] ms, args[1] frames per period,
+								// args[2] amplitude, args[3] channels (1 left,
+								// 2 right) -> result[0] DMA interrupts
+	TEGRA_DIAG_STATUS,			// -> result[0] opened, [1] running,
+								// [2] buffer frames, [3] buffer count
+};
+
+struct tegra_audio_diag {
+	uint32	command;
+	uint32	args[4];
+	uint32	result[4];
+};
+
 
 // clock and reset controller
 #define CAR_BASE					0x60006000
@@ -187,6 +211,12 @@ struct tegra_audio {
 };
 
 
+struct tegra_audio_cookie {
+	tegra_audio*	audio;
+	bool			diag;
+};
+
+
 static device_manager_info* sDeviceManager;
 
 
@@ -1021,6 +1051,140 @@ buffer_force_stop(tegra_audio* audio)
 }
 
 
+//	#pragma mark - diagnostics (bring-up)
+
+
+static bool
+diag_address_allowed(uint32 address)
+{
+	// the peripheral registers only: clocks, GPIO, DMA, AHB; pin mux, DAS,
+	// I2S, I2C, ...
+	return (address & 3) == 0
+		&& ((address >= 0x60000000 && address < 0x60010000)
+			|| (address >= 0x70000000 && address < 0x70010000));
+}
+
+
+static status_t
+diag_access32(uint32 address, uint32* value, bool write)
+{
+	if (!diag_address_allowed(address))
+		return B_NOT_ALLOWED;
+
+	void* page;
+	area_id area = map_physical_memory("tegra audio diag",
+		address & ~(B_PAGE_SIZE - 1), B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &page);
+	if (area < B_OK)
+		return area;
+
+	volatile uint32* reg = (volatile uint32*)((uint8*)page
+		+ (address & (B_PAGE_SIZE - 1)));
+	if (write)
+		*reg = *value;
+	else
+		*value = *reg;
+
+	delete_area(area);
+	return B_OK;
+}
+
+
+/*!	Plays a square wave through the whole chain, as long as the media server
+	does not use the device.
+*/
+static status_t
+diag_tone(tegra_audio* audio, uint32 ms, uint32 period, uint32 amplitude,
+	uint32 channels, uint32* _interrupts)
+{
+	MutexLocker locker(audio->lock);
+	if (audio->running)
+		return B_BUSY;
+
+	if (ms == 0 || ms > 10000)
+		ms = 1500;
+	if (period < 2)
+		period = 64;
+	if (amplitude > 32767)
+		amplitude = 32767;
+
+	status_t status = create_buffers(audio, audio->bufferArea >= B_OK
+		? audio->bufferFrames : DEFAULT_BUFFER_FRAMES,
+		audio->bufferArea >= B_OK ? audio->bufferCount : BUFFER_COUNT);
+	if (status != B_OK)
+		return status;
+
+	int16* samples = (int16*)audio->buffers;
+	uint32 frames = audio->bufferFrames * audio->bufferCount;
+	for (uint32 i = 0; i < frames; i++) {
+		int16 value = (i % period) < period / 2
+			? (int16)amplitude : -(int16)amplitude;
+		samples[i * 2] = (channels & 1) != 0 ? value : 0;
+		samples[i * 2 + 1] = (channels & 2) != 0 ? value : 0;
+	}
+
+	audio->interrupts = 0;
+	start_playback(audio);
+	snooze(ms * 1000LL);
+	*_interrupts = audio->interrupts;
+	stop_playback(audio);
+
+	memset(audio->buffers, 0, frames * FRAME_SIZE);
+	return B_OK;
+}
+
+
+static status_t
+diag_control(tegra_audio* audio, void* arg, size_t length)
+{
+	tegra_audio_diag request;
+	if (length < sizeof(request) || !IS_USER_ADDRESS(arg)
+		|| user_memcpy(&request, arg, sizeof(request)) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+
+	status_t status = B_OK;
+	memset(request.result, 0, sizeof(request.result));
+	switch (request.command) {
+		case TEGRA_DIAG_READ32:
+			status = diag_access32(request.args[0], &request.result[0], false);
+			break;
+		case TEGRA_DIAG_WRITE32:
+			status = diag_access32(request.args[0], &request.args[1], true);
+			break;
+		case TEGRA_DIAG_CODEC_READ:
+		{
+			uint16 value = 0;
+			status = codec_read(audio, request.args[0], &value);
+			request.result[0] = value;
+			break;
+		}
+		case TEGRA_DIAG_CODEC_WRITE:
+			status = codec_write(audio, request.args[0], request.args[1]);
+			break;
+		case TEGRA_DIAG_TONE:
+			status = diag_tone(audio, request.args[0], request.args[1],
+				request.args[2], request.args[3], &request.result[0]);
+			break;
+		case TEGRA_DIAG_STATUS:
+		{
+			MutexLocker locker(audio->lock);
+			request.result[0] = audio->opened;
+			request.result[1] = audio->running;
+			request.result[2] = audio->bufferFrames;
+			request.result[3] = audio->bufferCount;
+			break;
+		}
+		default:
+			return B_BAD_VALUE;
+	}
+
+	if (user_memcpy(arg, &request, sizeof(request)) != B_OK)
+		return B_BAD_ADDRESS;
+	return status;
+}
+
+
 //	#pragma mark - device module
 
 
@@ -1043,11 +1207,21 @@ tegra_audio_open(void* deviceCookie, const char* path, int openMode,
 	void** _cookie)
 {
 	tegra_audio* audio = (tegra_audio*)deviceCookie;
-	MutexLocker locker(audio->lock);
-	if (audio->opened)
-		return B_BUSY;
-	audio->opened = true;
-	*_cookie = audio;
+	tegra_audio_cookie* cookie = new(std::nothrow) tegra_audio_cookie;
+	if (cookie == NULL)
+		return B_NO_MEMORY;
+	cookie->audio = audio;
+	cookie->diag = strcmp(path, TEGRA_AUDIO_DIAG_PATH) == 0;
+
+	if (!cookie->diag) {
+		MutexLocker locker(audio->lock);
+		if (audio->opened) {
+			delete cookie;
+			return B_BUSY;
+		}
+		audio->opened = true;
+	}
+	*_cookie = cookie;
 	return B_OK;
 }
 
@@ -1060,12 +1234,16 @@ tegra_audio_close(void* cookie)
 
 
 static status_t
-tegra_audio_free(void* cookie)
+tegra_audio_free(void* _cookie)
 {
-	tegra_audio* audio = (tegra_audio*)cookie;
-	MutexLocker locker(audio->lock);
-	stop_playback(audio);
-	audio->opened = false;
+	tegra_audio_cookie* cookie = (tegra_audio_cookie*)_cookie;
+	if (!cookie->diag) {
+		tegra_audio* audio = cookie->audio;
+		MutexLocker locker(audio->lock);
+		stop_playback(audio);
+		audio->opened = false;
+	}
+	delete cookie;
 	return B_OK;
 }
 
@@ -1088,9 +1266,16 @@ tegra_audio_write(void* cookie, off_t position, const void* buffer,
 
 
 static status_t
-tegra_audio_control(void* cookie, uint32 op, void* arg, size_t length)
+tegra_audio_control(void* _cookie, uint32 op, void* arg, size_t length)
 {
-	tegra_audio* audio = (tegra_audio*)cookie;
+	tegra_audio_cookie* cookie = (tegra_audio_cookie*)_cookie;
+	tegra_audio* audio = cookie->audio;
+
+	if (cookie->diag) {
+		if (op == TEGRA_AUDIO_DIAG)
+			return diag_control(audio, arg, length);
+		return B_BAD_VALUE;
+	}
 
 	switch (op) {
 		case B_MULTI_GET_DESCRIPTION:
@@ -1258,8 +1443,13 @@ static status_t
 tegra_audio_register_child_devices(void* cookie)
 {
 	tegra_audio* audio = (tegra_audio*)cookie;
-	return sDeviceManager->publish_device(audio->node,
+	status_t status = sDeviceManager->publish_device(audio->node,
 		"audio/hmulti/tegra_audio/1", TEGRA_AUDIO_DEVICE_MODULE_NAME);
+	if (status == B_OK) {
+		sDeviceManager->publish_device(audio->node, TEGRA_AUDIO_DIAG_PATH,
+			TEGRA_AUDIO_DEVICE_MODULE_NAME);
+	}
+	return status;
 }
 
 
