From dffd4038828a1a095db45cbd09a6b02866650c30 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Wed, 28 Oct 2026 18:35:54 +0100
Subject: [PATCH 59/63] kernel/arm: make executable pages coherent on all CPUs

When a page became executable, Map() and Protect() cleaned the level 1
data cache by set/way, which only reaches the cache of the current CPU,
then invalidated the instruction caches of all of them. Code written
through the data cache of the other CPU (by the file cache when a file
is written and then mapped, a loader, a JIT) could still be dirty there
only, and the instruction fetch read what was in memory before: old
instructions. On a Cortex-A9 MPCore (Tegra 2) a test that writes code
to a file from one thread and runs it from another got old values or
illegal instructions about once every 25 rounds, and WebPositive
crashed at instructions that cannot fault.

Clean the page by address to the point of unification instead, which
the other CPUs also carry out (ACTLR.FW), through a temporary kernel
mapping of the physical page, then invalidate the instruction caches
and branch predictors of all CPUs. Protect() does it for each page.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 headers/private/kernel/arch/arm/arch_cpu.h    |  1 +
 src/system/kernel/arch/arm/arch_cpu.cpp       | 42 +++++++++++++++++++
 .../paging/32bit/ARMVMTranslationMap32Bit.cpp | 20 +++++----
 3 files changed, 54 insertions(+), 9 deletions(-)

diff --git a/headers/private/kernel/arch/arm/arch_cpu.h b/headers/private/kernel/arch/arm/arch_cpu.h
index 7641264199..ccc8fa8f03 100644
--- a/headers/private/kernel/arch/arm/arch_cpu.h
+++ b/headers/private/kernel/arch/arm/arch_cpu.h
@@ -147,6 +147,7 @@ arm_clean_dcache_range(const void* address, size_t size)
 
 void arch_cpu_invalidate_TLB_page(addr_t page);
 void arm_sync_icache_all(void);
+void arm_sync_icache_page(phys_addr_t physicalAddress);
 void arm_local_tlb_invalidate(void);
 void arm_clean_invalidate_dcache_all(void);
 
diff --git a/src/system/kernel/arch/arm/arch_cpu.cpp b/src/system/kernel/arch/arm/arch_cpu.cpp
index 9a46e96bbd..013986262b 100644
--- a/src/system/kernel/arch/arm/arch_cpu.cpp
+++ b/src/system/kernel/arch/arm/arch_cpu.cpp
@@ -16,6 +16,7 @@
 #include <arch/cpu.h>
 #include <cpu.h>
 #include <boot/kernel_args.h>
+#include <vm/vm.h>
 
 
 bool gARMHasVFPD32 = true;
@@ -200,6 +201,47 @@ arm_sync_icache_all(void)
 }
 
 
+/*!	Makes the code in a physical page visible to the instruction fetches of
+	every CPU. The page may just have been written through the data cache of
+	another CPU (by the file cache, a loader or a JIT), which a clean by set/way
+	on this CPU does not reach: the page is cleaned to the point of
+	unification by address, which the other CPUs of a Cortex-A9 MPCore also
+	carry out (ACTLR.FW), then the instruction caches and branch predictors of
+	all CPUs are invalidated.
+	The calling thread must be pinned to its CPU.
+*/
+void
+arm_sync_icache_page(phys_addr_t physicalAddress)
+{
+	addr_t virtualAddress;
+	void* handle;
+	if (vm_get_physical_page_current_cpu(physicalAddress, &virtualAddress,
+			&handle) != B_OK) {
+		arm_sync_icache_all();
+		return;
+	}
+
+	uint32 ctr;
+	asm volatile ("mrc p15, 0, %0, c0, c0, 1" : "=r" (ctr));
+	const addr_t lineSize = 4 << ((ctr >> 16) & 0xf);
+
+	dsb();
+	for (addr_t line = virtualAddress; line < virtualAddress + B_PAGE_SIZE;
+			line += lineSize) {
+		// DCCMVAU: clean to the point of unification
+		asm volatile ("mcr p15, 0, %0, c7, c11, 1" : : "r" (line) : "memory");
+	}
+	dsb();
+	vm_put_physical_page_current_cpu(virtualAddress, handle);
+
+	// ICIALLUIS and BPIALLIS
+	asm volatile ("mcr p15, 0, %0, c7, c1, 0" : : "r" (0) : "memory");
+	asm volatile ("mcr p15, 0, %0, c7, c1, 6" : : "r" (0) : "memory");
+	dsb();
+	isb();
+}
+
+
 /*!	Writes back and discards the whole level 1 data cache of the current CPU,
 	e.g. before memory that was cached is accessed through a non-cacheable
 	mapping, so that no dirty line can be evicted over it later.
diff --git a/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp b/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
index f2e170fd32..b88d42278c 100644
--- a/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
+++ b/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
@@ -230,11 +230,13 @@ ARMVMTranslationMap32Bit::Map(addr_t va, phys_addr_t pa, uint32 attributes,
 
 	fMapCount++;
 
-	// The page may have been written through the data cache, and the
-	// instruction cache may still hold what was at this physical address
+	// The page may have been written through the data cache, of any CPU, and
+	// the instruction caches may still hold what was at this physical address
 	// before
-	if ((attributes & (B_EXECUTE_AREA | B_KERNEL_EXECUTE_AREA)) != 0)
-		arm_sync_icache_all();
+	if ((attributes & (B_EXECUTE_AREA | B_KERNEL_EXECUTE_AREA)) != 0) {
+		ThreadCPUPinner pinner(thread);
+		arm_sync_icache_page(pa);
+	}
 
 	return 0;
 }
@@ -599,14 +601,14 @@ ARMVMTranslationMap32Bit::Protect(addr_t start, addr_t end, uint32 attributes,
 				// been in any TLB.
 				InvalidatePage(start);
 			}
+
+			// Code may just have been written to the page that becomes
+			// executable, by any CPU (e.g. by the kernel add-on loader)
+			if ((attributes & (B_EXECUTE_AREA | B_KERNEL_EXECUTE_AREA)) != 0)
+				arm_sync_icache_page(oldEntry & ARM_PTE_ADDRESS_MASK);
 		}
 	} while (start != 0 && start < end);
 
-	// Code may just have been written to the pages that become executable,
-	// e.g. by the kernel add-on loader
-	if ((attributes & (B_EXECUTE_AREA | B_KERNEL_EXECUTE_AREA)) != 0)
-		arm_sync_icache_all();
-
 	return B_OK;
 }
 
