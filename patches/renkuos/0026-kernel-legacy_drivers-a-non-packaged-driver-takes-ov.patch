From 27b1fc4b0a2e15d94a34da91fa7f13954e2fcbde Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 22 Nov 2026 16:33:28 +0100
Subject: [PATCH 26/32] kernel/legacy_drivers: a non-packaged driver takes over
 the packaged one

get_priority() tried the system directory first, and /boot/system is a
prefix of /boot/system/non-packaged: a driver installed there got the
priority of the packaged driver with the same name instead of a higher
one, and whichever was found last was used. On a Toshiba AC100 a usb_raw
put in /boot/system/non-packaged/add-ons/kernel/drivers was loaded and then
replaced by the packaged one. The directories are now tried from the most
specific, and a prefix only counts up to a path separator.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/system/kernel/device_manager/legacy_drivers.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/system/kernel/device_manager/legacy_drivers.cpp b/src/system/kernel/device_manager/legacy_drivers.cpp
index c55fdf6be3..1b09764ba0 100644
--- a/src/system/kernel/device_manager/legacy_drivers.cpp
+++ b/src/system/kernel/device_manager/legacy_drivers.cpp
@@ -529,11 +529,17 @@ get_priority(const char* path)
 	};
 	KPath pathBuffer;
 
-	for (uint32 index = 0; index < B_COUNT_OF(whichPath); index++) {
+	// From the most specific: /boot/system is a prefix of
+	// /boot/system/non-packaged too, and a non-packaged driver got the
+	// priority of the packaged one it is meant to supersede. A prefix only
+	// counts up to a path separator.
+	for (int32 index = B_COUNT_OF(whichPath) - 1; index >= 0; index--) {
 		if (__find_directory(whichPath[index], gBootDevice, false,
 			pathBuffer.LockBuffer(), pathBuffer.BufferSize()) == B_OK) {
 			pathBuffer.UnlockBuffer();
-			if (strncmp(pathBuffer.Path(), path, pathBuffer.Length()) == 0)
+			size_t length = pathBuffer.Length();
+			if (strncmp(pathBuffer.Path(), path, length) == 0
+				&& (path[length] == '/' || path[length] == '\0'))
 				return index;
 		} else
 			pathBuffer.UnlockBuffer();
-- 
