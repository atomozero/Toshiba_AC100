From b47df4faaaffe4a6eed401c1e98ab06dff011cda Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 22:38:28 +0200
Subject: [PATCH 120/203] ARM bring-up: show how far a CPU that does not answer
 an early call got

The second CPU of the AC100 does not answer the first early CPU call. After
two seconds, show its call bit, the stage it reached and a heartbeat of its
waiting loop, written through to memory and read from there in case the
caches are not coherent (not for merging).
---
 src/system/kernel/arch/arm/arch_int.cpp |  9 ++++
 src/system/kernel/main.cpp              | 10 +++-
 src/system/kernel/smp.cpp               | 63 ++++++++++++++++++++++++-
 3 files changed, 80 insertions(+), 2 deletions(-)

diff --git a/src/system/kernel/arch/arm/arch_int.cpp b/src/system/kernel/arch/arm/arch_int.cpp
index 4408a3d7b4..a7169c92aa 100644
--- a/src/system/kernel/arch/arm/arch_int.cpp
+++ b/src/system/kernel/arch/arm/arch_int.cpp
@@ -143,11 +143,20 @@ arch_int_init(kernel_args *args)
 /*!	The exception setup of the other CPUs, once the boot CPU did
 	arch_int_init(): their own exception mode stacks, and the vector page.
 */
+extern "C" volatile uint32 gSMPDebugStage[];
+extern "C" void smp_debug_publish_stage(int32 cpu);
+
 void
 arch_int_init_secondary_cpu(int32 cpu)
 {
+	gSMPDebugStage[cpu] = 20;
+	smp_debug_publish_stage(cpu);
 	arm_vector_init(cpu);
+	gSMPDebugStage[cpu] = 21;
+	smp_debug_publish_stage(cpu);
 	arm_set_sctlr(arm_get_sctlr() | SCTLR_HIGH_VECTORS);
+	gSMPDebugStage[cpu] = 22;
+	smp_debug_publish_stage(cpu);
 }
 
 
diff --git a/src/system/kernel/main.cpp b/src/system/kernel/main.cpp
index 39cdd20116..8c464eba6d 100644
--- a/src/system/kernel/main.cpp
+++ b/src/system/kernel/main.cpp
@@ -78,6 +78,9 @@ bool gKernelStartup = true;
 bool gKernelShutdown = false;
 
 static kernel_args sKernelArgs;
+extern "C" volatile uint32 gSMPDebugStage[];
+extern "C" void smp_debug_publish_stage(int32 cpu);
+
 static uint32 sCpuRendezvous;
 static uint32 sCpuRendezvous2;
 static uint32 sCpuRendezvous3;
@@ -89,8 +92,13 @@ static void
 non_boot_cpu_init(void* args, int currentCPU)
 {
 	kernel_args* kernelArgs = (kernel_args*)args;
-	if (currentCPU != 0)
+	if (currentCPU != 0) {
+		gSMPDebugStage[currentCPU] = 10;
+		smp_debug_publish_stage(currentCPU);
 		cpu_init_percpu(kernelArgs, currentCPU);
+		gSMPDebugStage[currentCPU] = 11;
+		smp_debug_publish_stage(currentCPU);
+	}
 }
 
 
diff --git a/src/system/kernel/smp.cpp b/src/system/kernel/smp.cpp
index f047b0e9a5..fe7833ae33 100644
--- a/src/system/kernel/smp.cpp
+++ b/src/system/kernel/smp.cpp
@@ -89,6 +89,45 @@ enum mailbox_source {
 
 static int32 sBootCPUSpin = 0;
 
+// bring-up aid: how far the other CPUs got, shown when they do not answer;
+// on ARM written through to memory and read from there, so that it shows
+// even if the caches of the CPUs were not coherent
+extern "C" {
+volatile uint32 gSMPDebugStage[SMP_MAX_CPUS] __attribute__((aligned(64)));
+volatile uint32 gSMPDebugHeartbeat[SMP_MAX_CPUS] __attribute__((aligned(64)));
+}
+
+
+static inline void
+smp_debug_publish(int32 cpu)
+{
+#ifdef __arm__
+	// DCCMVAC: clean the lines to memory
+	asm volatile("dsb; mcr p15, 0, %0, c7, c10, 1; mcr p15, 0, %1, c7, c10, 1;"
+		" dsb" : : "r" (&gSMPDebugStage[cpu]), "r" (&gSMPDebugHeartbeat[cpu])
+		: "memory");
+#endif
+}
+
+
+extern "C" void
+smp_debug_publish_stage(int32 cpu)
+{
+	smp_debug_publish(cpu);
+}
+
+
+static inline void
+smp_debug_fetch(int32 cpu)
+{
+#ifdef __arm__
+	// DCIMVAC: drop our copies, only the other CPU writes these
+	asm volatile("dsb; mcr p15, 0, %0, c7, c6, 1; mcr p15, 0, %1, c7, c6, 1;"
+		" dsb" : : "r" (&gSMPDebugStage[cpu]), "r" (&gSMPDebugHeartbeat[cpu])
+		: "memory");
+#endif
+}
+
 static int32 sEarlyCPUCallCount;
 static CPUSet sEarlyCPUCallSet;
 static void (*sEarlyCPUCallFunction)(void*, int);
@@ -889,7 +928,11 @@ spinlock_contention_syscall(const char* subsystem, uint32 function,
 static void
 process_early_cpu_call(int32 cpu)
 {
+	gSMPDebugStage[cpu] = 2;
+	smp_debug_publish(cpu);
 	sEarlyCPUCallFunction(sEarlyCPUCallCookie, cpu);
+	gSMPDebugStage[cpu] = 3;
+	smp_debug_publish(cpu);
 	sEarlyCPUCallSet.ClearBitAtomic(cpu);
 	atomic_add(&sEarlyCPUCallCount, 1);
 }
@@ -909,8 +952,23 @@ call_all_cpus_early(void (*function)(void*, int), void* cookie)
 		sEarlyCPUCallSet.ClearBit(0);
 
 		// wait for all CPUs to finish
-		while (sEarlyCPUCallCount < sNumCPUs)
+		bigtime_t report = system_time() + 2000000;
+		while (sEarlyCPUCallCount < sNumCPUs) {
 			cpu_wait(&sEarlyCPUCallCount, sNumCPUs);
+
+			// bring-up aid: say why we are stuck
+			if (system_time() > report) {
+				report = system_time() + 2000000;
+				for (int32 i = 1; i < sNumCPUs; i++) {
+					smp_debug_fetch(i);
+					dprintf("SMP: CPU %" B_PRId32 " does not answer: call bit %d,"
+						" count %" B_PRId32 ", stage %" B_PRIu32 ", heartbeat %"
+						B_PRIu32 "\n", i, sEarlyCPUCallSet.GetBit(i),
+						sEarlyCPUCallCount, gSMPDebugStage[i],
+						gSMPDebugHeartbeat[i]);
+				}
+			}
+		}
 	}
 
 	function(cookie, 0);
@@ -1275,7 +1333,10 @@ smp_trap_non_boot_cpus(int32 cpu, uint32* rendezVous)
 
 	smp_cpu_rendezvous(rendezVous);
 
+	gSMPDebugStage[cpu] = 1;
 	while (sBootCPUSpin == 0) {
+		gSMPDebugHeartbeat[cpu]++;
+		smp_debug_publish(cpu);
 		if (sEarlyCPUCallSet.GetBitAtomic(cpu))
 			process_early_cpu_call(cpu);
 
