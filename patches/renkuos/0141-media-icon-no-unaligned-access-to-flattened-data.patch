From bf387baff056921da836f6aeb1373d77716ebc6c Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 19 Oct 2026 21:39:37 +0200
Subject: [PATCH 141/203] media, icon: no unaligned access to flattened data

BParameterWeb and its groups read and wrote the values of a flattened web in
place, but after a string they are not aligned anymore. Transformable did the
same with matrices taken from archives. Both raised SIGBUS on ARM (Media
preferences, the Deskbar volume control, applications loading icons).
---
 src/kits/media/ParameterWeb.cpp               | 18 +++++++-----------
 src/libs/icon/transformable/Transformable.cpp |  7 ++++++-
 2 files changed, 13 insertions(+), 12 deletions(-)

diff --git a/src/kits/media/ParameterWeb.cpp b/src/kits/media/ParameterWeb.cpp
index bd5eb4186a..72ee817da6 100644
--- a/src/kits/media/ParameterWeb.cpp
+++ b/src/kits/media/ParameterWeb.cpp
@@ -18,6 +18,7 @@
 
 #include <new>
 #include <string.h>
+#include <type_traits>
 
 #include <MediaNode.h>
 #include <MediaRoster.h>
@@ -171,11 +172,10 @@ static const ssize_t kAdditionalDiscreteParameterSize = sizeof(ssize_t);
 template<class Type> Type
 read_from_buffer(const void **_buffer)
 {
-	const Type *typedBuffer = static_cast<const Type *>(*_buffer);
-	Type value = *typedBuffer;
-
-	typedBuffer++;
-	*_buffer = static_cast<const void *>(typedBuffer);
+	// the flattened data does not have to be aligned
+	typename std::remove_const<Type>::type value;
+	memcpy((void*)&value, *_buffer, sizeof(Type));
+	*_buffer = static_cast<const uint8 *>(*_buffer) + sizeof(Type);
 
 	return value;
 }
@@ -224,12 +224,8 @@ reserve_in_buffer(void **_buffer)
 template<class Type> void
 write_to_buffer(void **_buffer, Type value)
 {
-	Type *typedBuffer = static_cast<Type *>(*_buffer);
-
-	*typedBuffer = value;
-	typedBuffer++;
-
-	*_buffer = static_cast<void *>(typedBuffer);
+	memcpy(*_buffer, (const void*)&value, sizeof(Type));
+	*_buffer = static_cast<uint8 *>(*_buffer) + sizeof(Type);
 }
 
 
diff --git a/src/libs/icon/transformable/Transformable.cpp b/src/libs/icon/transformable/Transformable.cpp
index 137684f1db..f19c33f33e 100644
--- a/src/libs/icon/transformable/Transformable.cpp
+++ b/src/libs/icon/transformable/Transformable.cpp
@@ -88,8 +88,13 @@ Transformable::StoreTo(double matrix[matrix_size]) const
 
 
 void
-Transformable::LoadFrom(const double matrix[matrix_size])
+Transformable::LoadFrom(const double _matrix[matrix_size])
 {
+	// the matrix often comes straight from an archive, where it does not
+	// have to be aligned
+	double matrix[matrix_size];
+	memcpy(matrix, _matrix, sizeof(matrix));
+
 	// before calling the potentially heavy TransformationChanged()
 	// hook function, make sure that the transformation
 	// really changed
