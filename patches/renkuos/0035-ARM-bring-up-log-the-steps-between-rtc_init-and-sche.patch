From f6c4bf3d8c4fb56a186d36dfdbee1d01fb157515 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 18:56:18 +0200
Subject: [PATCH 035/270] ARM bring-up: log the steps between rtc_init and
 scheduler_init (not for merging)

---
 src/system/kernel/main.cpp            |  6 ++++++
 src/system/kernel/real_time_clock.cpp | 12 ++++++++++--
 2 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/src/system/kernel/main.cpp b/src/system/kernel/main.cpp
index 8fbc0accb3..f42b7ec74b 100644
--- a/src/system/kernel/main.cpp
+++ b/src/system/kernel/main.cpp
@@ -199,18 +199,24 @@ _start(kernel_args *bootKernelArgs, int currentCPU)
 		timer_init(&sKernelArgs);
 		TRACE("init real time clock\n");
 		rtc_init(&sKernelArgs);
+		dprintf("AC100: timer_init_post_rtc\n");
 		timer_init_post_rtc();
 
 		TRACE("init condition variables\n");
+		dprintf("AC100: condition_variable_init\n");
 		condition_variable_init();
 
 		// now we can create and use semaphores
 		TRACE("init VM semaphores\n");
+		dprintf("AC100: vm_init_post_sem\n");
 		vm_init_post_sem(&sKernelArgs);
 		TRACE("init generic syscall\n");
+		dprintf("AC100: generic_syscall_init\n");
 		generic_syscall_init();
+		dprintf("AC100: smp_init_post_generic_syscalls\n");
 		smp_init_post_generic_syscalls();
 		TRACE("init scheduler\n");
+		dprintf("AC100: scheduler_init\n");
 		scheduler_init();
 		TRACE("init threads\n");
 		thread_init(&sKernelArgs);
diff --git a/src/system/kernel/real_time_clock.cpp b/src/system/kernel/real_time_clock.cpp
index 63aff11f53..c854ee4682 100644
--- a/src/system/kernel/real_time_clock.cpp
+++ b/src/system/kernel/real_time_clock.cpp
@@ -44,8 +44,11 @@ static char sTimezoneName[B_FILE_NAME_LENGTH] = "GMT";
 static void
 real_time_clock_changed()
 {
+	dprintf("AC100: timer_real_time_clock_changed\n");
 	timer_real_time_clock_changed();
+	dprintf("AC100: user_timer_real_time_clock_changed\n");
 	user_timer_real_time_clock_changed();
+	dprintf("AC100: real_time_clock_changed done\n");
 }
 
 
@@ -116,7 +119,9 @@ rtc_init(kernel_args *args)
 	arch_rtc_init(args, sRealTimeDataCompat);
 #endif
 
+	dprintf("AC100: arch_rtc_init done, rtc_hw_to_system\n");
 	rtc_hw_to_system();
+	dprintf("AC100: rtc_hw_to_system done\n");
 
 	add_debugger_command("rtc", &rtc_debug, "Set and test the real-time clock");
 	return B_OK;
@@ -129,13 +134,16 @@ rtc_init(kernel_args *args)
 void
 set_real_time_clock_usecs(bigtime_t currentTime)
 {
-	arch_rtc_set_system_time_offset(sRealTimeData, currentTime
-		- system_time());
+	dprintf("AC100: set_real_time_clock_usecs, system_time() ...\n");
+	bigtime_t now = system_time();
+	dprintf("AC100: system_time() = %" B_PRIdBIGTIME "\n", now);
+	arch_rtc_set_system_time_offset(sRealTimeData, currentTime - now);
 #ifdef _COMPAT_MODE
 	arch_rtc_set_system_time_offset(sRealTimeDataCompat, currentTime
 		- system_time());
 #endif
 	rtc_system_to_hw();
+	dprintf("AC100: rtc_system_to_hw done\n");
 	real_time_clock_changed();
 }
 
