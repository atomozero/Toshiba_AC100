diff --git a/src/add-ons/kernel/drivers/misc/tegra_dc_diag/tegra_dc_diag.cpp b/src/add-ons/kernel/drivers/misc/tegra_dc_diag/tegra_dc_diag.cpp
new file mode 100644
index 0000000000..60b2bce262
--- /dev/null
+++ b/src/add-ons/kernel/drivers/misc/tegra_dc_diag/tegra_dc_diag.cpp
@@ -0,0 +1,446 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+/*!	AC100 bring-up: reading /dev/misc/tegra_dc_diag reports, without changing
+	anything, how the firmware left the display hardware of the Tegra 2: the
+	clocks and resets of the display, HDMI and graphics blocks, the registers
+	of the display controllers that are running, and whether the memory the
+	firmware reserved for its frame buffer is managed by the kernel.
+	Blocks are only read when their clock is on and they are out of reset:
+	accessing a block that is not clocked hangs the bus.
+*/
+
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <Drivers.h>
+#include <KernelExport.h>
+#include <vm/vm.h>
+#include <vm/vm_page.h>
+#include <vm/vm_types.h>
+#include <vm/VMArea.h>
+#include <vm/VMCache.h>
+
+
+#define TEGRA20_CAR_BASE		0x60006000
+#define TEGRA20_PMC_BASE		0x7000e400
+#define TEGRA20_DC_A_BASE		0x54200000
+#define TEGRA20_DC_B_BASE		0x54240000
+#define TEGRA20_HDMI_BASE		0x54280000
+
+// CAR, byte offsets
+#define CAR_RST_DEVICES_L		0x004
+#define CAR_RST_DEVICES_H		0x008
+#define CAR_CLK_OUT_ENB_L		0x010
+#define CAR_CLK_OUT_ENB_H		0x014
+#define CAR_PLLC_BASE			0x080
+#define CAR_PLLP_BASE			0x0a0
+#define CAR_PLLD_BASE			0x0d0
+#define CAR_CLK_SOURCE_DISP1	0x138
+#define CAR_CLK_SOURCE_DISP2	0x13c
+#define CAR_CLK_SOURCE_G3D		0x158
+#define CAR_CLK_SOURCE_G2D		0x15c
+#define CAR_CLK_SOURCE_HOST1X	0x180
+#define CAR_CLK_SOURCE_HDMI		0x18c
+
+// PMC
+#define PMC_PWRGATE_STATUS		0x38
+
+#define DC_SIZE					0x10000
+
+static const char* sDeviceNames[] = { "misc/tegra_dc_diag", NULL };
+
+int32 api_version = B_CUR_DRIVER_API_VERSION;
+
+
+struct block {
+	const char*	name;
+	bool		high;	// in the H registers, else L
+	uint32		bit;
+};
+
+static const block kBlocks[] = {
+	{ "disp1", false, 27 },
+	{ "disp2", false, 26 },
+	{ "host1x", false, 28 },
+	{ "2d", false, 21 },
+	{ "3d", false, 24 },
+	{ "hdmi", true, 19 },
+};
+
+
+struct named_register {
+	const char*	name;
+	uint32		word;	// word offset
+};
+
+// Display controller registers, word offsets (Tegra 2 TRM chapter 29)
+static const named_register kDcRegisters[] = {
+	{ "DISPLAY_COMMAND", 0x032 },
+	{ "DISPLAY_POWER_CONTROL", 0x036 },
+	{ "INT_STATUS", 0x037 },
+	{ "INT_MASK", 0x038 },
+	{ "INT_ENABLE", 0x039 },
+	{ "INT_TYPE", 0x03a },
+	{ "INT_POLARITY", 0x03b },
+	{ "STATE_ACCESS", 0x040 },
+	{ "STATE_CONTROL", 0x041 },
+	{ "WINDOW_HEADER", 0x042 },
+	{ "DISP_WIN_OPTIONS", 0x402 },
+	{ "MEM_HIGH_PRIORITY", 0x403 },
+	{ "MEM_HIGH_PRIORITY_TIMER", 0x404 },
+	{ "DISP_TIMING_OPTIONS", 0x405 },
+	{ "REF_TO_SYNC", 0x406 },
+	{ "SYNC_WIDTH", 0x407 },
+	{ "BACK_PORCH", 0x408 },
+	{ "DISP_ACTIVE", 0x409 },
+	{ "FRONT_PORCH", 0x40a },
+	{ "DISP_CLOCK_CONTROL", 0x42e },
+	{ "DISP_INTERFACE_CONTROL", 0x42f },
+	{ "DISP_COLOR_CONTROL", 0x430 },
+	{ "SHIFT_CLOCK_OPTIONS", 0x431 },
+	{ "DATA_ENABLE_OPTIONS", 0x432 },
+	{ "CURSOR_START_ADDR", 0x43e },
+	{ "CURSOR_POSITION", 0x440 },
+};
+
+// Window registers, relative to the window's WIN and WINBUF blocks
+static const named_register kWindowRegisters[] = {
+	{ "WIN_OPTIONS", 0x00 },
+	{ "BYTE_SWAP", 0x01 },
+	{ "COLOR_DEPTH", 0x03 },
+	{ "POSITION", 0x04 },
+	{ "SIZE", 0x05 },
+	{ "PRESCALED_SIZE", 0x06 },
+	{ "DDA_INCREMENT", 0x09 },
+	{ "LINE_STRIDE", 0x0a },
+	{ "BLEND_1WIN", 0x10 },
+};
+
+static const named_register kWindowBufferRegisters[] = {
+	{ "START_ADDR", 0x00 },
+	{ "ADDR_H_OFFSET", 0x06 },
+	{ "ADDR_V_OFFSET", 0x08 },
+	{ "UFLOW_STATUS", 0x0a },
+};
+
+
+static size_t
+append(char* buffer, size_t size, size_t length, const char* format, ...)
+{
+	if (length >= size)
+		return length;
+	va_list args;
+	va_start(args, format);
+	length += vsnprintf(buffer + length, size - length, format, args);
+	va_end(args);
+	return length;
+}
+
+
+static volatile uint32*
+map_registers(const char* name, phys_addr_t base, size_t size, area_id* _area)
+{
+	void* address;
+	*_area = map_physical_memory(name, base, size, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA, &address);
+	return *_area >= 0 ? (volatile uint32*)address : NULL;
+}
+
+
+static bool
+block_running(volatile uint32* car, const block& block)
+{
+	uint32 enable = car[(block.high ? CAR_CLK_OUT_ENB_H : CAR_CLK_OUT_ENB_L)
+		/ 4];
+	uint32 reset = car[(block.high ? CAR_RST_DEVICES_H : CAR_RST_DEVICES_L)
+		/ 4];
+	return (enable & (1u << block.bit)) != 0
+		&& (reset & (1u << block.bit)) == 0;
+}
+
+
+static size_t
+report_clocks(char* buffer, size_t size, size_t length, bool* _dcARunning,
+	bool* _dcBRunning)
+{
+	area_id area;
+	volatile uint32* car = map_registers("tegra car", TEGRA20_CAR_BASE,
+		B_PAGE_SIZE, &area);
+	if (car == NULL)
+		return append(buffer, size, length, "cannot map the CAR\n");
+
+	length = append(buffer, size, length, "clocks:");
+	for (size_t i = 0; i < B_COUNT_OF(kBlocks); i++) {
+		length = append(buffer, size, length, " %s %s", kBlocks[i].name,
+			block_running(car, kBlocks[i]) ? "on" : "off");
+	}
+	length = append(buffer, size, length,
+		"\nPLLC %08" B_PRIx32 ", PLLP %08" B_PRIx32 ", PLLD %08" B_PRIx32
+		"\nsources: disp1 %08" B_PRIx32 ", disp2 %08" B_PRIx32 ", host1x %08"
+		B_PRIx32 ", 2d %08" B_PRIx32 ", 3d %08" B_PRIx32 ", hdmi %08" B_PRIx32
+		"\n", car[CAR_PLLC_BASE / 4], car[CAR_PLLP_BASE / 4],
+		car[CAR_PLLD_BASE / 4], car[CAR_CLK_SOURCE_DISP1 / 4],
+		car[CAR_CLK_SOURCE_DISP2 / 4], car[CAR_CLK_SOURCE_HOST1X / 4],
+		car[CAR_CLK_SOURCE_G2D / 4], car[CAR_CLK_SOURCE_G3D / 4],
+		car[CAR_CLK_SOURCE_HDMI / 4]);
+
+	*_dcARunning = block_running(car, kBlocks[0]);
+	*_dcBRunning = block_running(car, kBlocks[1]);
+	delete_area(area);
+
+	volatile uint32* pmc = map_registers("tegra pmc",
+		TEGRA20_PMC_BASE & ~(B_PAGE_SIZE - 1), B_PAGE_SIZE, &area);
+	if (pmc != NULL) {
+		length = append(buffer, size, length,
+			"power partitions on: %#" B_PRIx32 " (bit 1 = 3D)\n",
+			pmc[((TEGRA20_PMC_BASE & (B_PAGE_SIZE - 1)) + PMC_PWRGATE_STATUS)
+				/ 4]);
+		delete_area(area);
+	}
+	return length;
+}
+
+
+static size_t
+report_window(char* buffer, size_t size, size_t length, volatile uint32* dc,
+	char name, uint32 windowWord, uint32 bufferWord)
+{
+	length = append(buffer, size, length, "  window %c:", name);
+	for (size_t i = 0; i < B_COUNT_OF(kWindowRegisters); i++) {
+		length = append(buffer, size, length, " %s %08" B_PRIx32,
+			kWindowRegisters[i].name,
+			dc[windowWord + kWindowRegisters[i].word]);
+	}
+	for (size_t i = 0; i < B_COUNT_OF(kWindowBufferRegisters); i++) {
+		length = append(buffer, size, length, " %s %08" B_PRIx32,
+			kWindowBufferRegisters[i].name,
+			dc[bufferWord + kWindowBufferRegisters[i].word]);
+	}
+	return append(buffer, size, length, "\n");
+}
+
+
+static size_t
+report_dc(char* buffer, size_t size, size_t length, const char* name,
+	phys_addr_t base)
+{
+	area_id area;
+	volatile uint32* dc = map_registers("tegra dc", base, DC_SIZE, &area);
+	if (dc == NULL)
+		return append(buffer, size, length, "%s: cannot map\n", name);
+
+	length = append(buffer, size, length, "%s:\n", name);
+	for (size_t i = 0; i < B_COUNT_OF(kDcRegisters); i++) {
+		length = append(buffer, size, length, "  %s %08" B_PRIx32 "\n",
+			kDcRegisters[i].name, dc[kDcRegisters[i].word]);
+	}
+
+	// The window the header selects, through the documented registers
+	length = report_window(buffer, size, length, dc, 'h', 0x700, 0x800);
+	// Each window through its own aperture, as Linux addresses them
+	for (int i = 0; i < 3; i++) {
+		uint32 windowBase = 0xa00 + 0x200 * i;
+		length = report_window(buffer, size, length, dc, 'A' + i,
+			windowBase + 0x180, windowBase + 0x1c0);
+	}
+
+	delete_area(area);
+	return length;
+}
+
+
+static size_t
+report_memory(char* buffer, size_t size, size_t length)
+{
+	// The firmware frame buffer and the memory above it, in 1MB steps
+	length = append(buffer, size, length, "managed pages from 0x1f000000:");
+	for (phys_addr_t start = 0x1f000000; start < 0x20000000;
+			start += 0x100000) {
+		uint32 managed = 0, free = 0;
+		for (phys_addr_t address = start; address < start + 0x100000;
+				address += B_PAGE_SIZE) {
+			vm_page* page = vm_lookup_page(address / B_PAGE_SIZE);
+			if (page == NULL)
+				continue;
+			managed++;
+			if (page->State() == PAGE_STATE_FREE
+				|| page->State() == PAGE_STATE_CLEAR) {
+				free++;
+			}
+		}
+		length = append(buffer, size, length, " %" B_PRIx64 ":%"
+			B_PRIu32 "/%" B_PRIu32, (uint64)start, managed, free);
+	}
+	length = append(buffer, size, length, " (managed/free of 256)\n");
+
+	// Page states of the firmware frame buffer region, and whether the
+	// pages belong to a cache (an area)
+	static const char* kStates[] = { "active", "inactive", "modified",
+		"cached", "free", "clear", "wired", "unused" };
+	uint32 counts[8] = {};
+	uint32 inCache = 0;
+	phys_addr_t lastCached = 0;
+	for (phys_addr_t address = 0x1f800000; address < 0x20000000;
+			address += B_PAGE_SIZE) {
+		vm_page* page = vm_lookup_page(address / B_PAGE_SIZE);
+		if (page == NULL)
+			continue;
+		counts[page->State() & 7]++;
+		if (page->Cache() != NULL) {
+			if (inCache == 0 || address != lastCached + B_PAGE_SIZE) {
+				if (inCache != 0) {
+					length = append(buffer, size, length, "-%" B_PRIx64
+						" ", (uint64)(lastCached + B_PAGE_SIZE));
+				}
+				VMArea* area = page->Cache()->areas.Head();
+				length = append(buffer, size, length, "cached run %"
+					B_PRIx64 " (area \"%s\")", (uint64)address,
+					area != NULL ? area->name : "-");
+			}
+			lastCached = address;
+			inCache++;
+		}
+	}
+	if (inCache != 0) {
+		length = append(buffer, size, length, "-%" B_PRIx64 "\n",
+			(uint64)(lastCached + B_PAGE_SIZE));
+	}
+	length = append(buffer, size, length, "0x1f800000-0x20000000:");
+	for (int i = 0; i < 8; i++) {
+		if (counts[i] != 0) {
+			length = append(buffer, size, length, " %s %" B_PRIu32, kStates[i],
+				counts[i]);
+		}
+	}
+	return append(buffer, size, length, ", %" B_PRIu32 " in a cache\n",
+		inCache);
+}
+
+
+//	#pragma mark - device hooks
+
+
+static status_t
+diag_open(const char* name, uint32 flags, void** _cookie)
+{
+	*_cookie = NULL;
+	return B_OK;
+}
+
+
+static status_t
+diag_close(void* cookie)
+{
+	return B_OK;
+}
+
+
+static status_t
+diag_free(void* cookie)
+{
+	return B_OK;
+}
+
+
+static status_t
+diag_control(void* cookie, uint32 op, void* arg, size_t length)
+{
+	return B_DEV_INVALID_IOCTL;
+}
+
+
+static status_t
+diag_read(void* cookie, off_t position, void* buffer, size_t* _length)
+{
+	const size_t kSize = 8192;
+	char* text = (char*)malloc(kSize);
+	if (text == NULL)
+		return B_NO_MEMORY;
+
+	bool dcARunning = false, dcBRunning = false;
+	size_t textLength = report_clocks(text, kSize, 0, &dcARunning,
+		&dcBRunning);
+	if (dcARunning)
+		textLength = report_dc(text, kSize, textLength, "DC A",
+			TEGRA20_DC_A_BASE);
+	if (dcBRunning)
+		textLength = report_dc(text, kSize, textLength, "DC B",
+			TEGRA20_DC_B_BASE);
+	textLength = report_memory(text, kSize, textLength);
+	if (textLength >= kSize)
+		textLength = kSize - 1;
+
+	status_t status = B_OK;
+	if (position < 0 || (size_t)position >= textLength)
+		*_length = 0;
+	else {
+		size_t length = min_c(*_length, textLength - (size_t)position);
+		if (user_memcpy(buffer, text + position, length) != B_OK)
+			status = B_BAD_ADDRESS;
+		else
+			*_length = length;
+	}
+	free(text);
+	return status;
+}
+
+
+static status_t
+diag_write(void* cookie, off_t position, const void* buffer, size_t* _length)
+{
+	*_length = 0;
+	return B_NOT_ALLOWED;
+}
+
+
+static device_hooks sDeviceHooks = {
+	diag_open,
+	diag_close,
+	diag_free,
+	diag_control,
+	diag_read,
+	diag_write,
+};
+
+
+//	#pragma mark - driver
+
+
+status_t
+init_hardware(void)
+{
+	return B_OK;
+}
+
+
+status_t
+init_driver(void)
+{
+	return B_OK;
+}
+
+
+void
+uninit_driver(void)
+{
+}
+
+
+const char**
+publish_devices(void)
+{
+	return sDeviceNames;
+}
+
+
+device_hooks*
+find_device(const char* name)
+{
+	return &sDeviceHooks;
+}
