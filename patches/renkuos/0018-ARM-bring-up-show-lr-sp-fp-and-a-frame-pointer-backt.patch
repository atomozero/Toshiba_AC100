From f7517ea1896619d5ef6f59163279962dbe6ef9b1 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 16:25:55 +0200
Subject: [PATCH 018/203] ARM bring-up: show lr, sp, fp and a frame pointer
 backtrace on early faults (not for merging)

---
 src/system/kernel/arch/arm/arch_int.cpp | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/system/kernel/arch/arm/arch_int.cpp b/src/system/kernel/arch/arm/arch_int.cpp
index d4a60a0655..21527d2b48 100644
--- a/src/system/kernel/arch/arm/arch_int.cpp
+++ b/src/system/kernel/arch/arm/arch_int.cpp
@@ -370,6 +370,19 @@ arch_arm_page_fault(struct iframe *frame, addr_t far, uint32 fsr, bool isWrite,
 		arm_boot_marker_value(4, far);
 		arm_boot_marker_value(5, frame->pc);
 		arm_boot_marker_value(6, fsr);
+		arm_boot_marker_value(7, frame->svc_lr);
+		arm_boot_marker_value(8, frame->svc_sp);
+		arm_boot_marker_value(9, frame->r11);
+
+		// follow the frame pointer chain: [fp] = return address,
+		// [fp - 4] = caller's frame pointer
+		uint32 fp = frame->r11;
+		for (int level = 0; level < 4; level++) {
+			if (fp < KERNEL_BASE || (fp & 3) != 0)
+				break;
+			arm_boot_marker_value(10 + level, ((uint32*)fp)[0]);
+			fp = ((uint32*)fp)[-1];
+		}
 	}
 
 	Thread *thread = thread_get_current_thread();
