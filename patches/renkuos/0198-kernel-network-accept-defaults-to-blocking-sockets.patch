From a7b137e0efe4c5f1a9eb89892e2817f164616ef0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?J=C3=A9r=C3=B4me=20Duval?= <jerome.duval@gmail.com>
Date: Thu, 1 Oct 2026 22:07:59 +0200
Subject: [PATCH 198/270] kernel/network: accept() defaults to blocking sockets

as suggested by waddlesplash on the change 11748
tested with curl test suite

Change-Id: I1421c913bb94db739e2f5a7d401cfd57172fd0b9
Reviewed-on: https://review.haiku-os.org/c/haiku/+/11895
Tested-by: Commit checker robot <no-reply+buildbot@haiku-os.org>
Reviewed-by: waddlesplash <waddlesplash@gmail.com>
Haiku-Format: Haiku-format Bot <no-reply+haikuformatbot@haiku-os.org>
(cherry picked from commit bbdbb842819461dd5f3c07b59852fb3d24214031)
---
 headers/private/system/socket_defs.h | 13 -------------
 src/system/kernel/fs/socket.cpp      | 22 +++++-----------------
 src/system/libnetwork/socket.cpp     |  3 +--
 3 files changed, 6 insertions(+), 32 deletions(-)
 delete mode 100644 headers/private/system/socket_defs.h

diff --git a/headers/private/system/socket_defs.h b/headers/private/system/socket_defs.h
deleted file mode 100644
index 339dae940b..0000000000
--- a/headers/private/system/socket_defs.h
+++ /dev/null
@@ -1,13 +0,0 @@
-/*
- * Copyright 2026, Haiku, Inc. All rights reserved.
- * Distributed under the terms of the MIT License.
- */
-#ifndef _SYSTEM_SOCKET_DEFS_H
-#define _SYSTEM_SOCKET_DEFS_H
-
-
-// for accept() inherit behavior
-#define SOCK_INHERIT 0x1
-
-
-#endif	/* _SYSTEM_SOCKET_DEFS_H */
diff --git a/src/system/kernel/fs/socket.cpp b/src/system/kernel/fs/socket.cpp
index 02e2238ef1..14b1fa1c8d 100644
--- a/src/system/kernel/fs/socket.cpp
+++ b/src/system/kernel/fs/socket.cpp
@@ -15,7 +15,6 @@
 #include <AutoDeleter.h>
 #include <AutoDeleterDrivers.h>
 
-#include <socket_defs.h>
 #include <syscall_utils.h>
 
 #include <fd.h>
@@ -388,27 +387,16 @@ static int
 create_socket_fd(net_socket* socket, int flags, bool kernel)
 {
 	int oflags = 0;
+	int32 nonBlock = 0;
 	if ((flags & SOCK_CLOEXEC) != 0)
 		oflags |= O_CLOEXEC;
 	if ((flags & SOCK_CLOFORK) != 0)
 		oflags |= O_CLOFORK;
-	if ((flags & SOCK_INHERIT) != 0) {
-		// Get the socket's non-blocking flag, so we can set the respective
-		// open mode flag.
-		int32 nonBlock;
-		socklen_t nonBlockLen = sizeof(nonBlock);
-		status_t error = sStackInterface->getsockopt(socket, SOL_SOCKET,
-			SO_NONBLOCK, &nonBlock, &nonBlockLen);
-		if (error != B_OK)
-			return error;
-		if (nonBlock)
-			oflags |= O_NONBLOCK;
-	} else if ((flags & SOCK_NONBLOCK) != 0) {
+	if ((flags & SOCK_NONBLOCK) != 0) {
 		oflags |= O_NONBLOCK;
-		int32 nonBlock = 1;
-		sStackInterface->setsockopt(socket, SOL_SOCKET,
-			SO_NONBLOCK, &nonBlock, sizeof(nonBlock));
+		nonBlock = 1;
 	}
+	sStackInterface->setsockopt(socket, SOL_SOCKET, SO_NONBLOCK, &nonBlock, sizeof(nonBlock));
 
 	// allocate a file descriptor
 	file_descriptor* descriptor = alloc_fd();
@@ -528,7 +516,7 @@ common_accept(int fd, struct sockaddr *address, socklen_t *_addressLength, int f
 	GET_SOCKET_FD_OR_RETURN(fd, kernel, descriptor);
 	FileDescriptorPutter _(descriptor);
 
-	if ((flags & ~(SOCK_CLOEXEC | SOCK_NONBLOCK | SOCK_CLOFORK | SOCK_INHERIT)) != 0)
+	if ((flags & ~(SOCK_CLOEXEC | SOCK_NONBLOCK | SOCK_CLOFORK)) != 0)
 		RETURN_AND_SET_ERRNO(B_BAD_VALUE);
 
 	net_socket* acceptedSocket;
diff --git a/src/system/libnetwork/socket.cpp b/src/system/libnetwork/socket.cpp
index de832a9d66..44d33a042e 100644
--- a/src/system/libnetwork/socket.cpp
+++ b/src/system/libnetwork/socket.cpp
@@ -18,7 +18,6 @@
 #include <sys/ioctl.h>
 #include <unistd.h>
 
-#include <socket_defs.h>
 #include <syscall_utils.h>
 
 #include <syscalls.h>
@@ -230,7 +229,7 @@ _accept(int socket, struct sockaddr *_address, socklen_t *_addressLength, int fl
 extern "C" int
 accept(int socket, struct sockaddr *_address, socklen_t *_addressLength)
 {
-	return _accept(socket, _address, _addressLength, SOCK_INHERIT);
+	return _accept(socket, _address, _addressLength, 0);
 }
 
 
