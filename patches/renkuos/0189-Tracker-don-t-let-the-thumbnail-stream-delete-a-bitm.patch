From 94bd4063e05f828eb489d9f877e6afa5ac8ac606 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Fri, 23 Oct 2026 22:41:30 +0200
Subject: [PATCH 189/270] Tracker: don't let the thumbnail stream delete a
 bitmap on the stack

GenerateThumbnailJob wraps its stack BBitmap in a BBitmapStream to make the
WebP thumbnail, but only detached it when the translation succeeded. With
no WebP translator (as on ARM) the stream's destructor deleted the stack
object: Tracker, and every file panel, crashed with "bogus pointer" on
the thumbnail of any image, such as a fresh screenshot.
---
 src/kits/tracker/Thumbnails.cpp | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/kits/tracker/Thumbnails.cpp b/src/kits/tracker/Thumbnails.cpp
index 83ed4f1be2..58c4218765 100644
--- a/src/kits/tracker/Thumbnails.cpp
+++ b/src/kits/tracker/Thumbnails.cpp
@@ -215,9 +215,12 @@ GenerateThumbnailJob::Execute()
 		BBitmap* thumbPointer = &thumb;
 		BBitmapStream thumbStream(thumbPointer);
 		BMallocIO stream;
-		if (BTranslatorRoster::Default()->Translate(&thumbStream,
-					NULL, NULL, &stream, B_WEBP_FORMAT) == B_OK
-				&& thumbStream.DetachBitmap(&thumbPointer) == B_OK) {
+		status_t translated = BTranslatorRoster::Default()->Translate(
+			&thumbStream, NULL, NULL, &stream, B_WEBP_FORMAT);
+		// the stream must never delete the bitmap, which lives on the stack,
+		// also when there is no WebP translator
+		if (thumbStream.DetachBitmap(&thumbPointer) == B_OK
+				&& translated == B_OK) {
 			// write WebP image data into an attribute
 			status = fFile->WriteAttr(kAttrThumbnail, B_RAW_TYPE, 0,
 				stream.Buffer(), stream.BufferLength());
