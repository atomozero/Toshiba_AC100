From 2bcebe391b9533beb8623395cf0917a8f92e3e84 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 26 Oct 2026 22:24:31 +0100
Subject: [PATCH 263/270] tegra_audio: mixer controls for the speaker,
 headphones and HDMI

The output group has the volume and mute of the speaker and of the
headphones (the ALC5632 attenuators, 1.5 dB steps) and two HDMI
switches: the sound on the HDMI screen (the S/PDIF controller is now
always set up, and the switch restarts playback) and the speaker off
while a screen is plugged in. The Media preferences and Cortex show
them, and the media server keeps them.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../drivers/audio/tegra/tegra_audio.cpp       | 214 +++++++++++++++++-
 1 file changed, 202 insertions(+), 12 deletions(-)

diff --git a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
index 22a4e63f31..8477dfd223 100644
--- a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
+++ b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
@@ -263,6 +263,13 @@ struct tegra_audio {
 	int32					headphones;	// -1 not known yet
 	int32					hdmi;		// -1 not known yet
 	bool					hdmiMutesSpeaker;
+
+	// the mixer controls (Media preferences, Cortex): attenuation of the
+	// left and right channel in 1.5 dB steps (0 - 31), mute by the user
+	uint8					speakerLevel[2];
+	uint8					headphoneLevel[2];
+	bool					speakerMuted;
+	bool					headphonesMuted;
 };
 
 
@@ -422,17 +429,31 @@ codec_init(tegra_audio* audio)
 }
 
 
-/*!	Mutes the speaker while headphones are plugged in, as the PAZ00 machine
-	driver of Linux does with its jack and the "Int Spk" pin.
+/*!	A volume register of the ALC5632: attenuation of the left channel in
+	bits 12-8 and of the right one in bits 4-0, mutes in bits 15 and 7.
+*/
+static uint16
+codec_volume(const uint8* level, bool mute)
+{
+	return (mute ? 0x8080 : 0) | ((level[0] & 0x1f) << 8) | (level[1] & 0x1f);
+}
+
+
+/*!	The speaker is off while headphones are plugged in, as the PAZ00 machine
+	driver of Linux does with its jack and the "Int Spk" pin, and while an
+	HDMI screen is (the sound goes there through S/PDIF), or when the user
+	muted it. Called with the lock held.
 */
 static void
 set_outputs(tegra_audio* audio)
 {
-	// the sound goes to the S/PDIF controller and on to HDMI anyway
 	bool hdmi = audio->hdmi > 0 && audio->hdmiMutesSpeaker
 		&& audio->spdifEnabled;
-	bool mute = audio->headphones > 0 || hdmi;
-	codec_update(audio, ALC5632_SPK_OUT_VOL, 0x8080, mute ? 0x8080 : 0);
+	bool mute = audio->headphones > 0 || hdmi || audio->speakerMuted;
+	codec_write(audio, ALC5632_SPK_OUT_VOL,
+		codec_volume(audio->speakerLevel, mute));
+	codec_write(audio, ALC5632_HP_OUT_VOL,
+		codec_volume(audio->headphoneLevel, audio->headphonesMuted));
 	TRACE_ALWAYS("headphones %s, HDMI %s, speaker %s\n",
 		audio->headphones > 0 ? "plugged in" : "unplugged",
 		audio->hdmi > 0 ? "plugged in" : "unplugged", mute ? "muted" : "on");
@@ -447,6 +468,7 @@ jack_thread(void* data)
 		int32 plugged = (read32(audio->gpioPort, GPIO_IN) & HP_DETECT_BIT) != 0;
 		int32 hdmi = (read32(audio->hdmiPort, GPIO_IN) & HDMI_DETECT_BIT) != 0;
 		if (plugged != audio->headphones || hdmi != audio->hdmi) {
+			MutexLocker locker(audio->lock);
 			audio->headphones = plugged;
 			audio->hdmi = hdmi;
 			set_outputs(audio);
@@ -1156,17 +1178,170 @@ set_global_format(tegra_audio* audio, multi_format_info* data)
 }
 
 
+enum {
+	MIX_OUTPUT = 1,
+	MIX_SPEAKER,
+	MIX_SPEAKER_LEFT,
+	MIX_SPEAKER_RIGHT,
+	MIX_SPEAKER_MUTE,
+	MIX_HEADPHONES,
+	MIX_HEADPHONES_LEFT,
+	MIX_HEADPHONES_RIGHT,
+	MIX_HEADPHONES_MUTE,
+	MIX_HDMI,
+	MIX_HDMI_SOUND,
+	MIX_HDMI_MUTES_SPEAKER,
+	MIX_CONTROL_COUNT = MIX_HDMI_MUTES_SPEAKER
+};
+
+#define ALC5632_STEP_DB			1.5f
+#define ALC5632_MAX_LEVEL		31
+
+
+static void
+make_control(multi_mix_control& control, int32 id, uint32 flags,
+	int32 parent, enum strind_id string, const char* name, int32 master = 0)
+{
+	memset(&control, 0, sizeof(control));
+	control.id = id;
+	control.flags = flags;
+	control.parent = parent;
+	control.string = string;
+	control.master = master;
+	strlcpy(control.name, name, sizeof(control.name));
+	if ((flags & B_MULTI_MIX_GAIN) != 0) {
+		control.gain.min_gain = -ALC5632_STEP_DB * ALC5632_MAX_LEVEL;
+		control.gain.max_gain = 0;
+		control.gain.granularity = ALC5632_STEP_DB;
+	}
+}
+
+
+/*!	Output: the speaker and the headphones with their volume and mute, and
+	HDMI: whether the sound goes there, and whether the speaker is off
+	while a screen is plugged in.
+*/
 static status_t
 list_mix_controls(tegra_audio* audio, multi_mix_control_info* data)
 {
 	multi_mix_control_info info;
 	if (user_memcpy(&info, data, sizeof(info)) != B_OK)
 		return B_BAD_ADDRESS;
-	info.control_count = 0;
+
+	multi_mix_control controls[MIX_CONTROL_COUNT];
+	int32 i = 0;
+	make_control(controls[i++], MIX_OUTPUT, B_MULTI_MIX_GROUP, 0, S_OUTPUT,
+		"");
+	make_control(controls[i++], MIX_SPEAKER, B_MULTI_MIX_GROUP, MIX_OUTPUT,
+		S_null, "Speaker");
+	make_control(controls[i++], MIX_SPEAKER_LEFT, B_MULTI_MIX_GAIN,
+		MIX_SPEAKER, S_null, "");
+	make_control(controls[i++], MIX_SPEAKER_RIGHT, B_MULTI_MIX_GAIN,
+		MIX_SPEAKER, S_null, "", MIX_SPEAKER_LEFT);
+	make_control(controls[i++], MIX_SPEAKER_MUTE, B_MULTI_MIX_ENABLE,
+		MIX_SPEAKER, S_MUTE, "");
+	make_control(controls[i++], MIX_HEADPHONES, B_MULTI_MIX_GROUP,
+		MIX_OUTPUT, S_HEADPHONE, "");
+	make_control(controls[i++], MIX_HEADPHONES_LEFT, B_MULTI_MIX_GAIN,
+		MIX_HEADPHONES, S_null, "");
+	make_control(controls[i++], MIX_HEADPHONES_RIGHT, B_MULTI_MIX_GAIN,
+		MIX_HEADPHONES, S_null, "", MIX_HEADPHONES_LEFT);
+	make_control(controls[i++], MIX_HEADPHONES_MUTE, B_MULTI_MIX_ENABLE,
+		MIX_HEADPHONES, S_MUTE, "");
+	make_control(controls[i++], MIX_HDMI, B_MULTI_MIX_GROUP, MIX_OUTPUT,
+		S_null, "HDMI");
+	make_control(controls[i++], MIX_HDMI_SOUND, B_MULTI_MIX_ENABLE, MIX_HDMI,
+		S_null, "Sound on the HDMI screen");
+	make_control(controls[i++], MIX_HDMI_MUTES_SPEAKER, B_MULTI_MIX_ENABLE,
+		MIX_HDMI, S_null, "Speaker off while a screen is plugged in");
+
+	int32 count = min_c(info.control_count, (int32)B_COUNT_OF(controls));
+	if (count < 0 || (count > 0 && !IS_USER_ADDRESS(info.controls))
+		|| user_memcpy(info.controls, controls,
+			count * sizeof(multi_mix_control)) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+	info.control_count = B_COUNT_OF(controls);
 	return user_memcpy(data, &info, sizeof(info));
 }
 
 
+static status_t
+mix_values(tegra_audio* audio, multi_mix_value_info* data, bool set)
+{
+	multi_mix_value_info info;
+	if (user_memcpy(&info, data, sizeof(info)) != B_OK
+		|| info.item_count < 0 || info.item_count > 64
+		|| (info.item_count > 0 && !IS_USER_ADDRESS(info.values))) {
+		return B_BAD_ADDRESS;
+	}
+
+	MutexLocker locker(audio->lock);
+
+	for (int32 i = 0; i < info.item_count; i++) {
+		multi_mix_value value;
+		if (user_memcpy(&value, &info.values[i], sizeof(value)) != B_OK)
+			return B_BAD_ADDRESS;
+
+		uint8* level = NULL;
+		bool* flag = NULL;
+		switch (value.id) {
+			case MIX_SPEAKER_LEFT:
+			case MIX_SPEAKER_RIGHT:
+				level = &audio->speakerLevel[value.id - MIX_SPEAKER_LEFT];
+				break;
+			case MIX_HEADPHONES_LEFT:
+			case MIX_HEADPHONES_RIGHT:
+				level = &audio->headphoneLevel[value.id - MIX_HEADPHONES_LEFT];
+				break;
+			case MIX_SPEAKER_MUTE:
+				flag = &audio->speakerMuted;
+				break;
+			case MIX_HEADPHONES_MUTE:
+				flag = &audio->headphonesMuted;
+				break;
+			case MIX_HDMI_SOUND:
+				flag = &audio->spdifEnabled;
+				break;
+			case MIX_HDMI_MUTES_SPEAKER:
+				flag = &audio->hdmiMutesSpeaker;
+				break;
+			default:
+				continue;
+		}
+
+		if (!set) {
+			if (level != NULL)
+				value.gain = -ALC5632_STEP_DB * *level;
+			else
+				value.enable = *flag;
+			if (user_memcpy(&info.values[i], &value, sizeof(value)) != B_OK)
+				return B_BAD_ADDRESS;
+			continue;
+		}
+
+		if (level != NULL) {
+			int32 steps = (int32)(-value.gain / ALC5632_STEP_DB + 0.5f);
+			*level = max_c(0, min_c(steps, ALC5632_MAX_LEVEL));
+		} else if (flag == &audio->spdifEnabled) {
+			// only with the S/PDIF controller set up at start
+			bool enable = value.enable && audio->spdifInterruptInstalled;
+			if (enable != audio->spdifEnabled) {
+				// both DMA channels start together with the next buffer
+				stop_playback(audio);
+				audio->spdifEnabled = enable;
+
+			}
+		} else
+			*flag = value.enable;
+	}
+
+	if (set)
+		set_outputs(audio);
+	return B_OK;
+}
+
+
 static status_t
 get_buffers(tegra_audio* audio, multi_buffer_list* data)
 {
@@ -1508,6 +1683,10 @@ tegra_audio_control(void* _cookie, uint32 op, void* arg, size_t length)
 			return set_global_format(audio, (multi_format_info*)arg);
 		case B_MULTI_LIST_MIX_CONTROLS:
 			return list_mix_controls(audio, (multi_mix_control_info*)arg);
+		case B_MULTI_GET_MIX:
+			return mix_values(audio, (multi_mix_value_info*)arg, false);
+		case B_MULTI_SET_MIX:
+			return mix_values(audio, (multi_mix_value_info*)arg, true);
 		case B_MULTI_GET_BUFFERS:
 			return get_buffers(audio, (multi_buffer_list*)arg);
 		case B_MULTI_BUFFER_EXCHANGE:
@@ -1667,12 +1846,23 @@ tegra_audio_init_driver(device_node* node, void** _cookie)
 		"hdmi_mutes_speaker", true, true);
 	unload_driver_settings(settings);
 
-	if (spdif) {
-		setup_spdif(audio);
-		audio->spdifEnabled = install_io_interrupt_handler(
-			SPDIF_DMA_CHANNEL_IRQ, spdif_dma_interrupt, audio, 0) == B_OK;
-		audio->spdifInterruptInstalled = audio->spdifEnabled;
-		TRACE_ALWAYS("S/PDIF: %s\n", audio->spdifEnabled ? "on" : "off");
+	// The S/PDIF controller is always set up, so that the mixer control
+	// can turn the HDMI sound on and off
+	setup_spdif(audio);
+	audio->spdifInterruptInstalled = install_io_interrupt_handler(
+		SPDIF_DMA_CHANNEL_IRQ, spdif_dma_interrupt, audio, 0) == B_OK;
+	audio->spdifEnabled = spdif && audio->spdifInterruptInstalled;
+	TRACE_ALWAYS("S/PDIF: %s\n", audio->spdifEnabled ? "on" : "off");
+
+	// the volumes codec_init() set
+	uint16 volume;
+	if (codec_read(audio, ALC5632_SPK_OUT_VOL, &volume) == B_OK) {
+		audio->speakerLevel[0] = (volume >> 8) & 0x1f;
+		audio->speakerLevel[1] = volume & 0x1f;
+	}
+	if (codec_read(audio, ALC5632_HP_OUT_VOL, &volume) == B_OK) {
+		audio->headphoneLevel[0] = (volume >> 8) & 0x1f;
+		audio->headphoneLevel[1] = volume & 0x1f;
 	}
 	if (selfTest)
 		self_test(audio);
