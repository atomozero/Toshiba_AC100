From bf983151591f061d9d18dac94c955c12c5b1c02a Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 24 Oct 2026 19:27:46 +0200
Subject: [PATCH 209/270] tegra_audio: run the bring-up self test only on
 request

It ends with a 1.5 s tone on every boot. "self_test true" in the
tegra_audio driver settings still runs it.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
index 9b1071785f..662816bfdc 100644
--- a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
+++ b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
@@ -24,6 +24,7 @@
 
 #include <KernelExport.h>
 #include <device_manager.h>
+#include <driver_settings.h>
 #include <hmulti_audio.h>
 #include <i2c.h>
 #include <kernel.h>
@@ -1498,7 +1499,14 @@ tegra_audio_init_driver(device_node* node, void** _cookie)
 		return status;
 	}
 
-	self_test(audio);
+	// the bring-up tests end with a tone of 1.5 s, so they only run when
+	// "self_test true" is in the tegra_audio driver settings
+	void* settings = load_driver_settings("tegra_audio");
+	bool selfTest = get_driver_boolean_parameter(settings, "self_test", false,
+		true);
+	unload_driver_settings(settings);
+	if (selfTest)
+		self_test(audio);
 	start_jack_detection(audio);
 
 	*_cookie = audio;
