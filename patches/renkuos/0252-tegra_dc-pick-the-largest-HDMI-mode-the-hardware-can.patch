From 9163d8bae1136260c3fe894acaafa90d61c3f613 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 26 Oct 2026 14:22:43 +0100
Subject: [PATCH 252/270] tegra_dc: pick the largest HDMI mode the hardware can
 drive

A 4K television prefers 3840x2160 at 594 MHz, beyond the 148.5 MHz the
Tegra 2 can drive. Take the preferred mode when possible, or else the
largest usable one among the EDID detailed timings and the CEA codes
for 1080p and 720p, and log the modes the screen lists.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../kernel/drivers/graphics/tegra_dc/hdmi.cpp | 75 +++++++++++++++++--
 1 file changed, 67 insertions(+), 8 deletions(-)

diff --git a/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp b/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
index 204714f522..544af5f510 100644
--- a/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
+++ b/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
@@ -638,6 +638,10 @@ parse_detailed_timing(const uint8* d, hdmi_mode& mode)
 	uint32 vSyncWidth = (d[10] & 0xf) | ((d[11] & 3) << 4);
 	uint8 flags = d[17];
 
+	dprintf("tegra_dc: hdmi: EDID mode %" B_PRIu32 "x%" B_PRIu32 "%s, %"
+		B_PRIu32 " kHz, totals %" B_PRIu32 "x%" B_PRIu32 "\n", hActive,
+		vActive, (flags & 0x80) != 0 ? " interlaced" : "", pixelClock,
+		hActive + hBlank, vActive + vBlank);
 	if ((flags & 0x80) != 0 || (flags & 0x18) != 0x18
 		|| pixelClock > 148500 || hActive > 1920 || vActive > 1200
 		|| hActive < 640 || vActive < 480) {
@@ -660,6 +664,64 @@ parse_detailed_timing(const uint8* d, hdmi_mode& mode)
 }
 
 
+// 1920x1080 at 60 Hz (CEA-861 VIC 16)
+static const hdmi_mode k1080p = {
+	148500, 1920, 2008, 2052, 2200, 1080, 1084, 1089, 1125, true, true, 16
+};
+
+
+/*!	The screen's preferred mode if this hardware can drive it, or else the
+	largest one it can among the detailed timings and, as 1080p is often
+	only listed by its CEA code, the CEA video codes.
+*/
+static bool
+choose_mode(const uint8* edid, uint32 size, hdmi_mode& chosen)
+{
+	bool found = false;
+	auto consider = [&](const hdmi_mode& mode) {
+		if (!found || (uint32)mode.h_display * mode.v_display
+				> (uint32)chosen.h_display * chosen.v_display) {
+			chosen = mode;
+			found = true;
+		}
+	};
+
+	for (uint32 offset = 0x36; offset < 0x7e; offset += 18) {
+		hdmi_mode mode;
+		if (parse_detailed_timing(edid + offset, mode)) {
+			consider(mode);
+			if (offset == 0x36)
+				return true;
+		}
+	}
+
+	if (size >= 256 && edid[128] == 0x02) {
+		const uint8* cea = edid + 128;
+		uint32 end = cea[2];
+		for (uint32 offset = end; offset + 18 <= 127 && end >= 4;
+				offset += 18) {
+			hdmi_mode mode;
+			if (parse_detailed_timing(cea + offset, mode))
+				consider(mode);
+		}
+		for (uint32 i = 4; i < end && i < 127;) {
+			uint32 tag = cea[i] >> 5;
+			uint32 length = cea[i] & 0x1f;
+			if (tag == 2) {
+				for (uint32 j = 1; j <= length && i + j < 127; j++) {
+					if ((cea[i + j] & 0x7f) == k1080p.vic)
+						consider(k1080p);
+					else if ((cea[i + j] & 0x7f) == k720p.vic)
+						consider(k720p);
+				}
+			}
+			i += 1 + length;
+		}
+	}
+	return found;
+}
+
+
 /*!	A screen is an HDMI sink, rather than a DVI one, if its CEA extension
 	has the HDMI vendor specific data block.
 */
@@ -1141,9 +1203,9 @@ connect()
 	sHdmi.mode = k720p;
 	if (status == B_OK) {
 		hdmiSink = is_hdmi_sink(edid, edidSize);
-		hdmi_mode preferred;
-		if (parse_detailed_timing(edid + 0x36, preferred))
-			sHdmi.mode = preferred;
+		hdmi_mode chosen;
+		if (choose_mode(edid, edidSize, chosen))
+			sHdmi.mode = chosen;
 		char name[14] = "unknown";
 		for (uint32 offset = 0x36; offset < 0x7e; offset += 18) {
 			const uint8* descriptor = edid + offset;
@@ -1158,11 +1220,8 @@ connect()
 				name[13] = '\0';
 			}
 		}
-		dprintf("tegra_dc: hdmi: EDID of \"%s\", %s sink, preferred %s\n",
-			name, hdmiSink ? "HDMI" : "DVI",
-			sHdmi.mode.h_display != k720p.h_display
-				|| sHdmi.mode.pixel_clock != k720p.pixel_clock
-				? "mode taken" : "mode 1280x720 (or unusable)");
+		dprintf("tegra_dc: hdmi: EDID of \"%s\", %s sink\n", name,
+			hdmiSink ? "HDMI" : "DVI");
 	} else
 		ERROR("no EDID (%s), trying 1280x720\n", strerror(status));
 
