From 9cc2b8465bb0ababdf675bf5b109f69bef9c9d08 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 24 Oct 2026 23:54:28 +0200
Subject: [PATCH 214/270] arm: raise the AC100 supplies to their nominal
 voltages on request

U-Boot runs the Tegra 2 CPU at 1 GHz with the 1.0 V that the TPS6586x
starts with, while the Tegra 2 tables of Linux want up to 1.1 V at
that rate, and 1.225 V on the core.

With "tegra_nominal_voltages true" in the kernel settings, the core,
RTC and CPU supplies are raised to 1.225, 1.225 and 1.1 V right after
the DVC I2C controller is set up, 25 mV at a time, keeping the core
120 mV above the CPU and within 170 mV of the RTC domain. They are
never lowered.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../kernel/arch/arm/arch_real_time_clock.cpp  | 114 +++++++++++++++++-
 1 file changed, 113 insertions(+), 1 deletion(-)

diff --git a/src/system/kernel/arch/arm/arch_real_time_clock.cpp b/src/system/kernel/arch/arm/arch_real_time_clock.cpp
index 64ef8ca5e0..7ee025c49c 100644
--- a/src/system/kernel/arch/arm/arch_real_time_clock.cpp
+++ b/src/system/kernel/arch/arm/arch_real_time_clock.cpp
@@ -72,6 +72,25 @@ static spinlock sTegraRTCLock = B_SPINLOCK_INITIALIZER;
 	// reading starts at the register before it
 #define TPS6586X_EPOCH				1230768000	// 2009-01-01 00:00:00 UTC
 
+// the supplies of the core, the CPU and the RTC domain: 725 mV and steps of
+// 25 mV in the low 5 bits of their V1 registers, applied by a go bit
+#define TPS6586X_VCC1				0x20
+#define TPS6586X_VCC2				0x21
+#define TPS6586X_SM1V1				0x23
+#define TPS6586X_SM0V1				0x26
+#define TPS6586X_LDO2BV1			0x2f
+#define TPS6586X_DVM_MIN_MV			725
+#define TPS6586X_DVM_STEP_MV		25
+
+// U-Boot runs the CPU at 1 GHz with the 1.0 V the TPS6586x starts with, while
+// the Tegra 2 tables of Linux want up to 1.1 V at that rate, and the core 1.225
+// V; the core must stay 120 mV above the CPU and within 170 mV of the RTC
+#define TEGRA_NOMINAL_CORE_MV		1225
+#define TEGRA_NOMINAL_CPU_MV		1100
+#define TEGRA_NOMINAL_RTC_MV		1225
+#define TEGRA_CORE_OVER_CPU_MV		120
+#define TEGRA_CORE_RTC_SPREAD_MV	170
+
 // its clock, as for the other I2C controllers: 8 times the bus clock, from
 // PLLP (216 MHz)
 #define TEGRA20_CAR_BASE			0x60006000
@@ -364,6 +383,94 @@ tegra_rtc_set_time(uint64 seconds)
 }
 
 
+struct tps6586x_supply {
+	const char*	name;
+	uint8		voltageRegister;
+	uint8		controlRegister;
+	uint8		goBit;
+	uint8		v2Bit;
+	uint32		nominal;
+};
+
+// in the order they are raised, the core first
+static const tps6586x_supply kTPS6586xSupplies[] = {
+	{ "core", TPS6586X_SM0V1, TPS6586X_VCC1, 1 << 2, 1 << 3,
+		TEGRA_NOMINAL_CORE_MV },
+	{ "rtc", TPS6586X_LDO2BV1, TPS6586X_VCC2, 1 << 6, 1 << 7,
+		TEGRA_NOMINAL_RTC_MV },
+	{ "cpu", TPS6586X_SM1V1, TPS6586X_VCC1, 1 << 0, 1 << 1,
+		TEGRA_NOMINAL_CPU_MV },
+};
+
+
+/*!	Raises the core, RTC and CPU supplies to their nominal voltages, 25 mV at
+	a time, if they are below; it never lowers them.
+*/
+static void
+tps6586x_set_nominal_voltages()
+{
+	const int32 count = B_COUNT_OF(kTPS6586xSupplies);
+	uint8 values[count];
+	uint32 millivolts[count];
+
+	InterruptsSpinLocker locker(sDVCLock);
+	for (int32 i = 0; i < count; i++) {
+		const tps6586x_supply& supply = kTPS6586xSupplies[i];
+		uint8 control;
+		status_t status = tps6586x_read(supply.controlRegister, &control, 1);
+		if (status == B_OK)
+			status = tps6586x_read(supply.voltageRegister, &values[i], 1);
+		if (status != B_OK || (control & supply.v2Bit) != 0) {
+			locker.Unlock();
+			dprintf("AC100: TPS6586x voltages: %s not readable from V1\n",
+				supply.name);
+			return;
+		}
+		millivolts[i] = TPS6586X_DVM_MIN_MV
+			+ (values[i] & 0x1f) * TPS6586X_DVM_STEP_MV;
+	}
+
+	for (int32 i = 0; i < count; i++) {
+		const tps6586x_supply& supply = kTPS6586xSupplies[i];
+		while (millivolts[i] < supply.nominal) {
+			millivolts[i] += TPS6586X_DVM_STEP_MV;
+			// core, rtc, cpu
+			if (millivolts[0] < millivolts[2] + TEGRA_CORE_OVER_CPU_MV
+				|| millivolts[0] > millivolts[1] + TEGRA_CORE_RTC_SPREAD_MV
+				|| millivolts[1] > millivolts[0] + TEGRA_CORE_RTC_SPREAD_MV) {
+				locker.Unlock();
+				dprintf("AC100: TPS6586x voltages: %s %" B_PRIu32 " mV would "
+					"break the limits\n", supply.name, millivolts[i]);
+				return;
+			}
+
+			uint8 value = (values[i] & ~0x1f) | ((millivolts[i]
+				- TPS6586X_DVM_MIN_MV) / TPS6586X_DVM_STEP_MV);
+			uint8 go = supply.goBit;
+			status_t status = tps6586x_write(supply.voltageRegister, &value,
+				1);
+			if (status == B_OK)
+				status = tps6586x_write(supply.controlRegister, &go, 1);
+			if (status != B_OK) {
+				locker.Unlock();
+				dprintf("AC100: TPS6586x voltages: %s: %s\n", supply.name,
+					strerror(status));
+				return;
+			}
+			values[i] = value;
+
+			// even the slowest slew rate takes well under that for 25 mV
+			spin(1000);
+		}
+	}
+	locker.Unlock();
+
+	dprintf("AC100: TPS6586x voltages: core %" B_PRIu32 ", rtc %" B_PRIu32
+		", cpu %" B_PRIu32 " mV\n", millivolts[0], millivolts[1],
+		millivolts[2]);
+}
+
+
 status_t
 arch_rtc_init(kernel_args *args, struct real_time_data *data)
 {
@@ -387,10 +494,12 @@ arch_rtc_init(kernel_args *args, struct real_time_data *data)
 	}
 
 	// "tps6586x_clock false" in the kernel settings leaves the power
-	// management IC alone
+	// management IC alone; "tegra_nominal_voltages true" raises the supplies
 	void* settings = load_driver_settings("kernel");
 	bool usePMIC = get_driver_boolean_parameter(settings, "tps6586x_clock",
 		true, true);
+	bool nominalVoltages = get_driver_boolean_parameter(settings,
+		"tegra_nominal_voltages", false, true);
 	unload_driver_settings(settings);
 
 	if (sTegraRTC != NULL && args->arch_args.pmicI2C.start != 0 && usePMIC) {
@@ -409,6 +518,9 @@ arch_rtc_init(kernel_args *args, struct real_time_data *data)
 			uint64 seconds = tps6586x_get_time();
 			if (seconds != 0)
 				tegra_rtc_set_time(seconds);
+
+			if (nominalVoltages && sTPS6586xRead)
+				tps6586x_set_nominal_voltages();
 		}
 	}
 
