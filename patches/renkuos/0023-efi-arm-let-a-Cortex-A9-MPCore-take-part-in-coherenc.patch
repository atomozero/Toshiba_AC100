From 768d7b866f8b3930ea4c6afd4c1c0c07c4821c09 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 17:14:55 +0200
Subject: [PATCH 023/270] efi/arm: let a Cortex-A9 MPCore take part in
 coherency

Set ACTLR.SMP and ACTLR.FW before entering the kernel, as Linux does, so
that table walks are coherent with the L1 data cache and maintenance
operations are broadcast. The bits are only written when not set yet.
---
 src/system/boot/platform/efi/arch/arm/entry.S | 22 +++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/src/system/boot/platform/efi/arch/arm/entry.S b/src/system/boot/platform/efi/arch/arm/entry.S
index f81f3b3466..ec0aede521 100644
--- a/src/system/boot/platform/efi/arch/arm/entry.S
+++ b/src/system/boot/platform/efi/arch/arm/entry.S
@@ -66,6 +66,28 @@ _pl1_entry:
 	// flush TLB
 	MCR p15, 0, r1, c8, c7, 0
 
+	// On a Cortex-A9 MPCore the table walks and the cache and TLB maintenance
+	// operations are only coherent once the CPU takes part in SMP
+	// (ACTLR.SMP and ACTLR.FW). The bits may be read-only, so only write them
+	// when they are not set yet.
+	mrc		p15, 0, r9, c0, c0, 0	// MIDR
+	movw	r10, #0xfff0			// no literal pool: this code is copied
+	movt	r10, #0xff0f			// to a trampoline page
+	and		r9, r9, r10
+	movw	r10, #0xc090
+	movt	r10, #0x410f			// ARM Cortex-A9
+	cmp		r9, r10
+	bne		1f
+	mrc		p15, 0, r9, c0, c0, 5	// MPIDR
+	tst		r9, #0x40000000			// U bit: uniprocessor
+	bne		1f
+	mrc		p15, 0, r9, c1, c0, 1	// ACTLR
+	tst		r9, #0x40				// SMP
+	orreq	r9, r9, #0x41			// SMP | FW
+	mcreq	p15, 0, r9, c1, c0, 1
+	isb
+1:
+
 	// set TTBR0
 	// cacheability attributes for the page tables are:
 	// Normal Memory, Inner/Outer Write-Back no Write-Allocate Cacheable
