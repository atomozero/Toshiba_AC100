From 80325cfd5c99b290da7853a4bf00d59bc2bacccf Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 24 Oct 2026 11:39:00 +0200
Subject: [PATCH 202/203] libroot/arm: merge aligned words when the memcpy()
 source is misaligned

With the destination aligned and the source not, memcpy() read the
source one unaligned word at a time; on the AC100 (Cortex-A9) that ran
at about 130 MB/s against 400 MB/s for aligned copies. Read aligned
words four at a time instead and merge each two neighbours with shifts,
storing 16 bytes with one store multiple. Reads never go past the word
holding the last byte to copy. The kernel keeps copying such buffers
byte by byte, as it may access device memory.

memtest (all sizes and alignments up to 4 KB against a byte by byte
reference) passes in QEMU, where the whole system boots with it.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../posix/string/arch/arm/arch_memcpy.S       | 51 +++++++++++++++++--
 1 file changed, 48 insertions(+), 3 deletions(-)

diff --git a/src/system/libroot/posix/string/arch/arm/arch_memcpy.S b/src/system/libroot/posix/string/arch/arm/arch_memcpy.S
index d00677685c..84cd8d2cb4 100644
--- a/src/system/libroot/posix/string/arch/arm/arch_memcpy.S
+++ b/src/system/libroot/posix/string/arch/arm/arch_memcpy.S
@@ -40,9 +40,9 @@ FUNCTION(memcpy):
 
 2:
 #ifndef _KERNEL_MODE
-	/* the source may still be misaligned: no load multiple then */
-	tst		r1, #3
-	bne		.Lcopy_words
+	/* the source may still be misaligned: merge aligned words then */
+	ands	r3, r1, #3
+	bne		.Lcopy_shifted
 #endif
 	subs	r2, r2, #32
 	blo		4f
@@ -69,6 +69,51 @@ FUNCTION(memcpy):
 	subs	r2, r2, #1
 	bne		6b
 7:	pop		{r0, r4-r9, pc}
+
+#ifndef _KERNEL_MODE
+/*	The destination is word aligned, the source is \offset bytes past a word
+	boundary: read whole aligned words and merge each two neighbours into one
+	destination word, 16 bytes per round. Reads never go past the word that
+	holds the last byte to copy. Unaligned single word loads did the same at
+	a third of the speed.
+*/
+.macro COPY_SHIFTED offset
+	bic		r1, r1, #3
+	ldr		r9, [r1], #4
+1:	ldmia	r1!, {r4-r7}
+	mov		r3, r9, lsr #(8 * \offset)
+	orr		r3, r3, r4, lsl #(32 - 8 * \offset)
+	mov		r4, r4, lsr #(8 * \offset)
+	orr		r4, r4, r5, lsl #(32 - 8 * \offset)
+	mov		r5, r5, lsr #(8 * \offset)
+	orr		r5, r5, r6, lsl #(32 - 8 * \offset)
+	mov		r6, r6, lsr #(8 * \offset)
+	orr		r6, r6, r7, lsl #(32 - 8 * \offset)
+	mov		r9, r7
+	stmia	r0!, {r3-r6}
+	subs	r2, r2, #16
+	bhs		1b
+	/* back to the real source position for the rest */
+	sub		r1, r1, #(4 - \offset)
+	b		8f
+.endm
+
+.Lcopy_shifted:
+	/* r3 = source offset in its word; at least 16 bytes per round */
+	subs	r2, r2, #16
+	blo		8f
+	pld		[r1, #64]
+	cmp		r3, #2
+	beq		.Lshift2
+	bhi		.Lshift3
+	COPY_SHIFTED 1
+.Lshift2:
+	COPY_SHIFTED 2
+.Lshift3:
+	COPY_SHIFTED 3
+8:	add		r2, r2, #16
+	b		.Lcopy_words
+#endif
 FUNCTION_END(memcpy)
 
 
