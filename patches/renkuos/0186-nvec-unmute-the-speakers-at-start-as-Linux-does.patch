From c70fd3758ac2c0b3dc9d916b576644a76b7c8935 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Fri, 23 Oct 2026 20:47:29 +0200
Subject: [PATCH 186/203] nvec: unmute the speakers at start, as Linux does

The EC keeps the TPA6017 speaker amplifier in shutdown (EC_MUTE#) until
it receives the OEM request 0d 10 59 95. Headphones worked, the internal
speaker never did.
---
 src/add-ons/kernel/busses/i2c/nvec/nvec.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
index 6d7b6717d0..9cedac25bd 100644
--- a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
+++ b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
@@ -1214,6 +1214,9 @@ start_ec(nvec_device* device)
 	static const uint8 kGlobalEvents[] = { NVEC_SLEEP, GLOBAL_EVENTS, 1 };
 	static const uint8 kFirmwareVersion[] = { NVEC_CNTL,
 		GET_FIRMWARE_VERSION };
+	// the EC holds the speaker amplifier in shutdown (EC_MUTE#) until it is
+	// told otherwise; Linux sends the same OEM request ("unmute speakers?")
+	static const uint8 kUnmuteSpeakers[] = { NVEC_OEM0, 0x10, 0x59, 0x95 };
 	static const uint8 kKeyboardEnable[] = { NVEC_KBD, KBD_ENABLE };
 	static const uint8 kKeyboardWake[] = { NVEC_KBD, KBD_CNFG_WAKE, 1, 1 };
 	static const uint8 kKeyboardWakeKeys[] = { NVEC_KBD,
@@ -1231,6 +1234,7 @@ start_ec(nvec_device* device)
 
 	nvec_write(device, kGlobalEvents, sizeof(kGlobalEvents));
 	nvec_write(device, kFirmwareVersion, sizeof(kFirmwareVersion));
+	nvec_write(device, kUnmuteSpeakers, sizeof(kUnmuteSpeakers));
 
 	// lid switch and power button events; the mask bytes are system state
 	// 23-16, 31-24, 7-0, 15-8
