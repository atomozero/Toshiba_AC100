Subject: [PATCH 170/270] ARM bring-up: tegra_audio: FIFO, reset and loopback
 tests on both I2S controllers (not for merging)

---
 .../drivers/audio/tegra/tegra_audio.cpp       | 123 ++++++++++++++++++
 1 file changed, 123 insertions(+)

diff --git a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
index f4f1ccb1c7..e4ebb923d7 100644
--- a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
+++ b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
@@ -47,12 +47,14 @@
 #define CAR_PLLA_OUT				0xb4
 #define CAR_PLLA_MISC				0xbc
 #define CAR_CLK_SOURCE_I2S1			0x100
+#define CAR_CLK_SOURCE_I2S2			0x104
 #define PLL_BASE_BYPASS				(1U << 31)
 #define PLL_BASE_ENABLE				(1U << 30)
 #define PLL_BASE_LOCK				(1U << 27)
 #define PLL_MISC_LOCK_ENABLE		(1U << 18)
 #define PLL_MISC_CPCON_SHIFT		8
 #define CLOCK_I2S1					11
+#define CLOCK_I2S2					18
 #define CLOCK_APBDMA				34
 #define CLOCK_CDEV1					94
 
@@ -72,6 +74,7 @@
 
 // I2S1
 #define I2S1_BASE					0x70002800
+#define I2S2_BASE					0x70002a00
 #define I2S_CTRL					0x00
 #define I2S_CTRL_FIFO1_ENABLE		(1U << 29)
 #define I2S_CTRL_MASTER_ENABLE		(1U << 25)
@@ -82,6 +85,13 @@
 #define I2S_TIMING					0x08
 #define I2S_FIFO_SCR				0x0c
 #define I2S_FIFO_SCR_FIFO1_CLR		(1U << 8)
+#define I2S_FIFO_SCR_FIFO2_CLR		(1U << 12)
+#define I2S_FIFO_SCR_FIFO1_COUNT(scr)	(((scr) >> 16) & 0x3f)
+#define I2S_FIFO_SCR_FIFO2_COUNT(scr)	(((scr) >> 24) & 0x3f)
+#define I2S_CTRL_FIFO2_ENABLE		(1U << 28)
+#define I2S_CTRL_FIFO_LPBK_ENABLE	(1U << 26)
+#define I2S_STATUS_FIFO1_RDY		(1U << 31)
+#define I2S_FIFO2					0x80
 #define I2S_FIFO_SCR_ATN_FOUR_SLOTS	0x11	// both FIFOs
 #define I2S_FIFO1					0x40
 #define I2S_DMA_REQUEST				2		// APB DMA requester
@@ -607,6 +617,117 @@ run_self_test(tegra_audio* audio, const char* name)
 }
 
 
+/*!	Bring-up aid: feeds the transmit FIFO of an I2S controller from the CPU,
+	without DMA, and logs how fast it drains (44100 words a second when the
+	controller shifts the data out) and, with the internal loopback, how
+	much of it arrives in the receive FIFO.
+*/
+static void
+run_fifo_test(volatile uint8* i2s, const char* name, bool loopback)
+{
+	uint32 control = I2S_CTRL_MASTER_ENABLE | I2S_CTRL_BIT_FORMAT_I2S
+		| I2S_CTRL_BIT_SIZE_16 | I2S_CTRL_FIFO_FORMAT_PACKED;
+	if (loopback)
+		control |= I2S_CTRL_FIFO_LPBK_ENABLE | I2S_CTRL_FIFO2_ENABLE;
+	write32(i2s, I2S_CTRL, control);
+	write32(i2s, I2S_TIMING, 31);
+	write32(i2s, I2S_FIFO_SCR, I2S_FIFO_SCR_ATN_FOUR_SLOTS
+		| I2S_FIFO_SCR_FIFO1_CLR | I2S_FIFO_SCR_FIFO2_CLR);
+	uint32 clearedScr = read32(i2s, I2S_FIFO_SCR);
+	uint32 clearedStatus = read32(i2s, I2S_STATUS);
+
+	write32(i2s, I2S_CTRL, control | I2S_CTRL_FIFO1_ENABLE);
+
+	// write a word whenever the FIFO takes one, for 50 ms
+	uint32 written = 0;
+	uint32 polls = 0;
+	bigtime_t start = system_time();
+	bigtime_t end = start + 50000;
+	while (system_time() < end) {
+		polls++;
+		if ((read32(i2s, I2S_STATUS) & I2S_STATUS_FIFO1_RDY) != 0) {
+			write32(i2s, I2S_FIFO1, (written & 32) != 0
+				? 0x07d007d0 : 0xf830f830);
+			written++;
+		}
+	}
+	uint32 scr = read32(i2s, I2S_FIFO_SCR);
+	uint32 status = read32(i2s, I2S_STATUS);
+	snooze(10000);
+	uint32 laterScr = read32(i2s, I2S_FIFO_SCR);
+	uint32 received = 0;
+	if (loopback) {
+		while (received < 64 && I2S_FIFO_SCR_FIFO2_COUNT(
+				read32(i2s, I2S_FIFO_SCR)) != 0) {
+			read32(i2s, I2S_FIFO2);
+			received++;
+		}
+	}
+	write32(i2s, I2S_CTRL, control & ~(I2S_CTRL_FIFO_LPBK_ENABLE
+		| I2S_CTRL_FIFO2_ENABLE));
+
+	TRACE_ALWAYS("FIFO test (%s%s): %" B_PRIu32 " words taken in 50 ms (%"
+		B_PRIu32 " polls; about 2205 if it runs), cleared: scr %#" B_PRIx32
+		" status %#" B_PRIx32 "; after: scr %#" B_PRIx32 " status %#" B_PRIx32
+		", 10 ms later scr %#" B_PRIx32 "%s%" B_PRIu32 "\n", name,
+		loopback ? ", loopback" : "", written, polls, clearedScr,
+		clearedStatus, scr, status, laterScr,
+		loopback ? ", received " : "", loopback ? received : 0);
+}
+
+
+/*!	Bring-up aid: does the controller reset and take its clock? Checks
+	both I2S controllers, the second one clocked like the first.
+*/
+static void
+fifo_tests(tegra_audio* audio)
+{
+	TRACE_ALWAYS("CAR: clk enb L %#" B_PRIx32 ", rst L %#" B_PRIx32
+		", I2S1 source %#" B_PRIx32 ", I2S2 source %#" B_PRIx32
+		", PLL A %#" B_PRIx32 ", out %#" B_PRIx32 "\n",
+		read32(audio->car, CAR_CLK_OUT_ENB(0)),
+		read32(audio->car, CAR_RST_DEVICES(0)),
+		read32(audio->car, CAR_CLK_SOURCE_I2S1),
+		read32(audio->car, CAR_CLK_SOURCE_I2S2),
+		read32(audio->car, CAR_PLLA_BASE), read32(audio->car, CAR_PLLA_OUT));
+
+	// a register survives a reset only if the reset does not reach it
+	write32(audio->i2s, I2S_TIMING, 0x123);
+	uint32 before = read32(audio->i2s, I2S_TIMING);
+	set_reset(audio, CLOCK_I2S1, true);
+	spin(10);
+	set_reset(audio, CLOCK_I2S1, false);
+	TRACE_ALWAYS("I2S1 reset: timing %#" B_PRIx32 " -> %#" B_PRIx32
+		", ctrl %#" B_PRIx32 ", status %#" B_PRIx32 ", scr %#" B_PRIx32 "\n",
+		before, read32(audio->i2s, I2S_TIMING), read32(audio->i2s, I2S_CTRL),
+		read32(audio->i2s, I2S_STATUS), read32(audio->i2s, I2S_FIFO_SCR));
+
+	run_fifo_test(audio->i2s, "I2S1", false);
+	run_fifo_test(audio->i2s, "I2S1", true);
+
+	// I2S2 is in the same page, from the same clock
+	volatile uint8* i2s2 = audio->i2s + (I2S2_BASE - I2S1_BASE);
+	set_clock(audio, CLOCK_I2S2, true);
+	write32(audio->car, CAR_CLK_SOURCE_I2S2, (0U << 30) | (2 * (8 - 1)));
+	set_reset(audio, CLOCK_I2S2, true);
+	spin(10);
+	set_reset(audio, CLOCK_I2S2, false);
+	run_fifo_test(i2s2, "I2S2", false);
+	run_fifo_test(i2s2, "I2S2", true);
+	write32(i2s2, I2S_CTRL, 0);
+	set_clock(audio, CLOCK_I2S2, false);
+
+	// I2S1 from the oscillator, 12 MHz / 4
+	uint32 source = read32(audio->car, CAR_CLK_SOURCE_I2S1);
+	write32(audio->car, CAR_CLK_SOURCE_I2S1, (3U << 30) | (2 * (4 - 1)));
+	run_fifo_test(audio->i2s, "I2S1 clk_m", false);
+	write32(audio->car, CAR_CLK_SOURCE_I2S1, source);
+
+	// back to the playback setup
+	setup_i2s(audio);
+}
+
+
 static void
 self_test(tegra_audio* audio)
 {
@@ -633,6 +754,8 @@ self_test(tegra_audio* audio)
 		(read32(audio->car, CAR_RST_DEVICES(CLOCK_APBDMA / 32))
 			& (1U << (CLOCK_APBDMA % 32))) != 0 ? "on" : "off");
 
+	fifo_tests(audio);
+
 	if (run_self_test(audio, "PLL A") == 0) {
 		// Does the I2S run at all? Clock it from the oscillator (clk_m,
 		// 12 MHz divided by 4) instead of PLL A for a moment.
