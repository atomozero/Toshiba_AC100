From 69f29ef8fc25c6b37a1cc2092a92041277467c49 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 17:36:18 +0200
Subject: [PATCH 025/270] ARM bring-up: check the kernel code pages against the
 kernel file (not for merging)

---
 .../private/kernel/arch/arm/arm_boot_marker.h | 10 ++-
 src/system/kernel/arch/arm/arch_cpu.cpp       | 74 +++++++++++++++++++
 src/system/kernel/debug/debug.cpp             |  1 +
 3 files changed, 82 insertions(+), 3 deletions(-)

diff --git a/headers/private/kernel/arch/arm/arm_boot_marker.h b/headers/private/kernel/arch/arm/arm_boot_marker.h
index 620e1dde6a..c83fa90124 100644
--- a/headers/private/kernel/arch/arm/arm_boot_marker.h
+++ b/headers/private/kernel/arch/arm/arm_boot_marker.h
@@ -89,6 +89,9 @@ arm_boot_marker_draw_value(uint8* frameBuffer, uint32 bytesPerRow,
 	if (frameBuffer == NULL)
 		return;
 
+	// rows from 100 on go into further columns to the right
+	int left = kLeft + (row / 100) * 220;
+	row %= 100;
 	int top = 40 + row * kLineHeight;
 	int width = 30 + 8 * 6 * kScale + 8;
 	int color = (row + 4) % 7;
@@ -96,10 +99,10 @@ arm_boot_marker_draw_value(uint8* frameBuffer, uint32 bytesPerRow,
 
 	for (int y = top - 4; y < top + 7 * kScale + 4; y++) {
 		uint8* line = frameBuffer + y * bytesPerRow;
-		for (int x = kLeft - 4; x < kLeft + width; x++) {
-			bool square = x < kLeft + 18 && y >= top && y < top + 18;
+		for (int x = left - 4; x < left + width; x++) {
+			bool square = x < left + 18 && y >= top && y < top + 18;
 			bool pixel = false;
-			int digitX = x - (kLeft + 30);
+			int digitX = x - (left + 30);
 			int digitY = y - top;
 			if (!square && digitX >= 0 && digitX < 8 * 6 * kScale && digitY >= 0
 				&& digitY < 7 * kScale) {
@@ -124,6 +127,7 @@ arm_boot_marker_draw_value(uint8* frameBuffer, uint32 bytesPerRow,
 void arm_boot_marker(int index);
 void arm_boot_marker_value(int row, uint32 value);
 void arm_boot_marker_text(const char* text);
+void arm_boot_check_text(int row);
 #endif
 
 
diff --git a/src/system/kernel/arch/arm/arch_cpu.cpp b/src/system/kernel/arch/arm/arch_cpu.cpp
index 02537653d3..4bcb2c6675 100644
--- a/src/system/kernel/arch/arm/arch_cpu.cpp
+++ b/src/system/kernel/arch/arm/arch_cpu.cpp
@@ -21,6 +21,17 @@
 bool gARMHasVFPD32 = true;
 
 
+/*!	Checksums of the kernel's read-only segment, one per page, filled in from
+	the kernel file on the build host (not by the build itself).
+*/
+extern "C" struct {
+	uint32	magic;
+	uint32	base;
+	uint32	words;
+	uint32	sums[1024];
+} gArmTextCheck = { 0x7e57c0de, 0, 0, { 0 } };
+
+
 static uint8* sBootMarkerFrameBuffer;
 static uint32 sBootMarkerBytesPerRow;
 static uint32 sBootMarkerDepth;
@@ -86,6 +97,68 @@ arm_boot_marker_text(const char* text)
 }
 
 
+static uint32
+arm_virtual_to_physical(addr_t address)
+{
+	uint32 par;
+	asm volatile ("mcr p15, 0, %1, c7, c8, 0\n"	// ATS1CPR
+		"isb\n"
+		"mrc p15, 0, %0, c7, c4, 0"
+		: "=r" (par) : "r" (address));
+	if ((par & 1) != 0)
+		return 0xfa000000 | (par & 0xfff);
+	return (par & 0xfffff000) | (address & 0xfff);
+}
+
+
+extern "C" void __udivsi3();
+
+
+/*!	Compares the kernel's code pages with the checksums of the kernel file and
+	shows: number of bad pages (0xc0de....), first bad page, its physical
+	address, its checksum, the expected one and the first word of __udivsi3.
+*/
+void
+arm_boot_check_text(int row)
+{
+	uint32 bad = 0;
+	uint32 firstBad = 0;
+	uint32 firstSum = 0;
+	uint32 firstExpected = 0;
+	if (gArmTextCheck.base != 0) {
+		const uint32* words = (const uint32*)(addr_t)gArmTextCheck.base;
+		uint32 pages = (gArmTextCheck.words + 1023) / 1024;
+		for (uint32 page = 0; page < pages && page < 1024; page++) {
+			uint32 expected = gArmTextCheck.sums[page];
+			if (expected == 0)
+				continue;
+			uint32 sum = 0;
+			uint32 end = min_c(gArmTextCheck.words, (page + 1) * 1024);
+			for (uint32 i = page * 1024; i < end; i++)
+				sum = ((sum << 1) | (sum >> 31)) ^ words[i];
+			if (sum != expected) {
+				if (bad++ == 0) {
+					firstBad = gArmTextCheck.base + page * B_PAGE_SIZE;
+					firstSum = sum;
+					firstExpected = expected;
+				}
+			}
+		}
+	}
+
+	arm_boot_marker_value(row, (gArmTextCheck.base != 0 ? 0xc0de0000 : 0xdead0000)
+		| (bad & 0xffff));
+	arm_boot_marker_value(row + 1, firstBad);
+	arm_boot_marker_value(row + 2,
+		firstBad != 0 ? arm_virtual_to_physical(firstBad) : 0);
+	arm_boot_marker_value(row + 3, firstSum);
+	arm_boot_marker_value(row + 4, firstExpected);
+	arm_boot_marker_value(row + 5, *(volatile uint32*)(addr_t)&__udivsi3);
+	arm_boot_marker_value(row + 6,
+		arm_virtual_to_physical((addr_t)&__udivsi3));
+}
+
+
 status_t
 arch_cpu_preboot_init_percpu(kernel_args *args, int curr_cpu)
 {
@@ -97,6 +170,7 @@ arch_cpu_preboot_init_percpu(kernel_args *args, int curr_cpu)
 			sBootMarkerDepth = args->frame_buffer.depth;
 		}
 		arm_boot_marker(6);
+		arm_boot_check_text(103);
 
 		// MVFR0[3:0]: 1 = 16 double registers (e.g. Tegra 2), 2 = 32
 		gARMHasVFPD32 = (arm_get_mvfr0() & 0xf) == 2;
diff --git a/src/system/kernel/debug/debug.cpp b/src/system/kernel/debug/debug.cpp
index 46f34b85c3..6f965dd57f 100644
--- a/src/system/kernel/debug/debug.cpp
+++ b/src/system/kernel/debug/debug.cpp
@@ -2139,6 +2139,7 @@ panic(const char* format, ...)
 		if (!sPanicShown) {
 			sPanicShown = true;
 			arm_boot_marker(34);
+			arm_boot_check_text(203);
 			arm_boot_marker_value(3,
 				(uint32)(addr_t)__builtin_return_address(0));
 
