From b5e7baacef8e942f4728e257199d696f75297ef4 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 24 Oct 2026 01:17:02 +0200
Subject: [PATCH 195/203] libroot: uname() reports RenkuOS as the system name

---
 src/system/libroot/posix/sys/uname.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/system/libroot/posix/sys/uname.c b/src/system/libroot/posix/sys/uname.c
index 1dd0decf6f..352bec8ff9 100644
--- a/src/system/libroot/posix/sys/uname.c
+++ b/src/system/libroot/posix/sys/uname.c
@@ -36,7 +36,7 @@ uname(struct utsname *info)
 
 	get_system_info(&systemInfo);
 
-	strlcpy(info->sysname, "Haiku", sizeof(info->sysname));
+	strlcpy(info->sysname, "RenkuOS", sizeof(info->sysname));
 
 	haikuRevision = __get_haiku_revision();
 	if (haikuRevision[0] != '\0')
