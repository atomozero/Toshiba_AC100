From 101c2811a46ac64f57bd5c916a4999e8e2efe114 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 20 Oct 2026 07:38:58 +0200
Subject: [PATCH 161/203] kernel/arm: keep a page modified when its mapping
 becomes read-only

ARM has no dirty bit, so a page counts as modified while it is mapped
writable. Protect() made such a page read-only without recording that it
had been written, so it looked clean afterwards.
---
 .../arm/paging/32bit/ARMVMTranslationMap32Bit.cpp   | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp b/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
index f0573f8413..f2e170fd32 100644
--- a/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
+++ b/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
@@ -580,6 +580,19 @@ ARMVMTranslationMap32Bit::Protect(addr_t start, addr_t end, uint32 attributes,
 				entry = oldEntry;
 			}
 
+			// There is no dirty bit: a page counts as modified as long as it
+			// is mapped writable (AP[2] clear). When it becomes read-only,
+			// keep that in the page, or it would look clean afterwards and
+			// could be dropped, like the relocated data of a library that is
+			// made read-only once relocated.
+			if ((oldEntry & ARM_MMU_L2_FLAG_AP2) == 0
+				&& (newProtectionFlags & ARM_MMU_L2_FLAG_AP2) != 0) {
+				vm_page* page = vm_lookup_page(
+					(oldEntry & ARM_PTE_ADDRESS_MASK) / B_PAGE_SIZE);
+				if (page != NULL)
+					page->modified = true;
+			}
+
 			if ((oldEntry & ARM_MMU_L2_FLAG_AP0) != 0) {
 				// Note, that we only need to invalidate the address, if the
 				// accessed flag was set, since only then the entry could have
