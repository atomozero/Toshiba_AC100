+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef _TEGRA20_CPUFREQ_H
+#define _TEGRA20_CPUFREQ_H
+
+
+#include <cpufreq.h>
+
+
+#define TEGRA20_CPUFREQ_MODULE_NAME	CPUFREQ_MODULES_PREFIX "/tegra20_cpufreq/v1"
+
+
+/*!	The cpufreq module of the NVIDIA Tegra 2. Besides the hooks the kernel
+	calls, it lets a driver (tegra_dvfs) choose an operating point by hand
+	and describe the state, for testing and measuring.
+*/
+typedef struct tegra20_cpufreq_module_info {
+	cpufreq_module_info	info;
+
+	/*!	Runs the CPUs at \a mhz, one of the rates of the table, at the
+		voltage the table gives this chip for it. */
+	status_t			(*set_frequency)(uint32 mhz);
+	//!	The rate the CPUs run at, in MHz.
+	uint32				(*frequency)(void);
+	//!	The operating points and the current one, as text.
+	size_t				(*describe)(char* buffer, size_t size);
+} tegra20_cpufreq_module_info;
+
+
+#endif	// _TEGRA20_CPUFREQ_H
