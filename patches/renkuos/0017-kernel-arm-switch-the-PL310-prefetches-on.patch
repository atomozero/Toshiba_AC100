From b68624372b47143b9ae3d12557c87b2cadd894ac Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Thu, 19 Nov 2026 23:47:34 +0100
Subject: [PATCH 17/32] kernel/arm: switch the PL310 prefetches on

The L2 cache ran without its instruction and data prefetches, kept off
for errata of early revisions. Those of the r2p0 of the Tegra 2 do not
concern prefetching, and Linux has them on there. "arm_l2_prefetch
false" in the kernel settings leaves them off.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/system/kernel/arch/arm/arch_l2_cache.cpp | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/src/system/kernel/arch/arm/arch_l2_cache.cpp b/src/system/kernel/arch/arm/arch_l2_cache.cpp
index b564488f87..2ac34b770f 100644
--- a/src/system/kernel/arch/arm/arch_l2_cache.cpp
+++ b/src/system/kernel/arch/arm/arch_l2_cache.cpp
@@ -69,6 +69,8 @@ arm_l2_cache_init(kernel_args* args)
 	void* settings = load_driver_settings("kernel");
 	bool enable = get_driver_boolean_parameter(settings, "arm_l2_cache", false,
 		true);
+	bool prefetch = get_driver_boolean_parameter(settings, "arm_l2_prefetch",
+		true, true);
 	unload_driver_settings(settings);
 
 	void* address;
@@ -92,10 +94,15 @@ arm_l2_cache_init(kernel_args* args)
 
 	// the latencies and the auxiliary control may only be set while it is off;
 	// all memory is shareable (for SMP), which older revisions would not cache
-	// without the override; no prefetching (errata on early revisions)
-	write_reg(l2, L2X0_AUX_CTRL, (read_reg(l2, L2X0_AUX_CTRL)
-		| L2X0_AUX_SHARED_OVERRIDE)
-		& ~(L2X0_AUX_INSTRUCTION_PREFETCH | L2X0_AUX_DATA_PREFETCH));
+	// without the override. The instruction and data prefetches are on, as
+	// Linux has them on the Tegra 2 (r2p0); "arm_l2_prefetch false" leaves
+	// them off.
+	uint32 aux = read_reg(l2, L2X0_AUX_CTRL) | L2X0_AUX_SHARED_OVERRIDE;
+	if (prefetch)
+		aux |= L2X0_AUX_INSTRUCTION_PREFETCH | L2X0_AUX_DATA_PREFETCH;
+	else
+		aux &= ~(L2X0_AUX_INSTRUCTION_PREFETCH | L2X0_AUX_DATA_PREFETCH);
+	write_reg(l2, L2X0_AUX_CTRL, aux);
 	if (args->arch_args.l2TagLatency != 0)
 		write_reg(l2, L2X0_TAG_LATENCY, args->arch_args.l2TagLatency);
 	if (args->arch_args.l2DataLatency != 0)
