From 9393b240541daab0f4742b78fcb988629c8b9c5c Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 25 Oct 2026 15:50:22 +0100
Subject: [PATCH 221/270] sdhci: do not probe an empty Tegra slot

The card detection of Tegra 2 slots is a GPIO, which the driver read and
logged but then ignored, taking a card as present. An empty slot was
probed anyway: a second for CMD1 and a series of CMD55 timeouts on every
boot.

A new quirk, cardAbsent, says the card detect found the slot empty when
the controller was set up: the slot is then never scanned, and no card
insertion interrupt is enabled. The controller is still set up, as
failing its initialization would also stop the device manager from
probing the controllers after it. Insertion is still not watched, as
before.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/busses/mmc/sdhci.cpp     |  4 +++-
 src/add-ons/kernel/busses/mmc/sdhci.h       |  3 +++
 src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp | 11 ++++++++---
 3 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/src/add-ons/kernel/busses/mmc/sdhci.cpp b/src/add-ons/kernel/busses/mmc/sdhci.cpp
index db35f587fd..7e5dabcb57 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci.cpp
+++ b/src/add-ons/kernel/busses/mmc/sdhci.cpp
@@ -725,6 +725,8 @@ SdhciBus::_IsEmbeddedSlot()
 bool
 SdhciBus::_IsCardPresent()
 {
+	if (fQuirks.cardAbsent)
+		return false;
 	return _IsEmbeddedSlot() || fRegisters->present_state.IsCardInserted();
 }
 
@@ -1815,7 +1817,7 @@ SdhciBus::SetScanSemaphore(sem_id sem)
 	// We can now enable the card insertion interrupt for next time a card
 	// is inserted. Not for an embedded slot: insertion and removal events
 	// mean nothing there, and acting on them only disturbs the device.
-	if (!_IsEmbeddedSlot())
+	if (!_IsEmbeddedSlot() && !fQuirks.cardAbsent)
 		EnableInterrupts(SDHCI_INT_CARD_INS);
 }
 
diff --git a/src/add-ons/kernel/busses/mmc/sdhci.h b/src/add-ons/kernel/busses/mmc/sdhci.h
index 735866590a..cf48d510b0 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci.h
+++ b/src/add-ons/kernel/busses/mmc/sdhci.h
@@ -74,6 +74,9 @@ struct SdhciQuirks {
 	// the controller's card detect line is not used (card detect through a
 	// GPIO, or non removable device): take the card as always present
 	bool	forceCardPresent;
+	// the card detect (a GPIO) said the slot is empty when the controller
+	// was set up: do not probe it, which only times out
+	bool	cardAbsent;
 	// the transfer mode and command registers must be written together, in
 	// one 32 bit access
 	bool	combinedCommandWrite;
diff --git a/src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp b/src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp
index f6ca39c8d7..f113ace83c 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp
+++ b/src/add-ons/kernel/busses/mmc/sdhci_fdt.cpp
@@ -247,15 +247,20 @@ tegra20_init(fdt_device_module_info* module, fdt_device* dev,
 	quirks.noHighSpeedBit = true;
 
 	// Card detection is done through a GPIO on Tegra, not by the controller.
-	// TODO: use the "cd-gpios" GPIO for insertion and removal instead of
-	// assuming a card is present.
+	// An empty slot is not probed, which only times out and costs the boot a
+	// second or two. The controller is still set up: failing here would also
+	// stop the device manager from probing the controllers after it, among
+	// them the eMMC. Insertion is not watched, so a card put in later is only
+	// seen after a reboot.
+	// TODO: use the "cd-gpios" GPIO for insertion and removal.
+	quirks.forceCardPresent = true;
 	bool cardPresent;
 	if (tegra20_gpio(module, dev, "cd-gpios", false, false, &cardPresent)
 			== B_OK) {
 		TRACE_ALWAYS("Tegra %#" B_PRIx64 ": card detect says %s\n", regBase,
 			cardPresent ? "inserted" : "not inserted");
+		quirks.cardAbsent = !cardPresent;
 	}
-	quirks.forceCardPresent = true;
 	return B_OK;
 }
 
