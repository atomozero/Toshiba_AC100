From 9ba11aba37230d552ff7c7d65d30d9a500adb3a6 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 17:40:33 +0200
Subject: [PATCH 106/203] kernel/arm: an access flag fault on an unmapped page
 is a page fault

With several CPUs another one may unmap the page between the walk that
faulted and the look up of the handler: let vm_page_fault() map it again
instead of panicking.
---
 src/system/kernel/arch/arm/arch_int.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/system/kernel/arch/arm/arch_int.cpp b/src/system/kernel/arch/arm/arch_int.cpp
index 4f6e334105..ec4718460c 100644
--- a/src/system/kernel/arch/arm/arch_int.cpp
+++ b/src/system/kernel/arch/arm/arch_int.cpp
@@ -439,6 +439,8 @@ arch_arm_handle_access_flag_fault(addr_t far, uint32 fsr, bool isWrite, bool isE
 
 		map->QueryInterrupt(far, &physAddr, &pageFlags);
 
+		// another CPU may have unmapped the page meanwhile: then it is an
+		// ordinary page fault
 		if ((PAGE_PRESENT & pageFlags) == 0)
 			return false;
 
@@ -563,8 +565,6 @@ arch_arm_page_fault(struct iframe *frame, addr_t far, uint32 fsr, bool isWrite,
 			far);
 	} else if (!isExec && ((fsr & 0x060f) == FSR_FS_ALIGNMENT_FAULT)) {
 		panic("unhandled alignment exception\n");
-	} else if ((fsr & 0x060f) == FSR_FS_ACCESS_FLAG_FAULT) {
-		panic("unhandled access flag fault\n");
 	} else if ((frame->spsr & CPSR_I) != 0) {
 		// interrupts disabled
 
