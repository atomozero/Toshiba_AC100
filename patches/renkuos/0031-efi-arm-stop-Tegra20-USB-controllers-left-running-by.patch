From 2a03e15176db415cd68332fd2aba6c7c913a233a Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 18:22:55 +0200
Subject: [PATCH 031/203] efi/arm: stop Tegra20 USB controllers left running by
 the firmware (bring-up)

---
 .../boot/platform/efi/arch/arm/arch_dtb.cpp   | 88 +++++++++++++++++++
 .../boot/platform/efi/arch/arm/arch_start.cpp |  2 +
 src/system/kernel/arch/arm/arch_cpu.cpp       |  2 +
 3 files changed, 92 insertions(+)

diff --git a/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp b/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
index aa4e4afcbe..504d471108 100644
--- a/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
+++ b/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
@@ -53,6 +53,12 @@ static bool sHasTWD = false;
 // bring-up aid: the outer cache controller, if any
 static addr_range sL2Regs;
 
+// Tegra20 USB controllers and the clock and reset controller, to stop any
+// controller the firmware left running before the kernel takes over memory
+static addr_range sTegraUSBRegs[3];
+static uint32 sTegraUSBCount;
+static addr_range sTegraCARRegs;
+
 
 /*!	The TWD runs at PERIPHCLK, whose rate the device tree usually doesn't
 	describe, so measure it against the firmware's Stall().
@@ -126,6 +132,15 @@ arch_handle_fdt(const void* fdt, int node)
 		sHasTWD = true;
 	}
 
+	if (sTegraUSBCount < B_COUNT_OF(sTegraUSBRegs)
+		&& dtb_has_fdt_string(compatible, compatibleLen, "nvidia,tegra20-ehci")) {
+		dtb_get_reg(fdt, node, 0, sTegraUSBRegs[sTegraUSBCount++]);
+	}
+	if (sTegraCARRegs.start == 0
+		&& dtb_has_fdt_string(compatible, compatibleLen, "nvidia,tegra20-car")) {
+		dtb_get_reg(fdt, node, 0, sTegraCARRegs);
+	}
+
 	if (sL2Regs.start == 0 && dtb_has_fdt_string(compatible, compatibleLen,
 			"arm,pl310-cache")) {
 		dtb_get_reg(fdt, node, 0, sL2Regs);
@@ -148,6 +163,79 @@ arch_handle_fdt(const void* fdt, int node)
 }
 
 
+/*!	Stops the Tegra20 USB controllers the firmware left running: an active
+	controller keeps writing transfer descriptors into memory the kernel will
+	reuse. Records one byte per controller in bootDebug[6] (bit 0 run, bit 4
+	periodic, bit 5 async schedule, bits 6-7 USBMODE.CM; 0xff if its clock is
+	off or it is held in reset) and the status after stopping in bootDebug[7].
+	Must be called while the boot services are still available.
+*/
+void
+arch_quiesce_usb(void)
+{
+	// clock enable bit / reset bit per controller (USBD, USB2, USB3)
+	static const struct {
+		uint32 base;
+		uint32 enableRegister;
+		uint32 resetRegister;
+		uint32 bit;
+	} kClocks[] = {
+		{ 0xc5000000, 0x10, 0x04, 22 },
+		{ 0xc5004000, 0x14, 0x08, 26 },
+		{ 0xc5008000, 0x14, 0x08, 27 },
+	};
+
+	uint32* debug = gKernelArgs.arch_args.bootDebug;
+	debug[6] = 0xffffffff;
+	debug[7] = 0;
+	if (sTegraCARRegs.start == 0)
+		return;
+
+	for (uint32 i = 0; i < sTegraUSBCount; i++) {
+		addr_t base = (addr_t)sTegraUSBRegs[i].start;
+		uint32 slot = 3;
+		for (uint32 j = 0; j < B_COUNT_OF(kClocks); j++) {
+			if (kClocks[j].base == base)
+				slot = j;
+		}
+		if (slot == 3)
+			continue;
+
+		addr_t car = (addr_t)sTegraCARRegs.start;
+		uint32 enabled = *(volatile uint32*)(car + kClocks[slot].enableRegister);
+		uint32 reset = *(volatile uint32*)(car + kClocks[slot].resetRegister);
+		uint32 mask = 1U << kClocks[slot].bit;
+		if ((enabled & mask) == 0 || (reset & mask) != 0) {
+			dprintf("USB %#lx: clock off or in reset\n", base);
+			continue;
+		}
+
+		addr_t capabilities = base + 0x100;
+		addr_t operational = capabilities
+			+ (*(volatile uint32*)capabilities & 0xff);
+		volatile uint32* command = (volatile uint32*)operational;
+		volatile uint32* status = (volatile uint32*)(operational + 4);
+		// Tegra20 keeps USBMODE at 0x1f8, not at the standard 0x1a8
+		uint32 mode = *(volatile uint32*)(base + 0x1f8) & 3;
+		uint32 state = (*command & 0x31) | (mode << 6);
+		debug[6] = (debug[6] & ~(0xffU << (slot * 8))) | (state << (slot * 8));
+
+		dprintf("USB %#lx: USBCMD %#" B_PRIx32 ", USBSTS %#" B_PRIx32
+			", mode %" B_PRIu32 "\n", base, *command, *status, mode);
+
+		// stop the schedules, then the controller
+		*command &= ~0x30U;
+		for (int k = 0; k < 100 && (*status & 0xc000) != 0; k++)
+			kBootServices->Stall(20);
+		*command &= ~1U;
+		for (int k = 0; k < 100 && (*status & 0x1000) == 0; k++)
+			kBootServices->Stall(20);
+		debug[7] |= (*status & 0xf000) >> (12 - slot * 4);
+		dprintf("USB %#lx: stopped, USBSTS %#" B_PRIx32 "\n", base, *status);
+	}
+}
+
+
 void
 arch_dtb_set_kernel_args(void)
 {
diff --git a/src/system/boot/platform/efi/arch/arm/arch_start.cpp b/src/system/boot/platform/efi/arch/arm/arch_start.cpp
index 881dd69795..586fdafbc1 100644
--- a/src/system/boot/platform/efi/arch/arm/arch_start.cpp
+++ b/src/system/boot/platform/efi/arch/arm/arch_start.cpp
@@ -28,6 +28,7 @@
 
 
 extern "C" void clean_dcache_all(void);
+extern void arch_quiesce_usb(void);
 
 
 #include <arch/arm/arm_boot_marker.h>
@@ -196,6 +197,7 @@ arch_start_kernel(addr_t kernelEntry)
 	// entry.
 
 	loader_marker(1);
+	arch_quiesce_usb();
 	dprintf("frame buffer: phys %#" B_PRIx64 ", size %#" B_PRIx64 ", %" B_PRIu32
 		"x%" B_PRIu32 "x%" B_PRIu32 "\n",
 		(uint64)gKernelArgs.frame_buffer.physical_buffer.start,
diff --git a/src/system/kernel/arch/arm/arch_cpu.cpp b/src/system/kernel/arch/arm/arch_cpu.cpp
index f4f4165817..eac9b4b83d 100644
--- a/src/system/kernel/arch/arm/arch_cpu.cpp
+++ b/src/system/kernel/arch/arm/arch_cpu.cpp
@@ -185,6 +185,8 @@ arch_cpu_preboot_init_percpu(kernel_args *args, int curr_cpu)
 			(uint32)args->frame_buffer.physical_buffer.start);
 		arm_boot_marker_value(213,
 			arm_virtual_to_physical(args->cpu_kstack[0].start));
+		arm_boot_marker_value(102, debug[6]);	// USB controllers found running
+		arm_boot_marker_value(202, debug[7]);	// their status once stopped
 		uint32 actlr;
 		asm volatile ("mrc p15, 0, %0, c1, c0, 1" : "=r" (actlr));
 		arm_boot_marker_value(313, actlr);
