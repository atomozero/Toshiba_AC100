From d74ef12b3c5d67e58edee5794f9ebca9c44864c5 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 22:27:42 +0200
Subject: [PATCH 119/203] kernel/arm: invalidate the TLBs and instruction
 caches of all CPUs

The kernel invalidated only the TLB of the current CPU when kernel
mappings changed, and relied on ICIs for the others; early during boot the
other CPUs ignore ICIs, so they kept stale translations. On the AC100 the
second CPU then hung when the boot CPU first had it run code
(call_all_cpus_sync()), depending on timing: with the L2 cache or the new
memcpy() it always did.

Use the inner shareable (broadcast) operations for the global, range and
list TLB invalidations and for the instruction cache and branch predictor;
only the switch of page tables keeps invalidating the current CPU's TLB.
---
 headers/private/kernel/arch/arm/arch_cpu.h |  1 +
 src/system/kernel/arch/arm/arch_cpu.cpp    | 40 +++++++++++++++-------
 src/system/kernel/arch/arm/arch_thread.cpp |  3 +-
 3 files changed, 31 insertions(+), 13 deletions(-)

diff --git a/headers/private/kernel/arch/arm/arch_cpu.h b/headers/private/kernel/arch/arm/arch_cpu.h
index 402865c764..7641264199 100644
--- a/headers/private/kernel/arch/arm/arch_cpu.h
+++ b/headers/private/kernel/arch/arm/arch_cpu.h
@@ -147,6 +147,7 @@ arm_clean_dcache_range(const void* address, size_t size)
 
 void arch_cpu_invalidate_TLB_page(addr_t page);
 void arm_sync_icache_all(void);
+void arm_local_tlb_invalidate(void);
 void arm_clean_invalidate_dcache_all(void);
 
 // The outer (level 2) cache is not reached by the CP15 cache maintenance
diff --git a/src/system/kernel/arch/arm/arch_cpu.cpp b/src/system/kernel/arch/arm/arch_cpu.cpp
index 1c503361ef..3d4455a2ba 100644
--- a/src/system/kernel/arch/arm/arch_cpu.cpp
+++ b/src/system/kernel/arch/arm/arch_cpu.cpp
@@ -166,9 +166,9 @@ arm_sync_icache_all(void)
 	}
 	dsb();
 
-	// ICIALLU and BPIALL
-	asm volatile ("mcr p15, 0, %0, c7, c5, 0" : : "r" (0) : "memory");
-	asm volatile ("mcr p15, 0, %0, c7, c5, 6" : : "r" (0) : "memory");
+	// ICIALLUIS and BPIALLIS: the code may run on any CPU
+	asm volatile ("mcr p15, 0, %0, c7, c1, 0" : : "r" (0) : "memory");
+	asm volatile ("mcr p15, 0, %0, c7, c1, 6" : : "r" (0) : "memory");
 	dsb();
 	isb();
 }
@@ -232,10 +232,11 @@ arch_cpu_invalidate_tlb_range(intptr_t, addr_t start, addr_t end)
 	// ensure visibility of the update to translation table walks
 	dsb();
 
-	// TLBIMVAA: by address for all ASIDs, user mappings are not global
+	// TLBIMVAAIS: by address for all ASIDs (user mappings are not global),
+	// on all CPUs (early during boot the others ignore the ICIs)
 	int32 num_pages = end / B_PAGE_SIZE - start / B_PAGE_SIZE;
 	while (num_pages-- >= 0) {
-		asm volatile ("mcr p15, 0, %[c8format], c8, c7, 3"
+		asm volatile ("mcr p15, 0, %[c8format], c8, c3, 3"
 			: : [c8format] "r" (start) );
 		start += B_PAGE_SIZE;
 	}
@@ -252,9 +253,10 @@ arch_cpu_invalidate_tlb_list(intptr_t, addr_t pages[], int num_pages)
 	// ensure visibility of the update to translation table walks
 	dsb();
 
-	// TLBIMVAA: by address for all ASIDs, user mappings are not global
+	// TLBIMVAAIS: by address for all ASIDs (user mappings are not global),
+	// on all CPUs (early during boot the others ignore the ICIs)
 	for (int i = 0; i < num_pages; i++) {
-		asm volatile ("mcr p15, 0, %[c8format], c8, c7, 3":
+		asm volatile ("mcr p15, 0, %[c8format], c8, c3, 3":
 			: [c8format] "r" (pages[i]) );
 	}
 
@@ -264,15 +266,17 @@ arch_cpu_invalidate_tlb_list(intptr_t, addr_t pages[], int num_pages)
 }
 
 
+/*!	Drops all TLB entries of all CPUs (TLBIALLIS): the other CPUs may hold
+	translations of kernel mappings that changed, e.g. while they wait for
+	the boot CPU early during boot, ignoring the ICIs.
+*/
 void
 arch_cpu_global_tlb_invalidate(void)
 {
 	// ensure visibility of the update to translation table walks
 	dsb();
 
-	uint32 Rd = 0;
-	asm volatile ("mcr p15, 0, %[c8format], c8, c7, 0"
-		: : [c8format] "r" (Rd) );
+	asm volatile ("mcr p15, 0, %0, c8, c3, 0" : : "r" (0) : "memory");
 
 	// ensure completion of TLB invalidation
 	dsb();
@@ -280,9 +284,21 @@ arch_cpu_global_tlb_invalidate(void)
 }
 
 
+/*!	Drops all TLB entries of the current CPU only (TLBIALL). */
+void
+arm_local_tlb_invalidate(void)
+{
+	dsb();
+	asm volatile ("mcr p15, 0, %0, c8, c7, 0" : : "r" (0) : "memory");
+	dsb();
+	isb();
+}
+
+
 void
 arch_cpu_user_tlb_invalidate(intptr_t)
 {
-	// User mappings are not tagged with an ASID, so drop all TLB entries
-	arch_cpu_global_tlb_invalidate();
+	// User mappings are not tagged with an ASID, so drop all TLB entries;
+	// every CPU running the address space gets this through an ICI
+	arm_local_tlb_invalidate();
 }
diff --git a/src/system/kernel/arch/arm/arch_thread.cpp b/src/system/kernel/arch/arm/arch_thread.cpp
index 33fd83d3a7..91c9a5fb27 100644
--- a/src/system/kernel/arch/arm/arch_thread.cpp
+++ b/src/system/kernel/arch/arm/arch_thread.cpp
@@ -141,7 +141,8 @@ arm_swap_pgdir(uint32_t pageDirectoryAddress)
 	arm_set_ttbr0(pageDirectoryAddress | 0x5b);
 	isb();
 
-	arch_cpu_global_tlb_invalidate();
+	// only this CPU switches to the new page tables
+	arm_local_tlb_invalidate();
 
 	//TODO: update Context ID (incl. ASID)
 	//TODO: check if any additional TLB or Cache maintenance is needed
