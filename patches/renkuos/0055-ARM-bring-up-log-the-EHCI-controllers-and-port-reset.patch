From 06ef9761155363659032ea9c4cc47e397fae4b52 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 22:35:56 +0200
Subject: [PATCH 055/270] ARM bring-up: log the EHCI controllers and port
 resets, fix USBMODE offset in the loader dump (not for merging)

---
 src/add-ons/kernel/busses/usb/ehci.cpp             | 4 ++++
 src/system/boot/platform/efi/arch/arm/arch_dtb.cpp | 3 +--
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/add-ons/kernel/busses/usb/ehci.cpp b/src/add-ons/kernel/busses/usb/ehci.cpp
index b1f82b382b..0e56bdde3a 100644
--- a/src/add-ons/kernel/busses/usb/ehci.cpp
+++ b/src/add-ons/kernel/busses/usb/ehci.cpp
@@ -195,6 +195,8 @@ init_device(device_node* node, void** device_cookie)
 		}
 
 		bus->is_fdt = true;
+		dprintf("AC100: ehci FDT controller at %#" B_PRIx64 ", irq %" B_PRIu64
+			"\n", registers, irq);
 		bus->registers = registers;
 		bus->registers_size = registersSize;
 		bus->capability_offset = kFDTControllers[index].capability_offset;
@@ -1922,6 +1924,8 @@ EHCI::ResetPort(uint8 index)
 		fStack->TriggerExplore();
 	}
 
+	dprintf("AC100: ehci %p port %d reset, PORTSC %#" B_PRIx32 "\n",
+		fOperationalRegisters, index, ReadOpReg(portRegister));
 	fPortResetChange |= (1 << index);
 	return B_OK;
 }
diff --git a/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp b/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
index 504d471108..e276bf8a92 100644
--- a/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
+++ b/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
@@ -215,8 +215,7 @@ arch_quiesce_usb(void)
 			+ (*(volatile uint32*)capabilities & 0xff);
 		volatile uint32* command = (volatile uint32*)operational;
 		volatile uint32* status = (volatile uint32*)(operational + 4);
-		// Tegra20 keeps USBMODE at 0x1f8, not at the standard 0x1a8
-		uint32 mode = *(volatile uint32*)(base + 0x1f8) & 3;
+		uint32 mode = *(volatile uint32*)(operational + 0x68) & 3;
 		uint32 state = (*command & 0x31) | (mode << 6);
 		debug[6] = (debug[6] & ~(0xffU << (slot * 8))) | (state << (slot * 8));
 
