From 4bc9f8d9adc4488882bda9831903cdb848aa1fba Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 25 Oct 2026 23:05:07 +0100
Subject: [PATCH 246/270] app_server, BBitmap: let clients reach overlay
 buffers in their own team

The buffer address app_server put in the overlay client data is only
valid in app_server. When the overlay buffer lies in a cloneable area,
app_server now also passes the area and the buffer's offset in it, and
BBitmap::Bits() returns the address in a clone of that area, made once
per buffer and deleted with the bitmap. Accelerants whose buffers are
not cloneable keep the old behavior.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 headers/private/interface/BitmapPrivate.h | 11 +++++++
 src/kits/interface/Bitmap.cpp             | 35 ++++++++++++++++++++++-
 src/servers/app/drawing/Overlay.cpp       | 27 ++++++++++++++++-
 src/servers/app/drawing/Overlay.h         |  1 +
 4 files changed, 72 insertions(+), 2 deletions(-)

diff --git a/headers/private/interface/BitmapPrivate.h b/headers/private/interface/BitmapPrivate.h
index 0ae3abe167..65e24383e3 100644
--- a/headers/private/interface/BitmapPrivate.h
+++ b/headers/private/interface/BitmapPrivate.h
@@ -15,6 +15,17 @@
 struct overlay_client_data {
 	sem_id	lock;
 	uint8*	buffer;
+		// the app_server address of the buffer
+
+	area_id	area;
+	size_t	offset;
+		// the cloneable area of the buffer, and the buffer's offset in it;
+		// the area is -1 when the accelerant does not give one
+
+	area_id	client_area;
+	area_id	client_source;
+	uint8*	client_base;
+		// only the client uses these: its clone of the area
 };
 
 
diff --git a/src/kits/interface/Bitmap.cpp b/src/kits/interface/Bitmap.cpp
index 04b6ba8a75..59883a3206 100644
--- a/src/kits/interface/Bitmap.cpp
+++ b/src/kits/interface/Bitmap.cpp
@@ -492,6 +492,32 @@ BBitmap::IsValid() const
 }
 
 
+/*!	Returns the client's address of an overlay buffer: a clone of the
+	buffer's area when app_server gives one, as the buffer address in the
+	client data is only valid in app_server.
+*/
+static uint8*
+overlay_bits(overlay_client_data* data)
+{
+	if (data->buffer == NULL || data->area < 0)
+		return data->buffer;
+
+	if (data->client_source != data->area) {
+		if (data->client_area >= 0)
+			delete_area(data->client_area);
+		data->client_area = clone_area("overlay bitmap",
+			(void**)&data->client_base, B_ANY_ADDRESS,
+			B_READ_AREA | B_WRITE_AREA, data->area);
+		if (data->client_area < 0) {
+			data->client_source = -1;
+			return NULL;
+		}
+		data->client_source = data->area;
+	}
+	return data->client_base + data->offset;
+}
+
+
 /*!	\brief Locks the bitmap bits so that they cannot be relocated.
 
 	This is currently only used for overlay bitmaps - whenever you
@@ -566,7 +592,7 @@ BBitmap::Bits() const
 
 	if ((fFlags & B_BITMAP_WILL_OVERLAY) != 0) {
 		overlay_client_data* data = (overlay_client_data*)fBasePointer;
-		return data->buffer;
+		return overlay_bits(data);
 	}
 
 	return (void*)fBasePointer;
@@ -1258,6 +1284,13 @@ BBitmap::_CleanUp()
 	if ((fFlags & B_BITMAP_NO_SERVER_LINK) != 0) {
 		free(fBasePointer);
 	} else if (fServerToken != -1) {
+		if ((fFlags & B_BITMAP_WILL_OVERLAY) != 0) {
+			overlay_client_data* data = (overlay_client_data*)fBasePointer;
+			if (data->client_area >= 0)
+				delete_area(data->client_area);
+			data->client_area = -1;
+		}
+
 		BPrivate::AppServerLink link;
 		// AS_DELETE_BITMAP:
 		// Attached Data:
diff --git a/src/servers/app/drawing/Overlay.cpp b/src/servers/app/drawing/Overlay.cpp
index dd527cd50f..6c033580d9 100644
--- a/src/servers/app/drawing/Overlay.cpp
+++ b/src/servers/app/drawing/Overlay.cpp
@@ -120,7 +120,7 @@ Overlay::Resume(ServerBitmap* bitmap)
 	if (status < B_OK)
 		return status;
 
-	fClientData->buffer = (uint8*)fOverlayBuffer->buffer;
+	_UpdateClientData();
 	return B_OK;
 }
 
@@ -137,6 +137,7 @@ Overlay::Suspend(ServerBitmap* bitmap, bool needTemporary)
 
 	_FreeBuffer();
 	fClientData->buffer = NULL;
+	fClientData->area = -1;
 
 	return B_OK;
 }
@@ -167,7 +168,31 @@ Overlay::SetClientData(overlay_client_data* clientData)
 {
 	fClientData = clientData;
 	fClientData->lock = fSemaphore;
+	fClientData->client_area = -1;
+	fClientData->client_source = -1;
+	fClientData->client_base = NULL;
+	_UpdateClientData();
+}
+
+
+/*!	The buffer address is only valid in app_server: the client gets the
+	buffer's area to clone as well, if it can be cloned.
+*/
+void
+Overlay::_UpdateClientData()
+{
 	fClientData->buffer = (uint8*)fOverlayBuffer->buffer;
+	fClientData->area = -1;
+	fClientData->offset = 0;
+
+	area_info info;
+	area_id area = area_for(fOverlayBuffer->buffer);
+	if (area >= 0 && get_area_info(area, &info) == B_OK
+		&& (info.protection & B_CLONEABLE_AREA) != 0) {
+		fClientData->area = area;
+		fClientData->offset = (addr_t)fOverlayBuffer->buffer
+			- (addr_t)info.address;
+	}
 }
 
 
diff --git a/src/servers/app/drawing/Overlay.h b/src/servers/app/drawing/Overlay.h
index 5a8e1cec40..9b38662d57 100644
--- a/src/servers/app/drawing/Overlay.h
+++ b/src/servers/app/drawing/Overlay.h
@@ -57,6 +57,7 @@ class Overlay {
 	private:
 		void _FreeBuffer();
 		status_t _AllocateBuffer(ServerBitmap* bitmap);
+		void _UpdateClientData();
 
 		HWInterface&			fHWInterface;
 		const overlay_buffer*	fOverlayBuffer;
