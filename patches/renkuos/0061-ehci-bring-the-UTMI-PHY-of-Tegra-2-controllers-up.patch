From 134eab357ae00d34c3413ada09255cee03ec7601 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 23:28:11 +0200
Subject: [PATCH 061/203] ehci: bring the UTMI PHY of Tegra 2 controllers up

The boot firmware may leave a Tegra 2 USB controller in a state where
its UTMI PHY clock is not valid, and accessing the controller then
stalls the CPU: on the Toshiba AC100 the first register read after the
controller reset never completed.

Before taking over a device tree controller with a UTMI PHY, power the
shared UTMI pads up, reset the controller through the clock and reset
controller, program the PHY like the boot firmware and Linux do (PLL-U
delays for the oscillator frequency, transceiver and receiver settings),
take the PHY out of reset and wait for its clock to become valid, then
select the UTMI interface and leave the power down states.
---
 src/add-ons/kernel/busses/usb/ehci.cpp | 214 ++++++++++++++++++++++++-
 1 file changed, 211 insertions(+), 3 deletions(-)

diff --git a/src/add-ons/kernel/busses/usb/ehci.cpp b/src/add-ons/kernel/busses/usb/ehci.cpp
index 963be3302b..72a028e4f6 100644
--- a/src/add-ons/kernel/busses/usb/ehci.cpp
+++ b/src/add-ons/kernel/busses/usb/ehci.cpp
@@ -53,15 +53,216 @@ typedef struct {
 } ehci_pci_sim_info;
 
 
+// #pragma mark - NVIDIA Tegra 2 UTMI PHY
+
+
+#define TEGRA20_CAR_BASE				0x60006000
+#define TEGRA_CAR_RST_DEVICES(bank)		(0x04 + (bank) * 4)
+#define TEGRA_CAR_CLK_OUT_ENB(bank)		(0x10 + (bank) * 4)
+#define TEGRA_CAR_OSC_CTRL				0x50
+#define TEGRA_CLOCK_USBD				22
+	// the first controller, which also holds the shared UTMI pad registers
+
+// controller registers, from the start of the controller
+#define TEGRA_USB_ICUSB_CTRL			0x16c
+#define TEGRA_USB_PORTSC1				0x184
+#define TEGRA_USB_SUSP_CTRL				0x400
+#define TEGRA_USB_PHY_VBUS_SENSORS		0x404
+#define TEGRA_UTMIP_PLL_CFG1			0x804
+#define TEGRA_UTMIP_XCVR_CFG0			0x808
+#define TEGRA_UTMIP_BIAS_CFG0			0x80c
+#define TEGRA_UTMIP_HSRX_CFG0			0x810
+#define TEGRA_UTMIP_HSRX_CFG1			0x814
+#define TEGRA_UTMIP_TX_CFG0				0x820
+#define TEGRA_UTMIP_MISC_CFG1			0x828
+#define TEGRA_UTMIP_DEBOUNCE_CFG0		0x82c
+#define TEGRA_UTMIP_BAT_CHRG_CFG0		0x830
+#define TEGRA_UTMIP_SPARE_CFG0			0x834
+#define TEGRA_UTMIP_XCVR_CFG1			0x838
+#define TEGRA_UTMIP_BIAS_CFG1			0x83c
+
+#define UTMIP_PHY_ENB					(1 << 12)
+#define UTMIP_RESET						(1 << 11)
+#define USB_PHY_CLK_VALID				(1 << 7)
+#define VBUS_B_SESS_VLD_SW_VALUE		(1 << 12)
+#define VBUS_B_SESS_VLD_SW_EN			(1 << 11)
+#define UTMIP_PHY_XTAL_CLOCKEN			(1 << 30)
+#define UTMIP_OTGPD						(1 << 11)
+#define UTMIP_BIASPD					(1 << 10)
+#define UTMIP_FS_PREAMBLE_J				(1 << 19)
+#define UTMIP_PD_CHRG					(1 << 0)
+#define FUSE_SETUP_SEL					(1 << 3)
+#define UTMIP_XCVR_LSBIAS_SE			(1 << 21)
+#define UTMIP_FORCE_PD_POWERDOWN		(1 << 14)
+#define UTMIP_FORCE_PD2_POWERDOWN		(1 << 16)
+#define UTMIP_FORCE_PDZI_POWERDOWN		(1 << 18)
+#define UTMIP_FORCE_PDDISC_POWERDOWN	(1 << 0)
+#define UTMIP_FORCE_PDCHRP_POWERDOWN	(1 << 2)
+#define UTMIP_FORCE_PDDR_POWERDOWN		(1 << 4)
+#define IC_ENB1							(1 << 3)
+#define TEGRA_PORTSC_PTS_MASK			(3U << 30)
+#define TEGRA_PORTSC_STS				(1 << 29)
+
+// PLL-U delays per oscillator frequency (OSC_CTRL[31:30]: 13, 19.2, 12 and
+// 26 MHz): enable delay, stable count, active delay, crystal frequency count,
+// debounce time, bias time
+static const uint32 kTegra20UTMITimings[4][6] = {
+	{ 0x02, 0x33, 0x05, 0x7f, 0x7ef4, 5 },
+	{ 0x03, 0x4b, 0x06, 0xbb, 0xbb80, 7 },
+	{ 0x02, 0x2f, 0x04, 0x76, 0x7530, 5 },
+	{ 0x04, 0x66, 0x09, 0xfe, 0xfde8, 9 },
+};
+
+
+static inline void
+tegra_set_bits(volatile uint32* reg, uint32 mask, uint32 value)
+{
+	*reg = (*reg & ~mask) | value;
+}
+
+
+/*!	Brings the UTMI PHY of a Tegra 2 USB controller up, the way the boot
+	firmware and Linux do. The firmware may have used the controller, but left
+	it in a state where the PHY clock is not valid, and accessing the
+	controller then stalls the CPU.
+*/
+static status_t
+tegra20_utmi_phy_init(fdt_device_module_info* fdt, fdt_device* fdtDevice,
+	phys_addr_t registers)
+{
+	int length;
+	const char* phyType = (const char*)fdt->get_prop(fdtDevice, "phy_type",
+		&length);
+	if (phyType == NULL || strcmp(phyType, "utmi") != 0)
+		return B_OK;
+
+	const uint32* clocks = (const uint32*)fdt->get_prop(fdtDevice, "clocks",
+		&length);
+	if (clocks == NULL || length < 8)
+		return B_BAD_DATA;
+	uint32 clock = B_BENDIAN_TO_HOST_INT32(clocks[1]);
+
+	volatile uint32* car;
+	area_id carArea = map_physical_memory("tegra car", TEGRA20_CAR_BASE,
+		B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, (void**)&car);
+	if (carArea < B_OK)
+		return carArea;
+
+	volatile uint8* usb;
+	area_id usbArea = map_physical_memory("tegra usb phy", registers,
+		0x1000, B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+		(void**)&usb);
+	volatile uint8* usb1;
+	area_id usb1Area = map_physical_memory("tegra usb1 pads",
+		registers & ~(phys_addr_t)0xffff, 0x1000, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, (void**)&usb1);
+	if (usbArea < B_OK || usb1Area < B_OK) {
+		delete_area(carArea);
+		delete_area(usbArea);
+		delete_area(usb1Area);
+		return B_NO_MEMORY;
+	}
+#define USB_REG(offset)		((volatile uint32*)(usb + (offset)))
+
+	const uint32* timing
+		= kTegra20UTMITimings[car[TEGRA_CAR_OSC_CTRL / 4] >> 30];
+
+	// The shared UTMI pads are controlled through the first controller,
+	// whose clock must be running
+	uint32 usbdBit = 1U << TEGRA_CLOCK_USBD;
+	car[TEGRA_CAR_CLK_OUT_ENB(0) / 4] |= usbdBit;
+	car[TEGRA_CAR_RST_DEVICES(0) / 4] &= ~usbdBit;
+
+	// Reset the controller, with its clock running
+	uint32 bank = clock / 32;
+	uint32 bit = 1U << (clock % 32);
+	car[TEGRA_CAR_CLK_OUT_ENB(bank) / 4] |= bit;
+	car[TEGRA_CAR_RST_DEVICES(bank) / 4] |= bit;
+	spin(2);
+	car[TEGRA_CAR_RST_DEVICES(bank) / 4] &= ~bit;
+	spin(2);
+
+	// Power the shared pads up
+	*(volatile uint32*)(usb1 + TEGRA_UTMIP_BIAS_CFG0)
+		&= ~(UTMIP_OTGPD | UTMIP_BIASPD);
+
+	*USB_REG(TEGRA_USB_SUSP_CTRL) |= UTMIP_RESET | UTMIP_PHY_ENB;
+
+	// Stop the crystal clock while the PHY is configured
+	*USB_REG(TEGRA_UTMIP_MISC_CFG1) &= ~UTMIP_PHY_XTAL_CLOCKEN;
+	spin(1);
+
+	*USB_REG(TEGRA_USB_PHY_VBUS_SENSORS)
+		&= ~(VBUS_B_SESS_VLD_SW_VALUE | VBUS_B_SESS_VLD_SW_EN);
+
+	tegra_set_bits(USB_REG(TEGRA_UTMIP_MISC_CFG1), (0xfff << 6) | (0x1f << 18),
+		(timing[1] << 6) | (timing[2] << 18));
+	tegra_set_bits(USB_REG(TEGRA_UTMIP_PLL_CFG1), (0x1f << 27) | 0xfff,
+		(timing[0] << 27) | timing[3]);
+	tegra_set_bits(USB_REG(TEGRA_UTMIP_BIAS_CFG1), 0x1f << 3, timing[5] << 3);
+	tegra_set_bits(USB_REG(TEGRA_UTMIP_DEBOUNCE_CFG0), 0xffff, timing[4]);
+
+	*USB_REG(TEGRA_UTMIP_TX_CFG0) |= UTMIP_FS_PREAMBLE_J;
+	*USB_REG(TEGRA_UTMIP_BAT_CHRG_CFG0) |= UTMIP_PD_CHRG;
+	*USB_REG(TEGRA_UTMIP_XCVR_CFG0) &= ~UTMIP_XCVR_LSBIAS_SE;
+	*USB_REG(TEGRA_UTMIP_SPARE_CFG0) &= ~FUSE_SETUP_SEL;
+
+	// idle wait, elastic limit and HS sync start delay, the values all Tegra 2
+	// device trees use
+	tegra_set_bits(USB_REG(TEGRA_UTMIP_HSRX_CFG0), (0x1f << 15) | (0x1f << 10),
+		(17 << 15) | (16 << 10));
+	tegra_set_bits(USB_REG(TEGRA_UTMIP_HSRX_CFG1), 0x1f << 1, 9 << 1);
+
+	spin(1);
+	*USB_REG(TEGRA_UTMIP_MISC_CFG1) |= UTMIP_PHY_XTAL_CLOCKEN;
+
+	// Take the PHY out of reset and wait for its clock
+	*USB_REG(TEGRA_USB_SUSP_CTRL) &= ~UTMIP_RESET;
+	bigtime_t start = system_time();
+	while ((*USB_REG(TEGRA_USB_SUSP_CTRL) & USB_PHY_CLK_VALID) == 0
+		&& system_time() - start < 100000) {
+		spin(10);
+	}
+	bool valid = (*USB_REG(TEGRA_USB_SUSP_CTRL) & USB_PHY_CLK_VALID) != 0;
+
+	if (valid) {
+		*USB_REG(TEGRA_USB_ICUSB_CTRL) &= ~IC_ENB1;
+
+		// UTMI parallel interface
+		*USB_REG(TEGRA_USB_PORTSC1)
+			&= ~(TEGRA_PORTSC_PTS_MASK | TEGRA_PORTSC_STS);
+
+		*USB_REG(TEGRA_UTMIP_XCVR_CFG0) &= ~(UTMIP_FORCE_PD_POWERDOWN
+			| UTMIP_FORCE_PD2_POWERDOWN | UTMIP_FORCE_PDZI_POWERDOWN);
+		*USB_REG(TEGRA_UTMIP_XCVR_CFG1) &= ~(UTMIP_FORCE_PDDISC_POWERDOWN
+			| UTMIP_FORCE_PDCHRP_POWERDOWN | UTMIP_FORCE_PDDR_POWERDOWN);
+	}
+#undef USB_REG
+
+	delete_area(usb1Area);
+	delete_area(usbArea);
+	delete_area(carArea);
+
+	if (!valid) {
+		TRACE_MODULE_ERROR("Tegra UTMI PHY clock did not become valid\n");
+		return B_TIMED_OUT;
+	}
+	return B_OK;
+}
+
+
 // Device tree controllers we support
 static const struct {
 	const char* compatible;
 	size_t capability_offset;
 	uint32 flags;
+	status_t (*setup_phy)(fdt_device_module_info* fdt, fdt_device* device,
+		phys_addr_t registers);
 } kFDTControllers[] = {
-	// NVIDIA Tegra 2 (ChipIdea core). The PHYs are expected to have been set
-	// up by the boot firmware.
-	{ "nvidia,tegra20-ehci", 0x100, EHCI::kIntegratedTT },
+	// NVIDIA Tegra 2 (ChipIdea core)
+	{ "nvidia,tegra20-ehci", 0x100, EHCI::kIntegratedTT,
+		&tegra20_utmi_phy_init },
 };
 
 
@@ -195,6 +396,13 @@ init_device(device_node* node, void** device_cookie)
 			return B_ERROR;
 		}
 
+		if (kFDTControllers[index].setup_phy != NULL
+			&& kFDTControllers[index].setup_phy(fdt, fdtDevice, registers)
+				!= B_OK) {
+			free(bus);
+			return B_ERROR;
+		}
+
 		bus->is_fdt = true;
 		dprintf("AC100: ehci FDT controller at %#" B_PRIx64 ", irq %" B_PRIu64
 			"\n", registers, irq);
