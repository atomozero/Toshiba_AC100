From c2cd85d95ead6648a79fd12685ab84c594b14565 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 27 Oct 2026 07:48:58 +0100
Subject: [PATCH 56/63] nvec: restart a transfer the EC left in the middle at
 once

The EC has been seen to stop in the middle of a message it sent. Until
the controller is started over nothing gets through, keyboard and
touchpad included, and tx_thread() only notices after a request of ours
went unanswered twice: the cursor stood still for 10 to 12 seconds.

Check every 100 ms, from the poll thread, for a transfer that has not
moved since the last check, restart the controller then and ask the EC
again to read a message of ours that may have been pending.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/busses/i2c/nvec/nvec.cpp | 31 +++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
index f1044fdd82..8b7d13be17 100644
--- a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
+++ b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
@@ -198,6 +198,8 @@ struct nvec_device {
 	// check_lost_interrupt(): the interrupt count when it found one pending
 	uint32				pendingInterrupts;
 	int32				pendingChecks;
+	// check_stalled_transfer(): the interrupt count at the last check
+	uint32				stalledInterrupts;
 	uint32				events;
 
 	sem_id				rxSem;		// a message came in
@@ -1140,6 +1142,34 @@ check_lost_interrupt(nvec_device* device)
 }
 
 
+/*!	The EC has been seen to stop in the middle of a message it sent (state 4,
+	no interrupt pending): nothing gets through anymore, keyboard and touchpad
+	included, until the controller is started over. tx_thread() only does so
+	once a request of ours went unanswered twice, 10 seconds later. A message
+	takes about a millisecond, so a transfer that did not move since the last
+	check, 100 ms ago, is given up here.
+*/
+static void
+check_stalled_transfer(nvec_device* device)
+{
+	InterruptsSpinLocker locker(device->lock);
+	bool stalled = device->state != 0
+		&& device->interrupts == device->stalledInterrupts
+		&& (read_reg(device, I2C_SL_STATUS) & I2C_SL_IRQ) == 0;
+	device->stalledInterrupts = device->interrupts;
+	bool sending = device->txHead != device->txTail;
+	locker.Unlock();
+
+	if (!stalled)
+		return;
+
+	restart_controller(device);
+	// the message the EC may have been about to read is still ours to send
+	if (sending)
+		set_request(device, true);
+}
+
+
 /*!	The EC sometimes stops sending keyboard and touchpad events, while it
 	still answers requests (seen on the AC100, after a minute or after
 	hours). Enabling the events, the keyboard and the touchpad again, as at
@@ -1197,6 +1227,7 @@ poll_thread(void* data)
 		for (int32 i = 0; i < 50 && !device->stopping; i++) {
 			snooze(100000);
 			check_lost_interrupt(device);
+			check_stalled_transfer(device);
 		}
 	}
 	return B_OK;
-- 
