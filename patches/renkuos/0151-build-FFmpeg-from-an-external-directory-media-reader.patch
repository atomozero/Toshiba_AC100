From 7de0eba87bc339c247aa7a610467e030ee1504fb Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 19 Oct 2026 23:57:34 +0200
Subject: [PATCH 151/203] build: FFmpeg from an external directory; media
 reader plugins in the ARM image

Without the FFmpeg plugin MediaPlayer could not open any file. Like the GL
kit, HAIKU_EXTERNAL_FFMPEG_DIR points to an FFmpeg extracted from a package
built for the target, when the repositories have none.
---
 build/jam/BuildFeatures              | 16 +++++++++++++++-
 build/jam/images/definitions/minimum |  2 ++
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/build/jam/BuildFeatures b/build/jam/BuildFeatures
index 44e57854cf..2327c944ba 100644
--- a/build/jam/BuildFeatures
+++ b/build/jam/BuildFeatures
@@ -215,7 +215,21 @@ if $(HAIKU_EXTERNAL_GL_DIR) && ! [ IsPackageAvailable mesa_devel ] {
 
 
 # FFmpeg
-if [ IsPackageAvailable ffmpeg6_devel ] {
+if $(HAIKU_EXTERNAL_FFMPEG_DIR) && ! [ IsPackageAvailable ffmpeg6_devel ] {
+	# An FFmpeg built elsewhere for the target (extracted package), when the
+	# repositories have none for it.
+	local ffmpegDir = $(HAIKU_EXTERNAL_FFMPEG_DIR) ;
+	SetBuildFeatureAttribute ffmpeg : headers
+		: [ FDirName $(ffmpegDir) develop headers ] ;
+	local ffmpegLib ;
+	local ffmpegLibraries ;
+	for ffmpegLib in libavformat.so libavcodec.so libavfilter.so libswscale.so
+			libavutil.so libswresample.so {
+		ffmpegLibraries += [ FDirName $(ffmpegDir) lib $(ffmpegLib) ] ;
+	}
+	SetBuildFeatureAttribute ffmpeg : libraries : $(ffmpegLibraries) ;
+	EnableBuildFeatures ffmpeg ;
+} else if [ IsPackageAvailable ffmpeg6_devel ] {
 	local ffmpegLibs = libavformat.so libavcodec.so libavfilter.so libswscale.so
 		libavutil.so libswresample.so ;
 
diff --git a/build/jam/images/definitions/minimum b/build/jam/images/definitions/minimum
index 9f437c9b6f..637d16279c 100644
--- a/build/jam/images/definitions/minimum
+++ b/build/jam/images/definitions/minimum
@@ -594,6 +594,8 @@ if arm in $(HAIKU_PACKAGING_ARCHS) {
 	] ;
 
 	SYSTEM_ADD_ONS_MEDIA_PLUGINS += [ FFilterByBuildFeatures
+		au_reader
+		ffmpeg@ffmpeg
 		http_streamer
 		raw_decoder
 	] ;
