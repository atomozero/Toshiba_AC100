+
+static status_t
+tegra_audio_control(void* cookie, uint32 op, void* arg, size_t length)
+{
+	tegra_audio* audio = (tegra_audio*)cookie;
+
+	switch (op) {
+		case B_MULTI_GET_DESCRIPTION:
+			return get_description(audio, (multi_description*)arg);
+		case B_MULTI_GET_ENABLED_CHANNELS:
+			return get_enabled_channels(audio, (multi_channel_enable*)arg);
+		case B_MULTI_SET_ENABLED_CHANNELS:
+			return B_OK;
+		case B_MULTI_GET_GLOBAL_FORMAT:
+			return get_global_format(audio, (multi_format_info*)arg);
+		case B_MULTI_SET_GLOBAL_FORMAT:
+			return set_global_format(audio, (multi_format_info*)arg);
+		case B_MULTI_LIST_MIX_CONTROLS:
+			return list_mix_controls(audio, (multi_mix_control_info*)arg);
+		case B_MULTI_GET_BUFFERS:
+			return get_buffers(audio, (multi_buffer_list*)arg);
+		case B_MULTI_BUFFER_EXCHANGE:
+			return buffer_exchange(audio, (multi_buffer_info*)arg);
+		case B_MULTI_BUFFER_FORCE_STOP:
+			return buffer_force_stop(audio);
+	}
+
+	return B_BAD_VALUE;
+}
