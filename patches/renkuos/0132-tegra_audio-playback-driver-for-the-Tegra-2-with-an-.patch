+
+
+/*!	Audio of the NVIDIA Tegra 2 with a Realtek ALC5632 codec, as on the
+	Toshiba AC100 (Compal PAZ00): playback only, 16 bit stereo at 44.1 kHz.
+
+	The chain, as Linux sets it up: PLL A (56.448 MHz) / 2.5 gives the codec's
+	master clock (512 fs) on the CDEV1 pin and, divided again, the clock of the
+	I2S1 controller, which is the bus master; the DAS connects I2S1 to the
+	DAP1 pins of the codec. An APB DMA channel feeds the I2S1 transmit FIFO in
+	continuous mode, one buffer after the other. The codec, on the first I2C
+	bus, is a slave that routes its DAC to the speaker (class D amplifier) and
+	the headphones.
+*/
+
+
+#include <new>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <KernelExport.h>
+#include <device_manager.h>
+#include <hmulti_audio.h>
+#include <i2c.h>
+#include <kernel.h>
+#include <lock.h>
+#include <util/AutoLock.h>
+#include <vm/vm.h>
+
+
+#define TRACE_ALWAYS(x...)	dprintf("tegra_audio: " x)
+
+#define TEGRA_AUDIO_DRIVER_MODULE_NAME	"drivers/audio/hmulti/tegra_audio/driver_v1"
+#define TEGRA_AUDIO_DEVICE_MODULE_NAME	"drivers/audio/hmulti/tegra_audio/device_v1"
+
+
+// clock and reset controller
+#define CAR_BASE					0x60006000
+#define CAR_RST_DEVICES(bank)		(0x04 + (bank) * 4)
+#define CAR_CLK_OUT_ENB(bank)		(0x10 + (bank) * 4)
+#define CAR_PLLP_OUTA				0xa4
+#define CAR_PLLA_BASE				0xb0
+#define CAR_PLLA_OUT				0xb4
+#define CAR_PLLA_MISC				0xbc
+#define CAR_CLK_SOURCE_I2S1			0x100
+#define PLL_BASE_BYPASS				(1U << 31)
+#define PLL_BASE_ENABLE				(1U << 30)
+#define PLL_BASE_LOCK				(1U << 27)
+#define PLL_MISC_LOCK_ENABLE		(1U << 18)
+#define PLL_MISC_CPCON_SHIFT		8
+#define CLOCK_I2S1					11
+#define CLOCK_APBDMA				34
+#define CLOCK_CDEV1					94
+
+// pin multiplexing
+#define APB_MISC_BASE				0x70000000
+#define PINMUX_TRISTATE_A			0x14
+#define PINMUX_TRISTATE_CDEV1		(1U << 4)
+#define PINMUX_TRISTATE_DAP1		(1U << 7)
+#define PINMUX_CTL_C				0x88
+#define PINMUX_CDEV1_SHIFT			2		// function 1: PLL A out
+#define PINMUX_DAP1_SHIFT			20		// function 0: DAP1
+
+// digital audio switch, in the same page
+#define DAS_OFFSET					0xc00
+#define DAS_DAP_CTRL_SEL(dap)		(DAS_OFFSET + 0x00 + (dap) * 4)
+#define DAS_DAC_INPUT_DATA_CLK_SEL(dac)	(DAS_OFFSET + 0x40 + (dac) * 4)
+
+// I2S1
+#define I2S1_BASE					0x70002800
+#define I2S_CTRL					0x00
+#define I2S_CTRL_FIFO1_ENABLE		(1U << 29)
+#define I2S_CTRL_MASTER_ENABLE		(1U << 25)
+#define I2S_CTRL_BIT_FORMAT_I2S		(0U << 10)
+#define I2S_CTRL_BIT_SIZE_16		(0U << 8)
+#define I2S_CTRL_FIFO_FORMAT_PACKED	(7U << 4)
+#define I2S_STATUS					0x04
+#define I2S_TIMING					0x08
+#define I2S_FIFO_SCR				0x0c
+#define I2S_FIFO_SCR_FIFO1_CLR		(1U << 8)
+#define I2S_FIFO_SCR_ATN_FOUR_SLOTS	0x11	// both FIFOs
+#define I2S_FIFO1					0x40
+#define I2S_DMA_REQUEST				2		// APB DMA requester
+
+// APB DMA
+#define APBDMA_BASE					0x6000a000
+#define APBDMA_GENERAL				0x000
+#define APBDMA_GENERAL_ENABLE		(1U << 31)
+#define APBDMA_IRQ_MASK_SET			0x020
+#define APBDMA_CHANNEL				1
+#define APBDMA_CHANNEL_OFFSET		(0x1000 + APBDMA_CHANNEL * 0x20)
+#define APBDMA_CHANNEL_IRQ			(32 + 104 + APBDMA_CHANNEL)
+#define DMA_CSR						0x00
+#define DMA_CSR_ENABLE				(1U << 31)
+#define DMA_CSR_IE_EOC				(1U << 30)
+#define DMA_CSR_DIR_TO_DEVICE		(1U << 28)
+#define DMA_CSR_FLOW				(1U << 21)
+#define DMA_CSR_REQ_SEL_SHIFT		16
+#define DMA_STATUS					0x04
+#define DMA_STATUS_BUSY				(1U << 31)
+#define DMA_STATUS_EOC				(1U << 30)
+#define DMA_AHB_PTR					0x10
+#define DMA_AHB_SEQ					0x14
+#define DMA_AHB_SEQ_INTR_ENABLE		(1U << 31)
+#define DMA_AHB_SEQ_BUS_WIDTH_32	(2U << 28)
+#define DMA_AHB_SEQ_BURST_4			(5U << 24)
+#define DMA_APB_PTR					0x18
+#define DMA_APB_SEQ					0x1c
+#define DMA_APB_SEQ_BUS_WIDTH_32	(2U << 28)
+#define DMA_APB_SEQ_WRAP_WORD_1		(1U << 16)
+
+// Realtek ALC5632
+#define ALC5632_RESET				0x00
+#define ALC5632_SPK_OUT_VOL			0x02
+#define ALC5632_HP_OUT_VOL			0x04
+#define ALC5632_STEREO_DAC_IN_VOL	0x0c
+#define ALC5632_MIC_ROUTING_CTRL	0x10
+#define ALC5632_OUTPUT_MIXER_CTRL	0x1c
+#define ALC5632_PWR_DOWN_CTRL_STATUS	0x26
+#define ALC5632_DAI_CONTROL			0x34
+#define ALC5632_PWR_MANAG_ADD1		0x3a
+#define ALC5632_PWR_MANAG_ADD2		0x3c
+#define ALC5632_PWR_MANAG_ADD3		0x3e
+#define ALC5632_GPCR1				0x40
+#define ALC5632_MISC_CTRL			0x5e
+#define ALC5632_DAC_CLK_CTRL1		0x60
+#define ALC5632_HID_CTRL_INDEX		0x6a
+#define ALC5632_HID_CTRL_DATA		0x6c
+#define ALC5632_VENDOR_ID1			0x7c
+#define ALC5632_VENDOR_ID2			0x7e
+
+#define SAMPLE_RATE					44100
+#define FRAME_SIZE					4		// 16 bit stereo
+#define BUFFER_COUNT				2
+#define DEFAULT_BUFFER_FRAMES		1024
+#define MAX_BUFFER_FRAMES			8192	// the DMA does at most 64 KB
+
+
+struct tegra_audio {
+	device_node*			node;
+	i2c_device_interface*	i2c;
+	i2c_device				i2cCookie;
+
+	area_id					carArea;
+	volatile uint8*			car;
+	area_id					miscArea;
+	volatile uint8*			misc;		// pin multiplexing and DAS
+	area_id					i2sArea;
+	volatile uint8*			i2s;
+	area_id					dmaArea;
+	volatile uint8*			dma;		// controller
+	volatile uint8*			channel;	// our channel in it
+
+	mutex					lock;
+	bool					opened;
+	bool					running;
+	bool					interruptInstalled;
+
+	area_id					bufferArea;
+	uint8*					buffers;
+	phys_addr_t				buffersPhysical;
+	uint32					bufferFrames;
+	uint32					bufferCount;
+
+	spinlock				interruptLock;
+	sem_id					bufferReadySem;
+	int32					playing;	// the buffer the DMA is reading
+	int64					framesPlayed;
+	bigtime_t				realTime;
+	uint32					interrupts;
+};
+
+
+static device_manager_info* sDeviceManager;
+
+
+static inline uint32
+read32(volatile uint8* base, uint32 offset)
+{
+	return *(volatile uint32*)(base + offset);
+}
+
+
+static inline void
+write32(volatile uint8* base, uint32 offset, uint32 value)
+{
+	*(volatile uint32*)(base + offset) = value;
+}
+
+
+static area_id
+map_registers(const char* name, phys_addr_t address, volatile uint8** _base)
+{
+	void* base;
+	area_id area = map_physical_memory(name, address, B_PAGE_SIZE,
+		B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &base);
+	if (area >= B_OK)
+		*_base = (volatile uint8*)base;
+	return area;
+}
+
+
+//	#pragma mark - codec
+
+
+static status_t
+codec_write(tegra_audio* audio, uint8 reg, uint16 value)
+{
+	uint8 data[2] = { (uint8)(value >> 8), (uint8)value };
+	status_t status = audio->i2c->acquire_bus(audio->i2cCookie);
+	if (status != B_OK)
+		return status;
+	status = audio->i2c->exec_command(audio->i2cCookie, I2C_OP_WRITE_STOP,
+		&reg, 1, data, 2);
+	audio->i2c->release_bus(audio->i2cCookie);
+	if (status != B_OK)
+		TRACE_ALWAYS("codec write %#x: %s\n", reg, strerror(status));
+	return status;
+}
+
+
+static status_t
+codec_read(tegra_audio* audio, uint8 reg, uint16* _value)
+{
+	uint8 data[2];
+	status_t status = audio->i2c->acquire_bus(audio->i2cCookie);
+	if (status != B_OK)
+		return status;
+	status = audio->i2c->exec_command(audio->i2cCookie, I2C_OP_READ_STOP,
+		&reg, 1, data, 2);
+	audio->i2c->release_bus(audio->i2cCookie);
+	if (status == B_OK)
+		*_value = (data[0] << 8) | data[1];
+	return status;
+}
+
+
+static void
+codec_update(tegra_audio* audio, uint8 reg, uint16 mask, uint16 value)
+{
+	uint16 old;
+	if (codec_read(audio, reg, &old) == B_OK)
+		codec_write(audio, reg, (old & ~mask) | (value & mask));
+}
+
+
+/*!	As Linux's alc5632 driver with the PAZ00 machine driver sets it up for
+	playback: slave, I2S, 16 bit, the system clock straight from MCLK (512 fs),
+	then the bias as for SND_SOC_BIAS_ON and the DAPM path from the DAC to
+	the speaker and to the headphones.
+*/
+static status_t
+codec_init(tegra_audio* audio)
+{
+	uint16 vendor = 0, id = 0;
+	status_t status = codec_read(audio, ALC5632_VENDOR_ID1, &vendor);
+	if (status == B_OK)
+		status = codec_read(audio, ALC5632_VENDOR_ID2, &id);
+	TRACE_ALWAYS("codec id %#06x %#06x: %s\n", vendor, id, strerror(status));
+	if (status != B_OK)
+		return status;
+	if (vendor != 0x10ec || (id >> 8) != 0x5c)
+		return B_DEVICE_NOT_FOUND;
+
+	codec_write(audio, ALC5632_RESET, 0x59b4);
+	snooze(10000);
+
+	// slave, I2S, 16 bit; system clock from MCLK, 512 fs
+	codec_write(audio, ALC5632_DAI_CONTROL, 1U << 15);
+	codec_update(audio, ALC5632_GPCR1, 1U << 15, 0);
+	codec_write(audio, ALC5632_DAC_CLK_CTRL1, 0x3075);
+
+	// bias on, with the headphone depop sequence
+	codec_update(audio, ALC5632_PWR_MANAG_ADD1, 1U << 6, 1U << 6);
+		// soft generator
+	codec_update(audio, ALC5632_PWR_MANAG_ADD3, 1U << 1, 1U << 1);
+	codec_update(audio, ALC5632_MISC_CTRL, 1U << 8, 1U << 8);
+		// depop mode 2
+	codec_update(audio, ALC5632_PWR_DOWN_CTRL_STATUS, 0xef00, 0);
+	snooze(500000);
+	codec_update(audio, ALC5632_PWR_MANAG_ADD2, 1U << 13, 1U << 13);
+		// VREF
+	codec_update(audio, ALC5632_PWR_MANAG_ADD1, 0x0343, 0x0343);
+		// DAC reference, soft generator, headphone amplifiers, main bias
+	codec_update(audio, ALC5632_MISC_CTRL, 1U << 8, 0);
+
+	// DACs into the speaker mixer and the headphone mixers (the switches mute
+	// when set)
+	codec_update(audio, ALC5632_MIC_ROUTING_CTRL, 0x000e, 0);
+	// speaker: N output LN/-R, class D amplifier, from the speaker mixer;
+	// headphones from their mixers
+	codec_write(audio, ALC5632_OUTPUT_MIXER_CTRL, 0xab08);
+
+	// power: DAC channels, I2S, speaker amplifier; DAC clocks, mixers;
+	// speaker and headphone outputs
+	codec_update(audio, ALC5632_PWR_MANAG_ADD1, 0xcc00, 0xcc00);
+	codec_update(audio, ALC5632_PWR_MANAG_ADD2, 0x0338, 0x0338);
+	// the class D amplifier: its generators (private register 0x46) first
+	codec_write(audio, ALC5632_HID_CTRL_INDEX, 0x46);
+	codec_write(audio, ALC5632_HID_CTRL_DATA, 0xffff);
+	codec_update(audio, ALC5632_PWR_MANAG_ADD2, 1U << 14, 1U << 14);
+	codec_update(audio, ALC5632_PWR_MANAG_ADD3, 0x3c00, 0x3c00);
+
+	// volumes (0 is the loudest, steps of 1.5 dB) and unmute
+	codec_write(audio, ALC5632_SPK_OUT_VOL, 0x0404);
+	codec_write(audio, ALC5632_HP_OUT_VOL, 0x0404);
+	codec_write(audio, ALC5632_STEREO_DAC_IN_VOL, 0x1010);
+	codec_update(audio, ALC5632_MISC_CTRL, 0x00c0, 0);
+
+	static const uint8 kShown[] = { 0x02, 0x04, 0x0c, 0x10, 0x1c, 0x26, 0x34,
+		0x3a, 0x3c, 0x3e, 0x40, 0x5e, 0x60 };
+	char text[256];
+	size_t length = 0;
+	for (uint32 i = 0; i < B_COUNT_OF(kShown); i++) {
+		uint16 value = 0;
+		codec_read(audio, kShown[i], &value);
+		length += snprintf(text + length, sizeof(text) - length, " %02x=%04x",
+			kShown[i], value);
+	}
+	TRACE_ALWAYS("codec:%s\n", text);
+	return B_OK;
+}
+
+
+//	#pragma mark - Tegra side
+
+
+static void
+set_clock(tegra_audio* audio, uint32 clock, bool enable)
+{
+	uint32 offset = CAR_CLK_OUT_ENB(clock / 32);
+	uint32 bit = 1U << (clock % 32);
+	uint32 value = read32(audio->car, offset);
+	write32(audio->car, offset, enable ? value | bit : value & ~bit);
+}
+
+
+static void
+set_reset(tegra_audio* audio, uint32 clock, bool reset)
+{
+	uint32 offset = CAR_RST_DEVICES(clock / 32);
+	uint32 bit = 1U << (clock % 32);
+	uint32 value = read32(audio->car, offset);
+	write32(audio->car, offset, reset ? value | bit : value & ~bit);
+}
+
+
+/*!	PLL A at 56.448 MHz from PLL P out 1 (28.8 MHz), its output 0 at
+	22.5792 MHz (512 x 44.1 kHz) for the codec on CDEV1, I2S1 at 2.8224 MHz
+	(twice its bit clock) from it.
+*/
+static status_t
+setup_clocks(tegra_audio* audio)
+{
+	uint32 pllpOutA = read32(audio->car, CAR_PLLP_OUTA);
+	if ((pllpOutA & 0xffff) != ((13 << 8) | 7)) {
+		// out 1: 216 MHz / 7.5, override, clock enable, out of reset
+		write32(audio->car, CAR_PLLP_OUTA,
+			(pllpOutA & 0xffff0000) | (13 << 8) | 7);
+	}
+
+	uint32 base = read32(audio->car, CAR_PLLA_BASE);
+	uint32 wanted = (49 << 8) | 25;		// N = 49, M = 25, P = 1
+	if ((base & PLL_BASE_ENABLE) == 0 || (base & PLL_BASE_BYPASS) != 0
+		|| (base & 0x7fff1f) != wanted) {
+		write32(audio->car, CAR_PLLA_BASE, PLL_BASE_BYPASS | wanted);
+		uint32 misc = read32(audio->car, CAR_PLLA_MISC);
+		misc &= ~(0xfU << PLL_MISC_CPCON_SHIFT);
+		write32(audio->car, CAR_PLLA_MISC, misc | (1 << PLL_MISC_CPCON_SHIFT)
+			| PLL_MISC_LOCK_ENABLE);
+		write32(audio->car, CAR_PLLA_BASE,
+			PLL_BASE_BYPASS | PLL_BASE_ENABLE | wanted);
+		bigtime_t timeout = system_time() + 2000;
+		while ((read32(audio->car, CAR_PLLA_BASE) & PLL_BASE_LOCK) == 0
+			&& system_time() < timeout) {
+			spin(10);
+		}
+		write32(audio->car, CAR_PLLA_BASE, PLL_BASE_ENABLE | wanted);
+	}
+	// out 0: divided by 2.5 (2 * (2.5 - 1) in 7.1 fixed point), enabled
+	write32(audio->car, CAR_PLLA_OUT, (3 << 8) | 3);
+
+	// I2S1 from PLL A out 0, divided by 8
+	set_clock(audio, CLOCK_I2S1, true);
+	write32(audio->car, CAR_CLK_SOURCE_I2S1, (0U << 30) | (2 * (8 - 1)));
+	set_reset(audio, CLOCK_I2S1, true);
+	spin(10);
+	set_reset(audio, CLOCK_I2S1, false);
+
+	// the codec's master clock
+	set_clock(audio, CLOCK_CDEV1, true);
+
+	set_clock(audio, CLOCK_APBDMA, true);
+	set_reset(audio, CLOCK_APBDMA, false);
+
+	TRACE_ALWAYS("clocks: PLL P out A %#" B_PRIx32 " -> %#" B_PRIx32
+		", PLL A %#" B_PRIx32 " -> %#" B_PRIx32 " (misc %#" B_PRIx32
+		"), out %#" B_PRIx32 ", I2S1 %#" B_PRIx32 "\n", pllpOutA,
+		read32(audio->car, CAR_PLLP_OUTA), base,
+		read32(audio->car, CAR_PLLA_BASE), read32(audio->car, CAR_PLLA_MISC),
+		read32(audio->car, CAR_PLLA_OUT),
+		read32(audio->car, CAR_CLK_SOURCE_I2S1));
+	return (read32(audio->car, CAR_PLLA_BASE) & PLL_BASE_LOCK) != 0
+		? B_OK : B_TIMED_OUT;
+}
+
+
+static void
+setup_pins_and_das(tegra_audio* audio)
+{
+	uint32 tristate = read32(audio->misc, PINMUX_TRISTATE_A);
+	uint32 mux = read32(audio->misc, PINMUX_CTL_C);
+	write32(audio->misc, PINMUX_CTL_C, (mux
+		& ~((3U << PINMUX_CDEV1_SHIFT) | (3U << PINMUX_DAP1_SHIFT)))
+		| (1U << PINMUX_CDEV1_SHIFT));
+	write32(audio->misc, PINMUX_TRISTATE_A,
+		tristate & ~(PINMUX_TRISTATE_CDEV1 | PINMUX_TRISTATE_DAP1));
+
+	// DAP1 <-> DAC1 (I2S1)
+	uint32 dap = read32(audio->misc, DAS_DAP_CTRL_SEL(0));
+	uint32 dac = read32(audio->misc, DAS_DAC_INPUT_DATA_CLK_SEL(0));
+	write32(audio->misc, DAS_DAP_CTRL_SEL(0), 0);
+	write32(audio->misc, DAS_DAC_INPUT_DATA_CLK_SEL(0), 0);
+
+	TRACE_ALWAYS("pins: tristate %#" B_PRIx32 " -> %#" B_PRIx32 ", mux %#"
+		B_PRIx32 " -> %#" B_PRIx32 "; DAS: DAP1 %#" B_PRIx32 ", DAC1 %#"
+		B_PRIx32 "\n", tristate, read32(audio->misc, PINMUX_TRISTATE_A), mux,
+		read32(audio->misc, PINMUX_CTL_C), dap, dac);
+}
+
+
+static void
+setup_i2s(tegra_audio* audio)
+{
+	write32(audio->i2s, I2S_CTRL, I2S_CTRL_MASTER_ENABLE
+		| I2S_CTRL_BIT_FORMAT_I2S | I2S_CTRL_BIT_SIZE_16
+		| I2S_CTRL_FIFO_FORMAT_PACKED);
+	// bit clock count per channel: 2.8224 MHz / (2 * 44.1 kHz) - 1
+	write32(audio->i2s, I2S_TIMING, 31);
+	write32(audio->i2s, I2S_FIFO_SCR, I2S_FIFO_SCR_ATN_FOUR_SLOTS);
+}
+
+
+//	#pragma mark - DMA
+
+
+static inline phys_addr_t
+buffer_physical(tegra_audio* audio, int32 index)
+{
+	return audio->buffersPhysical
+		+ (phys_addr_t)index * audio->bufferFrames * FRAME_SIZE;
+}
+
+
+static int32
+dma_interrupt(void* data)
+{
+	tegra_audio* audio = (tegra_audio*)data;
+	uint32 status = read32(audio->channel, DMA_STATUS);
+	if ((status & DMA_STATUS_EOC) == 0)
+		return B_UNHANDLED_INTERRUPT;
+	write32(audio->channel, DMA_STATUS, status);
+		// clears the end of count
+
+	acquire_spinlock(&audio->interruptLock);
+	audio->interrupts++;
+	// the DMA went on with the buffer programmed as the next one; the one
+	// after it is the one that just finished
+	audio->playing = (audio->playing + 1) % audio->bufferCount;
+	write32(audio->channel, DMA_AHB_PTR, buffer_physical(audio,
+		(audio->playing + 1) % audio->bufferCount));
+	audio->framesPlayed += audio->bufferFrames;
+	audio->realTime = system_time();
+	release_spinlock(&audio->interruptLock);
+
+	release_sem_etc(audio->bufferReadySem, 1, B_DO_NOT_RESCHEDULE);
+	return B_INVOKE_SCHEDULER;
+}
+
+
+static void
+start_playback(tegra_audio* audio)
+{
+	if (audio->running)
+		return;
+
+	audio->playing = 0;
+	audio->framesPlayed = 0;
+	audio->realTime = system_time();
+
+	write32(audio->dma, APBDMA_GENERAL, APBDMA_GENERAL_ENABLE);
+	write32(audio->dma, APBDMA_IRQ_MASK_SET, 1U << APBDMA_CHANNEL);
+
+	uint32 csr = DMA_CSR_DIR_TO_DEVICE | DMA_CSR_FLOW | DMA_CSR_IE_EOC
+		| (I2S_DMA_REQUEST << DMA_CSR_REQ_SEL_SHIFT)
+		| ((audio->bufferFrames * FRAME_SIZE - 4) & 0xfffc);
+	write32(audio->channel, DMA_CSR, csr);
+	write32(audio->channel, DMA_STATUS, read32(audio->channel, DMA_STATUS));
+	write32(audio->channel, DMA_APB_SEQ,
+		DMA_APB_SEQ_BUS_WIDTH_32 | DMA_APB_SEQ_WRAP_WORD_1);
+	write32(audio->channel, DMA_APB_PTR, I2S1_BASE + I2S_FIFO1);
+	write32(audio->channel, DMA_AHB_SEQ, DMA_AHB_SEQ_INTR_ENABLE
+		| DMA_AHB_SEQ_BUS_WIDTH_32 | DMA_AHB_SEQ_BURST_4);
+	write32(audio->channel, DMA_AHB_PTR, buffer_physical(audio, 0));
+	write32(audio->channel, DMA_CSR, csr | DMA_CSR_ENABLE);
+	// taken over once the first buffer is done (continuous mode)
+	write32(audio->channel, DMA_AHB_PTR,
+		buffer_physical(audio, 1 % audio->bufferCount));
+
+	write32(audio->i2s, I2S_FIFO_SCR,
+		I2S_FIFO_SCR_ATN_FOUR_SLOTS | I2S_FIFO_SCR_FIFO1_CLR);
+	write32(audio->i2s, I2S_CTRL,
+		read32(audio->i2s, I2S_CTRL) | I2S_CTRL_FIFO1_ENABLE);
+
+	audio->running = true;
+}
+
+
+static void
+stop_playback(tegra_audio* audio)
+{
+	if (!audio->running)
+		return;
+
+	write32(audio->i2s, I2S_CTRL,
+		read32(audio->i2s, I2S_CTRL) & ~I2S_CTRL_FIFO1_ENABLE);
+	write32(audio->channel, DMA_CSR, read32(audio->channel, DMA_CSR)
+		& ~(DMA_CSR_ENABLE | DMA_CSR_IE_EOC));
+	write32(audio->channel, DMA_STATUS, read32(audio->channel, DMA_STATUS));
+	audio->running = false;
+}
+
+
+static status_t
+create_buffers(tegra_audio* audio, uint32 frames, uint32 count)
+{
+	if (audio->bufferArea >= B_OK) {
+		if (audio->bufferFrames == frames && audio->bufferCount == count)
+			return B_OK;
+		delete_area(audio->bufferArea);
+		audio->bufferArea = -1;
+	}
+
+	size_t size = ROUNDUP(frames * FRAME_SIZE * count, B_PAGE_SIZE);
+	void* address;
+	audio->bufferArea = create_area("tegra audio buffers", &address,
+		B_ANY_KERNEL_ADDRESS, size, B_32_BIT_CONTIGUOUS,
+		B_READ_AREA | B_WRITE_AREA | B_KERNEL_READ_AREA
+			| B_KERNEL_WRITE_AREA);
+	if (audio->bufferArea < B_OK)
+		return audio->bufferArea;
+
+	physical_entry entry;
+	status_t status = get_memory_map(address, size, &entry, 1);
+	if (status == B_OK) {
+		// the APB DMA does not snoop the caches
+		status = vm_set_area_memory_type(audio->bufferArea, entry.address,
+			B_UNCACHED_MEMORY);
+	}
+	if (status != B_OK) {
+		delete_area(audio->bufferArea);
+		audio->bufferArea = -1;
+		return status;
+	}
+
+	audio->buffers = (uint8*)address;
+	audio->buffersPhysical = entry.address;
+	audio->bufferFrames = frames;
+	audio->bufferCount = count;
+	memset(audio->buffers, 0, size);
+	return B_OK;
+}
+
+
+/*!	Bring-up aid: plays a short tone through the whole chain at start and
+	logs what the DMA and the I2S controller did.
+*/
+static void
+self_test(tegra_audio* audio)
+{
+	if (create_buffers(audio, DEFAULT_BUFFER_FRAMES, BUFFER_COUNT) != B_OK)
+		return;
+
+	// a 689 Hz square wave (64 frames per period), quiet
+	int16* samples = (int16*)audio->buffers;
+	for (uint32 i = 0; i < DEFAULT_BUFFER_FRAMES * BUFFER_COUNT; i++) {
+		int16 value = (i & 32) != 0 ? 2000 : -2000;
+		samples[i * 2] = value;
+		samples[i * 2 + 1] = value;
+	}
+
+	start_playback(audio);
+	snooze(300000);
+	uint32 dmaStatus = read32(audio->channel, DMA_STATUS);
+	uint32 i2sStatus = read32(audio->i2s, I2S_STATUS);
+	uint32 interrupts = audio->interrupts;
+	stop_playback(audio);
+	memset(audio->buffers, 0, DEFAULT_BUFFER_FRAMES * BUFFER_COUNT
+		* FRAME_SIZE);
+
+	TRACE_ALWAYS("self test: %" B_PRIu32 " DMA interrupts in 300 ms (expected"
+		" about 13), DMA status %#" B_PRIx32 ", I2S status %#" B_PRIx32
+		", ctrl %#" B_PRIx32 "\n", interrupts, dmaStatus, i2sStatus,
+		read32(audio->i2s, I2S_CTRL));
+	audio->interrupts = 0;
+}
+
+
+//	#pragma mark - multi_audio
+
+
+static multi_channel_info sChannels[] = {
+	{ 0, B_MULTI_OUTPUT_CHANNEL, B_CHANNEL_LEFT | B_CHANNEL_STEREO_BUS, 0 },
+	{ 1, B_MULTI_OUTPUT_CHANNEL, B_CHANNEL_RIGHT | B_CHANNEL_STEREO_BUS, 0 },
+	{ 2, B_MULTI_OUTPUT_BUS, B_CHANNEL_LEFT | B_CHANNEL_STEREO_BUS,
+		B_CHANNEL_MINI_JACK_STEREO },
+	{ 3, B_MULTI_OUTPUT_BUS, B_CHANNEL_RIGHT | B_CHANNEL_STEREO_BUS,
+		B_CHANNEL_MINI_JACK_STEREO },
+};
+
+
+static status_t
+get_description(tegra_audio* audio, multi_description* data)
+{
+	multi_description description;
+	if (user_memcpy(&description, data, sizeof(description)) != B_OK)
+		return B_BAD_ADDRESS;
+
+	description.interface_version = B_CURRENT_INTERFACE_VERSION;
+	description.interface_minimum = B_CURRENT_INTERFACE_VERSION;
+	strlcpy(description.friendly_name, "Toshiba AC100 audio",
+		sizeof(description.friendly_name));
+	strlcpy(description.vendor_info, "NVIDIA Tegra 2, Realtek ALC5632",
+		sizeof(description.vendor_info));
+
+	description.output_channel_count = 2;
+	description.input_channel_count = 0;
+	description.output_bus_channel_count = 2;
+	description.input_bus_channel_count = 0;
+	description.aux_bus_channel_count = 0;
+	description.output_rates = B_SR_44100;
+	description.input_rates = 0;
+	description.max_cvsr_rate = 0;
+	description.min_cvsr_rate = 0;
+	description.output_formats = B_FMT_16BIT;
+	description.input_formats = 0;
+	description.lock_sources = B_MULTI_LOCK_INTERNAL;
+	description.timecode_sources = 0;
+	description.interface_flags = B_MULTI_INTERFACE_PLAYBACK;
+	description.start_latency = 30000;
+	description.control_panel[0] = '\0';
+
+	int32 requested = description.request_channel_count;
+	if (user_memcpy(data, &description, sizeof(description)) != B_OK)
+		return B_BAD_ADDRESS;
+	if (requested >= (int32)B_COUNT_OF(sChannels)
+		&& user_memcpy(description.channels, sChannels, sizeof(sChannels))
+			!= B_OK) {
+		return B_BAD_ADDRESS;
+	}
+	return B_OK;
+}
+
+
+static status_t
+get_enabled_channels(tegra_audio* audio, multi_channel_enable* data)
+{
+	multi_channel_enable enable;
+	if (user_memcpy(&enable, data, sizeof(enable)) != B_OK)
+		return B_BAD_ADDRESS;
+	if (enable.enable_bits != NULL) {
+		uchar bits = 0x3;
+		if (user_memcpy(enable.enable_bits, &bits, 1) != B_OK)
+			return B_BAD_ADDRESS;
+	}
+	enable.lock_source = B_MULTI_LOCK_INTERNAL;
+	return user_memcpy(data, &enable, sizeof(enable));
+}
+
+
+static status_t
+get_global_format(tegra_audio* audio, multi_format_info* data)
+{
+	multi_format_info info;
+	memset(&info, 0, sizeof(info));
+	info.info_size = sizeof(info);
+	info.output_latency = 0;
+	info.input_latency = 0;
+	info.timecode_kind = 0;
+	info.output.rate = B_SR_44100;
+	info.output.cvsr = SAMPLE_RATE;
+	info.output.format = B_FMT_16BIT;
+	info.input = info.output;
+	return user_memcpy(data, &info, sizeof(info));
+}
+
+
+static status_t
+set_global_format(tegra_audio* audio, multi_format_info* data)
+{
+	multi_format_info info;
+	if (user_memcpy(&info, data, sizeof(info)) != B_OK)
+		return B_BAD_ADDRESS;
+	if ((info.output.rate != 0 && info.output.rate != B_SR_44100)
+		|| (info.output.format != 0 && info.output.format != B_FMT_16BIT)) {
+		return B_BAD_VALUE;
+	}
+	return B_OK;
+}
+
+
+static status_t
+list_mix_controls(tegra_audio* audio, multi_mix_control_info* data)
+{
+	multi_mix_control_info info;
+	if (user_memcpy(&info, data, sizeof(info)) != B_OK)
+		return B_BAD_ADDRESS;
+	info.control_count = 0;
+	return user_memcpy(data, &info, sizeof(info));
+}
+
+
+static status_t
+get_buffers(tegra_audio* audio, multi_buffer_list* data)
+{
+	multi_buffer_list list;
+	if (user_memcpy(&list, data, sizeof(list)) != B_OK)
+		return B_BAD_ADDRESS;
+
+	uint32 frames = list.request_playback_buffer_size;
+	if (frames == 0 || frames > MAX_BUFFER_FRAMES)
+		frames = DEFAULT_BUFFER_FRAMES;
+	frames = ROUNDUP(frames, 4);
+		// the DMA moves bursts of 4 words
+
+	MutexLocker locker(audio->lock);
+	stop_playback(audio);
+	status_t status = create_buffers(audio, frames, BUFFER_COUNT);
+	if (status != B_OK)
+		return status;
+
+	list.flags = B_MULTI_BUFFER_PLAYBACK;
+	list.return_playback_buffers = BUFFER_COUNT;
+	list.return_playback_channels = 2;
+	list.return_playback_buffer_size = frames;
+	list.return_record_buffers = 0;
+	list.return_record_channels = 0;
+	list.return_record_buffer_size = 0;
+
+	for (int32 i = 0; i < BUFFER_COUNT; i++) {
+		buffer_desc descs[2];
+		for (int32 channel = 0; channel < 2; channel++) {
+			descs[channel].base = (char*)audio->buffers
+				+ i * frames * FRAME_SIZE + channel * 2;
+			descs[channel].stride = FRAME_SIZE;
+		}
+		buffer_desc* userDescs;
+		if (user_memcpy(&userDescs, &list.playback_buffers[i],
+				sizeof(userDescs)) != B_OK
+			|| !IS_USER_ADDRESS(userDescs)
+			|| user_memcpy(userDescs, descs, sizeof(descs)) != B_OK) {
+			return B_BAD_ADDRESS;
+		}
+	}
+
+	TRACE_ALWAYS("%d buffers of %" B_PRIu32 " frames\n", BUFFER_COUNT,
+		frames);
+	return user_memcpy(data, &list, sizeof(list));
+}
+
+
+static status_t
+buffer_exchange(tegra_audio* audio, multi_buffer_info* data)
+{
+	multi_buffer_info info;
+	if (user_memcpy(&info, data, sizeof(info)) != B_OK)
+		return B_BAD_ADDRESS;
+
+	{
+		MutexLocker locker(audio->lock);
+		if (audio->bufferArea < B_OK)
+			return B_ERROR;
+		start_playback(audio);
+	}
+
+	status_t status = acquire_sem_etc(audio->bufferReadySem, 1,
+		B_CAN_INTERRUPT | B_RELATIVE_TIMEOUT, 500000);
+	if (status == B_TIMED_OUT) {
+		static int32 sReported = 0;
+		if (atomic_add(&sReported, 1) < 5) {
+			TRACE_ALWAYS("no DMA interrupt: DMA status %#" B_PRIx32
+				", I2S status %#" B_PRIx32 "\n",
+				read32(audio->channel, DMA_STATUS),
+				read32(audio->i2s, I2S_STATUS));
+		}
+	} else if (status != B_OK)
+		return status;
+
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&audio->interruptLock);
+	info.playback_buffer_cycle = audio->playing;
+	info.played_real_time = audio->realTime;
+	info.played_frames_count = audio->framesPlayed;
+	release_spinlock(&audio->interruptLock);
+	restore_interrupts(state);
+
+	info.record_buffer_cycle = 0;
+	info.recorded_real_time = 0;
+	info.recorded_frames_count = 0;
+	info.flags = B_MULTI_BUFFER_PLAYBACK;
+
+	return user_memcpy(data, &info, sizeof(info));
+}
+
+
+static status_t
+buffer_force_stop(tegra_audio* audio)
+{
+	MutexLocker locker(audio->lock);
+	stop_playback(audio);
+	return B_OK;
+}
