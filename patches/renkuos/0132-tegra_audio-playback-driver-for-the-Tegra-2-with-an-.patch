+/*!	Registers the devices the device tree puts on this bus (like the audio
+	codec of the AC100), so that their drivers can find them. Their address is
+	in their node name, "name@address".
+*/
+static status_t
+tegra_i2c_scan_bus(i2c_bus_cookie cookie)
+{
+	tegra_i2c* controller = (tegra_i2c*)cookie;
+	device_node* fdtNode = gDeviceManager->get_parent_node(controller->node);
+	if (fdtNode == NULL)
+		return B_ERROR;
+
+	device_node* child = NULL;
+	while (gDeviceManager->get_next_child_node(fdtNode, NULL, &child)
+			== B_OK) {
+		const char* name;
+		const char* compatible;
+		if (gDeviceManager->get_attr_string(child, "fdt/name", &name, false)
+				!= B_OK
+			|| gDeviceManager->get_attr_string(child, "fdt/compatible",
+				&compatible, false) != B_OK) {
+			continue;
+		}
+		const char* at = strchr(name, '@');
+		if (at == NULL)
+			continue;
+		i2c_addr address = (i2c_addr)strtoul(at + 1, NULL, 16);
+
+		char* hid = strdup(compatible);
+		char* cid[] = { hid, NULL };
+		status_t status = hid != NULL
+			? gI2c->register_device(controller->bus, address, hid, cid, NULL)
+			: B_NO_MEMORY;
+		TRACE_ALWAYS("device %s (%s) at %#x: %s\n", name, compatible,
+			address, strerror(status));
+		free(hid);
+	}
+
+	gDeviceManager->put_node(fdtNode);
+	return B_OK;
+}
+
