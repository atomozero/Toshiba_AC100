From fd2cbe615ab60e13a0031ecf30ca913fe076ac81 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Fri, 23 Oct 2026 23:01:16 +0200
Subject: [PATCH 192/203] ehci: keep the last port status per controller
 (bring-up log)

---
 src/add-ons/kernel/busses/usb/ehci.cpp | 6 +++---
 src/add-ons/kernel/busses/usb/ehci.h   | 2 ++
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/add-ons/kernel/busses/usb/ehci.cpp b/src/add-ons/kernel/busses/usb/ehci.cpp
index 5a37f092bc..7a334d3513 100644
--- a/src/add-ons/kernel/busses/usb/ehci.cpp
+++ b/src/add-ons/kernel/busses/usb/ehci.cpp
@@ -1079,6 +1079,7 @@ EHCI::EHCI(Stack *stack, device_node* node)
 	B_INITIALIZE_SPINLOCK(&fInterruptLock);
 
 	memset(fIsoAnchors, 0, sizeof(fIsoAnchors));
+	memset(fLastPortStatus, 0xff, sizeof(fLastPortStatus));
 
 	// Create a lock for the isochronous transfer list
 	mutex_init(&fIsochronousLock, "EHCI isochronous lock");
@@ -2388,9 +2389,8 @@ EHCI::GetPortStatus(uint8 index, usb_port_status *status)
 	uint32 portStatus = ReadOpReg(EHCI_PORTSC + index * sizeof(uint32));
 
 	// bring-up aid: report every change of the port status
-	static uint32 sLastPortStatus[4] = { ~0U, ~0U, ~0U, ~0U };
-	if (index < 4 && portStatus != sLastPortStatus[index]) {
-		sLastPortStatus[index] = portStatus;
+	if (index < 4 && portStatus != fLastPortStatus[index]) {
+		fLastPortStatus[index] = portStatus;
 		dprintf("AC100: ehci %p port %u of %u: PORTSC %#" B_PRIx32 "\n",
 			fOperationalRegisters, index, fPortCount, portStatus);
 	}
diff --git a/src/add-ons/kernel/busses/usb/ehci.h b/src/add-ons/kernel/busses/usb/ehci.h
index e34d64e910..fd332ec27a 100644
--- a/src/add-ons/kernel/busses/usb/ehci.h
+++ b/src/add-ons/kernel/busses/usb/ehci.h
@@ -293,6 +293,8 @@ inline	uint32						ReadCapReg32(uint32 reg);
 
 		// Port management
 		uint8						fPortCount;
+		uint32						fLastPortStatus[4];
+									// bring-up aid, see GetPortStatus()
 		uint16						fPortResetChange;
 		uint16						fPortSuspendChange;
 
