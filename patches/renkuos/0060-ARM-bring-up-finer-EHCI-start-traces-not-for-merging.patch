From 3a8f212a61f41b727e6b520830001a13d59cfac4 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 23:19:21 +0200
Subject: [PATCH 060/270] ARM bring-up: finer EHCI start traces (not for
 merging)

---
 src/add-ons/kernel/busses/usb/ehci.cpp | 7 +++++++
 src/add-ons/kernel/busses/usb/ehci.h   | 1 +
 2 files changed, 8 insertions(+)

diff --git a/src/add-ons/kernel/busses/usb/ehci.cpp b/src/add-ons/kernel/busses/usb/ehci.cpp
index ec3651dbe4..963be3302b 100644
--- a/src/add-ons/kernel/busses/usb/ehci.cpp
+++ b/src/add-ons/kernel/busses/usb/ehci.cpp
@@ -112,6 +112,7 @@ init_bus(device_node* node, void** bus_cookie)
 		return B_NO_MEMORY;
 	}
 
+	dprintf("AC100: ehci init check\n");
 	if (ehci->InitCheck() < B_OK) {
 		TRACE_MODULE_ERROR("bus failed init check\n");
 		delete ehci;
@@ -1096,6 +1097,7 @@ status_t
 EHCI::Start()
 {
 	TRACE("starting EHCI host controller\n");
+	dprintf("AC100: ehci %p Start(), reading USBCMD\n", fOperationalRegisters);
 	dprintf("AC100: ehci %p start, USBCMD %#" B_PRIx32 ", USBSTS %#" B_PRIx32
 		"\n", fOperationalRegisters, ReadOpReg(EHCI_USBCMD),
 		ReadOpReg(EHCI_USBSTS));
@@ -2015,6 +2017,11 @@ EHCI::Interrupt()
 	uint32 status = ReadOpReg(EHCI_USBSTS) & EHCI_USBSTS_INTMASK;
 
 	// bring-up aid: tell an interrupt storm
+	if (!fInterruptSeen) {
+		fInterruptSeen = true;
+		dprintf("AC100: ehci %p first interrupt, USBSTS %#" B_PRIx32 "\n",
+			fOperationalRegisters, status);
+	}
 	static int32 sInterruptCount;
 	if (++sInterruptCount % 5000 == 0) {
 		dprintf("AC100: ehci %p %" B_PRId32 " interrupts, USBSTS %#" B_PRIx32
diff --git a/src/add-ons/kernel/busses/usb/ehci.h b/src/add-ons/kernel/busses/usb/ehci.h
index 285a05ee48..e34d64e910 100644
--- a/src/add-ons/kernel/busses/usb/ehci.h
+++ b/src/add-ons/kernel/busses/usb/ehci.h
@@ -236,6 +236,7 @@ inline	uint32						ReadCapReg32(uint32 reg);
 		pci_device*					fDevice;
 		Stack *						fStack;
 		uint32						fEnabledInterrupts;
+		bool						fInterruptSeen = false;
 		uint32						fThreshold;
 
 		// Periodic transfer framelist and interrupt entries
