From 4dbd47873587145f7b4d86d797779b2cb60ff927 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 19 Oct 2026 12:59:50 +0200
Subject: [PATCH 135/270] ARM bring-up: name the image of an unaligned access
 in userland

Log the image and the offset in it of the instruction that caused a SIGBUS
for an unaligned access (not for merging).
---
 src/system/kernel/arch/arm/arch_int.cpp | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/system/kernel/arch/arm/arch_int.cpp b/src/system/kernel/arch/arm/arch_int.cpp
index a6d08e6035..9058a4a790 100644
--- a/src/system/kernel/arch/arm/arch_int.cpp
+++ b/src/system/kernel/arch/arm/arch_int.cpp
@@ -19,6 +19,7 @@
 #include <arch/smp.h>
 #include <boot/kernel_args.h>
 #include <device_manager.h>
+#include <kimage.h>
 #include <kscheduler.h>
 #include <interrupt_controller.h>
 #include <ksyscalls.h>
@@ -599,9 +600,20 @@ arch_arm_page_fault(struct iframe *frame, addr_t far, uint32 fsr, bool isWrite,
 		thread_at_kernel_entry(system_time());
 		enable_interrupts();
 
+		// bring-up aid: in which image
+		struct image* image = image_iterate_through_team_images(
+			thread->team->id, [](struct image* image, void* cookie) {
+				addr_t pc = *(addr_t*)cookie;
+				return pc >= (addr_t)image->info.basic_info.text
+					&& pc - (addr_t)image->info.basic_info.text
+						< (addr_t)image->info.basic_info.text_size;
+			}, &frame->pc);
 		dprintf("AC100: SIGBUS for team %" B_PRId32 " \"%s\": unaligned access "
-			"to %#" B_PRIxADDR " at pc %#" B_PRIx32 "\n", thread->team->id,
-			thread->team->Name(), far, frame->pc);
+			"to %#" B_PRIxADDR " at pc %#" B_PRIx32 " (%s + %#" B_PRIxADDR
+			")\n", thread->team->id, thread->team->Name(), far, frame->pc,
+			image != NULL ? image->info.basic_info.name : "?",
+			image != NULL
+				? frame->pc - (addr_t)image->info.basic_info.text : 0);
 		Signal signal(SIGBUS, BUS_ADRALN, B_OK, thread->team->id);
 		signal.SetAddress((void*)far);
 		send_signal_to_thread(thread, signal, 0);
