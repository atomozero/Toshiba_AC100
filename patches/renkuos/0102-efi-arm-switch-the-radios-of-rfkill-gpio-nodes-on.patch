From 9c5e15619aa9c2239c81b74735e3b0631527b748 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 16:29:18 +0200
Subject: [PATCH 102/203] efi/arm: switch the radios of rfkill-gpio nodes on

The wireless module of the Toshiba AC100 is held in reset and powered down
by two GPIOs until they are driven active, as Linux' rfkill-gpio does when
the radio is not blocked. Do so in the loader, which gives the module time
to come up before the kernel enumerates the USB bus.
---
 .../boot/platform/efi/arch/arm/arch_dtb.cpp   | 58 +++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp b/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
index ea316cad95..8cb43492e7 100644
--- a/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
+++ b/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
@@ -58,6 +58,13 @@ static addr_range sL2Regs;
 static addr_range sTegraUSBRegs[3];
 static uint32 sTegraUSBCount;
 static addr_range sTegraCARRegs;
+static addr_range sTegraGPIORegs;
+// GPIOs to drive active to switch a radio on (Tegra GPIO number, active low)
+static struct {
+	uint32 pin;
+	bool activeLow;
+} sRadioGPIOs[4];
+static uint32 sRadioGPIOCount;
 
 
 /*!	The TWD runs at PERIPHCLK, whose rate the device tree usually doesn't
@@ -140,6 +147,29 @@ arch_handle_fdt(const void* fdt, int node)
 		&& dtb_has_fdt_string(compatible, compatibleLen, "nvidia,tegra20-car")) {
 		dtb_get_reg(fdt, node, 0, sTegraCARRegs);
 	}
+	if (sTegraGPIORegs.start == 0
+		&& dtb_has_fdt_string(compatible, compatibleLen, "nvidia,tegra20-gpio")) {
+		dtb_get_reg(fdt, node, 0, sTegraGPIORegs);
+	}
+	// the wireless module stays in reset and powered down until its reset
+	// and shutdown GPIOs are driven active (cells: controller, pin, flags)
+	if (dtb_has_fdt_string(compatible, compatibleLen, "rfkill-gpio")) {
+		static const char* const kProperties[] = { "reset-gpios",
+			"shutdown-gpios" };
+		for (uint32 i = 0; i < B_COUNT_OF(kProperties); i++) {
+			int length;
+			const uint32* cells = (const uint32*)fdt_getprop(fdt, node,
+				kProperties[i], &length);
+			if (cells == NULL || length < 12
+				|| sRadioGPIOCount >= B_COUNT_OF(sRadioGPIOs)) {
+				continue;
+			}
+			sRadioGPIOs[sRadioGPIOCount].pin = fdt32_to_cpu(cells[1]);
+			sRadioGPIOs[sRadioGPIOCount].activeLow
+				= (fdt32_to_cpu(cells[2]) & 1) != 0;
+			sRadioGPIOCount++;
+		}
+	}
 
 	// the kernel resets the machine through it
 	if (gKernelArgs.arch_args.pmc.start == 0
@@ -251,9 +281,37 @@ arch_quiesce_usb(void)
 }
 
 
+/*!	Switches the radios of rfkill-gpio nodes on, as Linux does when they are
+	not blocked: drives their GPIOs active, as outputs in GPIO mode.
+*/
+static void
+enable_radio_gpios(void)
+{
+	if (sTegraGPIORegs.start == 0)
+		return;
+
+	for (uint32 i = 0; i < sRadioGPIOCount; i++) {
+		uint32 pin = sRadioGPIOs[i].pin;
+		// 32 GPIOs per bank, 8 per port; the masked registers at 0x800 take
+		// the bits to change in their upper byte
+		addr_t port = (addr_t)sTegraGPIORegs.start + (pin / 32) * 0x80
+			+ ((pin % 32) / 8) * 4;
+		uint32 bit = 1U << (pin % 8);
+		uint32 value = sRadioGPIOs[i].activeLow ? 0 : bit;
+		*(volatile uint32*)(port + 0x820) = (bit << 8) | value;	// output
+		*(volatile uint32*)(port + 0x810) = (bit << 8) | bit;	// enable
+		*(volatile uint32*)(port + 0x800) = (bit << 8) | bit;	// GPIO mode
+		dprintf("radio: GPIO %" B_PRIu32 " set %s\n", pin,
+			value != 0 ? "high" : "low");
+	}
+}
+
+
 void
 arch_dtb_set_kernel_args(void)
 {
+	enable_radio_gpios();
+
 	// bring-up aid: record the state the firmware left the CPU in
 	uint32* debug = gKernelArgs.arch_args.bootDebug;
 	asm volatile ("mrc p15, 0, %0, c0, c0, 0" : "=r" (debug[0]));	// MIDR
