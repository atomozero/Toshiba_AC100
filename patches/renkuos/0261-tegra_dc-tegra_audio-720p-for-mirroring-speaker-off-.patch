From 48efa5ff5bf4430f24b5b436333699ab12397fe0 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 26 Oct 2026 21:37:02 +0100
Subject: [PATCH 261/270] tegra_dc, tegra_audio: 720p for mirroring, speaker
 off with HDMI

The HDMI output takes the smallest mode the screen lists that holds
the 1024x600 picture, usually 1280x720: a larger one only scales the
same picture more, at a clock that is harder on the link; at 1080p
the HDMI audio sounded metallic. 'hdmi_mode preferred' goes back to
the preferred or largest mode. The audio source is left to the HDMI
block, as Linux does: forcing S/PDIF sounded worse.

tegra_audio mutes the speaker while an HDMI screen is plugged in (the
hot plug line, GPIO N7), as the sound goes there through S/PDIF;
'hdmi_mutes_speaker false' keeps it on.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../drivers/audio/tegra/tegra_audio.cpp       | 30 ++++++++++---
 .../kernel/drivers/graphics/tegra_dc/hdmi.cpp | 42 +++++++++++++++----
 2 files changed, 57 insertions(+), 15 deletions(-)

diff --git a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
index a7d620252b..96c58c5fe5 100644
--- a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
+++ b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
@@ -182,6 +182,9 @@ struct tegra_audio_diag {
 #define GPIO_IN						0x30
 #define GPIO_PORT_W					22
 #define HP_DETECT_BIT				(1U << 2)
+// the HDMI hot plug line, GPIO N7 (the tegra_dc driver makes it a GPIO)
+#define GPIO_PORT_N					13
+#define HDMI_DETECT_BIT				(1U << 7)
 #define HP_POLL_INTERVAL			250000
 
 // Realtek ALC5632
@@ -252,9 +255,12 @@ struct tegra_audio {
 
 	area_id					gpioArea;
 	volatile uint8*			gpioPort;	// the registers of port W
+	volatile uint8*			hdmiPort;	// and of port N
 	thread_id				jackThread;
 	volatile bool			quitJackThread;
 	int32					headphones;	// -1 not known yet
+	int32					hdmi;		// -1 not known yet
+	bool					hdmiMutesSpeaker;
 };
 
 
@@ -418,11 +424,16 @@ codec_init(tegra_audio* audio)
 	driver of Linux does with its jack and the "Int Spk" pin.
 */
 static void
-set_headphones(tegra_audio* audio, bool plugged)
+set_outputs(tegra_audio* audio)
 {
-	codec_update(audio, ALC5632_SPK_OUT_VOL, 0x8080, plugged ? 0x8080 : 0);
-	TRACE_ALWAYS("headphones %s, speaker %s\n",
-		plugged ? "plugged in" : "unplugged", plugged ? "muted" : "on");
+	// the sound goes to the S/PDIF controller and on to HDMI anyway
+	bool hdmi = audio->hdmi > 0 && audio->hdmiMutesSpeaker
+		&& audio->spdifEnabled;
+	bool mute = audio->headphones > 0 || hdmi;
+	codec_update(audio, ALC5632_SPK_OUT_VOL, 0x8080, mute ? 0x8080 : 0);
+	TRACE_ALWAYS("headphones %s, HDMI %s, speaker %s\n",
+		audio->headphones > 0 ? "plugged in" : "unplugged",
+		audio->hdmi > 0 ? "plugged in" : "unplugged", mute ? "muted" : "on");
 }
 
 
@@ -432,9 +443,11 @@ jack_thread(void* data)
 	tegra_audio* audio = (tegra_audio*)data;
 	while (!audio->quitJackThread) {
 		int32 plugged = (read32(audio->gpioPort, GPIO_IN) & HP_DETECT_BIT) != 0;
-		if (plugged != audio->headphones) {
+		int32 hdmi = (read32(audio->hdmiPort, GPIO_IN) & HDMI_DETECT_BIT) != 0;
+		if (plugged != audio->headphones || hdmi != audio->hdmi) {
 			audio->headphones = plugged;
-			set_headphones(audio, plugged);
+			audio->hdmi = hdmi;
+			set_outputs(audio);
 		}
 		snooze(HP_POLL_INTERVAL);
 	}
@@ -448,6 +461,7 @@ start_jack_detection(tegra_audio* audio)
 	audio->gpioArea = map_registers("tegra gpio", GPIO_BASE, &audio->gpioPort);
 	if (audio->gpioArea < B_OK)
 		return;
+	audio->hdmiPort = audio->gpioPort + GPIO_PORT_OFFSET(GPIO_PORT_N);
 	audio->gpioPort += GPIO_PORT_OFFSET(GPIO_PORT_W);
 
 	// a GPIO, as an input
@@ -457,6 +471,7 @@ start_jack_detection(tegra_audio* audio)
 		read32(audio->gpioPort, GPIO_CNF) | HP_DETECT_BIT);
 
 	audio->headphones = -1;
+	audio->hdmi = -1;
 	audio->jackThread = spawn_kernel_thread(jack_thread, "tegra audio jack",
 		B_LOW_PRIORITY, audio);
 	if (audio->jackThread >= B_OK)
@@ -1627,6 +1642,9 @@ tegra_audio_init_driver(device_node* node, void** _cookie)
 	bool selfTest = get_driver_boolean_parameter(settings, "self_test", false,
 		true);
 	bool spdif = get_driver_boolean_parameter(settings, "spdif", true, true);
+	// "hdmi_mutes_speaker false" keeps the speaker on with an HDMI screen
+	audio->hdmiMutesSpeaker = get_driver_boolean_parameter(settings,
+		"hdmi_mutes_speaker", true, true);
 	unload_driver_settings(settings);
 
 	if (spdif) {
diff --git a/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp b/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
index 11e610361a..edea1d5492 100644
--- a/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
+++ b/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
@@ -320,8 +320,10 @@ struct tmds_settings {
 
 	// experiments with the HDMI audio, also from the driver settings
 	bool	force_720p;		// "hdmi_mode 720p"
+	bool	preferred_mode;	// "hdmi_mode preferred"
 	bool	hardware_cts;	// "hdmi_hw_cts": the block measures CTS itself
 	bool	audio_auto;		// "hdmi_audio_auto": source chosen by the block
+							// (the default: S/PDIF forced sounded worse)
 };
 
 
@@ -711,17 +713,36 @@ static const hdmi_mode k1080p = {
 };
 
 
-/*!	The screen's preferred mode if this hardware can drive it, or else the
-	largest one it can among the detailed timings and, as 1080p is often
-	only listed by its CEA code, the CEA video codes.
+/*!	The smallest mode the screen lists that still holds the panel's picture
+	(1024x600) without shrinking it, usually 1280x720: a larger one only
+	scales the same picture more, at a higher clock that is harder on the
+	link (the HDMI audio sounded metallic at 1080p, clean at 720p).
+	With \a preferred, the screen's preferred mode if this hardware can
+	drive it, or else the largest it can.
+	The candidates are the detailed timings and, as 720p and 1080p are often
+	only listed by their CEA codes, the CEA video codes.
 */
 static bool
-choose_mode(const uint8* edid, uint32 size, hdmi_mode& chosen)
+choose_mode(const uint8* edid, uint32 size, bool preferred,
+	hdmi_mode& chosen)
 {
 	bool found = false;
+	auto holdsPanel = [](const hdmi_mode& mode) {
+		return mode.h_display >= sHdmi.width && mode.v_display >= sHdmi.height;
+	};
 	auto consider = [&](const hdmi_mode& mode) {
-		if (!found || (uint32)mode.h_display * mode.v_display
-				> (uint32)chosen.h_display * chosen.v_display) {
+		uint32 area = (uint32)mode.h_display * mode.v_display;
+		uint32 chosenArea = (uint32)chosen.h_display * chosen.v_display;
+		bool better;
+		if (!found)
+			better = true;
+		else if (preferred)
+			better = area > chosenArea;
+		else if (holdsPanel(mode) != holdsPanel(chosen))
+			better = holdsPanel(mode);
+		else
+			better = holdsPanel(mode) ? area < chosenArea : area > chosenArea;
+		if (better) {
 			chosen = mode;
 			found = true;
 		}
@@ -731,7 +752,7 @@ choose_mode(const uint8* edid, uint32 size, hdmi_mode& chosen)
 		hdmi_mode mode;
 		if (parse_detailed_timing(edid + offset, mode)) {
 			consider(mode);
-			if (offset == 0x36)
+			if (offset == 0x36 && preferred)
 				return true;
 		}
 	}
@@ -1382,10 +1403,12 @@ connect()
 	const char* modeName = get_driver_parameter(settings, "hdmi_mode", NULL,
 		NULL);
 	tmds.force_720p = modeName != NULL && strcmp(modeName, "720p") == 0;
+	tmds.preferred_mode = modeName != NULL
+		&& strcmp(modeName, "preferred") == 0;
 	tmds.hardware_cts = get_driver_boolean_parameter(settings, "hdmi_hw_cts",
 		false, true);
 	tmds.audio_auto = get_driver_boolean_parameter(settings,
-		"hdmi_audio_auto", false, true);
+		"hdmi_audio_auto", true, true);
 	tmds.vco_cap = min_c(strtoul(get_driver_parameter(settings,
 		"hdmi_vco_cap", "1", "1"), NULL, 0), 0xfu);
 	unload_driver_settings(settings);
@@ -1409,7 +1432,8 @@ connect()
 	if (status == B_OK) {
 		hdmiSink = is_hdmi_sink(edid, edidSize);
 		hdmi_mode chosen;
-		if (!tmds.force_720p && choose_mode(edid, edidSize, chosen))
+		if (!tmds.force_720p && choose_mode(edid, edidSize,
+				tmds.preferred_mode, chosen))
 			sHdmi.mode = chosen;
 		char name[14] = "unknown";
 		for (uint32 offset = 0x36; offset < 0x7e; offset += 18) {
