+
+static status_t
+set_global_format(tegra_audio* audio, multi_format_info* data)
+{
+	multi_format_info info;
+	if (user_memcpy(&info, data, sizeof(info)) != B_OK)
+		return B_BAD_ADDRESS;
+	if ((info.output.rate != 0 && info.output.rate != B_SR_44100)
+		|| (info.output.format != 0 && info.output.format != B_FMT_16BIT)) {
+		return B_BAD_VALUE;
+	}
+	return B_OK;
+}
