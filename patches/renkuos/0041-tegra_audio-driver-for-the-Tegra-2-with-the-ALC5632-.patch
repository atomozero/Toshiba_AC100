+
+/*!	Output: the speaker and the headphones with their volume and mute, and
+	HDMI: whether the sound goes there, and whether the speaker is off
+	while a screen is plugged in.
+*/
+static status_t
+list_mix_controls(tegra_audio* audio, multi_mix_control_info* data)
+{
+	multi_mix_control_info info;
+	if (user_memcpy(&info, data, sizeof(info)) != B_OK)
+		return B_BAD_ADDRESS;
+
+	multi_mix_control controls[MIX_CONTROL_COUNT];
+	int32 i = 0;
+	make_control(controls[i++], MIX_OUTPUT, B_MULTI_MIX_GROUP, 0, S_OUTPUT,
+		"");
+	make_control(controls[i++], MIX_SPEAKER, B_MULTI_MIX_GROUP, MIX_OUTPUT,
+		S_null, "Speaker");
+	make_control(controls[i++], MIX_SPEAKER_LEFT, B_MULTI_MIX_GAIN,
+		MIX_SPEAKER, S_null, "");
+	make_control(controls[i++], MIX_SPEAKER_RIGHT, B_MULTI_MIX_GAIN,
+		MIX_SPEAKER, S_null, "", MIX_SPEAKER_LEFT);
+	make_control(controls[i++], MIX_SPEAKER_MUTE, B_MULTI_MIX_ENABLE,
+		MIX_SPEAKER, S_MUTE, "");
+	make_control(controls[i++], MIX_HEADPHONES, B_MULTI_MIX_GROUP,
+		MIX_OUTPUT, S_HEADPHONE, "");
+	make_control(controls[i++], MIX_HEADPHONES_LEFT, B_MULTI_MIX_GAIN,
+		MIX_HEADPHONES, S_null, "");
+	make_control(controls[i++], MIX_HEADPHONES_RIGHT, B_MULTI_MIX_GAIN,
+		MIX_HEADPHONES, S_null, "", MIX_HEADPHONES_LEFT);
+	make_control(controls[i++], MIX_HEADPHONES_MUTE, B_MULTI_MIX_ENABLE,
+		MIX_HEADPHONES, S_MUTE, "");
+	make_control(controls[i++], MIX_HDMI, B_MULTI_MIX_GROUP, MIX_OUTPUT,
+		S_null, "HDMI");
+	make_control(controls[i++], MIX_HDMI_SOUND, B_MULTI_MIX_ENABLE, MIX_HDMI,
+		S_null, "Sound on the HDMI screen");
+	make_control(controls[i++], MIX_HDMI_MUTES_SPEAKER, B_MULTI_MIX_ENABLE,
+		MIX_HDMI, S_null, "Speaker off while a screen is plugged in");
+
+	make_control(controls[i++], MIX_INPUT, B_MULTI_MIX_GROUP, 0, S_INPUT, "");
+	make_control(controls[i++], MIX_RECORD, B_MULTI_MIX_GROUP, MIX_INPUT,
+		S_null, "Recording");
+	make_control(controls[i++], MIX_RECORD_LEFT, B_MULTI_MIX_GAIN,
+		MIX_RECORD, S_null, "");
+	make_control(controls[i++], MIX_RECORD_RIGHT, B_MULTI_MIX_GAIN,
+		MIX_RECORD, S_null, "", MIX_RECORD_LEFT);
+	for (int32 c = i - 2; c < i; c++) {
+		controls[c].gain.min_gain = ALC5632_RECORD_BASE_DB;
+		controls[c].gain.max_gain = ALC5632_RECORD_BASE_DB
+			+ ALC5632_STEP_DB * ALC5632_RECORD_MAX;
+	}
+	make_control(controls[i++], MIX_SOURCE, B_MULTI_MIX_MUX, MIX_RECORD,
+		S_null, "Microphone");
+	make_control(controls[i++], MIX_SOURCE_BUILT_IN, B_MULTI_MIX_MUX_VALUE,
+		MIX_SOURCE, S_null, "Built-in");
+	make_control(controls[i++], MIX_SOURCE_HEADSET, B_MULTI_MIX_MUX_VALUE,
+		MIX_SOURCE, S_null, "Headset");
+	make_control(controls[i++], MIX_BOOST, B_MULTI_MIX_GROUP, MIX_INPUT,
+		S_null, "Boost");
+	controls[i - 1].flags = B_MULTI_MIX_GAIN;
+	controls[i - 1].parent = MIX_RECORD;
+	controls[i - 1].gain.min_gain = 0;
+	controls[i - 1].gain.max_gain = ALC5632_BOOST_STEP_DB * 7;
+	controls[i - 1].gain.granularity = ALC5632_BOOST_STEP_DB;
+
+	int32 count = min_c(info.control_count, (int32)B_COUNT_OF(controls));
+	if (count < 0 || (count > 0 && !IS_USER_ADDRESS(info.controls))
+		|| user_memcpy(info.controls, controls,
+			count * sizeof(multi_mix_control)) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+	info.control_count = B_COUNT_OF(controls);
+	return user_memcpy(data, &info, sizeof(info));
+}
+
+
+static status_t
+mix_values(tegra_audio* audio, multi_mix_value_info* data, bool set)
+{
+	multi_mix_value_info info;
+	if (user_memcpy(&info, data, sizeof(info)) != B_OK
+		|| info.item_count < 0 || info.item_count > 64
+		|| (info.item_count > 0 && !IS_USER_ADDRESS(info.values))) {
+		return B_BAD_ADDRESS;
+	}
+
+	MutexLocker locker(audio->lock);
+	bool changedInput = false;
+	for (int32 i = 0; i < info.item_count; i++) {
+		multi_mix_value value;
+		if (user_memcpy(&value, &info.values[i], sizeof(value)) != B_OK)
+			return B_BAD_ADDRESS;
+
+		uint8* level = NULL;
+		bool* flag = NULL;
+		bool input = false;
+		switch (value.id) {
+			case MIX_RECORD_LEFT:
+			case MIX_RECORD_RIGHT:
+			{
+				uint8& record = audio->recordLevel[value.id - MIX_RECORD_LEFT];
+				if (set) {
+					int32 steps = (int32)((value.gain - ALC5632_RECORD_BASE_DB)
+						/ ALC5632_STEP_DB + 0.5f);
+					record = max_c(0, min_c(steps, ALC5632_RECORD_MAX));
+				} else {
+					value.gain = ALC5632_RECORD_BASE_DB
+						+ ALC5632_STEP_DB * record;
+				}
+				input = true;
+				break;
+			}
+			case MIX_SOURCE:
+				if (set)
+					audio->inputSource = value.mux == 1 ? 1 : 0;
+				else
+					value.mux = audio->inputSource;
+				input = true;
+				break;
+			case MIX_BOOST:
+				if (set) {
+					int32 steps = (int32)(value.gain / ALC5632_BOOST_STEP_DB
+						+ 0.5f);
+					audio->micBoost = max_c(0, min_c(steps, 7));
+				} else
+					value.gain = ALC5632_BOOST_STEP_DB * audio->micBoost;
+				input = true;
+				break;
+		}
+		if (input) {
+			if (set)
+				changedInput = true;
+			else if (user_memcpy(&info.values[i], &value, sizeof(value))
+					!= B_OK) {
+				return B_BAD_ADDRESS;
+			}
+			continue;
+		}
+		switch (value.id) {
+			case MIX_SPEAKER_LEFT:
+			case MIX_SPEAKER_RIGHT:
+				level = &audio->speakerLevel[value.id - MIX_SPEAKER_LEFT];
+				break;
+			case MIX_HEADPHONES_LEFT:
+			case MIX_HEADPHONES_RIGHT:
+				level = &audio->headphoneLevel[value.id - MIX_HEADPHONES_LEFT];
+				break;
+			case MIX_SPEAKER_MUTE:
+				flag = &audio->speakerMuted;
+				break;
+			case MIX_HEADPHONES_MUTE:
+				flag = &audio->headphonesMuted;
+				break;
+			case MIX_HDMI_SOUND:
+				flag = &audio->spdifEnabled;
+				break;
+			case MIX_HDMI_MUTES_SPEAKER:
+				flag = &audio->hdmiMutesSpeaker;
+				break;
+			default:
+				continue;
+		}
+
+		if (!set) {
+			if (level != NULL)
+				value.gain = -ALC5632_STEP_DB * *level;
+			else
+				value.enable = *flag;
+			if (user_memcpy(&info.values[i], &value, sizeof(value)) != B_OK)
+				return B_BAD_ADDRESS;
+			continue;
+		}
+
+		if (level != NULL) {
+			int32 steps = (int32)(-value.gain / ALC5632_STEP_DB + 0.5f);
+			*level = max_c(0, min_c(steps, ALC5632_MAX_LEVEL));
+		} else if (flag == &audio->spdifEnabled) {
+			// only with the S/PDIF controller set up at start
+			bool enable = value.enable && audio->spdifInterruptInstalled;
+			if (enable != audio->spdifEnabled) {
+				// both DMA channels start together with the next buffer
+				stop_playback(audio);
+				audio->spdifEnabled = enable;
+
+			}
+		} else
+			*flag = value.enable;
+	}
+
+	if (set)
+		set_outputs(audio);
+	if (changedInput)
+		set_input(audio);
+	return B_OK;
+}
+
+
+static status_t
+get_buffers(tegra_audio* audio, multi_buffer_list* data)
+{
+	multi_buffer_list list;
+	if (user_memcpy(&list, data, sizeof(list)) != B_OK)
+		return B_BAD_ADDRESS;
+
+	uint32 frames = list.request_playback_buffer_size;
+	if (frames == 0 || frames > MAX_BUFFER_FRAMES)
+		frames = DEFAULT_BUFFER_FRAMES;
+	frames = ROUNDUP(frames, 4);
+		// the DMA moves bursts of 4 words
+
+	MutexLocker locker(audio->lock);
+	stop_playback(audio);
+	status_t status = create_buffers(audio, frames, BUFFER_COUNT);
+	if (status != B_OK)
+		return status;
+
+	bool record = audio->recordInterruptInstalled;
+	list.flags = B_MULTI_BUFFER_PLAYBACK | (record ? B_MULTI_BUFFER_RECORD : 0);
+	list.return_playback_buffers = BUFFER_COUNT;
+	list.return_playback_channels = 2;
+	list.return_playback_buffer_size = frames;
+	list.return_record_buffers = record ? BUFFER_COUNT : 0;
+	list.return_record_channels = record ? 2 : 0;
+	list.return_record_buffer_size = record ? frames : 0;
+
+	// the record buffers follow the playback ones
+	for (int32 i = 0; i < BUFFER_COUNT * (record ? 2 : 1); i++) {
+		buffer_desc descs[2];
+		for (int32 channel = 0; channel < 2; channel++) {
+			descs[channel].base = (char*)audio->buffers
+				+ i * frames * FRAME_SIZE + channel * 2;
+			descs[channel].stride = FRAME_SIZE;
+		}
+		buffer_desc** buffers = i < BUFFER_COUNT
+			? list.playback_buffers : list.record_buffers;
+		buffer_desc* userDescs;
+		if (user_memcpy(&userDescs, &buffers[i % BUFFER_COUNT],
+				sizeof(userDescs)) != B_OK
+			|| !IS_USER_ADDRESS(userDescs)
+			|| user_memcpy(userDescs, descs, sizeof(descs)) != B_OK) {
+			return B_BAD_ADDRESS;
+		}
+	}
+
+	TRACE_ALWAYS("%d buffers of %" B_PRIu32 " frames\n", BUFFER_COUNT,
+		frames);
+	return user_memcpy(data, &list, sizeof(list));
+}
+
+
+static status_t
+buffer_exchange(tegra_audio* audio, multi_buffer_info* data)
+{
+	multi_buffer_info info;
+	if (user_memcpy(&info, data, sizeof(info)) != B_OK)
+		return B_BAD_ADDRESS;
+
+	{
+		MutexLocker locker(audio->lock);
+		if (audio->bufferArea < B_OK)
+			return B_ERROR;
+		start_playback(audio);
+	}
+
+	status_t status = acquire_sem_etc(audio->bufferReadySem, 1,
+		B_CAN_INTERRUPT | B_RELATIVE_TIMEOUT, 500000);
+	if (status == B_TIMED_OUT) {
+		static int32 sReported = 0;
+		if (atomic_add(&sReported, 1) < 5) {
+			TRACE_ALWAYS("no DMA interrupt: DMA status %#" B_PRIx32
+				", I2S status %#" B_PRIx32 "\n",
+				read32(audio->channel, DMA_STATUS),
+				read32(audio->i2s, I2S_STATUS));
+		}
+	} else if (status != B_OK)
+		return status;
+
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&audio->interruptLock);
+	info.playback_buffer_cycle = audio->playing;
+	info.played_real_time = audio->realTime;
+	info.played_frames_count = audio->framesPlayed;
+	release_spinlock(&audio->interruptLock);
+	restore_interrupts(state);
+
+	if (audio->recordInterruptInstalled) {
+		state = disable_interrupts();
+		acquire_spinlock(&audio->interruptLock);
+		// the buffer the DMA just filled
+		info.record_buffer_cycle = (audio->recording + audio->bufferCount - 1)
+			% audio->bufferCount;
+		info.recorded_real_time = audio->recordTime;
+		info.recorded_frames_count = audio->framesRecorded;
+		release_spinlock(&audio->interruptLock);
+		restore_interrupts(state);
+		info.flags = B_MULTI_BUFFER_PLAYBACK | B_MULTI_BUFFER_RECORD;
+	} else {
+		info.record_buffer_cycle = 0;
+		info.recorded_real_time = 0;
+		info.recorded_frames_count = 0;
+		info.flags = B_MULTI_BUFFER_PLAYBACK;
+	}
+
+	return user_memcpy(data, &info, sizeof(info));
+}
+
+
+static status_t
+buffer_force_stop(tegra_audio* audio)
+{
+	MutexLocker locker(audio->lock);
+	stop_playback(audio);
+	return B_OK;
+}
