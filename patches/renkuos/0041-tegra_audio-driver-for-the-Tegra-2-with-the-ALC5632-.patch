+
+
+/*!	Audio of the NVIDIA Tegra 2 with a Realtek ALC5632 codec, as on the
+	Toshiba AC100 (Compal PAZ00): playback only, 16 bit stereo at 44.1 kHz.
+
+	The chain, as Linux sets it up: PLL A (56.448 MHz) / 2.5 gives the codec's
+	master clock (512 fs) on the CDEV1 pin and, divided again, the clock of the
+	I2S1 controller, which is the bus master; the DAS connects I2S1 to the
+	DAP1 pins of the codec. An APB DMA channel feeds the I2S1 transmit FIFO in
+	continuous mode, one buffer after the other. The codec, on the first I2C
+	bus, is a slave that routes its DAC to the speaker (class D amplifier) and
+	the headphones.
+
+	Recording: the codec's digital microphone (next to the camera) or the
+	headset microphone of the jack (MIC1) go through its ADC back over the
+	same I2S link, into the second FIFO of I2S1 and a third DMA channel.
+
+	The same buffers also go to the S/PDIF controller, through a second DMA
+	channel: the HDMI block takes its audio from there (TRM 27.3). Its clock,
+	128 fs = 5.6448 MHz, is PLL A out 0 divided by 4, so both outputs run at
+	exactly the same rate.
+*/
+
+
+#include <new>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <KernelExport.h>
+#include <device_manager.h>
+#include <driver_settings.h>
+#include <hmulti_audio.h>
+#include <i2c.h>
+#include <kernel.h>
+#include <lock.h>
+#include <util/AutoLock.h>
+#include <vm/vm.h>
+
+
+#define TRACE_ALWAYS(x...)	dprintf("tegra_audio: " x)
+
+#define TEGRA_AUDIO_DRIVER_MODULE_NAME	"drivers/audio/hmulti/tegra_audio/driver_v1"
+#define TEGRA_AUDIO_DEVICE_MODULE_NAME	"drivers/audio/hmulti/tegra_audio/device_v1"
+
+// Diagnostics: a second device, /dev/audio/tegra_audio_diag, that can be opened
+// next to the media server's and takes only these requests (the ac100audio
+// tool uses it)
+#define TEGRA_AUDIO_DIAG_PATH		"audio/tegra_audio_diag"
+#define TEGRA_AUDIO_DIAG			0x41433130	// 'AC10'
+
+enum {
+	TEGRA_DIAG_READ32 = 1,		// args[0] physical address -> result[0]
+	TEGRA_DIAG_WRITE32,			// args[0] physical address, args[1] value
+	TEGRA_DIAG_CODEC_READ,		// args[0] register -> result[0]
+	TEGRA_DIAG_CODEC_WRITE,		// args[0] register, args[1] value
+	TEGRA_DIAG_TONE,			// args[0] ms, args[1] frames per period,
+								// args[2] amplitude, args[3] channels (1 left,
+								// 2 right) -> result[0] DMA interrupts
+	TEGRA_DIAG_STATUS,			// -> result[0] opened, [1] running,
+								// [2] buffer frames, [3] buffer count
+};
+
+struct tegra_audio_diag {
+	uint32	command;
+	uint32	args[4];
+	uint32	result[4];
+};
+
+
+// clock and reset controller
+#define CAR_BASE					0x60006000
+#define CAR_RST_DEVICES(bank)		(0x04 + (bank) * 4)
+#define CAR_CLK_OUT_ENB(bank)		(0x10 + (bank) * 4)
+#define CAR_PLLP_OUTA				0xa4
+#define CAR_PLLA_BASE				0xb0
+#define CAR_PLLA_OUT				0xb4
+#define CAR_PLLA_MISC				0xbc
+#define CAR_CLK_SOURCE_I2S1			0x100
+#define CAR_CLK_SOURCE_I2S2			0x104
+#define CLK_SOURCE_I2S_MASTER_CLKEN	(1U << 28)
+#define PLL_BASE_BYPASS				(1U << 31)
+#define PLL_BASE_ENABLE				(1U << 30)
+#define PLL_BASE_LOCK				(1U << 27)
+#define PLL_MISC_LOCK_ENABLE		(1U << 18)
+#define PLL_MISC_CPCON_SHIFT		8
+#define CAR_CLK_SOURCE_SPDIF_OUT	0x108
+#define CLOCK_SPDIF					10
+#define CLOCK_I2S1					11
+#define CLOCK_I2S2					18
+#define CLOCK_APBDMA				34
+#define CLOCK_CDEV1					94
+
+// pin multiplexing
+#define APB_MISC_BASE				0x70000000
+#define PINMUX_TRISTATE_A			0x14
+#define PINMUX_TRISTATE_CDEV1		(1U << 4)
+#define PINMUX_TRISTATE_DAP1		(1U << 7)
+#define PINMUX_CTL_C				0x88
+#define PINMUX_CDEV1_SHIFT			2		// function 1: PLL A out
+#define PINMUX_DAP1_SHIFT			20		// function 0: DAP1
+
+// digital audio switch, in the same page
+#define DAS_OFFSET					0xc00
+#define DAS_DAP_CTRL_SEL(dap)		(DAS_OFFSET + 0x00 + (dap) * 4)
+#define DAS_DAC_INPUT_DATA_CLK_SEL(dac)	(DAS_OFFSET + 0x40 + (dac) * 4)
+
+// I2S1
+#define I2S1_BASE					0x70002800
+#define I2S2_BASE					0x70002a00
+#define I2S_CTRL					0x00
+#define I2S_CTRL_FIFO1_ENABLE		(1U << 29)
+#define I2S_CTRL_MASTER_ENABLE		(1U << 25)
+#define I2S_CTRL_BIT_FORMAT_I2S		(0U << 10)
+#define I2S_CTRL_BIT_SIZE_16		(0U << 8)
+#define I2S_CTRL_FIFO_FORMAT_PACKED	(7U << 4)
+#define I2S_STATUS					0x04
+#define I2S_TIMING					0x08
+#define I2S_FIFO_SCR				0x0c
+#define I2S_FIFO_SCR_FIFO1_CLR		(1U << 8)
+#define I2S_FIFO_SCR_FIFO2_CLR		(1U << 12)
+#define I2S_FIFO_SCR_FIFO1_COUNT(scr)	(((scr) >> 16) & 0x3f)
+#define I2S_FIFO_SCR_FIFO2_COUNT(scr)	(((scr) >> 24) & 0x3f)
+#define I2S_CTRL_FIFO2_ENABLE		(1U << 28)
+#define I2S_CTRL_FIFO_LPBK_ENABLE	(1U << 26)
+#define I2S_STATUS_FIFO1_RDY		(1U << 31)
+#define I2S_FIFO2					0x80
+#define I2S_FIFO_SCR_ATN_FOUR_SLOTS	0x11	// both FIFOs
+#define I2S_FIFO1					0x40
+#define I2S_DMA_REQUEST				2		// APB DMA requester
+
+// S/PDIF, in the same page as I2S1
+#define SPDIF_BASE					0x70002400
+#define SPDIF_CTRL					0x00
+#define SPDIF_CTRL_TX_EN			(1U << 28)
+#define SPDIF_CTRL_TC_EN			(1U << 27)	// send the channel status
+#define SPDIF_CTRL_PACK				(1U << 14)	// left and right in a word
+#define SPDIF_CTRL_BIT_MODE_16		(0U << 12)
+#define SPDIF_DATA_FIFO_CSR			0x0c
+#define SPDIF_FIFO_TX_CLR			(1U << 7)
+#define SPDIF_FIFO_TX_ATN_FOUR_SLOTS	(1U << 5)
+#define SPDIF_DATA_OUT				0x40
+#define SPDIF_CH_STA_TX(i)			(0x140 + (i) * 4)	// A to F
+#define SPDIF_DMA_REQUEST			3
+
+// APB DMA
+#define APBDMA_BASE					0x6000a000
+#define APBDMA_GENERAL				0x000
+#define APBDMA_GENERAL_ENABLE		(1U << 31)
+#define APBDMA_IRQ_MASK_SET			0x020
+#define APBDMA_CHANNEL				1
+#define APBDMA_CHANNEL_OFFSET		(0x1000 + APBDMA_CHANNEL * 0x20)
+#define APBDMA_CHANNEL_IRQ			(32 + 104 + APBDMA_CHANNEL)
+#define RECORD_DMA_CHANNEL			3
+#define RECORD_DMA_CHANNEL_OFFSET	(0x1000 + RECORD_DMA_CHANNEL * 0x20)
+#define RECORD_DMA_CHANNEL_IRQ		(32 + 104 + RECORD_DMA_CHANNEL)
+#define SPDIF_DMA_CHANNEL			2
+#define SPDIF_DMA_CHANNEL_OFFSET	(0x1000 + SPDIF_DMA_CHANNEL * 0x20)
+#define SPDIF_DMA_CHANNEL_IRQ		(32 + 104 + SPDIF_DMA_CHANNEL)
+#define DMA_CSR						0x00
+#define DMA_CSR_ENABLE				(1U << 31)
+#define DMA_CSR_IE_EOC				(1U << 30)
+#define DMA_CSR_DIR_TO_DEVICE		(1U << 28)
+#define DMA_CSR_FLOW				(1U << 21)
+#define DMA_CSR_REQ_SEL_SHIFT		16
+#define DMA_STATUS					0x04
+#define DMA_STATUS_BUSY				(1U << 31)
+#define DMA_STATUS_EOC				(1U << 30)
+#define DMA_AHB_PTR					0x10
+#define DMA_AHB_SEQ					0x14
+#define DMA_AHB_SEQ_INTR_ENABLE		(1U << 31)
+#define DMA_AHB_SEQ_BUS_WIDTH_32	(2U << 28)
+#define DMA_AHB_SEQ_BURST_4			(5U << 24)
+#define DMA_APB_PTR					0x18
+#define DMA_APB_SEQ					0x1c
+#define DMA_APB_SEQ_BUS_WIDTH_32	(2U << 28)
+#define DMA_APB_SEQ_WRAP_WORD_1		(1U << 16)
+
+// GPIO controller: the headphone jack switch is on GPIO W2, high while a
+// plug is in (nvidia,hp-det-gpios of the PAZ00 device tree)
+#define GPIO_BASE					0x6000d000
+#define GPIO_PORT_OFFSET(port)		(((port) / 4) * 0x80 + ((port) % 4) * 4)
+#define GPIO_CNF					0x00
+#define GPIO_OE						0x10
+#define GPIO_IN						0x30
+#define GPIO_PORT_W					22
+#define HP_DETECT_BIT				(1U << 2)
+// the HDMI hot plug line, GPIO N7 (the tegra_dc driver makes it a GPIO)
+#define GPIO_PORT_N					13
+#define HDMI_DETECT_BIT				(1U << 7)
+#define HP_POLL_INTERVAL			250000
+
+// Realtek ALC5632
+#define ALC5632_RESET				0x00
+#define ALC5632_SPK_OUT_VOL			0x02
+#define ALC5632_HP_OUT_VOL			0x04
+#define ALC5632_STEREO_DAC_IN_VOL	0x0c
+#define ALC5632_MIC_VOL				0x0e
+#define ALC5632_ADC_REC_GAIN		0x12	// left 12-8, right 4-0
+#define ALC5632_ADC_REC_MIXER		0x14	// mutes: MIC1 bits 14 and 6
+#define ALC5632_I2S_OUT_CTL			0x1a	// bit 5: 0 = the stereo ADC
+#define ALC5632_MIC_CTRL			0x22	// MIC1 boost bits 11-10
+#define ALC5632_DIGI_BOOST_CTRL		0x24	// digital microphone
+#define ALC5632_MIC_ROUTING_CTRL	0x10
+#define ALC5632_OUTPUT_MIXER_CTRL	0x1c
+#define ALC5632_PWR_DOWN_CTRL_STATUS	0x26
+#define ALC5632_DAI_CONTROL			0x34
+#define ALC5632_PWR_MANAG_ADD1		0x3a
+#define ALC5632_PWR_MANAG_ADD2		0x3c
+#define ALC5632_PWR_MANAG_ADD3		0x3e
+#define ALC5632_GPCR1				0x40
+#define ALC5632_MISC_CTRL			0x5e
+#define ALC5632_DAC_CLK_CTRL1		0x60
+#define ALC5632_HID_CTRL_INDEX		0x6a
+#define ALC5632_HID_CTRL_DATA		0x6c
+#define ALC5632_VENDOR_ID1			0x7c
+#define ALC5632_VENDOR_ID2			0x7e
+
+#define SAMPLE_RATE					44100
+#define FRAME_SIZE					4		// 16 bit stereo
+#define BUFFER_COUNT				2
+#define DEFAULT_BUFFER_FRAMES		1024
+#define MAX_BUFFER_FRAMES			8192	// the DMA does at most 64 KB
+
+
+struct tegra_audio {
+	device_node*			node;
+	i2c_device_interface*	i2c;
+	i2c_device				i2cCookie;
+
+	area_id					carArea;
+	volatile uint8*			car;
+	area_id					miscArea;
+	volatile uint8*			misc;		// pin multiplexing and DAS
+	area_id					i2sArea;
+	volatile uint8*			i2s;
+	area_id					dmaArea;
+	volatile uint8*			dma;		// controller
+	volatile uint8*			channel;	// our channel in it
+	volatile uint8*			spdif;
+	volatile uint8*			spdifChannel;
+	bool					spdifEnabled;
+	bool					spdifInterruptInstalled;
+	int32					spdifPlaying;
+	int64					i2sBuffersDone;		// buffers each channel is
+	int64					spdifBuffersDone;	// through with
+
+	mutex					lock;
+	bool					opened;
+	bool					running;
+	bool					interruptInstalled;
+
+	area_id					bufferArea;
+	uint8*					buffers;
+	phys_addr_t				buffersPhysical;
+	uint32					bufferFrames;
+	uint32					bufferCount;
+
+	spinlock				interruptLock;
+	sem_id					bufferReadySem;
+	int32					playing;	// the buffer the DMA is reading
+	int64					framesPlayed;
+	bigtime_t				realTime;
+	uint32					interrupts;
+	uint32					i2sSourceAtBoot;
+
+	area_id					gpioArea;
+	volatile uint8*			gpioPort;	// the registers of port W
+	volatile uint8*			hdmiPort;	// and of port N
+	thread_id				jackThread;
+	volatile bool			quitJackThread;
+	int32					headphones;	// -1 not known yet
+	int32					hdmi;		// -1 not known yet
+	bool					hdmiMutesSpeaker;
+
+	// the mixer controls (Media preferences, Cortex): attenuation of the
+	// left and right channel in 1.5 dB steps (0 - 31), mute by the user
+	uint8					recordLevel[2];		// ADC gain, -16.5 dB + 1.5 dB n
+	uint8					micBoost;			// in steps of 6 dB (0 - 7)
+	int32					inputSource;		// 0 digital, 1 headset microphone
+	volatile uint8*			recordChannel;
+	bool					recordInterruptInstalled;
+	int32					recording;			// the buffer the DMA fills
+	int64					framesRecorded;
+	bigtime_t				recordTime;
+	uint8					speakerLevel[2];
+	uint8					headphoneLevel[2];
+	bool					speakerMuted;
+	bool					headphonesMuted;
+};
+
+
+struct tegra_audio_cookie {
+	tegra_audio*	audio;
+	bool			diag;
+};
+
+
+static device_manager_info* sDeviceManager;
+
+
+static inline uint32
+read32(volatile uint8* base, uint32 offset)
+{
+	return *(volatile uint32*)(base + offset);
+}
+
+
+static inline void
+write32(volatile uint8* base, uint32 offset, uint32 value)
+{
+	*(volatile uint32*)(base + offset) = value;
+}
+
+
+static area_id
+map_registers(const char* name, phys_addr_t address, volatile uint8** _base)
+{
+	void* base;
+	area_id area = map_physical_memory(name, address, B_PAGE_SIZE,
+		B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &base);
+	if (area >= B_OK)
+		*_base = (volatile uint8*)base;
+	return area;
+}
+
+
+//	#pragma mark - codec
+
+
+static status_t
+codec_write(tegra_audio* audio, uint8 reg, uint16 value)
+{
+	uint8 data[2] = { (uint8)(value >> 8), (uint8)value };
+	status_t status = audio->i2c->acquire_bus(audio->i2cCookie);
+	if (status != B_OK)
+		return status;
+	status = audio->i2c->exec_command(audio->i2cCookie, I2C_OP_WRITE_STOP,
+		&reg, 1, data, 2);
+	audio->i2c->release_bus(audio->i2cCookie);
+	if (status != B_OK)
+		TRACE_ALWAYS("codec write %#x: %s\n", reg, strerror(status));
+	return status;
+}
+
+
+static status_t
+codec_read(tegra_audio* audio, uint8 reg, uint16* _value)
+{
+	uint8 data[2];
+	status_t status = audio->i2c->acquire_bus(audio->i2cCookie);
+	if (status != B_OK)
+		return status;
+	status = audio->i2c->exec_command(audio->i2cCookie, I2C_OP_READ_STOP,
+		&reg, 1, data, 2);
+	audio->i2c->release_bus(audio->i2cCookie);
+	if (status == B_OK)
+		*_value = (data[0] << 8) | data[1];
+	return status;
+}
+
+
+static void
+codec_update(tegra_audio* audio, uint8 reg, uint16 mask, uint16 value)
+{
+	uint16 old;
+	if (codec_read(audio, reg, &old) == B_OK)
+		codec_write(audio, reg, (old & ~mask) | (value & mask));
+}
+
+
+/*!	As Linux's alc5632 driver with the PAZ00 machine driver sets it up for
+	playback: slave, I2S, 16 bit, the system clock straight from MCLK (512 fs),
+	then the bias as for SND_SOC_BIAS_ON and the DAPM path from the DAC to
+	the speaker and to the headphones.
+*/
+static status_t
+codec_init(tegra_audio* audio)
+{
+	uint16 vendor = 0, id = 0;
+	status_t status = codec_read(audio, ALC5632_VENDOR_ID1, &vendor);
+	if (status == B_OK)
+		status = codec_read(audio, ALC5632_VENDOR_ID2, &id);
+	TRACE_ALWAYS("codec id %#06x %#06x: %s\n", vendor, id, strerror(status));
+	if (status != B_OK)
+		return status;
+	if (vendor != 0x10ec || (id >> 8) != 0x5c)
+		return B_DEVICE_NOT_FOUND;
+
+	codec_write(audio, ALC5632_RESET, 0x59b4);
+	snooze(10000);
+
+	// slave, I2S, 16 bit; system clock from MCLK, 512 fs
+	codec_write(audio, ALC5632_DAI_CONTROL, 1U << 15);
+	codec_update(audio, ALC5632_GPCR1, 1U << 15, 0);
+	codec_write(audio, ALC5632_DAC_CLK_CTRL1, 0x3075);
+
+	// bias on, with the headphone depop sequence
+	codec_update(audio, ALC5632_PWR_MANAG_ADD1, 1U << 6, 1U << 6);
+		// soft generator
+	codec_update(audio, ALC5632_PWR_MANAG_ADD3, 1U << 1, 1U << 1);
+	codec_update(audio, ALC5632_MISC_CTRL, 1U << 8, 1U << 8);
+		// depop mode 2
+	codec_update(audio, ALC5632_PWR_DOWN_CTRL_STATUS, 0xef00, 0);
+	snooze(500000);
+	codec_update(audio, ALC5632_PWR_MANAG_ADD2, 1U << 13, 1U << 13);
+		// VREF
+	codec_update(audio, ALC5632_PWR_MANAG_ADD1, 0x0343, 0x0343);
+		// DAC reference, soft generator, headphone amplifiers, main bias
+	codec_update(audio, ALC5632_MISC_CTRL, 1U << 8, 0);
+
+	// DACs into the speaker mixer and the headphone mixers (the switches mute
+	// when set)
+	codec_update(audio, ALC5632_MIC_ROUTING_CTRL, 0x000e, 0);
+	// speaker: N output RP/+R, class AB amplifier, from the headphone
+	// mixers, as the Android port of the AC100 routes it; headphones from
+	// their mixers
+	codec_write(audio, ALC5632_OUTPUT_MIXER_CTRL, 0x4708);
+
+	// power: DAC channels, I2S, speaker amplifier; DAC clocks, mixers;
+	// speaker and headphone outputs
+	codec_update(audio, ALC5632_PWR_MANAG_ADD1, 0xcc00, 0xcc00);
+	codec_update(audio, ALC5632_PWR_MANAG_ADD2, 0x0338, 0x0338);
+	// the class AB amplifier
+	codec_update(audio, ALC5632_PWR_MANAG_ADD2, 3U << 14, 1U << 15);
+	codec_update(audio, ALC5632_PWR_MANAG_ADD3, 0x3c00, 0x3c00);
+
+	// volumes (0 is the loudest, steps of 1.5 dB) and unmute
+	codec_write(audio, ALC5632_SPK_OUT_VOL, 0x0404);
+	codec_write(audio, ALC5632_HP_OUT_VOL, 0x0404);
+	codec_write(audio, ALC5632_STEREO_DAC_IN_VOL, 0x1010);
+	codec_update(audio, ALC5632_MISC_CTRL, 0x00c0, 0);
+
+	static const uint8 kShown[] = { 0x02, 0x04, 0x0c, 0x10, 0x1c, 0x26, 0x34,
+		0x3a, 0x3c, 0x3e, 0x40, 0x5e, 0x60 };
+	char text[256];
+	size_t length = 0;
+	for (uint32 i = 0; i < B_COUNT_OF(kShown); i++) {
+		uint16 value = 0;
+		codec_read(audio, kShown[i], &value);
+		length += snprintf(text + length, sizeof(text) - length, " %02x=%04x",
+			kShown[i], value);
+	}
+	TRACE_ALWAYS("codec:%s\n", text);
+	return B_OK;
+}
+
+
+/*!	The ADC records the digital microphone or the headset one (MIC1, with
+	its bias), as the PAZ00 routing of Linux has them; its gain is the
+	record level. Called with the lock held.
+*/
+static void
+set_input(tegra_audio* audio)
+{
+	bool digital = audio->inputSource == 0;
+	uint8 boost = audio->micBoost & 7;
+
+	// the gain of the ADC: 5 bits per channel
+	uint16 gain;
+	if (codec_read(audio, ALC5632_ADC_REC_GAIN, &gain) == B_OK) {
+		gain = (gain & ~0x1f1f) | ((audio->recordLevel[0] & 0x1f) << 8)
+			| (audio->recordLevel[1] & 0x1f);
+		codec_write(audio, ALC5632_ADC_REC_GAIN, gain);
+	}
+	// the stereo ADC on the I2S output
+	codec_update(audio, ALC5632_I2S_OUT_CTL, 1U << 5, 0);
+
+	if (digital) {
+		// digital microphone on, into both ADC channels (the routing bits
+		// mute when set), its boost in steps of 6 dB
+		codec_write(audio, ALC5632_DIGI_BOOST_CTRL, (1U << 15) | boost);
+		codec_write(audio, ALC5632_ADC_REC_MIXER, 0x7f7f);
+		codec_update(audio, ALC5632_PWR_MANAG_ADD1, 1U << 3, 0);
+		codec_update(audio, ALC5632_PWR_MANAG_ADD2, 0x00c3, 0x00c0);
+		codec_update(audio, ALC5632_PWR_MANAG_ADD3, 1U << 3, 0);
+	} else {
+		// MIC1 with its bias and boost (0, 20, 30 or 40 dB) into the record
+		// mixers
+		uint16 micBoost = boost == 0 ? 0 : boost <= 3 ? 1 : boost <= 5 ? 2 : 3;
+		codec_write(audio, ALC5632_DIGI_BOOST_CTRL, 0x00c0);
+		codec_update(audio, ALC5632_MIC_CTRL, 3U << 10, micBoost << 10);
+		codec_write(audio, ALC5632_ADC_REC_MIXER,
+			0x7f7f & ~((1U << 14) | (1U << 6)));
+		codec_update(audio, ALC5632_PWR_MANAG_ADD1, 1U << 3, 1U << 3);
+		codec_update(audio, ALC5632_PWR_MANAG_ADD2, 0x00c3, 0x00c3);
+		codec_update(audio, ALC5632_PWR_MANAG_ADD3, 0x000a, 0x000a);
+	}
+	TRACE_ALWAYS("recording the %s microphone, gain %u, boost %u\n",
+		digital ? "built-in" : "headset", audio->recordLevel[0], boost);
+}
+
+
+/*!	A volume register of the ALC5632: attenuation of the left channel in
+	bits 12-8 and of the right one in bits 4-0, mutes in bits 15 and 7.
+*/
+static uint16
+codec_volume(const uint8* level, bool mute)
+{
+	return (mute ? 0x8080 : 0) | ((level[0] & 0x1f) << 8) | (level[1] & 0x1f);
+}
+
+
+/*!	The speaker is off while headphones are plugged in, as the PAZ00 machine
+	driver of Linux does with its jack and the "Int Spk" pin, and while an
+	HDMI screen is (the sound goes there through S/PDIF), or when the user
+	muted it. Called with the lock held.
+*/
+static void
+set_outputs(tegra_audio* audio)
+{
+	bool hdmi = audio->hdmi > 0 && audio->hdmiMutesSpeaker
+		&& audio->spdifEnabled;
+	bool mute = audio->headphones > 0 || hdmi || audio->speakerMuted;
+	codec_write(audio, ALC5632_SPK_OUT_VOL,
+		codec_volume(audio->speakerLevel, mute));
+	codec_write(audio, ALC5632_HP_OUT_VOL,
+		codec_volume(audio->headphoneLevel, audio->headphonesMuted));
+	TRACE_ALWAYS("headphones %s, HDMI %s, speaker %s\n",
+		audio->headphones > 0 ? "plugged in" : "unplugged",
+		audio->hdmi > 0 ? "plugged in" : "unplugged", mute ? "muted" : "on");
+}
+
+
+static status_t
+jack_thread(void* data)
+{
+	tegra_audio* audio = (tegra_audio*)data;
+	while (!audio->quitJackThread) {
+		int32 plugged = (read32(audio->gpioPort, GPIO_IN) & HP_DETECT_BIT) != 0;
+		int32 hdmi = (read32(audio->hdmiPort, GPIO_IN) & HDMI_DETECT_BIT) != 0;
+		if (plugged != audio->headphones || hdmi != audio->hdmi) {
+			MutexLocker locker(audio->lock);
+			audio->headphones = plugged;
+			audio->hdmi = hdmi;
+			set_outputs(audio);
+		}
+		snooze(HP_POLL_INTERVAL);
+	}
+	return B_OK;
+}
+
+
+static void
+start_jack_detection(tegra_audio* audio)
+{
+	audio->gpioArea = map_registers("tegra gpio", GPIO_BASE, &audio->gpioPort);
+	if (audio->gpioArea < B_OK)
+		return;
+	audio->hdmiPort = audio->gpioPort + GPIO_PORT_OFFSET(GPIO_PORT_N);
+	audio->gpioPort += GPIO_PORT_OFFSET(GPIO_PORT_W);
+
+	// a GPIO, as an input
+	write32(audio->gpioPort, GPIO_OE,
+		read32(audio->gpioPort, GPIO_OE) & ~HP_DETECT_BIT);
+	write32(audio->gpioPort, GPIO_CNF,
+		read32(audio->gpioPort, GPIO_CNF) | HP_DETECT_BIT);
+
+	audio->headphones = -1;
+	audio->hdmi = -1;
+	audio->jackThread = spawn_kernel_thread(jack_thread, "tegra audio jack",
+		B_LOW_PRIORITY, audio);
+	if (audio->jackThread >= B_OK)
+		resume_thread(audio->jackThread);
+}
+
+
+//	#pragma mark - Tegra side
+
+
+/*!	The source (bits 31-30) and the divisor in 7.1 fixed point (bits 7-0)
+	of an I2S CLK_SOURCE register, with the master clock enabled: without
+	it the controller does not shift anything out as the master.
+*/
+static inline uint32
+i2s_clock_source(uint32 value, uint32 source, uint32 divisor)
+{
+	return (value & ~((3U << 30) | 0xff)) | (source << 30)
+		| CLK_SOURCE_I2S_MASTER_CLKEN | (2 * (divisor - 1));
+}
+
+
+static void
+set_clock(tegra_audio* audio, uint32 clock, bool enable)
+{
+	uint32 offset = CAR_CLK_OUT_ENB(clock / 32);
+	uint32 bit = 1U << (clock % 32);
+	uint32 value = read32(audio->car, offset);
+	write32(audio->car, offset, enable ? value | bit : value & ~bit);
+}
+
+
+static void
+set_reset(tegra_audio* audio, uint32 clock, bool reset)
+{
+	uint32 offset = CAR_RST_DEVICES(clock / 32);
+	uint32 bit = 1U << (clock % 32);
+	uint32 value = read32(audio->car, offset);
+	write32(audio->car, offset, reset ? value | bit : value & ~bit);
+}
+
+
+/*!	PLL A at 56.448 MHz from PLL P out 1 (28.8 MHz), its output 0 at
+	22.5792 MHz (512 x 44.1 kHz) for the codec on CDEV1, I2S1 at 2.8224 MHz
+	(twice its bit clock) from it.
+*/
+static status_t
+setup_clocks(tegra_audio* audio)
+{
+	uint32 pllpOutA = read32(audio->car, CAR_PLLP_OUTA);
+	if ((pllpOutA & 0xffff) != ((13 << 8) | 7)) {
+		// out 1: 216 MHz / 7.5, override, clock enable, out of reset
+		write32(audio->car, CAR_PLLP_OUTA,
+			(pllpOutA & 0xffff0000) | (13 << 8) | 7);
+	}
+
+	uint32 base = read32(audio->car, CAR_PLLA_BASE);
+	uint32 wanted = (49 << 8) | 25;		// N = 49, M = 25, P = 1
+	if ((base & PLL_BASE_ENABLE) == 0 || (base & PLL_BASE_BYPASS) != 0
+		|| (base & 0x7fff1f) != wanted) {
+		write32(audio->car, CAR_PLLA_BASE, PLL_BASE_BYPASS | wanted);
+		uint32 misc = read32(audio->car, CAR_PLLA_MISC);
+		misc &= ~(0xfU << PLL_MISC_CPCON_SHIFT);
+		write32(audio->car, CAR_PLLA_MISC, misc | (1 << PLL_MISC_CPCON_SHIFT)
+			| PLL_MISC_LOCK_ENABLE);
+		write32(audio->car, CAR_PLLA_BASE,
+			PLL_BASE_BYPASS | PLL_BASE_ENABLE | wanted);
+		bigtime_t timeout = system_time() + 2000;
+		while ((read32(audio->car, CAR_PLLA_BASE) & PLL_BASE_LOCK) == 0
+			&& system_time() < timeout) {
+			spin(10);
+		}
+		write32(audio->car, CAR_PLLA_BASE, PLL_BASE_ENABLE | wanted);
+	}
+	// out 0: divided by 2.5 (2 * (2.5 - 1) in 7.1 fixed point), enabled
+	write32(audio->car, CAR_PLLA_OUT, (3 << 8) | 3);
+
+	// I2S1 from PLL A out 0, divided by 8; only the source and the divisor
+	// are ours to change, the other bits keep their reset values
+	set_clock(audio, CLOCK_I2S1, true);
+	audio->i2sSourceAtBoot = read32(audio->car, CAR_CLK_SOURCE_I2S1);
+	write32(audio->car, CAR_CLK_SOURCE_I2S1,
+		i2s_clock_source(audio->i2sSourceAtBoot, 0, 8));
+	set_reset(audio, CLOCK_I2S1, true);
+	spin(10);
+	set_reset(audio, CLOCK_I2S1, false);
+
+	// the codec's master clock
+	set_clock(audio, CLOCK_CDEV1, true);
+
+	set_clock(audio, CLOCK_APBDMA, true);
+	set_reset(audio, CLOCK_APBDMA, false);
+
+	TRACE_ALWAYS("clocks: PLL P out A %#" B_PRIx32 " -> %#" B_PRIx32
+		", PLL A %#" B_PRIx32 " -> %#" B_PRIx32 " (misc %#" B_PRIx32
+		"), out %#" B_PRIx32 ", I2S1 %#" B_PRIx32 " -> %#" B_PRIx32 "\n",
+		pllpOutA, read32(audio->car, CAR_PLLP_OUTA), base,
+		read32(audio->car, CAR_PLLA_BASE), read32(audio->car, CAR_PLLA_MISC),
+		read32(audio->car, CAR_PLLA_OUT), audio->i2sSourceAtBoot,
+		read32(audio->car, CAR_CLK_SOURCE_I2S1));
+	return (read32(audio->car, CAR_PLLA_BASE) & PLL_BASE_LOCK) != 0
+		? B_OK : B_TIMED_OUT;
+}
+
+
+static void
+setup_pins_and_das(tegra_audio* audio)
+{
+	uint32 tristate = read32(audio->misc, PINMUX_TRISTATE_A);
+	uint32 mux = read32(audio->misc, PINMUX_CTL_C);
+	write32(audio->misc, PINMUX_CTL_C, (mux
+		& ~((3U << PINMUX_CDEV1_SHIFT) | (3U << PINMUX_DAP1_SHIFT)))
+		| (1U << PINMUX_CDEV1_SHIFT));
+	write32(audio->misc, PINMUX_TRISTATE_A,
+		tristate & ~(PINMUX_TRISTATE_CDEV1 | PINMUX_TRISTATE_DAP1));
+
+	// DAP1 <-> DAC1 (I2S1)
+	uint32 dap = read32(audio->misc, DAS_DAP_CTRL_SEL(0));
+	uint32 dac = read32(audio->misc, DAS_DAC_INPUT_DATA_CLK_SEL(0));
+	write32(audio->misc, DAS_DAP_CTRL_SEL(0), 0);
+	write32(audio->misc, DAS_DAC_INPUT_DATA_CLK_SEL(0), 0);
+
+	TRACE_ALWAYS("pins: tristate %#" B_PRIx32 " -> %#" B_PRIx32 ", mux %#"
+		B_PRIx32 " -> %#" B_PRIx32 "; DAS: DAP1 %#" B_PRIx32 ", DAC1 %#"
+		B_PRIx32 "\n", tristate, read32(audio->misc, PINMUX_TRISTATE_A), mux,
+		read32(audio->misc, PINMUX_CTL_C), dap, dac);
+}
+
+
+static void
+setup_i2s(tegra_audio* audio)
+{
+	write32(audio->i2s, I2S_CTRL, I2S_CTRL_MASTER_ENABLE
+		| I2S_CTRL_BIT_FORMAT_I2S | I2S_CTRL_BIT_SIZE_16
+		| I2S_CTRL_FIFO_FORMAT_PACKED);
+	// bit clock count per channel: 2.8224 MHz / (2 * 44.1 kHz) - 1
+	write32(audio->i2s, I2S_TIMING, 31);
+	write32(audio->i2s, I2S_FIFO_SCR, I2S_FIFO_SCR_ATN_FOUR_SLOTS);
+}
+
+
+/*!	S/PDIF output at 44.1 kHz, 16 bit stereo packed in one word per frame
+	as in the buffers: PLL A out 0 (22.5792 MHz) divided by 4.
+*/
+static void
+setup_spdif(tegra_audio* audio)
+{
+	// source 0 is PLL A out 0; the divisor is 7.1 fixed point, minus 1
+	write32(audio->car, CAR_CLK_SOURCE_SPDIF_OUT, 2 * (4 - 1));
+	set_clock(audio, CLOCK_SPDIF, true);
+	set_reset(audio, CLOCK_SPDIF, true);
+	spin(10);
+	set_reset(audio, CLOCK_SPDIF, false);
+
+	// Consumer channel status of linear PCM at 44.1 kHz (sample frequency
+	// code 0 in bits 27-24 of the first word), as the NVIDIA driver sends
+	for (int32 i = 0; i < 6; i++)
+		write32(audio->spdif, SPDIF_CH_STA_TX(i), 0);
+	write32(audio->spdif, SPDIF_CTRL, SPDIF_CTRL_PACK
+		| SPDIF_CTRL_BIT_MODE_16);
+	write32(audio->spdif, SPDIF_DATA_FIFO_CSR, SPDIF_FIFO_TX_ATN_FOUR_SLOTS);
+}
+
+
+//	#pragma mark - DMA
+
+
+static inline phys_addr_t
+buffer_physical(tegra_audio* audio, int32 index)
+{
+	return audio->buffersPhysical
+		+ (phys_addr_t)index * audio->bufferFrames * FRAME_SIZE;
+}
+
+
+/*!	The record buffers follow the playback ones in the same area. */
+static inline phys_addr_t
+record_physical(tegra_audio* audio, int32 index)
+{
+	return buffer_physical(audio, audio->bufferCount + index);
+}
+
+
+static int32
+record_dma_interrupt(void* data)
+{
+	tegra_audio* audio = (tegra_audio*)data;
+	uint32 status = read32(audio->recordChannel, DMA_STATUS);
+	if ((status & DMA_STATUS_EOC) == 0)
+		return B_UNHANDLED_INTERRUPT;
+	write32(audio->recordChannel, DMA_STATUS, status);
+
+	acquire_spinlock(&audio->interruptLock);
+	audio->recording = (audio->recording + 1) % audio->bufferCount;
+	write32(audio->recordChannel, DMA_AHB_PTR, record_physical(audio,
+		(audio->recording + 1) % audio->bufferCount));
+	audio->framesRecorded += audio->bufferFrames;
+	audio->recordTime = system_time();
+	release_spinlock(&audio->interruptLock);
+	return B_HANDLED_INTERRUPT;
+}
+
+
+static int32
+dma_interrupt(void* data)
+{
+	tegra_audio* audio = (tegra_audio*)data;
+	uint32 status = read32(audio->channel, DMA_STATUS);
+	if ((status & DMA_STATUS_EOC) == 0)
+		return B_UNHANDLED_INTERRUPT;
+	write32(audio->channel, DMA_STATUS, status);
+		// clears the end of count
+
+	acquire_spinlock(&audio->interruptLock);
+	audio->interrupts++;
+	// the DMA went on with the buffer programmed as the next one; the one
+	// after it is the one that just finished
+	audio->playing = (audio->playing + 1) % audio->bufferCount;
+	write32(audio->channel, DMA_AHB_PTR, buffer_physical(audio,
+		(audio->playing + 1) % audio->bufferCount));
+	audio->framesPlayed += audio->bufferFrames;
+	audio->realTime = system_time();
+	// The buffer just finished goes back to the media server, which fills
+	// it at once: with S/PDIF, only when that channel is through with it too
+	audio->i2sBuffersDone++;
+	bool release = !audio->spdifEnabled
+		|| audio->spdifBuffersDone >= audio->i2sBuffersDone;
+	release_spinlock(&audio->interruptLock);
+
+	if (!release)
+		return B_HANDLED_INTERRUPT;
+	release_sem_etc(audio->bufferReadySem, 1, B_DO_NOT_RESCHEDULE);
+	return B_INVOKE_SCHEDULER;
+}
+
+
+/*!	The S/PDIF channel follows the buffers on its own: it only needs the
+	address of the buffer after the one it just started.
+*/
+static int32
+spdif_dma_interrupt(void* data)
+{
+	tegra_audio* audio = (tegra_audio*)data;
+	uint32 status = read32(audio->spdifChannel, DMA_STATUS);
+	if ((status & DMA_STATUS_EOC) == 0)
+		return B_UNHANDLED_INTERRUPT;
+	write32(audio->spdifChannel, DMA_STATUS, status);
+
+	acquire_spinlock(&audio->interruptLock);
+	audio->spdifPlaying = (audio->spdifPlaying + 1) % audio->bufferCount;
+	write32(audio->spdifChannel, DMA_AHB_PTR, buffer_physical(audio,
+		(audio->spdifPlaying + 1) % audio->bufferCount));
+	// I2S got there first: the buffer goes back now
+	audio->spdifBuffersDone++;
+	bool release = audio->spdifBuffersDone <= audio->i2sBuffersDone;
+	release_spinlock(&audio->interruptLock);
+
+	if (!release)
+		return B_HANDLED_INTERRUPT;
+	release_sem_etc(audio->bufferReadySem, 1, B_DO_NOT_RESCHEDULE);
+	return B_INVOKE_SCHEDULER;
+}
+
+
+static void
+start_spdif_dma(tegra_audio* audio)
+{
+	audio->spdifPlaying = 0;
+	audio->spdifBuffersDone = 0;
+	write32(audio->dma, APBDMA_IRQ_MASK_SET, 1U << SPDIF_DMA_CHANNEL);
+
+	volatile uint8* channel = audio->spdifChannel;
+	uint32 csr = DMA_CSR_DIR_TO_DEVICE | DMA_CSR_FLOW | DMA_CSR_IE_EOC
+		| (SPDIF_DMA_REQUEST << DMA_CSR_REQ_SEL_SHIFT)
+		| ((audio->bufferFrames * FRAME_SIZE - 4) & 0xfffc);
+	write32(channel, DMA_CSR, csr);
+	write32(channel, DMA_STATUS, read32(channel, DMA_STATUS));
+	write32(channel, DMA_APB_SEQ,
+		DMA_APB_SEQ_BUS_WIDTH_32 | DMA_APB_SEQ_WRAP_WORD_1);
+	write32(channel, DMA_APB_PTR, SPDIF_BASE + SPDIF_DATA_OUT);
+	write32(channel, DMA_AHB_SEQ, DMA_AHB_SEQ_INTR_ENABLE
+		| DMA_AHB_SEQ_BUS_WIDTH_32 | DMA_AHB_SEQ_BURST_4);
+	write32(channel, DMA_AHB_PTR, buffer_physical(audio, 0));
+	write32(audio->spdif, SPDIF_DATA_FIFO_CSR,
+		SPDIF_FIFO_TX_ATN_FOUR_SLOTS | SPDIF_FIFO_TX_CLR);
+	write32(channel, DMA_CSR, csr | DMA_CSR_ENABLE);
+	write32(channel, DMA_AHB_PTR,
+		buffer_physical(audio, 1 % audio->bufferCount));
+}
+
+
+static void
+start_playback(tegra_audio* audio)
+{
+	if (audio->running)
+		return;
+
+	audio->playing = 0;
+	audio->i2sBuffersDone = 0;
+	audio->framesPlayed = 0;
+	audio->realTime = system_time();
+
+	write32(audio->dma, APBDMA_GENERAL, APBDMA_GENERAL_ENABLE);
+	write32(audio->dma, APBDMA_IRQ_MASK_SET, 1U << APBDMA_CHANNEL);
+
+	uint32 csr = DMA_CSR_DIR_TO_DEVICE | DMA_CSR_FLOW | DMA_CSR_IE_EOC
+		| (I2S_DMA_REQUEST << DMA_CSR_REQ_SEL_SHIFT)
+		| ((audio->bufferFrames * FRAME_SIZE - 4) & 0xfffc);
+	write32(audio->channel, DMA_CSR, csr);
+	write32(audio->channel, DMA_STATUS, read32(audio->channel, DMA_STATUS));
+	write32(audio->channel, DMA_APB_SEQ,
+		DMA_APB_SEQ_BUS_WIDTH_32 | DMA_APB_SEQ_WRAP_WORD_1);
+	write32(audio->channel, DMA_APB_PTR, I2S1_BASE + I2S_FIFO1);
+	write32(audio->channel, DMA_AHB_SEQ, DMA_AHB_SEQ_INTR_ENABLE
+		| DMA_AHB_SEQ_BUS_WIDTH_32 | DMA_AHB_SEQ_BURST_4);
+	write32(audio->channel, DMA_AHB_PTR, buffer_physical(audio, 0));
+	write32(audio->channel, DMA_CSR, csr | DMA_CSR_ENABLE);
+	// taken over once the first buffer is done (continuous mode)
+	write32(audio->channel, DMA_AHB_PTR,
+		buffer_physical(audio, 1 % audio->bufferCount));
+	if (audio->spdifEnabled)
+		start_spdif_dma(audio);
+
+	// recording, from the I2S1 receive FIFO into the record buffers
+	if (audio->recordInterruptInstalled) {
+		audio->recording = 0;
+		audio->framesRecorded = 0;
+		audio->recordTime = system_time();
+		write32(audio->dma, APBDMA_IRQ_MASK_SET, 1U << RECORD_DMA_CHANNEL);
+		volatile uint8* channel = audio->recordChannel;
+		uint32 recordCsr = DMA_CSR_FLOW | DMA_CSR_IE_EOC
+			| (I2S_DMA_REQUEST << DMA_CSR_REQ_SEL_SHIFT)
+			| ((audio->bufferFrames * FRAME_SIZE - 4) & 0xfffc);
+			// direction: from the device
+		write32(channel, DMA_CSR, recordCsr);
+		write32(channel, DMA_STATUS, read32(channel, DMA_STATUS));
+		write32(channel, DMA_APB_SEQ,
+			DMA_APB_SEQ_BUS_WIDTH_32 | DMA_APB_SEQ_WRAP_WORD_1);
+		write32(channel, DMA_APB_PTR, I2S1_BASE + I2S_FIFO2);
+		write32(channel, DMA_AHB_SEQ, DMA_AHB_SEQ_INTR_ENABLE
+			| DMA_AHB_SEQ_BUS_WIDTH_32 | DMA_AHB_SEQ_BURST_4);
+		write32(channel, DMA_AHB_PTR, record_physical(audio, 0));
+		write32(channel, DMA_CSR, recordCsr | DMA_CSR_ENABLE);
+		write32(channel, DMA_AHB_PTR,
+			record_physical(audio, 1 % audio->bufferCount));
+	}
+
+	write32(audio->i2s, I2S_FIFO_SCR, I2S_FIFO_SCR_ATN_FOUR_SLOTS
+		| I2S_FIFO_SCR_FIFO1_CLR | I2S_FIFO_SCR_FIFO2_CLR);
+	if (audio->spdifEnabled) {
+		// the DMA fills the S/PDIF FIFO first (TRM 27.3.3.7)
+		spin(20);
+		// TC_EN (channel status) made a television lose the picture
+		write32(audio->spdif, SPDIF_CTRL,
+			read32(audio->spdif, SPDIF_CTRL) | SPDIF_CTRL_TX_EN);
+	}
+	write32(audio->i2s, I2S_CTRL, read32(audio->i2s, I2S_CTRL)
+		| I2S_CTRL_FIFO1_ENABLE
+		| (audio->recordInterruptInstalled ? I2S_CTRL_FIFO2_ENABLE : 0));
+
+	audio->running = true;
+}
+
+
+static void
+stop_playback(tegra_audio* audio)
+{
+	if (!audio->running)
+		return;
+
+	write32(audio->i2s, I2S_CTRL, read32(audio->i2s, I2S_CTRL)
+		& ~(I2S_CTRL_FIFO1_ENABLE | I2S_CTRL_FIFO2_ENABLE));
+	if (audio->recordInterruptInstalled) {
+		write32(audio->recordChannel, DMA_CSR,
+			read32(audio->recordChannel, DMA_CSR)
+				& ~(DMA_CSR_ENABLE | DMA_CSR_IE_EOC));
+		write32(audio->recordChannel, DMA_STATUS,
+			read32(audio->recordChannel, DMA_STATUS));
+	}
+	write32(audio->channel, DMA_CSR, read32(audio->channel, DMA_CSR)
+		& ~(DMA_CSR_ENABLE | DMA_CSR_IE_EOC));
+	write32(audio->channel, DMA_STATUS, read32(audio->channel, DMA_STATUS));
+	if (audio->spdifEnabled) {
+		write32(audio->spdif, SPDIF_CTRL, read32(audio->spdif, SPDIF_CTRL)
+			& ~(SPDIF_CTRL_TC_EN | SPDIF_CTRL_TX_EN));
+		write32(audio->spdifChannel, DMA_CSR,
+			read32(audio->spdifChannel, DMA_CSR)
+				& ~(DMA_CSR_ENABLE | DMA_CSR_IE_EOC));
+		write32(audio->spdifChannel, DMA_STATUS,
+			read32(audio->spdifChannel, DMA_STATUS));
+	}
+	audio->running = false;
+}
