+//	#pragma mark - diagnostics
+
+
+static bool
+diag_address_allowed(uint32 address)
+{
+	// the peripheral registers only: clocks, GPIO, DMA, AHB; pin mux, DAS,
+	// I2S, I2C, ...
+	return (address & 3) == 0
+		&& ((address >= 0x60000000 && address < 0x60010000)
+			|| (address >= 0x70000000 && address < 0x70010000));
+}
+
+
+static status_t
+diag_access32(uint32 address, uint32* value, bool write)
+{
+	if (!diag_address_allowed(address))
+		return B_NOT_ALLOWED;
+
+	void* page;
+	area_id area = map_physical_memory("tegra audio diag",
+		address & ~(B_PAGE_SIZE - 1), B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &page);
+	if (area < B_OK)
+		return area;
+
+	volatile uint32* reg = (volatile uint32*)((uint8*)page
+		+ (address & (B_PAGE_SIZE - 1)));
+	if (write)
+		*reg = *value;
+	else
+		*value = *reg;
+
+	delete_area(area);
+	return B_OK;
+}
+
+
+/*!	Plays a square wave through the whole chain, as long as the media server
+	does not use the device.
+*/
+static status_t
+diag_tone(tegra_audio* audio, uint32 ms, uint32 period, uint32 amplitude,
+	uint32 channels, uint32* _interrupts)
+{
+	MutexLocker locker(audio->lock);
+	if (audio->running)
+		return B_BUSY;
+
+	if (ms == 0 || ms > 10000)
+		ms = 1500;
+	if (period < 2)
+		period = 64;
+	if (amplitude > 32767)
+		amplitude = 32767;
+
+	status_t status = create_buffers(audio, audio->bufferArea >= B_OK
+		? audio->bufferFrames : DEFAULT_BUFFER_FRAMES,
+		audio->bufferArea >= B_OK ? audio->bufferCount : BUFFER_COUNT);
+	if (status != B_OK)
+		return status;
+
+	int16* samples = (int16*)audio->buffers;
+	uint32 frames = audio->bufferFrames * audio->bufferCount;
+	for (uint32 i = 0; i < frames; i++) {
+		int16 value = (i % period) < period / 2
+			? (int16)amplitude : -(int16)amplitude;
+		samples[i * 2] = (channels & 1) != 0 ? value : 0;
+		samples[i * 2 + 1] = (channels & 2) != 0 ? value : 0;
+	}
+
+	audio->interrupts = 0;
+	start_playback(audio);
+	snooze(ms * 1000LL);
+	*_interrupts = audio->interrupts;
+	stop_playback(audio);
+
+	memset(audio->buffers, 0, frames * FRAME_SIZE);
+	return B_OK;
+}
+
+
+static status_t
+diag_control(tegra_audio* audio, void* arg, size_t length)
+{
+	tegra_audio_diag request;
+	if (length < sizeof(request) || !IS_USER_ADDRESS(arg)
+		|| user_memcpy(&request, arg, sizeof(request)) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+
+	status_t status = B_OK;
+	memset(request.result, 0, sizeof(request.result));
+	switch (request.command) {
+		case TEGRA_DIAG_READ32:
+			status = diag_access32(request.args[0], &request.result[0], false);
+			break;
+		case TEGRA_DIAG_WRITE32:
+			status = diag_access32(request.args[0], &request.args[1], true);
+			break;
+		case TEGRA_DIAG_CODEC_READ:
+		{
+			uint16 value = 0;
+			status = codec_read(audio, request.args[0], &value);
+			request.result[0] = value;
+			break;
+		}
+		case TEGRA_DIAG_CODEC_WRITE:
+			status = codec_write(audio, request.args[0], request.args[1]);
+			break;
+		case TEGRA_DIAG_TONE:
+			status = diag_tone(audio, request.args[0], request.args[1],
+				request.args[2], request.args[3], &request.result[0]);
+			break;
+		case TEGRA_DIAG_STATUS:
+		{
+			MutexLocker locker(audio->lock);
+			request.result[0] = audio->opened;
+			request.result[1] = audio->running;
+			request.result[2] = audio->bufferFrames;
+			request.result[3] = audio->bufferCount;
+			break;
+		}
+		default:
+			return B_BAD_VALUE;
+	}
+
+	if (user_memcpy(arg, &request, sizeof(request)) != B_OK)
+		return B_BAD_ADDRESS;
+	return status;
+}
