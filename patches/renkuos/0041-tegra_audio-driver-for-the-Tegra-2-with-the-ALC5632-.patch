+/*!	Diagnostics: plays a short tone through the whole chain and logs what
+	the DMA and the I2S controller did.
+*/
+static uint32
+run_self_test(tegra_audio* audio, const char* name)
+{
+	audio->interrupts = 0;
+	start_playback(audio);
+
+	// how far the DMA gets: its remaining count, over time
+	uint32 counts[3];
+	for (int i = 0; i < 3; i++) {
+		snooze(100000);
+		counts[i] = read32(audio->channel, DMA_STATUS);
+	}
+	uint32 i2sStatus = read32(audio->i2s, I2S_STATUS);
+	uint32 i2sControl = read32(audio->i2s, I2S_CTRL);
+	uint32 fifoControl = read32(audio->i2s, I2S_FIFO_SCR);
+	uint32 interrupts = audio->interrupts;
+	stop_playback(audio);
+
+	TRACE_ALWAYS("self test (%s): %" B_PRIu32 " DMA interrupts in 300 ms"
+		" (expected about 13), DMA status %#" B_PRIx32 " %#" B_PRIx32 " %#"
+		B_PRIx32 ", I2S status %#" B_PRIx32 ", ctrl %#" B_PRIx32 ", fifo %#"
+		B_PRIx32 ", timing %#" B_PRIx32 "\n", name, interrupts, counts[0],
+		counts[1], counts[2], i2sStatus, i2sControl, fifoControl,
+		read32(audio->i2s, I2S_TIMING));
+	return interrupts;
+}
+
+
+/*!	Diagnostics: feeds the transmit FIFO of an I2S controller from the CPU,
+	without DMA, and logs how fast it drains (44100 words a second when the
+	controller shifts the data out) and, with the internal loopback, how
+	much of it arrives in the receive FIFO.
+*/
+static void
+run_fifo_test(volatile uint8* i2s, const char* name, bool loopback)
+{
+	uint32 control = I2S_CTRL_MASTER_ENABLE | I2S_CTRL_BIT_FORMAT_I2S
+		| I2S_CTRL_BIT_SIZE_16 | I2S_CTRL_FIFO_FORMAT_PACKED;
+	if (loopback)
+		control |= I2S_CTRL_FIFO_LPBK_ENABLE | I2S_CTRL_FIFO2_ENABLE;
+	write32(i2s, I2S_CTRL, control);
+	write32(i2s, I2S_TIMING, 31);
+	write32(i2s, I2S_FIFO_SCR, I2S_FIFO_SCR_ATN_FOUR_SLOTS
+		| I2S_FIFO_SCR_FIFO1_CLR | I2S_FIFO_SCR_FIFO2_CLR);
+	uint32 clearedScr = read32(i2s, I2S_FIFO_SCR);
+	uint32 clearedStatus = read32(i2s, I2S_STATUS);
+
+	write32(i2s, I2S_CTRL, control | I2S_CTRL_FIFO1_ENABLE);
+
+	// write a word whenever the FIFO takes one, for 50 ms
+	uint32 written = 0;
+	uint32 polls = 0;
+	bigtime_t start = system_time();
+	bigtime_t end = start + 50000;
+	while (system_time() < end) {
+		polls++;
+		if (I2S_FIFO_SCR_FIFO1_COUNT(read32(i2s, I2S_FIFO_SCR)) != 0) {
+			write32(i2s, I2S_FIFO1, (written & 32) != 0
+				? 0x07d007d0 : 0xf830f830);
+			written++;
+		}
+	}
+	uint32 scr = read32(i2s, I2S_FIFO_SCR);
+	uint32 status = read32(i2s, I2S_STATUS);
+	snooze(10000);
+	uint32 laterScr = read32(i2s, I2S_FIFO_SCR);
+	uint32 received = 0;
+	if (loopback) {
+		while (received < 64 && I2S_FIFO_SCR_FIFO2_COUNT(
+				read32(i2s, I2S_FIFO_SCR)) != 0) {
+			read32(i2s, I2S_FIFO2);
+			received++;
+		}
+	}
+	write32(i2s, I2S_CTRL, control & ~(I2S_CTRL_FIFO_LPBK_ENABLE
+		| I2S_CTRL_FIFO2_ENABLE));
+
+	TRACE_ALWAYS("FIFO test (%s%s): %" B_PRIu32 " words taken in 50 ms (%"
+		B_PRIu32 " polls; 32 to fill it, about 2205 more if it runs), cleared: scr %#" B_PRIx32
+		" status %#" B_PRIx32 "; after: scr %#" B_PRIx32 " status %#" B_PRIx32
+		", 10 ms later scr %#" B_PRIx32 ", received %" B_PRIu32 "\n", name,
+		loopback ? ", loopback" : "", written, polls, clearedScr,
+		clearedStatus, scr, status, laterScr, received);
+}
+
+
+/*!	Diagnostics: does the controller reset and take its clock? Checks
+	both I2S controllers, the second one clocked like the first.
+*/
+static void
+fifo_tests(tegra_audio* audio)
+{
+	TRACE_ALWAYS("CAR: clk enb L %#" B_PRIx32 ", rst L %#" B_PRIx32
+		", I2S1 source %#" B_PRIx32 ", I2S2 source %#" B_PRIx32
+		", PLL A %#" B_PRIx32 ", out %#" B_PRIx32 "\n",
+		read32(audio->car, CAR_CLK_OUT_ENB(0)),
+		read32(audio->car, CAR_RST_DEVICES(0)),
+		read32(audio->car, CAR_CLK_SOURCE_I2S1),
+		read32(audio->car, CAR_CLK_SOURCE_I2S2),
+		read32(audio->car, CAR_PLLA_BASE), read32(audio->car, CAR_PLLA_OUT));
+
+	// a register survives a reset only if the reset does not reach it
+	write32(audio->i2s, I2S_TIMING, 0x123);
+	uint32 before = read32(audio->i2s, I2S_TIMING);
+	set_reset(audio, CLOCK_I2S1, true);
+	spin(10);
+	set_reset(audio, CLOCK_I2S1, false);
+	TRACE_ALWAYS("I2S1 reset: timing %#" B_PRIx32 " -> %#" B_PRIx32
+		", ctrl %#" B_PRIx32 ", status %#" B_PRIx32 ", scr %#" B_PRIx32 "\n",
+		before, read32(audio->i2s, I2S_TIMING), read32(audio->i2s, I2S_CTRL),
+		read32(audio->i2s, I2S_STATUS), read32(audio->i2s, I2S_FIFO_SCR));
+
+	uint32 source = read32(audio->car, CAR_CLK_SOURCE_I2S1);
+	run_fifo_test(audio->i2s, "I2S1", false);
+	run_fifo_test(audio->i2s, "I2S1", true);
+
+	// the bits of the source register that Linux leaves alone: is one of
+	// them what lets the clock out?
+	write32(audio->car, CAR_CLK_SOURCE_I2S1, source | (1U << 28));
+	run_fifo_test(audio->i2s, "I2S1 bit 28 set", false);
+	write32(audio->car, CAR_CLK_SOURCE_I2S1, source & ~(3U << 28));
+	run_fifo_test(audio->i2s, "I2S1 bits 29-28 clear", false);
+
+	// I2S1 from the oscillator, 12 MHz / 4
+	write32(audio->car, CAR_CLK_SOURCE_I2S1, i2s_clock_source(source, 3, 4));
+	run_fifo_test(audio->i2s, "I2S1 clk_m", false);
+	write32(audio->car, CAR_CLK_SOURCE_I2S1, source);
+
+	// the DAP as the master of its pins
+	uint32 dap = read32(audio->misc, DAS_DAP_CTRL_SEL(0));
+	write32(audio->misc, DAS_DAP_CTRL_SEL(0), dap | (1U << 31));
+	run_fifo_test(audio->i2s, "I2S1 DAP master", false);
+	write32(audio->misc, DAS_DAP_CTRL_SEL(0), dap);
+
+	// back to the playback setup
+	setup_i2s(audio);
+}
+
+
+static void
+self_test(tegra_audio* audio)
+{
+	if (create_buffers(audio, DEFAULT_BUFFER_FRAMES, BUFFER_COUNT) != B_OK)
+		return;
+
+	// a 689 Hz square wave (64 frames per period), quiet
+	int16* samples = (int16*)audio->buffers;
+	for (uint32 i = 0; i < DEFAULT_BUFFER_FRAMES * BUFFER_COUNT; i++) {
+		int16 value = (i & 32) != 0 ? 2000 : -2000;
+		samples[i * 2] = value;
+		samples[i * 2 + 1] = value;
+	}
+
+	uint32 bank = CLOCK_I2S1 / 32;
+	uint32 bit = 1U << (CLOCK_I2S1 % 32);
+	TRACE_ALWAYS("self test: I2S1 clock %s, reset %s, source %#" B_PRIx32
+		"; APB DMA clock %s, reset %s\n",
+		(read32(audio->car, CAR_CLK_OUT_ENB(bank)) & bit) != 0 ? "on" : "off",
+		(read32(audio->car, CAR_RST_DEVICES(bank)) & bit) != 0 ? "on" : "off",
+		read32(audio->car, CAR_CLK_SOURCE_I2S1),
+		(read32(audio->car, CAR_CLK_OUT_ENB(CLOCK_APBDMA / 32))
+			& (1U << (CLOCK_APBDMA % 32))) != 0 ? "on" : "off",
+		(read32(audio->car, CAR_RST_DEVICES(CLOCK_APBDMA / 32))
+			& (1U << (CLOCK_APBDMA % 32))) != 0 ? "on" : "off");
+
+	fifo_tests(audio);
+
+	if (run_self_test(audio, "PLL A") == 0) {
+		// Does the I2S run at all? Clock it from the oscillator (clk_m,
+		// 12 MHz divided by 4) instead of PLL A for a moment.
+		uint32 source = read32(audio->car, CAR_CLK_SOURCE_I2S1);
+		write32(audio->car, CAR_CLK_SOURCE_I2S1,
+			i2s_clock_source(source, 3, 4));
+		run_self_test(audio, "clk_m");
+		write32(audio->car, CAR_CLK_SOURCE_I2S1, source);
+	}
+
+	// Bring-up: an audible check of the codec and the amplifiers, without
+	// the media kit: 1.5 s of the same tone, louder
+	for (uint32 i = 0; i < DEFAULT_BUFFER_FRAMES * BUFFER_COUNT; i++) {
+		int16 value = (i & 32) != 0 ? 8000 : -8000;
+		samples[i * 2] = value;
+		samples[i * 2 + 1] = value;
+	}
+	audio->interrupts = 0;
+	start_playback(audio);
+	snooze(1500000);
+	uint16 codecStatus = 0;
+	codec_read(audio, ALC5632_PWR_DOWN_CTRL_STATUS, &codecStatus);
+	stop_playback(audio);
+	TRACE_ALWAYS("tone: %" B_PRIu32 " DMA interrupts in 1.5 s (expected "
+		"about 64), codec power status %#06x\n", audio->interrupts,
+		codecStatus);
+
+	memset(audio->buffers, 0, DEFAULT_BUFFER_FRAMES * BUFFER_COUNT
+		* FRAME_SIZE);
+	audio->interrupts = 0;
+}
