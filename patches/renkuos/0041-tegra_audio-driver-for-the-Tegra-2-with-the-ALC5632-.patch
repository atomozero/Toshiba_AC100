+static status_t
+tegra_audio_open(void* deviceCookie, const char* path, int openMode,
+	void** _cookie)
+{
+	tegra_audio* audio = (tegra_audio*)deviceCookie;
+	tegra_audio_cookie* cookie = new(std::nothrow) tegra_audio_cookie;
+	if (cookie == NULL)
+		return B_NO_MEMORY;
+	cookie->audio = audio;
+	cookie->diag = strcmp(path, TEGRA_AUDIO_DIAG_PATH) == 0;
+
+	if (!cookie->diag) {
+		MutexLocker locker(audio->lock);
+		if (audio->opened) {
+			delete cookie;
+			return B_BUSY;
+		}
+		audio->opened = true;
+	}
+	*_cookie = cookie;
+	return B_OK;
+}
