+
+static status_t
+create_buffers(tegra_audio* audio, uint32 frames, uint32 count)
+{
+	if (audio->bufferArea >= B_OK) {
+		if (audio->bufferFrames == frames && audio->bufferCount == count)
+			return B_OK;
+		delete_area(audio->bufferArea);
+		audio->bufferArea = -1;
+	}
+
+	// playback buffers, then as many record buffers
+	size_t size = ROUNDUP(frames * FRAME_SIZE * count * 2, B_PAGE_SIZE);
+	void* address;
+	audio->bufferArea = create_area("tegra audio buffers", &address,
+		B_ANY_KERNEL_ADDRESS, size, B_32_BIT_CONTIGUOUS,
+		B_READ_AREA | B_WRITE_AREA | B_KERNEL_READ_AREA
+			| B_KERNEL_WRITE_AREA);
+	if (audio->bufferArea < B_OK)
+		return audio->bufferArea;
+
+	physical_entry entry;
+	status_t status = get_memory_map(address, size, &entry, 1);
+	if (status == B_OK) {
+		// the APB DMA does not snoop the caches
+		status = vm_set_area_memory_type(audio->bufferArea, entry.address,
+			B_UNCACHED_MEMORY);
+	}
+	if (status != B_OK) {
+		delete_area(audio->bufferArea);
+		audio->bufferArea = -1;
+		return status;
+	}
+
+	audio->buffers = (uint8*)address;
+	audio->buffersPhysical = entry.address;
+	audio->bufferFrames = frames;
+	audio->bufferCount = count;
+	memset(audio->buffers, 0, size);
+	return B_OK;
+}
