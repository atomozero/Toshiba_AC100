+static void
+tegra_audio_free_resources(tegra_audio* audio)
+{
+	if (audio->jackThread >= B_OK) {
+		audio->quitJackThread = true;
+		wait_for_thread(audio->jackThread, NULL);
+	}
+	if (audio->gpioArea >= B_OK)
+		delete_area(audio->gpioArea);
+	if (audio->interruptInstalled) {
+		remove_io_interrupt_handler(APBDMA_CHANNEL_IRQ, dma_interrupt,
+			audio);
+	}
+	if (audio->spdifInterruptInstalled) {
+		remove_io_interrupt_handler(SPDIF_DMA_CHANNEL_IRQ,
+			spdif_dma_interrupt, audio);
+	}
+	if (audio->recordInterruptInstalled) {
+		remove_io_interrupt_handler(RECORD_DMA_CHANNEL_IRQ,
+			record_dma_interrupt, audio);
+	}
+	if (audio->bufferArea >= B_OK)
+		delete_area(audio->bufferArea);
+	if (audio->bufferReadySem >= B_OK)
+		delete_sem(audio->bufferReadySem);
+	if (audio->dmaArea >= B_OK)
+		delete_area(audio->dmaArea);
+	if (audio->i2sArea >= B_OK)
+		delete_area(audio->i2sArea);
+	if (audio->miscArea >= B_OK)
+		delete_area(audio->miscArea);
+	if (audio->carArea >= B_OK)
+		delete_area(audio->carArea);
+	mutex_destroy(&audio->lock);
+	delete audio;
+}
+
+
+static status_t
+tegra_audio_init_driver(device_node* node, void** _cookie)
+{
+	tegra_audio* audio = new(std::nothrow) tegra_audio;
+	if (audio == NULL)
+		return B_NO_MEMORY;
+	memset((void*)audio, 0, sizeof(*audio));
+	audio->node = node;
+	audio->carArea = audio->miscArea = audio->i2sArea = audio->dmaArea = -1;
+	audio->bufferArea = -1;
+	audio->gpioArea = -1;
+	audio->jackThread = -1;
+	audio->bufferReadySem = -1;
+	mutex_init(&audio->lock, "tegra audio");
+	B_INITIALIZE_SPINLOCK(&audio->interruptLock);
+
+	device_node* parent = sDeviceManager->get_parent_node(node);
+	status_t status = sDeviceManager->get_driver(parent,
+		(driver_module_info**)&audio->i2c, (void**)&audio->i2cCookie);
+	sDeviceManager->put_node(parent);
+	if (status != B_OK) {
+		tegra_audio_free_resources(audio);
+		return status;
+	}
+
+	audio->carArea = map_registers("tegra car", CAR_BASE, &audio->car);
+	audio->miscArea = map_registers("tegra apb misc", APB_MISC_BASE,
+		&audio->misc);
+	audio->i2sArea = map_registers("tegra i2s1", I2S1_BASE & ~(B_PAGE_SIZE - 1),
+		&audio->i2s);
+	// the DMA controller's second page holds the channels
+	void* dmaBase;
+	audio->dmaArea = map_physical_memory("tegra apb dma", APBDMA_BASE,
+		2 * B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &dmaBase);
+	if (audio->carArea < B_OK || audio->miscArea < B_OK
+		|| audio->i2sArea < B_OK || audio->dmaArea < B_OK) {
+		tegra_audio_free_resources(audio);
+		return B_NO_MEMORY;
+	}
+	audio->dma = (volatile uint8*)dmaBase;
+	audio->channel = audio->dma + APBDMA_CHANNEL_OFFSET;
+	audio->spdifChannel = audio->dma + SPDIF_DMA_CHANNEL_OFFSET;
+	audio->recordChannel = audio->dma + RECORD_DMA_CHANNEL_OFFSET;
+	audio->spdif = audio->i2s + (SPDIF_BASE & (B_PAGE_SIZE - 1));
+	audio->i2s += I2S1_BASE & (B_PAGE_SIZE - 1);
+
+	audio->bufferReadySem = create_sem(0, "tegra audio buffer ready");
+	if (audio->bufferReadySem < B_OK) {
+		tegra_audio_free_resources(audio);
+		return B_NO_MEMORY;
+	}
+
+	status = setup_clocks(audio);
+	if (status == B_OK) {
+		setup_pins_and_das(audio);
+		setup_i2s(audio);
+		status = codec_init(audio);
+	}
+	if (status == B_OK) {
+		status = install_io_interrupt_handler(APBDMA_CHANNEL_IRQ,
+			dma_interrupt, audio, 0);
+		audio->interruptInstalled = status == B_OK;
+	}
+	TRACE_ALWAYS("init: %s\n", strerror(status));
+	if (status != B_OK) {
+		tegra_audio_free_resources(audio);
+		return status;
+	}
+
+	// the bring-up tests end with a tone of 1.5 s, so they only run when
+	// "self_test true" is in the tegra_audio driver settings; "spdif false"
+	// keeps the sound off the S/PDIF controller and HDMI
+	void* settings = load_driver_settings("tegra_audio");
+	bool selfTest = get_driver_boolean_parameter(settings, "self_test", false,
+		true);
+	bool spdif = get_driver_boolean_parameter(settings, "spdif", true, true);
+	// "hdmi_mutes_speaker false" keeps the speaker on with an HDMI screen
+	audio->hdmiMutesSpeaker = get_driver_boolean_parameter(settings,
+		"hdmi_mutes_speaker", true, true);
+	unload_driver_settings(settings);
+
+	// The S/PDIF controller is always set up, so that the mixer control
+	// can turn the HDMI sound on and off
+	setup_spdif(audio);
+	audio->spdifInterruptInstalled = install_io_interrupt_handler(
+		SPDIF_DMA_CHANNEL_IRQ, spdif_dma_interrupt, audio, 0) == B_OK;
+	audio->spdifEnabled = spdif && audio->spdifInterruptInstalled;
+	TRACE_ALWAYS("S/PDIF: %s\n", audio->spdifEnabled ? "on" : "off");
+
+	// recording: the built-in microphone, 0 dB, no boost
+	audio->recordLevel[0] = audio->recordLevel[1] = 11;
+	audio->micBoost = 2;
+	audio->inputSource = 0;
+	audio->recordInterruptInstalled = install_io_interrupt_handler(
+		RECORD_DMA_CHANNEL_IRQ, record_dma_interrupt, audio, 0) == B_OK;
+	if (audio->recordInterruptInstalled) {
+		MutexLocker locker(audio->lock);
+		set_input(audio);
+	}
+
+	// the volumes codec_init() set
+	uint16 volume;
+	if (codec_read(audio, ALC5632_SPK_OUT_VOL, &volume) == B_OK) {
+		audio->speakerLevel[0] = (volume >> 8) & 0x1f;
+		audio->speakerLevel[1] = volume & 0x1f;
+	}
+	if (codec_read(audio, ALC5632_HP_OUT_VOL, &volume) == B_OK) {
+		audio->headphoneLevel[0] = (volume >> 8) & 0x1f;
+		audio->headphoneLevel[1] = volume & 0x1f;
+	}
+	if (selfTest)
+		self_test(audio);
+	start_jack_detection(audio);
+
+	*_cookie = audio;
+	return B_OK;
+}
+
+
+static void
+tegra_audio_uninit_driver(void* cookie)
+{
+	tegra_audio* audio = (tegra_audio*)cookie;
+	stop_playback(audio);
+	tegra_audio_free_resources(audio);
+}
+
+
+static status_t
+tegra_audio_register_child_devices(void* cookie)
+{
+	tegra_audio* audio = (tegra_audio*)cookie;
+	status_t status = sDeviceManager->publish_device(audio->node,
+		"audio/hmulti/tegra_audio/1", TEGRA_AUDIO_DEVICE_MODULE_NAME);
+	if (status == B_OK) {
+		sDeviceManager->publish_device(audio->node, TEGRA_AUDIO_DIAG_PATH,
+			TEGRA_AUDIO_DEVICE_MODULE_NAME);
+	}
+	return status;
+}
