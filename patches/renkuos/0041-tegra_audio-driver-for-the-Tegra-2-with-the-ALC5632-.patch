+static float
+tegra_audio_supports_device(device_node* parent)
+{
+	const char* bus;
+	const char* hid;
+	if (sDeviceManager->get_attr_string(parent, B_DEVICE_BUS, &bus, false)
+			!= B_OK || strcmp(bus, "i2c") != 0
+		|| sDeviceManager->get_attr_string(parent, ACPI_DEVICE_HID_ITEM, &hid,
+			false) != B_OK || strcmp(hid, "realtek,alc5632") != 0) {
+		return 0.0f;
+	}
+	return 0.8f;
+}
