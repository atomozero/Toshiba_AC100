From 35cc3d359bafd5cd4b6685e98d5bbf1e3f8c017b Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 20 Oct 2026 21:38:43 +0200
Subject: [PATCH 174/203] tegra_audio: enable the I2S master clock explicitly

Bit 28 of CLK_SOURCE_I2S1 is I2S1_MASTER_CLKEN (Tegra 2 TRM, 5.4.46).
It comes up set, but do not depend on that.
---
 src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
index 08f4bc05a9..e87b1c6373 100644
--- a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
+++ b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
@@ -48,6 +48,7 @@
 #define CAR_PLLA_MISC				0xbc
 #define CAR_CLK_SOURCE_I2S1			0x100
 #define CAR_CLK_SOURCE_I2S2			0x104
+#define CLK_SOURCE_I2S_MASTER_CLKEN	(1U << 28)
 #define PLL_BASE_BYPASS				(1U << 31)
 #define PLL_BASE_ENABLE				(1U << 30)
 #define PLL_BASE_LOCK				(1U << 27)
@@ -340,13 +341,14 @@ codec_init(tegra_audio* audio)
 
 
 /*!	The source (bits 31-30) and the divisor in 7.1 fixed point (bits 7-0)
-	of a CLK_SOURCE register, the other bits kept.
+	of an I2S CLK_SOURCE register, with the master clock enabled: without
+	it the controller does not shift anything out as the master.
 */
 static inline uint32
 i2s_clock_source(uint32 value, uint32 source, uint32 divisor)
 {
 	return (value & ~((3U << 30) | 0xff)) | (source << 30)
-		| (2 * (divisor - 1));
+		| CLK_SOURCE_I2S_MASTER_CLKEN | (2 * (divisor - 1));
 }
 
 
