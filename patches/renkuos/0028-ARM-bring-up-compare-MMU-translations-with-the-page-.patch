--- a/src/system/kernel/slab/ObjectCache.cpp
+++ b/src/system/kernel/slab/ObjectCache.cpp
@@ -123,6 +123,68 @@ ObjectCache::Init(const char* name, size_t objectSize, size_t alignment,
 }
 
 
+#ifdef __ARM__
+/*!	Bring-up aid: checks that the slab pages do not share a physical page with
+	the current stack, and that the MMU translates both like the page tables
+	say. \a stage is 0 before and 1 after the slab was initialized.
+*/
+static void __attribute__((noinline))
+arm_check_slab_mapping(void* pages, size_t byteCount, int stage)
+{
+	VMAddressSpace* kernelSpace = VMAddressSpace::Kernel();
+	if (!gKernelStartup || kernelSpace == NULL)
+		return;
+
+	VMTranslationMap* map = kernelSpace->TranslationMap();
+	addr_t stack = ROUNDDOWN((addr_t)__builtin_frame_address(0), B_PAGE_SIZE);
+	phys_addr_t stackPhysical = 0;
+	uint32 flags;
+	if (map->Query(stack, &stackPhysical, &flags) != B_OK
+		|| (flags & PAGE_PRESENT) == 0) {
+		return;
+	}
+	uint32 stackHardware = arm_virtual_to_physical(stack);
+
+	for (addr_t address = ROUNDDOWN((addr_t)pages, B_PAGE_SIZE);
+			address < (addr_t)pages + byteCount; address += B_PAGE_SIZE) {
+		phys_addr_t physical = 0;
+		if (map->Query(address, &physical, &flags) != B_OK
+			|| (flags & PAGE_PRESENT) == 0) {
+			continue;
+		}
+		uint32 hardware = arm_virtual_to_physical(address);
+		// an access flag fault (FS 0b00110) only means not accessed yet
+		bool notAccessed = (hardware & 0xff000000) == 0xfa000000
+			&& (hardware & 0x7e) == 0x0c;
+		if ((!notAccessed && hardware != (uint32)physical)
+			|| stackHardware != (uint32)stackPhysical) {
+			arm_boot_marker(41 + stage);
+			arm_boot_marker_value(110, (uint32)address);
+			arm_boot_marker_value(111, (uint32)physical);
+			arm_boot_marker_value(112, hardware);
+			arm_boot_marker_value(113, stackHardware);
+			panic("MMU/page table mismatch (%d): %p -> %#" B_PRIxPHYSADDR
+				" (MMU %#" B_PRIx32 "), stack %p -> %#" B_PRIxPHYSADDR
+				" (MMU %#" B_PRIx32 ")", stage, (void*)address, physical,
+				hardware, (void*)stack, stackPhysical, stackHardware);
+		}
+		if (physical == stackPhysical || address == stack) {
+			arm_boot_marker(40);
+			arm_boot_marker_value(7, (uint32)address);
+			arm_boot_marker_value(8, (uint32)physical);
+			arm_boot_marker_value(9, (uint32)stack);
+			arm_boot_marker_value(10, (uint32)stackPhysical);
+			panic("slab page %p (phys %#" B_PRIxPHYSADDR ") is also the stack "
+				"page %p", (void*)address, physical, (void*)stack);
+		}
+	}
+	arm_boot_marker_value(11 + stage, stage == 0 ? (uint32)stack : stackHardware);
+	if (stage == 0)
+		arm_boot_marker_value(12, (uint32)stackPhysical);
+}
+#endif
+
+
 slab*
 ObjectCache::InitSlab(slab* slab, void* pages, size_t byteCount, uint32 flags)
 {
@@ -130,38 +192,7 @@ ObjectCache::InitSlab(slab* slab, void* pages, size_t byteCount, uint32 flags)
 		((uint8*)pages) + byteCount, byteCount);
 
 #ifdef __ARM__
