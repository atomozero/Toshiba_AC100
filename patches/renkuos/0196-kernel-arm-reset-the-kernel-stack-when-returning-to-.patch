From 8ca95ad641f717547c78890483edc2ff97768c4a Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 24 Oct 2026 02:22:46 +0200
Subject: [PATCH 196/270] kernel/arm: reset the kernel stack when returning to
 userland

arch_return_to_userland() left the SVC stack pointer inside the iframe it
returned from. When that frame is deep in the kernel stack, as after
exec() (the exec syscall never returns) or fork(), the next exception
from userland started there, so every exec() leaked the whole call chain
of the syscall. Two or three exec() in a row in the same thread (sshd
re-executing itself on SIGHUP, shell scripts using exec) overflowed the
16 KB stack, or first tripped the iframe stack assertion: the IFrameScope
of the exec syscall is never popped either.

Reset SP to the top of the thread's kernel stack, like x86 does with
tss.sp0, and empty the iframe stack in arch_thread_enter_userspace().

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/system/kernel/arch/arm/arch_asm.S      | 14 ++++++++++----
 src/system/kernel/arch/arm/arch_thread.cpp |  6 ++++++
 2 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/src/system/kernel/arch/arm/arch_asm.S b/src/system/kernel/arch/arm/arch_asm.S
index 977e3ca640..b540fef868 100644
--- a/src/system/kernel/arch/arm/arch_asm.S
+++ b/src/system/kernel/arch/arm/arch_asm.S
@@ -285,10 +285,16 @@ FUNCTION(arch_return_to_userland):
 	// load user mode entry point in LR
 	ldr		lr, [r0, #IFRAME_pc]
 
-	// load general purpose registers
-	mov		sp, r0
-	add		sp, sp, #4
-	ldmfd	sp!, { r0-r12 }
+	// The next exception from userland starts on the SVC stack: reset it to
+	// the top of the thread's kernel stack. The frame may sit deep inside it
+	// (exec(), fork()), and that whole call chain is dead from here on;
+	// leaving SP there leaks it on every exec() until the stack overflows.
+	mrc		p15, 0, ip, c13, c0, 4		// TPIDRPRW: current Thread*
+	ldr		sp, [ip, #THREAD_kernel_stack_top]
+
+	// load general purpose registers (base in the list, no writeback)
+	add		r0, r0, #4
+	ldmia	r0, { r0-r12 }
 
 	// jump to user mode entry point
 	movs	pc, lr
diff --git a/src/system/kernel/arch/arm/arch_thread.cpp b/src/system/kernel/arch/arm/arch_thread.cpp
index 91c9a5fb27..26e8c15bc5 100644
--- a/src/system/kernel/arch/arm/arch_thread.cpp
+++ b/src/system/kernel/arch/arm/arch_thread.cpp
@@ -230,6 +230,12 @@ arch_thread_enter_userspace(Thread *thread, addr_t entry,
 
 	disable_interrupts();
 
+	// No kernel frame survives the jump to userland. After an exec() the
+	// frame of the syscall that got us here is still on the iframe stack,
+	// since that syscall never returns: drop it, or every exec() leaks a slot
+	// and a few of them in a row make arm_push_iframe() panic.
+	thread->arch_info.iframes.index = 0;
+
 	// prepare the user iframe
 	iframe frame = {};
 	frame.r0 = (uint32)args1;
