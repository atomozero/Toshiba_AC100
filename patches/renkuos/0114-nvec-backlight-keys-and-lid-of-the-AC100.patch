From 3d08e66f4fb34ad113c306540c56499be4b90a55 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 20:49:48 +0200
Subject: [PATCH 114/270] nvec: backlight keys and lid of the AC100

The backlight keys (Fn + the sun keys) come as F6 and F7 on the AC100:
they change the backlight instead. The lid comes as a system event
(c5 04 00 00 02 00 when closed): switch the backlight off meanwhile.
---
 src/add-ons/kernel/busses/i2c/nvec/nvec.cpp | 41 +++++++++++++++++++--
 1 file changed, 37 insertions(+), 4 deletions(-)

diff --git a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
index 228449539b..05a71866b7 100644
--- a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
+++ b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
@@ -106,6 +106,7 @@ enum {
 	NVEC_OEM0		= 0x0d,
 	NVEC_KB_EVT		= 0x80,
 	NVEC_PS2_EVT	= 0x81,
+	NVEC_SYSTEM_EVT	= 0x85,
 };
 
 // event sizes, bits 5-6 of the type byte
@@ -171,6 +172,7 @@ struct nvec_device {
 	area_id				pwmArea;
 	volatile uint32*	pwm;			// backlight, if its clock runs
 	int32				backlightLevel;	// 1 - BACKLIGHT_LEVELS
+	bool				lidClosed;		// the backlight is off meanwhile
 	volatile uint8*		gpio;
 	uint32				requestGPIO;
 	bool				requestActiveLow;
@@ -711,6 +713,8 @@ change_backlight(nvec_device* device, int32 delta)
 	if (level > BACKLIGHT_LEVELS)
 		level = BACKLIGHT_LEVELS;
 	device->backlightLevel = level;
+	if (device->lidClosed)
+		return;
 
 	uint32 duty = level * 256 / BACKLIGHT_LEVELS;
 	*device->pwm = (*device->pwm & ~TEGRA_PWM_DUTY_MASK) | TEGRA_PWM_ENABLE
@@ -720,6 +724,24 @@ change_backlight(nvec_device* device, int32 delta)
 }
 
 
+/*!	Switches the backlight off while the lid is closed. */
+static void
+set_lid_closed(nvec_device* device, bool closed)
+{
+	if (closed == device->lidClosed)
+		return;
+	device->lidClosed = closed;
+	TRACE_ALWAYS("lid %s\n", closed ? "closed" : "open");
+
+	if (device->pwm == NULL)
+		return;
+	if (closed)
+		*device->pwm &= ~(TEGRA_PWM_DUTY_MASK | TEGRA_PWM_ENABLE);
+	else
+		change_backlight(device, 0);
+}
+
+
 static void
 setup_backlight(nvec_device* device)
 {
@@ -785,10 +807,14 @@ handle_scan_code(nvec_device* device, uint8 code)
 	bool down = (code & 0x80) == 0;
 	uint32 scancode = (code & 0x7f) | (extended ? 0x80 : 0);
 
-	if (scancode == 0xb9 || scancode == 0xba) {
-		// backlight up and down
-		if (down)
-			change_backlight(device, scancode == 0xb9 ? 1 : -1);
+	// the backlight keys (Fn + the sun keys) come as F7 and F6 on the AC100
+	// (e0 39 and e0 3a on other NVEC keyboards)
+	if (scancode == 0x41 || scancode == 0x40 || scancode == 0xb9
+		|| scancode == 0xba) {
+		if (down) {
+			change_backlight(device,
+				scancode == 0x41 || scancode == 0xb9 ? 1 : -1);
+		}
 		return;
 	}
 
@@ -1073,6 +1099,13 @@ rx_thread(void* data)
 				handle_battery_message(device, &message);
 				break;
 
+			case NVEC_SYSTEM_EVT:
+				// the system status changed: c5 04 00 00 02 00 has the
+				// lid closed
+				if (message.size >= 6)
+					set_lid_closed(device, (message.data[4] & LID_SWITCH) != 0);
+				break;
+
 			case NVEC_SYS:
 				if (message.size >= 6 && message.data[2] == GET_SYSTEM_STATUS) {
 					device->acOnline = message_uint16(&message) != 0;
