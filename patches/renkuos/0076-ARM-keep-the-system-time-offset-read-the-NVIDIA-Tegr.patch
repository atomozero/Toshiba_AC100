From 0aeefe5caebb93818c6c1f3e8f003cbb37b264cd Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 10:57:50 +0200
Subject: [PATCH 076/270] ARM: keep the system time offset, read the NVIDIA
 Tegra real time clock

arch_rtc_set_system_time_offset() did nothing and the offset was always
0 on ARM, so the time of day was the time since boot, even after it had
been set. Store it the way libroot reads it: in the copy the version
does not point to, then bump the version.

On Tegra, the boot loader passes the registers of the
"nvidia,tegra20-rtc" node, a seconds counter in the always on power
domain, which the kernel now reads and sets.
---
 .../kernel/arch/arm/arch_kernel_args.h        |  1 +
 .../boot/platform/efi/arch/arm/arch_dtb.cpp   |  4 ++
 .../kernel/arch/arm/arch_real_time_clock.cpp  | 59 ++++++++++++++++++-
 3 files changed, 61 insertions(+), 3 deletions(-)

diff --git a/headers/private/kernel/arch/arm/arch_kernel_args.h b/headers/private/kernel/arch/arm/arch_kernel_args.h
index f4481cdf20..25bc3edd85 100644
--- a/headers/private/kernel/arch/arm/arch_kernel_args.h
+++ b/headers/private/kernel/arch/arm/arch_kernel_args.h
@@ -44,6 +44,7 @@ typedef struct {
 	uint32				bootMarkerFrameBuffer;	// kernel address, bring-up aid
 	uint32				bootDebug[8];	// loader's view of the CPU, bring-up aid
 	addr_range			pmc;	// NVIDIA Tegra power management controller
+	addr_range			rtc;	// NVIDIA Tegra real time clock
 } _PACKED arch_kernel_args;
 
 #endif	/* KERNEL_ARCH_ARM_KERNEL_ARGS_H */
diff --git a/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp b/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
index ac77f840c5..e915739bb3 100644
--- a/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
+++ b/src/system/boot/platform/efi/arch/arm/arch_dtb.cpp
@@ -146,6 +146,10 @@ arch_handle_fdt(const void* fdt, int node)
 		&& dtb_has_fdt_string(compatible, compatibleLen, "nvidia,tegra20-pmc")) {
 		dtb_get_reg(fdt, node, 0, gKernelArgs.arch_args.pmc);
 	}
+	if (gKernelArgs.arch_args.rtc.start == 0
+		&& dtb_has_fdt_string(compatible, compatibleLen, "nvidia,tegra20-rtc")) {
+		dtb_get_reg(fdt, node, 0, gKernelArgs.arch_args.rtc);
+	}
 
 	if (sL2Regs.start == 0 && dtb_has_fdt_string(compatible, compatibleLen,
 			"arm,pl310-cache")) {
diff --git a/src/system/kernel/arch/arm/arch_real_time_clock.cpp b/src/system/kernel/arch/arm/arch_real_time_clock.cpp
index 58cbea9172..737bd2dc5b 100644
--- a/src/system/kernel/arch/arm/arch_real_time_clock.cpp
+++ b/src/system/kernel/arch/arm/arch_real_time_clock.cpp
@@ -10,39 +10,92 @@
 
 #include <arch/real_time_clock.h>
 
+#include <KernelExport.h>
+
+#include <boot/kernel_args.h>
 #include <real_time_clock.h>
 #include <real_time_data.h>
 #include <smp.h>
+#include <util/AutoLock.h>
+
+
+// NVIDIA Tegra real time clock: a seconds counter in the always on domain
+#define TEGRA_RTC_BUSY				0x04
+#define TEGRA_RTC_SECONDS			0x08
+#define TEGRA_RTC_SHADOW_SECONDS	0x0c
+#define TEGRA_RTC_MILLI_SECONDS		0x10
+
+static volatile uint32* sTegraRTC;
+static spinlock sTegraRTCLock = B_SPINLOCK_INITIALIZER;
 
 
 status_t
 arch_rtc_init(kernel_args *args, struct real_time_data *data)
 {
-	return B_NOT_SUPPORTED;
+	data->arch_data.data[0].system_time_offset = 0;
+	data->arch_data.data[1].system_time_offset = 0;
+	data->arch_data.system_time_conversion_factor = 1000000000LL;
+	data->arch_data.version = 0;
+
+	if (args->arch_args.rtc.start != 0) {
+		void* address;
+		area_id area = map_physical_memory("tegra rtc",
+			args->arch_args.rtc.start, B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+			B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+		if (area >= B_OK) {
+			sTegraRTC = (volatile uint32*)((addr_t)address
+				+ (args->arch_args.rtc.start & (B_PAGE_SIZE - 1)));
+		}
+	}
+
+	return B_OK;
 }
 
 
 uint64
 arch_rtc_get_hw_time(void)
 {
-	return 0;
+	if (sTegraRTC == NULL)
+		return 0;
+
+	// reading the milliseconds latches the seconds into the shadow register
+	InterruptsSpinLocker locker(sTegraRTCLock);
+	(void)sTegraRTC[TEGRA_RTC_MILLI_SECONDS / 4];
+	return sTegraRTC[TEGRA_RTC_SHADOW_SECONDS / 4];
 }
 
 
 void
 arch_rtc_set_hw_time(uint64 seconds)
 {
+	if (sTegraRTC == NULL)
+		return;
+
+	// the registers may only be written while the clock is not busy posting
+	// its new value, which takes up to about 500 us
+	InterruptsSpinLocker locker(sTegraRTCLock);
+	for (int32 i = 0; i < 500 && (sTegraRTC[TEGRA_RTC_BUSY / 4] & 1) != 0; i++)
+		spin(1);
+	sTegraRTC[TEGRA_RTC_SECONDS / 4] = (uint32)seconds;
 }
 
 
+/*!	Userland reads the offset without a lock: it reads the copy the version
+	points to, and again if the version changed meanwhile.
+*/
 void
 arch_rtc_set_system_time_offset(struct real_time_data *data, bigtime_t offset)
 {
+	int32 version = data->arch_data.version + 1;
+	data->arch_data.data[version % 2].system_time_offset = offset;
+	memory_write_barrier();
+	data->arch_data.version = version;
 }
 
 
 bigtime_t
 arch_rtc_get_system_time_offset(struct real_time_data *data)
 {
-	return 0;
+	return data->arch_data.data[data->arch_data.version % 2]
+		.system_time_offset;
 }
