From 81ac40851c385b2a73c54c91b1dc38d63eb263bf Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 20 Oct 2026 18:10:19 +0200
Subject: [PATCH 06/63] BMessage: do not print fields from unaligned data in
 place

The field data need not be aligned in the message buffer, and floating
point loads from unaligned addresses fault on ARM: PrintToStream() of a
message with a BPoint crashed. Copy the values out before printing them.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/kits/app/Message.cpp | 18 ++++++++++++------
 1 file changed, 12 insertions(+), 6 deletions(-)

diff --git a/src/kits/app/Message.cpp b/src/kits/app/Message.cpp
index b4d6a135bd..16e67c6340 100644
--- a/src/kits/app/Message.cpp
+++ b/src/kits/app/Message.cpp
@@ -83,12 +83,16 @@ port_id BMessage::sReplyPorts[sNumReplyPorts];
 int32 BMessage::sReplyPortInUse[sNumReplyPorts];
 
 
+// The field data need not be aligned in the message buffer: copy it out
+// first, as unaligned floating point loads fault on ARM.
+
 template<typename Type>
 static void
 print_to_stream_type(uint8* pointer)
 {
-	Type* item = (Type*)pointer;
-	item->PrintToStream();
+	Type item;
+	memcpy((void*)&item, pointer, sizeof(Type));
+	item.PrintToStream();
 }
 
 
@@ -96,8 +100,9 @@ template<typename Type>
 static void
 print_type(const char* format, uint8* pointer)
 {
-	Type* item = (Type*)pointer;
-	printf(format,* item,* item);
+	Type item;
+	memcpy(&item, pointer, sizeof(Type));
+	printf(format, item, item);
 }
 
 
@@ -105,8 +110,9 @@ template<typename Type>
 static void
 print_type3(const char* format, uint8* pointer)
 {
-	Type* item = (Type*)pointer;
-	printf(format, *item, *item, *item);
+	Type item;
+	memcpy(&item, pointer, sizeof(Type));
+	printf(format, item, item, item);
 }
 
 
