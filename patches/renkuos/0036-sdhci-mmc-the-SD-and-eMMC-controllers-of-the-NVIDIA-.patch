+#ifdef __ARM__
+/*!	The DMA engine is not coherent with the CPU data caches on ARM. Before a
+	transfer, write back (and for reads also discard) the cached lines of the
+	buffer, so that no dirty line is later evicted over the data the controller
+	wrote; after a read, discard them again, as they may have been fetched
+	speculatively while the transfer was running.
+*/
+static void
+sync_dma_buffer(phys_addr_t address, size_t size, bool isWrite)
+{
+	uint32 ctr;
+	asm volatile ("mrc p15, 0, %0, c0, c0, 1" : "=r" (ctr));
+	const addr_t lineSize = 4 << ((ctr >> 16) & 0xf);
+
+	const phys_addr_t end = address + size;
+	while (address < end) {
+		phys_addr_t page = ROUNDDOWN(address, B_PAGE_SIZE);
+		size_t chunk = std::min(end, page + B_PAGE_SIZE) - address;
+
+		addr_t virtualPage;
+		void* handle;
+		if (vm_get_physical_page(page, &virtualPage, &handle) != B_OK) {
+			panic("sdhci: could not map DMA buffer page %#" B_PRIxPHYSADDR,
+				page);
+			return;
+		}
+
+		addr_t start = virtualPage + (address - page);
+		for (addr_t line = start & ~(lineSize - 1); line < start + chunk;
+				line += lineSize) {
+			if (isWrite) {
+				// DCCMVAC: clean to the point of coherency
+				asm volatile ("mcr p15, 0, %0, c7, c10, 1" : : "r" (line)
+					: "memory");
+			} else {
+				// DCCIMVAC: clean and invalidate to the point of coherency
+				asm volatile ("mcr p15, 0, %0, c7, c14, 1" : : "r" (line)
+					: "memory");
+			}
+		}
+		asm volatile ("dsb" : : : "memory");
+
+		// The outer cache too. For reads, discard the inner lines again, so
+		// that none of them is refilled from it with old data meanwhile.
+		if (isWrite)
+			arm_outer_cache_clean_range(address, chunk);
+		else {
+			arm_outer_cache_flush_range(address, chunk);
+			for (addr_t line = start & ~(lineSize - 1); line < start + chunk;
+					line += lineSize) {
+				// DCIMVAC: invalidate to the point of coherency
+				asm volatile ("mcr p15, 0, %0, c7, c6, 1" : : "r" (line)
+					: "memory");
+			}
+			asm volatile ("dsb" : : : "memory");
+		}
+
+		vm_put_physical_page(virtualPage, handle);
+		address += chunk;
+	}
+}
+#endif
