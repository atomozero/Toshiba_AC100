+/*!	Reads the EXT_CSD until two reads agree on the fields that never change
+	and these make sense. The size of the device comes from it: on the
+	Toshiba AC100 the first read came back corrupted at times, with a sector
+	count of 1.96 TB for a 16 GB eMMC, and the partition scan then kept
+	reading past the end of the device, so the boot volume was never found.
+*/
+static status_t
+mmc_disk_read_ext_csd_checked(mmc_disk_driver_info* info, uint8* extCsd,
+	bool largerThan2GB)
+{
+	uint8* check = (uint8*)malloc(kExtCsdSize);
+	if (check == NULL)
+		return B_NO_MEMORY;
+
+	status_t error = B_ERROR;
+	for (int attempt = 0; attempt < 5; attempt++) {
+		if (attempt > 0)
+			snooze(10000);
+
+		error = mmc_disk_read_ext_csd(info, extCsd);
+		if (error != B_OK)
+			continue;
+		error = mmc_disk_read_ext_csd(info, check);
+		if (error != B_OK)
+			continue;
+
+		// EXT_CSD_STRUCTURE is at most 2 and EXT_CSD_REV at most 8 (eMMC
+		// 5.1); a device larger than 2GB has its size in SEC_COUNT only
+		uint32 sectors = ext_csd_sector_count(extCsd);
+		bool plausible = extCsd[kExtCsdStructure] <= 2
+			&& extCsd[kExtCsdRevision] <= 8
+			&& (!largerThan2GB
+				|| (uint64)sectors * kBlockSize > 2LL * 1024 * 1024 * 1024);
+		if (plausible && ext_csd_same_device(extCsd, check)) {
+			free(check);
+			return B_OK;
+		}
+
+		ERROR("EXT_CSD read %d not usable: sectors %" B_PRIu32 " and %"
+			B_PRIu32 ", revision %u and %u, structure %u and %u\n", attempt,
+			sectors, ext_csd_sector_count(check), extCsd[kExtCsdRevision],
+			check[kExtCsdRevision], extCsd[kExtCsdStructure],
+			check[kExtCsdStructure]);
+		error = B_IO_ERROR;
+	}
+
+	free(check);
+	return error;
+}
