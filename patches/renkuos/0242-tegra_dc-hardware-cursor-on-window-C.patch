+++ b/src/add-ons/kernel/drivers/graphics/tegra_dc/tegra_dc.cpp
@@ -73,6 +73,10 @@ extern void* gFDT;
 #define SCANOUT_BASE				0x1f800000
 #define SCANOUT_SIZE				0x500000
 
+// The cursor image, 64x64 B8G8R8A8, after room for a 32 bit frame buffer
+#define CURSOR_OFFSET				0x400000
+#define CURSOR_BYTES_PER_ROW		(TEGRA_DC_CURSOR_SIZE * 4)
+
 #define PANEL_WIDTH					1024
 #define PANEL_HEIGHT				600
 
@@ -83,6 +87,8 @@ extern void* gFDT;
 #define DC_CMD_INT_TYPE				0x03a
 #define DC_CMD_INT_POLARITY			0x03b
 #define DC_CMD_STATE_CONTROL		0x041
+#define DC_DISP_MEM_HIGH_PRIORITY	0x403
+#define DC_DISP_MEM_HIGH_PRIORITY_TIMER	0x404
 #define DC_DISP_SYNC_WIDTH			0x407
 #define DC_DISP_BACK_PORCH			0x408
 #define DC_DISP_DISP_ACTIVE			0x409
@@ -92,8 +98,12 @@ extern void* gFDT;
 
 #define INT_V_BLANK					(1u << 2)
 
+#define STATE_GENERAL_ACT_REQ		(1u << 0)
 #define STATE_WIN_A_ACT_REQ			(1u << 1)
+#define STATE_WIN_C_ACT_REQ			(1u << 3)
+#define STATE_GENERAL_UPDATE		(1u << 8)
 #define STATE_WIN_A_UPDATE			(1u << 9)
+#define STATE_WIN_C_UPDATE			(1u << 11)
 
 // Window A, through its own register aperture (as Linux addresses the
 // windows, which avoids the window header register; checked on the AC100)
@@ -107,6 +117,37 @@ extern void* gFDT;
 #define WINBUF_ADDR_H_OFFSET		(WIN_A_BASE + 0x1c0 + 0x06)
 #define WINBUF_ADDR_V_OFFSET		(WIN_A_BASE + 0x1c0 + 0x08)
 
+// Window registers relative to a window's own WIN and WINBUF blocks
+#define WIN_C_BASE					0xe00
+#define WIN_REG(base, reg)			((base) + 0x180 + (reg))
+#define WINBUF_REG(base, reg)		((base) + 0x1c0 + (reg))
+#define REG_OPTIONS					0x00
+#define REG_COLOR_DEPTH				0x03
+#define REG_POSITION				0x04
+#define REG_SIZE					0x05
+#define REG_PRESCALED_SIZE			0x06
+#define REG_H_INITIAL_DDA			0x07
+#define REG_V_INITIAL_DDA			0x08
+#define REG_DDA_INCREMENT			0x09
+#define REG_LINE_STRIDE				0x0a
+#define REG_BUF_STRIDE				0x0b
+#define REG_BUFFER_ADDR_MODE		0x0d
+#define REG_BLEND_NOKEY				0x0f
+#define REG_BLEND_1WIN				0x10
+#define REG_BLEND_2WIN_X			0x11	// A: with B, C: with A
+#define REG_BLEND_2WIN_Y			0x12	// A: with C, C: with B
+#define REG_BLEND_3WIN				0x13
+#define REG_START_ADDR				0x00
+#define REG_ADDR_H_OFFSET			0x06
+#define REG_ADDR_V_OFFSET			0x08
+
+// Blend control (TRM 29.10.18 - 29.10.21)
+#define BLEND_WEIGHT1(x)			((uint32)(x) << 16)
+#define BLEND_WEIGHT0(x)			((uint32)(x) << 8)
+#define BLEND_CONTROL_FIX			(0u << 2)
+#define BLEND_CONTROL_ALPHA			(1u << 2)
+#define BLEND_CONTROL_DEPENDENT		(2u << 2)
+
 #define WIN_OPTIONS_COLOR_EXPAND	(1u << 6)
 #define WIN_OPTIONS_ENABLE			(1u << 30)
 
@@ -133,6 +174,16 @@ struct tegra_dc_device {
 	area_id				pwm_area;
 	volatile uint32*	pwm;
 	uint32				saved_pwm;		// while the screen sleeps
+
+	// hardware cursor, on window C
+	bool				cursor_ready;	// window C and blending set up
+	bool				cursor_shown;
+	int32				cursor_x;		// hot spot on screen
+	int32				cursor_y;
+	uint16				cursor_width;
+	uint16				cursor_height;
+	uint16				cursor_hot_x;
+	uint16				cursor_hot_y;
