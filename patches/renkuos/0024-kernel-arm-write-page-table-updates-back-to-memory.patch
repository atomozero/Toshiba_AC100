From 30a352ff34668b7f5f662a3a0a36d0b35c142899 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 17:14:55 +0200
Subject: [PATCH 024/270] kernel/arm: write page table updates back to memory

The translation table walker does not necessarily look into the L1 data
cache. On a Cortex-A9 that does not take part in SMP coherency it reads
the tables from memory, so entries written through the cache were not
seen by the MMU until evicted, and new mappings could resolve through
stale or random memory. QEMU does not model caches and never showed it.

Clean the affected cache lines after every page directory and page table
write, after preparing new tables, and for page tables allocated by
Map(), which are cleared through the cache.

Also clear the whole of the early physical page pool tables: only a
quarter of them was zeroed, leaving uninitialized entries behind.
---
 headers/private/kernel/arch/arm/arch_cpu.h    | 21 +++++++++++++++++++
 .../arm/paging/32bit/ARMPagingMethod32Bit.cpp | 12 ++++++++---
 .../arm/paging/32bit/ARMPagingMethod32Bit.h   | 18 ++++++++++++----
 .../paging/32bit/ARMPagingStructures32Bit.cpp |  7 ++++++-
 .../paging/32bit/ARMVMTranslationMap32Bit.cpp |  8 +++++++
 5 files changed, 58 insertions(+), 8 deletions(-)

diff --git a/headers/private/kernel/arch/arm/arch_cpu.h b/headers/private/kernel/arch/arm/arch_cpu.h
index ad0a36414f..38fa676618 100644
--- a/headers/private/kernel/arch/arm/arch_cpu.h
+++ b/headers/private/kernel/arch/arm/arch_cpu.h
@@ -124,6 +124,27 @@ arm_get_fp(void)
 }
 
 
+/*!	Cleans the data cache lines covering the given range to the point of
+	coherency. The translation table walker does not necessarily look into the
+	L1 data cache (e.g. on Cortex-A9 without ACTLR.SMP), so page table updates
+	must be pushed out before they are used.
+*/
+static inline void
+arm_clean_dcache_range(const void* address, size_t size)
+{
+	uint32 ctr;
+	asm volatile ("mrc p15, 0, %0, c0, c0, 1" : "=r" (ctr));
+	addr_t lineSize = 4 << ((ctr >> 16) & 0xf);
+
+	addr_t line = (addr_t)address & ~(lineSize - 1);
+	addr_t end = (addr_t)address + size;
+	dsb();
+	for (; line < end; line += lineSize)
+		asm volatile ("mcr p15, 0, %0, c7, c10, 1" : : "r" (line) : "memory");
+	dsb();
+}
+
+
 void arch_cpu_invalidate_TLB_page(addr_t page);
 
 static inline void
diff --git a/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.cpp b/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.cpp
index c25b8521d5..ee2dd0e351 100644
--- a/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.cpp
+++ b/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.cpp
@@ -184,6 +184,7 @@ ARMPagingMethod32Bit::PhysicalPageSlotPool::Map(phys_addr_t physicalAddress,
 		| ARM_MMU_L2_TYPE_SMALLNEW
 		| ARM_MMU_L2_FLAG_B | ARM_MMU_L2_FLAG_C
 		| ARM_MMU_L2_FLAG_HAIKU_KERNEL_RW | ARM_MMU_L2_FLAG_XN;
+	arm_clean_dcache_range(&pte, sizeof(pte));
 
 	arch_cpu_invalidate_TLB_page(virtualAddress);
 }
@@ -226,6 +227,7 @@ ARMPagingMethod32Bit::PhysicalPageSlotPool::AllocatePool(
 
 	// prepare the page table
 	memset(data, 0, B_PAGE_SIZE);
+	arm_clean_dcache_range(data, B_PAGE_SIZE);
 
 	// get the page table's physical address
 	phys_addr_t physicalTable;
@@ -387,6 +389,7 @@ ARMPagingMethod32Bit::MapEarly(kernel_args* args, addr_t virtualAddress,
 
 		// zero it out in it's new mapping
 		memset((void*)pgtable_virt, 0, B_PAGE_SIZE);
+		arm_clean_dcache_range((void*)pgtable_virt, B_PAGE_SIZE);
 
 		// put it in the pgdir
 		e = &fKernelVirtualPageDirectory[index];
@@ -487,8 +490,8 @@ ARMPagingMethod32Bit::PutPageTableInPageDir(page_directory_entry* entry,
 	dsb();
 
 	*entry = (pgtablePhysical & ARM_PDE_ADDRESS_MASK) | ARM_MMU_L1_TYPE_COARSE | attributes;
+	arm_clean_dcache_range(entry, sizeof(*entry));
 
-	dsb();
 	isb();
 }
 
@@ -506,8 +509,8 @@ ARMPagingMethod32Bit::PutPageTableEntryInTable(page_table_entry* entry,
 
 	// put it in the page table
 	*(volatile page_table_entry*)entry = page;
+	arm_clean_dcache_range(entry, sizeof(*entry));
 
-	dsb();
 	isb();
 }
 
@@ -526,7 +529,10 @@ ARMPagingMethod32Bit::_EarlyPreparePageTables(page_table_entry* pageTables,
 	addr_t address, size_t size)
 {
 	ARMPagingMethod32Bit* method = ARMPagingMethod32Bit::Method();
-	memset(pageTables, 0, 256 * (size / (B_PAGE_SIZE * 256)));
+	size_t tablesSize = 256 * sizeof(page_table_entry)
+		* (size / (B_PAGE_SIZE * 256));
+	memset(pageTables, 0, tablesSize);
+	arm_clean_dcache_range(pageTables, tablesSize);
 
 	// put the array of pgtables directly into the kernel pagedir
 	// these will be wired and kept mapped into virtual space to be easy to get
diff --git a/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.h b/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.h
index 6ffb2ecbc8..49986e9014 100644
--- a/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.h
+++ b/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.h
@@ -112,7 +112,9 @@ ARMPagingMethod32Bit::Method()
 ARMPagingMethod32Bit::SetPageTableEntry(page_table_entry* entry,
 	page_table_entry newEntry)
 {
-	return atomic_get_and_set((int32*)entry, newEntry);
+	page_table_entry oldEntry = atomic_get_and_set((int32*)entry, newEntry);
+	arm_clean_dcache_range(entry, sizeof(*entry));
+	return oldEntry;
 }
 
 
@@ -120,7 +122,9 @@ ARMPagingMethod32Bit::SetPageTableEntry(page_table_entry* entry,
 ARMPagingMethod32Bit::SetPageTableEntryFlags(page_table_entry* entry,
 	uint32 flags)
 {
-	return atomic_or((int32*)entry, flags);
+	page_table_entry oldEntry = atomic_or((int32*)entry, flags);
+	arm_clean_dcache_range(entry, sizeof(*entry));
+	return oldEntry;
 }
 
 
@@ -128,7 +132,10 @@ ARMPagingMethod32Bit::SetPageTableEntryFlags(page_table_entry* entry,
 ARMPagingMethod32Bit::TestAndSetPageTableEntry(page_table_entry* entry,
 	page_table_entry newEntry, page_table_entry oldEntry)
 {
-	return atomic_test_and_set((int32*)entry, newEntry, oldEntry);
+	page_table_entry previous = atomic_test_and_set((int32*)entry, newEntry,
+		oldEntry);
+	arm_clean_dcache_range(entry, sizeof(*entry));
+	return previous;
 }
 
 
@@ -142,7 +149,9 @@ ARMPagingMethod32Bit::ClearPageTableEntry(page_table_entry* entry)
 /*static*/ inline page_table_entry
 ARMPagingMethod32Bit::ClearPageTableEntryFlags(page_table_entry* entry, uint32 flags)
 {
-	return atomic_and((int32*)entry, ~flags);
+	page_table_entry oldEntry = atomic_and((int32*)entry, ~flags);
+	arm_clean_dcache_range(entry, sizeof(*entry));
+	return oldEntry;
 }
 
 
@@ -158,6 +167,7 @@ ARMPagingMethod32Bit::SetAndClearPageTableEntryFlags(page_table_entry* entry, ui
 			break;
 		originalValue = oldEntry;
 	}
+	arm_clean_dcache_range(entry, sizeof(*entry));
 
 	return originalValue;
 }
diff --git a/src/system/kernel/arch/arm/paging/32bit/ARMPagingStructures32Bit.cpp b/src/system/kernel/arch/arm/paging/32bit/ARMPagingStructures32Bit.cpp
index 5f7176bc54..35d0b1dbdf 100644
--- a/src/system/kernel/arch/arm/paging/32bit/ARMPagingStructures32Bit.cpp
+++ b/src/system/kernel/arch/arm/paging/32bit/ARMPagingStructures32Bit.cpp
@@ -81,6 +81,9 @@ ARMPagingStructures32Bit::Init(page_directory_entry* virtualPageDir,
 				NUM_KERNEL_PGDIR_ENTS * sizeof(page_directory_entry));
 		}
 
+		arm_clean_dcache_range(pgdir_virt,
+			ARM_MMU_L1_TABLE_ENTRY_COUNT * sizeof(page_directory_entry));
+
 		sPagingStructuresList.Add(this);
 
 		release_spinlock(&sPagingStructuresListLock);
@@ -127,6 +130,8 @@ ARMPagingStructures32Bit::UpdateAllPageDirs(int index,
 	InterruptsSpinLocker locker(sPagingStructuresListLock);
 
 	PagingStructuresList::ConstIterator it = sPagingStructuresList.GetIterator();
-	while (ARMPagingStructures32Bit* info = it.Next())
+	while (ARMPagingStructures32Bit* info = it.Next()) {
 		info->pgdir_virt[index] = entry;
+		arm_clean_dcache_range(&info->pgdir_virt[index], sizeof(entry));
+	}
 }
diff --git a/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp b/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
index 41a53b7220..cf7e54417c 100644
--- a/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
+++ b/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
@@ -187,6 +187,14 @@ ARMVMTranslationMap32Bit::Map(addr_t va, phys_addr_t pa, uint32 attributes,
 
 		TRACE("map_tmap: asked for free page for pgtable. 0x%lx\n", pgtable);
 
+		// the page was cleared through the cache, make sure the table walker
+		// does not see stale memory
+		{
+			ThreadCPUPinner pinner(thread_get_current_thread());
+			arm_clean_dcache_range(fPageMapper->GetPageTableAt(pgtable),
+				B_PAGE_SIZE);
+		}
+
 		// put it in the pgdir
 		ARMPagingMethod32Bit::PutPageTableInPageDir(&pd[index], pgtable,
 			(va < KERNEL_BASE) ? ARM_MMU_L1_FLAG_PXN : 0);
