 	boot_timer_info &timer = gKernelArgs.arch_args.timer;
 	if (timer.kind[0] == 0) {
 		for (uint32 i = 0; i < B_COUNT_OF(kSupportedTimers); i++) {
@@ -101,9 +257,106 @@ arch_handle_fdt(const void* fdt, int node)
