+	the boot CPU it is up, waits until the kernel arguments are ready, then
+	enters the kernel with the parameters of arch_enter_kernel_parameters.
+*/
+FUNCTION(arch_enter_kernel_secondary):
+	cpsid	aif
+
+	// invalidate the L1 data cache by set/way
+	mov		r0, #0
+	mcr		p15, 2, r0, c0, c0, 0	// CSSELR: level 1 data cache
+	isb
+	mrc		p15, 1, r0, c0, c0, 0	// CCSIDR
+	movw	r1, #0x7fff
+	and		r2, r1, r0, lsr #13		// number of sets - 1
+	movw	r1, #0x3ff
+	and		r3, r1, r0, lsr #3		// associativity - 1
+	add		r2, r2, #1				// number of sets
+	and		r0, r0, #0x7
+	add		r0, r0, #4				// log2 of the line size
+	clz		r1, r3					// shift of the way
+	add		r4, r3, #1				// number of ways
+1:	sub		r2, r2, #1
+	mov		r3, r4
+2:	subs	r3, r3, #1
+	mov		r5, r3, lsl r1
+	mov		r6, r2, lsl r0
+	orr		r5, r5, r6
+	mcr		p15, 0, r5, c7, c6, 2	// DCISW
+	bgt		2b
+	cmp		r2, #0
+	bgt		1b
+	dsb
+
+	mov		r0, #0
+	mcr		p15, 0, r0, c7, c5, 0	// ICIALLU
+	mcr		p15, 0, r0, c7, c5, 6	// BPIALL
+	mcr		p15, 0, r0, c8, c7, 0	// TLBIALL
+	dsb
+	isb
+
+	// our CPU number, from MPIDR.Aff0
+	mrc		p15, 0, r6, c0, c0, 5
+	and		r6, r6, #0xff
+
+	// we are up; the boot CPU reads this with its caches on, it invalidates
+	// the line first
+	adr		r9, arch_enter_kernel_parameters
+	mov		r0, #1
+	add		r1, r9, #(ENTER_KERNEL_STARTED)
+	str		r0, [r1, r6, lsl #2]
+	dsb
+
+	// wait for the go: the kernel arguments are in place
+3:	ldr		r0, [r9, #(ENTER_KERNEL_GO)]
+	cmp		r0, #0
+	bne		4f
+	wfe
+	b		3b
+
+4:	ldr		r0, [r9, #(ENTER_KERNEL_TTBR)]
+	ldr		r1, [r9, #(ENTER_KERNEL_ARGS)]
+	ldr		r2, [r9, #(ENTER_KERNEL_ENTRY)]
+	add		r3, r9, #(ENTER_KERNEL_STACKS)
+	ldr		r3, [r3, r6, lsl #2]
+	b		_enter_kernel_common
+FUNCTION_END(arch_enter_kernel_secondary)
+
+
+// filled in by arch_smp_boot_other_cpus() in the trampoline page
+.balign 64
+FUNCTION(arch_enter_kernel_parameters):
+	.word	0		// TTBR
+	.word	0		// kernel args
+	.word	0		// kernel entry
+	.word	0		// go
+	.rept	4
+	.word	0		// stack tops
+	.endr
+	.balign	64		// the started flags get their own cache line
+	.rept	4
+	.word	0
+	.endr
+	.balign	64
+FUNCTION_END(arch_enter_kernel_parameters)
+
