+/*!	Stops the Tegra20 USB controllers the firmware left running: an active
+	controller keeps writing transfer descriptors into memory the kernel will
+	reuse. Must be called while the boot services are still available.
+*/
+void
+arch_quiesce_usb(void)
+{
+	// clock enable bit / reset bit per controller (USBD, USB2, USB3)
+	static const struct {
+		uint32 base;
+		uint32 enableRegister;
+		uint32 resetRegister;
+		uint32 bit;
+	} kClocks[] = {
+		{ 0xc5000000, 0x10, 0x04, 22 },
+		{ 0xc5004000, 0x14, 0x08, 26 },
+		{ 0xc5008000, 0x14, 0x08, 27 },
+	};
+
+	if (sTegraCARRegs.start == 0)
+		return;
+
+	for (uint32 i = 0; i < sTegraUSBCount; i++) {
+		addr_t base = (addr_t)sTegraUSBRegs[i].start;
+		uint32 slot = 3;
+		for (uint32 j = 0; j < B_COUNT_OF(kClocks); j++) {
+			if (kClocks[j].base == base)
+				slot = j;
+		}
+		if (slot == 3)
+			continue;
+
+		addr_t car = (addr_t)sTegraCARRegs.start;
+		uint32 enabled = *(volatile uint32*)(car + kClocks[slot].enableRegister);
+		uint32 reset = *(volatile uint32*)(car + kClocks[slot].resetRegister);
+		uint32 mask = 1U << kClocks[slot].bit;
+		if ((enabled & mask) == 0 || (reset & mask) != 0) {
+			dprintf("USB %#lx: clock off or in reset\n", base);
+			continue;
+		}
+
+		addr_t capabilities = base + 0x100;
+		addr_t operational = capabilities
+			+ (*(volatile uint32*)capabilities & 0xff);
+		volatile uint32* command = (volatile uint32*)operational;
+		volatile uint32* status = (volatile uint32*)(operational + 4);
+		uint32 mode = *(volatile uint32*)(operational + 0x68) & 3;
+		dprintf("USB %#lx: USBCMD %#" B_PRIx32 ", USBSTS %#" B_PRIx32
+			", mode %" B_PRIu32 "\n", base, *command, *status, mode);
+
+		// stop the schedules, then the controller
+		*command &= ~0x30U;
+		for (int k = 0; k < 100 && (*status & 0xc000) != 0; k++)
+			kBootServices->Stall(20);
+		*command &= ~1U;
+		for (int k = 0; k < 100 && (*status & 0x1000) == 0; k++)
+			kBootServices->Stall(20);
+		dprintf("USB %#lx: stopped, USBSTS %#" B_PRIx32 "\n", base, *status);
+	}
+}
+
+
+/*!	Switches the radios of rfkill-gpio nodes on, as Linux does when they are
+	not blocked: drives their GPIOs active, as outputs in GPIO mode.
+*/
+static void
+enable_radio_gpios(void)
+{
+	if (sTegraGPIORegs.start == 0)
+		return;
+
+	if (sRadioGPIOCount == 0 && sIsAC100) {
+		sRadioGPIOs[0].pin = 25;
+		sRadioGPIOs[0].activeLow = false;
+		sRadioGPIOs[1].pin = 85;
+		sRadioGPIOs[1].activeLow = false;
+		sRadioGPIOCount = 2;
+	}
+
+	for (uint32 i = 0; i < sRadioGPIOCount; i++) {
+		uint32 pin = sRadioGPIOs[i].pin;
+		// 32 GPIOs per bank, 8 per port; the masked registers at 0x800 take
+		// the bits to change in their upper byte
+		addr_t port = (addr_t)sTegraGPIORegs.start + (pin / 32) * 0x80
+			+ ((pin % 32) / 8) * 4;
+		uint32 bit = 1U << (pin % 8);
+		uint32 value = sRadioGPIOs[i].activeLow ? 0 : bit;
+		*(volatile uint32*)(port + 0x820) = (bit << 8) | value;	// output
+		*(volatile uint32*)(port + 0x810) = (bit << 8) | bit;	// enable
+		*(volatile uint32*)(port + 0x800) = (bit << 8) | bit;	// GPIO mode
+		dprintf("radio: GPIO %" B_PRIu32 " set %s\n", pin,
+			value != 0 ? "high" : "low");
+	}
+}
