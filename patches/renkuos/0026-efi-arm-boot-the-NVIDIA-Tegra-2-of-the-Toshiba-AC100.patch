+			sRadioGPIOCount++;
+		}
+	}
+
+	// the kernel resets the machine through it
+	if (gKernelArgs.arch_args.pmc.start == 0
+		&& dtb_has_fdt_string(compatible, compatibleLen, "nvidia,tegra20-pmc")) {
+		dtb_get_reg(fdt, node, 0, gKernelArgs.arch_args.pmc);
+	}
+	if (gKernelArgs.arch_args.rtc.start == 0
+		&& dtb_has_fdt_string(compatible, compatibleLen, "nvidia,tegra20-rtc")) {
+		dtb_get_reg(fdt, node, 0, gKernelArgs.arch_args.rtc);
+	}
+	// the power management IC behind it has the battery backed clock
+	if (gKernelArgs.arch_args.pmicI2C.start == 0
+		&& dtb_has_fdt_string(compatible, compatibleLen,
+			"nvidia,tegra20-i2c-dvc")) {
+		dtb_get_reg(fdt, node, 0, gKernelArgs.arch_args.pmicI2C);
+	}
+
+	if (sL2Regs.start == 0 && dtb_has_fdt_string(compatible, compatibleLen,
+			"arm,pl310-cache")) {
+		dtb_get_reg(fdt, node, 0, sL2Regs);
+		gKernelArgs.arch_args.l2Cache = sL2Regs;
+
+		// <read write setup> cycles, as the latency registers want them
+		static const char* const kLatencies[] = { "arm,tag-latency",
+			"arm,data-latency" };
+		uint32* registers[] = { &gKernelArgs.arch_args.l2TagLatency,
+			&gKernelArgs.arch_args.l2DataLatency };
+		for (uint32 i = 0; i < 2; i++) {
+			int length;
+			const uint32* cells = (const uint32*)fdt_getprop(fdt, node,
+				kLatencies[i], &length);
+			if (cells == NULL || length < 12)
+				continue;
+			uint32 read = fdt32_to_cpu(cells[0]);
+			uint32 write = fdt32_to_cpu(cells[1]);
+			uint32 setup = fdt32_to_cpu(cells[2]);
+			if (read == 0 || write == 0 || setup == 0)
+				continue;
+			*registers[i] = ((setup - 1) & 7) | (((read - 1) & 7) << 4)
+				| (((write - 1) & 7) << 8);
+		}
+	}
