+			? gKernelArgs.cpu_kstack[i].start + gKernelArgs.cpu_kstack[i].size
+			: 0;
+		params[ENTER_KERNEL_STARTED / 4 + i] = 0;
+	}
+	// the other CPUs start with their caches off
+	clean_dcache_all();
+
+	addr_t entry = (addr_t)trampolinePage
+		+ ((addr_t)arch_enter_kernel_secondary - (addr_t)arch_enter_kernel);
+	volatile uint32* started = &params[ENTER_KERNEL_STARTED / 4];
