+				: "memory");	// DCIMVAC
+			asm volatile("dsb" : : : "memory");
+			up = started[count] != 0;
+		}
+		if (!up) {
+			dprintf("smp: CPU %" B_PRIu32 " did not come up\n", count);
+			break;
+		}
