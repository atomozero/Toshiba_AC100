From a44433bbfce43588c6419485670d735f0785d9e7 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Fri, 20 Nov 2026 07:59:16 +0100
Subject: [PATCH 19/32] kernel/legacy_drivers: fail the open of a device the
 reloaded driver dropped

When a legacy driver binary was updated, the open of one of its devices
reloads it first. If the new driver no longer publishes that device, the
open went on with the hooks of the image that had just been unloaded; it
now fails with ENODEV. A failed reload also left the device counted as
initialized: both errors undo the count.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/system/kernel/device_manager/legacy_drivers.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/system/kernel/device_manager/legacy_drivers.cpp b/src/system/kernel/device_manager/legacy_drivers.cpp
index 1d8a62d95a..c55fdf6be3 100644
--- a/src/system/kernel/device_manager/legacy_drivers.cpp
+++ b/src/system/kernel/device_manager/legacy_drivers.cpp
@@ -1284,8 +1284,15 @@ LegacyDevice::InitDevice()
 	if (fDriver != NULL && fDriver->devices_used == 0
 		&& (fDriver->image < 0 || fDriver->binary_updated)) {
 		status_t status = reload_driver(fDriver);
-		if (status < B_OK)
+		if (status == B_OK && fRemovedFromParent) {
+			// the reloaded driver no longer publishes this device: its hooks
+			// belong to the image that was unloaded
+			status = ENODEV;
+		}
+		if (status < B_OK) {
+			fInitialized--;
 			return status;
+		}
 	}
 
 	if (fDriver != NULL)
