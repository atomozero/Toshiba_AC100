+
+static uint32
+fdt_get_uint32(fdt_device_module_info* module, fdt_device* dev,
+	const char* name, uint32 index, uint32 defaultValue)
+{
+	int length;
+	const uint32* cells = (const uint32*)module->get_prop(dev, name, &length);
+	if (cells == NULL || length < (int)((index + 1) * sizeof(uint32)))
+		return defaultValue;
+	return B_BENDIAN_TO_HOST_INT32(cells[index]);
+}
+
+
+static status_t
+nvec_init_driver(device_node* node, void** _cookie)
+{
+	nvec_device* device = new(std::nothrow) nvec_device;
+	if (device == NULL)
+		return B_NO_MEMORY;
+	memset((void*)device, 0, sizeof(*device));
+	device->node = node;
+	device->lock = B_SPINLOCK_INITIALIZER;
+	device->keyLock = B_SPINLOCK_INITIALIZER;
+	device->mouseLock = B_SPINLOCK_INITIALIZER;
+	device->batteryLock = B_SPINLOCK_INITIALIZER;
+	mutex_init(&device->powerButtonLock, "nvec power button");
+	mutex_init(&device->diagLock, "nvec diag");
+	device->diagSem = -1;
+	device->diagClass = -1;
+	device->registersArea = device->gpioArea = device->pwmArea = -1;
+	device->rxSem = device->txSem = device->transferSem = device->keySem
+		= device->mouseSem = -1;
+	device->repeatDelay = 300000;
+	device->repeatRate = 35000;
+	device->clickSpeed = 500000;
+
+	status_t status;
+	{
+		device_node* parent = gDeviceManager->get_parent_node(node);
+		fdt_device_module_info* fdt;
+		fdt_device* fdtDevice;
+		status = gDeviceManager->get_driver(parent,
+			(driver_module_info**)&fdt, (void**)&fdtDevice);
+		gDeviceManager->put_node(parent);
+		if (status != B_OK)
+			goto err;
+
+		uint64 registers, length;
+		if (!fdt->get_reg(fdtDevice, 0, &registers, &length)
+			|| !fdt->get_interrupt(fdtDevice, 0, NULL, &device->irq)) {
+			status = B_BAD_DATA;
+			goto err;
+		}
+		// <phandle gpio flags>
+		device->requestGPIO = fdt_get_uint32(fdt, fdtDevice, "request-gpios",
+			1, 0xaa);
+		device->requestActiveLow = (fdt_get_uint32(fdt, fdtDevice,
+			"request-gpios", 2, 0) & 1) != 0;
+		device->slaveAddress = fdt_get_uint32(fdt, fdtDevice, "slave-addr", 0,
+			0x8a);
+
+		status = map_registers("nvec", registers, &device->registersArea,
+			&device->registers);
+		if (status != B_OK)
+			goto err;
+		TRACE_ALWAYS("controller at %#" B_PRIx64 ", IRQ %" B_PRIu64
+			", request GPIO %" B_PRIu32 ", address %#" B_PRIx32 "\n",
+			registers, device->irq, device->requestGPIO,
+			device->slaveAddress);
+	}
+
+	device->rxSem = create_sem(0, "nvec rx");
+	device->txSem = create_sem(0, "nvec tx");
+	device->transferSem = create_sem(0, "nvec transfer");
+	device->keySem = create_sem(0, "nvec keys");
+	device->mouseSem = create_sem(0, "nvec movements");
+	device->diagSem = create_sem(0, "nvec diag");
+	if (device->rxSem < B_OK || device->txSem < B_OK
+		|| device->transferSem < B_OK || device->keySem < B_OK
+		|| device->mouseSem < B_OK) {
+		status = B_NO_MORE_SEMS;
+		goto err;
+	}
+
+	status = setup_hardware(device);
+	if (status != B_OK)
+		goto err;
+	setup_backlight(device);
+
+	status = install_io_interrupt_handler(device->irq, nvec_interrupt, device,
+		0);
+	if (status != B_OK)
+		goto err;
+
+	device->rxThread = spawn_kernel_thread(rx_thread, "nvec rx",
+		B_URGENT_DISPLAY_PRIORITY, device);
+	device->txThread = spawn_kernel_thread(tx_thread, "nvec tx",
+		B_URGENT_DISPLAY_PRIORITY, device);
+	resume_thread(device->rxThread);
+	resume_thread(device->txThread);
+
+	start_ec(device);
+
+	device->pollThread = spawn_kernel_thread(poll_thread, "nvec poll",
+		B_LOW_PRIORITY, device);
+	resume_thread(device->pollThread);
+
+	sPowerOffDevice = device;
+	gArmPowerOffHook = &nvec_power_off;
+
+	*_cookie = device;
+	return B_OK;
+
+err:
+	TRACE_ALWAYS("init failed: %s\n", strerror(status));
+	mutex_destroy(&device->powerButtonLock);
+	mutex_destroy(&device->diagLock);
+	delete_sem(device->diagSem);
+	delete_sem(device->rxSem);
+	delete_sem(device->txSem);
+	delete_sem(device->transferSem);
+	delete_sem(device->keySem);
+	delete_sem(device->mouseSem);
+	delete_area(device->registersArea);
+	delete_area(device->gpioArea);
+	delete_area(device->pwmArea);
+	delete device;
+	return status;
+}
+
+
+static void
+nvec_uninit_driver(void* cookie)
+{
+	nvec_device* device = (nvec_device*)cookie;
+
+	gArmPowerOffHook = NULL;
+	sPowerOffDevice = NULL;
+
+	device->stopping = true;
+	remove_io_interrupt_handler(device->irq, nvec_interrupt, device);
+	mutex_destroy(&device->powerButtonLock);
+	delete_sem(device->rxSem);
+	delete_sem(device->txSem);
+	delete_sem(device->transferSem);
+	delete_sem(device->keySem);
+	delete_sem(device->mouseSem);
+	status_t result;
+	wait_for_thread(device->rxThread, &result);
+	wait_for_thread(device->txThread, &result);
+	wait_for_thread(device->pollThread, &result);
+	delete_area(device->registersArea);
+	delete_area(device->gpioArea);
+	delete_area(device->pwmArea);
+	delete device;
+}
+
+
+static status_t
+nvec_register_child_devices(void* cookie)
+{
+	nvec_device* device = (nvec_device*)cookie;
+
+	status_t status = gDeviceManager->publish_device(device->node,
+		"input/keyboard/nvec/0", NVEC_DEVICE_MODULE_NAME);
+	if (status == B_OK) {
+		status = gDeviceManager->publish_device(device->node,
+			"input/mouse/nvec/0", NVEC_DEVICE_MODULE_NAME);
+	}
+	if (status == B_OK) {
+		status = gDeviceManager->publish_device(device->node,
+			"power/nvec_battery/0", NVEC_DEVICE_MODULE_NAME);
+	}
+	if (status == B_OK) {
+		status = gDeviceManager->publish_device(device->node,
+			"power/button/power_nvec", NVEC_DEVICE_MODULE_NAME);
+	}
+	if (status == B_OK) {
+		gDeviceManager->publish_device(device->node, NVEC_DIAG_PATH,
+			NVEC_DEVICE_MODULE_NAME);
+	}
+	return status;
+}
