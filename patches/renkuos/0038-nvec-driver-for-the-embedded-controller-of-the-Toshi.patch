+static status_t
+nvec_open(void* cookie, const char* path, int openMode, void** _cookie)
+{
+	nvec_handle* handle = new(std::nothrow) nvec_handle;
+	if (handle == NULL)
+		return B_NO_MEMORY;
+
+	handle->device = (nvec_device*)cookie;
+	if (strstr(path, "keyboard") != NULL)
+		handle->kind = NVEC_KEYBOARD;
+	else if (strstr(path, "mouse") != NULL)
+		handle->kind = NVEC_MOUSE;
+	else if (strstr(path, "button") != NULL)
+		handle->kind = NVEC_POWER_BUTTON;
+	else if (strcmp(path, NVEC_DIAG_PATH) == 0)
+		handle->kind = NVEC_DIAG;
+	else
+		handle->kind = NVEC_BATTERY;
+	*_cookie = handle;
+	return B_OK;
+}
