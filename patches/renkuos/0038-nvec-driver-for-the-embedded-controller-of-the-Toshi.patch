+
+static status_t
+nvec_read(void* cookie, off_t position, void* buffer, size_t* _length)
+{
+	nvec_handle* handle = (nvec_handle*)cookie;
+	if (handle->kind != NVEC_POWER_BUTTON || *_length < 1) {
+		*_length = 0;
+		return B_NOT_ALLOWED;
+	}
+
+	// 1 if the button was pressed since the last read
+	nvec_device* device = handle->device;
+	MutexLocker locker(device->powerButtonLock);
+	uint8 pressed = device->powerButtonPressed;
+	device->powerButtonPressed = 0;
+	locker.Unlock();
+
+	if (!IS_USER_ADDRESS(buffer)
+		|| user_memcpy(buffer, &pressed, sizeof(pressed)) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+	*_length = 1;
+	return B_OK;
+}
+
+
+static status_t
+nvec_select(void* cookie, uint8 event, selectsync* sync)
+{
+	nvec_handle* handle = (nvec_handle*)cookie;
+	if (handle->kind != NVEC_POWER_BUTTON || event != B_SELECT_READ)
+		return B_BAD_VALUE;
+
+	nvec_device* device = handle->device;
+	MutexLocker locker(device->powerButtonLock);
+	status_t status = add_select_sync_pool_entry(
+		&device->powerButtonSelectPool, sync, event);
+	if (status == B_OK && device->powerButtonPressed != 0)
+		notify_select_event(sync, event);
+	return status;
+}
+
+
+static status_t
+nvec_deselect(void* cookie, uint8 event, selectsync* sync)
+{
+	nvec_handle* handle = (nvec_handle*)cookie;
+	if (handle->kind != NVEC_POWER_BUTTON || event != B_SELECT_READ)
+		return B_BAD_VALUE;
+
+	nvec_device* device = handle->device;
+	MutexLocker locker(device->powerButtonLock);
+	return remove_select_sync_pool_entry(&device->powerButtonSelectPool, sync,
+		event);
+}
