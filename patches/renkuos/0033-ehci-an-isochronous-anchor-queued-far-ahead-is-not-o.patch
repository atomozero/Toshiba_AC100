From 1e178b1edaad9d2cfb436125aaae428fc84a1bbb Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 24 Nov 2026 12:43:41 +0100
Subject: [PATCH] ehci: an isochronous anchor queued far ahead is not one
 already passed

The check added to never chain a transfer into frames already passed took
an anchor more than half the virtual frame list ahead (64 ms) for one that
had passed, as the anchor only counted frames modulo that list. usb_audio
keeps about 100 ms queued: every transfer then started again near the
current frame, in frames its predecessors already filled, and only every
other one carried data (a UAC microphone on an AC100 recorded half silence).

Keep the anchor modulo the whole frame list, and take it for passed only
when it is behind the controller or more than a virtual frame list ahead.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/busses/usb/ehci.cpp | 21 ++++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/src/add-ons/kernel/busses/usb/ehci.cpp b/src/add-ons/kernel/busses/usb/ehci.cpp
index af6f28fce1..c83adb0ff9 100644
--- a/src/add-ons/kernel/busses/usb/ehci.cpp
+++ b/src/add-ons/kernel/busses/usb/ehci.cpp
@@ -2120,13 +2120,19 @@ EHCI::SubmitIsochronous(Transfer *transfer)
 			// were not seen by the finisher, which only looks a few frames
 			// back, and ran a whole frame list later into the buffer of a
 			// transfer that was long finished.
+			// The anchor counts frames modulo the whole frame list, so a
+			// transfer queued up to a virtual frame list ahead (128 ms; a
+			// sound card keeps about 100 ms queued) is not mistaken for one
+			// whose frames have passed.
 			uint32 now = (ReadOpReg(EHCI_FRINDEX) / 8)
-				& (EHCI_VFRAMELIST_ENTRIES_COUNT - 1);
+				& (EHCI_FRAMELIST_ENTRIES_COUNT - 1);
 			uint32 ahead = ((uint32)anchor - now)
-				& (EHCI_VFRAMELIST_ENTRIES_COUNT - 1);
+				& (EHCI_FRAMELIST_ENTRIES_COUNT - 1);
 			uint32 margin = (fThreshold + 7) / 8 + 1;
-			if (ahead < margin || ahead >= EHCI_VFRAMELIST_ENTRIES_COUNT / 2)
+			if (ahead < margin || ahead >= EHCI_VFRAMELIST_ENTRIES_COUNT)
 				anchor = -1;
+			else
+				anchor &= EHCI_VFRAMELIST_ENTRIES_COUNT - 1;
 		}
 		if (fFirstIsochronousTransfer != NULL && anchor != -1)
 			currentFrame = anchor;
@@ -4249,6 +4255,15 @@ EHCI::GetIsoAnchor(Pipe *pipe)
 void
 EHCI::SetIsoAnchor(Pipe *pipe, int32 frame)
 {
+	// Keep the frame modulo the whole frame list: the frame is less than a
+	// virtual frame list ahead of the controller, which tells which of its
+	// turns it belongs to.
+	uint32 now = (ReadOpReg(EHCI_FRINDEX) / 8)
+		& (EHCI_FRAMELIST_ENTRIES_COUNT - 1);
+	frame = (now + (((uint32)frame - now)
+		& (EHCI_VFRAMELIST_ENTRIES_COUNT - 1)))
+		& (EHCI_FRAMELIST_ENTRIES_COUNT - 1);
+
 	int free = -1;
 	for (int i = 0; i < kIsoAnchorCount; i++) {
 		if (fIsoAnchors[i].pipe == pipe) {
-- 
