From 73485a672a2876868b4825b1140483e51b8cebb2 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Thu, 19 Nov 2026 21:02:01 +0100
Subject: [PATCH 09/32] Revert "DIAGNOSTIC sdhci: log the PIO reference reads
 of the self test (temporary)"

This reverts commit bac76e4520586416294ba571f3b37fac70465ea7.
---
 src/add-ons/kernel/busses/mmc/sdhci.cpp | 40 ++++++-------------------
 1 file changed, 9 insertions(+), 31 deletions(-)

diff --git a/src/add-ons/kernel/busses/mmc/sdhci.cpp b/src/add-ons/kernel/busses/mmc/sdhci.cpp
index 6d245caec4..c6905e0b68 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci.cpp
+++ b/src/add-ons/kernel/busses/mmc/sdhci.cpp
@@ -293,12 +293,6 @@ static const uint32 kDataStatusBits = SDHCI_INT_TRANS_CMP
 static const uint32 kClearableStatusBits = ~(uint32)(SDHCI_INT_CARD_INS
 	| SDHCI_INT_CARD_REM | SDHCI_INT_CARD_STATUS);
 
-// DIAGNOSTIC (AC100 PIO self test): what the PIO read of the last block saw
-// when it found the buffer ready, and when it ended
-static uint32 sPioReadyLive;
-static uint32 sPioReadyPresent;
-static uint32 sPioEndPresent;
-
 // #pragma mark -
 /*
 PartA2, SD Host Controller Simplified Specification, Version 4.20
@@ -1215,11 +1209,8 @@ SdhciBus::_TransferChunk(uint8 command, uint32 argument, uint32 blockCount,
 				uint32 present = fRegisters->present_state.Bits();
 				bool bufferEnabled = (present & bufferEnableBit) != 0
 					&& (isWrite || (present & (1 << 9)) == 0);
-				if ((live & readyBit) != 0 || bufferEnabled) {
-					sPioReadyLive = live;
-					sPioReadyPresent = fRegisters->present_state.Bits();
+				if ((live & readyBit) != 0 || bufferEnabled)
 					break;
-				}
 				bigtime_t now = system_time();
 				if (now >= deadline) {
 					status = B_TIMED_OUT;
@@ -1253,7 +1244,6 @@ SdhciBus::_TransferChunk(uint8 command, uint32 argument, uint32 blockCount,
 			} else {
 				for (uint32 i = 0; i < wordCount; i++)
 					words[i] = fRegisters->buffer_data_port;
-				sPioEndPresent = fRegisters->present_state.Bits();
 				if (buffer != NULL)
 					memcpy(buffer + offset, words, blockSize);
 				else
@@ -1532,28 +1522,16 @@ SdhciBus::_SelectTransferMode()
 		status_t status = B_ERROR;
 		for (int attempt = 0; attempt < 4; attempt++) {
 			status = B_OK;
-			for (uint32 r = 0; r < 4 && status == B_OK; r++) {
-				uint32 i = r & 1;
-				uint8* target = (r < 2 ? reference : again);
-				if (target == NULL)
-					break;
-				target += i * kBlockSize;
-				uint32 before = fRegisters->present_state.Bits();
-				uint32 statusBefore = fRegisters->interrupt_status;
-				sPioReadyLive = sPioReadyPresent = sPioEndPresent = 0;
+			for (uint32 i = 0; i < 2 && status == B_OK; i++) {
+				status = _TransferChunk(SD_READ_SINGLE_BLOCK, i * step, 1,
+					kBlockSize, false, kDataModePio, kStopModeSingle, 0,
+					reference + i * kBlockSize, kSelfTestTimeout);
+			}
+			for (uint32 i = 0; i < 2 && status == B_OK && again != NULL;
+					i++) {
 				status = _TransferChunk(SD_READ_SINGLE_BLOCK, i * step, 1,
 					kBlockSize, false, kDataModePio, kStopModeSingle, 0,
-					target, kSelfTestTimeout);
-				// DIAGNOSTIC (AC100 PIO self test)
-				TRACE_ALWAYS("pio read %" B_PRIu32 " (block %" B_PRIu32 "): %s, "
-					"before: state %08" B_PRIx32 " int %08" B_PRIx32 "; ready: "
-					"int %08" B_PRIx32 " state %08" B_PRIx32 "; after data: state "
-					"%08" B_PRIx32 "; now %08" B_PRIx32 "; data %02x%02x%02x%02x "
-					"... %02x%02x\n", r, i, strerror(status), before,
-					statusBefore, sPioReadyLive, sPioReadyPresent,
-					sPioEndPresent, fRegisters->present_state.Bits(),
-					target[0], target[1], target[2], target[3], target[510],
-					target[511]);
+					again + i * kBlockSize, kSelfTestTimeout);
 			}
 			if (status == B_OK && (again == NULL
 					|| memcmp(again, reference, testLength) == 0))
-- 
