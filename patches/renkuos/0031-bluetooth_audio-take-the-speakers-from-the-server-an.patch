diff --git a/src/servers/bluetooth/BluetoothServer.cpp b/src/servers/bluetooth/BluetoothServer.cpp
index ed60a76fbe..6467c0ccf0 100644
--- a/src/servers/bluetooth/BluetoothServer.cpp
+++ b/src/servers/bluetooth/BluetoothServer.cpp
@@ -226,6 +226,43 @@ void BluetoothServer::MessageReceived(BMessage* message)
 		}
 		break;
 
+		case BT_MSG_GET_BONDED_DEVICES:
+		{
+			BMessage reply(BT_MSG_GET_BONDED_DEVICES);
+			BAutolock locker(fStoresLock);
+			for (int32 i = 0; i < fBondStores.CountItems(); i++) {
+				BondStore* bonds = fBondStores.ItemAt(i);
+				DeviceCache* devices = DeviceCacheFor(bonds->Adapter());
+				BMessage described;
+				bonds->Describe(described);
+				BMessage bond;
+				for (int32 j = 0; described.FindMessage("bond", j, &bond)
+						== B_OK; j++) {
+					const void* data;
+					ssize_t size;
+					if (bond.FindData("address", B_RAW_TYPE, &data, &size)
+							!= B_OK || size != sizeof(bdaddr_t)) {
+						continue;
+					}
+					DeviceRecord record;
+					if (devices != NULL)
+						devices->Get(*(const bdaddr_t*)data, record);
+					BMessage device;
+					device.AddData("address", B_RAW_TYPE, data, size);
+					device.AddString("name", record.name);
+					device.AddData("class", B_RAW_TYPE, record.deviceClass,
+						sizeof(record.deviceClass));
+					for (uint8 k = 0; k < record.serviceClassCount; k++) {
+						device.AddUInt16("service class",
+							record.serviceClasses[k]);
+					}
+					reply.AddMessage("device", &device);
+				}
+			}
+			message->SendReply(&reply);
+			return;
+		}
+
 		case kMsgBondChanged:
 		{
 			BMessage notice(*message);
@@ -736,7 +773,15 @@ BluetoothServer::BondStoreFor(const bdaddr_t& adapter)
 	bonds->Load();
 	if (firstTime)
 		_ImportPairedDevicesFile(bonds, devices);
+	_RetirePairedDevicesFile();
 	bonds->SetListener(this);
+
+	// whoever waits for the bonds of the controllers (the Bluetooth audio
+	// add-on, which may have started before us) can ask for them now
+	BMessage loaded(kMsgBondChanged);
+	loaded.AddData("adapter", B_RAW_TYPE, &adapter, sizeof(bdaddr_t));
+	loaded.AddInt32("change", 3);
+	PostMessage(&loaded);
 	return bonds;
 }
 
@@ -799,8 +844,8 @@ BluetoothServer::_StateDirectory(BPath& path)
 /*!	Takes the paired devices of the file kept before the bond store: the
 	keys become bonds of this adapter (the file did not tell which adapter
 	they were of), and what is known of every device goes to the cache.
-	The file stays as it is, for the Bluetooth audio add-on that still
-	reads it; the server no longer writes it.
+	The server no longer writes the file; it is put aside afterwards (see
+	_RetirePairedDevicesFile()).
 */
 void
 BluetoothServer::_ImportPairedDevicesFile(BondStore* bonds,
@@ -857,8 +902,32 @@ BluetoothServer::_ImportPairedDevicesFile(BondStore* bonds,
 	devices->Flush();
 
 	syslog(LOG_NOTICE, "bluetooth_server: %" B_PRId32 " bonds and %" B_PRId32
-		" devices taken from %s, which is no longer written\n", bonded,
-		known, path.Path());
+		" devices taken from %s\n", bonded, known, path.Path());
+}
+
+
+/*!	Puts the file of the paired devices kept before the bond store aside,
+	once its content was taken in: as "Bluetooth_paired_devices.migrated",
+	which only its owner may read, as it holds link keys. Nothing reads it
+	any more.
+*/
+void
+BluetoothServer::_RetirePairedDevicesFile()
+{
+	BPath path;
+	if (find_directory(B_USER_SETTINGS_DIRECTORY, &path) != B_OK
+		|| path.Append("Bluetooth_paired_devices") != B_OK) {
+		return;
+	}
+	BEntry entry(path.Path());
+	if (!entry.Exists())
+		return;
+
+	entry.SetPermissions(S_IRUSR | S_IWUSR);
+	if (entry.Rename("Bluetooth_paired_devices.migrated", true) == B_OK) {
+		syslog(LOG_NOTICE, "bluetooth_server: %s is no longer used, it is "
+			"now %s.migrated\n", path.Path(), path.Leaf());
+	}
 }
 
 
