diff --git a/headers/private/bluetooth/bluetoothserver_p.h b/headers/private/bluetooth/bluetoothserver_p.h
index 0dddd3da81..57e92aa2d0 100644
--- a/headers/private/bluetooth/bluetoothserver_p.h
+++ b/headers/private/bluetooth/bluetoothserver_p.h
@@ -51,8 +51,13 @@
 
 // A bond was made, changed or removed: sent with SendNotices() to whoever
 // watches the server for it (BHandler::StartWatching()), with "adapter" and
-// "address" (B_RAW_TYPE, bdaddr_t) and "change" (int32, see BondStore)
+// "address" (B_RAW_TYPE, bdaddr_t) and "change" (int32: 0 made, 1 changed,
+// 2 removed, 3 the bonds of "adapter" were read, no "address")
 #define BT_NOTICE_BONDS_CHANGED         'btBC'
+	// the bonded devices of every controller, without their keys: a
+	// "device" message for each, with "address" (B_RAW_TYPE, bdaddr_t),
+	// "name", "class" (3 bytes) and "service class" (uint16, each)
+#define BT_MSG_GET_BONDED_DEVICES       'btgB'
 
 
 #endif
diff --git a/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioAddOn.cpp b/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioAddOn.cpp
index ccd891126c..7cce6e5d1d 100644
--- a/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioAddOn.cpp
+++ b/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioAddOn.cpp
@@ -11,27 +11,110 @@
 #include <string.h>
 #include <syslog.h>
 
-#include <File.h>
+#include <Autolock.h>
 #include <image.h>
-#include <FindDirectory.h>
+#include <Looper.h>
 #include <Message.h>
-#include <Path.h>
+#include <Messenger.h>
+#include <Roster.h>
+
+#include <bluetooth/bdaddrUtils.h>
+#include <bluetoothserver_p.h>
 
 #include "BluetoothAudioNode.h"
 
 
+// how long the media add-on server waits for the Bluetooth server at most
+static const bigtime_t kServerTimeout = 500000;
+
+
+/*!	Tells the add-on when the bonds change, and when the Bluetooth server
+	starts (it may come after the media services, and knows the bonds only
+	once its controller is set up). It runs in the media add-on server, as
+	little as it can: it only watches, and asks the add-on to look again.
+*/
+class BondWatcher : public BLooper {
+public:
+	BondWatcher(BluetoothAudioAddOn* addOn)
+		:
+		BLooper("bluetooth audio bonds", B_LOW_PRIORITY),
+		fAddOn(addOn)
+	{
+	}
+
+	void Start()
+	{
+		Run();
+		be_roster->StartWatching(BMessenger(this), B_REQUEST_LAUNCHED);
+		if (Lock()) {
+			_WatchServer();
+			Unlock();
+		}
+	}
+
+	virtual void MessageReceived(BMessage* message)
+	{
+		switch (message->what) {
+			case B_SOME_APP_LAUNCHED:
+				if (strcmp(message->GetString("be:signature", ""),
+						BLUETOOTH_SIGNATURE) == 0) {
+					_WatchServer();
+					fAddOn->BondsChanged();
+				}
+				break;
+
+			case B_OBSERVER_NOTICE_CHANGE:
+				if (message->GetInt32(B_OBSERVE_WHAT_CHANGE, 0)
+						== BT_NOTICE_BONDS_CHANGED) {
+					fAddOn->BondsChanged();
+				}
+				break;
+
+			default:
+				BLooper::MessageReceived(message);
+				break;
+		}
+	}
+
+	virtual void Quit()
+	{
+		be_roster->StopWatching(BMessenger(this));
+		BLooper::Quit();
+	}
+
+private:
+	void _WatchServer()
+	{
+		BMessenger server(BLUETOOTH_SIGNATURE);
+		if (server.IsValid())
+			StartWatching(server, BT_NOTICE_BONDS_CHANGED);
+	}
+
+	BluetoothAudioAddOn*	fAddOn;
+};
+
+
 BluetoothAudioAddOn::BluetoothAudioAddOn(image_id image)
 	:
-	BMediaAddOn(image)
+	BMediaAddOn(image),
+	fLock("bluetooth audio devices"),
+	fWatcher(NULL)
 {
 	_LoadDevices();
 	syslog(LOG_INFO, "bluetooth_audio: %" B_PRId32 " outputs\n",
 		fDevices.CountItems());
+
+	fWatcher = new(std::nothrow) BondWatcher(this);
+	if (fWatcher != NULL)
+		fWatcher->Start();
 }
 
 
 BluetoothAudioAddOn::~BluetoothAudioAddOn()
 {
+	if (fWatcher != NULL && fWatcher->Lock())
+		fWatcher->Quit();
+
 	for (int32 i = 0; i < fDevices.CountItems(); i++) {
 		free((char*)fDevices.ItemAt(i)->flavor.name);
 		free((char*)fDevices.ItemAt(i)->flavor.info);
@@ -49,6 +132,7 @@ BluetoothAudioAddOn::InitCheck(const char** _failureText)
 int32
 BluetoothAudioAddOn::CountFlavors()
 {
+	BAutolock locker(fLock);
 	return fDevices.CountItems();
 }
 
@@ -56,6 +140,7 @@ BluetoothAudioAddOn::CountFlavors()
 status_t
 BluetoothAudioAddOn::GetFlavorAt(int32 index, const flavor_info** _info)
 {
+	BAutolock locker(fLock);
 	BluetoothAudioDevice* device = fDevices.ItemAt(index);
 	if (device == NULL)
 		return B_BAD_INDEX;
@@ -68,6 +153,7 @@ BMediaNode*
 BluetoothAudioAddOn::InstantiateNodeFor(const flavor_info* info,
 	BMessage* config, status_t* _error)
 {
+	BAutolock locker(fLock);
 	BluetoothAudioDevice* device = fDevices.ItemAt(info->internal_id);
 	if (device == NULL) {
 		*_error = B_BAD_INDEX;
@@ -83,34 +169,59 @@ BluetoothAudioAddOn::InstantiateNodeFor(const flavor_info* info,
 }
 
 
-/*!	The paired devices that are speakers or headphones: those with an
-	Audio Sink record, as bluetooth_server kept them. For a device whose
-	records were not read yet, the class says: audio and video, or nothing
-	(a Google Home has no class at all); phones, computers, peripherals such
-	as keyboards and game pads, and imaging devices are left out.
+/*!	Looks at the bonds again: speakers paired meanwhile become outputs at
+	once, without a restart of the media services.
 */
 void
+BluetoothAudioAddOn::BondsChanged()
+{
+	if (_LoadDevices() > 0) {
+		syslog(LOG_INFO, "bluetooth_audio: %" B_PRId32 " outputs\n",
+			CountFlavors());
+		NotifyFlavorChange();
+	}
+}
+
+
+/*!	The bonded devices that are speakers or headphones, as bluetooth_server
+	tells them: those with an Audio Sink record. For a device whose records
+	were not read yet, the class says: audio and video, or nothing (a Google
+	Home has no class at all); phones, computers, peripherals such as
+	keyboards and game pads, and imaging devices are left out.
+
+	Only devices not known yet are added; a device whose bond goes keeps its
+	output until the media services restart, as its node knows it by its
+	index (it no longer calls the speakers: they have no key).
+	Returns how many were added.
+*/
+int32
 BluetoothAudioAddOn::_LoadDevices()
 {
-	BPath path;
-	if (find_directory(B_USER_SETTINGS_DIRECTORY, &path) != B_OK
-		|| path.Append("Bluetooth_paired_devices") != B_OK)
-		return;
-	BFile file(path.Path(), B_READ_ONLY);
+	BMessage request(BT_MSG_GET_BONDED_DEVICES);
 	BMessage devices;
-	if (file.InitCheck() != B_OK || devices.Unflatten(&file) != B_OK)
-		return;
+	if (BMessenger(BLUETOOTH_SIGNATURE).SendMessage(&request, &devices,
+			kServerTimeout, kServerTimeout) != B_OK) {
+		return 0;
+	}
 
+	BAutolock locker(fLock);
+	int32 added = 0;
 	BMessage remote;
-	for (int32 i = 0; devices.FindMessage("remote", i, &remote) == B_OK;
+	for (int32 i = 0; devices.FindMessage("device", i, &remote) == B_OK;
 			i++) {
 		const bdaddr_t* address;
 		ssize_t size;
-		if (remote.FindData("bdaddr", B_ANY_TYPE, (const void**)&address,
-				&size) != B_OK || size != sizeof(bdaddr_t))
+		if (remote.FindData("address", B_RAW_TYPE, (const void**)&address,
+				&size) != B_OK || size != sizeof(bdaddr_t)) {
+			continue;
+		}
+		bool known = false;
+		for (int32 j = 0; j < fDevices.CountItems() && !known; j++)
+			known = bdaddrUtils::Compare(fDevices.ItemAt(j)->address, *address);
+		if (known)
 			continue;
 
-		// the service classes bluetooth_server kept from the SDP records:
+		// the service classes bluetooth_server read from the SDP records:
 		// speakers have an Audio Sink (0x110b)
 		uint16 serviceClass;
 		bool servicesKnown = false;
@@ -127,7 +238,7 @@ BluetoothAudioAddOn::_LoadDevices()
 			// something; 1 computer, 2 phone, 5 peripheral, 6 imaging
 			uint32 major = 0x1f;
 			const uint8* deviceClass;
-			if (remote.FindData("class_of_device", B_RAW_TYPE,
+			if (remote.FindData("class", B_RAW_TYPE,
 					(const void**)&deviceClass, &size) == B_OK && size == 3)
 				major = deviceClass[1] & 0x1f;
 			if (major == 1 || major == 2 || major == 5 || major == 6)
@@ -136,7 +247,7 @@ BluetoothAudioAddOn::_LoadDevices()
 
 		BluetoothAudioDevice* device = new(std::nothrow) BluetoothAudioDevice;
 		if (device == NULL)
-			return;
+			break;
 		memcpy(&device->address, address, sizeof(bdaddr_t));
 		device->name = remote.GetString("name", "");
 		if (device->name.IsEmpty())
@@ -164,8 +275,15 @@ BluetoothAudioAddOn::_LoadDevices()
 		flavor.out_format_flags = 0;
 		flavor.out_formats = NULL;
 
-		fDevices.AddItem(device);
+		if (!fDevices.AddItem(device)) {
+			free((char*)flavor.name);
+			free((char*)flavor.info);
+			delete device;
+			break;
+		}
+		added++;
 	}
+	return added;
 }
 
 
