From 6fcfa4053ffe4f8757ec7b815a89e78a277eaae0 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 26 Oct 2026 21:53:14 +0100
Subject: [PATCH 262/270] tegra_audio: give a buffer back only when both DMA
 channels are done

The media server fills a buffer as soon as the exchange returns it.
That happened when the I2S channel was through with it, while the
S/PDIF channel could still be reading its last samples: the HDMI sound
was rough, about 43 times a second. Now the buffer goes back when the
later of the two channels finishes it; the HDMI sound is clean.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../drivers/audio/tegra/tegra_audio.cpp       | 22 ++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
index 96c58c5fe5..22a4e63f31 100644
--- a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
+++ b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
@@ -233,6 +233,8 @@ struct tegra_audio {
 	bool					spdifEnabled;
 	bool					spdifInterruptInstalled;
 	int32					spdifPlaying;
+	int64					i2sBuffersDone;		// buffers each channel is
+	int64					spdifBuffersDone;	// through with
 
 	mutex					lock;
 	bool					opened;
@@ -666,8 +668,15 @@ dma_interrupt(void* data)
 		(audio->playing + 1) % audio->bufferCount));
 	audio->framesPlayed += audio->bufferFrames;
 	audio->realTime = system_time();
+	// The buffer just finished goes back to the media server, which fills
+	// it at once: with S/PDIF, only when that channel is through with it too
+	audio->i2sBuffersDone++;
+	bool release = !audio->spdifEnabled
+		|| audio->spdifBuffersDone >= audio->i2sBuffersDone;
 	release_spinlock(&audio->interruptLock);
 
+	if (!release)
+		return B_HANDLED_INTERRUPT;
 	release_sem_etc(audio->bufferReadySem, 1, B_DO_NOT_RESCHEDULE);
 	return B_INVOKE_SCHEDULER;
 }
@@ -685,10 +694,19 @@ spdif_dma_interrupt(void* data)
 		return B_UNHANDLED_INTERRUPT;
 	write32(audio->spdifChannel, DMA_STATUS, status);
 
+	acquire_spinlock(&audio->interruptLock);
 	audio->spdifPlaying = (audio->spdifPlaying + 1) % audio->bufferCount;
 	write32(audio->spdifChannel, DMA_AHB_PTR, buffer_physical(audio,
 		(audio->spdifPlaying + 1) % audio->bufferCount));
-	return B_HANDLED_INTERRUPT;
+	// I2S got there first: the buffer goes back now
+	audio->spdifBuffersDone++;
+	bool release = audio->spdifBuffersDone <= audio->i2sBuffersDone;
+	release_spinlock(&audio->interruptLock);
+
+	if (!release)
+		return B_HANDLED_INTERRUPT;
+	release_sem_etc(audio->bufferReadySem, 1, B_DO_NOT_RESCHEDULE);
+	return B_INVOKE_SCHEDULER;
 }
 
 
@@ -696,6 +714,7 @@ static void
 start_spdif_dma(tegra_audio* audio)
 {
 	audio->spdifPlaying = 0;
+	audio->spdifBuffersDone = 0;
 	write32(audio->dma, APBDMA_IRQ_MASK_SET, 1U << SPDIF_DMA_CHANNEL);
 
 	volatile uint8* channel = audio->spdifChannel;
@@ -725,6 +744,7 @@ start_playback(tegra_audio* audio)
 		return;
 
 	audio->playing = 0;
+	audio->i2sBuffersDone = 0;
 	audio->framesPlayed = 0;
 	audio->realTime = system_time();
 
