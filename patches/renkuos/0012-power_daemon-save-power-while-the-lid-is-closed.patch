From afc8d25aa35b68f62c7ac436fe38174b9c4652e7 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Thu, 19 Nov 2026 21:19:25 +0100
Subject: [PATCH 12/32] power_daemon: save power while the lid is closed

The lid monitor only printed the state of the ACPI lid. It now also
watches the lid of the AC100 embedded controller, and while the lid is
closed it switches the screen off (DPMS), puts the scheduler in power
saving mode and takes the wireless interfaces down; opening the lid
brings all of it back, the network server joining the known networks
again. "lid_closed_low_power false" in ~/config/settings/power_daemon
leaves everything running.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/servers/power/Jamfile         |   4 +-
 src/servers/power/lid_monitor.cpp | 141 ++++++++++++++++++++++++++++--
 src/servers/power/lid_monitor.h   |  15 +++-
 3 files changed, 149 insertions(+), 11 deletions(-)

diff --git a/src/servers/power/Jamfile b/src/servers/power/Jamfile
index b0d4cd158f..6cacf90f99 100644
--- a/src/servers/power/Jamfile
+++ b/src/servers/power/Jamfile
@@ -1,6 +1,6 @@
 SubDir HAIKU_TOP src servers power ;
 
-UsePrivateHeaders app ;
+UsePrivateHeaders app net shared ;
 
 AddResources power_daemon : power_daemon.rdef ;
 
@@ -11,4 +11,4 @@ Application power_daemon :
 	power_button_monitor.cpp
 	;
 
-LinkAgainst power_daemon : be [ TargetLibstdc++ TargetLibsupc++ ] ;
+LinkAgainst power_daemon : be bnetapi network [ TargetLibstdc++ TargetLibsupc++ ] ;
diff --git a/src/servers/power/lid_monitor.cpp b/src/servers/power/lid_monitor.cpp
index 308508162f..c50c06feb6 100644
--- a/src/servers/power/lid_monitor.cpp
+++ b/src/servers/power/lid_monitor.cpp
@@ -1,6 +1,7 @@
 /*
