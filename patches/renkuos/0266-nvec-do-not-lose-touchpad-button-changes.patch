From f964025504b2b36218f33edc0f4da36832025087 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 26 Oct 2026 22:24:32 +0100
Subject: [PATCH 266/270] nvec: do not lose touchpad button changes

A full movement queue dropped new packets, button presses and releases
included: now the movement goes into the newest entry while the
buttons stay, and the oldest entry makes room for a change. Packets
with the overflow bits set, from fast movements, were skipped and
could misalign the following ones; they are kept with the movement
clamped. After a pause of 100 ms between bytes a new packet starts,
as Linux' psmouse resyncs. The statistics count skipped bytes and
merged packets.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/busses/i2c/nvec/nvec.cpp | 61 +++++++++++++++++----
 1 file changed, 49 insertions(+), 12 deletions(-)

diff --git a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
index 7f741c1534..595be89e93 100644
--- a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
+++ b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
@@ -251,6 +251,9 @@ struct nvec_device {
 	uint32				keyEvents;
 	uint32				mouseBytes;
 	uint32				buttons;
+	bigtime_t			lastMouseByte;
+	uint32				skippedBytes;	// statistics: bytes skipped to resync,
+	uint32				mergedPackets;	// packets added to a full queue
 	int32				clicks;
 	bigtime_t			lastClick;
 	bigtime_t			clickSpeed;
@@ -968,11 +971,20 @@ handle_mouse_byte(nvec_device* device, uint8 byte)
 		return;
 	}
 
-	// the first byte of a packet always has bit 3 set; also skip those with
-	// the overflow bits, which the touchpad does not use: this resyncs on
-	// the self test result (0xaa 0x00) that follows its reset
-	if (device->packetPosition == 0 && ((byte & 0x08) == 0 || (byte & 0xc0) != 0))
+	// The bytes of a packet come close together: after a pause a new packet
+	// starts, as Linux' psmouse resyncs
+	bigtime_t now = system_time();
+	if (device->packetPosition != 0 && now - device->lastMouseByte > 100000)
+		device->packetPosition = 0;
+	device->lastMouseByte = now;
+
+	// the first byte of a packet always has bit 3 set: this resyncs on the
+	// self test result (0xaa 0x00) that follows a reset. A fast movement
+	// may set the overflow bits; the packet still has the buttons.
+	if (device->packetPosition == 0 && (byte & 0x08) == 0) {
+		device->skippedBytes++;
 		return;
+	}
 	device->packet[device->packetPosition++] = byte;
 	if (device->packetPosition < 3)
 		return;
@@ -980,7 +992,12 @@ handle_mouse_byte(nvec_device* device, uint8 byte)
 
 	const uint8* packet = device->packet;
 	uint32 buttons = packet[0] & 7;
-	bigtime_t now = system_time();
+	int32 xdelta = ((packet[0] & 0x10) ? ~0xff : 0) | packet[1];
+	int32 ydelta = ((packet[0] & 0x20) ? ~0xff : 0) | packet[2];
+	if ((packet[0] & 0x40) != 0)
+		xdelta = (packet[0] & 0x10) ? -255 : 255;
+	if ((packet[0] & 0x80) != 0)
+		ydelta = (packet[0] & 0x20) ? -255 : 255;
 	if (buttons != 0 && device->buttons == 0) {
 		if (device->lastClick + device->clickSpeed > now)
 			device->clicks++;
@@ -990,21 +1007,39 @@ handle_mouse_byte(nvec_device* device, uint8 byte)
 	}
 	device->buttons = buttons;
 
+	bool full = false;
 	InterruptsSpinLocker locker(device->mouseLock);
-	if (device->movementHead - device->movementTail >= NVEC_MOUSE_COUNT)
-		return;
+	if (device->movementHead - device->movementTail >= NVEC_MOUSE_COUNT) {
+		// Full: a button change must not get lost. The movement goes into
+		// the newest entry if the buttons stay, else the oldest entry makes
+		// room.
+		device->mergedPackets++;
+		mouse_movement& newest = device->movements[
+			(device->movementHead - 1) % NVEC_MOUSE_COUNT];
+		if (newest.buttons == buttons) {
+			newest.xdelta += xdelta;
+			newest.ydelta += ydelta;
+			newest.timestamp = now;
+			return;
+		}
+		device->movementTail++;
+		full = true;
+	}
+
 	mouse_movement& movement
 		= device->movements[device->movementHead % NVEC_MOUSE_COUNT];
 	memset(&movement, 0, sizeof(movement));
 	movement.buttons = buttons;
-	movement.xdelta = ((packet[0] & 0x10) ? ~0xff : 0) | packet[1];
-	movement.ydelta = ((packet[0] & 0x20) ? ~0xff : 0) | packet[2];
+	movement.xdelta = xdelta;
+	movement.ydelta = ydelta;
 	movement.clicks = device->clicks;
 	movement.timestamp = now;
 	device->movementHead++;
 	locker.Unlock();
 
-	release_sem_etc(device->mouseSem, 1, B_DO_NOT_RESCHEDULE);
+	// a full queue keeps its count: the oldest entry made room
+	if (!full)
+		release_sem_etc(device->mouseSem, 1, B_DO_NOT_RESCHEDULE);
 }
 
 
@@ -1214,12 +1249,14 @@ poll_thread(void* data)
 		if (next % 6 == 0) {
 			TRACE_ALWAYS("%" B_PRIu32 " interrupts, %" B_PRIu32 " messages (%"
 				B_PRIu32 " events: %" B_PRIu32 " keys, %" B_PRIu32 " touchpad "
-				"bytes, %" B_PRIu32 " touchpad resets), %" B_PRIu32 " protocol "
+				"bytes, %" B_PRIu32 " skipped, %" B_PRIu32 " merged, %" B_PRIu32
+				" touchpad resets), %" B_PRIu32 " protocol "
 				"errors, %" B_PRIu32 " lost interrupts, %" B_PRIu32
 				" restarts, state %" B_PRId32 ", status %#"
 				B_PRIx32 "\n",
 				device->interrupts, device->messages, device->events,
-				device->keyEvents, device->mouseBytes, device->touchpadResets,
+				device->keyEvents, device->mouseBytes, device->skippedBytes,
+				device->mergedPackets, device->touchpadResets,
 				device->protocolErrors, device->lostInterrupts, device->restarts,
 				device->state,
 				read_reg(device, I2C_SL_STATUS));
