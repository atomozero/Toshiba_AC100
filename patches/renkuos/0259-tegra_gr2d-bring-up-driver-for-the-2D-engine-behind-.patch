+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+/*!	Bring-up driver for the 2D engine (GR2D) of the NVIDIA Tegra 2, behind
+	host1x. Reading /dev/misc/tegra_gr2d runs a test suite on buffers of its
+	own and returns a report: it does not touch the screen.
+
+	host1x fetches commands from memory through a channel DMA and hands them
+	to the engine of the class they select; an engine increments a sync
+	point when it is done. The register layout of host1x follows the Linux
+	host1x driver (used as documentation only); the GR2D command sequences
+	follow grate (Copyright Erik Faye-Lund and Thierry Reding, MIT license).
+*/
+
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <Drivers.h>
+#include <KernelExport.h>
+#include <OS.h>
+#include <lock.h>
+
+
+#define TEGRA20_CAR_BASE			0x60006000
+#define CAR_RST_DEVICES_L			0x004
+#define CAR_CLK_OUT_ENB_L			0x010
+#define CAR_CLK_SOURCE_G2D			0x15c
+#define CAR_CLK_SOURCE_HOST1X		0x180
+#define CAR_G2D_BIT					(1u << 21)
+#define CAR_HOST1X_BIT				(1u << 28)
+#define CAR_SOURCE_PLL_C			(1u << 30)
+
+#define HOST1X_BASE					0x50000000
+#define HOST1X_SIZE					0x20000		// 8 channels of 16 KB
+#define CHANNEL_FIFOSTAT			0x00
+#define CHANNEL_DMASTART			0x14
+#define CHANNEL_DMAPUT				0x18
+#define CHANNEL_DMAGET				0x1c
+#define CHANNEL_DMAEND				0x20
+#define CHANNEL_DMACTRL				0x24
+#define DMACTRL_DMASTOP				(1u << 0)
+#define DMACTRL_DMAGETRST			(1u << 1)
+#define DMACTRL_DMAINITGET			(1u << 2)
+#define HOST1X_SYNC					0x3000
+#define SYNC_CMDPROC_STOP			0xac
+#define SYNC_CH_TEARDOWN			0xb0
+#define SYNC_SYNCPT(id)				(HOST1X_SYNC + 0x400 + (id) * 4)
+#define SYNCPT_ID					25			// not used by anything else
+
+// host1x command opcodes
+#define OPCODE_SETCL(offset, classid, mask) \
+	((0x0u << 28) | (((offset) & 0xfff) << 16) | (((classid) & 0x3ff) << 6) \
+		| ((mask) & 0x3f))
+#define OPCODE_NONINCR(offset, count) \
+	((0x2u << 28) | (((offset) & 0xfff) << 16) | ((count) & 0xffff))
+#define OPCODE_MASK(offset, mask) \
+	((0x3u << 28) | (((offset) & 0xfff) << 16) | ((mask) & 0xffff))
+
+#define CLASS_HOST1X				0x01
+#define CLASS_GR2D					0x51
+#define GR2D_INCR_SYNCPT			0x00
+#define SYNCPT_OP_DONE				(1u << 8)
+
+#define PUSH_BUFFER_SIZE			B_PAGE_SIZE
+#define SURFACE_WIDTH				512
+#define SURFACE_HEIGHT				300
+#define SURFACE_PITCH				(SURFACE_WIDTH * 4)
+#define SURFACE_SIZE				(SURFACE_PITCH * SURFACE_HEIGHT)
+
+// Contiguous memory is scarce once the system runs: the test surfaces are in
+// the memory reserved for the frame buffer, between the end of the screen at
+// 32 bits per pixel (2.4 MB) and the cursor image (at 4 MB)
+#define SURFACE_PHYSICAL(i)			(0x1fa60000 + (i) * 0x98000)
+#define PUSH_BUFFER_PHYSICAL		0x1fb90000
+
+
+struct buffer {
+	area_id		area;
+	uint32*		address;
+	uint32		physical;
+};
+
+
+static struct {
+	mutex			lock;
+	area_id			car_area;
+	volatile uint32* car;
+	area_id			host1x_area;
+	volatile uint32* host1x;
+	volatile uint32* channel;
+	int32			channel_index;
+	buffer			push;
+	buffer			surfaces[2];
+	uint32			push_count;
+} sGr;
+
+
+int32 api_version = B_CUR_DRIVER_API_VERSION;
+static const char* sDeviceNames[] = { "misc/tegra_gr2d", NULL };
+
+
+static size_t
+append(char* buffer, size_t size, size_t length, const char* format, ...)
+{
+	if (length >= size)
+		return length;
+	va_list args;
+	va_start(args, format);
+	length += vsnprintf(buffer + length, size - length, format, args);
+	va_end(args);
+	return length;
+}
+
+
+static inline uint32
+read_channel(uint32 offset)
+{
+	return sGr.channel[offset / 4];
+}
+
+
+static inline void
+write_channel(uint32 offset, uint32 value)
+{
+	sGr.channel[offset / 4] = value;
+}
+
+
+static inline uint32
+read_syncpt()
+{
+	return sGr.host1x[SYNC_SYNCPT(SYNCPT_ID) / 4];
+}
+
+
+static void
+free_resources()
+{
+	for (int32 i = 0; i < 2; i++)
+		delete_area(sGr.surfaces[i].area);
+	delete_area(sGr.push.area);
+	delete_area(sGr.host1x_area);
+	delete_area(sGr.car_area);
+	sGr.surfaces[0].area = sGr.surfaces[1].area = sGr.push.area = -1;
+	sGr.host1x_area = sGr.car_area = -1;
+}
+
+
+//	#pragma mark - submission
+
+
+static void
+push(uint32 word)
+{
+	if (sGr.push_count < PUSH_BUFFER_SIZE / 4)
+		sGr.push.address[sGr.push_count] = word;
+	sGr.push_count++;
+}
+
+
+/*!	Runs the commands in the push buffer from its start and waits for the
+	sync point they increment at the end.
+*/
+static status_t
+run_push_buffer(char* report, size_t size, size_t& length,
+	bigtime_t* _elapsed = NULL)
+{
+	if (sGr.push_count > PUSH_BUFFER_SIZE / 4)
+		return B_BUFFER_OVERFLOW;
+
+	// DMAPUT, DMAGET and DMAEND are offsets from DMASTART; DMAINITGET
+	// copies DMAPUT into DMAGET (absolute pointers made the DMA read from
+	// twice the address, which the memory controller reported as a decode
+	// error of host1xdmar)
+	uint32 start = sGr.push.physical;
+	uint32 end = sGr.push_count * 4;
+	uint32 target = read_syncpt() + 1;
+
+	// A clean channel: stop its command processor, tear it down (drops
+	// what is left in its command FIFO), start it again
+	volatile uint32* sync = sGr.host1x + HOST1X_SYNC / 4;
+	sync[SYNC_CMDPROC_STOP / 4] |= 1u << sGr.channel_index;
+	write_channel(CHANNEL_DMACTRL, DMACTRL_DMASTOP);
+	sync[SYNC_CH_TEARDOWN / 4] = 1u << sGr.channel_index;
+	sync[SYNC_CMDPROC_STOP / 4] &= ~(1u << sGr.channel_index);
+
+	write_channel(CHANNEL_DMASTART, start);
+	write_channel(CHANNEL_DMAEND, PUSH_BUFFER_SIZE + 4);
+	write_channel(CHANNEL_DMAPUT, 0);
+	write_channel(CHANNEL_DMACTRL, DMACTRL_DMASTOP | DMACTRL_DMAGETRST
+		| DMACTRL_DMAINITGET);
+	write_channel(CHANNEL_DMACTRL, 0);
+
+	// the commands must be in memory before the DMA is told about them
+	__asm__ __volatile__("dsb" ::: "memory");
+	bigtime_t begin = system_time();
+	write_channel(CHANNEL_DMAPUT, end);
+
+	bigtime_t timeout = begin + 500000;
+	while ((int32)(read_syncpt() - target) < 0) {
+		if (system_time() > timeout) {
+			length = append(report, size, length, "  timed out: sync point %"
+				B_PRIu32 " (wanted %" B_PRIu32 "), DMAGET %#" B_PRIx32
+				", DMAPUT %#" B_PRIx32 ", FIFOSTAT %#" B_PRIx32 ", CBREAD %#"
+				B_PRIx32 ", CBSTAT %#" B_PRIx32 "\n", read_syncpt(), target,
+				read_channel(CHANNEL_DMAGET), read_channel(CHANNEL_DMAPUT),
+				read_channel(CHANNEL_FIFOSTAT),
+				sync[(0x720 + sGr.channel_index * 4) / 4],
+				sync[(0x758 + sGr.channel_index * 4) / 4]);
+			// What is in the channel's command FIFO?
+			sync[0x74c / 4] = (1u << 31) | ((uint32)sGr.channel_index << 16);
+			uint32 pointers = sync[0x754 / 4];
+			length = append(report, size, length, "  command FIFO read %#"
+				B_PRIx32 ", write %#" B_PRIx32 ":", pointers & 0x1ff,
+				(pointers >> 16) & 0x1ff);
+			uint32 base = sync[(0x80 + sGr.channel_index * 4) / 4] & 0x1ff;
+			for (uint32 i = 0; i < 4; i++) {
+				sync[0x74c / 4] = (1u << 31)
+					| ((uint32)sGr.channel_index << 16) | (base + i);
+				length = append(report, size, length, " %08" B_PRIx32,
+					sync[0x750 / 4]);
+			}
+			sync[0x74c / 4] = 0;
+			length = append(report, size, length, "\n");
+			write_channel(CHANNEL_DMACTRL, DMACTRL_DMASTOP);
+			return B_TIMED_OUT;
+		}
+		spin(1);
+	}
+	if (_elapsed != NULL)
+		*_elapsed = system_time() - begin;
+	write_channel(CHANNEL_DMACTRL, DMACTRL_DMASTOP);
+	return B_OK;
+}
+
+
+static void
+push_end()
+{
+	push(OPCODE_NONINCR(GR2D_INCR_SYNCPT, 1));
+	push(SYNCPT_OP_DONE | SYNCPT_ID);
+}
+
+
+/*!	Solid fill of a rectangle of a 32 bit surface (grate's clear_rect). */
+static void
+push_fill(const buffer& surface, uint32 color, uint32 x, uint32 y,
+	uint32 width, uint32 height)
+{
+	push(OPCODE_SETCL(0, CLASS_GR2D, 0));
+	push(OPCODE_MASK(0x09, 0x9));
+	push(0x0000003a);	// trigger
+	push(0x00000000);	// cmdsel
+	push(OPCODE_MASK(0x1e, 0x7));
+	push(0x00000000);	// controlsecond
+	push((4 >> 1) << 16 | 1 << 6 | 1 << 2);
+		// controlmain: 32 bpp, source solid, turbo fill
+	push(0x000000cc);	// ropfade: copy
+	push(OPCODE_MASK(0x2b, 0x9));
+	push(surface.physical);	// dstba
+	push(SURFACE_PITCH);	// dstst
+	push(OPCODE_NONINCR(0x35, 1));
+	push(color);		// srcfgc
+	push(OPCODE_NONINCR(0x46, 1));
+	push(0);			// tilemode: linear
+	push(OPCODE_MASK(0x38, 0x5));
+	push(height << 16 | width);	// dstsize
+	push(y << 16 | x);			// dstps
+}
+
+
+/*!	Copy of a rectangle between 32 bit surfaces (grate's blit). */
+static void
+push_blit(const buffer& source, const buffer& target, uint32 sourceX,
+	uint32 sourceY, uint32 x, uint32 y, uint32 width, uint32 height)
+{
+	push(OPCODE_SETCL(0, CLASS_GR2D, 0));
+	push(OPCODE_MASK(0x09, 0x9));
+	push(0x0000003a);	// trigger
+	push(0x00000000);	// cmdsel
+	push(OPCODE_MASK(0x1e, 0x7));
+	push(0x00000000);	// controlsecond
+	push(1 << 20 | (4 >> 1) << 16);
+		// controlmain: source of the same depth, 32 bpp
+	push(0x000000cc);	// ropfade: copy
+	push(OPCODE_NONINCR(0x46, 1));
+	push(0);			// tilemode: linear
+	push(OPCODE_MASK(0x2b, 0xe149));
+	push(target.physical);	// dstba
+	push(SURFACE_PITCH);	// dstst
+	push(source.physical);	// srcba
+	push(SURFACE_PITCH);	// srcst
+	push(height << 16 | width);	// dstsize
+	push(sourceY << 16 | sourceX);	// srcps
+	push(y << 16 | x);			// dstps
+}
+
+
+//	#pragma mark - tests
+
+
+static uint32
+count_mismatches(const buffer& surface, uint32 x, uint32 y, uint32 width,
+	uint32 height, uint32 inside, uint32 outside)
+{
+	uint32 mismatches = 0;
+	for (uint32 row = 0; row < SURFACE_HEIGHT; row++) {
+		const uint32* line = surface.address + row * SURFACE_WIDTH;
+		for (uint32 column = 0; column < SURFACE_WIDTH; column++) {
+			bool in = column >= x && column < x + width && row >= y
+				&& row < y + height;
+			if (line[column] != (in ? inside : outside))
+				mismatches++;
+		}
+	}
+	return mismatches;
+}
+
+
+static size_t
+run_tests(char* report, size_t size)
+{
+	size_t length = 0;
+
+
+	// Clocks: host1x as the firmware left it, GR2D from PLL C / 2
+	uint32 enable = sGr.car[CAR_CLK_OUT_ENB_L / 4];
+	uint32 reset = sGr.car[CAR_RST_DEVICES_L / 4];
+	length = append(report, size, length, "host1x clock %s, source %#" B_PRIx32
+		"; GR2D clock %s, reset %s, source %#" B_PRIx32 "\n",
+		(enable & CAR_HOST1X_BIT) != 0 && (reset & CAR_HOST1X_BIT) == 0
+			? "on" : "off", sGr.car[CAR_CLK_SOURCE_HOST1X / 4],
+		(enable & CAR_G2D_BIT) != 0 ? "on" : "off",
+		(reset & CAR_G2D_BIT) != 0 ? "asserted" : "released",
+		sGr.car[CAR_CLK_SOURCE_G2D / 4]);
+	if ((enable & CAR_HOST1X_BIT) == 0 || (reset & CAR_HOST1X_BIT) != 0)
+		return append(report, size, length, "host1x is not running\n");
+
+	if ((enable & CAR_G2D_BIT) == 0 || (reset & CAR_G2D_BIT) != 0) {
+		sGr.car[CAR_CLK_SOURCE_G2D / 4] = CAR_SOURCE_PLL_C | 2;	// 300 MHz
+		sGr.car[CAR_RST_DEVICES_L / 4] |= CAR_G2D_BIT;
+		sGr.car[CAR_CLK_OUT_ENB_L / 4] |= CAR_G2D_BIT;
+		snooze(1000);
+		sGr.car[CAR_RST_DEVICES_L / 4] &= ~CAR_G2D_BIT;
+		snooze(100);
+		length = append(report, size, length, "GR2D started, source %#"
+			B_PRIx32 "\n", sGr.car[CAR_CLK_SOURCE_G2D / 4]);
+	}
+
+	length = append(report, size, length, "channel %d: FIFOSTAT %#" B_PRIx32
+		", DMACTRL %#" B_PRIx32 ", DMAGET %#" B_PRIx32 "; sync point %d = %"
+		B_PRIu32 "\n", sGr.channel_index, read_channel(CHANNEL_FIFOSTAT),
+		read_channel(CHANNEL_DMACTRL), read_channel(CHANNEL_DMAGET),
+		SYNCPT_ID, read_syncpt());
+
+	volatile uint32* sync = sGr.host1x + HOST1X_SYNC / 4;
+	length = append(report, size, length, "sync: CMDPROC_STOP %#" B_PRIx32
+		", CH_TEARDOWN %#" B_PRIx32 ", CF_SETUP %#" B_PRIx32 ", CBREAD %#"
+		B_PRIx32 ", CBSTAT %#" B_PRIx32 "\nsync points:", sync[0xac / 4],
+		sync[0xb0 / 4], sync[(0x80 + sGr.channel_index * 4) / 4],
+		sync[(0x720 + sGr.channel_index * 4) / 4],
+		sync[(0x758 + sGr.channel_index * 4) / 4]);
+	for (int32 i = 0; i < 32; i++)
+		length = append(report, size, length, " %" B_PRIx32, sync[0x100 + i]);
+	// The CPU can increment a sync point too: that checks where they are
+	uint32 before = read_syncpt();
+	sync[0x700 / 4] = 1u << SYNCPT_ID;
+	length = append(report, size, length, "\nCPU increment of %d: %" B_PRIu32
+		" -> %" B_PRIu32 "\n", SYNCPT_ID, before, read_syncpt());
+
+	// 1. Only sync point increments: immediate ones from the host1x class
+	// and from GR2D, then one when GR2D is done
+	static const struct {
+		const char*	name;
+		uint32		classID;
+		uint32		condition;
+	} kIncrements[] = {
+		{ "host1x, immediate", CLASS_HOST1X, 0 },
+		{ "GR2D, immediate", CLASS_GR2D, 0 },
+		{ "GR2D, operation done", CLASS_GR2D, SYNCPT_OP_DONE },
+	};
+	status_t status = B_OK;
+	for (size_t i = 0; i < B_COUNT_OF(kIncrements); i++) {
+		sGr.push_count = 0;
+		push(OPCODE_SETCL(0, kIncrements[i].classID, 0));
+		push(OPCODE_NONINCR(GR2D_INCR_SYNCPT, 1));
+		push(kIncrements[i].condition | SYNCPT_ID);
+		status = run_push_buffer(report, size, length);
+		length = append(report, size, length, "1. sync point, %s: %s\n",
+			kIncrements[i].name, strerror(status));
+	}
+	if (status != B_OK)
+		return length;
+
+	// 2. Fill a rectangle
+	buffer& a = sGr.surfaces[0];
+	buffer& b = sGr.surfaces[1];
+	memset(a.address, 0, SURFACE_SIZE);
+	sGr.push_count = 0;
+	push_fill(a, 0xff2080c0, 100, 50, 200, 120);
+	push_end();
+	status = run_push_buffer(report, size, length);
+	uint32 mismatches = status == B_OK
+		? count_mismatches(a, 100, 50, 200, 120, 0xff2080c0, 0) : 0;
+	length = append(report, size, length, "2. fill 200x120: %s, %" B_PRIu32
+		" wrong pixels (first pixel %#" B_PRIx32 ")\n", strerror(status),
+		mismatches, a.address[50 * SURFACE_WIDTH + 100]);
+	if (status != B_OK || mismatches != 0)
+		return length;
+
+	// 3. Copy it elsewhere in the other surface
+	memset(b.address, 0, SURFACE_SIZE);
+	sGr.push_count = 0;
+	push_blit(a, b, 100, 50, 300, 150, 200, 120);
+	push_end();
+	status = run_push_buffer(report, size, length);
+	mismatches = status == B_OK
+		? count_mismatches(b, 300, 150, 200, 120, 0xff2080c0, 0) : 0;
+	length = append(report, size, length, "3. blit 200x120: %s, %" B_PRIu32
+		" wrong pixels\n", strerror(status), mismatches);
+	if (status != B_OK || mismatches != 0)
+		return length;
+
+	// 4. Speed: whole surface fills and copies, against the CPU
+	const int32 kRounds = 20;
+	bigtime_t fillTime = 0, blitTime = 0;
+	for (int32 i = 0; i < kRounds && status == B_OK; i++) {
+		bigtime_t elapsed;
+		sGr.push_count = 0;
+		push_fill(a, 0xff000000 | i, 0, 0, SURFACE_WIDTH, SURFACE_HEIGHT);
+		push_end();
+		status = run_push_buffer(report, size, length, &elapsed);
+		fillTime += elapsed;
+		sGr.push_count = 0;
+		push_blit(a, b, 0, 0, 0, 0, SURFACE_WIDTH, SURFACE_HEIGHT);
+		push_end();
+		if (status == B_OK)
+			status = run_push_buffer(report, size, length, &elapsed);
+		blitTime += elapsed;
+	}
+	if (status != B_OK)
+		return append(report, size, length, "4. speed: %s\n",
+			strerror(status));
+	mismatches = count_mismatches(b, 0, 0, SURFACE_WIDTH, SURFACE_HEIGHT,
+		0xff000000 | (kRounds - 1), 0);
+
+	bigtime_t cpuFill = system_time();
+	for (int32 i = 0; i < kRounds; i++) {
+		uint32 color = 0xff000000 | i;
+		for (uint32 j = 0; j < SURFACE_SIZE / 4; j++)
+			a.address[j] = color;
+	}
+	cpuFill = system_time() - cpuFill;
+	bigtime_t cpuCopy = system_time();
+	for (int32 i = 0; i < kRounds; i++)
+		memcpy(b.address, a.address, SURFACE_SIZE);
+	cpuCopy = system_time() - cpuCopy;
+
+	length = append(report, size, length, "4. %dx%d, 32 bit, per frame: "
+		"GR2D fill %" B_PRId64 " us, copy %" B_PRId64 " us (%" B_PRIu32
+		" wrong pixels); CPU fill %" B_PRId64 " us, copy %" B_PRId64
+		" us (write combining memory)\n", SURFACE_WIDTH, SURFACE_HEIGHT,
+		fillTime / kRounds, blitTime / kRounds, mismatches,
+		cpuFill / kRounds, cpuCopy / kRounds);
+
+	return length;
+}
+
+
+//	#pragma mark - device hooks
+
+
+static status_t
+gr2d_open(const char* name, uint32 flags, void** _cookie)
+{
+	*_cookie = NULL;
+	return B_OK;
+}
+
+
+static status_t
+gr2d_close(void* cookie)
+{
+	return B_OK;
+}
+
+
+static status_t
+gr2d_free(void* cookie)
+{
+	return B_OK;
+}
+
+
+static status_t
+gr2d_control(void* cookie, uint32 op, void* arg, size_t length)
+{
+	return B_DEV_INVALID_IOCTL;
+}
+
+
+static status_t
+gr2d_read(void* cookie, off_t position, void* data, size_t* _length)
+{
+	if (position != 0) {
+		*_length = 0;
+		return B_OK;
+	}
+
+	const size_t kSize = 4096;
+	char* report = (char*)malloc(kSize);
+	if (report == NULL)
+		return B_NO_MEMORY;
+
+	mutex_lock(&sGr.lock);
+	size_t length = run_tests(report, kSize);
+	mutex_unlock(&sGr.lock);
+	if (length >= kSize)
+		length = kSize - 1;
+
+	length = min_c(length, *_length);
+	status_t status = user_memcpy(data, report, length);
+	free(report);
+	*_length = status == B_OK ? length : 0;
+	return status;
+}
+
+
+static status_t
+gr2d_write(void* cookie, off_t position, const void* data, size_t* _length)
+{
+	*_length = 0;
+	return B_NOT_ALLOWED;
+}
+
+
+static device_hooks sDeviceHooks = {
+	gr2d_open,
+	gr2d_close,
+	gr2d_free,
+	gr2d_control,
+	gr2d_read,
+	gr2d_write,
+};
+
+
+//	#pragma mark - driver
+
+
+status_t
+init_hardware(void)
+{
+	return B_OK;
+}
+
+
+status_t
+init_driver(void)
+{
+	memset(&sGr, 0, sizeof(sGr));
+	sGr.car_area = sGr.host1x_area = sGr.push.area = -1;
+	sGr.surfaces[0].area = sGr.surfaces[1].area = -1;
+	mutex_init(&sGr.lock, "tegra_gr2d");
+
+	void* address;
+	sGr.car_area = map_physical_memory("tegra_gr2d car", TEGRA20_CAR_BASE,
+		B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+	sGr.car = (volatile uint32*)address;
+	sGr.host1x_area = map_physical_memory("tegra_gr2d host1x", HOST1X_BASE,
+		HOST1X_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+	sGr.host1x = (volatile uint32*)address;
+	sGr.channel_index = 7;
+	sGr.channel = sGr.host1x + sGr.channel_index * 0x1000;
+
+	status_t status = sGr.car_area < 0 ? sGr.car_area
+		: sGr.host1x_area < 0 ? sGr.host1x_area : B_OK;
+	if (status == B_OK) {
+		// device memory: never in the CPU caches
+		sGr.push.physical = PUSH_BUFFER_PHYSICAL;
+		sGr.push.area = map_physical_memory("tegra_gr2d push buffer",
+			sGr.push.physical, PUSH_BUFFER_SIZE, B_ANY_KERNEL_ADDRESS,
+			B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+		sGr.push.address = (uint32*)address;
+		if (sGr.push.area < 0)
+			status = sGr.push.area;
+	}
+	for (int32 i = 0; i < 2 && status == B_OK; i++) {
+		buffer& surface = sGr.surfaces[i];
+		surface.physical = SURFACE_PHYSICAL(i);
+		surface.area = map_physical_memory("tegra_gr2d surface",
+			surface.physical, SURFACE_SIZE,
+			B_ANY_KERNEL_ADDRESS | B_WRITE_COMBINING_MEMORY,
+			B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+		surface.address = (uint32*)address;
+		if (surface.area < 0)
+			status = surface.area;
+	}
+	if (status != B_OK) {
+		dprintf("tegra_gr2d: init failed: %s (car %" B_PRId32 ", host1x %"
+			B_PRId32 ", push %" B_PRId32 ", surfaces %" B_PRId32 " %" B_PRId32
+			")\n", strerror(status), sGr.car_area, sGr.host1x_area,
+			sGr.push.area, sGr.surfaces[0].area, sGr.surfaces[1].area);
+		free_resources();
+		mutex_destroy(&sGr.lock);
+	}
+	return status;
+}
+
+
+void
+uninit_driver(void)
+{
+	if (sGr.channel != NULL && sGr.host1x_area >= 0)
+		sGr.channel[CHANNEL_DMACTRL / 4] = DMACTRL_DMASTOP;
+	free_resources();
+	mutex_destroy(&sGr.lock);
+}
+
+
+const char**
+publish_devices(void)
+{
+	return sDeviceNames;
+}
+
+
+device_hooks*
+find_device(const char* name)
+{
+	return &sDeviceHooks;
+}
