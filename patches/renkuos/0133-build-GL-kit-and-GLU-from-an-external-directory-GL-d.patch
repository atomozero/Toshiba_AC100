From 543f95cdb84a6e9b4520cfe8d703419d42035064 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 19 Oct 2026 12:59:49 +0200
Subject: [PATCH 133/270] build: GL kit and GLU from an external directory; GL
 demos in the ARM image

There are no mesa and glu packages for ARM in the repositories. With
HAIKU_EXTERNAL_GL_DIR set to a directory holding Mesa (legacy, with the GL
kit) and GLU extracted to mesa/ and glu/, enable the mesa and glu build
features from there. The ARM image then gets GLInfo, GLTeapot, Haiku3d (with
the trademarks), libglut and the Flurry, GLife and Gravity screen savers.
---
 build/jam/BuildFeatures              | 18 +++++++++++++++++-
 build/jam/images/definitions/minimum |  7 +++++++
 2 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/build/jam/BuildFeatures b/build/jam/BuildFeatures
index 0f2fce8265..44e57854cf 100644
--- a/build/jam/BuildFeatures
+++ b/build/jam/BuildFeatures
@@ -182,7 +182,23 @@ if [ IsPackageAvailable glu_devel ] {
 
 
 # GL (GL Kit, Mesa3D)
-if [ IsPackageAvailable mesa_devel ] {
+# HAIKU_EXTERNAL_GL_DIR: Mesa (legacy, with the GL kit) and GLU built outside
+# of the package repositories, extracted to <dir>/mesa and <dir>/glu, like
+# for the Toshiba AC100 (ARM, VFPv3-D16)
+if $(HAIKU_EXTERNAL_GL_DIR) && ! [ IsPackageAvailable mesa_devel ] {
+	local glDir = $(HAIKU_EXTERNAL_GL_DIR) ;
+	SetBuildFeatureAttribute mesa : headers
+		: [ FDirName $(glDir) mesa develop headers os opengl ]
+		  [ FDirName $(glDir) mesa develop headers ] ;
+	SetBuildFeatureAttribute mesa : library
+		: [ FDirName $(glDir) mesa lib libGL.so ] ;
+	EnableBuildFeatures mesa ;
+	SetBuildFeatureAttribute glu : headers
+		: [ FDirName $(glDir) glu develop headers ] ;
+	SetBuildFeatureAttribute glu : library
+		: [ FDirName $(glDir) glu lib libGLU.so ] ;
+	EnableBuildFeatures glu ;
+} else if [ IsPackageAvailable mesa_devel ] {
 	ExtractBuildFeatureArchives mesa :
 		file: base mesa
 			runtime: lib
diff --git a/build/jam/images/definitions/minimum b/build/jam/images/definitions/minimum
index 2117eed1c1..c496ca39f5 100644
--- a/build/jam/images/definitions/minimum
+++ b/build/jam/images/definitions/minimum
@@ -216,6 +216,7 @@ rule HaikuImageGetSystemLibs
 			libdevice.so
 			libbluetooth.so@arm
 			libgame.so@arm
+			libglut.so@mesa
 			libgnu.so
 			libmail.so@arm
 			libmedia.so@arm
@@ -507,6 +508,7 @@ if arm in $(HAIKU_PACKAGING_ARCHS) {
 	SYSTEM_APPS += [ FFilterByBuildFeatures
 		AutoRaise
 		CodyCam
+		GLInfo@mesa
 		HaikuDepot
 		Icon-O-Matic@expat
 		LaunchBox
@@ -556,6 +558,8 @@ if arm in $(HAIKU_PACKAGING_ARCHS) {
 
 	SYSTEM_DEMOS += [ FFilterByBuildFeatures
 		Cortex@expat
+		GLTeapot@mesa
+		$(HAIKU_INCLUDE_TRADEMARKS)Haiku3d@mesa
 		OverlayImage
 	] ;
 
@@ -622,6 +626,9 @@ if arm in $(HAIKU_PACKAGING_ARCHS) {
 	SYSTEM_ADD_ONS_SCREENSAVERS += [ FFilterByBuildFeatures
 		Butterfly
 		DebugNow
+		Flurry@mesa
+		GLife@mesa
+		Gravity@mesa
 		Icons
 		IFS
 		Leaves
