From 8cb521f77e19f9a1c3b1e9e8e4487e8cafd3e82a Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 20 Oct 2026 20:38:57 +0200
Subject: [PATCH 172/270] tegra_audio: change only the source and divisor of
 the I2S1 clock

Write the source and the divisor of CLK_SOURCE_I2S1 and keep its other
bits, as Linux does: the register comes up as 0xd0000000 and bit 28 was
cleared. With it cleared, neither I2S controller ever drained its FIFO.

Bring-up (not for merging): the FIFO tests now fill the FIFO by its
count, and compare the source register bits, clk_m and the DAP as
master.
---
 .../drivers/audio/tegra/tegra_audio.cpp       | 64 ++++++++++++-------
 1 file changed, 40 insertions(+), 24 deletions(-)

diff --git a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
index e4ebb923d7..47799109a2 100644
--- a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
+++ b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
@@ -182,6 +182,7 @@ struct tegra_audio {
 	int64					framesPlayed;
 	bigtime_t				realTime;
 	uint32					interrupts;
+	uint32					i2sSourceAtBoot;
 };
 
 
@@ -339,6 +340,17 @@ codec_init(tegra_audio* audio)
 //	#pragma mark - Tegra side
 
 
+/*!	The source (bits 31-30) and the divisor in 7.1 fixed point (bits 7-0)
+	of a CLK_SOURCE register, the other bits kept.
+*/
+static inline uint32
+i2s_clock_source(uint32 value, uint32 source, uint32 divisor)
+{
+	return (value & ~((3U << 30) | 0xff)) | (source << 30)
+		| (2 * (divisor - 1));
+}
+
+
 static void
 set_clock(tegra_audio* audio, uint32 clock, bool enable)
 {
@@ -394,9 +406,12 @@ setup_clocks(tegra_audio* audio)
 	// out 0: divided by 2.5 (2 * (2.5 - 1) in 7.1 fixed point), enabled
 	write32(audio->car, CAR_PLLA_OUT, (3 << 8) | 3);
 
-	// I2S1 from PLL A out 0, divided by 8
+	// I2S1 from PLL A out 0, divided by 8; only the source and the divisor
+	// are ours to change, the other bits keep their reset values
 	set_clock(audio, CLOCK_I2S1, true);
-	write32(audio->car, CAR_CLK_SOURCE_I2S1, (0U << 30) | (2 * (8 - 1)));
+	audio->i2sSourceAtBoot = read32(audio->car, CAR_CLK_SOURCE_I2S1);
+	write32(audio->car, CAR_CLK_SOURCE_I2S1,
+		i2s_clock_source(audio->i2sSourceAtBoot, 0, 8));
 	set_reset(audio, CLOCK_I2S1, true);
 	spin(10);
 	set_reset(audio, CLOCK_I2S1, false);
@@ -409,10 +424,10 @@ setup_clocks(tegra_audio* audio)
 
 	TRACE_ALWAYS("clocks: PLL P out A %#" B_PRIx32 " -> %#" B_PRIx32
 		", PLL A %#" B_PRIx32 " -> %#" B_PRIx32 " (misc %#" B_PRIx32
-		"), out %#" B_PRIx32 ", I2S1 %#" B_PRIx32 "\n", pllpOutA,
-		read32(audio->car, CAR_PLLP_OUTA), base,
+		"), out %#" B_PRIx32 ", I2S1 %#" B_PRIx32 " -> %#" B_PRIx32 "\n",
+		pllpOutA, read32(audio->car, CAR_PLLP_OUTA), base,
 		read32(audio->car, CAR_PLLA_BASE), read32(audio->car, CAR_PLLA_MISC),
-		read32(audio->car, CAR_PLLA_OUT),
+		read32(audio->car, CAR_PLLA_OUT), audio->i2sSourceAtBoot,
 		read32(audio->car, CAR_CLK_SOURCE_I2S1));
 	return (read32(audio->car, CAR_PLLA_BASE) & PLL_BASE_LOCK) != 0
 		? B_OK : B_TIMED_OUT;
@@ -645,7 +660,7 @@ run_fifo_test(volatile uint8* i2s, const char* name, bool loopback)
 	bigtime_t end = start + 50000;
 	while (system_time() < end) {
 		polls++;
-		if ((read32(i2s, I2S_STATUS) & I2S_STATUS_FIFO1_RDY) != 0) {
+		if (I2S_FIFO_SCR_FIFO1_COUNT(read32(i2s, I2S_FIFO_SCR)) != 0) {
 			write32(i2s, I2S_FIFO1, (written & 32) != 0
 				? 0x07d007d0 : 0xf830f830);
 			written++;
@@ -667,12 +682,11 @@ run_fifo_test(volatile uint8* i2s, const char* name, bool loopback)
 		| I2S_CTRL_FIFO2_ENABLE));
 
 	TRACE_ALWAYS("FIFO test (%s%s): %" B_PRIu32 " words taken in 50 ms (%"
-		B_PRIu32 " polls; about 2205 if it runs), cleared: scr %#" B_PRIx32
+		B_PRIu32 " polls; 32 to fill it, about 2205 more if it runs), cleared: scr %#" B_PRIx32
 		" status %#" B_PRIx32 "; after: scr %#" B_PRIx32 " status %#" B_PRIx32
-		", 10 ms later scr %#" B_PRIx32 "%s%" B_PRIu32 "\n", name,
+		", 10 ms later scr %#" B_PRIx32 ", received %" B_PRIu32 "\n", name,
 		loopback ? ", loopback" : "", written, polls, clearedScr,
-		clearedStatus, scr, status, laterScr,
-		loopback ? ", received " : "", loopback ? received : 0);
+		clearedStatus, scr, status, laterScr, received);
 }
 
 
@@ -702,27 +716,28 @@ fifo_tests(tegra_audio* audio)
 		before, read32(audio->i2s, I2S_TIMING), read32(audio->i2s, I2S_CTRL),
 		read32(audio->i2s, I2S_STATUS), read32(audio->i2s, I2S_FIFO_SCR));
 
+	uint32 source = read32(audio->car, CAR_CLK_SOURCE_I2S1);
 	run_fifo_test(audio->i2s, "I2S1", false);
 	run_fifo_test(audio->i2s, "I2S1", true);
 
-	// I2S2 is in the same page, from the same clock
-	volatile uint8* i2s2 = audio->i2s + (I2S2_BASE - I2S1_BASE);
-	set_clock(audio, CLOCK_I2S2, true);
-	write32(audio->car, CAR_CLK_SOURCE_I2S2, (0U << 30) | (2 * (8 - 1)));
-	set_reset(audio, CLOCK_I2S2, true);
-	spin(10);
-	set_reset(audio, CLOCK_I2S2, false);
-	run_fifo_test(i2s2, "I2S2", false);
-	run_fifo_test(i2s2, "I2S2", true);
-	write32(i2s2, I2S_CTRL, 0);
-	set_clock(audio, CLOCK_I2S2, false);
+	// the bits of the source register that Linux leaves alone: is one of
+	// them what lets the clock out?
+	write32(audio->car, CAR_CLK_SOURCE_I2S1, source | (1U << 28));
+	run_fifo_test(audio->i2s, "I2S1 bit 28 set", false);
+	write32(audio->car, CAR_CLK_SOURCE_I2S1, source & ~(3U << 28));
+	run_fifo_test(audio->i2s, "I2S1 bits 29-28 clear", false);
 
 	// I2S1 from the oscillator, 12 MHz / 4
-	uint32 source = read32(audio->car, CAR_CLK_SOURCE_I2S1);
-	write32(audio->car, CAR_CLK_SOURCE_I2S1, (3U << 30) | (2 * (4 - 1)));
+	write32(audio->car, CAR_CLK_SOURCE_I2S1, i2s_clock_source(source, 3, 4));
 	run_fifo_test(audio->i2s, "I2S1 clk_m", false);
 	write32(audio->car, CAR_CLK_SOURCE_I2S1, source);
 
+	// the DAP as the master of its pins
+	uint32 dap = read32(audio->misc, DAS_DAP_CTRL_SEL(0));
+	write32(audio->misc, DAS_DAP_CTRL_SEL(0), dap | (1U << 31));
+	run_fifo_test(audio->i2s, "I2S1 DAP master", false);
+	write32(audio->misc, DAS_DAP_CTRL_SEL(0), dap);
+
 	// back to the playback setup
 	setup_i2s(audio);
 }
@@ -760,7 +775,8 @@ self_test(tegra_audio* audio)
 		// Does the I2S run at all? Clock it from the oscillator (clk_m,
 		// 12 MHz divided by 4) instead of PLL A for a moment.
 		uint32 source = read32(audio->car, CAR_CLK_SOURCE_I2S1);
-		write32(audio->car, CAR_CLK_SOURCE_I2S1, (3U << 30) | (2 * (4 - 1)));
+		write32(audio->car, CAR_CLK_SOURCE_I2S1,
+			i2s_clock_source(source, 3, 4));
 		run_self_test(audio, "clk_m");
 		write32(audio->car, CAR_CLK_SOURCE_I2S1, source);
 	}
