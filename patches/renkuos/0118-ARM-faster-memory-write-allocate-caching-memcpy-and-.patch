From e4fd7bf1e5307caf1a730baf75d7be234479f49a Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 21:56:59 +0200
Subject: [PATCH 118/270] ARM: faster memory: write-allocate caching, memcpy()
 and memset() in assembly

Map normal memory write-back with write-allocate (NMRR type 3), as Linux
does on Cortex-A9: without it every store missing the cache went to
memory.

memcpy() and memset() copy 32 bytes at a time with load and store multiple
(and prefetching) instead of a word at a time in C. In userland, copies
between differently aligned buffers use unaligned word loads, which ARMv7
does on normal memory; the kernel keeps copying those byte by byte, as it
may access device memory.
---
 src/system/boot/platform/efi/arch/arm/entry.S |   8 +-
 .../arm/paging/32bit/ARMPagingMethod32Bit.h   |   3 +-
 src/system/kernel/lib/arch/arm/Jamfile        |   3 +-
 .../libroot/posix/string/arch/arm/Jamfile     |   3 +-
 .../posix/string/arch/arm/arch_memcpy.S       | 118 ++++++++++++++++++
 5 files changed, 127 insertions(+), 8 deletions(-)
 create mode 100644 src/system/libroot/posix/string/arch/arm/arch_memcpy.S

diff --git a/src/system/boot/platform/efi/arch/arm/entry.S b/src/system/boot/platform/efi/arch/arm/entry.S
index 457fd70160..3e7d72679b 100644
--- a/src/system/boot/platform/efi/arch/arm/entry.S
+++ b/src/system/boot/platform/efi/arch/arm/entry.S
@@ -134,10 +134,12 @@ _pl1_entry:
 
 	// set NMRR as follows:
 	// - memory type 2 is Inner/Outer Write-Through
-	// - memory type 3 is Inner/Outer Write-Back, no Write-Allocate
+	// - memory type 3 (all normal memory) is Inner/Outer Write-Back,
+	//   Write-Allocate, as Linux uses it on Cortex-A9: without, every store
+	//   that misses the cache goes to memory
 	// - don't care about the rest
-	mov		r9, #0x000000e0
-	orr		r9, #0x00e00000
+	mov		r9, #0x00000060
+	orr		r9, #0x00600000
 	mcr		p15, 0, r9, c10, c2, 1
 
 	// ensure the PRRR and NMRR registers are updated before enabling MMU
diff --git a/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.h b/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.h
index 3a3b1c3463..49a5c69259 100644
--- a/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.h
+++ b/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.h
@@ -259,7 +259,8 @@ ARMPagingMethod32Bit::MemoryTypeToPageTableEntryFlags(uint32 memoryType)
 		case B_WRITE_PROTECTED_MEMORY:
 		case B_WRITE_BACK_MEMORY:
 		default:
-			// Outer and Inner Write-Back, no Write-Allocate
+			// Outer and Inner Write-Back, Write-Allocate (TEX remap type 3,
+			// see NMRR in the boot loader)
 			return ARM_MMU_L2_FLAG_B | ARM_MMU_L2_FLAG_C;
 	}
 }
diff --git a/src/system/kernel/lib/arch/arm/Jamfile b/src/system/kernel/lib/arch/arm/Jamfile
index 3a1508ced8..3cff34af45 100644
--- a/src/system/kernel/lib/arch/arm/Jamfile
+++ b/src/system/kernel/lib/arch/arm/Jamfile
@@ -27,9 +27,8 @@ KernelMergeObject kernel_lib_posix_arch_$(TARGET_ARCH).o :
 	kernel_longjmp_return.c
 	kernel_setjmp_save_sigs.c
 
-	generic_memcpy.c
+	arch_memcpy.S
 	arch_aeabi_memcpy.c
-	generic_memset.c
 
 	: $(TARGET_KERNEL_PIC_CCFLAGS)
 ;
diff --git a/src/system/libroot/posix/string/arch/arm/Jamfile b/src/system/libroot/posix/string/arch/arm/Jamfile
index 1e05ca3273..cf8cfdfc4a 100644
--- a/src/system/libroot/posix/string/arch/arm/Jamfile
+++ b/src/system/libroot/posix/string/arch/arm/Jamfile
@@ -13,9 +13,8 @@ for architectureObject in [ MultiArchSubDirSetup arm ] {
 		SEARCH_SOURCE += [ FDirName $(SUBDIR) $(DOTDOT) generic ] ;
 
 		MergeObject <$(architecture)>posix_string_arch_$(TARGET_ARCH).o :
-			generic_memcpy.c
+			arch_memcpy.S
 			arch_aeabi_memcpy.c
-			generic_memset.c
 			;
 	}
 }
diff --git a/src/system/libroot/posix/string/arch/arm/arch_memcpy.S b/src/system/libroot/posix/string/arch/arm/arch_memcpy.S
new file mode 100644
index 0000000000..d00677685c
--- /dev/null
+++ b/src/system/libroot/posix/string/arch/arm/arch_memcpy.S
@@ -0,0 +1,118 @@
+/*
+ * Copyright 2026, Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include <asm_defs.h>
+
+
+/*	ARMv7 memcpy() and memset(): 32 bytes at a time with load and store
+	multiple, then words, then bytes. In userland a copy between differently
+	aligned buffers uses unaligned word loads, which ARMv7 does on normal
+	memory; the kernel may copy from or to device memory, where they fault, so
+	it copies those byte by byte.
+*/
+
+.syntax unified
+.arm
+
+
+/* void* memcpy(void* dest, const void* source, size_t count) */
+FUNCTION(memcpy):
+	push	{r0, r4-r9, lr}
+	cmp		r2, #16
+	blo		.Lcopy_bytes
+
+	eor		r3, r0, r1
+	tst		r3, #3
+#ifdef _KERNEL_MODE
+	bne		.Lcopy_bytes
+#endif
+
+	/* align the destination */
+1:	tst		r0, #3
+	beq		2f
+	ldrb	r3, [r1], #1
+	strb	r3, [r0], #1
+	sub		r2, r2, #1
+	b		1b
+
+2:
+#ifndef _KERNEL_MODE
+	/* the source may still be misaligned: no load multiple then */
+	tst		r1, #3
+	bne		.Lcopy_words
+#endif
+	subs	r2, r2, #32
+	blo		4f
+3:	pld		[r1, #64]
+	ldmia	r1!, {r3-r9, r12}
+	stmia	r0!, {r3-r9, r12}
+	subs	r2, r2, #32
+	bhs		3b
+4:	add		r2, r2, #32
+
+.Lcopy_words:
+	subs	r2, r2, #4
+	blo		5f
+	ldr		r3, [r1], #4
+	str		r3, [r0], #4
+	b		.Lcopy_words
+5:	add		r2, r2, #4
+
+.Lcopy_bytes:
+	cmp		r2, #0
+	beq		7f
+6:	ldrb	r3, [r1], #1
+	strb	r3, [r0], #1
+	subs	r2, r2, #1
+	bne		6b
+7:	pop		{r0, r4-r9, pc}
+FUNCTION_END(memcpy)
+
+
+/* void* memset(void* dest, int value, size_t count) */
+FUNCTION(memset):
+	push	{r0, r4-r9, lr}
+	and		r1, r1, #0xff
+	orr		r1, r1, r1, lsl #8
+	orr		r1, r1, r1, lsl #16
+	cmp		r2, #16
+	blo		.Lset_bytes
+
+	/* align the destination */
+1:	tst		r0, #3
+	beq		2f
+	strb	r1, [r0], #1
+	sub		r2, r2, #1
+	b		1b
+
+2:	mov		r3, r1
+	mov		r4, r1
+	mov		r5, r1
+	mov		r6, r1
+	mov		r7, r1
+	mov		r8, r1
+	mov		r12, r1
+	subs	r2, r2, #32
+	blo		4f
+3:	stmia	r0!, {r1, r3-r8, r12}
+	subs	r2, r2, #32
+	bhs		3b
+4:	add		r2, r2, #32
+
+5:	subs	r2, r2, #4
+	blo		6f
+	str		r1, [r0], #4
+	b		5b
+6:	add		r2, r2, #4
+
+.Lset_bytes:
+	cmp		r2, #0
+	beq		8f
+7:	strb	r1, [r0], #1
+	subs	r2, r2, #1
+	bne		7b
+8:	pop		{r0, r4-r9, pc}
+FUNCTION_END(memset)
