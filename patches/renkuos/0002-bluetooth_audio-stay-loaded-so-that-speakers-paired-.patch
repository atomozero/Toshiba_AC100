From 9b5a1dce7faa2b7e5ed99d98f24f90d58cd2713a Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Thu, 19 Nov 2026 18:58:51 +0100
Subject: [PATCH 02/32] bluetooth_audio: stay loaded, so that speakers paired
 later are seen

The media add-on server unloads an add-on that has no node once it
started, which for this one is whenever no speakers were paired then.
The bond watcher went with it, and speakers paired later did not become
outputs until the media services restarted. The add-on now keeps one use
of itself with the dormant node manager, which it never gives back.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../bluetooth_audio/BluetoothAudioAddOn.cpp   | 27 ++++++++++++++++++-
 .../bluetooth_audio/BluetoothAudioAddOn.h     |  2 ++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioAddOn.cpp b/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioAddOn.cpp
index 7cce6e5d1d..e8a99ee43a 100644
--- a/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioAddOn.cpp
+++ b/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioAddOn.cpp
@@ -20,6 +20,7 @@
 
 #include <bluetooth/bdaddrUtils.h>
 #include <bluetoothserver_p.h>
+#include <DormantNodeManager.h>
 
 #include "BluetoothAudioNode.h"
 
@@ -98,7 +99,8 @@ BluetoothAudioAddOn::BluetoothAudioAddOn(image_id image)
 	:
 	BMediaAddOn(image),
 	fLock("bluetooth audio devices"),
-	fWatcher(NULL)
+	fWatcher(NULL),
+	fStaysLoaded(false)
 {
 	_LoadDevices();
 	syslog(LOG_INFO, "bluetooth_audio: %" B_PRId32 " outputs\n",
@@ -132,6 +134,8 @@ BluetoothAudioAddOn::InitCheck(const char** _failureText)
 int32
 BluetoothAudioAddOn::CountFlavors()
 {
+	_StayLoaded();
+
 	BAutolock locker(fLock);
 	return fDevices.CountItems();
 }
@@ -194,6 +198,27 @@ BluetoothAudioAddOn::BondsChanged()
 	index (it no longer calls the speakers: they have no key).
 	Returns how many were added.
 */
+/*!	The media add-on server unloads an add-on that has no node, which for
+	us is whenever no speakers were paired when the media services started.
+	The add-on would then take its bond watcher along, and speakers paired
+	later would not become outputs until the media services restart. So it
+	keeps itself loaded: one more use of the add-on, which is never given
+	back. The first call to CountFlavors() comes after the add-on server
+	gave the add-on its ID.
+*/
+void
+BluetoothAudioAddOn::_StayLoaded()
+{
+	if (fStaysLoaded || AddonID() <= 0)
+		return;
+	BMediaAddOn* addOn = gDormantNodeManager->GetAddOn(AddonID());
+	if (addOn == this)
+		fStaysLoaded = true;
+	else if (addOn != NULL)
+		gDormantNodeManager->PutAddOn(AddonID());
+}
+
+
 int32
 BluetoothAudioAddOn::_LoadDevices()
 {
diff --git a/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioAddOn.h b/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioAddOn.h
index beb3109c9b..ee2b3deff5 100644
--- a/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioAddOn.h
+++ b/src/add-ons/media/media-add-ons/bluetooth_audio/BluetoothAudioAddOn.h
@@ -48,12 +48,14 @@ public:
 
 private:
 			int32				_LoadDevices();
+			void				_StayLoaded();
 
 			BLocker				fLock;
 			BObjectList<BluetoothAudioDevice, true> fDevices;
 				// only added to while running: a node knows its device by
 				// its index
 			BondWatcher*		fWatcher;
+			bool				fStaysLoaded;
 };
 
 
