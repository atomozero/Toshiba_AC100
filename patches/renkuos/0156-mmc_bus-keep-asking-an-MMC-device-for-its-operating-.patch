From d5ce952101cb18648b40e5433071e2a1adb51b02 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 20 Oct 2026 00:25:19 +0200
Subject: [PATCH 156/203] mmc_bus: keep asking an MMC device for its operating
 conditions

The first CMD1 after power up can get no reply, as with the eMMC of the
Toshiba AC100: the scan then took the device for something else. Keep asking
also after a command without reply, and give up after one second, the time a
device may take to become ready, instead of waiting forever for a device
that stays busy.
---
 .../kernel/bus_managers/mmc/mmc_bus.cpp       | 30 ++++++++++++++-----
 1 file changed, 23 insertions(+), 7 deletions(-)

diff --git a/src/add-ons/kernel/bus_managers/mmc/mmc_bus.cpp b/src/add-ons/kernel/bus_managers/mmc/mmc_bus.cpp
index 7185662b75..6c290ec5e0 100644
--- a/src/add-ons/kernel/bus_managers/mmc/mmc_bus.cpp
+++ b/src/add-ons/kernel/bus_managers/mmc/mmc_bus.cpp
@@ -416,21 +416,37 @@ MMCBus::_WorkerThread(void* cookie)
 			hcs = 0;
 
 			TRACE("Trying MMC CMD1 initialization...\n");
+			// The first commands after power up can get lost (seen with the
+			// eMMC of the Toshiba AC100), and a device may take up to one
+			// second to become ready (JEDEC 84-B51, 6.4.3): keep asking, also
+			// when a command got no reply, but not forever.
+			const bigtime_t kMMCReadyTimeout = 1000000;
+			bigtime_t mmcStart = system_time();
+			bool replied = false;
+			ocr = 0;
 			do {
 				// Full voltage window (2.7-3.6V and 1.70-1.95V), and bit 30 to
 				// tell the device the host supports sector addressing, which
 				// devices larger than 2GB require (JEDEC 84-B51, 7.1). Devices
 				// that only do byte addressing ignore that bit.
 				status = bus->ExecuteCommand(0, MMC_SEND_OP_COND, 0x40FF8080, &ocr);
-				if (status != B_OK) {
-					TRACE("MMC CMD1 failed\n");
-					break;
-				}
+				if (status == B_OK)
+					replied = true;
+				else
+					ocr = 0;
 				if ((ocr & (1 << 31)) == 0) {
-					TRACE("MMC card is busy\n");
-					snooze(100000);
+					TRACE("MMC card is busy or did not reply\n");
+					snooze(10000);
 				}
-			} while ((ocr & (1 << 31)) == 0);
+			} while ((ocr & (1 << 31)) == 0
+				&& system_time() - mmcStart < kMMCReadyTimeout);
+
+			if (!replied)
+				TRACE("MMC CMD1 got no reply\n");
+			else if ((ocr & (1 << 31)) == 0)
+				ERROR("MMC device did not become ready\n");
+			else
+				status = B_OK;
 
 			if (status == B_OK && (ocr & (1 << 31)) != 0) {
 				TRACE("Detected MMC card after CMD1\n");
