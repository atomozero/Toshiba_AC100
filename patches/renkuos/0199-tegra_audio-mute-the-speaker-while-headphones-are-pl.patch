From 0e37d43fdd6cd92f8fade90d91b9b4476c76e01c Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 24 Oct 2026 10:14:10 +0200
Subject: [PATCH 199/270] tegra_audio: mute the speaker while headphones are
 plugged in

The jack switch of the AC100 is on GPIO W2 (nvidia,hp-det-gpios), high
while a plug is in; the pin is not set up as a GPIO by the firmware.
Configure it as an input and poll it every 250 ms from a kernel thread,
muting the speaker outputs of the ALC5632 while headphones are in, as
the PAZ00 machine driver of Linux does with its "Int Spk" pin.

Checked on the AC100 by reading the pin: 1 with headphones, 0 without.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../drivers/audio/tegra/tegra_audio.cpp       | 76 +++++++++++++++++++
 1 file changed, 76 insertions(+)

diff --git a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
index 0aed59c3da..9b1071785f 100644
--- a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
+++ b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
@@ -148,6 +148,17 @@ struct tegra_audio_diag {
 #define DMA_APB_SEQ_BUS_WIDTH_32	(2U << 28)
 #define DMA_APB_SEQ_WRAP_WORD_1		(1U << 16)
 
+// GPIO controller: the headphone jack switch is on GPIO W2, high while a
+// plug is in (nvidia,hp-det-gpios of the PAZ00 device tree)
+#define GPIO_BASE					0x6000d000
+#define GPIO_PORT_OFFSET(port)		(((port) / 4) * 0x80 + ((port) % 4) * 4)
+#define GPIO_CNF					0x00
+#define GPIO_OE						0x10
+#define GPIO_IN						0x30
+#define GPIO_PORT_W					22
+#define HP_DETECT_BIT				(1U << 2)
+#define HP_POLL_INTERVAL			250000
+
 // Realtek ALC5632
 #define ALC5632_RESET				0x00
 #define ALC5632_SPK_OUT_VOL			0x02
@@ -208,6 +219,12 @@ struct tegra_audio {
 	bigtime_t				realTime;
 	uint32					interrupts;
 	uint32					i2sSourceAtBoot;
+
+	area_id					gpioArea;
+	volatile uint8*			gpioPort;	// the registers of port W
+	thread_id				jackThread;
+	volatile bool			quitJackThread;
+	int32					headphones;	// -1 not known yet
 };
 
 
@@ -367,6 +384,56 @@ codec_init(tegra_audio* audio)
 }
 
 
+/*!	Mutes the speaker while headphones are plugged in, as the PAZ00 machine
+	driver of Linux does with its jack and the "Int Spk" pin.
+*/
+static void
+set_headphones(tegra_audio* audio, bool plugged)
+{
+	codec_update(audio, ALC5632_SPK_OUT_VOL, 0x8080, plugged ? 0x8080 : 0);
+	TRACE_ALWAYS("headphones %s, speaker %s\n",
+		plugged ? "plugged in" : "unplugged", plugged ? "muted" : "on");
+}
+
+
+static status_t
+jack_thread(void* data)
+{
+	tegra_audio* audio = (tegra_audio*)data;
+	while (!audio->quitJackThread) {
+		int32 plugged = (read32(audio->gpioPort, GPIO_IN) & HP_DETECT_BIT) != 0;
+		if (plugged != audio->headphones) {
+			audio->headphones = plugged;
+			set_headphones(audio, plugged);
+		}
+		snooze(HP_POLL_INTERVAL);
+	}
+	return B_OK;
+}
+
+
+static void
+start_jack_detection(tegra_audio* audio)
+{
+	audio->gpioArea = map_registers("tegra gpio", GPIO_BASE, &audio->gpioPort);
+	if (audio->gpioArea < B_OK)
+		return;
+	audio->gpioPort += GPIO_PORT_OFFSET(GPIO_PORT_W);
+
+	// a GPIO, as an input
+	write32(audio->gpioPort, GPIO_OE,
+		read32(audio->gpioPort, GPIO_OE) & ~HP_DETECT_BIT);
+	write32(audio->gpioPort, GPIO_CNF,
+		read32(audio->gpioPort, GPIO_CNF) | HP_DETECT_BIT);
+
+	audio->headphones = -1;
+	audio->jackThread = spawn_kernel_thread(jack_thread, "tegra audio jack",
+		B_LOW_PRIORITY, audio);
+	if (audio->jackThread >= B_OK)
+		resume_thread(audio->jackThread);
+}
+
+
 //	#pragma mark - Tegra side
 
 
@@ -1337,6 +1404,12 @@ tegra_audio_register_device(device_node* parent)
 static void
 tegra_audio_free_resources(tegra_audio* audio)
 {
+	if (audio->jackThread >= B_OK) {
+		audio->quitJackThread = true;
+		wait_for_thread(audio->jackThread, NULL);
+	}
+	if (audio->gpioArea >= B_OK)
+		delete_area(audio->gpioArea);
 	if (audio->interruptInstalled) {
 		remove_io_interrupt_handler(APBDMA_CHANNEL_IRQ, dma_interrupt,
 			audio);
@@ -1368,6 +1441,8 @@ tegra_audio_init_driver(device_node* node, void** _cookie)
 	audio->node = node;
 	audio->carArea = audio->miscArea = audio->i2sArea = audio->dmaArea = -1;
 	audio->bufferArea = -1;
+	audio->gpioArea = -1;
+	audio->jackThread = -1;
 	audio->bufferReadySem = -1;
 	mutex_init(&audio->lock, "tegra audio");
 	B_INITIALIZE_SPINLOCK(&audio->interruptLock);
@@ -1424,6 +1499,7 @@ tegra_audio_init_driver(device_node* node, void** _cookie)
 	}
 
 	self_test(audio);
+	start_jack_detection(audio);
 
 	*_cookie = audio;
 	return B_OK;
