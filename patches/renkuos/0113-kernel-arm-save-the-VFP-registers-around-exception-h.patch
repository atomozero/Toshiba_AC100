From 6b49df2ec9b86b08f4aebc5f9cb63f89d6311695 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 20:49:48 +0200
Subject: [PATCH 113/203] kernel/arm: save the VFP registers around exception
 handlers

The kernel uses the VFP registers too (the compiler does for 64 bit
copies), so an interrupt or abort clobbered those of the interrupted code:
on the Toshiba AC100, with many interrupts, computations in userland went
wrong now and then (164 errors in sigtest). Building the kernel without
them is not possible, as supports_device() returns a float.

Save them below the iframe on entry of the IRQ, FIQ, abort and undefined
instruction handlers and restore them on exit. A signal frame set up on the
way back to userland takes the saved ones, not the live ones the kernel
used since.
---
 .../kernel/arch/arm/arch_thread_types.h       |  3 ++
 src/system/kernel/arch/arm/arch_exceptions.S  | 45 ++++++++++---------
 src/system/kernel/arch/arm/arch_int.cpp       | 27 +++++++++--
 src/system/kernel/arch/arm/arch_thread.cpp    | 16 +++++--
 4 files changed, 63 insertions(+), 28 deletions(-)

diff --git a/headers/private/kernel/arch/arm/arch_thread_types.h b/headers/private/kernel/arch/arm/arch_thread_types.h
index 23edd176b6..dc3ee91073 100644
--- a/headers/private/kernel/arch/arm/arch_thread_types.h
+++ b/headers/private/kernel/arch/arm/arch_thread_types.h
@@ -52,6 +52,9 @@ struct arch_thread {
 	struct iframe_stack	iframes;
 
 	struct iframe*	userFrame;
+	struct arch_fpu_context* userFPU;
+		// the VFP registers of userland saved on exception entry, while
+		// signals are handled; NULL after a syscall (they are live then)
 	uint32	oldR0;
 	uint32	oldR1;
 
diff --git a/src/system/kernel/arch/arm/arch_exceptions.S b/src/system/kernel/arch/arm/arch_exceptions.S
index aeb1fb00e8..8f34c5e1d9 100644
--- a/src/system/kernel/arch/arm/arch_exceptions.S
+++ b/src/system/kernel/arch/arm/arch_exceptions.S
@@ -18,6 +18,26 @@
 	msr		cpsr_c, r0
 .endm
 
+/* Calls \handler with the iframe, around it saves and restores the VFP
+   registers: the kernel uses them too (the compiler does for 64 bit
+   copies), and an exception may interrupt code using them at any point.
+   The saved registers are right below the iframe, see
+   arm_exception_fpu_context(). */
+#define EXCEPTION_FPU_AREA_SIZE	264		/* sizeof(arch_fpu_context) */
+.macro CALL_HANDLER_SAVING_VFP handler
+	mov		r4, sp						/* iframe */
+	sub		sp, sp, #EXCEPTION_FPU_AREA_SIZE
+	mov		r0, sp
+	bl		arm_save_fpu
+	mov		r0, r4
+	mov		fp, r0
+	bl		\handler
+	DISABLE_INTERRUPTS
+	mov		r0, sp
+	bl		arm_restore_fpu
+	mov		sp, r4
+.endm
+
 /* The following two macros are taken from FreeBSD... */
 
 .macro PUSH_FRAME_IN_SVC
@@ -135,11 +155,8 @@ arm_exception_stacks:
 FUNCTION(arm_undefined):
 	PUSH_FRAME_IN_SVC
 
-	mov		r0, sp		/* iframe */
-	mov		fp, r0
-	bl		arch_arm_undefined
+	CALL_HANDLER_SAVING_VFP arch_arm_undefined
 
-	DISABLE_INTERRUPTS
 	PULL_FRAME_FROM_SVC_AND_EXIT
 FUNCTION_END(arm_undefined)
 
@@ -164,11 +181,8 @@ FUNCTION(arm_prefetch_abort):
 	sub		lr, lr, #4	/* Adjust LR */
 	PUSH_FRAME_IN_SVC
 
-	mov		r0, sp		/* iframe */
-	mov		fp, r0
-	bl		arch_arm_prefetch_abort
+	CALL_HANDLER_SAVING_VFP arch_arm_prefetch_abort
 
-	DISABLE_INTERRUPTS
 	PULL_FRAME_FROM_SVC_AND_EXIT
 FUNCTION_END(arm_prefetch_abort)
 
@@ -181,11 +195,8 @@ FUNCTION(arm_data_abort):
 	sub		lr, lr, #8	/* Adjust LR */
 	PUSH_FRAME_IN_SVC
 
-	mov		r0, sp		/* iframe */
-	mov		fp, r0
-	bl		arch_arm_data_abort
+	CALL_HANDLER_SAVING_VFP arch_arm_data_abort
 
-	DISABLE_INTERRUPTS
 	PULL_FRAME_FROM_SVC_AND_EXIT
 FUNCTION_END(arm_data_abort)
 
@@ -199,11 +210,8 @@ FUNCTION(arm_irq):
 	sub		lr, lr, #4	/* Adjust LR */
 	PUSH_FRAME_IN_SVC
 
-	mov		r0, sp		/* iframe */
-	mov		fp, r0
-	bl		arch_arm_irq
+	CALL_HANDLER_SAVING_VFP arch_arm_irq
 
-	DISABLE_INTERRUPTS
 	PULL_FRAME_FROM_SVC_AND_EXIT
 FUNCTION_END(arm_irq)
 
@@ -212,11 +220,8 @@ FUNCTION(arm_fiq):
 	sub		lr, lr, #4	/* Adjust LR */
 	PUSH_FRAME_IN_SVC
 
-	mov		r0, sp		/* iframe */
-	mov		fp, r0
-	bl		arch_arm_fiq
+	CALL_HANDLER_SAVING_VFP arch_arm_fiq
 
-	DISABLE_INTERRUPTS
 	PULL_FRAME_FROM_SVC_AND_EXIT
 FUNCTION_END(arm_fiq)
 
diff --git a/src/system/kernel/arch/arm/arch_int.cpp b/src/system/kernel/arch/arm/arch_int.cpp
index ec4718460c..4408a3d7b4 100644
--- a/src/system/kernel/arch/arm/arch_int.cpp
+++ b/src/system/kernel/arch/arm/arch_int.cpp
@@ -248,10 +248,25 @@ static struct arm_exception_record* arm_log_exception(uint32 type,
 	signals, setting up their frames on \a iframe.
 	Interrupts must be disabled; they still are on return.
 */
+/*!	The VFP registers the exception entry saved below \a iframe, see
+	CALL_HANDLER_SAVING_VFP in arch_exceptions.S.
+*/
+static inline arch_fpu_context*
+arm_exception_fpu_context(struct iframe* iframe)
+{
+	return (arch_fpu_context*)((addr_t)iframe - 264);
+}
+
+static_assert(sizeof(arch_fpu_context) == 264,
+	"see EXCEPTION_FPU_AREA_SIZE in arch_exceptions.S");
+
+
 extern "C" void
-arm_kernel_exit_to_userland(Thread* thread, struct iframe* iframe)
+arm_kernel_exit_to_userland(Thread* thread, struct iframe* iframe,
+	arch_fpu_context* fpu)
 {
 	thread->arch_info.userFrame = iframe;
+	thread->arch_info.userFPU = fpu;
 	if ((thread->flags & (THREAD_FLAGS_SIGNALS_PENDING
 			| THREAD_FLAGS_DEBUG_THREAD
 			| THREAD_FLAGS_TRAP_FOR_CORE_DUMP)) != 0) {
@@ -260,6 +275,7 @@ arm_kernel_exit_to_userland(Thread* thread, struct iframe* iframe)
 	} else
 		thread_at_kernel_exit_no_signals();
 	thread->arch_info.userFrame = NULL;
+	thread->arch_info.userFPU = NULL;
 }
 
 
@@ -285,7 +301,8 @@ arch_arm_undefined(struct iframe *iframe)
 		send_signal_to_thread(thread, signal, 0);
 
 		disable_interrupts();
-		arm_kernel_exit_to_userland(thread, iframe);
+		arm_kernel_exit_to_userland(thread, iframe,
+			arm_exception_fpu_context(iframe));
 		return;
 	}
 
@@ -620,7 +637,8 @@ arch_arm_page_fault(struct iframe *frame, addr_t far, uint32 fsr, bool isWrite,
 	if (isUser) {
 		// e.g. deliver the SIGSEGV of an unresolved fault right away
 		disable_interrupts();
-		arm_kernel_exit_to_userland(thread, frame);
+		arm_kernel_exit_to_userland(thread, frame,
+			arm_exception_fpu_context(frame));
 	}
 }
 
@@ -688,7 +706,8 @@ arch_arm_irq(struct iframe *iframe)
 	if (fromUser) {
 		// signals sent to a thread running in userland are handled here
 		disable_interrupts();
-		arm_kernel_exit_to_userland(thread_get_current_thread(), iframe);
+		arm_kernel_exit_to_userland(thread_get_current_thread(), iframe,
+			arm_exception_fpu_context(iframe));
 	}
 }
 
diff --git a/src/system/kernel/arch/arm/arch_thread.cpp b/src/system/kernel/arch/arm/arch_thread.cpp
index 48f4235966..33fd83d3a7 100644
--- a/src/system/kernel/arch/arm/arch_thread.cpp
+++ b/src/system/kernel/arch/arm/arch_thread.cpp
@@ -33,7 +33,8 @@
 #include "ARMVMTranslationMap.h"
 
 
-extern "C" void arm_kernel_exit_to_userland(Thread* thread, iframe* frame);
+extern "C" void arm_kernel_exit_to_userland(Thread* thread, iframe* frame,
+	arch_fpu_context* fpu);
 
 
 //#define TRACE_ARCH_THREAD
@@ -238,7 +239,7 @@ arch_thread_enter_userspace(Thread *thread, addr_t entry,
 
 	// handle the signals sent before the thread started (like the
 	// SIGNAL_CONTINUE_THREAD of resume_thread()), then return to userland
-	arm_kernel_exit_to_userland(thread, &frame);
+	arm_kernel_exit_to_userland(thread, &frame, NULL);
 	arch_return_to_userland(&frame);
 
 	// normally we don't get here
@@ -306,7 +307,13 @@ arch_setup_signal_frame(Thread *thread, struct sigaction *sa,
 	signalFrameData->context.uc_mcontext.r15  = frame->pc;
 	signalFrameData->context.uc_mcontext.cpsr = frame->spsr;
 
-	arm_save_fpu((arch_fpu_context*)&signalFrameData->context.uc_mcontext.d[0]);
+	// the registers of the interrupted code: saved by the exception entry
+	// (the kernel used them since), or live after a syscall
+	if (thread->arch_info.userFPU != NULL) {
+		memcpy(&signalFrameData->context.uc_mcontext.d[0],
+			thread->arch_info.userFPU, sizeof(arch_fpu_context));
+	} else
+		arm_save_fpu((arch_fpu_context*)&signalFrameData->context.uc_mcontext.d[0]);
 
 	// Fill in signalFrameData->context.uc_stack
 	signal_get_user_stack(frame->usr_sp, &signalFrameData->context.uc_stack);
@@ -417,6 +424,7 @@ void
 arch_restore_fork_frame(struct arch_fork_arg *arg)
 {
 	disable_interrupts();
-	arm_kernel_exit_to_userland(thread_get_current_thread(), &arg->frame);
+	arm_kernel_exit_to_userland(thread_get_current_thread(), &arg->frame,
+		NULL);
 	arch_return_to_userland(&arg->frame);
 }
