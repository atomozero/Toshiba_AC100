From 83155bb70d9794ca6ec083f4168b341c3714fa05 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 23:12:42 +0200
Subject: [PATCH 124/270] ARM bring-up: let userland read the cycle counter

To see why a busy thread runs three times slower with two CPUs on the
AC100: whether it gets fewer instructions per cycle or a slower clock (not
for merging).
---
 src/system/kernel/arch/arm/arch_cpu.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/system/kernel/arch/arm/arch_cpu.cpp b/src/system/kernel/arch/arm/arch_cpu.cpp
index 3d4455a2ba..22d5271761 100644
--- a/src/system/kernel/arch/arm/arch_cpu.cpp
+++ b/src/system/kernel/arch/arm/arch_cpu.cpp
@@ -36,6 +36,13 @@ arch_cpu_preboot_init_percpu(kernel_args *args, int curr_cpu)
 	asm volatile ("mcr p15, 0, %0, c13, c0, 1" : : "r" (0));
 	asm volatile ("isb");
 
+	// bring-up aid: let userland read the cycle counter (PMCCNTR) of each CPU
+	uint32 pmcr;
+	asm volatile ("mrc p15, 0, %0, c9, c12, 0" : "=r" (pmcr));
+	asm volatile ("mcr p15, 0, %0, c9, c12, 0" : : "r" (pmcr | 1));
+	asm volatile ("mcr p15, 0, %0, c9, c12, 1" : : "r" (1U << 31));
+	asm volatile ("mcr p15, 0, %0, c9, c14, 0" : : "r" (1));
+
 	if (curr_cpu == 0) {
 		sFirmwareContextID = contextID;
 
