From 31dc2edf9efa77a371255a663d175d7c4552c671 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 19 Oct 2026 23:17:08 +0200
Subject: [PATCH 150/203] kernel/arm: Tegra timer: do not handle ICIs while
 waiting for the time

acquire_spinlock() handles pending inter-CPU interrupts while it spins.
add_timer() reads the time with the timer lock of its CPU held; when the time
lock was busy and a change of the real time clock was pending, its handler
waited for that same timer lock and the CPU deadlocked (panic when the clock
was set from a time server).
---
 src/system/kernel/arch/arm/soc_tegra.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/system/kernel/arch/arm/soc_tegra.cpp b/src/system/kernel/arch/arm/soc_tegra.cpp
index 15ce2a0c87..bbf8367caa 100644
--- a/src/system/kernel/arch/arm/soc_tegra.cpp
+++ b/src/system/kernel/arch/arm/soc_tegra.cpp
@@ -7,6 +7,7 @@
 #include "soc_tegra.h"
 
 #include <KernelExport.h>
+#include <cpu.h>
 #include <smp.h>
 #include <timer.h>
 #include <vm/vm.h>
@@ -151,7 +152,12 @@ bigtime_t
 TegraTimer::Time()
 {
 	cpu_status state = disable_interrupts();
-	acquire_spinlock(&fLock);
+	// Spin without handling inter-CPU interrupts, as acquire_spinlock() does:
+	// callers may hold locks their handlers need (add_timer() holds the timer
+	// lock that a change of the real time clock takes on every CPU), and the
+	// lock is only ever held for one register read.
+	while (!try_acquire_spinlock(&fLock))
+		arch_cpu_pause();
 
 	bigtime_t time = _TimeLocked();
 
