+		setdecor
+		spamdbm
+		translate
+		WindowShade
+	] ;
+
+	SYSTEM_APPS += [ FFilterByBuildFeatures
+		AutoRaise
+		CodyCam
+		GLInfo@mesa
+		HaikuDepot
+		Icon-O-Matic@expat
+		LaunchBox
+		LegacyPackageInstaller
+		Mail
+		MediaConverter
+		MediaPlayer
+		People
+		PoorMan
+		RemoteDesktop
+		SerialConnect
+		SoftwareUpdater
+		SoundRecorder
+	] ;
