From ba7f9b50129ac0baa7499d2f49c82194d4f80a7a Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 27 Oct 2026 07:20:31 +0100
Subject: [PATCH 52/63] build: the AC100 drivers, applications and external
 libraries in the ARM images

- the GL kit and GLU, FFmpeg, libpng, libjpeg and OpenSSL from external
  directories, with the GL demos, the media plugins and translators
- the applications, preferences and add-ons of the regular image in the
  minimum image on ARM; ralinkwifi, ASIX and Pegasus USB network
  drivers, the Bluetooth stack
- the Tegra 2 and AC100 drivers in the Haiku package; no i2c_hid and no
  usb_webcam on 32-bit ARM

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 build/jam/BuildFeatures                       |  66 +++++-
 build/jam/images/definitions/minimum          | 215 +++++++++++++++++-
 build/jam/packages/Haiku                      |  13 +-
 .../Persistence/Wrappers/MediaFormatIO.cpp    |   6 +-
 src/preferences/media/Jamfile                 |  13 +-
 5 files changed, 299 insertions(+), 14 deletions(-)

diff --git a/build/jam/BuildFeatures b/build/jam/BuildFeatures
index 0f2fce8265..585b900496 100644
--- a/build/jam/BuildFeatures
+++ b/build/jam/BuildFeatures
@@ -19,7 +19,17 @@ if [ IsHaikuImagePackageAdded openssl3 ] {
 	HAIKU_BUILD_FEATURE_SSL = 1 ;
 }
 
-if $(HAIKU_BUILD_FEATURE_SSL) {
+if $(HAIKU_EXTERNAL_OPENSSL_DIR) && ! [ IsPackageAvailable openssl3_devel ] {
+	# An OpenSSL built elsewhere for the target (extracted package), when the
+	# repositories have none for it: the network kit gets HTTPS support, the
+	# image must then contain the package that provides libssl.so.3.
+	SetBuildFeatureAttribute openssl : headers
+		: [ FDirName $(HAIKU_EXTERNAL_OPENSSL_DIR) develop headers ] ;
+	SetBuildFeatureAttribute openssl : libraries
+		: [ FDirName $(HAIKU_EXTERNAL_OPENSSL_DIR) develop lib libcrypto.so ]
+		  [ FDirName $(HAIKU_EXTERNAL_OPENSSL_DIR) develop lib libssl.so ] ;
+	EnableBuildFeatures openssl ;
+} else if $(HAIKU_BUILD_FEATURE_SSL) {
 	if [ IsPackageAvailable openssl3_devel ] {
 		ExtractBuildFeatureArchives openssl :
 			file: base openssl3
@@ -182,7 +192,23 @@ if [ IsPackageAvailable glu_devel ] {
 
 
 # GL (GL Kit, Mesa3D)
-if [ IsPackageAvailable mesa_devel ] {
+# HAIKU_EXTERNAL_GL_DIR: Mesa (legacy, with the GL kit) and GLU built outside
+# of the package repositories, extracted to <dir>/mesa and <dir>/glu, like
+# for the Toshiba AC100 (ARM, VFPv3-D16)
+if $(HAIKU_EXTERNAL_GL_DIR) && ! [ IsPackageAvailable mesa_devel ] {
+	local glDir = $(HAIKU_EXTERNAL_GL_DIR) ;
+	SetBuildFeatureAttribute mesa : headers
+		: [ FDirName $(glDir) mesa develop headers os opengl ]
+		  [ FDirName $(glDir) mesa develop headers ] ;
+	SetBuildFeatureAttribute mesa : library
+		: [ FDirName $(glDir) mesa lib libGL.so ] ;
+	EnableBuildFeatures mesa ;
+	SetBuildFeatureAttribute glu : headers
+		: [ FDirName $(glDir) glu develop headers ] ;
+	SetBuildFeatureAttribute glu : library
+		: [ FDirName $(glDir) glu lib libGLU.so ] ;
+	EnableBuildFeatures glu ;
+} else if [ IsPackageAvailable mesa_devel ] {
 	ExtractBuildFeatureArchives mesa :
 		file: base mesa
 			runtime: lib
@@ -199,7 +225,21 @@ if [ IsPackageAvailable mesa_devel ] {
 
 
 # FFmpeg
-if [ IsPackageAvailable ffmpeg6_devel ] {
+if $(HAIKU_EXTERNAL_FFMPEG_DIR) && ! [ IsPackageAvailable ffmpeg6_devel ] {
+	# An FFmpeg built elsewhere for the target (extracted package), when the
+	# repositories have none for it.
+	local ffmpegDir = $(HAIKU_EXTERNAL_FFMPEG_DIR) ;
+	SetBuildFeatureAttribute ffmpeg : headers
+		: [ FDirName $(ffmpegDir) develop headers ] ;
+	local ffmpegLib ;
+	local ffmpegLibraries ;
+	for ffmpegLib in libavformat.so libavcodec.so libavfilter.so libswscale.so
+			libavutil.so libswresample.so {
+		ffmpegLibraries += [ FDirName $(ffmpegDir) lib $(ffmpegLib) ] ;
+	}
+	SetBuildFeatureAttribute ffmpeg : libraries : $(ffmpegLibraries) ;
+	EnableBuildFeatures ffmpeg ;
+} else if [ IsPackageAvailable ffmpeg6_devel ] {
 	local ffmpegLibs = libavformat.so libavcodec.so libavfilter.so libswscale.so
 		libavutil.so libswresample.so ;
 
@@ -318,7 +358,15 @@ if [ IsPackageAvailable haikuwebkit_devel ] {
 
 
 # libpng
-if [ IsPackageAvailable libpng16_devel ] {
+if $(HAIKU_EXTERNAL_LIBPNG_DIR) && ! [ IsPackageAvailable libpng16_devel ] {
+	# A libpng built elsewhere for the target (extracted package), when the
+	# repositories have none for it.
+	SetBuildFeatureAttribute libpng : headers
+		: [ FDirName $(HAIKU_EXTERNAL_LIBPNG_DIR) develop headers ] ;
+	SetBuildFeatureAttribute libpng : library
+		: [ FDirName $(HAIKU_EXTERNAL_LIBPNG_DIR) lib libpng16.so ] ;
+	EnableBuildFeatures libpng ;
+} else if [ IsPackageAvailable libpng16_devel ] {
 	ExtractBuildFeatureArchives libpng :
 		file: base libpng16
 			runtime: lib
@@ -369,7 +417,15 @@ if [ IsPackageAvailable jasper_devel ] {
 
 
 # jpeg
-if [ IsPackageAvailable libjpeg_turbo_devel ] {
+if $(HAIKU_EXTERNAL_JPEG_DIR) && ! [ IsPackageAvailable libjpeg_turbo_devel ] {
+	# A libjpeg built elsewhere for the target (extracted package), when the
+	# repositories have none for it.
+	SetBuildFeatureAttribute jpeg : headers
+		: [ FDirName $(HAIKU_EXTERNAL_JPEG_DIR) develop headers ] ;
+	SetBuildFeatureAttribute jpeg : library
+		: [ FDirName $(HAIKU_EXTERNAL_JPEG_DIR) lib libjpeg.so ] ;
+	EnableBuildFeatures jpeg ;
+} else if [ IsPackageAvailable libjpeg_turbo_devel ] {
 	ExtractBuildFeatureArchives jpeg :
 		file: base libjpeg_turbo
 			runtime: lib
