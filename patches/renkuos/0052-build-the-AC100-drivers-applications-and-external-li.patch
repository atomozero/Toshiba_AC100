--- a/src/preferences/media/Jamfile
+++ b/src/preferences/media/Jamfile
@@ -2,6 +2,16 @@ SubDir HAIKU_TOP src preferences media ;
 
 UsePrivateHeaders media midi shared ;
 
+# libmidi needs fluidlite, which is not available everywhere (e.g. ARM): the
+# MIDI settings view only needs its settings functions then
+local midiSources ;
+local midiLibrary = midi ;
+if ! [ FIsBuildFeatureEnabled fluidlite ] {
+	SEARCH_SOURCE += [ FDirName $(HAIKU_TOP) src kits midi ] ;
+	midiSources = MidiSettings.cpp ;
+	midiLibrary = ;
+}
+
