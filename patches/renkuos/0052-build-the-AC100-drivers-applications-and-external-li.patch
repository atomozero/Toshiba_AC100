+		Media
+		Printers
+		Repositories
+		ScreenSaver
+		Sounds
+	] ;
+
+	SYSTEM_DEMOS += [ FFilterByBuildFeatures
+		Cortex@expat
+		GLTeapot@mesa
+		$(HAIKU_INCLUDE_TRADEMARKS)Haiku3d@mesa
+		OverlayImage
+	] ;
+
+	SYSTEM_SERVERS += [ FFilterByBuildFeatures
+		bluetooth_server
+		mail_daemon
+		media_addon_server
+		media_server
+		midi_server
+		print_server
+		print_addon_server
+	] ;
+
