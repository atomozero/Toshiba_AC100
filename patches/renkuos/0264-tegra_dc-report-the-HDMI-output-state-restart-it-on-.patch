From 5f197d169f189980d545437aec99e8d5b09e43b1 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 26 Oct 2026 22:24:31 +0100
Subject: [PATCH 264/270] tegra_dc: report the HDMI output state, restart it on
 request

TEGRA_DC_GET_HDMI_STATUS tells whether a screen is plugged in, its
name, whether it is an HDMI sink, and the mode the output runs.
TEGRA_DC_RECONNECT_HDMI restarts the output with the driver settings
read again, so they apply without unplugging the cable.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../private/graphics/tegra_dc/tegra_dc_info.h | 19 +++++++
 .../kernel/drivers/graphics/tegra_dc/hdmi.cpp | 53 ++++++++++++++++++-
 .../kernel/drivers/graphics/tegra_dc/hdmi.h   |  5 ++
 .../drivers/graphics/tegra_dc/tegra_dc.cpp    | 13 +++++
 4 files changed, 89 insertions(+), 1 deletion(-)

diff --git a/headers/private/graphics/tegra_dc/tegra_dc_info.h b/headers/private/graphics/tegra_dc/tegra_dc_info.h
index 4e78a4b608..ce8563b0a2 100644
--- a/headers/private/graphics/tegra_dc/tegra_dc_info.h
+++ b/headers/private/graphics/tegra_dc/tegra_dc_info.h
@@ -67,6 +67,25 @@ enum {
 		// area_id
 	TEGRA_DC_CONFIGURE_OVERLAY,
 		// tegra_dc_overlay_config
+	TEGRA_DC_GET_HDMI_STATUS,
+		// tegra_dc_hdmi_status
+	TEGRA_DC_RECONNECT_HDMI,
+		// nothing: the HDMI output reads its driver settings again
+};
+
+
+struct tegra_dc_hdmi_status {
+	bool			plugged;		// the hot plug line is up
+	bool			active;			// the output runs
+	bool			has_edid;
+	bool			hdmi_sink;		// rather than DVI
+	bool			dvi;			// sending DVI
+	char			screen_name[16];
+	uint16			width;
+	uint16			height;
+	uint32			pixel_clock;	// kHz
+	uint16			h_total;
+	uint16			v_total;
 };
 
 
diff --git a/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp b/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
index edea1d5492..4236d3514e 100644
--- a/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
+++ b/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
@@ -18,6 +18,7 @@
 
 
 #include "hdmi.h"
+#include "tegra_dc_info.h"
 
 #include <stdio.h>
 #include <stdlib.h>
@@ -370,6 +371,11 @@ static struct {
 
 	hdmi_overlay	overlay;
 
+	bool			plugged;
+	bool			has_edid;
+	bool			hdmi_sink;
+	bool			sending_dvi;
+	char			screen_name[16];
 	bool			active;
 	hdmi_mode		mode;
 	tmds_settings	tmds;
@@ -1429,13 +1435,15 @@ connect()
 
 	bool hdmiSink = true;
 	sHdmi.mode = k720p;
+	sHdmi.screen_name[0] = '\0';
+	sHdmi.has_edid = status == B_OK;
 	if (status == B_OK) {
 		hdmiSink = is_hdmi_sink(edid, edidSize);
 		hdmi_mode chosen;
 		if (!tmds.force_720p && choose_mode(edid, edidSize,
 				tmds.preferred_mode, chosen))
 			sHdmi.mode = chosen;
-		char name[14] = "unknown";
+		char name[14] = "";
 		for (uint32 offset = 0x36; offset < 0x7e; offset += 18) {
 			const uint8* descriptor = edid + offset;
 			if (descriptor[0] == 0 && descriptor[1] == 0
@@ -1451,11 +1459,14 @@ connect()
 		}
 		dprintf("tegra_dc: hdmi: EDID of \"%s\", %s sink\n", name,
 			hdmiSink ? "HDMI" : "DVI");
+		strlcpy(sHdmi.screen_name, name, sizeof(sHdmi.screen_name));
 	} else
 		ERROR("no EDID (%s), trying 1280x720\n", strerror(status));
 
+	sHdmi.hdmi_sink = hdmiSink;
 	if (tmds.force_dvi)
 		hdmiSink = false;
+	sHdmi.sending_dvi = !hdmiSink;
 
 	const hdmi_mode& mode = sHdmi.mode;
 	status = set_pll_d(mode.pixel_clock);
@@ -1495,6 +1506,7 @@ hot_plug_thread(void*)
 			plugged = now;
 			stable = 0;
 			MutexLocker locker(sHdmi.lock);
+			sHdmi.plugged = plugged;
 			if (plugged)
 				connect();
 			else
@@ -1626,6 +1638,45 @@ hdmi_set_overlay(const hdmi_overlay& overlay)
 }
 
 
+void
+hdmi_get_status(tegra_dc_hdmi_status& status)
+{
+	memset(&status, 0, sizeof(status));
+	// thread ids are positive; before hdmi_start() it is 0
+	if (sHdmi.thread <= 0)
+		return;
+
+	MutexLocker locker(sHdmi.lock);
+	status.plugged = sHdmi.plugged;
+	status.active = sHdmi.active;
+	status.has_edid = sHdmi.has_edid;
+	status.hdmi_sink = sHdmi.hdmi_sink;
+	status.dvi = sHdmi.sending_dvi;
+	strlcpy(status.screen_name, sHdmi.screen_name,
+		sizeof(status.screen_name));
+	if (sHdmi.active) {
+		status.width = sHdmi.mode.h_display;
+		status.height = sHdmi.mode.v_display;
+		status.pixel_clock = sHdmi.mode.pixel_clock;
+		status.h_total = sHdmi.mode.h_total;
+		status.v_total = sHdmi.mode.v_total;
+	}
+}
+
+
+void
+hdmi_reconnect()
+{
+	if (sHdmi.thread <= 0)
+		return;
+
+	MutexLocker locker(sHdmi.lock);
+	disconnect();
+	if (sHdmi.plugged)
+		connect();
+}
+
+
 void
 hdmi_set_cursor(bool visible, uint32 physical, int32 x, int32 y,
 	uint32 width, uint32 height, uint32 skipX, uint32 skipY)
diff --git a/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.h b/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.h
index 1b4ae2865a..9c57009845 100644
--- a/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.h
+++ b/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.h
@@ -47,5 +47,10 @@ struct hdmi_overlay {
 
 void hdmi_set_overlay(const hdmi_overlay& overlay);
 
+struct tegra_dc_hdmi_status;
+void hdmi_get_status(tegra_dc_hdmi_status& status);
+// stops the output and starts it again with the driver settings
+void hdmi_reconnect();
+
 
 #endif	// TEGRA_DC_HDMI_H
diff --git a/src/add-ons/kernel/drivers/graphics/tegra_dc/tegra_dc.cpp b/src/add-ons/kernel/drivers/graphics/tegra_dc/tegra_dc.cpp
index 374a759e2d..4ae232715b 100644
--- a/src/add-ons/kernel/drivers/graphics/tegra_dc/tegra_dc.cpp
+++ b/src/add-ons/kernel/drivers/graphics/tegra_dc/tegra_dc.cpp
@@ -1266,6 +1266,19 @@ tegra_dc_ioctl(void* cookie, uint32 op, void* buffer, size_t length)
 			return configure_overlay(config);
 		}
 
+		case TEGRA_DC_GET_HDMI_STATUS:
+		{
+			tegra_dc_hdmi_status status;
+			hdmi_get_status(status);
+			if (length < sizeof(status))
+				return B_BAD_VALUE;
+			return user_memcpy(buffer, &status, sizeof(status));
+		}
+
+		case TEGRA_DC_RECONNECT_HDMI:
+			hdmi_reconnect();
+			return B_OK;
+
 		case TEGRA_DC_SET_DISPLAY_MODE:
 		{
 			display_mode mode;
