From 9f78ea3f08aea87637edd53dd90e72f6007c73ea Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 16:38:25 +0200
Subject: [PATCH 019/270] ARM bring-up: show the first panic message on screen
 and halt (not for merging)

---
 .../private/kernel/arch/arm/arm_boot_marker.h |  1 +
 src/system/kernel/arch/arm/arch_cpu.cpp       | 45 +++++++++++++++++++
 src/system/kernel/debug/debug.cpp             | 26 ++++++++++-
 3 files changed, 70 insertions(+), 2 deletions(-)

diff --git a/headers/private/kernel/arch/arm/arm_boot_marker.h b/headers/private/kernel/arch/arm/arm_boot_marker.h
index e883b7a0f5..620e1dde6a 100644
--- a/headers/private/kernel/arch/arm/arm_boot_marker.h
+++ b/headers/private/kernel/arch/arm/arm_boot_marker.h
@@ -123,6 +123,7 @@ arm_boot_marker_draw_value(uint8* frameBuffer, uint32 bytesPerRow,
 #ifdef _KERNEL_MODE
 void arm_boot_marker(int index);
 void arm_boot_marker_value(int row, uint32 value);
+void arm_boot_marker_text(const char* text);
 #endif
 
 
diff --git a/src/system/kernel/arch/arm/arch_cpu.cpp b/src/system/kernel/arch/arm/arch_cpu.cpp
index d3ae5f9347..02537653d3 100644
--- a/src/system/kernel/arch/arm/arch_cpu.cpp
+++ b/src/system/kernel/arch/arm/arch_cpu.cpp
@@ -15,6 +15,7 @@
 #include <arch/cpu.h>
 #include <boot/kernel_args.h>
 #include <arch/arm/arm_boot_marker.h>
+#include "../../debug/font.h"
 
 
 bool gARMHasVFPD32 = true;
@@ -41,6 +42,50 @@ arm_boot_marker_value(int row, uint32 value)
 }
 
 
+/*!	Writes \a text in the lower part of the screen, white on black, wrapping
+	at the screen edge. Uses the kernel debug console's small font.
+*/
+void
+arm_boot_marker_text(const char* text)
+{
+	if (sBootMarkerFrameBuffer == NULL)
+		return;
+
+	const FramebufferFont& font = bigFont;
+	const int kTop = 440;
+	const int kColumns = (sBootMarkerBytesPerRow * 8 / sBootMarkerDepth)
+		/ font.glyphWidth - 1;
+	int column = 0;
+	int line = 0;
+
+	for (const char* c = text; *c != '\0' && line < 8; c++) {
+		if (*c == '\n' || column >= kColumns) {
+			column = 0;
+			line++;
+			if (*c == '\n')
+				continue;
+		}
+		uint8 glyph = (uint8)*c < 128 ? (uint8)*c : '?';
+		for (int y = 0; y < font.glyphHeight; y++) {
+			uint16 bits = font.glyphWidth > 8
+				? ((const uint16*)font.data)[font.glyphHeight * glyph + y]
+				: font.data[font.glyphHeight * glyph + y];
+			uint8* row = sBootMarkerFrameBuffer + (kTop + line * font.glyphHeight
+				+ y) * sBootMarkerBytesPerRow;
+			for (int x = 0; x < font.glyphWidth; x++, bits >>= 1) {
+				int pixelX = 8 + (column * font.glyphWidth) + x;
+				bool set = (bits & 1) != 0;
+				if (sBootMarkerDepth == 32)
+					((volatile uint32*)row)[pixelX] = set ? 0xffffff : 0;
+				else if (sBootMarkerDepth == 16)
+					((volatile uint16*)row)[pixelX] = set ? 0xffff : 0;
+			}
+		}
+		column++;
+	}
+}
+
+
 status_t
 arch_cpu_preboot_init_percpu(kernel_args *args, int curr_cpu)
 {
diff --git a/src/system/kernel/debug/debug.cpp b/src/system/kernel/debug/debug.cpp
index 77431959f1..46f34b85c3 100644
--- a/src/system/kernel/debug/debug.cpp
+++ b/src/system/kernel/debug/debug.cpp
@@ -2132,8 +2132,30 @@ void
 panic(const char* format, ...)
 {
 #ifdef __ARM__
-	arm_boot_marker(34);
-	arm_boot_marker_value(3, (uint32)(addr_t)__builtin_return_address(0));
+	{
+		// bring-up aid: show the first panic on screen and stop there, as
+		// the kernel debugger may not survive this early
+		static bool sPanicShown = false;
+		if (!sPanicShown) {
+			sPanicShown = true;
+			arm_boot_marker(34);
+			arm_boot_marker_value(3,
+				(uint32)(addr_t)__builtin_return_address(0));
+
+			static char sPanicText[512];
+			strlcpy(sPanicText, "PANIC: ", sizeof(sPanicText));
+			va_list markerArgs;
+			va_start(markerArgs, format);
+			vsnprintf(sPanicText + 7, sizeof(sPanicText) - 7, format,
+				markerArgs);
+			va_end(markerArgs);
+			arm_boot_marker_text(sPanicText);
+
+			disable_interrupts();
+			while (true)
+				;
+		}
+	}
 #endif
 	va_list args;
 	va_start(args, format);
