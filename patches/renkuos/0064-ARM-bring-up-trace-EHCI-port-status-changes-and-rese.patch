From 4dcf46996585210f9b39b61bb6b4858ac106a24b Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 23:41:39 +0200
Subject: [PATCH 064/270] ARM bring-up: trace EHCI port status changes and
 resets (not for merging)

---
 src/add-ons/kernel/busses/usb/ehci.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/add-ons/kernel/busses/usb/ehci.cpp b/src/add-ons/kernel/busses/usb/ehci.cpp
index 7a5617c327..5542816f79 100644
--- a/src/add-ons/kernel/busses/usb/ehci.cpp
+++ b/src/add-ons/kernel/busses/usb/ehci.cpp
@@ -1310,6 +1310,8 @@ EHCI::Start()
 {
 	TRACE("starting EHCI host controller\n");
 	dprintf("AC100: ehci %p Start(), reading USBCMD\n", fOperationalRegisters);
+	dprintf("AC100: ehci %p HCSPARAMS %#" B_PRIx32 ", %u ports\n",
+		fOperationalRegisters, ReadCapReg32(EHCI_HCSPARAMS), fPortCount);
 	dprintf("AC100: ehci %p start, USBCMD %#" B_PRIx32 ", USBSTS %#" B_PRIx32
 		"\n", fOperationalRegisters, ReadOpReg(EHCI_USBCMD),
 		ReadOpReg(EHCI_USBSTS));
@@ -1996,6 +1998,14 @@ EHCI::GetPortStatus(uint8 index, usb_port_status *status)
 	status->status = status->change = 0;
 	uint32 portStatus = ReadOpReg(EHCI_PORTSC + index * sizeof(uint32));
 
+	// bring-up aid: report every change of the port status
+	static uint32 sLastPortStatus[4] = { ~0U, ~0U, ~0U, ~0U };
+	if (index < 4 && portStatus != sLastPortStatus[index]) {
+		sLastPortStatus[index] = portStatus;
+		dprintf("AC100: ehci %p port %u of %u: PORTSC %#" B_PRIx32 "\n",
+			fOperationalRegisters, index, fPortCount, portStatus);
+	}
+
 	// build the status
 	if (portStatus & EHCI_PORTSC_CONNSTATUS)
 		status->status |= PORT_STATUS_CONNECTION;
@@ -2116,6 +2126,8 @@ EHCI::ResetPort(uint8 index)
 	TRACE("reset port %d\n", index);
 	uint32 portRegister = EHCI_PORTSC + index * sizeof(uint32);
 	uint32 portStatus = ReadOpReg(portRegister) & EHCI_PORTSC_DATAMASK;
+	dprintf("AC100: ehci %p resetting port %u, PORTSC %#" B_PRIx32 "\n",
+		fOperationalRegisters, index, ReadOpReg(portRegister));
 
 	if ((fFlags & kIntegratedTT) == 0 && (portStatus & EHCI_PORTSC_DMINUS)) {
 		TRACE_ALWAYS("lowspeed device connected, giving up port ownership\n");
