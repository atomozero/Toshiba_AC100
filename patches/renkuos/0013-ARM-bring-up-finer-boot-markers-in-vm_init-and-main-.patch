From c15c5f94231abbc47aecadc8dc9d73798bc6fb85 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 15:43:29 +0200
Subject: [PATCH 013/203] ARM bring-up: finer boot markers in vm_init and main
 (not for merging)

---
 src/system/kernel/main.cpp  | 11 +++++++++++
 src/system/kernel/vm/vm.cpp | 14 ++++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/src/system/kernel/main.cpp b/src/system/kernel/main.cpp
index d578bba3db..8fbc0accb3 100644
--- a/src/system/kernel/main.cpp
+++ b/src/system/kernel/main.cpp
@@ -61,6 +61,13 @@
 #include <vm/vm.h>
 #include <boot/kernel_args.h>
 
+#ifdef __ARM__
+#	include <arch/arm/arm_boot_marker.h>
+#	define MAIN_MARKER(x) arm_boot_marker(x)
+#else
+#	define MAIN_MARKER(x)
+#endif
+
 #include "vm/VMAnonymousCache.h"
 
 
@@ -147,11 +154,15 @@ _start(kernel_args *bootKernelArgs, int currentCPU)
 
 		TRACE("init VM\n");
 		vm_init(&sKernelArgs);
+		MAIN_MARKER(27);
 			// Before vm_init_post_sem() is called, we have to make sure that
 			// the boot loader allocated region is not used anymore
 		boot_item_init();
+		MAIN_MARKER(28);
 		debug_init_post_vm(&sKernelArgs);
+		MAIN_MARKER(29);
 		low_resource_manager_init();
+		MAIN_MARKER(30);
 
 		// now we can use the heap and create areas
 		arch_platform_init_post_vm(&sKernelArgs);
diff --git a/src/system/kernel/vm/vm.cpp b/src/system/kernel/vm/vm.cpp
index b9bfb0c44a..ff10ef1c53 100644
--- a/src/system/kernel/vm/vm.cpp
+++ b/src/system/kernel/vm/vm.cpp
@@ -10,6 +10,13 @@
 
 #include <vm/vm.h>
 
+#ifdef __ARM__
+#	include <arch/arm/arm_boot_marker.h>
+#	define VM_MARKER(x) arm_boot_marker(x)
+#else
+#	define VM_MARKER(x)
+#endif
+
 #include <ctype.h>
 #include <stdlib.h>
 #include <stdio.h>
@@ -3605,10 +3612,14 @@ vm_init(kernel_args* args)
 	// need now
 	arch_vm_translation_map_init_post_area(args);
 	arch_vm_init_post_area(args);
+	VM_MARKER(20);
 	vm_page_init_post_area(args);
+	VM_MARKER(21);
 	slab_init_post_area();
+	VM_MARKER(22);
 
 	vm_kernel_args_init_post_area(args);
+	VM_MARKER(23);
 
 	void* lastPage = (void*)ROUNDDOWN(~(addr_t)0, B_PAGE_SIZE);
 	vm_block_address_range("overflow protection", lastPage, B_PAGE_SIZE);
@@ -3645,9 +3656,12 @@ vm_init(kernel_args* args)
 #endif
 #endif
 
+	VM_MARKER(24);
 	create_page_mappings_object_caches();
+	VM_MARKER(25);
 
 	vm_debug_init();
+	VM_MARKER(26);
 
 	TRACE(("vm_init: exit\n"));
 
