From b66d0c1a7e3fdefa40b9672f19be05ca53bf2636 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 12:13:20 +0200
Subject: [PATCH 006/270] kernel/arm: fix commpage accesses when entering
 userland and on signals

- arch_thread_enter_userspace() read the thread exit stub address from
  the commpage after disabling interrupts. The commpage is user memory,
  and a page fault there could not be handled ('page fault, but
  interrupts were disabled'). Read it before disabling interrupts.
- arch_setup_signal_frame() did its user_memcpy() inside ASSERT(), so
  without KDEBUG the signal handler address was never read. Do the copy
  unconditionally and propagate errors.
---
 src/system/kernel/arch/arm/arch_thread.cpp | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/src/system/kernel/arch/arm/arch_thread.cpp b/src/system/kernel/arch/arm/arch_thread.cpp
index 4a3a01f1cb..63cd486db3 100644
--- a/src/system/kernel/arch/arm/arch_thread.cpp
+++ b/src/system/kernel/arch/arm/arch_thread.cpp
@@ -191,7 +191,12 @@ arch_thread_enter_userspace(Thread *thread, addr_t entry,
 	// Copy the address of the stub that calls exit_thread() when the thread
 	// entry function returns to LR to act as the return address.
 	// The stub is inside commpage.
+	// The commpage is user memory: read it while page faults can still be
+	// handled, i.e. before disabling interrupts.
 	addr_t commPageAddress = (addr_t)thread->team->commpage_address;
+	addr_t threadExitAddress
+		= ((addr_t*)commPageAddress)[COMMPAGE_ENTRY_ARM_THREAD_EXIT]
+			+ commPageAddress;
 
 	disable_interrupts();
 
@@ -200,8 +205,7 @@ arch_thread_enter_userspace(Thread *thread, addr_t entry,
 	frame.r0 = (uint32)args1;
 	frame.r1 = (uint32)args2;
 	frame.usr_sp = stackTop;
-	frame.usr_lr = ((addr_t*)commPageAddress)[COMMPAGE_ENTRY_ARM_THREAD_EXIT]
-		+ commPageAddress;
+	frame.usr_lr = threadExitAddress;
 	frame.pc = entry;
 
 	// return to userland
@@ -293,9 +297,11 @@ arch_setup_signal_frame(Thread *thread, struct sigaction *sa,
 	// prepare the user stack frame for a function call to the signal handler wrapper function
 	addr_t commpageAddr = (addr_t)thread->team->commpage_address;
 	addr_t signalHandlerAddr;
-	ASSERT(user_memcpy(&signalHandlerAddr,
+	res = user_memcpy(&signalHandlerAddr,
 		&((addr_t*)commpageAddr)[COMMPAGE_ENTRY_ARM_SIGNAL_HANDLER],
-		sizeof(signalHandlerAddr)) >= B_OK);
+		sizeof(signalHandlerAddr));
+	if (res < B_OK)
+		return res;
 	signalHandlerAddr += commpageAddr;
 
 	frame->usr_lr = frame->pc;
