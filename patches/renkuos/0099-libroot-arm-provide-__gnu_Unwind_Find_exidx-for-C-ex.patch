From ce6266fd350db146b63fa72105a9aff92524baa2 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 16:21:11 +0200
Subject: [PATCH 099/270] libroot/arm: provide __gnu_Unwind_Find_exidx() for
 C++ exceptions

The ARM EHABI unwinder of libgcc looks up the exception index table of the
code it unwinds through this function, which the C library provides on
other systems. Without it libgcc only knew its own table, so every C++
exception ended in std::terminate() (Terminal on closing, the registrar on
shutdown). Find the image containing the address and return its
PT_ARM_EXIDX segment.
---
 src/system/libroot/os/arch/arm/Jamfile        |  1 +
 .../libroot/os/arch/arm/unwind_exidx.cpp      | 64 +++++++++++++++++++
 2 files changed, 65 insertions(+)
 create mode 100644 src/system/libroot/os/arch/arm/unwind_exidx.cpp

diff --git a/src/system/libroot/os/arch/arm/Jamfile b/src/system/libroot/os/arch/arm/Jamfile
index 0ff35404c2..624868c14f 100644
--- a/src/system/libroot/os/arch/arm/Jamfile
+++ b/src/system/libroot/os/arch/arm/Jamfile
@@ -20,6 +20,7 @@ for architectureObject in [ MultiArchSubDirSetup arm ] {
 			thread.c
 			time.c
 			tls.c
+			unwind_exidx.cpp
 
 			generic_atomic.cpp
 			generic_stack_trace.cpp
diff --git a/src/system/libroot/os/arch/arm/unwind_exidx.cpp b/src/system/libroot/os/arch/arm/unwind_exidx.cpp
new file mode 100644
index 0000000000..66a1d106d0
--- /dev/null
+++ b/src/system/libroot/os/arch/arm/unwind_exidx.cpp
@@ -0,0 +1,64 @@
+/*
+ * Copyright 2026, Haiku, Inc.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include <elf.h>
+#include <image.h>
+#include <stdint.h>
+
+
+#ifndef PT_ARM_EXIDX
+#	define PT_ARM_EXIDX 0x70000001
+#endif
+
+
+/*!	Called by the ARM EHABI unwinder of libgcc to find the exception index
+	table (.ARM.exidx) covering \a pc. Without it libgcc only knows its own
+	table, and every C++ exception ends in std::terminate().
+	Sets \a _count to the number of 8 byte entries.
+*/
+extern "C" uintptr_t
+__gnu_Unwind_Find_exidx(uintptr_t pc, int* _count)
+{
+	image_info info;
+	int32 cookie = 0;
+	while (get_next_image_info(B_CURRENT_TEAM, &cookie, &info) == B_OK) {
+		uintptr_t text = (uintptr_t)info.text;
+		if (pc < text || pc - text >= (uintptr_t)info.text_size)
+			continue;
+
+		// the first segment starts with the ELF header and the program
+		// headers
+		const Elf32_Ehdr* header = (const Elf32_Ehdr*)text;
+		if (header->e_ident[EI_MAG0] != ELFMAG0
+			|| header->e_ident[EI_MAG1] != ELFMAG1
+			|| header->e_ident[EI_MAG2] != ELFMAG2
+			|| header->e_ident[EI_MAG3] != ELFMAG3) {
+			return 0;
+		}
+
+		const Elf32_Phdr* programHeaders
+			= (const Elf32_Phdr*)(text + header->e_phoff);
+		uintptr_t delta = 0;
+		bool foundLoad = false;
+		for (int i = 0; i < header->e_phnum; i++) {
+			if (programHeaders[i].p_type == PT_LOAD && !foundLoad) {
+				// the load address of the first segment
+				delta = text - (programHeaders[i].p_vaddr
+					& ~(uintptr_t)(B_PAGE_SIZE - 1));
+				foundLoad = true;
+			}
+		}
+		for (int i = 0; i < header->e_phnum; i++) {
+			if (programHeaders[i].p_type == PT_ARM_EXIDX) {
+				*_count = programHeaders[i].p_memsz / 8;
+				return programHeaders[i].p_vaddr + delta;
+			}
+		}
+		return 0;
+	}
+
+	return 0;
+}
