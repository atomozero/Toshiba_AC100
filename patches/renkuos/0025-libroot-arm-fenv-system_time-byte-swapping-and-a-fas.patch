+/*
+ * Copyright 2026, Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT license.
+ */
+
+
+#include <string.h>
+
+
+/* ARM EABI run-time helpers, emitted by some compilers instead of memcpy() */
+
+void
+__aeabi_memcpy(void* dest, const void* source, size_t count)
+{
+	memcpy(dest, source, count);
+}
+
+
+void
+__aeabi_memcpy4(void* dest, const void* source, size_t count)
+{
+	memcpy(dest, source, count);
+}
+
+
+void
+__aeabi_memcpy8(void* dest, const void* source, size_t count)
+{
+	memcpy(dest, source, count);
+}
diff --git a/src/system/libroot/posix/string/arch/arm/arch_memcpy.S b/src/system/libroot/posix/string/arch/arm/arch_memcpy.S
new file mode 100644
index 0000000000..84cd8d2cb4
--- /dev/null
+++ b/src/system/libroot/posix/string/arch/arm/arch_memcpy.S
@@ -0,0 +1,163 @@
+/*
+ * Copyright 2026, Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include <asm_defs.h>
+
+
+/*	ARMv7 memcpy() and memset(): 32 bytes at a time with load and store
+	multiple, then words, then bytes. In userland a copy between differently
+	aligned buffers uses unaligned word loads, which ARMv7 does on normal
+	memory; the kernel may copy from or to device memory, where they fault, so
+	it copies those byte by byte.
+*/
+
+.syntax unified
+.arm
+
+
+/* void* memcpy(void* dest, const void* source, size_t count) */
+FUNCTION(memcpy):
+	push	{r0, r4-r9, lr}
+	cmp		r2, #16
+	blo		.Lcopy_bytes
+
+	eor		r3, r0, r1
+	tst		r3, #3
+#ifdef _KERNEL_MODE
+	bne		.Lcopy_bytes
+#endif
+
+	/* align the destination */
+1:	tst		r0, #3
+	beq		2f
+	ldrb	r3, [r1], #1
+	strb	r3, [r0], #1
+	sub		r2, r2, #1
+	b		1b
+
+2:
+#ifndef _KERNEL_MODE
+	/* the source may still be misaligned: merge aligned words then */
+	ands	r3, r1, #3
+	bne		.Lcopy_shifted
+#endif
+	subs	r2, r2, #32
+	blo		4f
+3:	pld		[r1, #64]
+	ldmia	r1!, {r3-r9, r12}
+	stmia	r0!, {r3-r9, r12}
+	subs	r2, r2, #32
+	bhs		3b
+4:	add		r2, r2, #32
+
+.Lcopy_words:
+	subs	r2, r2, #4
+	blo		5f
+	ldr		r3, [r1], #4
+	str		r3, [r0], #4
+	b		.Lcopy_words
+5:	add		r2, r2, #4
+
+.Lcopy_bytes:
+	cmp		r2, #0
+	beq		7f
+6:	ldrb	r3, [r1], #1
+	strb	r3, [r0], #1
+	subs	r2, r2, #1
+	bne		6b
+7:	pop		{r0, r4-r9, pc}
+
+#ifndef _KERNEL_MODE
+/*	The destination is word aligned, the source is \offset bytes past a word
+	boundary: read whole aligned words and merge each two neighbours into one
+	destination word, 16 bytes per round. Reads never go past the word that
+	holds the last byte to copy. Unaligned single word loads did the same at
+	a third of the speed.
+*/
+.macro COPY_SHIFTED offset
+	bic		r1, r1, #3
+	ldr		r9, [r1], #4
+1:	ldmia	r1!, {r4-r7}
+	mov		r3, r9, lsr #(8 * \offset)
+	orr		r3, r3, r4, lsl #(32 - 8 * \offset)
+	mov		r4, r4, lsr #(8 * \offset)
+	orr		r4, r4, r5, lsl #(32 - 8 * \offset)
+	mov		r5, r5, lsr #(8 * \offset)
+	orr		r5, r5, r6, lsl #(32 - 8 * \offset)
+	mov		r6, r6, lsr #(8 * \offset)
+	orr		r6, r6, r7, lsl #(32 - 8 * \offset)
+	mov		r9, r7
+	stmia	r0!, {r3-r6}
+	subs	r2, r2, #16
+	bhs		1b
+	/* back to the real source position for the rest */
+	sub		r1, r1, #(4 - \offset)
+	b		8f
+.endm
+
+.Lcopy_shifted:
+	/* r3 = source offset in its word; at least 16 bytes per round */
+	subs	r2, r2, #16
+	blo		8f
+	pld		[r1, #64]
+	cmp		r3, #2
+	beq		.Lshift2
+	bhi		.Lshift3
+	COPY_SHIFTED 1
+.Lshift2:
+	COPY_SHIFTED 2
+.Lshift3:
+	COPY_SHIFTED 3
+8:	add		r2, r2, #16
+	b		.Lcopy_words
+#endif
+FUNCTION_END(memcpy)
+
+
+/* void* memset(void* dest, int value, size_t count) */
+FUNCTION(memset):
+	push	{r0, r4-r9, lr}
+	and		r1, r1, #0xff
+	orr		r1, r1, r1, lsl #8
+	orr		r1, r1, r1, lsl #16
+	cmp		r2, #16
+	blo		.Lset_bytes
+
+	/* align the destination */
+1:	tst		r0, #3
+	beq		2f
+	strb	r1, [r0], #1
+	sub		r2, r2, #1
+	b		1b
+
+2:	mov		r3, r1
+	mov		r4, r1
+	mov		r5, r1
+	mov		r6, r1
+	mov		r7, r1
+	mov		r8, r1
+	mov		r12, r1
+	subs	r2, r2, #32
+	blo		4f
+3:	stmia	r0!, {r1, r3-r8, r12}
+	subs	r2, r2, #32
+	bhs		3b
+4:	add		r2, r2, #32
+
+5:	subs	r2, r2, #4
+	blo		6f
+	str		r1, [r0], #4
+	b		5b
+6:	add		r2, r2, #4
+
+.Lset_bytes:
+	cmp		r2, #0
+	beq		8f
+7:	strb	r1, [r0], #1
+	subs	r2, r2, #1
+	bne		7b
+8:	pop		{r0, r4-r9, pc}
+FUNCTION_END(memset)
