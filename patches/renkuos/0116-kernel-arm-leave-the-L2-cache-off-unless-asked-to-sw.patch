From a5c41af6b9dfa1c79b1900108aa2e7604480553d Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 21:08:46 +0200
Subject: [PATCH 116/270] kernel/arm: leave the L2 cache off unless asked to
 switch it on

On the Toshiba AC100 the system hung after switching it on (it booted once,
then the next boots hung, which also points at corrupted data written
meanwhile). Until that is understood, only switch it on with
"arm_l2_cache true" in the kernel settings, and without prefetching, which
has errata on early PL310 revisions. Log the cache id.
---
 src/system/kernel/arch/arm/arch_l2_cache.cpp | 23 +++++++++++---------
 1 file changed, 13 insertions(+), 10 deletions(-)

diff --git a/src/system/kernel/arch/arm/arch_l2_cache.cpp b/src/system/kernel/arch/arm/arch_l2_cache.cpp
index e34dc76fa4..b564488f87 100644
--- a/src/system/kernel/arch/arm/arch_l2_cache.cpp
+++ b/src/system/kernel/arch/arm/arch_l2_cache.cpp
@@ -5,8 +5,9 @@
 
 
 /*!	The PL310 (L2C-310) outer cache of Cortex-A9 systems, e.g. 1 MB on the
-	NVIDIA Tegra 2. Firmwares may leave it off; it is switched on here, unless
-	the kernel settings say "arm_l2_cache false".
+	NVIDIA Tegra 2. Firmwares may leave it off. It is only switched on when
+	the kernel settings say "arm_l2_cache true": on the Toshiba AC100 the
+	system hung after doing so (not understood yet).
 
 	The CP15 cache maintenance operations stop at the outer cache: memory
 	shared with a DMA engine must also be handled here, by physical address.
@@ -66,7 +67,7 @@ arm_l2_cache_init(kernel_args* args)
 		return B_OK;
 
 	void* settings = load_driver_settings("kernel");
-	bool enable = get_driver_boolean_parameter(settings, "arm_l2_cache", true,
+	bool enable = get_driver_boolean_parameter(settings, "arm_l2_cache", false,
 		true);
 	unload_driver_settings(settings);
 
@@ -84,17 +85,17 @@ arm_l2_cache_init(kernel_args* args)
 		return B_OK;
 	}
 	if (!enable) {
-		dprintf("L2 cache: left off by the kernel settings\n");
+		dprintf("L2 cache: left off (\"arm_l2_cache true\" switches it on)\n");
 		delete_area(area);
 		return B_OK;
 	}
 
 	// the latencies and the auxiliary control may only be set while it is off;
 	// all memory is shareable (for SMP), which older revisions would not cache
-	// without the override; prefetching as Linux does on Tegra 2
-	write_reg(l2, L2X0_AUX_CTRL, read_reg(l2, L2X0_AUX_CTRL)
-		| L2X0_AUX_SHARED_OVERRIDE | L2X0_AUX_INSTRUCTION_PREFETCH
-		| L2X0_AUX_DATA_PREFETCH);
+	// without the override; no prefetching (errata on early revisions)
+	write_reg(l2, L2X0_AUX_CTRL, (read_reg(l2, L2X0_AUX_CTRL)
+		| L2X0_AUX_SHARED_OVERRIDE)
+		& ~(L2X0_AUX_INSTRUCTION_PREFETCH | L2X0_AUX_DATA_PREFETCH));
 	if (args->arch_args.l2TagLatency != 0)
 		write_reg(l2, L2X0_TAG_LATENCY, args->arch_args.l2TagLatency);
 	if (args->arch_args.l2DataLatency != 0)
@@ -114,8 +115,10 @@ arm_l2_cache_init(kernel_args* args)
 	asm volatile("dsb" : : : "memory");
 	sL2 = l2;
 
-	dprintf("L2 cache: on, %" B_PRIu32 " ways, aux %#" B_PRIx32 ", latencies "
-		"%#" B_PRIx32 "/%#" B_PRIx32 "\n", ways, read_reg(l2, L2X0_AUX_CTRL),
+	dprintf("L2 cache: on (cache id %#" B_PRIx32 "), %" B_PRIu32 " ways, aux %#"
+		B_PRIx32 ", latencies "
+		"%#" B_PRIx32 "/%#" B_PRIx32 "\n", read_reg(l2, 0), ways,
+		read_reg(l2, L2X0_AUX_CTRL),
 		read_reg(l2, L2X0_TAG_LATENCY), read_reg(l2, L2X0_DATA_LATENCY));
 	return B_OK;
 }
