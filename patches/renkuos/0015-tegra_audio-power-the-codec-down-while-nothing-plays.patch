From cce58a4e33a1556826e81eab3cabed5bb5a09d5f Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Thu, 19 Nov 2026 22:51:23 +0100
Subject: [PATCH 15/32] tegra_audio: power the codec down while nothing plays

While the stream is stopped, as when the sound goes to Bluetooth
speakers, the ALC5632 amplifiers, mixers and converters stayed powered:
about 65 mW. They are now powered down when the stream stops and after
the driver set the codec up, and powered up again with the depop
sequence of codec_init() when it starts; the input is set again, as it
may have changed meanwhile.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../drivers/audio/tegra/tegra_audio.cpp       | 63 +++++++++++++++++++
 1 file changed, 63 insertions(+)

diff --git a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
index 071cff51e7..a6650c9b4a 100644
--- a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
+++ b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
@@ -264,6 +264,8 @@ struct tegra_audio {
 	mutex					lock;
 	bool					opened;
 	bool					running;
+	bool					codecAsleep;	// powered down while stopped
+	uint16					codecPower[3];	// its power registers then
 	bool					interruptInstalled;
 
 	area_id					bufferArea;
@@ -945,12 +947,64 @@ start_spdif_dma(tegra_audio* audio)
 }
 
 
+/*!	While nothing plays through the internal output (the stream is stopped,
+	as when the sound goes to Bluetooth speakers), the codec's amplifiers,
+	mixers and converters are powered down: about 65 mW. Called with the
+	lock held.
+*/
+static void
+codec_sleep(tegra_audio* audio)
+{
+	if (audio->codecAsleep)
+		return;
+
+	static const uint8 kPower[] = { ALC5632_PWR_MANAG_ADD1,
+		ALC5632_PWR_MANAG_ADD2, ALC5632_PWR_MANAG_ADD3 };
+	for (uint32 i = 0; i < B_COUNT_OF(kPower); i++) {
+		if (codec_read(audio, kPower[i], &audio->codecPower[i]) != B_OK)
+			return;
+	}
+	// the outputs first, the references last
+	codec_write(audio, ALC5632_PWR_MANAG_ADD3, 0);
+	codec_write(audio, ALC5632_PWR_MANAG_ADD2, 0);
+	codec_write(audio, ALC5632_PWR_MANAG_ADD1, 0);
+	audio->codecAsleep = true;
+}
+
+
+/*!	Powers the codec up again as codec_init() does, with the depop sequence
+	of the headphone amplifiers, then as it was. Called with the lock held.
+*/
+static void
+codec_wake(tegra_audio* audio)
+{
+	if (!audio->codecAsleep)
+		return;
+
+	codec_update(audio, ALC5632_PWR_MANAG_ADD1, 1U << 6, 1U << 6);
+	codec_update(audio, ALC5632_PWR_MANAG_ADD3, 1U << 1, 1U << 1);
+	codec_update(audio, ALC5632_MISC_CTRL, 1U << 8, 1U << 8);
+	snooze(100000);
+	codec_update(audio, ALC5632_PWR_MANAG_ADD2, 1U << 13, 1U << 13);
+	codec_write(audio, ALC5632_PWR_MANAG_ADD1, audio->codecPower[0]);
+	codec_write(audio, ALC5632_PWR_MANAG_ADD2, audio->codecPower[1]);
+	codec_write(audio, ALC5632_PWR_MANAG_ADD3, audio->codecPower[2]);
+	codec_update(audio, ALC5632_MISC_CTRL, 1U << 8, 0);
+	audio->codecAsleep = false;
+
+	// the input may have been changed meanwhile
+	set_input(audio);
+}
+
+
 static void
 start_playback(tegra_audio* audio)
 {
 	if (audio->running)
 		return;
 
+	codec_wake(audio);
+
 	audio->playing = 0;
 	audio->i2sBuffersDone = 0;
 	audio->framesPlayed = 0;
@@ -1046,6 +1100,8 @@ stop_playback(tegra_audio* audio)
 			read32(audio->spdifChannel, DMA_STATUS));
 	}
 	audio->running = false;
+
+	codec_sleep(audio);
 }
 
 
@@ -2221,6 +2277,13 @@ tegra_audio_init_driver(device_node* node, void** _cookie)
 		self_test(audio);
 	start_jack_detection(audio);
 
+	{
+		// until something plays
+		MutexLocker locker(audio->lock);
+		if (!audio->running)
+			codec_sleep(audio);
+	}
+
 	*_cookie = audio;
 	return B_OK;
 }
