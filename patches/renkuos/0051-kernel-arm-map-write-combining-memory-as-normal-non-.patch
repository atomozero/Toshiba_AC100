From d475225f8f3e2305924f942993c09e4ca6eac1bf Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 22:35:39 +0200
Subject: [PATCH 051/270] kernel/arm: map write combining memory as normal
 non-cacheable

B_WRITE_COMBINING_MEMORY was mapped as shareable device memory, which
forbids unaligned accesses and is slow for buffers. Map it as normal,
inner and outer non-cacheable memory (TEX remap type 4, set up so by the
boot loader), like Linux does for write combining mappings on ARMv7.
---
 .../kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.h       | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.h b/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.h
index 49986e9014..3a3b1c3463 100644
--- a/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.h
+++ b/src/system/kernel/arch/arm/paging/32bit/ARMPagingMethod32Bit.h
@@ -251,8 +251,8 @@ ARMPagingMethod32Bit::MemoryTypeToPageTableEntryFlags(uint32 memoryType)
 			// Strongly Ordered
 			return 0;
 		case B_WRITE_COMBINING_MEMORY:
-			// Shareable Device Memory
-			return ARM_MMU_L2_FLAG_B;
+			// Normal, Inner/Outer Non-cacheable (TEX remap type 4)
+			return ARM_MMU_L2_FLAG_TEX0;
 		case B_WRITE_THROUGH_MEMORY:
 			// Outer and Inner Write-Through, no Write-Allocate
 			return ARM_MMU_L2_FLAG_C;
