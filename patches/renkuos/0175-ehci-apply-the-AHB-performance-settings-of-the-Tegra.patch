From 98510b6443d63864950831794e1aae7d709a2b28 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 20 Oct 2026 21:51:04 +0200
Subject: [PATCH 175/203] ehci: apply the AHB performance settings of the Tegra
 2 TRM

The Tegra 2 TRM (26.3.6, "Performance Settings for USB Controllers")
asks for these before a USB controller runs: bursts of 8 words, fast
re-arbitration on the memory gizmo, IMMEDIATE on the controller's gizmo,
the controller as a high priority AHB master with weight 7 and a
prefetch channel for it.

Without them, on the Toshiba AC100 the interrupt transfers of low speed
devices behind a hub failed with transaction errors in their complete
splits once the APB DMA of the audio driver was running.
---
 src/add-ons/kernel/busses/usb/ehci.cpp        | 68 +++++++++++++++++++
 src/add-ons/kernel/busses/usb/ehci_hardware.h |  1 +
 2 files changed, 69 insertions(+)

diff --git a/src/add-ons/kernel/busses/usb/ehci.cpp b/src/add-ons/kernel/busses/usb/ehci.cpp
index b33d8f959d..f096353d3b 100644
--- a/src/add-ons/kernel/busses/usb/ehci.cpp
+++ b/src/add-ons/kernel/busses/usb/ehci.cpp
@@ -57,6 +57,17 @@ typedef struct {
 
 
 #define TEGRA20_CAR_BASE				0x60006000
+#define TEGRA20_AHB_BASE				0x6000c000
+#define AHB_ARBITRATION_PRIORITY_CTRL	0x004
+#define AHB_PRIORITY_WEIGHT(x)			((uint32)(x) << 29)
+#define AHB_GIZMO_AHB_MEM				0x00c
+#define AHB_GIZMO_ENB_FAST_REARBITRATE	(1 << 2)
+#define AHB_GIZMO_IMMEDIATE				(1 << 18)
+#define AHB_PREFETCH_ENABLE				(1U << 31)
+#define AHB_PREFETCH_MST_ID(x)			((uint32)(x) << 26)
+#define AHB_PREFETCH_MST_ID_MASK		(0x1fU << 26)
+#define AHB_PREFETCH_ADDR_BNDRY(x)		((uint32)(x) << 21)
+#define AHB_PREFETCH_INACTIVITY_TIMEOUT(x)	((uint32)(x) & 0xffff)
 #define TEGRA_CAR_RST_DEVICES(bank)		(0x04 + (bank) * 4)
 #define TEGRA_CAR_CLK_OUT_ENB(bank)		(0x10 + (bank) * 4)
 #define TEGRA_CAR_OSC_CTRL				0x50
@@ -126,6 +137,59 @@ tegra_set_bits(volatile uint32* reg, uint32 mask, uint32 value)
 }
 
 
+/*!	The AHB settings the Tegra 2 TRM asks for before a USB controller runs
+	(26.3.6 "Performance Settings for USB Controllers"): fast re-arbitration
+	on the memory port, IMMEDIATE on the controller's gizmo, the controller
+	as a high priority master with weight 7, and a prefetch channel for it.
+	Without them the controller can lose the bus to other masters for long
+	enough to miss split transaction slots.
+*/
+static void
+tegra20_usb_ahb_setup(phys_addr_t registers)
+{
+	// gizmo register, AHB master number, prefetch channel register
+	uint32 gizmo, master, prefetch;
+	switch (registers) {
+		case 0xc5000000:
+			gizmo = 0x01c; master = 6; prefetch = 0x0f0;	// USB1, CFG2
+			break;
+		case 0xc5004000:
+			gizmo = 0x078; master = 18; prefetch = 0x0e4;	// USB2, CFG4
+			break;
+		case 0xc5008000:
+			gizmo = 0x07c; master = 17; prefetch = 0x0e0;	// USB3, CFG3
+			break;
+		default:
+			return;
+	}
+
+	void* address;
+	area_id area = map_physical_memory("tegra ahb", TEGRA20_AHB_BASE,
+		B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+	if (area < B_OK)
+		return;
+#define AHB_REG(offset) ((volatile uint32*)((uint8*)address + (offset)))
+
+	tegra_set_bits(AHB_REG(AHB_GIZMO_AHB_MEM), AHB_GIZMO_ENB_FAST_REARBITRATE,
+		AHB_GIZMO_ENB_FAST_REARBITRATE);
+	tegra_set_bits(AHB_REG(gizmo), AHB_GIZMO_IMMEDIATE, AHB_GIZMO_IMMEDIATE);
+	tegra_set_bits(AHB_REG(AHB_ARBITRATION_PRIORITY_CTRL),
+		AHB_PRIORITY_WEIGHT(7) | (1U << master),
+		AHB_PRIORITY_WEIGHT(7) | (1U << master));
+	// 64 KB boundary, the inactivity timeout the TRM asks for
+	*AHB_REG(prefetch) = AHB_PREFETCH_ENABLE | AHB_PREFETCH_MST_ID(master)
+		| AHB_PREFETCH_ADDR_BNDRY(12) | AHB_PREFETCH_INACTIVITY_TIMEOUT(0x800);
+
+	dprintf("AC100: ehci %#" B_PRIxPHYSADDR " AHB: priority %#" B_PRIx32
+		", gizmo %#" B_PRIx32 ", memory gizmo %#" B_PRIx32 ", prefetch %#"
+		B_PRIx32 "\n", registers, *AHB_REG(AHB_ARBITRATION_PRIORITY_CTRL),
+		*AHB_REG(gizmo), *AHB_REG(AHB_GIZMO_AHB_MEM), *AHB_REG(prefetch));
+#undef AHB_REG
+	delete_area(area);
+}
+
+
 /*!	Brings the UTMI PHY of a Tegra 2 USB controller up, the way the boot
 	firmware and Linux do. The firmware may have used the controller, but left
 	it in a state where the PHY clock is not valid, and accessing the
@@ -263,6 +327,8 @@ tegra20_utmi_phy_init(fdt_device_module_info* fdt, fdt_device* fdtDevice,
 		TRACE_MODULE_ERROR("Tegra UTMI PHY clock did not become valid\n");
 		return B_TIMED_OUT;
 	}
+
+	tegra20_usb_ahb_setup(registers);
 	return B_OK;
 }
 
@@ -2231,6 +2297,8 @@ EHCI::ControllerReset()
 		// The reset also cleared the TX FIFO fill threshold, which Linux'
 		// ehci-tegra.c sets to 10 on Tegra 2
 		WriteOpReg(EHCI_TXFILLTUNING, 10 << EHCI_TXFILLTUNING_THRES_SHIFT);
+		// bursts of 8 words both ways, as the Tegra 2 TRM asks (26.3.6)
+		WriteOpReg(EHCI_BURSTSIZE, (8 << 8) | 8);
 	}
 
 	return B_OK;
diff --git a/src/add-ons/kernel/busses/usb/ehci_hardware.h b/src/add-ons/kernel/busses/usb/ehci_hardware.h
index aacb05ce7d..b576eed3a4 100644
--- a/src/add-ons/kernel/busses/usb/ehci_hardware.h
+++ b/src/add-ons/kernel/busses/usb/ehci_hardware.h
@@ -105,6 +105,7 @@
 #define EHCI_PORTSC_PSPD_FULL	0
 #define EHCI_PORTSC_PSPD_LOW	1
 #define EHCI_PORTSC_PSPD_HIGH	2
+#define EHCI_BURSTSIZE			0x20		// DMA burst sizes (TDI)
 #define EHCI_TXFILLTUNING		0x24		// TX FIFO fill tuning (TDI)
 #define EHCI_TXFILLTUNING_THRES_SHIFT	16
 #define EHCI_USBMODE			0x68		// USB Mode
