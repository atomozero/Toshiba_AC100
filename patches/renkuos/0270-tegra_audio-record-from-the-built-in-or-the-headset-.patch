 static int32
 dma_interrupt(void* data)
 {
@@ -791,8 +885,32 @@ start_playback(tegra_audio* audio)
 	if (audio->spdifEnabled)
 		start_spdif_dma(audio);
 
-	write32(audio->i2s, I2S_FIFO_SCR,
-		I2S_FIFO_SCR_ATN_FOUR_SLOTS | I2S_FIFO_SCR_FIFO1_CLR);
+	// recording, from the I2S1 receive FIFO into the record buffers
+	if (audio->recordInterruptInstalled) {
+		audio->recording = 0;
+		audio->framesRecorded = 0;
+		audio->recordTime = system_time();
+		write32(audio->dma, APBDMA_IRQ_MASK_SET, 1U << RECORD_DMA_CHANNEL);
+		volatile uint8* channel = audio->recordChannel;
+		uint32 recordCsr = DMA_CSR_FLOW | DMA_CSR_IE_EOC
+			| (I2S_DMA_REQUEST << DMA_CSR_REQ_SEL_SHIFT)
+			| ((audio->bufferFrames * FRAME_SIZE - 4) & 0xfffc);
+			// direction: from the device
+		write32(channel, DMA_CSR, recordCsr);
+		write32(channel, DMA_STATUS, read32(channel, DMA_STATUS));
+		write32(channel, DMA_APB_SEQ,
+			DMA_APB_SEQ_BUS_WIDTH_32 | DMA_APB_SEQ_WRAP_WORD_1);
+		write32(channel, DMA_APB_PTR, I2S1_BASE + I2S_FIFO2);
+		write32(channel, DMA_AHB_SEQ, DMA_AHB_SEQ_INTR_ENABLE
+			| DMA_AHB_SEQ_BUS_WIDTH_32 | DMA_AHB_SEQ_BURST_4);
+		write32(channel, DMA_AHB_PTR, record_physical(audio, 0));
+		write32(channel, DMA_CSR, recordCsr | DMA_CSR_ENABLE);
+		write32(channel, DMA_AHB_PTR,
+			record_physical(audio, 1 % audio->bufferCount));
+	}
+
+	write32(audio->i2s, I2S_FIFO_SCR, I2S_FIFO_SCR_ATN_FOUR_SLOTS
+		| I2S_FIFO_SCR_FIFO1_CLR | I2S_FIFO_SCR_FIFO2_CLR);
 	if (audio->spdifEnabled) {
 		// the DMA fills the S/PDIF FIFO first (TRM 27.3.3.7)
 		spin(20);
@@ -800,8 +918,9 @@ start_playback(tegra_audio* audio)
 		write32(audio->spdif, SPDIF_CTRL,
 			read32(audio->spdif, SPDIF_CTRL) | SPDIF_CTRL_TX_EN);
 	}
-	write32(audio->i2s, I2S_CTRL,
-		read32(audio->i2s, I2S_CTRL) | I2S_CTRL_FIFO1_ENABLE);
+	write32(audio->i2s, I2S_CTRL, read32(audio->i2s, I2S_CTRL)
+		| I2S_CTRL_FIFO1_ENABLE
+		| (audio->recordInterruptInstalled ? I2S_CTRL_FIFO2_ENABLE : 0));
 
 	audio->running = true;
 }
@@ -813,8 +932,15 @@ stop_playback(tegra_audio* audio)
 	if (!audio->running)
 		return;
 
-	write32(audio->i2s, I2S_CTRL,
-		read32(audio->i2s, I2S_CTRL) & ~I2S_CTRL_FIFO1_ENABLE);
+	write32(audio->i2s, I2S_CTRL, read32(audio->i2s, I2S_CTRL)
+		& ~(I2S_CTRL_FIFO1_ENABLE | I2S_CTRL_FIFO2_ENABLE));
+	if (audio->recordInterruptInstalled) {
+		write32(audio->recordChannel, DMA_CSR,
+			read32(audio->recordChannel, DMA_CSR)
+				& ~(DMA_CSR_ENABLE | DMA_CSR_IE_EOC));
+		write32(audio->recordChannel, DMA_STATUS,
+			read32(audio->recordChannel, DMA_STATUS));
+	}
 	write32(audio->channel, DMA_CSR, read32(audio->channel, DMA_CSR)
 		& ~(DMA_CSR_ENABLE | DMA_CSR_IE_EOC));
 	write32(audio->channel, DMA_STATUS, read32(audio->channel, DMA_STATUS));
@@ -841,7 +967,8 @@ create_buffers(tegra_audio* audio, uint32 frames, uint32 count)
 		audio->bufferArea = -1;
