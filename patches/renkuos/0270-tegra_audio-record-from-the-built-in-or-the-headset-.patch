From 8b83a683fa64cb7e83a1e682637c1f3c075a15b3 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 26 Oct 2026 23:06:16 +0100
Subject: [PATCH 270/270] tegra_audio: record from the built-in or the headset
 microphone

The codec's digital microphone (next to the camera) or the headset
microphone of the jack (MIC1 with its bias), as the PAZ00 routing of
Linux has them, go through its ADC back over I2S into the second FIFO
of I2S1, which a third APB DMA channel empties into record buffers
after the playback ones. The device describes two input channels at
44.1 kHz, and the mixer gets an input group with the record level, the
microphone to use and its boost.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../drivers/audio/tegra/tegra_audio.cpp       | 304 ++++++++++++++++--
 1 file changed, 277 insertions(+), 27 deletions(-)

diff --git a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
index 8477dfd223..1da9e78fcf 100644
--- a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
+++ b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
@@ -15,6 +15,10 @@
 	bus, is a slave that routes its DAC to the speaker (class D amplifier) and
 	the headphones.
 
+	Recording: the codec's digital microphone (next to the camera) or the
+	headset microphone of the jack (MIC1) go through its ADC back over the
+	same I2S link, into the second FIFO of I2S1 and a third DMA channel.
+
 	The same buffers also go to the S/PDIF controller, through a second DMA
 	channel: the HDMI block takes its audio from there (TRM 27.3). Its clock,
 	128 fs = 5.6448 MHz, is PLL A out 0 divided by 4, so both outputs run at
@@ -151,6 +155,9 @@ struct tegra_audio_diag {
 #define APBDMA_CHANNEL				1
 #define APBDMA_CHANNEL_OFFSET		(0x1000 + APBDMA_CHANNEL * 0x20)
 #define APBDMA_CHANNEL_IRQ			(32 + 104 + APBDMA_CHANNEL)
+#define RECORD_DMA_CHANNEL			3
+#define RECORD_DMA_CHANNEL_OFFSET	(0x1000 + RECORD_DMA_CHANNEL * 0x20)
+#define RECORD_DMA_CHANNEL_IRQ		(32 + 104 + RECORD_DMA_CHANNEL)
 #define SPDIF_DMA_CHANNEL			2
 #define SPDIF_DMA_CHANNEL_OFFSET	(0x1000 + SPDIF_DMA_CHANNEL * 0x20)
 #define SPDIF_DMA_CHANNEL_IRQ		(32 + 104 + SPDIF_DMA_CHANNEL)
@@ -192,6 +199,12 @@ struct tegra_audio_diag {
 #define ALC5632_SPK_OUT_VOL			0x02
 #define ALC5632_HP_OUT_VOL			0x04
 #define ALC5632_STEREO_DAC_IN_VOL	0x0c
+#define ALC5632_MIC_VOL				0x0e
+#define ALC5632_ADC_REC_GAIN		0x12	// left 12-8, right 4-0
+#define ALC5632_ADC_REC_MIXER		0x14	// mutes: MIC1 bits 14 and 6
+#define ALC5632_I2S_OUT_CTL			0x1a	// bit 5: 0 = the stereo ADC
+#define ALC5632_MIC_CTRL			0x22	// MIC1 boost bits 11-10
+#define ALC5632_DIGI_BOOST_CTRL		0x24	// digital microphone
 #define ALC5632_MIC_ROUTING_CTRL	0x10
 #define ALC5632_OUTPUT_MIXER_CTRL	0x1c
 #define ALC5632_PWR_DOWN_CTRL_STATUS	0x26
@@ -266,6 +279,14 @@ struct tegra_audio {
 
 	// the mixer controls (Media preferences, Cortex): attenuation of the
 	// left and right channel in 1.5 dB steps (0 - 31), mute by the user
+	uint8					recordLevel[2];		// ADC gain, -16.5 dB + 1.5 dB n
+	uint8					micBoost;			// in steps of 6 dB (0 - 7)
+	int32					inputSource;		// 0 digital, 1 headset microphone
+	volatile uint8*			recordChannel;
+	bool					recordInterruptInstalled;
+	int32					recording;			// the buffer the DMA fills
+	int64					framesRecorded;
+	bigtime_t				recordTime;
 	uint8					speakerLevel[2];
 	uint8					headphoneLevel[2];
 	bool					speakerMuted;
@@ -429,6 +450,51 @@ codec_init(tegra_audio* audio)
 }
 
 
+/*!	The ADC records the digital microphone or the headset one (MIC1, with
+	its bias), as the PAZ00 routing of Linux has them; its gain is the
+	record level. Called with the lock held.
+*/
+static void
+set_input(tegra_audio* audio)
+{
+	bool digital = audio->inputSource == 0;
+	uint8 boost = audio->micBoost & 7;
+
+	// the gain of the ADC: 5 bits per channel
+	uint16 gain;
+	if (codec_read(audio, ALC5632_ADC_REC_GAIN, &gain) == B_OK) {
+		gain = (gain & ~0x1f1f) | ((audio->recordLevel[0] & 0x1f) << 8)
+			| (audio->recordLevel[1] & 0x1f);
+		codec_write(audio, ALC5632_ADC_REC_GAIN, gain);
+	}
+	// the stereo ADC on the I2S output
+	codec_update(audio, ALC5632_I2S_OUT_CTL, 1U << 5, 0);
+
+	if (digital) {
+		// digital microphone on, into both ADC channels (the routing bits
+		// mute when set), its boost in steps of 6 dB
+		codec_write(audio, ALC5632_DIGI_BOOST_CTRL, (1U << 15) | boost);
+		codec_write(audio, ALC5632_ADC_REC_MIXER, 0x7f7f);
+		codec_update(audio, ALC5632_PWR_MANAG_ADD1, 1U << 3, 0);
+		codec_update(audio, ALC5632_PWR_MANAG_ADD2, 0x00c3, 0x00c0);
+		codec_update(audio, ALC5632_PWR_MANAG_ADD3, 1U << 3, 0);
+	} else {
+		// MIC1 with its bias and boost (0, 20, 30 or 40 dB) into the record
+		// mixers
+		uint16 micBoost = boost == 0 ? 0 : boost <= 3 ? 1 : boost <= 5 ? 2 : 3;
+		codec_write(audio, ALC5632_DIGI_BOOST_CTRL, 0x00c0);
+		codec_update(audio, ALC5632_MIC_CTRL, 3U << 10, micBoost << 10);
+		codec_write(audio, ALC5632_ADC_REC_MIXER,
+			0x7f7f & ~((1U << 14) | (1U << 6)));
+		codec_update(audio, ALC5632_PWR_MANAG_ADD1, 1U << 3, 1U << 3);
+		codec_update(audio, ALC5632_PWR_MANAG_ADD2, 0x00c3, 0x00c3);
+		codec_update(audio, ALC5632_PWR_MANAG_ADD3, 0x000a, 0x000a);
+	}
+	TRACE_ALWAYS("recording the %s microphone, gain %u, boost %u\n",
+		digital ? "built-in" : "headset", audio->recordLevel[0], boost);
+}
+
+
 /*!	A volume register of the ALC5632: attenuation of the left channel in
 	bits 12-8 and of the right one in bits 4-0, mutes in bits 15 and 7.
 */
@@ -671,6 +737,34 @@ buffer_physical(tegra_audio* audio, int32 index)
 }
 
 
+/*!	The record buffers follow the playback ones in the same area. */
+static inline phys_addr_t
+record_physical(tegra_audio* audio, int32 index)
+{
+	return buffer_physical(audio, audio->bufferCount + index);
+}
+
+
+static int32
+record_dma_interrupt(void* data)
+{
+	tegra_audio* audio = (tegra_audio*)data;
+	uint32 status = read32(audio->recordChannel, DMA_STATUS);
+	if ((status & DMA_STATUS_EOC) == 0)
+		return B_UNHANDLED_INTERRUPT;
+	write32(audio->recordChannel, DMA_STATUS, status);
+
+	acquire_spinlock(&audio->interruptLock);
+	audio->recording = (audio->recording + 1) % audio->bufferCount;
+	write32(audio->recordChannel, DMA_AHB_PTR, record_physical(audio,
+		(audio->recording + 1) % audio->bufferCount));
+	audio->framesRecorded += audio->bufferFrames;
+	audio->recordTime = system_time();
+	release_spinlock(&audio->interruptLock);
+	return B_HANDLED_INTERRUPT;
+}
+
