From 92e2276d0903b0389a5c01fe3ea7cbde10d9bfe2 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 20:49:48 +0200
Subject: [PATCH 115/203] minimum image: demos, ActivityMonitor, Magnify,
 Screenshot on ARM

With the libraries they and SDL2 need (libgame, libmedia, libmidi2,
libscreensaver), for the Toshiba AC100.
---
 build/jam/images/definitions/minimum | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/build/jam/images/definitions/minimum b/build/jam/images/definitions/minimum
index 32d294c55c..293203516e 100644
--- a/build/jam/images/definitions/minimum
+++ b/build/jam/images/definitions/minimum
@@ -128,6 +128,7 @@ SYSTEM_BIN = [ FFilterByBuildFeatures
 
 SYSTEM_APPS = [ FFilterByBuildFeatures
 	AboutSystem
+	ActivityMonitor@arm
 	BootManager@x86,x86_64
 	CharacterMap
 	Debugger@libedit
@@ -138,9 +139,11 @@ SYSTEM_APPS = [ FFilterByBuildFeatures
 	DriveSetup
 	Expander
 	Installer
+	Magnify@arm
 	NetworkStatus
 	PowerStatus@arm
 	ProcessController
+	Screenshot@arm
 	ShowImage
 	StyledEdit
 	Terminal
@@ -185,7 +188,16 @@ SYSTEM_PREFERENCES = [ FFilterByBuildFeatures
 	VirtualMemory
 ] ;
 
-SYSTEM_DEMOS = ;
+SYSTEM_DEMOS = [ FFilterByBuildFeatures
+	Chart@arm
+	Clock@arm
+	FontDemo@arm
+	Mandelbrot@arm
+	Pairs@arm
+	Playground@arm
+	Pulse@arm
+	Sudoku@arm
+] ;
 
 
 rule HaikuImageGetSystemLibs
@@ -202,9 +214,13 @@ rule HaikuImageGetSystemLibs
 			libdebug.so
 			libdebugger.so@primary
 			libdevice.so
+			libgame.so@arm
 			libgnu.so
+			libmedia.so@arm
+			libmidi2.so@arm
 			libnetwork.so
 			libpackage.so
+			libscreensaver.so@arm
 			libtextencoding.so
 			libtracker.so
 			libtranslation.so
