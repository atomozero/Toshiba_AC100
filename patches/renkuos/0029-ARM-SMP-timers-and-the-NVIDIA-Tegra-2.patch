+
 status_t
 arch_cpu_preboot_init_percpu(kernel_args *args, int curr_cpu)
 {
+	// Haiku does not use ASIDs: user mappings are not global and are tagged
+	// with CONTEXTIDR.ASID, which the firmware may have left non-zero
+	asm volatile ("mcr p15, 0, %0, c13, c0, 1" : : "r" (0));
+	asm volatile ("isb");
+
+	if (curr_cpu == 0) {
+		// MVFR0[3:0]: 1 = 16 double registers (e.g. Tegra 2), 2 = 32
+		gARMHasVFPD32 = (arm_get_mvfr0() & 0xf) == 2;
+	}
+
 	return B_OK;
 }
 
@@ -26,23 +45,86 @@ arch_cpu_preboot_init_percpu(kernel_args *args, int curr_cpu)
 status_t
 arch_cpu_init_percpu(kernel_args *args, int curr_cpu)
 {
+	// the boot CPU sets its exceptions up in arch_int_init()
 	if (curr_cpu != 0)
-		panic("No SMP support on ARM yet!\n");
+		arch_int_init_secondary_cpu(curr_cpu);
+
+	// Branch prediction: the firmware switches it on for the boot CPU only,
+	// the others come out of reset without; a busy loop then runs about
+	// three times slower on them
+	uint32 control;
+	asm volatile("mrc p15, 0, %0, c1, c0, 0" : "=r" (control));
+	uint32 auxControl;
+	asm volatile("mrc p15, 0, %0, c1, c0, 1" : "=r" (auxControl));
+	if ((control & (1 << 11)) == 0) {
+		asm volatile("mcr p15, 0, %0, c7, c5, 6; dsb; isb" : : "r" (0));
+			// BPIALL
+		asm volatile("mcr p15, 0, %0, c1, c0, 0; isb"
+			: : "r" (control | (1 << 11)));
+	}
+	dprintf("arm: CPU %d: SCTLR 0x%08" B_PRIx32 " (branch prediction %s),"
+		" ACTLR 0x%08" B_PRIx32 "\n", curr_cpu, control,
+		(control & (1 << 11)) != 0 ? "on" : "switched on", auxControl);
 
-	return 0;
+	return B_OK;
 }
 
 
 status_t
 arch_cpu_init(kernel_args *args)
 {
+	// one package of single threaded cores, as on all ARMv7 multiprocessors
+	for (uint32 i = 0; i < args->num_cpus; i++) {
+		cpu_ent* cpu = &gCPU[i];
+		cpu->topology_id[CPU_TOPOLOGY_PACKAGE] = 0;
+		cpu->topology_id[CPU_TOPOLOGY_CORE] = i;
+		cpu->topology_id[CPU_TOPOLOGY_SMT] = 0;
+	}
 	return B_OK;
 }
 
 
+// NVIDIA Tegra power management controller: a write of MAIN_RST to its
+// control register resets the whole chip
+#define TEGRA_PMC_CNTRL				0x00
+#define TEGRA_PMC_CNTRL_MAIN_RST	(1 << 4)
+
+static volatile uint32* sTegraPMC;
+// After a chip reset the Toshiba AC100 starts its stock bootloader from the
+// eMMC; Haiku only comes back if U-Boot is loaded again over USB (RCM). So a
+// reboot switches the machine off instead, unless "arm_reboot_resets true"
+// is in the kernel settings (for U-Boot installed on the eMMC).
+static bool sRebootResets = true;
+
+// set by the driver that can switch the machine off, like the embedded
+// controller of the Toshiba AC100
+extern "C" {
+void (*gArmPowerOffHook)(void) = NULL;
+}
+
+
 status_t
 arch_cpu_init_post_vm(kernel_args *args)
 {
+	arm_l2_cache_init(args);
+
+	void* settings = load_driver_settings("kernel");
+	sRebootResets = get_driver_boolean_parameter(settings, "arm_reboot_resets",
+		false, true);
+	unload_driver_settings(settings);
+
+	if (args->arch_args.pmc.start != 0) {
+		void* address;
+		area_id area = map_physical_memory("tegra pmc",
+			args->arch_args.pmc.start & ~(phys_addr_t)(B_PAGE_SIZE - 1),
+			B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+			B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+		if (area >= B_OK) {
+			sTegraPMC = (volatile uint32*)((addr_t)address
+				+ (args->arch_args.pmc.start & (B_PAGE_SIZE - 1)));
+		}
+	}
+
 	return B_OK;
 }
 
@@ -57,6 +139,21 @@ arch_cpu_init_post_modules(kernel_args *args)
 status_t
 arch_cpu_shutdown(bool reboot)
 {
+	if (reboot && !sRebootResets && gArmPowerOffHook != NULL) {
+		dprintf("reboot: switching off instead (\"arm_reboot_resets true\" "
+			"resets the chip)\n");
+		reboot = false;
+	}
+
+	if (reboot && sTegraPMC != NULL) {
+		disable_interrupts();
+		sTegraPMC[TEGRA_PMC_CNTRL / 4] |= TEGRA_PMC_CNTRL_MAIN_RST;
+		spin(100000);
+	}
+
+	if (!reboot && gArmPowerOffHook != NULL)
+		gArmPowerOffHook();
+
 	while(1)
 		arch_cpu_idle();
 
@@ -65,12 +162,78 @@ arch_cpu_shutdown(bool reboot)
 }
 
 
+/*!	Makes code written through the data cache visible to instruction fetches:
+	cleans the whole level 1 data cache to the point of unification (which is
+	level 1 on the supported CPUs), then invalidates the instruction cache and
+	the branch predictor. This only affects the current CPU.
+*/
+void
+arm_sync_icache_all(void)
+{
+	// select the level 1 data cache and read its geometry
+	asm volatile ("mcr p15, 2, %0, c0, c0, 0" : : "r" (0));
+	asm volatile ("isb");
+	uint32 ccsidr;
+	asm volatile ("mrc p15, 1, %0, c0, c0, 0" : "=r" (ccsidr));
+
+	uint32 lineShift = (ccsidr & 7) + 4;
+	uint32 ways = ((ccsidr >> 3) & 0x3ff) + 1;
+	uint32 sets = ((ccsidr >> 13) & 0x7fff) + 1;
+	uint32 wayShift = ways > 1 ? __builtin_clz(ways - 1) : 0;
+
+	dsb();
+	for (uint32 way = 0; way < ways; way++) {
+		for (uint32 set = 0; set < sets; set++) {
+			// DCCSW: clean by set/way
+			uint32 value = (way << wayShift) | (set << lineShift);
+			asm volatile ("mcr p15, 0, %0, c7, c10, 2" : : "r" (value)
+				: "memory");
+		}
+	}
+	dsb();
+
+	// ICIALLUIS and BPIALLIS: the code may run on any CPU
+	asm volatile ("mcr p15, 0, %0, c7, c1, 0" : : "r" (0) : "memory");
+	asm volatile ("mcr p15, 0, %0, c7, c1, 6" : : "r" (0) : "memory");
+	dsb();
+	isb();
+}
+
+
+/*!	Writes back and discards the whole level 1 data cache of the current CPU,
+	e.g. before memory that was cached is accessed through a non-cacheable
+	mapping, so that no dirty line can be evicted over it later.
+*/
+void
+arm_clean_invalidate_dcache_all(void)
+{
+	asm volatile ("mcr p15, 2, %0, c0, c0, 0" : : "r" (0));
+	asm volatile ("isb");
+	uint32 ccsidr;
+	asm volatile ("mrc p15, 1, %0, c0, c0, 0" : "=r" (ccsidr));
+
+	uint32 lineShift = (ccsidr & 7) + 4;
+	uint32 ways = ((ccsidr >> 3) & 0x3ff) + 1;
+	uint32 sets = ((ccsidr >> 13) & 0x7fff) + 1;
+	uint32 wayShift = ways > 1 ? __builtin_clz(ways - 1) : 0;
+
+	dsb();
+	for (uint32 way = 0; way < ways; way++) {
+		for (uint32 set = 0; set < sets; set++) {
+			// DCCISW: clean and invalidate by set/way
+			uint32 value = (way << wayShift) | (set << lineShift);
+			asm volatile ("mcr p15, 0, %0, c7, c14, 2" : : "r" (value)
+				: "memory");
+		}
+	}
+	dsb();
+}
+
+
 void
 arch_cpu_sync_icache(void *address, size_t len)
 {
-	uint32 Rd = 0;
-	asm volatile ("mcr p15, 0, %[c7format], c7, c5, 0"
-		: : [c7format] "r" (Rd) );
+	arm_sync_icache_all();
 }
 
 
