 {
+	if (cpu == 0)
+		return B_OK;
+
+	InterruptController* controller = InterruptController::Get();
+	if (controller != NULL)
+		controller->PerCpuInit();
+
+	HardwareTimer* timer = HardwareTimer::Get();
+	if (timer != NULL)
+		timer->PerCpuInit();
+
 	return B_OK;
 }
 
