From 82b3d799331097b9697aaf7f971611acc3be6c00 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 14:29:34 +0200
Subject: [PATCH 089/203] AddOnMonitorHandler: don't treat add-ons from the
 future as unstable

With the clock not set (1970), every add-on looked modified "in the future"
and input_server never loaded any input device.
---
 src/kits/storage/AddOnMonitorHandler.cpp | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/kits/storage/AddOnMonitorHandler.cpp b/src/kits/storage/AddOnMonitorHandler.cpp
index 473ccc32a2..ae0149346f 100644
--- a/src/kits/storage/AddOnMonitorHandler.cpp
+++ b/src/kits/storage/AddOnMonitorHandler.cpp
@@ -534,8 +534,12 @@ AddOnMonitorHandler::_HandlePendingEntries()
 			continue;
 		}
 
-		// stat units are seconds, real_time_clock units are seconds
-		if (real_time_clock() - st.st_mtime < ADD_ON_STABLE_SECONDS) {
+		// stat units are seconds, real_time_clock units are seconds; an entry
+		// from the future means the clock is not set (e.g. a machine without
+		// a battery backed clock), not an entry that is still being written,
+		// which would otherwise never be taken
+		time_t age = real_time_clock() - st.st_mtime;
+		if (age >= 0 && age < ADD_ON_STABLE_SECONDS) {
 			// entry not stable, skip the entry for this pulse
 			iter++;
 			continue;
