From 52aa0dbad99644e8fffb041e9451f8d692fa71fb Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 12:01:36 +0200
Subject: [PATCH 005/270] kernel/arm: fix user TLB invalidation and make ARMv7
 atomics lock-free

- arch_cpu_user_tlb_invalidate() was empty (#warning WRITEME), so whenever
  more than PAGE_INVALIDATE_CACHE_SIZE pages of a user map changed, no
  TLB entry was dropped at all. Haiku does not use ASIDs on ARM yet, so
  invalidate the whole TLB. Per-page invalidation now uses the unified
  TLB operation instead of the data-TLB-only one.
- On ARMv7 implement the 32-bit kernel atomics with ldrex/strex instead of
  disabling interrupts. user_mutex.cpp runs them on user memory inside
  user_access(); a page fault taken there with interrupts disabled cannot
  be resolved, and user_access() would fail.
- clrex on context switch, so that a thread cannot complete a strex based
  on an exclusive reservation taken by another thread.
---
 src/system/kernel/arch/arm/arch_asm.S        |  2 +
 src/system/kernel/arch/arm/arch_atomic32.cpp | 58 ++++++++++++++++++++
 src/system/kernel/arch/arm/arch_cpu.cpp      | 13 ++---
 3 files changed, 65 insertions(+), 8 deletions(-)

diff --git a/src/system/kernel/arch/arm/arch_asm.S b/src/system/kernel/arch/arm/arch_asm.S
index c98100a990..c4addd43a6 100644
--- a/src/system/kernel/arch/arm/arch_asm.S
+++ b/src/system/kernel/arch/arm/arch_asm.S
@@ -69,6 +69,8 @@ FUNCTION(arm_context_switch):
 	stmfd   sp!, { r0-r12, lr }
 	str	sp, [r0]
 	ldr	sp, [r1]
+	/* drop any exclusive access of the previous thread (ldrex/strex) */
+	clrex
 	ldmfd   sp!, { r0-r12, lr }
 	bx	lr
 FUNCTION_END(arm_context_switch)
diff --git a/src/system/kernel/arch/arm/arch_atomic32.cpp b/src/system/kernel/arch/arm/arch_atomic32.cpp
index 12038f7506..01b45107ac 100644
--- a/src/system/kernel/arch/arm/arch_atomic32.cpp
+++ b/src/system/kernel/arch/arm/arch_atomic32.cpp
@@ -15,6 +15,62 @@
 
 #ifdef ATOMIC_FUNCS_ARE_SYSCALLS
 
+#if defined(__ARM_ARCH) && __ARM_ARCH >= 7
+
+/*
+ * ARMv7 has exclusive load/store instructions, so these do not need to disable
+ * interrupts. That matters: user_mutex.cpp runs them on user memory inside
+ * user_access(), and a page fault (e.g. on a copy-on-write page after fork())
+ * taken with interrupts disabled cannot be resolved and would make the operation
+ * fail (user_access() returns false).
+ */
+
+void
+atomic_set(int32 *value, int32 newValue)
+{
+	__atomic_store_n(value, newValue, __ATOMIC_SEQ_CST);
+}
+
+int32
+atomic_get_and_set(int32 *value, int32 newValue)
+{
+	return __atomic_exchange_n(value, newValue, __ATOMIC_SEQ_CST);
+}
+
+int32
+atomic_test_and_set(int32 *value, int32 newValue, int32 testAgainst)
+{
+	__atomic_compare_exchange_n(value, &testAgainst, newValue, false,
+		__ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+	return testAgainst;
+}
+
+int32
+atomic_add(int32 *value, int32 addValue)
+{
+	return __atomic_fetch_add(value, addValue, __ATOMIC_SEQ_CST);
+}
+
+int32
+atomic_and(int32 *value, int32 andValue)
+{
+	return __atomic_fetch_and(value, andValue, __ATOMIC_SEQ_CST);
+}
+
+int32
+atomic_or(int32 *value, int32 orValue)
+{
+	return __atomic_fetch_or(value, orValue, __ATOMIC_SEQ_CST);
+}
+
+int32
+atomic_get(int32 *value)
+{
+	return __atomic_load_n(value, __ATOMIC_SEQ_CST);
+}
+
+#else	// __ARM_ARCH < 7
+
 /*
  * NOTE: These functions are _intentionally_ not using spinlocks, unlike
  * the 64 bit versions. The reason for this is that they are used by the
@@ -90,6 +146,8 @@ atomic_get(int32 *value)
 	return oldValue;
 }
 
+#endif	// __ARM_ARCH < 7
+
 void
 _user_atomic_set(int32 *value, int32 newValue)
 {
diff --git a/src/system/kernel/arch/arm/arch_cpu.cpp b/src/system/kernel/arch/arm/arch_cpu.cpp
index 21c75ad705..91bcabe8ee 100644
--- a/src/system/kernel/arch/arm/arch_cpu.cpp
+++ b/src/system/kernel/arch/arm/arch_cpu.cpp
@@ -105,7 +105,7 @@ arch_cpu_invalidate_tlb_range(intptr_t, addr_t start, addr_t end)
 
 	int32 num_pages = end / B_PAGE_SIZE - start / B_PAGE_SIZE;
 	while (num_pages-- >= 0) {
-		asm volatile ("mcr p15, 0, %[c8format], c8, c6, 1"
+		asm volatile ("mcr p15, 0, %[c8format], c8, c7, 1"
 			: : [c8format] "r" (start) );
 		start += B_PAGE_SIZE;
 	}
@@ -123,7 +123,7 @@ arch_cpu_invalidate_tlb_list(intptr_t, addr_t pages[], int num_pages)
 	dsb();
 
 	for (int i = 0; i < num_pages; i++) {
-		asm volatile ("mcr p15, 0, %[c8format], c8, c6, 1":
+		asm volatile ("mcr p15, 0, %[c8format], c8, c7, 1":
 			: [c8format] "r" (pages[i]) );
 	}
 
@@ -151,10 +151,7 @@ arch_cpu_global_tlb_invalidate(void)
 
 void
 arch_cpu_user_tlb_invalidate(intptr_t)
-{/*
-	cpu_ops.flush_insn_pipeline();
-	cpu_ops.flush_atc_user();
-	cpu_ops.flush_insn_pipeline();
-*/
-#warning WRITEME
+{
+	// User mappings are not tagged with an ASID, so drop all TLB entries
+	arch_cpu_global_tlb_invalidate();
 }
