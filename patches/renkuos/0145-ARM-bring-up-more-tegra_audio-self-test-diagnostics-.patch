From 9f61c73bf693b39dfe0820836f532fb6e2a131ba Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 19 Oct 2026 22:07:31 +0200
Subject: [PATCH 145/270] ARM bring-up: more tegra_audio self test diagnostics,
 retry with clk_m (not for merging)

---
 .../drivers/audio/tegra/tegra_audio.cpp       | 64 +++++++++++++++----
 1 file changed, 51 insertions(+), 13 deletions(-)

diff --git a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
index 9a19834470..f4f1ccb1c7 100644
--- a/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
+++ b/src/add-ons/kernel/drivers/audio/tegra/tegra_audio.cpp
@@ -576,9 +576,37 @@ create_buffers(tegra_audio* audio, uint32 frames, uint32 count)
 }
 
 
-/*!	Bring-up aid: plays a short tone through the whole chain at start and
-	logs what the DMA and the I2S controller did.
+/*!	Bring-up aid: plays a short tone through the whole chain and logs what
+	the DMA and the I2S controller did.
 */
+static uint32
+run_self_test(tegra_audio* audio, const char* name)
+{
+	audio->interrupts = 0;
+	start_playback(audio);
+
+	// how far the DMA gets: its remaining count, over time
+	uint32 counts[3];
+	for (int i = 0; i < 3; i++) {
+		snooze(100000);
+		counts[i] = read32(audio->channel, DMA_STATUS);
+	}
+	uint32 i2sStatus = read32(audio->i2s, I2S_STATUS);
+	uint32 i2sControl = read32(audio->i2s, I2S_CTRL);
+	uint32 fifoControl = read32(audio->i2s, I2S_FIFO_SCR);
+	uint32 interrupts = audio->interrupts;
+	stop_playback(audio);
+
+	TRACE_ALWAYS("self test (%s): %" B_PRIu32 " DMA interrupts in 300 ms"
+		" (expected about 13), DMA status %#" B_PRIx32 " %#" B_PRIx32 " %#"
+		B_PRIx32 ", I2S status %#" B_PRIx32 ", ctrl %#" B_PRIx32 ", fifo %#"
+		B_PRIx32 ", timing %#" B_PRIx32 "\n", name, interrupts, counts[0],
+		counts[1], counts[2], i2sStatus, i2sControl, fifoControl,
+		read32(audio->i2s, I2S_TIMING));
+	return interrupts;
+}
+
+
 static void
 self_test(tegra_audio* audio)
 {
@@ -593,19 +621,29 @@ self_test(tegra_audio* audio)
 		samples[i * 2 + 1] = value;
 	}
 
-	start_playback(audio);
-	snooze(300000);
-	uint32 dmaStatus = read32(audio->channel, DMA_STATUS);
-	uint32 i2sStatus = read32(audio->i2s, I2S_STATUS);
-	uint32 interrupts = audio->interrupts;
-	stop_playback(audio);
+	uint32 bank = CLOCK_I2S1 / 32;
+	uint32 bit = 1U << (CLOCK_I2S1 % 32);
+	TRACE_ALWAYS("self test: I2S1 clock %s, reset %s, source %#" B_PRIx32
+		"; APB DMA clock %s, reset %s\n",
+		(read32(audio->car, CAR_CLK_OUT_ENB(bank)) & bit) != 0 ? "on" : "off",
+		(read32(audio->car, CAR_RST_DEVICES(bank)) & bit) != 0 ? "on" : "off",
+		read32(audio->car, CAR_CLK_SOURCE_I2S1),
+		(read32(audio->car, CAR_CLK_OUT_ENB(CLOCK_APBDMA / 32))
+			& (1U << (CLOCK_APBDMA % 32))) != 0 ? "on" : "off",
+		(read32(audio->car, CAR_RST_DEVICES(CLOCK_APBDMA / 32))
+			& (1U << (CLOCK_APBDMA % 32))) != 0 ? "on" : "off");
+
+	if (run_self_test(audio, "PLL A") == 0) {
+		// Does the I2S run at all? Clock it from the oscillator (clk_m,
+		// 12 MHz divided by 4) instead of PLL A for a moment.
+		uint32 source = read32(audio->car, CAR_CLK_SOURCE_I2S1);
+		write32(audio->car, CAR_CLK_SOURCE_I2S1, (3U << 30) | (2 * (4 - 1)));
+		run_self_test(audio, "clk_m");
+		write32(audio->car, CAR_CLK_SOURCE_I2S1, source);
+	}
+
 	memset(audio->buffers, 0, DEFAULT_BUFFER_FRAMES * BUFFER_COUNT
 		* FRAME_SIZE);
-
-	TRACE_ALWAYS("self test: %" B_PRIu32 " DMA interrupts in 300 ms (expected"
-		" about 13), DMA status %#" B_PRIx32 ", I2S status %#" B_PRIx32
-		", ctrl %#" B_PRIx32 "\n", interrupts, dmaStatus, i2sStatus,
-		read32(audio->i2s, I2S_CTRL));
 	audio->interrupts = 0;
 }
 
