@@ -0,0 +1,86 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef _BLUETOOTH_KEY_VAULT_H_
+#define _BLUETOOTH_KEY_VAULT_H_
+
+
+#include <Locker.h>
+#include <Message.h>
+#include <Path.h>
+
+#include <bluetooth/bluetooth.h>
+
+
+/*!	Where the link keys are kept, apart from everything else known of the
+	paired devices: the BondStore asks it for a key, and tells it to keep or
+	forget one, and knows nothing more of how it is done. The key store of
+	the system (BKeyStore) is meant to be one, once it encrypts the keys.
+
+	A key belongs to the pair of an adapter (controller) and a device, as
+	the specification has it.
+*/
+class KeyVault {
+public:
+	virtual						~KeyVault();
+
+	virtual	const char*			Name() const = 0;
+	virtual	status_t			InitCheck() const = 0;
+
+	virtual	status_t			Get(const bdaddr_t& adapter,
+									const bdaddr_t& remote,
+									linkkey_t& _key) = 0;
+	virtual	status_t			Put(const bdaddr_t& adapter,
+									const bdaddr_t& remote,
+									const linkkey_t& key) = 0;
+	virtual	status_t			Remove(const bdaddr_t& adapter,
+									const bdaddr_t& remote) = 0;
+
+	// adds an "address" (B_RAW_TYPE, bdaddr_t) to \a remotes for each key
+	// kept for \a adapter
+	virtual	status_t			GetRemotes(const bdaddr_t& adapter,
+									BMessage& remotes) = 0;
+};
+
+
+/*!	The keys of each adapter in a file of their own, "keys" in the folder
+	of the adapter, which only the owner may read or write. They are not
+	encrypted: there is nothing in the system yet to encrypt them with.
+*/
+class FileKeyVault : public KeyVault {
+public:
+								FileKeyVault(const BPath& directory);
+	virtual						~FileKeyVault();
+
+	virtual	const char*			Name() const;
+	virtual	status_t			InitCheck() const;
+
+	virtual	status_t			Get(const bdaddr_t& adapter,
+									const bdaddr_t& remote,
+									linkkey_t& _key);
+	virtual	status_t			Put(const bdaddr_t& adapter,
+									const bdaddr_t& remote,
+									const linkkey_t& key);
+	virtual	status_t			Remove(const bdaddr_t& adapter,
+									const bdaddr_t& remote);
+	virtual	status_t			GetRemotes(const bdaddr_t& adapter,
+									BMessage& remotes);
+
+private:
+			status_t			_Load(const bdaddr_t& adapter);
+			status_t			_Save();
+			int32				_IndexOf(const bdaddr_t& remote) const;
+
+private:
+			BLocker				fLock;
+			BPath				fDirectory;
+			bdaddr_t			fAdapter;
+				// the adapter whose keys are loaded in fKeys
+			bool				fLoaded;
+			BPath				fPath;
+			BMessage			fKeys;
+};
+
+
+#endif	// _BLUETOOTH_KEY_VAULT_H_
