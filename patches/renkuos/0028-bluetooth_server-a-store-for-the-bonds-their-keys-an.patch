+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef _BLUETOOTH_SETTINGS_FILE_H_
+#define _BLUETOOTH_SETTINGS_FILE_H_
+
+
+#include <Path.h>
+#include <SupportDefs.h>
+#include <sys/stat.h>
+
+#include <bluetooth/bluetooth.h>
+
+
+class BMessage;
+
+
+/*!	The files the Bluetooth server keeps its state in: flattened messages,
+	written aside and then put in place, so that a crash in the middle
+	leaves the previous version whole.
+*/
+namespace SettingsFile {
+
+// The folder of the state of one adapter (controller), in \a base:
+// "<base>/6C626D182CFD". It is created if needed.
+status_t	AdapterDirectory(const BPath& base, const bdaddr_t& adapter,
+				BPath& _path);
+
+// Reads \a path into \a message. A file that cannot be read is renamed
+// "<name>.broken", so that the next write does not lose it, and
+// B_BAD_DATA is returned; a missing file gives B_ENTRY_NOT_FOUND.
+status_t	Read(const BPath& path, BMessage& message);
+
+// Writes \a message to \a path with the permissions \a mode.
+status_t	Write(const BPath& path, const BMessage& message, mode_t mode);
+
+}
+
+
+#endif	// _BLUETOOTH_SETTINGS_FILE_H_
