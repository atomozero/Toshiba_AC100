diff --git a/src/servers/bluetooth/KeyVault.cpp b/src/servers/bluetooth/KeyVault.cpp
new file mode 100644
index 0000000000..bbf70083f5
--- /dev/null
+++ b/src/servers/bluetooth/KeyVault.cpp
@@ -0,0 +1,209 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+#include "KeyVault.h"
+
+#include <string.h>
+
+#include <Autolock.h>
+
+#include <bluetooth/bdaddrUtils.h>
+
+#include "SettingsFile.h"
+
+
+static const uint32 kMsgKeys = 'btKy';
+static const int32 kKeysVersion = 1;
+
+
+KeyVault::~KeyVault()
+{
+}
+
+
+//	#pragma mark - FileKeyVault
+
+
+FileKeyVault::FileKeyVault(const BPath& directory)
+	:
+	fLock("bluetooth keys"),
+	fDirectory(directory),
+	fAdapter(bdaddrUtils::NullAddress()),
+	fLoaded(false)
+{
+}
+
+
+FileKeyVault::~FileKeyVault()
+{
+	// nothing of the keys stays in the memory of the server
+	fKeys.MakeEmpty();
+}
+
+
+const char*
+FileKeyVault::Name() const
+{
+	return "file";
+}
+
+
+status_t
+FileKeyVault::InitCheck() const
+{
+	return fDirectory.InitCheck();
+}
+
+
+status_t
+FileKeyVault::Get(const bdaddr_t& adapter, const bdaddr_t& remote,
+	linkkey_t& _key)
+{
+	BAutolock locker(fLock);
+	status_t status = _Load(adapter);
+	if (status != B_OK)
+		return status;
+
+	int32 index = _IndexOf(remote);
+	if (index < 0)
+		return B_ENTRY_NOT_FOUND;
+
+	BMessage entry;
+	const void* data;
+	ssize_t size;
+	if (fKeys.FindMessage("key", index, &entry) != B_OK
+		|| entry.FindData("link key", B_RAW_TYPE, &data, &size) != B_OK
+		|| size != sizeof(linkkey_t)) {
+		return B_BAD_DATA;
+	}
+	memcpy(&_key, data, sizeof(linkkey_t));
+	return B_OK;
+}
+
+
+status_t
+FileKeyVault::Put(const bdaddr_t& adapter, const bdaddr_t& remote,
+	const linkkey_t& key)
+{
+	BAutolock locker(fLock);
+	status_t status = _Load(adapter);
+	if (status != B_OK && status != B_ENTRY_NOT_FOUND)
+		return status;
+
+	BMessage entry;
+	entry.AddData("address", B_RAW_TYPE, &remote, sizeof(bdaddr_t));
+	entry.AddData("link key", B_RAW_TYPE, &key, sizeof(linkkey_t));
+
+	int32 index = _IndexOf(remote);
+	if (index >= 0)
+		status = fKeys.ReplaceMessage("key", index, &entry);
+	else
+		status = fKeys.AddMessage("key", &entry);
+	if (status != B_OK)
+		return status;
+	return _Save();
+}
+
+
+status_t
+FileKeyVault::Remove(const bdaddr_t& adapter, const bdaddr_t& remote)
+{
+	BAutolock locker(fLock);
+	status_t status = _Load(adapter);
+	if (status != B_OK)
+		return status;
+
+	int32 index = _IndexOf(remote);
+	if (index < 0)
+		return B_ENTRY_NOT_FOUND;
+	fKeys.RemoveData("key", index);
+	return _Save();
+}
+
+
+status_t
+FileKeyVault::GetRemotes(const bdaddr_t& adapter, BMessage& remotes)
+{
+	BAutolock locker(fLock);
+	status_t status = _Load(adapter);
+	if (status == B_ENTRY_NOT_FOUND)
+		return B_OK;
+	if (status != B_OK)
+		return status;
+
+	BMessage entry;
+	for (int32 i = 0; fKeys.FindMessage("key", i, &entry) == B_OK; i++) {
+		const void* address;
+		ssize_t size;
+		if (entry.FindData("address", B_RAW_TYPE, &address, &size) == B_OK
+			&& size == sizeof(bdaddr_t)) {
+			remotes.AddData("address", B_RAW_TYPE, address, size);
+		}
+	}
+	return B_OK;
+}
+
+
+/*!	Reads the keys of \a adapter, unless they are loaded already. The lock
+	is held.
+*/
+status_t
+FileKeyVault::_Load(const bdaddr_t& adapter)
+{
+	if (fLoaded && bdaddrUtils::Compare(adapter, fAdapter))
+		return B_OK;
+
+	fLoaded = false;
+	fKeys.MakeEmpty();
+	fKeys.what = kMsgKeys;
+
+	BPath directory;
+	status_t status = SettingsFile::AdapterDirectory(fDirectory, adapter,
+		directory);
+	if (status == B_OK)
+		status = fPath.SetTo(directory.Path(), "keys");
+	if (status != B_OK)
+		return status;
+
+	fAdapter = adapter;
+	fLoaded = true;
+
+	status = SettingsFile::Read(fPath, fKeys);
+	if (status != B_OK) {
+		// none yet, or a broken file put aside: a vault without keys
+		fKeys.MakeEmpty();
+		fKeys.what = kMsgKeys;
+		return status == B_ENTRY_NOT_FOUND ? status : B_OK;
+	}
+	return B_OK;
+}
+
+
+status_t
+FileKeyVault::_Save()
+{
+	fKeys.what = kMsgKeys;
+	fKeys.RemoveName("version");
+	fKeys.AddInt32("version", kKeysVersion);
+	return SettingsFile::Write(fPath, fKeys, S_IRUSR | S_IWUSR);
+}
+
+
+int32
+FileKeyVault::_IndexOf(const bdaddr_t& remote) const
+{
+	BMessage entry;
+	for (int32 i = 0; fKeys.FindMessage("key", i, &entry) == B_OK; i++) {
+		const void* address;
+		ssize_t size;
+		if (entry.FindData("address", B_RAW_TYPE, &address, &size) == B_OK
+			&& size == sizeof(bdaddr_t)
+			&& bdaddrUtils::Compare(*(const bdaddr_t*)address, remote)) {
+			return i;
+		}
+	}
+	return -1;
+}
