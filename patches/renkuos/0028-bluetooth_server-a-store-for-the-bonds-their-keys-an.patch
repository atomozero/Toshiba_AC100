index 0000000000..792c2b6a1a
--- /dev/null
+++ b/src/servers/bluetooth/SettingsFile.cpp
@@ -0,0 +1,86 @@
+/*
+ * Copyright 2026, Andrea Bernardi
+ * SPDX-License-Identifier: MIT
+ */
+
+
+#include "SettingsFile.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <syslog.h>
+
+#include <Directory.h>
+#include <Entry.h>
+#include <File.h>
+#include <Message.h>
+#include <String.h>
+
+
+status_t
+SettingsFile::AdapterDirectory(const BPath& base, const bdaddr_t& adapter,
+	BPath& _path)
+{
+	// the address as the controller reads it out, most significant first
+	char name[13];
+	snprintf(name, sizeof(name), "%02X%02X%02X%02X%02X%02X", adapter.b[5],
+		adapter.b[4], adapter.b[3], adapter.b[2], adapter.b[1], adapter.b[0]);
+
+	status_t status = _path.SetTo(base.Path(), name);
+	if (status != B_OK)
+		return status;
+	status = create_directory(_path.Path(), 0755);
+	return status == B_FILE_EXISTS ? B_OK : status;
+}
+
+
+status_t
+SettingsFile::Read(const BPath& path, BMessage& message)
+{
+	BFile file(path.Path(), B_READ_ONLY);
+	status_t status = file.InitCheck();
+	if (status != B_OK)
+		return status == B_ENTRY_NOT_FOUND ? status : B_ERROR;
+
+	status = message.Unflatten(&file);
+	if (status == B_OK)
+		return B_OK;
+
+	// kept for whoever wants to look at it; the next write would lose it
+	BString broken(path.Leaf());
+	broken << ".broken";
+	BEntry entry(path.Path());
+	entry.Rename(broken.String(), true);
+	syslog(LOG_WARNING, "bluetooth_server: %s could not be read, it is now "
+		"%s\n", path.Path(), broken.String());
+	return B_BAD_DATA;
+}
+
+
+status_t
+SettingsFile::Write(const BPath& path, const BMessage& message, mode_t mode)
+{
+	BString temporary(path.Path());
+	temporary << ".new";
+
+	BFile file(temporary.String(), B_WRITE_ONLY | B_CREATE_FILE
+		| B_ERASE_FILE);
+	status_t status = file.InitCheck();
+	if (status == B_OK)
+		status = file.SetPermissions(mode);
+	if (status == B_OK)
+		status = message.Flatten(&file);
+	if (status == B_OK)
+		status = file.Sync();
+	file.Unset();
+
+	BEntry entry(temporary.String());
+	if (status == B_OK)
+		status = entry.Rename(path.Leaf(), true);
+	if (status != B_OK) {
+		entry.Remove();
+		syslog(LOG_ERR, "bluetooth_server: %s could not be written: %s\n",
+			path.Path(), strerror(status));
+	}
+	return status;
+}
