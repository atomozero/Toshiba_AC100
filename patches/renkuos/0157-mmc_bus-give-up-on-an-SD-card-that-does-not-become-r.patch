From 2629fd7de29ce092e44837d2e8d7a770d7f6bc66 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 20 Oct 2026 00:25:33 +0200
Subject: [PATCH 157/203] mmc_bus: give up on an SD card that does not become
 ready

ACMD41 was repeated forever while a card stayed busy, holding the bus. Stop
after three seconds, as with an unsupported voltage range. A failed CMD55 is
reported as such instead of from a card status that was never read.
---
 .../kernel/bus_managers/mmc/mmc_bus.cpp       | 25 ++++++++++++++++---
 1 file changed, 21 insertions(+), 4 deletions(-)

diff --git a/src/add-ons/kernel/bus_managers/mmc/mmc_bus.cpp b/src/add-ons/kernel/bus_managers/mmc/mmc_bus.cpp
index 6c290ec5e0..863f261162 100644
--- a/src/add-ons/kernel/bus_managers/mmc/mmc_bus.cpp
+++ b/src/add-ons/kernel/bus_managers/mmc/mmc_bus.cpp
@@ -469,20 +469,37 @@ MMCBus::_WorkerThread(void* cookie)
 		// We keep repeating ACMD41 until the card replies that it is
 		// initialized. For MMC we already probed using CMD1 above.
 		if ((cardType != CARD_TYPE_MMC) && (cardType != CARD_TYPE_MMC_EXTENDED_CAPACITY)) {
+			// The card has to finish its power up within one second. Give it
+			// some more, but do not wait forever for a card that never gets
+			// ready: the bus stayed held by this thread then.
+			const bigtime_t kReadyTimeout = 3000000;
+			bigtime_t readyStart = system_time();
 			do {
-				uint32_t cardStatus;
-				while (bus->ExecuteCommand(0, SD_APP_CMD, 0, &cardStatus) == B_BUSY) {
+				uint32_t cardStatus = 0;
+				status_t appStatus;
+				while ((appStatus = bus->ExecuteCommand(0, SD_APP_CMD, 0,
+						&cardStatus)) == B_BUSY) {
 					ERROR("Card locked after CMD8...\n");
 					snooze(1000000);
 				}
-				if ((cardStatus & 0xFFFF8000) != 0)
+				if (appStatus != B_OK)
+					ERROR("CMD55 failed: %s\n", strerror(appStatus));
+				else if ((cardStatus & 0xFFFF8000) != 0)
 					ERROR("SD card reports error %x\n", cardStatus);
-				if ((cardStatus & (1 << 5)) == 0)
+				else if ((cardStatus & (1 << 5)) == 0)
 					ERROR("Card did not enter ACMD mode\n");
 
+				ocr = 0;
 				bus->ExecuteCommand(0, SD_SEND_OP_COND, hcs | 0xFF8000, &ocr);
 
 				if ((ocr & (1 << 31)) == 0) {
+					if (system_time() - readyStart > kReadyTimeout) {
+						ERROR("card did not become ready, giving up\n");
+						bus->_TerminateBus();
+						bus->_InitialScanDone();
+						bus->ReleaseBus();
+						return B_TIMED_OUT;
+					}
 					TRACE("Card is busy\n");
 					snooze(100000);
 				}
