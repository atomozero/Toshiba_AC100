From 9e401e7857e2558aa74702a0628952449987cb85 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 18:35:01 +0200
Subject: [PATCH 033/203] ARM bring-up: show the panic message before the
 slower checks (not for merging)

---
 src/system/kernel/debug/debug.cpp | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/src/system/kernel/debug/debug.cpp b/src/system/kernel/debug/debug.cpp
index 61abe85889..af8cae9dda 100644
--- a/src/system/kernel/debug/debug.cpp
+++ b/src/system/kernel/debug/debug.cpp
@@ -2146,11 +2146,11 @@ panic(const char* format, ...)
 			asm volatile ("cpsid aif");
 			sPanicShown = true;
 			arm_boot_marker(34);
-			arm_boot_find_stack_aliases(110);
-			arm_boot_check_text(203);
-			arm_boot_show_exceptions(303);
 			arm_boot_marker_value(3,
 				(uint32)(addr_t)__builtin_return_address(0));
+			// the raw format first: formatting could fail on a broken stack
+			arm_boot_marker_text(format);
+			arm_boot_show_exceptions(303);
 
 			static char sPanicText[512];
 			strlcpy(sPanicText, "PANIC: ", sizeof(sPanicText));
@@ -2161,6 +2161,13 @@ panic(const char* format, ...)
 			va_end(markerArgs);
 			arm_boot_marker_text(sPanicText);
 
+			// slower checks last, with markers to tell how far they got
+			arm_boot_marker(35);
+			arm_boot_find_stack_aliases(110);
+			arm_boot_marker(36);
+			arm_boot_check_text(203);
+			arm_boot_marker(37);
+
 			disable_interrupts();
 			while (true)
 				;
