From 8349ebc4546e35ffcd9337aa05e38416602c2855 Mon Sep 17 00:00:00 2001
From: PulkoMandy <pulkomandy@pulkomandy.tk>
Date: Fri, 16 Oct 2026 22:11:58 +0200
Subject: [PATCH 164/270] freebsd_network: use generic bus.h and cpufunc.h for
 all non-x86 architectures

If it works for RISC-V and ARM64, it should work for everyone else?

Change-Id: I585e4bf200dea499e5f55b10a4a654336b2069a7
Reviewed-on: https://review.haiku-os.org/c/haiku/+/12203
Reviewed-by: waddlesplash <waddlesplash@gmail.com>
(cherry picked from commit ae25f101ad1b77749be21dd1dad21571eaeee18d)
---
 src/libs/compat/freebsd_network/compat/machine/bus.h     | 4 +---
 src/libs/compat/freebsd_network/compat/machine/cpufunc.h | 4 +---
 2 files changed, 2 insertions(+), 6 deletions(-)

diff --git a/src/libs/compat/freebsd_network/compat/machine/bus.h b/src/libs/compat/freebsd_network/compat/machine/bus.h
index b4189ef063..403b299af1 100644
--- a/src/libs/compat/freebsd_network/compat/machine/bus.h
+++ b/src/libs/compat/freebsd_network/compat/machine/bus.h
@@ -10,10 +10,8 @@
 
 #if defined(__i386__) || defined(__amd64__)
 #  include <machine/x86/bus.h>
-#elif (defined(__riscv) && __riscv_xlen == 64) || defined(__aarch64__)
-#  include <machine/generic/bus.h>
 #else
-#  error Need a bus.h for this arch!
+#  include <machine/generic/bus.h>
 #endif
 
 #endif /* _FBSD_COMPAT_MACHINE_BUS_H_ */
diff --git a/src/libs/compat/freebsd_network/compat/machine/cpufunc.h b/src/libs/compat/freebsd_network/compat/machine/cpufunc.h
index 665007232c..adec125b0e 100644
--- a/src/libs/compat/freebsd_network/compat/machine/cpufunc.h
+++ b/src/libs/compat/freebsd_network/compat/machine/cpufunc.h
@@ -11,10 +11,8 @@
 #  include <machine/x86/cpufunc.h>
 #elif defined(__x86_64__)
 #  include <machine/x86_64/cpufunc.h>
-#elif (defined(__riscv) && __riscv_xlen == 64) || defined(__aarch64__)
-#  include <machine/generic/cpufunc.h>
 #else
-#  error Need a cpufunc.h for this arch!
+#  include <machine/generic/cpufunc.h>
 #endif
 
 #endif /* _FBSD_COMPAT_MACHINE_CPUFUNC_H_ */
