From 1a5f6e7a12a17b585e63da39a046ed52d52dfe59 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 00:01:01 +0200
Subject: [PATCH 065/270] ARM bring-up: write the syslog to ac100log.txt on the
 EFI system partition (not for merging)

---
 src/system/kernel/debug/debug.cpp | 20 +++++++++--
 src/system/kernel/fs/vfs_boot.cpp | 58 +++++++++++++++++++++++++++++++
 2 files changed, 76 insertions(+), 2 deletions(-)

diff --git a/src/system/kernel/debug/debug.cpp b/src/system/kernel/debug/debug.cpp
index 542eeb2deb..9abd600ee0 100644
--- a/src/system/kernel/debug/debug.cpp
+++ b/src/system/kernel/debug/debug.cpp
@@ -98,13 +98,29 @@ static bool sDebugScreenEnabled = false;
 static bool sBlueScreenOutput = true;
 static bool sEmergencyKeysEnabled = true;
 static spinlock sSpinlock = B_SPINLOCK_INITIALIZER;
+
+static struct ring_buffer* sSyslogBuffer;
+
+
+/*!	Bring-up aid: copies the syslog buffer into \a buffer, returns the size.
+*/
+size_t
+debug_copy_syslog(char* buffer, size_t size)
+{
+	InterruptsSpinLocker locker(sSpinlock);
+	if (sSyslogBuffer == NULL)
+		return 0;
+	size_t readable = ring_buffer_readable(sSyslogBuffer);
+	if (readable > size)
+		readable = size;
+	return ring_buffer_peek(sSyslogBuffer, 0, buffer, readable);
+}
 static int32 sDebuggerOnCPU = -1;
 
 static sem_id sSyslogNotify = -1;
 static thread_id sSyslogWriter = -1;
 static port_id sSyslogPort = -1;
 static struct syslog_message* sSyslogMessage;
-static struct ring_buffer* sSyslogBuffer;
 static size_t sSyslogBufferOffset = 0;
 	// (relative) buffer offset of the yet unsent syslog messages
 static bool sSyslogDropped = false;
@@ -120,7 +136,7 @@ static const char* sCurrentKernelDebuggerMessagePrefix;
 static const char* sCurrentKernelDebuggerMessage;
 static va_list sCurrentKernelDebuggerMessageArgs;
 
-#define DEFAULT_SYSLOG_BUFFER_SIZE 65536
+#define DEFAULT_SYSLOG_BUFFER_SIZE 262144
 #define OUTPUT_BUFFER_SIZE 1024
 static char sOutputBuffer[OUTPUT_BUFFER_SIZE];
 static char sInterruptOutputBuffer[OUTPUT_BUFFER_SIZE];
diff --git a/src/system/kernel/fs/vfs_boot.cpp b/src/system/kernel/fs/vfs_boot.cpp
index b2b7ebb35a..b520d082a9 100644
--- a/src/system/kernel/fs/vfs_boot.cpp
+++ b/src/system/kernel/fs/vfs_boot.cpp
@@ -32,6 +32,54 @@
 
 #include "vfs_net_boot.h"
 
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+
+
+// bring-up aid: write the syslog to the EFI system partition, which can be
+// read on any PC, as the log scrolls by too fast on screen
+extern size_t debug_copy_syslog(char* buffer, size_t size);
+
+static char sEspPath[B_PATH_NAME_LENGTH];
+
+
+static status_t
+syslog_to_esp_thread(void*)
+{
+	const size_t kSize = 262144;
+	char* buffer = (char*)malloc(kSize);
+	if (buffer == NULL)
+		return B_NO_MEMORY;
+
+	_kern_create_dir(-1, "/esp", 0755);
+
+	// mount the partition only while writing, so that it is left clean
+	// whenever the machine is switched off
+	for (int32 i = 0; i < 30; i++) {
+		snooze(10000000);
+		status_t status = _kern_mount("/esp", sEspPath, "fat", 0, NULL, 0);
+		if (i == 0) {
+			dprintf("AC100: writing the syslog to %s, ac100log.txt: %s\n",
+				sEspPath, strerror(status));
+		}
+		if (status < 0)
+			continue;
+
+		size_t size = debug_copy_syslog(buffer, kSize);
+		int fd = _kern_open(-1, "/esp/ac100log.txt",
+			O_WRONLY | O_CREAT | O_TRUNC, 0644);
+		if (fd >= 0) {
+			_kern_write(fd, -1, buffer, size);
+			_kern_close(fd);
+		}
+		_kern_unmount("/esp", 0);
+	}
+
+	free(buffer);
+	return B_OK;
+}
+
 
 //#define TRACE_VFS
 #ifdef TRACE_VFS
@@ -570,6 +618,16 @@ vfs_mount_boot_file_system(kernel_args* args)
 		if (bootDevice >= 0) {
 			dprintf("Mounted boot partition: %s\n", path.Path());
 			gReadOnlyBootDevice = readOnly;
+
+			// the EFI system partition is the first one of the boot disk
+			strlcpy(sEspPath, path.Path(), sizeof(sEspPath));
+			char* last = strrchr(sEspPath, '/');
+			if (last != NULL && !readOnly) {
+				strlcpy(last + 1, "0", sizeof(sEspPath) - (last + 1 - sEspPath));
+				thread_id thread = spawn_kernel_thread(&syslog_to_esp_thread,
+					"syslog to ESP", B_LOW_PRIORITY, NULL);
+				resume_thread(thread);
+			}
 			break;
 		}
 	}
