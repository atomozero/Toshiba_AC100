From 47e7856ce5fd6632dc8ba9c74606c02b1e051cf2 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 20 Oct 2026 19:17:37 +0200
Subject: [PATCH 171/203] ARM bring-up: power cycle a ganged external hub for a
 failing port, log power cycles (not for merging)

---
 src/add-ons/kernel/bus_managers/usb/Hub.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/add-ons/kernel/bus_managers/usb/Hub.cpp b/src/add-ons/kernel/bus_managers/usb/Hub.cpp
index 9acf06662a..6f1066bae5 100644
--- a/src/add-ons/kernel/bus_managers/usb/Hub.cpp
+++ b/src/add-ons/kernel/bus_managers/usb/Hub.cpp
@@ -312,10 +312,20 @@ Hub::PowerCyclePort(uint8 index)
 	// TRACE_ALWAYS: it is a fixed property of the hub, not an event, and it
 	// would otherwise print on every failed round.
 	if ((fHubDescriptor.characteristics & 0x3) != 0x1) {
+#ifdef __arm__
+		// AC100 bring-up: the internal hub only has the camera and the
+		// external port behind it; try the ganged power cycle anyway
+		if (GetBusManager()->GetRootHub() != this && (fHubDescriptor.characteristics & 0x2) == 0) {
+			dprintf("AC100: usb hub %d: ganged power, power cycling all "
+				"ports for port %u\n", DeviceAddress(), index + 1);
+		} else
+#endif
+		{
 		TRACE("hub does not switch port power individually "
 			"(characteristics 0x%04x); not power cycling port %u\n",
 			fHubDescriptor.characteristics, index);
 		return B_NOT_SUPPORTED;
+		}
 	}
 
 	status_t status = DefaultPipe()->SendRequest(USB_REQTYPE_CLASS
@@ -333,6 +343,8 @@ Hub::PowerCyclePort(uint8 index)
 		return status;
 
 	snooze(USB_DELAY_HUB_POWER_UP);
+	dprintf("AC100: usb hub %d port %u power cycled\n", DeviceAddress(),
+		index + 1);
 	return B_OK;
 }
 
