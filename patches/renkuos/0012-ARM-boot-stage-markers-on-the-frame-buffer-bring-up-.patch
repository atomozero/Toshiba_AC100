 		panic("No interrupt controllers found!\n");
 	}
 
+	arm_boot_marker(15);
 	return B_OK;
 }
 
diff --git a/src/system/kernel/arch/arm/arch_platform.cpp b/src/system/kernel/arch/arm/arch_platform.cpp
index a7051f2610..c34ffe071e 100644
--- a/src/system/kernel/arch/arm/arch_platform.cpp
+++ b/src/system/kernel/arch/arm/arch_platform.cpp
@@ -9,6 +9,7 @@
 #include <KernelExport.h>
