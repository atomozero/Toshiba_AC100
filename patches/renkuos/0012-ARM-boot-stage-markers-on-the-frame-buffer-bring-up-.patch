From 539613898f9c3f878ef3f0340deb6b087e328502 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 15:17:29 +0200
Subject: [PATCH 012/203] ARM: boot stage markers on the frame buffer (bring-up
 aid, not for merging)

---
 .../kernel/arch/arm/arch_kernel_args.h        |  1 +
 .../private/kernel/arch/arm/arm_boot_marker.h | 57 +++++++++++++++++++
 .../boot/platform/efi/arch/arm/arch_mmu.cpp   |  9 +++
 .../boot/platform/efi/arch/arm/arch_start.cpp | 24 ++++++++
 src/system/kernel/arch/arm/arch_cpu.cpp       | 25 ++++++++
 src/system/kernel/arch/arm/arch_int.cpp       |  4 ++
 src/system/kernel/arch/arm/arch_platform.cpp  |  3 +
 src/system/kernel/arch/arm/arch_timer.cpp     |  3 +
 src/system/kernel/arch/arm/arch_vm.cpp        |  4 ++
 9 files changed, 130 insertions(+)
 create mode 100644 headers/private/kernel/arch/arm/arm_boot_marker.h

diff --git a/headers/private/kernel/arch/arm/arch_kernel_args.h b/headers/private/kernel/arch/arm/arch_kernel_args.h
index cd434bd6de..c693cb2702 100644
--- a/headers/private/kernel/arch/arm/arch_kernel_args.h
+++ b/headers/private/kernel/arch/arm/arch_kernel_args.h
@@ -41,6 +41,7 @@ typedef struct {
 	intc_info			interrupt_controller;
 	boot_timer_info		timer;
 	uint32				timerFrequency;	// in Hz, if the timer needs it
+	uint32				bootMarkerFrameBuffer;	// kernel address, bring-up aid
 } _PACKED arch_kernel_args;
 
 #endif	/* KERNEL_ARCH_ARM_KERNEL_ARGS_H */
diff --git a/headers/private/kernel/arch/arm/arm_boot_marker.h b/headers/private/kernel/arch/arm/arm_boot_marker.h
new file mode 100644
index 0000000000..994096d9f0
--- /dev/null
+++ b/headers/private/kernel/arch/arm/arm_boot_marker.h
@@ -0,0 +1,57 @@
+/*
+ * Copyright 2026, Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _KERNEL_ARCH_ARM_BOOT_MARKER_H
+#define _KERNEL_ARCH_ARM_BOOT_MARKER_H
+
+
+#include <SupportDefs.h>
+
+
+/*!	Bring-up aid for boards without a usable serial port: draws a small
+	colored square for boot stage \a index into the top left corner of the
+	frame buffer, so that the last stage reached can be read off the screen.
+	Squares are grouped by five; colors cycle red, green, blue, yellow,
+	magenta, cyan, white.
+*/
+static inline void
+arm_boot_marker_draw(uint8* frameBuffer, uint32 bytesPerRow, uint32 depth,
+	int index)
+{
+	static const uint32 kColors32[] = {
+		0xff0000, 0x00ff00, 0x0000ff, 0xffff00, 0xff00ff, 0x00ffff, 0xffffff
+	};
+	static const uint16 kColors16[] = {
+		0xf800, 0x07e0, 0x001f, 0xffe0, 0xf81f, 0x07ff, 0xffff
+	};
+	const int kSize = 16;
+
+	if (frameBuffer == NULL)
+		return;
+
+	int color = index % 7;
+	int left = 8 + index * (kSize + 6) + (index / 5) * 12;
+	for (int y = 0; y < kSize; y++) {
+		uint8* row = frameBuffer + (8 + y) * bytesPerRow;
+		for (int x = left; x < left + kSize; x++) {
+			if (depth == 32)
+				((volatile uint32*)row)[x] = kColors32[color];
+			else if (depth == 16)
+				((volatile uint16*)row)[x] = kColors16[color];
+			else if (depth == 24) {
+				row[x * 3] = kColors32[color] & 0xff;
+				row[x * 3 + 1] = (kColors32[color] >> 8) & 0xff;
+				row[x * 3 + 2] = kColors32[color] >> 16;
+			}
+		}
+	}
+}
+
+
+#ifdef _KERNEL_MODE
+void arm_boot_marker(int index);
+#endif
+
+
+#endif	// _KERNEL_ARCH_ARM_BOOT_MARKER_H
diff --git a/src/system/boot/platform/efi/arch/arm/arch_mmu.cpp b/src/system/boot/platform/efi/arch/arm/arch_mmu.cpp
index 4e9d6f99bb..3bd7ef96aa 100644
--- a/src/system/boot/platform/efi/arch/arm/arch_mmu.cpp
+++ b/src/system/boot/platform/efi/arch/arm/arch_mmu.cpp
@@ -286,6 +286,15 @@ arch_mmu_generate_post_efi_page_tables(size_t memoryMapSize,
 	map_range_to_new_area(gKernelArgs.arch_args.uart.regs,
 		ARM_MMU_L2_FLAG_B | ARM_MMU_L2_FLAG_HAIKU_KERNEL_RW | ARM_MMU_L2_FLAG_XN);
 
+	// bring-up aid: let the kernel draw boot markers before its VM is up
+	if (gKernelArgs.frame_buffer.enabled) {
+		gKernelArgs.arch_args.bootMarkerFrameBuffer = map_range_to_new_area(
+			gKernelArgs.frame_buffer.physical_buffer.start,
+			gKernelArgs.frame_buffer.physical_buffer.size,
+			ARM_MMU_L2_FLAG_B | ARM_MMU_L2_FLAG_HAIKU_KERNEL_RW
+				| ARM_MMU_L2_FLAG_XN);
+	}
+
 	sort_address_ranges(gKernelArgs.virtual_allocated_range,
 		gKernelArgs.num_virtual_allocated_ranges);
 
diff --git a/src/system/boot/platform/efi/arch/arm/arch_start.cpp b/src/system/boot/platform/efi/arch/arm/arch_start.cpp
index 165d1562b9..94e97f907c 100644
--- a/src/system/boot/platform/efi/arch/arm/arch_start.cpp
+++ b/src/system/boot/platform/efi/arch/arm/arch_start.cpp
@@ -28,6 +28,23 @@
 
 
 extern "C" void clean_dcache_all(void);
+
+
+#include <arch/arm/arm_boot_marker.h>
+
+
+static void
+loader_marker(int index)
+{
+	if (!gKernelArgs.frame_buffer.enabled)
+		return;
+
+	arm_boot_marker_draw(
+		(uint8*)(addr_t)gKernelArgs.frame_buffer.physical_buffer.start,
+		gKernelArgs.frame_buffer.bytes_per_row, gKernelArgs.frame_buffer.depth,
+		index);
+	clean_dcache_all();
+}
 extern "C" void invalidate_icache_all(void);
 
 extern "C" typedef void (*arch_enter_kernel_t)(uint32_t, addr_t, addr_t, addr_t);
@@ -88,6 +105,8 @@ allocate_trampoline_page(void)
 void
 arch_start_kernel(addr_t kernelEntry)
 {
+	loader_marker(0);
+
 	// Allocate virtual memory for kernel args
 	struct kernel_args *kernelArgs = NULL;
 	if (platform_allocate_region((void **)&kernelArgs,
@@ -176,11 +195,13 @@ arch_start_kernel(addr_t kernelEntry)
 	// they only needed to know about the maximum address, not any specific
 	// entry.
 
+	loader_marker(1);
 	dprintf("Calling ExitBootServices. So long, EFI!\n");
 	serial_disable();
 
 	while (true) {
 		if (kBootServices->ExitBootServices(kImage, mapKey) == EFI_SUCCESS) {
+			loader_marker(2);
 			// Disconnect from EFI serial_io / stdio services
 			serial_kernel_handoff();
 			dprintf("Unhooked from EFI serial services\n");
@@ -197,10 +218,12 @@ arch_start_kernel(addr_t kernelEntry)
 	// Update EFI, generate final kernel physical memory map, etc.
 	arch_mmu_post_efi_setup(memoryMapSize, memoryMap,
 		descriptorSize, descriptorVersion);
+	loader_marker(3);
 
 	// Re-init and activate serial in a horrific post-EFI landscape. Clowns roam the land freely.
 	serial_init();
 	serial_enable();
+	loader_marker(4);
 
 	// Copy final kernel args
 	// This should be the last step before jumping to the kernel
@@ -225,6 +248,7 @@ arch_start_kernel(addr_t kernelEntry)
 		final_ttbr0, (uint32_t)virtKernelArgs, (uint32_t)kernelEntry,
 		(uint32_t)(gKernelArgs.cpu_kstack[0].start + gKernelArgs.cpu_kstack[0].size));
 
+	loader_marker(5);
 	enter_kernel(final_ttbr0, virtKernelArgs, kernelEntry,
 		gKernelArgs.cpu_kstack[0].start + gKernelArgs.cpu_kstack[0].size);
 }
diff --git a/src/system/kernel/arch/arm/arch_cpu.cpp b/src/system/kernel/arch/arm/arch_cpu.cpp
index 91bcabe8ee..fe1d1920a5 100644
--- a/src/system/kernel/arch/arm/arch_cpu.cpp
+++ b/src/system/kernel/arch/arm/arch_cpu.cpp
@@ -14,15 +14,37 @@
 
 #include <arch/cpu.h>
 #include <boot/kernel_args.h>
+#include <arch/arm/arm_boot_marker.h>
 
 
 bool gARMHasVFPD32 = true;
 
 
+static uint8* sBootMarkerFrameBuffer;
+static uint32 sBootMarkerBytesPerRow;
+static uint32 sBootMarkerDepth;
+
+
+void
+arm_boot_marker(int index)
+{
+	arm_boot_marker_draw(sBootMarkerFrameBuffer, sBootMarkerBytesPerRow,
+		sBootMarkerDepth, index);
+}
+
+
 status_t
 arch_cpu_preboot_init_percpu(kernel_args *args, int curr_cpu)
 {
 	if (curr_cpu == 0) {
+		if (args->frame_buffer.enabled) {
+			sBootMarkerFrameBuffer
+				= (uint8*)(addr_t)args->arch_args.bootMarkerFrameBuffer;
+			sBootMarkerBytesPerRow = args->frame_buffer.bytes_per_row;
+			sBootMarkerDepth = args->frame_buffer.depth;
+		}
+		arm_boot_marker(6);
+
 		// MVFR0[3:0]: 1 = 16 double registers (e.g. Tegra 2), 2 = 32
 		gARMHasVFPD32 = (arm_get_mvfr0() & 0xf) == 2;
 	}
@@ -44,6 +66,7 @@ arch_cpu_init_percpu(kernel_args *args, int curr_cpu)
 status_t
 arch_cpu_init(kernel_args *args)
 {
+	arm_boot_marker(8);
 	return B_OK;
 }
 
@@ -51,6 +74,7 @@ arch_cpu_init(kernel_args *args)
 status_t
 arch_cpu_init_post_vm(kernel_args *args)
 {
+	arm_boot_marker(16);
 	return B_OK;
 }
 
@@ -58,6 +82,7 @@ arch_cpu_init_post_vm(kernel_args *args)
 status_t
 arch_cpu_init_post_modules(kernel_args *args)
 {
+	arm_boot_marker(19);
 	return B_OK;
 }
 
