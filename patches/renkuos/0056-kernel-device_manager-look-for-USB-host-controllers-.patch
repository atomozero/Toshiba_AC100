From 6a6857026542378ad50788803ce198d38031ce94 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 23:01:49 +0200
Subject: [PATCH 056/203] kernel/device_manager: look for USB host controllers
 on generic nodes

USB host controllers that are not on a PCI bus, like the EHCI
controllers of the NVIDIA Tegra 2 described in a device tree, are
published as generic nodes, and busses/usb was not among the paths
searched for their drivers, so they were never probed.
---
 src/system/kernel/device_manager/device_manager.cpp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/system/kernel/device_manager/device_manager.cpp b/src/system/kernel/device_manager/device_manager.cpp
index e1b659d087..db6ade41d3 100644
--- a/src/system/kernel/device_manager/device_manager.cpp
+++ b/src/system/kernel/device_manager/device_manager.cpp
@@ -1736,6 +1736,8 @@ device_node::_GetNextDriverPath(void*& cookie, KPath& _path)
 					_AddPath(*stack, "bus_managers/pci");
 					_AddPath(*stack, "busses/pci");
 					_AddPath(*stack, "busses/mmc");
+					// USB host controllers on a device tree bus
+					_AddPath(*stack, "busses/usb");
 				}
 				break;
 		}
