From 0a088301fd5723590d6988bac3b06e1b650f1efa Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Mon, 26 Oct 2026 14:53:53 +0100
Subject: [PATCH 256/270] tegra_dc: HDMI audio from S/PDIF at 44.1 kHz, reset
 the DDC bus

The audio clock regeneration packets now describe the 44.1 kHz stream
of the S/PDIF controller (N 6272), the HDMI audio source is S/PDIF. A
television heard the tegra_audio test tone this way.

After a hot plug the DDC controller kept words in its transmit FIFO
and never sent them: reset it before each EDID attempt.

tegra_dc_diag also dumps the HDMI block's registers while it runs.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 .../kernel/drivers/graphics/tegra_dc/hdmi.cpp | 35 +++++++++----------
 .../misc/tegra_dc_diag/tegra_dc_diag.cpp      | 29 +++++++++++++++
 2 files changed, 46 insertions(+), 18 deletions(-)

diff --git a/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp b/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
index eaefbe1aa9..737af8c40d 100644
--- a/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
+++ b/src/add-ons/kernel/drivers/graphics/tegra_dc/hdmi.cpp
@@ -221,7 +221,7 @@ extern "C" status_t arm_dvc_i2c_write(uint8 address, uint8 reg,
 #define AUDIO_FS_HIGH(x)			(((uint32)(x) & 0xfff) << 16)
 #define HDMI_AUDIO_CNTRL0			0x8b
 #define AUDIO_CNTRL0_ERROR_TOLERANCE(x)	((uint32)(x) & 0xff)
-#define AUDIO_CNTRL0_SOURCE_AUTO	(0u << 20)
+#define AUDIO_CNTRL0_SOURCE_SPDIF	(1u << 20)
 #define AUDIO_CNTRL0_FRAMES_PER_BLOCK(x)	(((uint32)(x) & 0xff) << 24)
 #define HDMI_AUDIO_N				0x8c
 #define AUDIO_N_VALUE(x)			((uint32)(x) & 0xfffff)
@@ -478,20 +478,17 @@ screen_plugged()
 //	#pragma mark - DDC
 
 
-/*!	The tegra_i2c bus driver usually runs I2C2 already, at the 100 kHz of
-	the DDC bus and with no devices on it: then its clock and reset are left
-	alone.
+/*!	I2C2 is also set up by the tegra_i2c bus driver, with no devices on it;
+	it is reset here every time with the same settings (100 kHz): after a
+	hot plug the controller kept words in its transmit FIFO and never sent
+	them.
 */
 static void
 setup_ddc()
 {
-	if ((read_car(CAR_CLK_OUT_ENB_H) & CAR_I2C2_BIT) == 0
-		|| (read_car(CAR_RST_DEVICES_H) & CAR_I2C2_BIT) != 0) {
-		write_car(CAR_CLK_SOURCE_I2C2, CAR_SOURCE_PLL_P
-			| ((216000 + 8 * DDC_BUS_KHZ - 1) / (8 * DDC_BUS_KHZ) - 1));
-		enable_block(CAR_CLK_OUT_ENB_H, CAR_RST_DEVICES_H, CAR_I2C2_BIT,
-			true);
-	}
+	write_car(CAR_CLK_SOURCE_I2C2, CAR_SOURCE_PLL_P
+		| ((216000 + 8 * DDC_BUS_KHZ - 1) / (8 * DDC_BUS_KHZ) - 1));
+	enable_block(CAR_CLK_OUT_ENB_H, CAR_RST_DEVICES_H, CAR_I2C2_BIT, true);
 
 	volatile uint32* i2c = sHdmi.i2c;
 	i2c[I2C_CNFG / 4] = I2C_CNFG_NEW_MASTER_FSM | I2C_CNFG_PACKET_MODE
@@ -1055,18 +1052,20 @@ write_infoframe(uint32 word, uint8* frame, size_t size)
 }
 
 
-/*!	Audio clock regeneration and the audio infoframe for 48 kHz stereo, so
-	that HDMI sinks find the audio clock they expect even while there is no
-	sound: N = 128 * 48000 / 1000, CTS = the pixel clock in kHz.
+/*!	Audio clock regeneration and the audio infoframe for the 44.1 kHz
+	stereo that the tegra_audio driver sends through the S/PDIF controller:
+	N = 6272 (the HDMI recommendation for 44.1 kHz), CTS = pixel clock * N /
+	(128 * 44100).
 */
 static void
 setup_audio_packets()
 {
-	const uint32 n = 6144;
-	uint32 cts = sHdmi.mode.pixel_clock;
+	const uint32 n = 6272;
+	uint32 cts = (uint32)(((uint64)sHdmi.mode.pixel_clock * 1000 * n
+		+ 128 * 44100 / 2) / (128 * 44100));
 
 	write_hdmi(HDMI_AUDIO_CNTRL0, AUDIO_CNTRL0_FRAMES_PER_BLOCK(0xc0)
-		| AUDIO_CNTRL0_ERROR_TOLERANCE(6) | AUDIO_CNTRL0_SOURCE_AUTO);
+		| AUDIO_CNTRL0_ERROR_TOLERANCE(6) | AUDIO_CNTRL0_SOURCE_SPDIF);
 
 	write_hdmi(HDMI_ACR_CTRL, 0);
 	write_hdmi(HDMI_AUDIO_N, AUDIO_N_RESETF | AUDIO_N_GENERATE_ALTERNATE
@@ -1275,9 +1274,9 @@ connect()
 	// answers on the DDC bus (a television took more than a second)
 	uint8 edid[EDID_SIZE];
 	uint32 edidSize = 0;
-	setup_ddc();
 	for (int32 attempt = 0; attempt < 10; attempt++) {
 		snooze(200000);
+		setup_ddc();
 		status = read_edid(edid, &edidSize);
 		if (status == B_OK)
 			break;
diff --git a/src/add-ons/kernel/drivers/misc/tegra_dc_diag/tegra_dc_diag.cpp b/src/add-ons/kernel/drivers/misc/tegra_dc_diag/tegra_dc_diag.cpp
index eca552a0a7..f092ee0566 100644
--- a/src/add-ons/kernel/drivers/misc/tegra_dc_diag/tegra_dc_diag.cpp
+++ b/src/add-ons/kernel/drivers/misc/tegra_dc_diag/tegra_dc_diag.cpp
@@ -348,6 +348,35 @@ report_hdmi(char* buffer, size_t size, size_t length)
 		delete_area(area);
 	}
 
+	// The HDMI block's registers, while its clock runs and it is out of
+	// reset (bit 19 of the H registers)
+	if (car != NULL) {
+		car = map_registers("tegra car", TEGRA20_CAR_BASE, B_PAGE_SIZE, &area);
+		bool hdmiRunning = car != NULL && (car[CAR_CLK_OUT_ENB_H / 4]
+			& (1u << 19)) != 0 && (car[CAR_RST_DEVICES_H / 4] & (1u << 19)) == 0;
+		if (car != NULL)
+			delete_area(area);
+		volatile uint32* hdmi = hdmiRunning ? map_registers("tegra hdmi",
+			TEGRA20_HDMI_BASE, B_PAGE_SIZE, &area) : NULL;
+		if (hdmi != NULL) {
+			static const struct { uint32 first, last; } kRanges[] = {
+				{ 0x01, 0x03 }, { 0x1e, 0x2a }, { 0x35, 0x39 }, { 0x44, 0x46 },
+				{ 0x4f, 0x51 }, { 0x55, 0x5a }, { 0x7e, 0x8c }, { 0x95, 0x99 },
+			};
+			length = append(buffer, size, length, "hdmi:");
+			for (size_t i = 0; i < B_COUNT_OF(kRanges); i++) {
+				for (uint32 word = kRanges[i].first; word <= kRanges[i].last;
+						word++) {
+					length = append(buffer, size, length, "%s%02" B_PRIx32 "=%08"
+						B_PRIx32, word == kRanges[i].first ? "\n " : " ", word,
+						hdmi[word]);
+				}
+			}
+			length = append(buffer, size, length, "\n");
+			delete_area(area);
+		}
+	}
+
 	// GPIO ports M..P are bank 3: CNF, OE, OUT, IN at 0x00/0x10/0x20/0x30
 	volatile uint32* gpio = map_registers("tegra gpio", 0x6000d000,
 		B_PAGE_SIZE, &area);
