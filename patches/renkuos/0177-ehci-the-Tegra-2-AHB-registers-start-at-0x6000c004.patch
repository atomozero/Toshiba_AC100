From e33c7f755ac2fcd1de77ef2248f0779dd0d43930 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 20 Oct 2026 22:04:29 +0200
Subject: [PATCH 177/270] ehci: the Tegra 2 AHB registers start at 0x6000c004

The TRM's AHB register offsets are relative to 0x6000c004, so the
priority setting went into AHB_ARBITRATION_DISABLE and took the USB3
controller off the bus. Log the disabled masters too.
---
 src/add-ons/kernel/busses/usb/ehci.cpp | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/src/add-ons/kernel/busses/usb/ehci.cpp b/src/add-ons/kernel/busses/usb/ehci.cpp
index f096353d3b..ffe3860972 100644
--- a/src/add-ons/kernel/busses/usb/ehci.cpp
+++ b/src/add-ons/kernel/busses/usb/ehci.cpp
@@ -58,6 +58,7 @@ typedef struct {
 
 #define TEGRA20_CAR_BASE				0x60006000
 #define TEGRA20_AHB_BASE				0x6000c000
+#define TEGRA20_AHB_REGISTERS			0x004	// the TRM's offsets start here
 #define AHB_ARBITRATION_PRIORITY_CTRL	0x004
 #define AHB_PRIORITY_WEIGHT(x)			((uint32)(x) << 29)
 #define AHB_GIZMO_AHB_MEM				0x00c
@@ -169,7 +170,8 @@ tegra20_usb_ahb_setup(phys_addr_t registers)
 		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
 	if (area < B_OK)
 		return;
-#define AHB_REG(offset) ((volatile uint32*)((uint8*)address + (offset)))
+#define AHB_REG(offset) \
+	((volatile uint32*)((uint8*)address + TEGRA20_AHB_REGISTERS + (offset)))
 
 	tegra_set_bits(AHB_REG(AHB_GIZMO_AHB_MEM), AHB_GIZMO_ENB_FAST_REARBITRATE,
 		AHB_GIZMO_ENB_FAST_REARBITRATE);
@@ -181,9 +183,10 @@ tegra20_usb_ahb_setup(phys_addr_t registers)
 	*AHB_REG(prefetch) = AHB_PREFETCH_ENABLE | AHB_PREFETCH_MST_ID(master)
 		| AHB_PREFETCH_ADDR_BNDRY(12) | AHB_PREFETCH_INACTIVITY_TIMEOUT(0x800);
 
-	dprintf("AC100: ehci %#" B_PRIxPHYSADDR " AHB: priority %#" B_PRIx32
-		", gizmo %#" B_PRIx32 ", memory gizmo %#" B_PRIx32 ", prefetch %#"
-		B_PRIx32 "\n", registers, *AHB_REG(AHB_ARBITRATION_PRIORITY_CTRL),
+	dprintf("AC100: ehci %#" B_PRIxPHYSADDR " AHB: disabled masters %#"
+		B_PRIx32 ", priority %#" B_PRIx32 ", gizmo %#" B_PRIx32 ", memory "
+		"gizmo %#" B_PRIx32 ", prefetch %#" B_PRIx32 "\n", registers,
+		*AHB_REG(0), *AHB_REG(AHB_ARBITRATION_PRIORITY_CTRL),
 		*AHB_REG(gizmo), *AHB_REG(AHB_GIZMO_AHB_MEM), *AHB_REG(prefetch));
 #undef AHB_REG
 	delete_area(area);
