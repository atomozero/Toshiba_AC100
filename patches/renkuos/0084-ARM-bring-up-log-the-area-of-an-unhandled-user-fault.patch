From 3352badeb734de44a9878da528b49611e098a988 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 13:00:49 +0200
Subject: [PATCH 084/270] ARM bring-up: log the area of an unhandled user fault
 and the frame buffer mapping (not for merging)

---
 .../kernel/drivers/graphics/framebuffer/device.cpp |  2 ++
 .../drivers/graphics/framebuffer/framebuffer.cpp   |  2 ++
 src/system/kernel/vm/vm.cpp                        | 14 +++++++++++++-
 3 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/src/add-ons/kernel/drivers/graphics/framebuffer/device.cpp b/src/add-ons/kernel/drivers/graphics/framebuffer/device.cpp
index 9d47657c01..d1ccbb5b44 100644
--- a/src/add-ons/kernel/drivers/graphics/framebuffer/device.cpp
+++ b/src/add-ons/kernel/drivers/graphics/framebuffer/device.cpp
@@ -120,6 +120,8 @@ device_ioctl(void* cookie, uint32 msg, void* buffer, size_t bufferLength)
 			area_id area = vm_clone_area(B_CURRENT_TEAM, "cloned framebuffer",
 				&dummy, B_ANY_ADDRESS, B_READ_AREA | B_WRITE_AREA, 0,
 				info->frame_buffer_area, true);
+			dprintf("AC100: framebuffer: clone of area %" B_PRId32 ": %"
+				B_PRId32 " at %p\n", info->frame_buffer_area, area, dummy);
 			if (area < 0)
 				return area;
 
diff --git a/src/add-ons/kernel/drivers/graphics/framebuffer/framebuffer.cpp b/src/add-ons/kernel/drivers/graphics/framebuffer/framebuffer.cpp
index abdd71138d..07e6da75b6 100644
--- a/src/add-ons/kernel/drivers/graphics/framebuffer/framebuffer.cpp
+++ b/src/add-ons/kernel/drivers/graphics/framebuffer/framebuffer.cpp
@@ -62,6 +62,8 @@ remap_frame_buffer(framebuffer_info& info, addr_t physicalBase, uint32 width,
 	area_id area = map_physical_memory("framebuffer buffer", base,
 		size, B_ANY_KERNEL_ADDRESS, B_READ_AREA | B_WRITE_AREA,
 		(void**)&frameBuffer);
+	dprintf("AC100: framebuffer: map %#lx, %lu bytes: area %" B_PRId32
+		" at %#lx\n", base, size, area, frameBuffer);
 	if (area < 0)
 		return area;
 
diff --git a/src/system/kernel/vm/vm.cpp b/src/system/kernel/vm/vm.cpp
index e1199bff31..4dbd8da7b8 100644
--- a/src/system/kernel/vm/vm.cpp
+++ b/src/system/kernel/vm/vm.cpp
@@ -3835,8 +3835,20 @@ vm_page_fault(addr_t address, addr_t faultAddress, bool isWrite, bool isExecute,
 				faultAddress, area ? area->name : "???", faultAddress - (area ?
 					area->Base() : 0x0));
 
-			if (addressSpace != NULL)
+			if (addressSpace != NULL) {
+				VMArea* target = addressSpace->LookupArea(address);
+				if (target != NULL) {
+					dprintf("vm_page_fault: address in area \"%s\" %#lx-%#lx, "
+						"protection %#" B_PRIx32 ", cache type %d, wiring %d, "
+						"error %s\n", target->name, target->Base(),
+						target->Base() + target->Size() - 1, target->protection,
+						target->cache_type, target->wiring, strerror(status));
+				} else {
+					dprintf("vm_page_fault: no area at the address, error %s\n",
+						strerror(status));
+				}
 				addressSpace->ReadUnlock();
+			}
 #endif	// bring-up aid
 
 			// If the thread has a signal handler for SIGSEGV, we simply
