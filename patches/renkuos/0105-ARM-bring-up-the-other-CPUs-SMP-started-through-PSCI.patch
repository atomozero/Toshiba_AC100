 {
-	// One cpu for now.
 	return 0;
 }
 
 
+static bool
+can_start(const platform_cpu_info& cpu)
+{
+	return cpu.psci && sPsciMethod != PSCI_NONE;
+}
+
+
 void
 arch_smp_init_other_cpus(void)
 {
-	// One cpu for now.
-	gKernelArgs.num_cpus = 1;
-	return;
+	// only CPUs with a known way to start them, numbered 0, 1, ... by
+	// MPIDR, as the trampoline takes its CPU number from it
+	uint32 count = 1;
+	while (count < sCpuCount && count < ENTER_KERNEL_MAX_CPUS
+		&& sCpus[count].id == count && can_start(sCpus[count])) {
+		count++;
+	}
+	gKernelArgs.num_cpus = count;
+
+	if (get_safemode_boolean(B_SAFEMODE_DISABLE_SMP, false)) {
+		TRACE(("smp disabled per safemode setting\n"));
+		gKernelArgs.num_cpus = 1;
+	}
+	dprintf("smp: %" B_PRIu32 " of %" B_PRIu32 " CPUs usable\n",
+		gKernelArgs.num_cpus, sCpuCount);
+
+	for (uint32 i = 1; i < gKernelArgs.num_cpus; i++) {
+		void* stack = NULL;
+		const size_t size = KERNEL_STACK_SIZE
+			+ KERNEL_STACK_GUARD_PAGES * B_PAGE_SIZE;
+		if (platform_allocate_region(&stack, size, 0) != B_OK)
+			panic("Unable to allocate AP stack");
+		memset(stack, 0, size);
+		gKernelArgs.cpu_kstack[i].start = fix_address((addr_t)stack);
+		gKernelArgs.cpu_kstack[i].size = size;
+	}
+}
+
+
+static int32
+psci_call(uint32 function, uint32 arg0, uint32 arg1, uint32 arg2)
+{
+	register uint32 r0 asm("r0") = function;
+	register uint32 r1 asm("r1") = arg0;
+	register uint32 r2 asm("r2") = arg1;
+	register uint32 r3 asm("r3") = arg2;
+	if (sPsciMethod == PSCI_HVC) {
+		asm volatile(".arch_extension virt\n\thvc #0"
+			: "+r" (r0) : "r" (r1), "r" (r2), "r" (r3) : "memory");
+	} else {
+		asm volatile(".arch_extension sec\n\tsmc #0"
+			: "+r" (r0) : "r" (r1), "r" (r2), "r" (r3) : "memory");
+	}
+	return (int32)r0;
+}
+
+
+static inline uint32*
+parameters(void* trampolinePage)
+{
+	return (uint32*)((addr_t)trampolinePage
+		+ ((addr_t)arch_enter_kernel_parameters - (addr_t)arch_enter_kernel));
+}
+
+
+/*!	Starts the other CPUs on the trampoline: they invalidate their caches and
+	wait for arch_smp_release_other_cpus(). Returns the number of CPUs that
+	are up, the boot CPU included; the kernel arguments must say so.
+*/
+uint32
+arch_smp_start_other_cpus(void* trampolinePage, uint32 ttbr,
+	addr_t kernelEntry, addr_t virtKernelArgs)
+{
+	if (gKernelArgs.num_cpus < 2)
+		return 1;
+
+	uint32* params = parameters(trampolinePage);
+	params[ENTER_KERNEL_TTBR / 4] = ttbr;
+	params[ENTER_KERNEL_ARGS / 4] = virtKernelArgs;
+	params[ENTER_KERNEL_ENTRY / 4] = kernelEntry;
+	params[ENTER_KERNEL_GO / 4] = 0;
+	for (uint32 i = 0; i < ENTER_KERNEL_MAX_CPUS; i++) {
+		params[ENTER_KERNEL_STACKS / 4 + i] = i < gKernelArgs.num_cpus
+			? gKernelArgs.cpu_kstack[i].start + gKernelArgs.cpu_kstack[i].size
+			: 0;
+		params[ENTER_KERNEL_STARTED / 4 + i] = 0;
+	}
+	// the other CPUs start with their caches off
+	clean_dcache_all();
+
+	addr_t entry = (addr_t)trampolinePage
+		+ ((addr_t)arch_enter_kernel_secondary - (addr_t)arch_enter_kernel);
+	volatile uint32* started = &params[ENTER_KERNEL_STARTED / 4];
+
+	uint32 count = 1;
+	for (; count < gKernelArgs.num_cpus; count++) {
+		int32 result = psci_call(PSCI_CPU_ON_32, sCpus[count].id, entry, 0);
+		if (result != 0) {
+			dprintf("smp: CPU %" B_PRIu32 " did not start: PSCI error %"
+				B_PRId32 "\n", count, result);
+			break;
+		}
+
+		// it writes with its caches off: drop our copy of the line
+		bool up = false;
+		for (int32 i = 0; i < 20000000 && !up; i++) {
+			asm volatile("mcr p15, 0, %0, c7, c6, 1" : : "r" (started)
+				: "memory");	// DCIMVAC
+			asm volatile("dsb" : : : "memory");
+			up = started[count] != 0;
+		}
+		if (!up) {
+			dprintf("smp: CPU %" B_PRIu32 " did not come up\n", count);
+			break;
+		}
+	}
+	dprintf("smp: %" B_PRIu32 " CPUs up\n", count);
+	return count;
+}
+
+
+/*!	Lets the other CPUs enter the kernel, once the kernel arguments are in
+	place.
+*/
+void
+arch_smp_release_other_cpus(void* trampolinePage)
+{
+	uint32* params = parameters(trampolinePage);
+	params[ENTER_KERNEL_GO / 4] = 1;
+	clean_dcache_all();
+	asm volatile("dsb\n\tsev" : : : "memory");
 }
 
 
