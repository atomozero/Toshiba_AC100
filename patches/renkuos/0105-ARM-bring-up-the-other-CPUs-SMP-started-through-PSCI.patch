+#define ENTER_KERNEL_ARGS		4
+#define ENTER_KERNEL_ENTRY		8
+#define ENTER_KERNEL_GO			12
+#define ENTER_KERNEL_STACKS		16	// 4 words
+#define ENTER_KERNEL_STARTED	64	// 4 words, own cache line
