+
 static platform_cpu_info sCpus[SMP_MAX_CPUS];
 uint32 sCpuCount = 0;
 
+enum psci_method {
+	PSCI_NONE,
+	PSCI_HVC,
+	PSCI_SMC
+};
+static psci_method sPsciMethod = PSCI_NONE;
+
 
