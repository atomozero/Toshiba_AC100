+void
+arch_smp_set_psci_method(const char* method)
+{
+	if (strcmp(method, "hvc") == 0)
+		sPsciMethod = PSCI_HVC;
+	else if (strcmp(method, "smc") == 0)
+		sPsciMethod = PSCI_SMC;
