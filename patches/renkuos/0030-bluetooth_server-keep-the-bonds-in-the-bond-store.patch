+//	#pragma mark - bonds and known devices
+
+
+/*!	The bonds of an adapter, read when it is first asked for. The first
+	time an adapter has none, those of the file the server kept before
+	(Bluetooth_paired_devices) are taken in.
+*/
+BondStore*
+BluetoothServer::BondStoreFor(const bdaddr_t& adapter)
+{
+	BAutolock locker(fStoresLock);
+	for (int32 i = 0; i < fBondStores.CountItems(); i++) {
+		BondStore* bonds = fBondStores.ItemAt(i);
+		if (bdaddrUtils::Compare(bonds->Adapter(), adapter))
+			return bonds;
+	}
+
+	BPath directory;
+	if (fKeyVault == NULL || _StateDirectory(directory) != B_OK)
+		return NULL;
+	DeviceCache* devices = DeviceCacheFor(adapter);
+	if (devices == NULL)
+		return NULL;
+
+	BPath adapterDirectory;
+	BPath bondsFile;
+	bool firstTime = SettingsFile::AdapterDirectory(directory, adapter,
+			adapterDirectory) == B_OK
+		&& bondsFile.SetTo(adapterDirectory.Path(), "bonds") == B_OK
+		&& !BEntry(bondsFile.Path()).Exists();
+
+	BondStore* bonds = new(std::nothrow) BondStore(directory, adapter,
+		fKeyVault);
+	if (bonds == NULL || !fBondStores.AddItem(bonds)) {
+		delete bonds;
+		return NULL;
+	}
+	bonds->Load();
+	if (firstTime)
+		_ImportPairedDevicesFile(bonds, devices);
+	bonds->SetListener(this);
+	return bonds;
+}
+
+
+DeviceCache*
+BluetoothServer::DeviceCacheFor(const bdaddr_t& adapter)
+{
+	BAutolock locker(fStoresLock);
+	BPath directory;
+	if (_StateDirectory(directory) != B_OK)
+		return NULL;
+
+	for (int32 i = 0; i < fDeviceCaches.CountItems(); i++) {
+		DeviceCache* devices = fDeviceCaches.ItemAt(i);
+		if (bdaddrUtils::Compare(devices->Adapter(), adapter))
+			return devices;
+	}
+
+	DeviceCache* devices = new(std::nothrow) DeviceCache(directory, adapter);
+	if (devices == NULL || !fDeviceCaches.AddItem(devices)) {
+		delete devices;
+		return NULL;
+	}
+	devices->Load();
+	return devices;
+}
+
+
+void
+BluetoothServer::BondChanged(const bdaddr_t& adapter, const bdaddr_t& remote,
+	int32 change)
+{
+	// any thread may change a bond: the looper tells the watchers
+	BMessage message(kMsgBondChanged);
+	message.AddData("adapter", B_RAW_TYPE, &adapter, sizeof(bdaddr_t));
+	message.AddData("address", B_RAW_TYPE, &remote, sizeof(bdaddr_t));
+	message.AddInt32("change", change);
+	PostMessage(&message);
+}
+
+
+/*!	Where the server keeps its state: a folder of the system, as the bonds
+	belong to the adapters, not to a user.
+*/
+status_t
+BluetoothServer::_StateDirectory(BPath& path)
+{
+	status_t status = find_directory(B_SYSTEM_SETTINGS_DIRECTORY, &path, true);
+	if (status == B_OK)
+		status = path.Append("bluetooth");
+	if (status == B_OK) {
+		status = create_directory(path.Path(), 0755);
+		if (status == B_FILE_EXISTS)
+			status = B_OK;
+	}
+	return status;
+}
+
+
+/*!	Takes the paired devices of the file kept before the bond store: the
+	keys become bonds of this adapter (the file did not tell which adapter
+	they were of), and what is known of every device goes to the cache.
+	The file stays as it is, for the Bluetooth audio add-on that still
+	reads it; the server no longer writes it.
+*/
+void
+BluetoothServer::_ImportPairedDevicesFile(BondStore* bonds,
+	DeviceCache* devices)
+{
+	BPath path;
+	if (find_directory(B_USER_SETTINGS_DIRECTORY, &path) != B_OK
+		|| path.Append("Bluetooth_paired_devices") != B_OK) {
+		return;
+	}
+	BFile file(path.Path(), B_READ_ONLY);
+	BMessage paired;
+	if (file.InitCheck() != B_OK || paired.Unflatten(&file) != B_OK)
+		return;
+
+	int32 bonded = 0;
+	int32 known = 0;
+	BMessage device;
+	for (int32 i = 0; paired.FindMessage("remote", i, &device) == B_OK; i++) {
+		const void* data;
+		ssize_t size;
+		if (device.FindData("bdaddr", B_ANY_TYPE, &data, &size) != B_OK
+			|| size != sizeof(bdaddr_t)) {
+			continue;
+		}
+
+		DeviceRecord record;
+		record.address = *(const bdaddr_t*)data;
+		record.name = device.GetString("name", "");
+		if (device.FindData("class_of_device", B_RAW_TYPE, &data, &size)
+				== B_OK && size == sizeof(record.deviceClass)) {
+			memcpy(record.deviceClass, data, size);
+		}
+		record.clockOffset = device.GetUInt16("clock_offset", 0);
+		record.pageScanRepetitionMode = device.GetUInt8("pscan_rep_mode", 0);
+		uint16 serviceClass;
+		while (record.serviceClassCount < B_COUNT_OF(record.serviceClasses)
+			&& device.FindUInt16("service class", record.serviceClassCount,
+				&serviceClass) == B_OK) {
+			record.serviceClasses[record.serviceClassCount++] = serviceClass;
+		}
+		devices->Update(record);
+		known++;
+
+		linkkey_t nullKey = LinkKeyUtils::NullKey();
+		if (device.FindData("link key", B_ANY_TYPE, &data, &size) == B_OK
+			&& size == sizeof(linkkey_t)
+			&& !LinkKeyUtils::Compare((linkkey_t*)data, &nullKey)
+			&& bonds->Import(record.address, *(const linkkey_t*)data,
+				device.GetUInt8("key type", kLinkKeyUnknown)) == B_OK) {
+			bonded++;
+		}
+	}
+	devices->Flush();
+
+	syslog(LOG_NOTICE, "bluetooth_server: %" B_PRId32 " bonds and %" B_PRId32
+		" devices taken from %s, which is no longer written\n", bonded,
+		known, path.Path());
+}
