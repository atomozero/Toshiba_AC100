From f43c443a06bf0d8dac653b63ca4c249571c75ac7 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Tue, 20 Oct 2026 18:10:17 +0200
Subject: [PATCH 04/63] SupportDefs: use a strong compare-and-swap in
 atomic_test_and_set()

atomic_test_and_set() and atomic_test_and_set64() used a weak
__atomic_compare_exchange_n() and returned the updated 'expected' value.
A weak CAS may fail spuriously on LL/SC architectures (a failing strex on
ARM, e.g. after an interrupt); the returned value then equals testAgainst
and is indistinguishable from success, although nothing was stored.

On ARM this let __mutex_lock() believe it owned a mutex it had never
locked, ending in 'mutex was not actually locked!' in launch_daemon,
net_server and others. x86 is not affected, as its CAS never fails
spuriously.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 headers/os/support/SupportDefs.h | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/headers/os/support/SupportDefs.h b/headers/os/support/SupportDefs.h
index 85b8affc98..ac2be17a3b 100644
--- a/headers/os/support/SupportDefs.h
+++ b/headers/os/support/SupportDefs.h
@@ -275,7 +275,7 @@ atomic_get_and_set(int32* value, int32 newValue)
 static __inline__ int32
 atomic_test_and_set(int32* value, int32 newValue, int32 testAgainst)
 {
-	__atomic_compare_exchange_n(value, &testAgainst, newValue, 1,
+	__atomic_compare_exchange_n(value, &testAgainst, newValue, 0,
 		__ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
 	return testAgainst;
 }
@@ -326,7 +326,7 @@ atomic_get_and_set64(int64* value, int64 newValue)
 static __inline__ int64
 atomic_test_and_set64(int64* value, int64 newValue, int64 testAgainst)
 {
-	__atomic_compare_exchange_n(value, &testAgainst, newValue, 1,
+	__atomic_compare_exchange_n(value, &testAgainst, newValue, 0,
 		__ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
 	return testAgainst;
 }
