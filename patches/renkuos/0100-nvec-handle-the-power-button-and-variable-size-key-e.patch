From ada163e5f83755ac1373b4b3106436c3c027ae3a Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 18 Oct 2026 16:24:59 +0200
Subject: [PATCH 100/270] nvec: handle the power button and variable size key
 events

The EC reports the power button as a variable size keyboard event
(e0 5e e0 de), which was dropped. Decode those events as scan code
sequences, and publish power/button/power_nvec: the power_daemon watches it
and asks to shut down when the button is pressed.
---
 src/add-ons/kernel/busses/i2c/nvec/nvec.cpp | 128 ++++++++++++++++++--
 1 file changed, 117 insertions(+), 11 deletions(-)

diff --git a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
index 334df375c8..c8caf4462c 100644
--- a/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
+++ b/src/add-ons/kernel/busses/i2c/nvec/nvec.cpp
@@ -27,7 +27,9 @@
 #include <device_manager.h>
 #include <bus/FDT.h>
 
+#include <fs/select_sync_pool.h>
 #include <kernel.h>
+#include <lock.h>
 #include <util/AutoLock.h>
 
 #include <ATKeymap.h>
@@ -198,6 +200,12 @@ struct nvec_device {
 	bigtime_t			repeatDelay;
 	bigtime_t			repeatRate;
 	bigtime_t			currentRepeatDelay;
+	bool				extendedKey;	// an 0xe0 prefix came
+
+	// power button, watched by the power_daemon
+	mutex				powerButtonLock;
+	uint8				powerButtonPressed;
+	select_sync_pool*	powerButtonSelectPool;
 
 	// touchpad
 	spinlock			mouseLock;
@@ -235,6 +243,7 @@ enum nvec_device_kind {
 	NVEC_KEYBOARD,
 	NVEC_MOUSE,
 	NVEC_BATTERY,
+	NVEC_POWER_BUTTON,
 };
 
 
@@ -663,18 +672,42 @@ put_key(nvec_device* device, uint32 keycode, bool down)
 
 
 static void
-handle_key_event(nvec_device* device, const nvec_msg* message)
+power_button_pressed(nvec_device* device)
 {
-	uint32 eventSize = (message->data[0] >> 5) & 3;
-	if (eventSize == NVEC_VAR_SIZE)
+	MutexLocker locker(device->powerButtonLock);
+	device->powerButtonPressed = 1;
+	if (device->powerButtonSelectPool != NULL) {
+		notify_select_event_pool(device->powerButtonSelectPool,
+			B_SELECT_READ);
+	}
+}
+
+
+/*!	Handles one byte of PS/2 scan code set 1; extended codes come with an
+	0xe0 prefix.
+*/
+static void
+handle_scan_code(nvec_device* device, uint8 code)
+{
+	if (code == 0xe0) {
+		device->extendedKey = true;
 		return;
+	}
 
-	// set 1 scan codes; extended ones come with their 0xe0 prefix
-	uint8 code = message->data[eventSize == NVEC_3BYTES ? 2 : 1];
+	bool extended = device->extendedKey;
+	device->extendedKey = false;
 	bool down = (code & 0x80) == 0;
-	uint32 scancode = (code & 0x7f) | (eventSize == NVEC_3BYTES ? 0x80 : 0);
+	uint32 scancode = (code & 0x7f) | (extended ? 0x80 : 0);
+
+	// the power button is no key: the power_daemon asks to shut down
+	if (scancode == 0xde) {
+		if (down)
+			power_button_pressed(device);
+		return;
+	}
+
 	if (scancode == 0 || scancode > B_COUNT_OF(kATKeycodeMap)) {
-		TRACE_ALWAYS("unknown key %#x\n", code);
+		TRACE_ALWAYS("unknown key %s%#x\n", extended ? "0xe0 " : "", code);
 		return;
 	}
 
@@ -682,6 +715,22 @@ handle_key_event(nvec_device* device, const nvec_msg* message)
 }
 
 
+static void
+handle_key_event(nvec_device* device, const nvec_msg* message)
+{
+	uint32 eventSize = (message->data[0] >> 5) & 3;
+	if (eventSize == NVEC_VAR_SIZE) {
+		// a sequence of scan codes, e.g. the power button's e0 5e e0 de
+		for (uint32 i = 0; i < message->data[1] && i + 2 < message->size; i++)
+			handle_scan_code(device, message->data[2 + i]);
+		return;
+	}
+
+	for (uint32 i = 1; i < (eventSize == NVEC_3BYTES ? 3u : 2u); i++)
+		handle_scan_code(device, message->data[i]);
+}
+
+
 static void
 handle_mouse_byte(nvec_device* device, uint8 byte)
 {
@@ -1031,6 +1080,8 @@ nvec_open(void* cookie, const char* path, int openMode, void** _cookie)
 		handle->kind = NVEC_KEYBOARD;
 	else if (strstr(path, "mouse") != NULL)
 		handle->kind = NVEC_MOUSE;
+	else if (strstr(path, "button") != NULL)
+		handle->kind = NVEC_POWER_BUTTON;
 	else
 		handle->kind = NVEC_BATTERY;
 	*_cookie = handle;
@@ -1056,8 +1107,56 @@ nvec_free(void* cookie)
 static status_t
 nvec_read(void* cookie, off_t position, void* buffer, size_t* _length)
 {
-	*_length = 0;
-	return B_NOT_ALLOWED;
+	nvec_handle* handle = (nvec_handle*)cookie;
+	if (handle->kind != NVEC_POWER_BUTTON || *_length < 1) {
+		*_length = 0;
+		return B_NOT_ALLOWED;
+	}
+
+	// 1 if the button was pressed since the last read
+	nvec_device* device = handle->device;
+	MutexLocker locker(device->powerButtonLock);
+	uint8 pressed = device->powerButtonPressed;
+	device->powerButtonPressed = 0;
+	locker.Unlock();
+
+	if (!IS_USER_ADDRESS(buffer)
+		|| user_memcpy(buffer, &pressed, sizeof(pressed)) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+	*_length = 1;
+	return B_OK;
+}
+
+
+static status_t
+nvec_select(void* cookie, uint8 event, selectsync* sync)
+{
+	nvec_handle* handle = (nvec_handle*)cookie;
+	if (handle->kind != NVEC_POWER_BUTTON || event != B_SELECT_READ)
+		return B_BAD_VALUE;
+
+	nvec_device* device = handle->device;
+	MutexLocker locker(device->powerButtonLock);
+	status_t status = add_select_sync_pool_entry(
+		&device->powerButtonSelectPool, sync, event);
+	if (status == B_OK && device->powerButtonPressed != 0)
+		notify_select_event(sync, event);
+	return status;
+}
+
+
+static status_t
+nvec_deselect(void* cookie, uint8 event, selectsync* sync)
+{
+	nvec_handle* handle = (nvec_handle*)cookie;
+	if (handle->kind != NVEC_POWER_BUTTON || event != B_SELECT_READ)
+		return B_BAD_VALUE;
+
+	nvec_device* device = handle->device;
+	MutexLocker locker(device->powerButtonLock);
+	return remove_select_sync_pool_entry(&device->powerButtonSelectPool, sync,
+		event);
 }
 
 
@@ -1352,6 +1451,7 @@ nvec_init_driver(device_node* node, void** _cookie)
 	device->keyLock = B_SPINLOCK_INITIALIZER;
 	device->mouseLock = B_SPINLOCK_INITIALIZER;
 	device->batteryLock = B_SPINLOCK_INITIALIZER;
+	mutex_init(&device->powerButtonLock, "nvec power button");
 	device->registersArea = device->gpioArea = -1;
 	device->rxSem = device->txSem = device->transferSem = device->keySem
 		= device->mouseSem = -1;
@@ -1436,6 +1536,7 @@ nvec_init_driver(device_node* node, void** _cookie)
 
 err:
 	TRACE_ALWAYS("init failed: %s\n", strerror(status));
+	mutex_destroy(&device->powerButtonLock);
 	delete_sem(device->rxSem);
 	delete_sem(device->txSem);
 	delete_sem(device->transferSem);
@@ -1458,6 +1559,7 @@ nvec_uninit_driver(void* cookie)
 
 	device->stopping = true;
 	remove_io_interrupt_handler(device->irq, nvec_interrupt, device);
+	mutex_destroy(&device->powerButtonLock);
 	delete_sem(device->rxSem);
 	delete_sem(device->txSem);
 	delete_sem(device->transferSem);
@@ -1488,6 +1590,10 @@ nvec_register_child_devices(void* cookie)
 		status = gDeviceManager->publish_device(device->node,
 			"power/nvec_battery/0", NVEC_DEVICE_MODULE_NAME);
 	}
+	if (status == B_OK) {
+		status = gDeviceManager->publish_device(device->node,
+			"power/button/power_nvec", NVEC_DEVICE_MODULE_NAME);
+	}
 	return status;
 }
 
@@ -1519,8 +1625,8 @@ static struct device_module_info sNvecDevice = {
 	nvec_write_hook,
 	NULL,	// io
 	nvec_control,
-	NULL,	// select
-	NULL,	// deselect
+	nvec_select,
+	nvec_deselect,
 };
 
 
