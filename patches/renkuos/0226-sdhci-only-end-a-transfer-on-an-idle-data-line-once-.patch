From 4e9a3a3b010c20060dab60e6e537e2fed34b0901 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sun, 25 Oct 2026 19:30:21 +0100
Subject: [PATCH 226/270] sdhci: only end a transfer on an idle data line once
 it was busy

When the transfer complete status was not seen, a data line no longer
busy was taken as the end of the transfer. For a read, the line only
becomes busy once the device starts sending, so a read checked before
that was taken as done before it began, and its buffer kept the data of
the previous transfer. On the Toshiba AC100 eMMC the backup GPT header
read then returned the primary header, now and then, and the boot volume
was not found.

Trust the idle data line only once it was seen busy, or after 250ms, and
log when the fallback is used.

Signed-off-by: atomozero <bernardi.andrea@gmail.com>
---
 src/add-ons/kernel/busses/mmc/sdhci.cpp | 20 +++++++++++++++-----
 1 file changed, 15 insertions(+), 5 deletions(-)

diff --git a/src/add-ons/kernel/busses/mmc/sdhci.cpp b/src/add-ons/kernel/busses/mmc/sdhci.cpp
index 7e5dabcb57..136734151e 100644
--- a/src/add-ons/kernel/busses/mmc/sdhci.cpp
+++ b/src/add-ons/kernel/busses/mmc/sdhci.cpp
@@ -1154,7 +1154,9 @@ SdhciBus::_TransferChunk(uint8 command, uint32 argument, uint32 blockCount,
 		// and cannot be lost. SDMA stops at each buffer boundary, writing the
 		// address register again lets it continue.
 		static int32 sFallbackLogCount = 0;
-		bigtime_t deadline = system_time() + timeout;
+		bigtime_t start = system_time();
+		bigtime_t deadline = start + timeout;
+		bool sawDataLineBusy = false;
 		while (true) {
 			uint32 live = fRegisters->interrupt_status;
 			uint32 recorded = fCommandResult;
@@ -1171,10 +1173,17 @@ SdhciBus::_TransferChunk(uint8 command, uint32 argument, uint32 blockCount,
 				fRegisters->system_address = fRegisters->system_address;
 				continue;
 			}
-			if (!fRegisters->present_state.DataInhibit()) {
+			if (fRegisters->present_state.DataInhibit())
+				sawDataLineBusy = true;
+			else if (sawDataLineBusy || system_time() - start > 250000) {
 				// The controller sets the status bit and releases the data
 				// line together, so the bit may simply have arrived between
 				// the two register reads above. Check once more.
+				// Only once the data line was seen busy, though: for a read,
+				// it only becomes busy when the device starts sending, and
+				// a read taken as done before that left the data of the
+				// previous transfer in the buffer (seen on the Toshiba AC100
+				// eMMC: the backup GPT read returned the primary header).
 				uint32 again = fRegisters->interrupt_status | fCommandResult;
 				if ((again & kDataErrorBits) != 0) {
 					status = B_IO_ERROR;
@@ -1183,9 +1192,10 @@ SdhciBus::_TransferChunk(uint8 command, uint32 argument, uint32 blockCount,
 				if ((again & SDHCI_INT_TRANS_CMP) != 0)
 					break;
 				if (atomic_add(&sFallbackLogCount, 1) < 5) {
-					TRACE("transfer end detected from the data line state, "
-						"transfer complete status not seen (command %u)\n",
-						command);
+					TRACE_ALWAYS("transfer end detected from the data line "
+						"state, transfer complete status not seen (command "
+						"%u, %s)\n", command,
+						sawDataLineBusy ? "line was busy" : "after 250ms");
 				}
 				break;
 			}
