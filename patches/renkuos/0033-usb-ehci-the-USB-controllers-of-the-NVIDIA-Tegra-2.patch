+// #pragma mark - NVIDIA Tegra 2 UTMI PHY
+
+
+#define TEGRA20_CAR_BASE				0x60006000
+#define TEGRA20_AHB_BASE				0x6000c000
+#define TEGRA20_AHB_REGISTERS			0x004	// the TRM's offsets start here
+#define AHB_ARBITRATION_PRIORITY_CTRL	0x004
+#define AHB_PRIORITY_WEIGHT(x)			((uint32)(x) << 29)
+#define AHB_GIZMO_AHB_MEM				0x00c
+#define AHB_GIZMO_ENB_FAST_REARBITRATE	(1 << 2)
+#define AHB_GIZMO_IMMEDIATE				(1 << 18)
+#define AHB_PREFETCH_ENABLE				(1U << 31)
+#define AHB_PREFETCH_MST_ID(x)			((uint32)(x) << 26)
+#define AHB_PREFETCH_MST_ID_MASK		(0x1fU << 26)
+#define AHB_PREFETCH_ADDR_BNDRY(x)		((uint32)(x) << 21)
+#define AHB_PREFETCH_INACTIVITY_TIMEOUT(x)	((uint32)(x) & 0xffff)
+#define TEGRA_CAR_RST_DEVICES(bank)		(0x04 + (bank) * 4)
+#define TEGRA_CAR_CLK_OUT_ENB(bank)		(0x10 + (bank) * 4)
+#define TEGRA_CAR_OSC_CTRL				0x50
+#define TEGRA_CLOCK_USBD				22
+	// the first controller, which also holds the shared UTMI pad registers
+
+// controller registers, from the start of the controller
+#define TEGRA_USB_ICUSB_CTRL			0x16c
+#define TEGRA_USB_PORTSC1				0x184
+#define TEGRA_USB_SUSP_CTRL				0x400
+#define TEGRA_USB_PHY_VBUS_SENSORS		0x404
+#define TEGRA_UTMIP_PLL_CFG1			0x804
+#define TEGRA_UTMIP_XCVR_CFG0			0x808
+#define TEGRA_UTMIP_BIAS_CFG0			0x80c
+#define TEGRA_UTMIP_HSRX_CFG0			0x810
+#define TEGRA_UTMIP_HSRX_CFG1			0x814
+#define TEGRA_UTMIP_TX_CFG0				0x820
+#define TEGRA_UTMIP_MISC_CFG1			0x828
+#define TEGRA_UTMIP_DEBOUNCE_CFG0		0x82c
+#define TEGRA_UTMIP_BAT_CHRG_CFG0		0x830
+#define TEGRA_UTMIP_SPARE_CFG0			0x834
+#define TEGRA_UTMIP_XCVR_CFG1			0x838
+#define TEGRA_UTMIP_BIAS_CFG1			0x83c
+
+#define UTMIP_PHY_ENB					(1 << 12)
+#define UTMIP_RESET						(1 << 11)
+#define USB_PHY_CLK_VALID				(1 << 7)
+#define VBUS_B_SESS_VLD_SW_VALUE		(1 << 12)
+#define VBUS_B_SESS_VLD_SW_EN			(1 << 11)
+#define UTMIP_PHY_XTAL_CLOCKEN			(1 << 30)
+#define UTMIP_OTGPD						(1 << 11)
+#define UTMIP_BIASPD					(1 << 10)
+#define UTMIP_FS_PREAMBLE_J				(1 << 19)
+#define UTMIP_PD_CHRG					(1 << 0)
+#define FUSE_SETUP_SEL					(1 << 3)
+#define UTMIP_XCVR_LSBIAS_SE			(1 << 21)
+#define UTMIP_FORCE_PD_POWERDOWN		(1 << 14)
+#define UTMIP_FORCE_PD2_POWERDOWN		(1 << 16)
+#define UTMIP_FORCE_PDZI_POWERDOWN		(1 << 18)
+#define UTMIP_FORCE_PDDISC_POWERDOWN	(1 << 0)
+#define UTMIP_FORCE_PDCHRP_POWERDOWN	(1 << 2)
+#define UTMIP_FORCE_PDDR_POWERDOWN		(1 << 4)
+#define IC_ENB1							(1 << 3)
+#define UTMIP_XCVR_SETUP(x)				((x) & 0xf)
+#define UTMIP_XCVR_SETUP_MSB(x)			((((x) & 0x70) >> 4) << 22)
+#define UTMIP_XCVR_LSRSLEW(x)			(((x) & 0x3) << 8)
+#define UTMIP_XCVR_LSFSLEW(x)			(((x) & 0x3) << 10)
+#define UTMIP_XCVR_TERM_RANGE_ADJ(x)	(((x) & 0xf) << 18)
+#define TEGRA_PORTSC_PTS_MASK			(3U << 30)
+#define TEGRA_PORTSC_STS				(1 << 29)
+
+// ULPI (USB2 with an external PHY)
+#define TEGRA20_APB_MISC_BASE			0x70000000
+#define TEGRA20_GPIO_BASE				0x6000d000
+#define TEGRA_CAR_PLLP_OUTB				0x0a8
+#define TEGRA_CAR_SCLK_BURST_POLICY		0x028
+#define TEGRA_SCLK_SOURCE_PLLP_OUT4		2
+#define TEGRA_SCLK_SOURCE_PLLP_OUT3		3
+#define TEGRA_CLOCK_CDEV2				(64 + 29)	// CLK_ENB_DEV2_OUT
+#define TEGRA_TRISTATE_REG_A			0x014
+#define TEGRA_TRISTATE_REG_B			0x018
+#define TEGRA_TRISTATE_REG_D			0x020
+#define TEGRA_PIN_MUX_CTL_A				0x080
+#define TEGRA_PIN_MUX_CTL_C				0x088
+#define TEGRA_GPIO_REG(gpio, reg)		(((gpio) / 32) * 0x80 \
+	+ (((gpio) / 8) % 4) * 4 + (reg))
+#define TEGRA_GPIO_MSK_CNF				0x800
+#define TEGRA_GPIO_MSK_OE				0x810
+#define TEGRA_GPIO_MSK_OUT				0x820
+#define TEGRA_USB_ULPI_VIEWPORT			0x170
+#define TEGRA_ULPI_TIMING_CTRL_0		0x424
+#define TEGRA_ULPI_TIMING_CTRL_1		0x428
+#define USB_SUSP_CLR					(1 << 5)
+#define ULPI_PHY_ENB					(1 << 13)
+#define UHSIC_RESET						(1 << 14)
+#define ULPI_OUTPUT_PINMUX_BYP			(1 << 10)
+#define ULPI_CLKOUT_PINMUX_BYP			(1 << 11)
+#define ULPI_DATA_TRIMMER_LOAD			(1 << 0)
+#define ULPI_DATA_TRIMMER_SEL(x)		(((x) & 0x7) << 1)
+#define ULPI_STPDIRNXT_TRIMMER_LOAD		(1 << 16)
+#define ULPI_STPDIRNXT_TRIMMER_SEL(x)	(((x) & 0x7) << 17)
+#define ULPI_DIR_TRIMMER_LOAD			(1 << 24)
+#define ULPI_DIR_TRIMMER_SEL(x)			(((x) & 0x7) << 25)
+#define ULPI_VIEW_WAKEUP				(1U << 31)
+#define ULPI_VIEW_RUN					(1 << 30)
+#define ULPI_VIEW_WRITE					(1 << 29)
+#define ULPI_VIEW_ADDR(x)				(((x) & 0xff) << 16)
+
+// PLL-U delays per oscillator frequency (OSC_CTRL[31:30]: 13, 19.2, 12 and
+// 26 MHz): enable delay, stable count, active delay, crystal frequency count,
+// debounce time, bias time
+static const uint32 kTegra20UTMITimings[4][6] = {
+	{ 0x02, 0x33, 0x05, 0x7f, 0x7ef4, 5 },
+	{ 0x03, 0x4b, 0x06, 0xbb, 0xbb80, 7 },
+	{ 0x02, 0x2f, 0x04, 0x76, 0x7530, 5 },
+	{ 0x04, 0x66, 0x09, 0xfe, 0xfde8, 9 },
+};
+
+
+static inline void
+tegra_set_bits(volatile uint32* reg, uint32 mask, uint32 value)
+{
+	*reg = (*reg & ~mask) | value;
+}
+
+
+/*!	The AHB settings the Tegra 2 TRM asks for before a USB controller runs
+	(26.3.6 "Performance Settings for USB Controllers"): fast re-arbitration
+	on the memory port, IMMEDIATE on the controller's gizmo, the controller
+	as a high priority master with weight 7, and a prefetch channel for it.
+	Without them the controller can lose the bus to other masters for long
+	enough to miss split transaction slots.
+*/
+static void
+tegra20_usb_ahb_setup(phys_addr_t registers)
+{
+	// gizmo register, AHB master number, prefetch channel register
+	uint32 gizmo, master, prefetch;
+	switch (registers) {
+		case 0xc5000000:
+			gizmo = 0x01c; master = 6; prefetch = 0x0f0;	// USB1, CFG2
+			break;
+		case 0xc5004000:
+			gizmo = 0x078; master = 18; prefetch = 0x0e4;	// USB2, CFG4
+			break;
+		case 0xc5008000:
+			gizmo = 0x07c; master = 17; prefetch = 0x0e0;	// USB3, CFG3
+			break;
+		default:
+			return;
+	}
+
+	void* address;
+	area_id area = map_physical_memory("tegra ahb", TEGRA20_AHB_BASE,
+		B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+	if (area < B_OK)
+		return;
+#define AHB_REG(offset) \
+	((volatile uint32*)((uint8*)address + TEGRA20_AHB_REGISTERS + (offset)))
+
+	tegra_set_bits(AHB_REG(AHB_GIZMO_AHB_MEM), AHB_GIZMO_ENB_FAST_REARBITRATE,
+		AHB_GIZMO_ENB_FAST_REARBITRATE);
+	tegra_set_bits(AHB_REG(gizmo), AHB_GIZMO_IMMEDIATE, AHB_GIZMO_IMMEDIATE);
+	tegra_set_bits(AHB_REG(AHB_ARBITRATION_PRIORITY_CTRL),
+		AHB_PRIORITY_WEIGHT(7) | (1U << master),
+		AHB_PRIORITY_WEIGHT(7) | (1U << master));
+	// 64 KB boundary, the inactivity timeout the TRM asks for
+	*AHB_REG(prefetch) = AHB_PREFETCH_ENABLE | AHB_PREFETCH_MST_ID(master)
+		| AHB_PREFETCH_ADDR_BNDRY(12) | AHB_PREFETCH_INACTIVITY_TIMEOUT(0x800);
+
+#undef AHB_REG
+	delete_area(area);
+}
+
+
+static status_t
+tegra_ulpi_wait(volatile uint32* view, uint32 mask)
+{
+	bigtime_t start = system_time();
+	while ((*view & mask) != 0) {
+		if (system_time() - start > 2000)
+			return B_TIMED_OUT;
+		spin(1);
+	}
+	return B_OK;
+}
+
+
+//!	Reads a register of the external PHY through the ULPI viewport.
+static int32
+tegra_ulpi_read(volatile uint32* view, uint8 reg)
+{
+	*view = ULPI_VIEW_WAKEUP | ULPI_VIEW_WRITE;
+	if (tegra_ulpi_wait(view, ULPI_VIEW_WAKEUP) != B_OK)
+		return B_TIMED_OUT;
+	*view = ULPI_VIEW_RUN | ULPI_VIEW_ADDR(reg);
+	if (tegra_ulpi_wait(view, ULPI_VIEW_RUN) != B_OK)
+		return B_TIMED_OUT;
+	return (*view >> 8) & 0xff;
+}
+
+
+static status_t
+tegra_ulpi_write(volatile uint32* view, uint8 reg, uint8 value)
+{
+	*view = ULPI_VIEW_WAKEUP | ULPI_VIEW_WRITE;
+	if (tegra_ulpi_wait(view, ULPI_VIEW_WAKEUP) != B_OK)
+		return B_TIMED_OUT;
+	*view = ULPI_VIEW_RUN | ULPI_VIEW_WRITE | ULPI_VIEW_ADDR(reg) | value;
+	return tegra_ulpi_wait(view, ULPI_VIEW_RUN);
+}
+
+
+/*!	Returns the reset GPIO of the external ULPI PHY ("nvidia,phy-reset-gpio"
+	of the node "nvidia,phy" points to), or -1.
+*/
+static int32
+tegra_ulpi_reset_gpio(fdt_device_module_info* fdt, fdt_device* fdtDevice,
+	bool* _activeLow)
+{
+	// older device trees have the GPIO in the controller's node
+	int length;
+	const uint32* gpio = (const uint32*)fdt->get_prop(fdtDevice,
+		"nvidia,phy-reset-gpio", &length);
+	if (gpio != NULL && length >= 12) {
+		*_activeLow = (B_BENDIAN_TO_HOST_INT32(gpio[2]) & 1) != 0;
+		return B_BENDIAN_TO_HOST_INT32(gpio[1]);
+	}
+
+	const uint32* phy = (const uint32*)fdt->get_prop(fdtDevice, "nvidia,phy",
+		&length);
+	if (phy == NULL || length < 4)
+		return -1;
+
+	device_node* busNode = fdt->get_bus(fdtDevice);
+	fdt_bus_module_info* busModule;
+	struct fdt_bus* bus;
+	if (busNode == NULL || gDeviceManager->get_driver(busNode,
+			(driver_module_info**)&busModule, (void**)&bus) != B_OK) {
+		return -1;
+	}
+	device_node* phyNode = busModule->node_by_phandle(bus,
+		B_BENDIAN_TO_HOST_INT32(phy[0]));
+	fdt_device_module_info* phyModule;
+	fdt_device* phyDevice;
+	if (phyNode == NULL || gDeviceManager->get_driver(phyNode,
+			(driver_module_info**)&phyModule, (void**)&phyDevice) != B_OK) {
+		return -1;
+	}
+
+	gpio = (const uint32*)phyModule->get_prop(phyDevice,
+		"nvidia,phy-reset-gpio", &length);
+	if (gpio == NULL || length < 12)
+		return -1;
+	*_activeLow = (B_BENDIAN_TO_HOST_INT32(gpio[2]) & 1) != 0;
+	return B_BENDIAN_TO_HOST_INT32(gpio[1]);
+}
+
+
+/*!	Brings up a Tegra 2 USB controller with an external ULPI PHY (the USB2
+	controller), following the TRM (26.3.3) and Linux: the 24 MHz link clock
+	on the CDEV2 pad, the ULPI pins, the PHY reset GPIO, then the link.
+*/
+static status_t
+tegra20_ulpi_phy_init(fdt_device_module_info* fdt, fdt_device* fdtDevice,
+	phys_addr_t registers, uint32 clock)
+{
+	bool activeLow = true;
+	int32 resetGPIO = tegra_ulpi_reset_gpio(fdt, fdtDevice, &activeLow);
+
+	volatile uint32* car;
+	area_id carArea = map_physical_memory("tegra car", TEGRA20_CAR_BASE,
+		B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, (void**)&car);
+	volatile uint8* misc;
+	area_id miscArea = map_physical_memory("tegra apb misc",
+		TEGRA20_APB_MISC_BASE, B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, (void**)&misc);
+	volatile uint8* gpio;
+	area_id gpioArea = map_physical_memory("tegra gpio", TEGRA20_GPIO_BASE,
+		B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, (void**)&gpio);
+	volatile uint8* usb;
+	area_id usbArea = map_physical_memory("tegra usb phy", registers,
+		0x1000, B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+		(void**)&usb);
+	if (carArea < B_OK || miscArea < B_OK || gpioArea < B_OK
+		|| usbArea < B_OK) {
+		delete_area(carArea);
+		delete_area(miscArea);
+		delete_area(gpioArea);
+		delete_area(usbArea);
+		return B_NO_MEMORY;
+	}
+#define MISC_REG(offset)	((volatile uint32*)(misc + (offset)))
+#define GPIO_REG(offset)	((volatile uint32*)(gpio + (offset)))
+#define USB_REG(offset)		((volatile uint32*)(usb + (offset)))
+
+	// The link clock: PLLP_OUT4 at 24 MHz (216 / 9) out of the CDEV2 pad.
+	// The boot firmware may run the system clock from PLLP_OUT4 (108 MHz):
+	// move it to PLLP_OUT3 (72 MHz, left as it is) first, as Linux moves it
+	// away (to PLLC_OUT1) before setting PLLP_OUT4 to 24 MHz.
+	uint32 sclk = car[TEGRA_CAR_SCLK_BURST_POLICY / 4];
+	uint32 newSclk = sclk;
+	for (int shift = 0; shift < 16; shift += 4) {
+		if (((sclk >> shift) & 0xf) == TEGRA_SCLK_SOURCE_PLLP_OUT4) {
+			newSclk = (newSclk & ~(0xfU << shift))
+				| (TEGRA_SCLK_SOURCE_PLLP_OUT3 << shift);
+		}
+	}
+	uint32 outb = car[TEGRA_CAR_PLLP_OUTB / 4];
+	if (newSclk != sclk && (outb >> 24) != 16) {
+		if ((outb & 3) != 3) {
+			TRACE_MODULE_ERROR("ULPI: the system clock runs from PLLP_OUT4 "
+				"and PLLP_OUT3 is off, no USB2\n");
+			delete_area(carArea);
+			delete_area(miscArea);
+			delete_area(gpioArea);
+			delete_area(usbArea);
+			return B_NOT_SUPPORTED;
+		}
+		car[TEGRA_CAR_SCLK_BURST_POLICY / 4] = newSclk;
+		spin(10);
+	}
+	if ((outb >> 24) != 16 || (outb & (7 << 16)) != (7 << 16)) {
+		outb &= 0xffff;
+		car[TEGRA_CAR_PLLP_OUTB / 4] = outb | (16 << 24) | (1 << 18);
+		spin(2);
+		car[TEGRA_CAR_PLLP_OUTB / 4] = outb | (16 << 24) | (7 << 16);
+	}
+	tegra_set_bits(MISC_REG(TEGRA_PIN_MUX_CTL_C), 3 << 4, 3 << 4);
+	tegra_set_bits(MISC_REG(TEGRA_TRISTATE_REG_A), 1 << 5, 0);
+
+	// the ULPI pins: UAA, UAB and UDA
+	tegra_set_bits(MISC_REG(TEGRA_PIN_MUX_CTL_A), (3 << 8) | (3 << 2) | 3,
+		(3 << 8) | (3 << 2) | 3);
+	tegra_set_bits(MISC_REG(TEGRA_TRISTATE_REG_B), (1 << 19) | (1 << 18), 0);
+	tegra_set_bits(MISC_REG(TEGRA_TRISTATE_REG_D), 1 << 13, 0);
+
+	// Reset the controller, with its clock running
+	uint32 bank = clock / 32;
+	uint32 bit = 1U << (clock % 32);
+	car[TEGRA_CAR_CLK_OUT_ENB(bank) / 4] |= bit;
+	car[TEGRA_CAR_RST_DEVICES(bank) / 4] |= bit;
+	spin(2);
+	car[TEGRA_CAR_RST_DEVICES(bank) / 4] &= ~bit;
+	spin(2);
+
+	// Hold the PHY in reset while its clock starts
+	uint32 gpioBit = 0;
+	if (resetGPIO >= 0) {
+		gpioBit = 1U << (resetGPIO % 8);
+		*GPIO_REG(TEGRA_GPIO_REG(resetGPIO, TEGRA_GPIO_MSK_OUT))
+			= (gpioBit << 8) | (activeLow ? 0 : gpioBit);
+		*GPIO_REG(TEGRA_GPIO_REG(resetGPIO, TEGRA_GPIO_MSK_OE))
+			= (gpioBit << 8) | gpioBit;
+		*GPIO_REG(TEGRA_GPIO_REG(resetGPIO, TEGRA_GPIO_MSK_CNF))
+			= (gpioBit << 8) | gpioBit;
+	}
+	uint32 cdev2 = 1U << (TEGRA_CLOCK_CDEV2 % 32);
+	car[TEGRA_CAR_CLK_OUT_ENB(TEGRA_CLOCK_CDEV2 / 32) / 4] |= cdev2;
+	snooze(5000);
+	if (resetGPIO >= 0) {
+		*GPIO_REG(TEGRA_GPIO_REG(resetGPIO, TEGRA_GPIO_MSK_OUT))
+			= (gpioBit << 8) | (activeLow ? gpioBit : 0);
+	}
+	snooze(2000);
+
+	// Select the ULPI link
+	*USB_REG(TEGRA_USB_SUSP_CTRL) |= UHSIC_RESET;
+	*USB_REG(TEGRA_ULPI_TIMING_CTRL_0)
+		|= ULPI_OUTPUT_PINMUX_BYP | ULPI_CLKOUT_PINMUX_BYP;
+	*USB_REG(TEGRA_USB_SUSP_CTRL) |= ULPI_PHY_ENB;
+
+	uint32 trimmers = ULPI_DATA_TRIMMER_SEL(4) | ULPI_STPDIRNXT_TRIMMER_SEL(4)
+		| ULPI_DIR_TRIMMER_SEL(4);
+	*USB_REG(TEGRA_ULPI_TIMING_CTRL_1) = 0;
+	*USB_REG(TEGRA_ULPI_TIMING_CTRL_1) = trimmers;
+	spin(10);
+	*USB_REG(TEGRA_ULPI_TIMING_CTRL_1) = trimmers | ULPI_DATA_TRIMMER_LOAD
+		| ULPI_STPDIRNXT_TRIMMER_LOAD | ULPI_DIR_TRIMMER_LOAD;
+
+	// Talk to the PHY: its IDs, then the VBUS fix-up Linux applies (VBUS is
+	// floating: use the external VBUS indicator)
+	volatile uint32* view = USB_REG(TEGRA_USB_ULPI_VIEWPORT);
+	int32 id[4];
+	for (int i = 0; i < 4; i++)
+		id[i] = tegra_ulpi_read(view, i);
+	status_t status = tegra_ulpi_write(view, 0x08, 0x40);
+	if (status == B_OK)
+		status = tegra_ulpi_write(view, 0x0b, 0x80);
+	if (status != B_OK) {
+		TRACE_MODULE_ERROR("ULPI PHY %02" B_PRIx32 "%02" B_PRIx32 ":%02"
+			B_PRIx32 "%02" B_PRIx32 ": setup failed: %s\n", id[1], id[0],
+			id[3], id[2], strerror(status));
+	}
+
+	*USB_REG(TEGRA_USB_SUSP_CTRL) |= USB_SUSP_CLR;
+	snooze(500);
+	*USB_REG(TEGRA_USB_SUSP_CTRL) &= ~USB_SUSP_CLR;
+
+	bigtime_t start = system_time();
+	while ((*USB_REG(TEGRA_USB_SUSP_CTRL) & USB_PHY_CLK_VALID) == 0
+		&& system_time() - start < 100000) {
+		spin(10);
+	}
+	bool valid = (*USB_REG(TEGRA_USB_SUSP_CTRL) & USB_PHY_CLK_VALID) != 0;
+#undef MISC_REG
+#undef GPIO_REG
+#undef USB_REG
+
+	delete_area(usbArea);
+	delete_area(gpioArea);
+	delete_area(miscArea);
+	delete_area(carArea);
+
+	if (!valid)
+		return B_TIMED_OUT;
+
+	tegra20_usb_ahb_setup(registers);
+	return B_OK;
+}
+
+
+/*!	Brings the UTMI PHY of a Tegra 2 USB controller up, the way the boot
+	firmware and Linux do. The firmware may have used the controller, but left
+	it in a state where the PHY clock is not valid, and accessing the
+	controller then stalls the CPU.
+*/
+static status_t
+tegra20_utmi_phy_init(fdt_device_module_info* fdt, fdt_device* fdtDevice,
+	phys_addr_t registers)
+{
+	int length;
+	const char* phyType = (const char*)fdt->get_prop(fdtDevice, "phy_type",
+		&length);
+	if (phyType == NULL)
+		return B_OK;
+
+	const uint32* clocks = (const uint32*)fdt->get_prop(fdtDevice, "clocks",
+		&length);
+	if (clocks == NULL || length < 8)
+		return B_BAD_DATA;
+	uint32 clock = B_BENDIAN_TO_HOST_INT32(clocks[1]);
+
+	if (strcmp(phyType, "ulpi") == 0)
+		return tegra20_ulpi_phy_init(fdt, fdtDevice, registers, clock);
+	if (strcmp(phyType, "utmi") != 0)
+		return B_OK;
+
+	volatile uint32* car;
+	area_id carArea = map_physical_memory("tegra car", TEGRA20_CAR_BASE,
+		B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, (void**)&car);
+	if (carArea < B_OK)
+		return carArea;
+
+	volatile uint8* usb;
+	area_id usbArea = map_physical_memory("tegra usb phy", registers,
+		0x1000, B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+		(void**)&usb);
+	volatile uint8* usb1;
+	area_id usb1Area = map_physical_memory("tegra usb1 pads",
+		registers & ~(phys_addr_t)0xffff, 0x1000, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, (void**)&usb1);
+	if (usbArea < B_OK || usb1Area < B_OK) {
+		delete_area(carArea);
+		delete_area(usbArea);
+		delete_area(usb1Area);
+		return B_NO_MEMORY;
+	}
+#define USB_REG(offset)		((volatile uint32*)(usb + (offset)))
+
+	const uint32* timing
+		= kTegra20UTMITimings[car[TEGRA_CAR_OSC_CTRL / 4] >> 30];
+
+	// The shared UTMI pads are controlled through the first controller,
+	// whose clock must be running
+	uint32 usbdBit = 1U << TEGRA_CLOCK_USBD;
+	car[TEGRA_CAR_CLK_OUT_ENB(0) / 4] |= usbdBit;
+	car[TEGRA_CAR_RST_DEVICES(0) / 4] &= ~usbdBit;
+
+	// Reset the controller, with its clock running
+	uint32 bank = clock / 32;
+	uint32 bit = 1U << (clock % 32);
+	car[TEGRA_CAR_CLK_OUT_ENB(bank) / 4] |= bit;
+	car[TEGRA_CAR_RST_DEVICES(bank) / 4] |= bit;
+	spin(2);
+	car[TEGRA_CAR_RST_DEVICES(bank) / 4] &= ~bit;
+	spin(2);
+
+	// Power the shared pads up
+	*(volatile uint32*)(usb1 + TEGRA_UTMIP_BIAS_CFG0)
+		&= ~(UTMIP_OTGPD | UTMIP_BIASPD);
+
+	*USB_REG(TEGRA_USB_SUSP_CTRL) |= UTMIP_RESET | UTMIP_PHY_ENB;
+
+	// Stop the crystal clock while the PHY is configured
+	*USB_REG(TEGRA_UTMIP_MISC_CFG1) &= ~UTMIP_PHY_XTAL_CLOCKEN;
+	spin(1);
+
+	*USB_REG(TEGRA_USB_PHY_VBUS_SENSORS)
+		&= ~(VBUS_B_SESS_VLD_SW_VALUE | VBUS_B_SESS_VLD_SW_EN);
+
+	tegra_set_bits(USB_REG(TEGRA_UTMIP_MISC_CFG1), (0xfff << 6) | (0x1f << 18),
+		(timing[1] << 6) | (timing[2] << 18));
+	tegra_set_bits(USB_REG(TEGRA_UTMIP_PLL_CFG1), (0x1f << 27) | 0xfff,
+		(timing[0] << 27) | timing[3]);
+	tegra_set_bits(USB_REG(TEGRA_UTMIP_BIAS_CFG1), 0x1f << 3, timing[5] << 3);
+	tegra_set_bits(USB_REG(TEGRA_UTMIP_DEBOUNCE_CFG0), 0xffff, timing[4]);
+
+	*USB_REG(TEGRA_UTMIP_TX_CFG0) |= UTMIP_FS_PREAMBLE_J;
+	*USB_REG(TEGRA_UTMIP_BAT_CHRG_CFG0) |= UTMIP_PD_CHRG;
+	*USB_REG(TEGRA_UTMIP_XCVR_CFG0) &= ~UTMIP_XCVR_LSBIAS_SE;
+	*USB_REG(TEGRA_UTMIP_SPARE_CFG0) &= ~FUSE_SETUP_SEL;
+
+	// idle wait, elastic limit and HS sync start delay, the values all Tegra 2
+	// device trees use
+	tegra_set_bits(USB_REG(TEGRA_UTMIP_HSRX_CFG0), (0x1f << 15) | (0x1f << 10),
+		(17 << 15) | (16 << 10));
+	tegra_set_bits(USB_REG(TEGRA_UTMIP_HSRX_CFG1), 0x1f << 1, 9 << 1);
+
+	spin(1);
+	*USB_REG(TEGRA_UTMIP_MISC_CFG1) |= UTMIP_PHY_XTAL_CLOCKEN;
+
+	// Take the PHY out of reset and wait for its clock
+	*USB_REG(TEGRA_USB_SUSP_CTRL) &= ~UTMIP_RESET;
+	bigtime_t start = system_time();
+	while ((*USB_REG(TEGRA_USB_SUSP_CTRL) & USB_PHY_CLK_VALID) == 0
+		&& system_time() - start < 100000) {
+		spin(10);
+	}
+	bool valid = (*USB_REG(TEGRA_USB_SUSP_CTRL) & USB_PHY_CLK_VALID) != 0;
+
+	if (valid) {
+		*USB_REG(TEGRA_USB_ICUSB_CTRL) &= ~IC_ENB1;
+
+		// UTMI parallel interface
+		*USB_REG(TEGRA_USB_PORTSC1)
+			&= ~(TEGRA_PORTSC_PTS_MASK | TEGRA_PORTSC_STS);
+
+		// The controller reset put the transceiver settings back to their
+		// defaults: use the values of the Tegra 2 device trees (HS drive
+		// strength, FS/LS slew rates, termination), as Linux does
+		tegra_set_bits(USB_REG(TEGRA_UTMIP_XCVR_CFG0),
+			UTMIP_FORCE_PD_POWERDOWN | UTMIP_FORCE_PD2_POWERDOWN
+				| UTMIP_FORCE_PDZI_POWERDOWN | UTMIP_XCVR_SETUP(0xf)
+				| UTMIP_XCVR_SETUP_MSB(0x7f) | UTMIP_XCVR_LSRSLEW(3)
+				| UTMIP_XCVR_LSFSLEW(3),
+			UTMIP_XCVR_SETUP(9) | UTMIP_XCVR_SETUP_MSB(9)
+				| UTMIP_XCVR_LSRSLEW(1) | UTMIP_XCVR_LSFSLEW(1));
+		tegra_set_bits(USB_REG(TEGRA_UTMIP_XCVR_CFG1),
+			UTMIP_FORCE_PDDISC_POWERDOWN | UTMIP_FORCE_PDCHRP_POWERDOWN
+				| UTMIP_FORCE_PDDR_POWERDOWN | UTMIP_XCVR_TERM_RANGE_ADJ(0xf),
+			UTMIP_XCVR_TERM_RANGE_ADJ(6));
+	}
+#undef USB_REG
+
+	delete_area(usb1Area);
+	delete_area(usbArea);
+	delete_area(carArea);
+
+	if (!valid) {
+		TRACE_MODULE_ERROR("Tegra UTMI PHY clock did not become valid\n");
+		return B_TIMED_OUT;
+	}
+
+	tegra20_usb_ahb_setup(registers);
+	return B_OK;
+}
+
+
+// Device tree controllers we support
+static const struct {
+	const char* compatible;
+	size_t capability_offset;
+	uint32 flags;
+	status_t (*setup_phy)(fdt_device_module_info* fdt, fdt_device* device,
+		phys_addr_t registers);
+} kFDTControllers[] = {
+	// NVIDIA Tegra 2 (ChipIdea core)
+	{ "nvidia,tegra20-ehci", 0x100, EHCI::kIntegratedTT,
+		&tegra20_utmi_phy_init },
+};
+
+
+static int32
+find_fdt_controller(device_node* node)
+{
+	const char* compatible;
+	if (gDeviceManager->get_attr_string(node, "fdt/compatible", &compatible,
+			false) != B_OK) {
+		return -1;
+	}
+
+	for (size_t i = 0; i < B_COUNT_OF(kFDTControllers); i++) {
+		if (strcmp(compatible, kFDTControllers[i].compatible) == 0)
+			return i;
+	}
+	return -1;
+}
