diff --git a/src/system/kernel/arch/arm/soc_tegra.cpp b/src/system/kernel/arch/arm/soc_tegra.cpp
new file mode 100644
index 0000000000..f5ca1931b6
--- /dev/null
+++ b/src/system/kernel/arch/arm/soc_tegra.cpp
@@ -0,0 +1,147 @@
+/*
+ * Copyright 2026, Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "soc_tegra.h"
+
+#include <int.h>
+#include <timer.h>
+#include <vm/vm.h>
+
+
+// Register offsets, in bytes, from the timer block base
+// (see drivers/clocksource/timer-tegra.c in Linux)
+#define TMR1_BASE			0x00
+#define TMR2_BASE			0x08
+#define TIMERUS_CNTR_1US	0x10
+
+#define TMR_PTV				0x0
+#define TMR_PTV_EN			(1U << 31)
+#define TMR_PTV_PER			(1U << 30)
+#define TMR_PTV_MAX			0x1fffffff
+#define TMR_PCR				0x4
+#define TMR_PCR_INTR_CLR	(1U << 30)
+
+// The binding lists one interrupt per timer, TMR1 first and TMR2 next
+#define TMR2_INTERRUPT_OFFSET	1
+
+// Well below the TIMERUS wrap time of 2^32 µs (about 71 minutes)
+#define WRAP_TICK_PERIOD	TMR_PTV_MAX
+
+
+static inline uint32
+read_reg(volatile uint32* regs, uint32 offset)
+{
+	return regs[offset / sizeof(uint32)];
+}
+
+
+static inline void
+write_reg(volatile uint32* regs, uint32 offset, uint32 value)
+{
+	regs[offset / sizeof(uint32)] = value;
+}
+
+
+TegraTimer::TegraTimer(phys_addr_t regBase, uint32 interrupt)
+	:
+	fEventInterrupt(interrupt),
+	fWrapInterrupt(interrupt + TMR2_INTERRUPT_OFFSET),
+	fLock(B_SPINLOCK_INITIALIZER),
+	fHighTime(0)
+{
+	fRegArea = vm_map_physical_memory(B_SYSTEM_TEAM, "timer-tegra",
+		(void**)&fRegs, B_ANY_KERNEL_ADDRESS, B_PAGE_SIZE,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, regBase, false);
+	if (fRegArea < 0)
+		panic("Cannot map Tegra timer registers!");
+
+	// TIMERUS is already running at 1 MHz, set up by the boot firmware
+	fLastCount = read_reg(fRegs, TIMERUS_CNTR_1US);
+
+	dprintf("Tegra: timer @ %#" B_PRIxPHYSADDR ", IRQs %" B_PRId32 "/%" B_PRId32
+		"\n", regBase, fEventInterrupt, fWrapInterrupt);
+
+	Clear();
+	install_io_interrupt_handler(fEventInterrupt,
+		&TegraTimer::_HandleEventInterrupt, this, 0);
+
+	write_reg(fRegs, TMR2_BASE + TMR_PCR, TMR_PCR_INTR_CLR);
+	install_io_interrupt_handler(fWrapInterrupt,
+		&TegraTimer::_HandleWrapInterrupt, this, 0);
+	write_reg(fRegs, TMR2_BASE + TMR_PTV,
+		TMR_PTV_EN | TMR_PTV_PER | WRAP_TICK_PERIOD);
+}
+
+
+void
+TegraTimer::SetTimeout(bigtime_t timeout)
+{
+	// The counter fires when it reaches zero after PTV + 1 ticks
+	if (timeout < 1)
+		timeout = 1;
+	if (timeout > TMR_PTV_MAX + 1)
+		timeout = TMR_PTV_MAX + 1;
+
+	write_reg(fRegs, TMR1_BASE + TMR_PTV, TMR_PTV_EN | (uint32)(timeout - 1));
+}
+
+
+bigtime_t
+TegraTimer::Time()
+{
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&fLock);
+
+	bigtime_t time = _TimeLocked();
+
+	release_spinlock(&fLock);
+	restore_interrupts(state);
+
+	return time;
+}
+
+
+void
+TegraTimer::Clear()
+{
+	write_reg(fRegs, TMR1_BASE + TMR_PTV, 0);
+	write_reg(fRegs, TMR1_BASE + TMR_PCR, TMR_PCR_INTR_CLR);
+}
+
+
+bigtime_t
+TegraTimer::_TimeLocked()
+{
+	uint32 count = read_reg(fRegs, TIMERUS_CNTR_1US);
+	if (count < fLastCount)
+		fHighTime += 1LL << 32;
+	fLastCount = count;
+
+	return fHighTime + count;
+}
+
+
+int32
+TegraTimer::_HandleEventInterrupt(void* data)
+{
+	TegraTimer* timer = (TegraTimer*)data;
+
+	timer->Clear();
+	return timer_interrupt();
+}
+
+
+int32
+TegraTimer::_HandleWrapInterrupt(void* data)
+{
+	TegraTimer* timer = (TegraTimer*)data;
+
+	write_reg(timer->fRegs, TMR2_BASE + TMR_PCR, TMR_PCR_INTR_CLR);
+
+	// Only sampling the counter matters here, see _TimeLocked()
+	timer->Time();
+	return B_HANDLED_INTERRUPT;
+}
diff --git a/src/system/kernel/arch/arm/soc_tegra.h b/src/system/kernel/arch/arm/soc_tegra.h
new file mode 100644
index 0000000000..579f09decb
--- /dev/null
+++ b/src/system/kernel/arch/arm/soc_tegra.h
@@ -0,0 +1,54 @@
+/*
+ * Copyright 2026, Haiku, Inc. All rights reserved.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef ARCH_ARM_SOC_TEGRA_H
+#define ARCH_ARM_SOC_TEGRA_H
+
+
+#include "soc.h"
+
+#include <new>
+
+#include <lock.h>
+
+
+// Timer block of NVIDIA Tegra 2 ("nvidia,tegra20-timer"): a free running
+// 1 MHz counter (TIMERUS) used as clock source and the one-shot TMR1 used
+// for timer events. TMR2 ticks periodically so that the 32-bit TIMERUS
+// counter is sampled before it wraps.
+class TegraTimer : public HardwareTimer {
+public:
+	void SetTimeout(bigtime_t timeout);
+	bigtime_t Time();
+	void Clear();
+
+	static status_t Init(phys_addr_t regBase, uint32 interrupt)
+	{
+		if (sInstance != NULL)
+			return B_OK;
+
+		TegraTimer* timer = new(std::nothrow) TegraTimer(regBase, interrupt);
+		return timer != NULL ? B_OK : B_NO_MEMORY;
+	}
+
+private:
+	TegraTimer(phys_addr_t regBase, uint32 interrupt);
+
+	bigtime_t _TimeLocked();
+
+	static int32 _HandleEventInterrupt(void* data);
+	static int32 _HandleWrapInterrupt(void* data);
+
+	area_id fRegArea;
+	volatile uint32* fRegs;
+	int32 fEventInterrupt;
+	int32 fWrapInterrupt;
+
+	spinlock fLock;
+	uint32 fLastCount;
+	bigtime_t fHighTime;
+};
+
+
+#endif /* ARCH_ARM_SOC_TEGRA_H */
