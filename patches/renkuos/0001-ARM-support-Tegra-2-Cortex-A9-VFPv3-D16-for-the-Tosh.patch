+/* d16-d31 are only touched when gARMHasVFPD32 is set, see arch_cpu.cpp */
+.fpu vfpv3
+
 /* void arm_save_fpu(struct arch_fpu_context* context); */
 FUNCTION(arm_save_fpu):
 	fstmiad		r0!, {d0-d15}
+	ldr			r1, =gARMHasVFPD32
+	ldrb		r1, [r1]
+	cmp			r1, #0
+	beq			1f
 	fstmiad		r0!, {d16-d31}
-	vmrs		r1, fpscr
+	b			2f
+1:	add			r0, r0, #128		/* keep fpscr at its fixed offset */
+2:	vmrs		r1, fpscr
 	str			r1, [r0]
 	bx			lr
 FUNCTION_END(arm_save_fpu)
@@ -87,8 +96,14 @@ FUNCTION_END(arm_save_fpu)
 /* void arm_restore_fpu(struct arch_fpu_context* context); */
 FUNCTION(arm_restore_fpu):
 	fldmiad		r0!, {d0-d15}
+	ldr			r1, =gARMHasVFPD32
+	ldrb		r1, [r1]
+	cmp			r1, #0
+	beq			1f
 	fldmiad		r0!, {d16-d31}
-	ldr			r1, [r0]
+	b			2f
+1:	add			r0, r0, #128		/* keep fpscr at its fixed offset */
+2:	ldr			r1, [r0]
 	vmsr		fpscr, r1
 	bx			lr
 FUNCTION_END(arm_restore_fpu)
