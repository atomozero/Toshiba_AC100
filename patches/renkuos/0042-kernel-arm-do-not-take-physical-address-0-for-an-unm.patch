From 2cbbf344c98310472ed89cc4f1bd9d61b7cbbe20 Mon Sep 17 00:00:00 2001
From: atomozero <bernardi.andrea@gmail.com>
Date: Sat, 17 Oct 2026 19:43:07 +0200
Subject: [PATCH 042/270] kernel/arm: do not take physical address 0 for an
 unmapped page

Query() and QueryInterrupt() only reported a page as present when its
physical address was not 0. On SoCs with RAM at physical address 0, like
the NVIDIA Tegra 2 in the Toshiba AC100, page 0 is handed out like any
other; the access flag fault handler then saw the page as not mapped and
panicked with "unhandled access flag fault".

Tell from the entry type whether the page is mapped.
---
 .../paging/32bit/ARMVMTranslationMap32Bit.cpp | 20 +++++++++++--------
 1 file changed, 12 insertions(+), 8 deletions(-)

diff --git a/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp b/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
index cf7e54417c..ef18e822ea 100644
--- a/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
+++ b/src/system/kernel/arch/arm/paging/32bit/ARMVMTranslationMap32Bit.cpp
@@ -466,12 +466,14 @@ ARMVMTranslationMap32Bit::Query(addr_t va, phys_addr_t *_physical,
 		pd[index] & ARM_PDE_ADDRESS_MASK);
 	page_table_entry entry = pt[VADDR_TO_PTENT(va)];
 
-	if ((entry & ARM_PTE_TYPE_MASK) != 0)
-		*_physical = (entry & ARM_PTE_ADDRESS_MASK);
-
 	*_flags = ARMPagingMethod32Bit::PageTableEntryFlagsToAttributes(entry);
-	if (*_physical != 0)
+
+	// physical page 0 is ordinary memory on some SoCs (e.g. NVIDIA Tegra), so
+	// the entry type, not the address, tells whether the page is mapped
+	if ((entry & ARM_PTE_TYPE_MASK) != 0) {
+		*_physical = (entry & ARM_PTE_ADDRESS_MASK);
 		*_flags |= PAGE_PRESENT;
+	}
 
 	pinner.Unlock();
 
@@ -501,12 +503,14 @@ ARMVMTranslationMap32Bit::QueryInterrupt(addr_t va, phys_addr_t *_physical,
 			pd[index] & ARM_PDE_ADDRESS_MASK);
 	page_table_entry entry = pt[VADDR_TO_PTENT(va)];
 
-	if ((entry & ARM_PTE_TYPE_MASK) != 0)
-		*_physical = (entry & ARM_PTE_ADDRESS_MASK);
-
 	*_flags = ARMPagingMethod32Bit::PageTableEntryFlagsToAttributes(entry);
-	if (*_physical != 0)
+
+	// physical page 0 is ordinary memory on some SoCs (e.g. NVIDIA Tegra), so
+	// the entry type, not the address, tells whether the page is mapped
+	if ((entry & ARM_PTE_TYPE_MASK) != 0) {
+		*_physical = (entry & ARM_PTE_ADDRESS_MASK);
 		*_flags |= PAGE_PRESENT;
+	}
 
 	return B_OK;
 }
